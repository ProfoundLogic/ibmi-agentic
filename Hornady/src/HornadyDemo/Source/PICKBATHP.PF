      *******************************************************************
      * APPLICATION:                                                    *
      * FILE NAME:   PICKBATHP                                          *
      * DESCRIPTION: Pick Batch Header                                  *
      * WRITTEN BY:  Glenn Hopwood (Profound Logic Software)            *
      * DATE:        Sept 2021                                          *
      *                                                                 *
      *    Date     By   Description                                    *
      * ----------  ---  ---------------------------------------------- *
      * XX/XX/XXXX  XXX  XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX *
      *******************************************************************
     A                                      UNIQUE
     A                                      REF(FLDREF)
     A          R PICKBATHR
      *
     A            PICKBAT   R               REFFLD(ORD#)
     A                                      TEXT('Pick Batch Num')
     A                                      COLHDG('Pick' 'Batch' 'Num')
     A            PICKSEQNO      8S 0       TEXT('Batch Seq Num')
     A                                      COLHDG('Batch' 'Seq' 'Num')
     A            PICKER        10A         TEXT('Picker')
     A                                      COLHDG('Picker')
     A            PICKINVLOC     4A         TEXT('Pick Inv Loc')
     A                                      COLHDG('Pick' 'Inv' 'Loc')
     A            PICKSTAT       1A         TEXT('Pick Batch Status')
     A                                      COLHDG('Pick' 'Batch' 'Status')
     A            PICKNUMITM     5S 0       TEXT('Num of Items')
     A                                      COLHDG('Num' 'of Items')
     A            PICKNUMPCS     5S 0       TEXT('Num of Pieces')
     A                                      COLHDG('Num' 'of Pieces')
     A            PICKSTART       Z         TEXT('Pick Start Stamp')
     A                                      COLHDG('Pick' 'Start' 'Stamp')
     A            PICKEND         Z         TEXT('Pick End Stamp')
     A                                      COLHDG('Pick' 'End' 'Stamp')
     A            PICKDUR        6P 0       TEXT('Pick Duration')
     A                                      COLHDG('Pick' 'Duration')
      *
     A            PICKCRTUSR    10          TEXT('Created by User')
     A                                      COLHDG('Created' 'User')
     A            PICKCRTTZ       Z         TEXT('Created Timestamp')
     A                                      COLHDG('Created' 'Timestamp')
      *
     A            PICKCHGUSR    10          TEXT('Changed by User')
     A                                      COLHDG('Changed' 'User')
     A            PICKCHGTZ       Z         TEXT('Changed Timestamp')
     A                                      COLHDG('Changed' 'Timestamp')
      *
      * Job that last used the BATCH
     A            PICKCHGJBU    10          TEXT('Changed Job User')
     A                                      COLHDG('Changed' 'Job' 'User')
     A            PICKCHGJBN    10          TEXT('Changed Job Name')
     A                                      COLHDG('Changed' 'Job' 'Name')
     A            PICKCHGJB#     6  0       TEXT('Changed Job Num')
     A                                      COLHDG('Changed' 'Job' 'Num')
     A            PICKTOT       50          TEXT('Tote id')
     A                                      DFT(' ')
      *
      *
     A          K PICKBAT
