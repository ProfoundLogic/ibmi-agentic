CREATE VIEW XXPVAR350F/PKGUNTL1 (
--  SQL1506   30   Key or attribute for PKGUNTL1 in XXPVAR350F ignored.
  PKUNIT ,
  PKDESC ,
  PKDLEN ,
  PKDWDT ,
  PKDHTG )
  AS
  SELECT
  PKUNIT ,
  PKDESC ,
  PKDLEN ,
  PKDWDT ,
  PKDHTG
  FROM XXPVAR350F/PKGUNT

  RCDFMT PKGUNTR    ;

LABEL ON TABLE XXPVAR350F/PKGUNTL1
  IS 'VS Package Unit file LF' ;

LABEL ON COLUMN XXPVAR350F/PKGUNTL1
( PKUNIT IS 'PKG                 UNT' ,
  PKDESC IS 'PKG                 DSC' ,
  PKDLEN IS 'DIM LENGTH' ,
  PKDWDT IS 'DIM WIDTH' ,
  PKDHTG IS 'DIM HEIGHT' ) ;

LABEL ON COLUMN XXPVAR350F/PKGUNTL1
( PKUNIT TEXT IS 'Package Unit' ,
  PKDESC TEXT IS 'Package Unit Description' ,
  PKDLEN TEXT IS 'DIM LENGTH' ,
  PKDWDT TEXT IS 'DIM WIDTH' ,
  PKDHTG TEXT IS 'DIM HEIGHT' ) ;

GRANT DELETE , INSERT , SELECT , UPDATE
ON XXPVAR350F/PKGUNTL1 TO PUBLIC WITH GRANT OPTION ;

GRANT ALTER , DELETE , INSERT , REFERENCES , SELECT , UPDATE
ON XXPVAR350F/PKGUNTL1 TO QPGMR WITH GRANT OPTION ;

