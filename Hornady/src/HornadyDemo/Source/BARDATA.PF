     A            BDVND14       14A         TEXT('VENDOR MASTER CTN UCC-14')
     A            BDVND14I      14A         TEXT('VENDOR INNER CARTON UCC-14')
     A            BDSHLHDR       5A         TEXT('T=DIE SHELLHLDR')
     A            BDSERIES       3A         TEXT('T=DIE SERIES')
     A            BDDIES23       1A         TEXT('T=DIE #DIES/SET')
     A            BDLINE01      25A         TEXT('LINE 01 DATA')
     A            BDLINE02      25A         TEXT('LINE 02 DATA')
     A            BDLINE03      25A         TEXT('LINE 03 DATA')
     A            BDLINE04      25A         TEXT('LINE 04 DATA')
