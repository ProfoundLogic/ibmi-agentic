     A                                      UNIQUE
     A          R BARDATAR
     A            BDSTS          1A         TEXT('A=ACTIVE, I/blank=INACTIVE')
     A            BDITEM        15A         TEXT('@ ITEM #')
     A            BDUPC          5A         TEXT('@ UPC 5 DIGIT')
