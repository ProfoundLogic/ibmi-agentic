     A            BDAMO1TRJ      8A         TEXT('AMMO 1 YDS TRAJ')
     A            BDAMO2TRJ      8A         TEXT('AMMO 2 YDS TRAJY')
     A            BDAMO3TRJ      8A         TEXT('AMMO 3 YDS TRAJY')
     A            BDAMO4TRJ      8A         TEXT('AMMO 4 YDS TRAJY')
     A            BDAMO5TRJ      8A         TEXT('AMMO 5 YDS TRAJY')
     A            BDAMO6TRJ      8A         TEXT('BLANK TRAJRY')
