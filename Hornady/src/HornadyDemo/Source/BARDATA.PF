     A            BDLINE10      25A         TEXT('LINE 10 DATA')
     A            BDLINE11      25A         TEXT('LINE 11 DATA')
     A            BDLINE12      25A         TEXT('LINE 12 DATA')
     A            BDACIP        25A         TEXT('AMMO CIP')
     A            BDAMUZZL       8A         TEXT('MUZZLE')
     A            BDAMO1YDS      8A         TEXT('AMMO 1 YDS')
     A            BDAMO2YDS      8A         TEXT('AMMO 2 YDS')
