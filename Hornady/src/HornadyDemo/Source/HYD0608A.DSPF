     A          R SFLCMD02
     A*%%TS  SD  20180619  164000  BEARL       REL-V7R3M0  5770-WDS
     A                                      TEXT('Main subfile - function key t-
     A                                      ext')
     A                                      OVERLAY
     A  93                                  PUTOVR
     A            S@MORE         7A  O 25125DSPATR(HI)
     A                                      OVRDTA
     A                                 26  2'F12=Cancel'
     A                                      COLOR(BLU)
     A          R WINDOW01
     A*%%TS  SD  20220207  173431  BEARL       REL-V7R3M0  5770-WDS
     A                                      WINDOW(9 27 9 52)
     A                                      WDWBORDER((*COLOR BLU) (*DSPATR RI)-
     A                                       (*CHAR '        '))
     A                                      CF11(11 'Continue')
     A                                      ALARM
     A                                  2 17'* * * WARNING * * *'
     A                                      DSPATR(BL)
     A                                  4  2'Not all items that are supposed to-
     A                                       be in the'
     A                                  5  2'tote have been scanned.  If everyt-
     A                                      hing has been'
     A                                  6  2'scanned, press F11 to continue.'
     A                                  8  2'F11=Continue   F12=Cancel'
     A                                      COLOR(BLU)
     A          R WINDOW02
     A*%%TS  SD  20220207  173431  BEARL       REL-V7R3M0  5770-WDS
     A                                      WINDOW(9 27 13 55)
     A                                      WDWBORDER((*COLOR BLU) (*DSPATR RI)-
     A                                       (*CHAR '        '))
     A                                      ALARM
     A                                  2 19'* * * WARNING * * *'
     A                                      DSPATR(BL)
     A            W2LINE1       53A  O  4  2TEXT('Window 2 line 1')
     A            W2LINE2       53A  O  5  2TEXT('Window 2 line 2')
     A            W2LINE3       53A  O  6  2TEXT('Window 2 line 3')
     A            W2LINE4       53A  O  7  2TEXT('Window 2 line 4')
     A****                              4  2'Items have been verified for the -
     A****                                  current tote.  These'
     A****                              5  2'verifications will be lost if the -
     A****                                  requested cancel is'
     A****                              6  2'performed.  Also, any labels gener-
     A****                                  ated in the current'
     A****                              7  2'Tote Verify session will be lost (-
     A****                                  and not be valid).'
     A                                  9  2'Key a "Y" to cancel the current To-
     A                                      te Verify session,'
     A                                      COLOR(BLU)
     A                                 10  2'or an "N" to continue in Tote Veri-
     A                                      fy.'
     A                                      COLOR(BLU)
     A                                 12  2'Process cancel request? . . .'
     A            W2DOIT         1A  B 12 34TEXT('Cancel TV session "Y"')
     A          R DSPBLANKA
     A*%%TS  SD  19920217  162710  BEARL       REL-V2R1M0  5738-PW1
     A                                      ASSUME
     A                                  1  2' '
