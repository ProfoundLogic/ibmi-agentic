      *******************************************************************
      * APPLICATION: Manufacturing, Shipping                            *
      * FILE NAME:   BARCUST                                            *
      * DESCRIPTION: Customer bar code data                             *
      * WRITTEN BY:  William Earl (MCA)                                 *
      * DATE:        January 2012                                       *
      *                                                                 *
      *    Date     By   Description                                    *
      * ----------  ---  ---------------------------------------------  *
      * 12/07/2017  MCA  Add CBIPL, CBIASN, and CBIINVC.                *
      *******************************************************************
     A                                      UNIQUE
     A          R BARCUSTR
     A            CBITEM        15A         TEXT('Item number')
     A                                      COLHDG('Item' 'No.')
     A            CBCUST         7S 0       TEXT('Customer number')
     A                                      COLHDG('Cust' 'No.')
     A                                      EDTCDE(Z)
     A            CBCITEM       30A         TEXT('Customer item number')
     A                                      COLHDG('Cust' 'Item' 'No.')
     A            CBCUPC        12A         TEXT('Customer UPC number')
     A                                      COLHDG('Cust' 'UPC')
     A            CBCUCCMC      14A         TEXT('Customer master carton UCC +
     A                                      number')
     A                                      COLHDG('Cust' 'Carton' 'UCC')
     A            CBBOXCTN       5S 0       TEXT('Boxes per carton')
     A                                      COLHDG('Boxes' 'Per' 'Ctn')
     A                                      EDTCDE(J)
     A            CBQTYCTN       6S 0       TEXT('Quantity per carton')
     A                                      COLHDG('Qty' 'Per' 'Ctn')
     A                                      EDTCDE(J)
     A            CBCTNDESC     12A         TEXT('Carton description')
     A                                      COLHDG('Carton' 'Description')
     A            CBCUCCBC      14A         TEXT('Customer barrel carton UCC +
     A                                      number')
     A                                      COLHDG('Cust' 'Barrel' 'UCC')
     A            CBQTYBAR       7S 0       TEXT('Quantity per barrel carton')
     A                                      COLHDG('Qty' 'Per' 'Barrel')
     A                                      EDTCDE(J)
     A            CBCUCCIP      14A         TEXT('Customer inner-pack UCC +
     A                                      number')
     A                                      COLHDG('Cust' 'Inner-Pack' 'UCC')
     A            CBQTYIPC       5S 0       TEXT('Quantity per inner-pack +
     A                                      carton')
     A                                      COLHDG('Qty' 'Per' 'Inner-Pack')
     A                                      EDTCDE(J)
     A****  H-Hornady, C-Customer, B-Both
     A            CBIPL          1A         TEXT('Packing List Item#')
     A                                      COLHDG('Pack' 'List' 'Item')
     A            CBIASN         1A         TEXT('856 ASN Item#')
     A                                      COLHDG('856' 'ASN' 'Item')
     A            CBIINVC        1A         TEXT('Invoice and 810 Item#')
     A                                      COLHDG('Invoice' '& 810' 'Item')
      *
     A          K CBITEM
     A          K CBCUST
