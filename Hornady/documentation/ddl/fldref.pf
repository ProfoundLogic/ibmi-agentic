     A**********************************************************************
     A* FIELD REFERENCE FILE — FLDREF
     A* Skeleton — fields here are the union of names referenced via
     A* REFFLD() in the in-package LF / DSPF / PF members and in the
     A* PICKBATDP / PICKBATHP REFFLDs (ORD#, ORL#, ITEM, TURN, IMQT, SEQ3).
     A* Types inferred from IBM i naming conventions — review before use.
     A**********************************************************************
     A          R FLDREFR
     A* --- Order / line / sequence ---
     A            ORD#           8S 0       TEXT('Order number')
     A                                      COLHDG('Order' 'Number')
     A                                      EDTCDE(Z)
     A            ORL#           4S 0       TEXT('Order line number')
     A                                      COLHDG('Line' 'Number')
     A            TURN           4S 0       TEXT('Turnaround number')
     A                                      COLHDG('Turn' 'Around')
     A            BLN#           5S 0       TEXT('Bin number')
     A                                      COLHDG('Bin' 'Number')
     A            SEQ3           3S 0       TEXT('3-digit sequence')
     A                                      COLHDG('Seq')
     A            SEQ4           4S 0       TEXT('4-digit sequence')
     A                                      COLHDG('Seq#')
     A            SEQ8           8S 0       TEXT('8-digit sequence')
     A                                      COLHDG('Sequence')
     A* --- Customer ---
     A            CUST           7S 0       TEXT('Customer number')
     A                                      COLHDG('Cust' 'No.')
     A                                      EDTCDE(Z)
     A            BLTO           7S 0       TEXT('Bill-to customer')
     A                                      COLHDG('Bill' 'To')
     A                                      EDTCDE(Z)
     A            SHTO           7S 0       TEXT('Ship-to customer')
     A                                      COLHDG('Ship' 'To')
     A                                      EDTCDE(Z)
     A            DSHP           7S 0       TEXT('Drop-ship customer')
     A                                      COLHDG('Drop' 'Ship')
     A                                      EDTCDE(Z)
     A* --- Item / inventory ---
     A            ITEM          15A         TEXT('Item number')
     A                                      COLHDG('Item' 'Number')
     A            IMDS          25A         TEXT('Item description')
     A                                      COLHDG('Item' 'Description')
     A            IMQT          11P 2       TEXT('Item quantity')
     A                                      COLHDG('Quantity')
     A* --- Shipment ---
     A            GRP#           7S 0       TEXT('Shipment group number')
     A                                      COLHDG('Group' 'Number')
     A                                      EDTCDE(Z)
     A            LOT#          10A         TEXT('Lot number')
     A                                      COLHDG('Lot' 'Number')
     A            SSCC          20A         TEXT('SSCC / UCC-128 barcode')
     A                                      COLHDG('SSCC')
     A            BOL#           8S 0       TEXT('Bill of lading number')
     A                                      COLHDG('BOL#')
     A* --- Address-ish ---
     A            STNM          30A         TEXT('Store / customer name')
     A                                      COLHDG('Name')
     A            STZP           9A         TEXT('Zip code')
     A                                      COLHDG('Zip')
     A* --- Ship-via ---
     A            SHPV           6A         TEXT('Ship-via code')
     A                                      COLHDG('Ship' 'Via')
     A            SVDS          30A         TEXT('Ship-via description')
     A                                      COLHDG('Ship-Via' 'Description')
     A* --- Status / flags ---
     A            STS            1A         TEXT('Status flag')
     A                                      COLHDG('Sts')
     A* --- Timestamps ---
     A            TSTP            Z         TEXT('Timestamp')
     A                                      COLHDG('Timestamp')
