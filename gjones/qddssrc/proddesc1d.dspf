      * @MBRTEXT: AI Creation of product description
     A          R SCRN1
     A                                      CF05(05 'AI')
     A                                      CA03(03 'Exit')
     A                                  4  5'Product ID:'
     A            PRID           5Y 0B  4 24
     A                                  6  5'Short Description:'
     A                                  7  5'Dimensions (in)'
     A                                  8  5'Length:'
     A                                  8 21'Width:'
     A                                  8 35'Depth:'
     A                                 10  5'Avail. Colors:'
     A                                 15  3'Catalog Description'
     A            SHORTDESC     50   B  6 24
     A            LENGTH         5Y 0B  8 14
     A            WIDTH          5Y 0B  8 28
     A            DEPTH          5Y 0B  8 42
     A            COLORS        50   B 10 24
     A            CATDESC      300   B 16  3CNTFLD(75)
     A                                 23  3'F3=Exit, F5=CatalogAI'
     A                                 12  5'Power Options:'
     A            POWER         50   B 12 24

     A*%%RS+<record-sequences>
     A*%%RS+ <sequence name="scrn1">
     A*%%RS+  <device type="display" width="80" height="24" />
     A*%%RS+  <record-write record-format="SCRN1" />
     A*%%RS+ </sequence>
     A*%%RS </record-sequences>