**free

dcl-f hyrstubd workstn;

pgmname = 'PICKERR';
title   = 'Picker Workflow (Profound UI mobile)';
line1   = 'Mobile / scan-gun picker workflow.  Pickers log in,';
line2   = 'see assigned batches, scan items into a tote, and';
line3   = 'mark batches complete.  Driven by PICKERD.DSPF with';
line4   = 'JSON layout metadata for a responsive UI.';

exfmt stub;

*inlr = *on;
