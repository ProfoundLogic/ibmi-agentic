             PGM        PARM(&PALLET &BANNRTY &PRTTYP &OUTQ &DRAWER +
                          &COPIES &HOLDSPLF &CALLER &RTNCODE)

             DCL        VAR(&PALLET)   TYPE(*DEC) LEN(9 0)
             DCL        VAR(&BANNRTY)  TYPE(*CHAR) LEN(1)
             DCL        VAR(&PRTTYP)   TYPE(*CHAR) LEN(1)
             DCL        VAR(&OUTQ)     TYPE(*CHAR) LEN(10)
             DCL        VAR(&DRAWER)   TYPE(*DEC) LEN(3 0)
             DCL        VAR(&COPIES)   TYPE(*DEC) LEN(3 0)
             DCL        VAR(&HOLDSPLF) TYPE(*CHAR) LEN(4)
             DCL        VAR(&CALLER)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&RTNCODE)  TYPE(*CHAR) LEN(2)
             /* Stub for HYC3550 -- Pallet Banner Print. No-op. */
             CHGVAR     VAR(&RTNCODE) VALUE('  ')
             RETURN
             ENDPGM
