     A*  WXD8P4 - 148 Lost Claim Update File
     A*****************************************************************
     A*
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PD801                     TEXT('148 Lost Claim Update file')
     A*
     A            D8TSET         3A         TEXT('Trn Set ID')
     A            D8MTC          2A         TEXT('MTC code')
     A            D8TDT          8A         TEXT('MTC date')
     A            D8JRST         2A         TEXT('Jurisdiction St')
     A            D8ACL#        25A         TEXT('State claim #')
     A            D8DOD          8A         TEXT('Date of death')
     A            D8ACDT         8A         TEXT('Date of injury')
     A            D8EMPN        11A         TEXT('Employer policy number')
     A            D8LSN         30A         TEXT('Claimant last name')
     A            D8FSN         20A         TEXT('Claimant first name')
     A            D8MID          2A         TEXT('Claimant MI.')
     A            D8SFFX         3A         TEXT('Claimant suffix')
     A            D8ACTY         2A         TEXT('Type of accident')
     A            D8EDID         9A         TEXT('User ID EDI sender')
     A            D8SS#          9A         TEXT('Claimant SS#')
     A            D8MEDD         8A         TEXT('$1000 pgm, dt limit reached')
     A            D8CLIN         2A         TEXT('Claim indicator')
     A            D8CLID         8A         TEXT('Claim indicator date')
     A            D8CLST         2A         TEXT('Claim status')
     A            D8CLSD         8A         TEXT('Claim status date')
     A            D8SMDT         8A         TEXT('Settled medical date')
     A            D8SRC#        30A         TEXT('Source claim number')
     A            D8BWCA        30A         TEXT('BWC claim assignment')
     A            D8STAT         1A         TEXT('Record status')
     A*                  (BLANK = NOT PROCESSED)
     A*                  ('P'   = PROCESSED)
     A            D8TRN#         5  0       TEXT('   TRANSACTION #')
     A*                  (THIS FIELD IS USED TO ATTACH THE ICD9 AND
     A*                   PRIOR AUTH SEGMENTS TO SPECIFIC RECORDS IN
     A*                   THIS FILE.  THE KEY IS 'ACL#/TRN#')
