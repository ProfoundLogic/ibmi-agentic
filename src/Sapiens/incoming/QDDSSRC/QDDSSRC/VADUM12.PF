     A          R PV201                     TEXT('VADUM CLAIM IMPORT  +
     A                                            Record 02 Format')
     A
     A            V2RCID         2A         TEXT('Record ID-Format 02')
     A            V2FND          3S 0       TEXT('Group Number')
     A            V2CLM#    R               REFFLD(DS40)
     A                                      TEXT('VADUM CLAIM#-XREF TO CMCASE')
     A                                      COLHDG('VADUM Claim #')
     A            V2FSN     R               REFFLD(FSN)
     A                                      COLHDG('FIRST NAME')
     A            V2LSN     R               REFFLD(LSN)
     A                                      COLHDG('LAST NAME')
     A            V2MID     R               REFFLD(MID)
     A                                      COLHDG('MID INITIAL')
     A            V2ADR1    R               REFFLD(ADR1)
     A            V2ADR2    R               REFFLD(ADR2)
     A            V2CTY     R               REFFLD(CTY)
     A            V2ST      R               REFFLD(ST)
     A            V2ZIP          9S 0       TEXT('ZIP CODE')
     A            V2CTRY         3A         COLHDG('COUNTRY CODE')
     A            V2ADR3    R               REFFLD(DS40)
     A                                      COLHDG('CITY/PROV/POSTAL CD')
     A            V2SEX     R               REFFLD(FLAG)
     A                                      COLHDG('GENDER')
     A            V2MSTS    R               REFFLD(FLAG)
     A                                      COLHDG('MARITAL' 'STATUS')
     A            V2DTOB         8A         TEXT('Date of Birth')
     A                                      COLHDG('Rept Date' 'to Admin')
     A            V2LTFL    R               REFFLD(FLAG)
     A                                      TEXT('Lost Time Flag')
     A                                      COLHDG('LOST' 'TIME' 'FLAG')
     A            V2STAT    R               REFFLD(STAT)
     A                                      TEXT('Claim Status,O=Open,C=Closed')
     A            V2ACDS        60A         TEXT('Accident Description')
     A            V2ACD2        60A         TEXT('Accident Description TWO')
     A            V2NATR    R               REFFLD(CODE)
     A                                      COLHDG('NATURE' 'CODE')
     A            V2PART    R               REFFLD(CODE)
     A                                      COLHDG('PART' 'CODE')
     A            V2CAUS    R               REFFLD(CODE)
     A                                      COLHDG('CAUSE' 'CODE')
     A            V2LSCV    R               REFFLD(CODE)
     A                                      COLHDG('LOSS COVERAGE CODE')
     A            V2COVT    R               REFFLD(CODE)
     A                                      COLHDG('TYPE OF' 'COVERAGE')
     A            V2JRST    R               REFFLD(CODE)
     A                                      COLHDG('JURISDICTION STATE')
     A            V2RCVD         8A         TEXT('Date accident reported to +
     A                                            Admin')
     A                                      COLHDG('Rept Date' 'to Admin')
     A            V2RPDT         8A         TEXT('Date accident reported to +
     A                                            Emplouer')
     A                                      COLHDG('Rept Date' 'to Emplyr')
     A            V2DOD          8A         TEXT('Date of Death')
     A            V2DEPT    R               REFFLD(DS10)
     A                                      COLHDG('DEPARTMENT')
     A            V2MCLM         7A         TEXT('Multiple Claim #')
     A            V2CLAS         5S 0       TEXT('Payroll Class Code')
     A            V2OCDS    R               REFFLD(DS40)
     A                                      TEXT('Occupation Description')
     A            V2AWW          9S 2       TEXT('Average Weekly Wage')
     A            V2HIDT         8A         TEXT('Hire Date')
     A            V2DTLW         8A         TEXT('Date Last Work')
     A            V2LUMP    R               REFFLD(FLAG)
     A                                      TEXT('Lump Settlement Indicator +
     A                                            Y/N')
     A            V2MTST    R               REFFLD(CODE)
     A                                      TEXT('Method of Settlement')
     A*                                     00 = Claim not subject to Settlement
     A*                                     03 = Stipulated Award
     A*                                     04 = Findings & Award-Judicial Award
     A*                                     05 = Dismissal
     A*                                     06 = Compromise Settlement
     A*                                     07 = No Safety Devices
     A*                                     08 = All Other Settlements         d
     A            V2FRAU    R               REFFLD(FLAG)
     A                                      TEXT('Fraud Indicator=Y/N')
     A            V2LITG    R               REFFLD(FLAG)
     A                                      TEXT('Litigation Indicator=Y/N')
     A            V2CVFL    R               REFFLD(FLAG)
     A                                      TEXT('Controverted=Y/N')
     A            V2SUBR    R               REFFLD(FLAG)
     A                                      TEXT('Subrogated=Y/N')
     A            V2DNY     R               REFFLD(FLAG)
     A                                      TEXT('Denied=Y/N')
     A            V2MCTP    R               REFFLD(CODE)
     A                                      TEXT('Managed Care Organization +
     A                                            Type')
     A*                                     00 = MCO-No Medical Srvices Provided
     A*                                     01 = MCO-Medical Services Provided
     A*                                     02 = HMO
     A*                                     03 = PPO
     A*                                     04 = EPO
     A*                                     05 = IPA
     A            V2VORC    R               REFFLD(FLAG)
     A                                      TEXT('Vocational Rehab Indicator +
     A                                            Y/N')
     A            V2RT01    R               REFFLD(CODE)
     A                                      TEXT('Medical Reserve Code')
     A*                                     11 = Medical
     A            V2RR01         9S 2       TEXT('Outstanding Medical Reserves')
     A            V2AR01         9S 2       TEXT('Total Medical Paid')
     A            V2RT02    R               REFFLD(CODE)
     A                                      TEXT('Expense Reserve Code')
     A*                                     13 = Expense
     A            V2RR02         9S 2       TEXT('Outstanding Expense Reserves')
     A            V2AR02         9S 2       TEXT('Total Expense Paid')
     A            V2RT03    R               REFFLD(CODE)
     A                                      TEXT('Indemnity Reserve Code')
     A*                                     12 = Indemnity
     A            V2RR03         9S 2       TEXT('Outstanding Indemnity +
     A                                            Reserves')
     A            V2AR03         9S 2       TEXT('Total Indemnity Paid')
     A            V2RT04    R               REFFLD(CODE)
     A                                      TEXT('Legal Reserve Code')
     A*                                     16 = Legal
     A            V2RR04         9S 2       TEXT('Outstanding Legal Reserves')
     A            V2AR04         9S 2       TEXT('Total Legal Paid')
     A            V2RT05    R               REFFLD(CODE)
     A                                      TEXT('Rehab Reserve Code')
     A*                                     14 = Rehabilitation
     A            V2RR05         9S 2       TEXT('Outstanding Rehab Reserves')
     A            V2AR05         9S 2       TEXT('Total Rehab Paid')
     A            V2RT06         2A         TEXT('Reserve Code 06')
     A            V2RR06         9S 2       TEXT('Outstanding Reserves 06')
     A            V2AR06         9S 2       TEXT('Total Paid 06')
     A            V2RT07         2A         TEXT('Reserve Code 07')
     A            V2RR07         9S 2       TEXT('Outstanding Reserves 07')
     A            V2AR07         9S 2       TEXT('Total Paid 07')
     A            V2RT08         2A         TEXT('Reserve Code 08')
     A            V2RR08         9S 2       TEXT('Outstanding Reserves 08')
     A            V2AR08         9S 2       TEXT('Total Paid 08')
     A            V2RT09         2A         TEXT('Reserve Code 09')
     A            V2RR09         9S 2       TEXT('Outstanding Reserves 09')
     A            V2AR09         9S 2       TEXT('Total Paid 09')
     A            V2RT10         2A         TEXT('Reserve Code 10')
     A            V2RR10         9S 2       TEXT('Outstanding Reserves 10')
     A            V2AR10         9S 2       TEXT('Total Paid 10')
     A            V2DEDR         9S 2       TEXT('Deductible Reimbursement +
     A                                            Amount')
     A            V2IDT          8A         TEXT('Date Claim Entered')
