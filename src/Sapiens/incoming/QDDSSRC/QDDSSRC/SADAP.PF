     A                                      REF(SREFP)
     A          R PDA01                     TEXT('DIAGNOSIS CODE INFO FILE')
     A            DACO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            DASUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER NUMBER')
     A            DAFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            DAFYR     R               REFFLD(FYR)
     A                                      COLHDG('YEAR')
     A            DACASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE NUMBER')
     A            DASEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('UNIQUE SEQUENCE#')
     A            DAICD9         5
     A                                      COLHDG('ICD9 DIAG CODE')
     A            DALOST    R               REFFLD(FLAG)
     A                                      COLHDG('LOS FLAG')
     A*                         VALID VALUES = D = DIAGNOSIS CODE
     A*                                        O = OPERATIVE CODE
     A            DAPRIM    R               REFFLD(FLAG)
     A                                      COLHDG('PRIMARY DIAG CODE')
     A*                         VALID VALUES = Y OR N
     A            DASTDT    R               REFFLD(DT)
     A                                      COLHDG('NOT NEEDED')
     A            DAILOC         3
     A                                      COLHDG('ICD9 LOCATION')
     A            DAISIT         3
     A                                      COLHDG('ICD9 SITE')
     A            DAISTS    R               REFFLD(DS3)
     A                                      COLHDG('STATUS')
     A* OH: USED TO HOLD BWC STATUS INFO RETURNED FROM THE STATE ON 148
     A            DAISDT    R               REFFLD(DT)
     A                                      COLHDG('STATUS DATE')
     A            DASTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            DAUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            DAPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            DATIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            DADT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            DAIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            DAIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            DAITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            DAIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            DAEXDT    R               REFFLD(DT)
     A                                      COLHDG('EXPIRATION DATE')
     A            DADODM    R               REFFLD(A50)
     A                                      COLHDG('DODM GOAL')
     A            DAINCL    R               REFFLD(A50)
     A                                      COLHDG('INCL IN DODM CALC')
     A*** Beg Add *** 05/23/13 ****************************************
     A            DAICD1001 R               REFFLD(DS7)
     A                                      COLHDG('ICD10 Code 1')
     A*
