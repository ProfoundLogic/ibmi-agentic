     A                                      REF(WREFP)
      *
     A          R PX101                     TEXT('A/R Detail Work File')
      *
     A            X1CO#          3S 0       COLHDG('Company #')
      *
     A            X1FND          3S 0       COLHDG('Group #')
      *
     A            X1EMP#         9S 0       COLHDG('Employer #')
      *
     A            X1DIV          5S 0       COLHDG('Division')
      *
     A            X1FYR          3S 0       COLHDG('Policy Year')
      *
     A            X1ST           2A         COLHDG('Rating State')
      *
     A            X1ARCD         2A         COLHDG('A/R Code')
      *
     A            X1ARTY         1A         COLHDG('A/R Type')
      *
     A            X1CTYP         1A         COLHDG('Category Type')
      *
     A            X1AMT          9S 2       COLHDG('Amount')
      *
     A            X1CHK#         7S 0       COLHDG('Check Number')
      *
     A            X1TRDT         7S 0       COLHDG('Transaction Date')
      *
     A            X1PODT         7S 0       COLHDG('Posting Date')
      *
     A            X1DATE         7S 0       COLHDG('Date Selected')
      *
     A            X1AGT#         5S 0       COLHDG('Agent #')
      *
     A            X1CRAT         5S 2       COLHDG('Commission Rate')
      *
     A            X1CAMT         9S 2       COLHDG('Commission Amount')
      *
     A            X1PLAN         1A         COLHDG('Commission Plan')
      *
      *
     A            X1USER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            X1PGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Pgm')
     A            X1TIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A            X1DT           7S 0       COLHDG('Maint Date')
      *
