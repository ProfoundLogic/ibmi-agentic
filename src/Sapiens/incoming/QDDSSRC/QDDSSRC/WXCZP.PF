     A                                      REF(WREFP)
     A          R PCZ01                     TEXT('Auto Cash Dissolve Entries')
     A            CZCO#          3S 0       COLHDG('CO#')
     A                                      TEXT('COMPANY NUMBER')
     A            CZFND          3S 0       COLHDG('FND')
     A                                      TEXT('GROUP NUMBER')
     A            CZEMP#         9S 0       COLHDG('EMP#')
     A                                      TEXT('EMPLOYER NUMBER')
     A            CZDIV          5S 0       COLHDG('DIV')
     A                                      TEXT('EMPLOYER DIVISION')
     A            CZCHK#         7S 0       COLHDG('CHECK#')
     A                                      TEXT('CHECK NUMBER')
     A            CZCKAM         9S 2       COLHDG('CHECK AMT')
     A                                      TEXT('CHECK AMOUNT')
     A            CZLATE         1A         COLHDG('LATE' 'PMNT')
     A                                      TEXT('LATE PAYMENT FLAG')
