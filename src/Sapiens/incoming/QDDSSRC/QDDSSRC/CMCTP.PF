     A*************************************************************
     A* * * CLIENT MASTER FILE * * *
     A*
     A                                      REF(CSREFP)
     A          R PCT01                     TEXT('CLIENT MASTER FILE')
     A            CTCLT#    R               REFFLD(CLT#)
     A                                      COLHDG('CLIENT' 'NUMBER')
     A            CTMBR     R               REFFLD(FLAG)
     A                                      COLHDG('MEMBER' 'FLAG' 'M/N')
     A                                      TEXT('M=MEMBER, N=NONMEMBER')
     A***                                      M=Member in WCMS Emplr Master
     A*** BEGIN CHANGE **** 08/09/94 ********************************
     A            CTFND     R               REFFLD(FND)
     A**********************************    COLHDG('FUND' 'NUMBER')
     A                                      COLHDG('WCMS' 'FUND#')
     A            CTMBR#    R               REFFLD(MBR#)
     A************************************  COLHDG('MEMBER' 'NUMBER')
     A                                      COLHDG('WCMS' 'EMPLR#')
     A*** END CHANGE ****** 08/09/94 ********************************
     A*** CLIENT DEMOGRAPHICS ***
     A            CTNAME    R               REFFLD(NAME)
     A                                      COLHDG('CLIENT' 'NAME')
     A            CTADR1    R               REFFLD(DS40)
     A                                      COLHDG('ADDRESS 1')
     A            CTADR2    R               REFFLD(DS40)
     A                                      COLHDG('ADDRESS 2')
