     A*
     A* HES Billing File - Header
     A*
     A*****************************************************************
     A* Created on 11/03/2009 by c:227 for Project 135MMX
     A*****************************************************************
     A* Purpose: This file will house the billing record for the
     A*          associated HES records.  Additional fields will
     A*          be added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAH9P record via H9DCID.
     A*****************************************************************
     A* Revisions:
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PH101                     TEXT('HES Billing File - Header')
     A            H1CR#         14A         COLHDG('Claim Reference#')
     A            H1IMAG        17A         COLHDG('Image Number')
     A            H1CLM#        30A         COLHDG('Claim#')
     A            H1FSN         25A         COLHDG('Claimant First Name')
     A            H1HLSN        35A         COLHDG('Claimant Last Name')
     A            H1DOB          8A         COLHDG('Date of Birth')
     A            H1HADT         8A         COLHDG('Injury Date')
     A            H1HSS#         9A         COLHDG('Social Security#')
     A            H1INDT         8A         COLHDG('Invoice Date')
     A            H1SBDT         8A         COLHDG('Submit Date')
     A            H1HPDT         8A         COLHDG('Process Date')
     A            H1FLDT         8A         COLHDG('Fill Date')
     A            H1NWRF         2A         COLHDG('New/Refill Code')
     A            H1RX#         10A         COLHDG('RX Number')
     A            H1NDC         11A         COLHDG('NDC#')
     A            H1NDCD        30A         COLHDG('Drug' 'Name')
     A            H1QTY          8A         COLHDG('Quantity')
     A            H1BILA        11A         COLHDG('Billed Amount')
     A            H1PRIC         8A         COLHDG('Reference Price')
     A            H1PAID         8A         COLHDG('Paid Amount')
     A            H1CFEE        11A         COLHDG('Claim Fee')
     A            H1DUE          8A         COLHDG('Amount Due')
     A            H1TTYP         1A         COLHDG('Transaction Type')
     A            H1DEA#        10A         COLHDG('DEA#')
     A            H1NPI#        12A         COLHDG('NPI#')
     A            H1LSN         35A         COLHDG('Last Physician')
     A            H1AST          2A         COLHDG('Adjudication State')
     A            H1VNID        15A         COLHDG('Vendor Network Id')
     A            H1PNAM        35A         COLHDG('Provider Name')
     A            H1ADR1        35A         COLHDG('Provider Address1')
     A            H1CTY         20A         COLHDG('Provider City')
     A            H1ST           2A         COLHDG('Provider State')
     A            H1ZIP         11A         COLHDG('Provider Zip')
     A            H1FEIN         9A         COLHDG('PBM FEIN')
     A            H1FIL1       250A         COLHDG('Filler')
     A            H1FIL2       250A         COLHDG('Filler')
     A            H1DCID        12A         COLHDG('SR Document Id')
     A            H1MBR#        10A         COLHDG('SR Member Name')
     A            H1CO#          3  0       COLHDG('SR Company Number')
     A            H1SUB#         5  0       COLHDG('SR Subscriber#')
     A            H1FYR          3  0       COLHDG('SR Policy Year')
     A            H1FND          3  0       COLHDG('SR Group#')
     A            H1CASE         7  0       COLHDG('SR Case#')
     A            H1SS#          9  0       COLHDG('SR SS#')
     A            H1ACDT         7  0       COLHDG('SR Accident Dt')
     A            H1EOB#         9  0       COLHDG('SR EOB#')
     A            H1DLUS        10A         COLHDG('SR Delete User')
     A            H1DLPG        10A         COLHDG('SR Delete Pgm')
