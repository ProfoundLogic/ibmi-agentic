     A            GBHRECFMT      1A         COLHDG('Recipient Name' +
     A                                      'Format')
     A            GBHRECINAM    62A         COLHDG('Recipient Individual' +
     A                                      'Name')
     A            GBHCLTFMT      1A         COLHDG('Client Name Format')
     A            GBHCLTLSN     18A         COLHDG('Client Last Name')
     A            GBHCLTFSN     13A         COLHDG('Client First Name')
     A            GBHRSV3       31A         COLHDG('Reserved for Future' +
     A                                      'Use 3')
     A            GBHCLTAD1     25A         COLHDG('Client Address 1')
     A            GBHCLTAD2     25A         COLHDG('Client Address 2')
     A            GBHCLTAD3     30A         COLHDG('Client Address 3')
     A            GBHCLTCTY     22A         COLHDG('Client City')
     A            GBHCLTST       2A         COLHDG('Client State')
     A            GBHCLTCRY      3A         COLHDG('Client Country')
