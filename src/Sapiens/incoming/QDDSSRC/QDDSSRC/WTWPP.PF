     A                                      REF(WREFP)
     A          R PWP01                     TEXT('WCPOLS Schedule File')
     A            WPCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company #')
     A            WPNAME        40A
     A                                      COLHDG('Schedule Name')
     A            WPST      R               REFFLD(ST)
     A                                      COLHDG('State/Bureau')
     A            WPCAR#         5S 0       COLHDG('Carrier #')
     A            WPFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group #')
     A            WPER      R               REFFLD(FLAG)
     A                                      COLHDG('Experience Rating')
     A            WPPEEP    R               REFFLD(FLAG)
     A                                      COLHDG('PEEP Processing')
     A            WPFILE       100A         COLHDG('File Name')
     A            WPDIR        250A         COLHDG('File Directory')
     A            WPSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            WPUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            WPPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            WPTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            WPDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            WPIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            WPIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            WPITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            WPIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
