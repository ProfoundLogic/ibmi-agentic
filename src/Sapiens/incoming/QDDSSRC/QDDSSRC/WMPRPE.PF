     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PPR01E                    TEXT('PAYROLL CLASS EXT FILE')
     A            PRCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            PRRTCD         3          COLHDG('RATE SET CODE')
     A            PRCLAS    R               REFFLD(CLAS)
     A                                      COLHDG('PAYROLL' 'CLASS')
     A            PREFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            PREXDS       300A
     A                                      COLHDG('PAYROLL CLASS' 'EXPANDED' +
     A                                      'DESCRIPTION')
     A            PRPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            PRUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            PRDT      R               REFFLD(DT)
     A                                      COLHDG('DATE')
     A            PRTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            PRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PROGRAM')
     A            PRIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            PRIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            PRITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            PRSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
      *
     A          K PRCO#
     A          K PRRTCD
     A          K PRCLAS
     A          K PREFDT
