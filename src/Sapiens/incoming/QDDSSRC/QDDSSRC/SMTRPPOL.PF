     A                                      REF(WREFP)
     A          R PTR01                     TEXT('Auto-Diary Triggers')
     A            TRCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TRNAME        10A
     A                                      COLHDG('Trigger Name')
     A            TRSEQ#         5S 0
     A                                      COLHDG('Name Seq#')
     A            TRPOLSTSTP    10A
     A                                      COLHDG('Policy Status Type')
     A            TRPOLSTS      10A
     A                                      COLHDG('Policy Status')
     A            TRQTETYPE     10A
     A                                      COLHDG('Policy/Quote Type')
     A            TRCHGVAL      15S 2
     A                                      COLHDG('$ Value Change +/-')
     A            TRCHG          3S 0
     A                                      COLHDG('% Change +/-')
     A            TRPREMLVL     15A
     A                                      COLHDG('Premium Level')
     A            TR#DAYSPR      3S 0
     A                                      COLHDG('# of Days Prior to' +
     A                                      'Effective Date')
     A            TRPREMAMT     15S 2
     A                                      COLHDG('Premium Amount')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TRCOMPDATE    10
     A                                      COLHDG('Compare Date')
     A            TRCOMPOPER    12
     A                                      COLHDG('Compare Oper')
     A          K TRCO#
     A          K TRNAME
     A          K TRSEQ#
