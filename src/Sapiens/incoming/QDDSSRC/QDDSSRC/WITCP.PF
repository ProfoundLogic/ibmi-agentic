     A                                      REF(WREFP)
     A          R PTC01                     TEXT('Portal Template  +
     A                                      Class Code File')
     A            TCCO#          3S 0       COLHDG('Company #')
     A            TCNAME        40          COLHDG('Template Name')
     A            TCCLAS         5S 0       COLHDG('Class' 'Code')
     A            TCRATECD       3A         COLHDG('Rate' 'Set' 'Code')
     A            TCRATEST       2A         COLHDG('Rating' 'State')
     A            TCUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TCPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TCDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TCTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TCIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TCIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TCITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TCSTAT         1A         COLHDG('Status')
