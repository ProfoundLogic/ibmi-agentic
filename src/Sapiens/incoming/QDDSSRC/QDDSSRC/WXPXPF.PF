     A          R PPX01F                    TEXT('CSV PREM FACTORS')
     A            PFRTYP         1A         COLHDG('REC_TYPE')
     A            PFCAP#        25A         COLHDG('POLICY#')
     A            PFFND          3A         COLHDG('GRP#')
     A            PFEMP#         9A         COLHDG('EMPLOYER #')
     A            PFDIV          5A         COLHDG('DIVISION')
     A            PFCODE         5A         COLHDG('STAT CODE')
     A            PFPRTE         6A         COLHDG('RATE (IF PERCENTAGE)')
     A            PFFRTE         5A         COLHDG('RATE (IF FACTOR)')
     A            PFBLVL         1A         COLHDG('BASED ON PREMIUM LVL')
     A            PFALVL         1A         COLHDG('APPLIED TO PREM LVL')
     A            PFEFDT         8A         COLHDG('FACTOR EFFECTIVE DT')
     A            PFEXDT         8A         COLHDG('FACTOR EXPIRATION DT')
     A            PFAMT         11A         COLHDG('AMOUNT')
     A            PFVDR#         5A         COLHDG('VENDOR NUMBER')
