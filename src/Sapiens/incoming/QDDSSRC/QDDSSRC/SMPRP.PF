     A**
     A* * * OPTICAL PURGE/DELETE REQUEST FILE
     A*
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*   DR189  C:02                                                 *
     A***  1/05/05 -  ADDED UNCP AND UNCF FIELDS FOR IFS
     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PPR01                     TEXT('OPTICAL PURGE DELE-
     A                                      TE REQUEST FILE')
     A            PRKEY     R               REFFLD(KEY)
     A            PRSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            PRSYS          1A         TEXT('SYSTEM ID                  ')
     A            PRHCMD         1A         TEXT('HEX CMD TO OLS             ')
     A            PRCPRY         1A         TEXT('COMMAND PRIORITY           ')
     A            PROSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            PROFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            PROSBD        12A         TEXT('OPTICAL SUBDIRECTORY       ')
     A            PRFOLD         8A         TEXT('FOLDER NAME                ')
     A            PRSUBD        12A         TEXT('SUBDIRECTORY NAME          ')
     A            PRDCID        12A         TEXT('UNIQUE DOCUMENT ID         ')
     A            PRDELF         1A         TEXT('DELETE FLAG                ')
     A            PRSTAT    R               REFFLD(STAT)
     A            PRUSER    R               REFFLD(USER)
     A            PRPGM     R               REFFLD(PGM)
     A            PRTIME    R               REFFLD(TIME)
     A            PRDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            PRIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            PRIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            PRPNAM    R               REFFLD(PGM)
     A                                      TEXT('KEYED PGM')
     A            PRASTT         1A         TEXT('ALLOW SAVE TO TAPE (Y/N)   ')
     A            PRBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            PRERDS        80A         TEXT('80B ERROR DESCRIPTION')
     A            PRTSFL         1A         TEXT('TAPE STATUS FLAG')
     A**** 01/05/05 **** ADD **************************************************
     A            PRUNCF    R               REFFLD(FLAG)
     A                                      TEXT('UNC FLAG <> BLANK IS IFS USE')
     A            PRUNCP    R               REFFLD(UNCP)
     A                                      TEXT('UNC PATH FOR IFS')
     A**** 01/05/05 **** END ADD **********************************************
