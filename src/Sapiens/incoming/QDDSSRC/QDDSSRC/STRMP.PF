     A            RMPURS        10A         COLHDG('Message Purpose')
     A            RMMSGID      100A         COLHDG('Message ID')
     A            RMDESC       250A         COLHDG('Message Description')
     A            RMCMPID      255A         COLHDG('Campaign ID')
     A            RMIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            RMIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            RMIDAT    R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            RMITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            RMUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            RMPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Pgm')
     A            RMDATE    R               REFFLD(DT)
