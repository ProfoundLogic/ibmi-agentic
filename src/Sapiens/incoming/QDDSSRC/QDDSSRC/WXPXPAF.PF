     A          R PPX01AF                   TEXT('Accident Fund Policy Export')
     A            PXCOID        10A         COLHDG('Company ID')
     A            PXPOL#        25A         COLHDG('Policy #')
     A            PXPOLEFFDT     8S 0       COLHDG('Policy Effective' +
     A                                      'Date')
     A            PXPOLST        2A         COLHDG('Policy State')
     A            PXPOLADDR     81A         COLHDG('Primary Policy' +
     A                                      'Holder Address')
     A            PXPOLCITY     25A         COLHDG('Primary Policy' +
     A                                      'Holder City')
     A            PXPOLSTATE     2A         COLHDG('Primary Policy' +
     A                                      'Holder State')
     A            PXPOLZIP      10A         COLHDG('Primary Policy' +
     A                                      'Holder Zip Code')
     A            PXLRGDEDFL     1A         COLHDG('Large Deductible' +
     A                                      'Flag')
     A            PXFCLASSFL     1A         COLHDG('F-Class Flag')
     A            PXOCCDISFL     1A         COLHDG('Occ Dis Flag')
     A            PXEMPLL       45A         COLHDG('Employer Liability' +
     A                                      'Limit')
     A            PXDEDPLAN     20A         COLHDG('Deductible Plan')
     A            PXAGGAMT      11S 2       COLHDG('Aggregate Amount')
     A            PXPERACCAM    11S 2       COLHDG('Per Accident Amount')
     A            PXEARNPREM    11S 2       COLHDG('Earned Premium')
     A            PXEARNDED     11S 2       COLHDG('Earned Deductible')
     A            PXEARNMRAT    11S 2       COLHDG('Earned Merit' +
     A                                      'Rating')
     A            PXEARNSCCR    11S 2       COLHDG('Earned Scheduled' +
     A                                      'Credit')
     A            PXEARNSCDE    11S 2       COLHDG('Earned Scheduled' +
     A                                      'Debit')
     A            PXEARNPRMD    11S 2       COLHDG('Earned Premium' +
     A                                      'Discount')
     A            PXEARNEMAS    11S 2       COLHDG('Earned Employer' +
     A                                      'Assessment')
     A            PXEARNTERR    11S 2       COLHDG('Earned Terrorism')
     A            PXEARNCATA    11S 2       COLHDG('Earned Catastrophe')
     A            PXEARNSFCR    11S 2       COLHDG('Earned Safety' +
     A                                      'Credit')
     A            PXEARNRTRO    11S 2       COLHDG('Earned Retro')
     A            PXEARNMCO     11S 2       COLHDG('Earned MCO')
     A            PXEARNDIV     11S 2       COLHDG('Earned Dividends')
     A            PXEARNEXCN    11S 2       COLHDG('Earned Expense' +
     A                                      'Constant')
     A            PXEARNMNPR    11S 2       COLHDG('Earned Minimum' +
     A                                      'Premium')
     A            PXWRITPREM    11S 2       COLHDG('Written Premium')
     A            PXWRITDED     11S 2       COLHDG('Written Deductible')
     A            PXWRITMRAT    11S 2       COLHDG('Written Merit' +
     A                                      'Rating')
     A            PXWRITSCCR    11S 2       COLHDG('Written Scheduled' +
     A                                      'Credit')
     A            PXWRITSCDE    11S 2       COLHDG('Written Scheduled' +
     A                                      'Debit')
     A            PXWRITPRMD    11S 2       COLHDG('Written Premium' +
     A                                      'Discount')
     A            PXWRITEMAS    11S 2       COLHDG('Written Employer' +
     A                                      'Assessment')
     A            PXWRITTERR    11S 2       COLHDG('Written Terrorism')
     A            PXWRITCATA    11S 2       COLHDG('Written Catastrophe')
     A            PXWRITSFCR    11S 2       COLHDG('Written Safety' +
     A                                      'Credit')
     A            PXWRITRTRO    11S 2       COLHDG('Written Retro')
     A            PXWRITMCO     11S 2       COLHDG('Written MCO')
     A            PXWRITDIV     11S 2       COLHDG('Written Dividends')
     A            PXWRITEXCN    11S 2       COLHDG('Written Expense' +
     A                                      'Constant')
     A            PXWRITMNPR    11S 2       COLHDG('Written Minimum' +
     A                                      'Premium')
     A            PXINDDEDRC    20A         COLHDG('Indemnity Deductible' +
     A                                      'Received')
     A            PXMEDDEDRC    20A         COLHDG('Medical Deductible' +
     A                                      'Received')

     A          K PXPOL#
     A          K PXPOLST
     A          K PXPOLEFFDT
