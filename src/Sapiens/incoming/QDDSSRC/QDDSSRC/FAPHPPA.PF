     A                                      REF(FSREFP)
     A          R PPH01                     TEXT('Pharmacy RCC Table File')
     A            PHMED#    R               REFFLD(DS10)
     A                                      COLHDG('Medicare Number')
     A            PHINPT    R               REFFLD(A76)
     A                                      COLHDG('Inpatient RCC')
     A            PHOUPT    R               REFFLD(A76)
     A                                      COLHDG('Outpatient RCC')
     A            PHSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            PHUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            PHPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Pgm')
     A            PHTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A            PHDT      R               REFFLD(DT)
     A                                      COLHDG('Maint Date')
     A            PHIUSR    R               REFFLD(USER)
     A                                      COLHDG('Init User')
     A            PHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Init Pgm')
     A            PHITIM    R               REFFLD(TIME)
     A                                      COLHDG('Init Time')
     A            PHIDT     R               REFFLD(DT)
     A                                      COLHDG('Init Date')
     A*** BEG ADD *** 11/18/08 ************************************************
