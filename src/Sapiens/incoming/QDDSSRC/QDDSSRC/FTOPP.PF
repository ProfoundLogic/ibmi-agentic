     A*
     A                                      REF(FSREFP)
     A          R POP01                     TEXT('OPPS HOSPITAL PROVIDER +
     A                                      SPECIFIC FILE')
     A            OPNPI#    R
     A*** BEG CHG *** 05/21/09 ***************************************
     A***********                           REFFLD(DS8)
     A                                      REFFLD(DS10)
     A*** END CHG *** 05/21/09 ***************************************
     A                                      COLHDG('NPI# NUMBER')
     A            OPPROV    R
     A                                      REFFLD(DS6)
     A                                      COLHDG('MEDICARE OSCAR' +
     A                                       ' NO.')
     A            OPEFDT         8S 0
     A                                      COLHDG('EFFECTIVE DATE ' +
     A                                      'OF UPDATE')
     A            OPDESC    R               REFFLD(DS40)
     A                                      COLHDG('PROVIDER NAME')
     A            OPDPT1         8S 0
     A                                      COLHDG('EFFECTIVE DATE OF' +
     A                                      ' FIRST PERIOD')
     A            OPBGDT         8S 0
     A                                      COLHDG('FISCAL YEAR' +
     A                                      ' BEGIN DATE')
     A            OPRPDT         8S 0
     A                                      COLHDG('REPORT DATE')
     A            OPTRDT         8S 0
     A                                      COLHDG('TERMINATION DATE')
     A            OPWAIV    R
     A                                      REFFLD(FLAG)
     A                                      COLHDG('PROVIDER WAIVED' +
     A                                      ' FROM PPS')
     A            OPINT          5S 0
     A                                      COLHDG('INTERMEDIARY NUMBER')
     A            OPTYPE    R
     A                                      REFFLD(DS2)
     A                                      COLHDG('PROVIDER TYPE')
     A            OPSLOC    R
     A                                      REFFLD(FLAG)
     A                                      COLHDG('SPECIALTY LOCALITY' +
     A                                      ' INDICATOR')
     A            OPCDWI    R
     A                                      REFFLD(FLAG)
     A                                      COLHDG('CHANGE CODE ' +
     A                                      'WAGE INDEX')
     A            OPAMSA    R
     A                                      REFFLD(DS4)
     A                                      COLHDG('ACTUAL MSA (NOT ' +
     A                                      'USED)')
     A            OPWMSA    R
     A                                      REFFLD(DS4)
     A                                      COLHDG('WAGE INDEX ' +
     A                                      'MSA (NOT USED)')
     A            OPPCR          4S 3
     A                                      COLHDG('PAYMENT TO COST ' +
     A                                      'RATIO')
     A            OPSCOD         2S 0
     A                                      COLHDG('STATE CODE')
     A            OPTOPS    R               COLHDG('TOPS INDICATOR')
     A                                      REFFLD(FLAG)
     A*** BEG CHG *** 05/21/09 ***************************************
     A*********   OPFIL2    R               COLHDG('FILLER')
     A*********                             REFFLD(DS2)
     A            OPHOQU    R               COLHDG('HOSPITAL QUALITY ' +
     A                                      'INDICATOR')
     A                                      REFFLD(FLAG)
     A            OPFIL     R               COLHDG('FILLER')
     A                                      REFFLD(FLAG)
     A*** END CHG *** 05/21/09 ***************************************
     A            OPOCCR         4S 3
     A                                      COLHDG('OUTPATIENT COST' +
     A                                      '-TO-CHARGE RATIO')
     A            OPACBS    R
     A                                      REFFLD(DS5)
     A                                      COLHDG('ACTUAL CBSA')
     A            OPWCBS    R
     A                                      REFFLD(DS5)
     A                                      COLHDG('CBSA WAGE' +
     A                                      ' INDEX')
     A            OPWIND         6S 4
     A                                      COLHDG('WAGE INDEX')
     A            OPSPWI         6S 4
     A                                      COLHDG('SPECIAL WAGE INDEX')
     A            OPSPPY    R               REFFLD(FLAG)
     A                                      COLHDG('SPECIAL PAYMENT ' +
     A                                      'INDICATOR')
     A            OPRCTR         4S 0
     A                                      COLHDG('REDUCED ' +
     A                                      'CO-INSURANCE ' +
     A                                      'TRAILER COUNT')
     A            OPSTAT    R
     A                                      REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            OPIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            OPIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            OPIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
     A            OPITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            OPUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            OPPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM' 'MAINTAINED')
     A            OPDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OPTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
