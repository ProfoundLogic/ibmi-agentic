     A** UR Concurrent/Retrospective Review Exception Claims Workfile
     A                                      REF(FSREFP)
     A          R PEE01                     TEXT('C/R Review Exception Claims')
     A            EECO#     R               REFFLD(CO#)
     A            EESUB#    R               REFFLD(SUB#)
     A            EEFND     R               REFFLD(FND) COLHDG('GROUP#')
     A            EEFYR     R               REFFLD(FYR)
     A            EECASE    R               REFFLD(CASE)
     A            EECSCD    R               REFFLD(CSCD)
     A                                      COLHDG('CLAIM' 'STATUS CODE')
     A            EEFDAT    R               REFFLD(DT)
     A                                      COLHDG('FROM SERV' 'DATE')
     A            EEIPOP    R               REFFLD(FLAG)
     A                                      COLHDG('IN/OUT PATIENT' 'FLAG')
     A            EEFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('PROVIDERS' 'FEIN')
     A            EEMOD     R               REFFLD(MOD)
     A                                      COLHDG('PROVIDERS' 'MODIFIER')
     A            EEPRTY    R               REFFLD(FLAG)
     A                                      COLHDG('PROVIDER' 'TYPE')
     A            EESVCD    R               REFFLD(SVCD)
     A            EEPMOD    R               REFFLD(PMOD)
     A            EECPT4    R               REFFLD(CPT4)
     A            EEICD9    R               REFFLD(ICD9)
     A            EEANMN    R               REFFLD(A52)
     A                                      COLHDG('ANESTHISIA' 'UNITS')
     A            EEUNTS    R               REFFLD(A52)
     A                                      COLHDG('UNITS OF' 'THE CHARGES')
     A            EEEOMB    R               REFFLD(SPEC)
     A                                      COLHDG('EOMB' 'CODE')
     A            EEDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('DETAIL' 'SEQUENCE #')
     A            EESS#     R               REFFLD(SS#)
     A            EEACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE')
     A            EERCFL    R               REFFLD(FLAG) COLHDG('REASONABLE' +
     A                                      'AND CUSTOMARY' 'Y/blank')
     A            EEZIPA    R               REFFLD(ZIPA) COLHDG('GEO ZIP')
     A            EEAST     R               REFFLD(ST) COLHDG('ADJUDICATION-
     A                                       STATE')
     A            EEADT     R               REFFLD(DT)
     A                                      COLHDG('ACTIVITY' 'DATE')
     A            EEEDIT    R               REFFLD(EDIT)
     A                                      COLHDG('EDIT' 'CODE')
     A            EEEXT     R               REFFLD(EXT)
     A                                      COLHDG('EDIT' 'CODE' 'EXT')
     A            EEETYP    R               REFFLD(EDTTYP)
     A                                      COLHDG('EDIT' 'TYPE')
     A            EEFL01    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED')
     A            EEFL02    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED')
     A            EEFL03    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED')
     A            EEFL04    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED')
     A            EEFL05    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED')
     A            EEDT01    R               REFFLD(DT)
     A                                      TEXT('NOT USED')
     A            EEDT02    R               REFFLD(DT)
     A                                      TEXT('NOT USED')
     A            EEDT03    R               REFFLD(DT)
     A                                      TEXT('NOT USED')
     A            EEDT04    R               REFFLD(DT)
     A                                      TEXT('NOT USED')
     A            EEDT05    R               REFFLD(DT)
     A                                      TEXT('NOT USED')
     A            EESTAT    R               REFFLD(STAT)
     A            EEUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A            EEPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PGM')
     A            EETIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A            EEDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A            EEIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            EEIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
