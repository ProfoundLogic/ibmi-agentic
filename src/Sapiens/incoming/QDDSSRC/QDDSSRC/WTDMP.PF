     A****************************************************************
     A*  MEDICARE 2ND PAY DATA COMPLIANCE CODE TABLE FILE
     A*
     A                                      REF(WREFP)
     A          R PDM01                     TEXT('MEDICARE COMPLIANCE -
     A                                           TABLE FILE')
     A            DMCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            DMCODE         2A
     A                                      COLHDG('COMPLIANCE CODE')
     A            DMDESC    R               REFFLD(DS00)
     A                                      COLHDG('COMPLIANCE CODE' 'DESC')
     A            DMSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A*
     A* MAINTENANCE INFORMATION
     A*
     A            DMUSER    R               REFFLD(USER)
     A            DMPGM     R               REFFLD(PGM)
     A            DMTIME    R     S         REFFLD(TIME)
     A            DMDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            DMIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            DMIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            DMITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            DMIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
