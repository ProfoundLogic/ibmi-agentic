     A            PMPEOL        15A         COLHDG('Client Link')
     A            PMRST          2A         COLHDG('Rating State')
     A            PMENAM       100A         COLHDG('Employer Name')
     A            PMFNAM       100A         COLHDG('Federal Name')
     A            PMMAD1        40A         COLHDG('Mail Address 1')
     A            PMMAD2        40A         COLHDG('Mail Address 2')
     A            PMMCTY        25A         COLHDG('Mail Address City')
     A            PMMST          2A         COLHDG('Mail Address State')
     A            PMMZIP         9A         COLHDG('Mail Zip')
     A            PMPAD1        40A         COLHDG('Phys Address 1')
     A            PMPAD2        40A         COLHDG('Phys Address 2')
     A            PMPCTY        25A         COLHDG('Phys Address City')
     A            PMPST          2A         COLHDG('Phys Address State')
     A            PMPZIP         9A         COLHDG('Phys Zip')
     A            PMPHON        10A         COLHDG('Phone #')
     A            PMFAX         10A         COLHDG('Fax #')
     A            PMFEIN         9A         COLHDG('Fed Tax ID')
     A            PMTPOB         1A         COLHDG('Type Of Business')
     A            PMSIC          6A         COLHDG('SIC Code')
     A            PMTOB          3A         COLHDG('Type of Building')
     A            PMEFDT         8A         COLHDG('Policy Eff Date')
     A            PMANDT         8A         COLHDG('Anniv Rate Date')
     A            PMNAIC        10A         COLHDG('NAIC Code')
     A            PM#OFE         7A         COLHDG('# Of Employees')
     A            PMNAMP         1A         COLHDG('DBA Personal' 'Name Flag')
     A            PMFDNP         1A         COLHDG('Fed Personal' 'Name Flag')
     A            PMLSID         1A         COLHDG('Employee Leasing ID')
     A            PMUE#         20A         COLHDG('State Unemployment #')
     A            PMSEMP        15A         COLHDG('State Risk ID')
     A            PMRSK#        15A         COLHDG('NCCI Risk ID')
     A            PMILCD         2A         COLHDG('Inc Limits Code')
     A            PMDBCR         5A         COLHDG('Sched Debit/Credit')
     A            PMASP2         5A         COLHDG('Deviation 1 Factor')
     A            PMDEV2         5A         COLHDG('Deviation 2 Factor')
     A            PMEXM1         5A         COLHDG('Exp Mod Factor')
     A            PMELID        10A         COLHDG('Location ID')
     A            PMELYR         3A         COLHDG('Location Year')
     A            PMTPYR        13A         COLHDG('Loc Total Payroll')
     A            PMBUILDYR      4A         COLHDG('Bld Const Year')
     A            PM#STORIES     3A         COLHDG('Bld # Of Stories')
     A            PMPEAKEMP      7A         COLHDG('Peak # Employees')
     A            PMEXPRTFLG     1A         COLHDG('Exp Rating Flag')
     A            PMCARR        25A         COLHDG('Carr Policy #')
     A            PMCUST        20A         COLHDG('Customer ID')
     A            PMEXDT         8A         COLHDG('Deletion Date')
     A* Begin Add *** 07/12/21 ***************************************
     A            PMEMP#         9A         COLHDG('Employer Number')
