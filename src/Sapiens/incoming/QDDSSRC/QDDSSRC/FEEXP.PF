     A                                      REF(FSREFP)
     A          R PEX01                     TEXT('WCMC EDI Control file')
     A*********************** KEY INFO ********************************
     A            EXCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY#')
     A            EXJRST    R               REFFLD(ST)
     A                                      COLHDG('JURISDICTION' 'STATE')
     A            EXTSET    R               REFFLD(CODE3)
     A                                      COLHDG('TRANSACTION' 'SET ID')
     A            EXLOG     R               REFFLD(FLAG)
     A                                      COLHDG('TRIGGER FOR' 'LOG CREATION')
     A*                                           Valid values: FTGTP
     A*                                           via 'CLOG'
     A*********************** FILE FORMATS ****************************
     A            EX837     R               REFFLD(FLAG)
     A                                      COLHDG('837 FILE' 'FORMAT')
     A*                                           Valid values: FTGTP
     A*                                           via 'FFOR'
     A            EX837A    R               REFFLD(FLAG)
     A                                      COLHDG('837/824 ACK' 'FILE FORMAT')
     A*                                           Valid values: FTGTP
     A*                                           via 'FFOR'
     A            EX835     R               REFFLD(FLAG)
     A                                      COLHDG('835 FILE' 'FORMAT')
     A*                                           Valid values: FTGTP
     A*                                           via 'FFOR'
     A*********************** TRANSMISSION INFO ***********************
     A            EXSEIN        12A         COLHDG('SENDER' 'FEIN')
     A            EXSZP          9A         COLHDG('SENDER' 'POSTAL CODE')
     A            EXREIN        12A         COLHDG('RECEIVER' 'FEIN')
     A            EXRZP          9A         COLHDG('RECEIVER' 'POSTAL CODE')
     A*********************** DAYS/DARTS REMARK CODES *****************
     A            EX#D01         3P 0       COLHDG('# OF' 'DAYS 01')
     A            EX#D02         3P 0       COLHDG('# OF' 'DAYS 02')
     A            EX#D03         3P 0       COLHDG('# OF' 'DAYS 03')
     A            EX#D04         3P 0       COLHDG('# OF' 'DAYS 04')
     A            EX#D05         3P 0       COLHDG('# OF' 'DAYS 05')
     A            EX#D06         3P 0       COLHDG('# OF' 'DAYS 06')
     A            EX#D07         3P 0       COLHDG('# OF' 'DAYS 07')
     A            EX#D08         3P 0       COLHDG('# OF' 'DAYS 08')
     A            EX#D09         3P 0       COLHDG('# OF' 'DAYS 09')
     A            EX#D10         3P 0       COLHDG('# OF' 'DAYS 10')
     A            EX#D11         3P 0       COLHDG('# OF' 'DAYS 11')
     A            EX#D12         3P 0       COLHDG('# OF' 'DAYS 12')
     A            EX#D13         3P 0       COLHDG('# OF' 'DAYS 13')
     A            EX#D14         3P 0       COLHDG('# OF' 'DAYS 14')
     A            EX#D15         3P 0       COLHDG('# OF' 'DAYS 15')
     A            EX#D16         3P 0       COLHDG('# OF' 'DAYS 16')
     A            EX#D17         3P 0       COLHDG('# OF' 'DAYS 17')
     A            EX#D18         3P 0       COLHDG('# OF' 'DAYS 18')
     A            EX#D19         3P 0       COLHDG('# OF' 'DAYS 19')
     A            EX#D20         3P 0       COLHDG('# OF' 'DAYS 20')
     A            EXDR01         5A         COLHDG('DARTS' 'REMARK CODE 01')
     A            EXDR02         5A         COLHDG('DARTS' 'REMARK CODE 02')
     A            EXDR03         5A         COLHDG('DARTS' 'REMARK CODE 03')
     A            EXDR04         5A         COLHDG('DARTS' 'REMARK CODE 04')
     A            EXDR05         5A         COLHDG('DARTS' 'REMARK CODE 05')
     A            EXDR06         5A         COLHDG('DARTS' 'REMARK CODE 06')
     A            EXDR07         5A         COLHDG('DARTS' 'REMARK CODE 07')
     A            EXDR08         5A         COLHDG('DARTS' 'REMARK CODE 08')
     A            EXDR09         5A         COLHDG('DARTS' 'REMARK CODE 09')
     A            EXDR10         5A         COLHDG('DARTS' 'REMARK CODE 10')
     A            EXDR11         5A         COLHDG('DARTS' 'REMARK CODE 11')
     A            EXDR12         5A         COLHDG('DARTS' 'REMARK CODE 12')
     A            EXDR13         5A         COLHDG('DARTS' 'REMARK CODE 13')
     A            EXDR14         5A         COLHDG('DARTS' 'REMARK CODE 14')
     A            EXDR15         5A         COLHDG('DARTS' 'REMARK CODE 15')
     A            EXDR16         5A         COLHDG('DARTS' 'REMARK CODE 16')
     A            EXDR17         5A         COLHDG('DARTS' 'REMARK CODE 17')
     A            EXDR18         5A         COLHDG('DARTS' 'REMARK CODE 18')
     A            EXDR19         5A         COLHDG('DARTS' 'REMARK CODE 19')
     A            EXDR20         5A         COLHDG('DARTS' 'REMARK CODE 20')
     A*********************** MAINTENANCE INFO ************************
     A            EXMAXT    R               REFFLD(A50)
     A                                      COLHDG('MAXIMUM NUMBER' +
     A                                      'OF TRANSACTIONS')
     A            EXCSDT    R               REFFLD(DT)
     A                                      COLHDG('PROCESSING' 'START DATE')
     A            EXSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            EXUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            EXPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            EXTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            EXDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            EXIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            EXIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            EXITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            EXIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
     A            EXSDUE         3P 0       COLHDG('# OF DAYS' 'FOR DUE DATE')
     A            EXHCPR         5A         COLHDG('HARDCOPY' 'REMARK CODE')
     A*** BEG ADD ***** 03/26/07 ****************************************
     A            EXPDNY    R               REFFLD(FLAG)
     A                                      COLHDG('PROCESS DENIED BILLS')
     A*** END ADD ***** 03/26/07 **************************************
     A*** FTGIP    CLOG = EDI 837 Log Creation
     A*** FTGTP values: 0=n/a
     A***               1=Completion of Bill
     A***               2=Completion of WC chk
     A*
     A*** FTGIP    FFOR = EDI File Format
     A*** FTGTP values: 0=n/a
     A***               1=Base
     A***               2=State
     A*
