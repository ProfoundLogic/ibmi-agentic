     A          R PST7C                     TEXT('ICR 7-C RECORD')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STNSID         3S 0       COLHDG('Non schd ind %')
     A            STNDIL         9S 0       COLHDG('Non schd ind' +
     A                                      'incurred loss amt')
     A            STEMLY         9S 0       COLHDG('Emp liability' +
     A                                      'or oth ind amt incur')
     A            STVOAM         9S 0       COLHDG('Voc rehabilitation' +
     A                                      'incurred amount tot')
     A            STPNBN         9S 0       COLHDG('Pension indemnity' +
     A                                      'benefits')
     A            STPRPT         9S 0       COLHDG('Present value of' +
     A                                      'future indemnity')
     A            STFUAL         9S 0       COLHDG('Funeral allowance' +
     A                                      'amount')
     A            STLSMR         9S 0       COLHDG('Lump sum remarriage' +
     A                                      'payment amount')
     A            STFUT1       130A         COLHDG('Future use')
     A            STGRP#         3S 0       COLHDG('Group #')
