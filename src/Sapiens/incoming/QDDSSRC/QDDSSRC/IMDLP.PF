     A          R PDL01                     TEXT('DIST/LOAD BALANCE FILE')
     A*
     A            DLID          10          COLHDG('DIST/LB ID')
     A            DLIMGQ        10          COLHDG('QUEUE ID')
     A*
     A            DLSTAT         1          COLHDG('STATUS')
     A            DLTYPE         1          COLHDG('DIST OR LB FLAG')
     A***** LAST MAINT INFO  *****
     A*
     A            DLIUSR        10          TEXT('INIT USER')
     A            DLIPGM        10          TEXT('INIT PGM')
     A            DLITIM         6S 0       TEXT('INIT TIME')
     A            DLIDT          6S 0       TEXT('INIT DATE')
     A            DLLUSR        10          TEXT('USER LAST MAINT')
     A            DLLPGM        10          TEXT('LAST MAINT PGM')
     A            DLLTIM         6S 0       TEXT('LAST MAINT TIME')
     A            DLLDT          6S 0       TEXT('LAST MAINT DATE')
     A            DLFL01         1          TEXT('**FUTURE USE FLG 01 **')
     A            DLFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            DLFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            DLFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            DLFL05         1          TEXT('**FUTURE USE FLG 05 **')
     A            DLCHR5         5          TEXT('**FUTURE USE A5 01 **')
      *** BEGIN ADD *** 07/09/99 ***********************************************
     A            DLLDAT         7  0       TEXT('LAST MAINT DATE')
      *** END   ADD *** 07/09/99 ***********************************************
