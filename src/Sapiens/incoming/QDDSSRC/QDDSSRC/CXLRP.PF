     A                                      REF(CREFP)
     A          R CXL01                     TEXT('LOSS RATIO WORK FILE')
     A**                                                            **
     A            XXCO#          3S 0
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            XXPOL#        13A
     A                                      COLHDG('POLICY' 'NUMBER')
     A            XXFIN         35A
     A                                      COLHDG('NAME INSURED')
     A            XXTERM         2S 0
     A                                      COLHDG('TERM')
     A            XXEFDT    R               REFFLD(DT8)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            XXLPYD         9S 2
     A                                      COLHDG('NET AMOUNT')
     A            XXOSRV         9S 2
     A                                      COLHDG('INCURRED')
     A            XXXEST         9S 2
     A                                      COLHDG('PREMIUM')
     A            CNT            3S 0
     A                                      COLHDG('COUNT')
     A            XXRATO         8S 2
     A                                      COLHDG('RATIO')
     A            PXEXDT    R               REFFLD(DT8)
     A                                      COLHDG('EXP.' 'DATE')
     A            XXEXPP         9S 2
     A                                      COLHDG('EXPENSES')
     A            XXTLIN         9S 2
     A                                      COLHDG('TOTAL LINE')
     A            XXPREM         9S 2
     A                                      COLHDG('PREMIUM')
     A            XXFREQ         6S 2
     A                                      COLHDG('FREQ.')
     A            XXPRM2         9S 2
     A                                      COLHDG('EARNED PREMIUM')
     A            XXTODT    R               REFFLD(DT8)
     A                                      COLHDG('TO' 'DATE')
