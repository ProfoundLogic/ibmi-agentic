     A          R PW101                     TEXT('Extract Witness Format')
     A*
     A            W1CO#          3P 0       COLHDG('COMPANY #')
     A*
     A            W1JRST         2A         COLHDG('JURISDICTION STATE')
     A*
     A            W1EXDT         7P 0       COLHDG('EXTRACT DATE')
     A*
     A            W1TSET         3A         COLHDG('TRANSACTION SET ID')
     A*
     A            W1ACLC        25A         COLHDG('ADMIN' 'CLAIM' '#')
     A*
     A            W1MTC          2A         COLHDG('MAINT' 'TYPE' 'CODE')
     A*
     A            W1NAME        40A         COLHDG('WITNESS' 'NAME')
     A*
     A            W1BPH#        15S 0       COLHDG('WITNESS' 'BUSINESS PHONE' +
     A                                      'NUMBER')
