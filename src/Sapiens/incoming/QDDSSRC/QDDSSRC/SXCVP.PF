     A**
     A** DOC CONVERSION FILE  **
     A**
     A* * * BASED ON SDCMP REMARK DETAIL FILE ***8
     A*
     A*    CMSMCD: SMCD (4A) - "REMARK SUMMARY CODE"                  *
     A*    CMFL01: FLAG (1A) - "DATA ENTRY INTERFACE Y/BLANK"         *
     A*    CMFL02: FLAG (1A) - "PURGEABLE ITEM"                       *
     A*    CMFL03: FLAG (1A) - "IN USE ... SEE CLT #03"               *
     A*    CMFL04: FLAG (1A) - "IN USE ... SEE CLT#03"                *
     A*    CMFL05: FLAG (1A) - "DOCUMENT LOCATION"                    *
     A*    CMRMCD: RMCD (5A) - "REMARK CODE"                          *
     A*    CMIDT : DT  (6.0) - "INITIAL DATE"                         *
     A*  05/03/93 02 - QOPT                                           *
     A*  AM USING CMFL05 FOR "STORAGE LOCATION"                       *
     A*
     A*  9/16/99 - USING THE CMQPTY FIELD FOR VIS DARTS -
     A*            "ADDITIONAL OBJECTS EXIST" FLAG
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PCV01                     TEXT('REMARK DETAIL RECORD')
     A            CVKEY     R               REFFLD(KEY)
     A            CVCSID    R               REFFLD(CSID)
     A            CVCOMM    R               REFFLD(COMM)
     A            CVCDAT    R               REFFLD(DT)
     A                                      COLHDG('REMARK' 'DATE')
     A            CVCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            CVDCID    R               REFFLD(DCID)
     A*** BEGIN ADD *** 03/05/92 **************************************
     A                                      COLHDG('DOC ID/PGM ID')
     A                                      TEXT('OFFICE DOCUMENT ID +
                                            OR DATA ENTRY PROGRAM ID')
     A*** END   ADD *** 03/05/92 **************************************
     A            CVPNAM    R               REFFLD(PGM)
     A                                      TEXT('KEYED PGM')
     A            CVTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANS' 'DATE')
     A            CVTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANS' 'TIME')
     A            CVSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            CVSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            CVSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A******
     A            CVSTAT    R               REFFLD(STAT)
     A            CVUSER    R               REFFLD(USER)
     A            CVPGM     R               REFFLD(PGM)
     A            CVTIME    R               REFFLD(TIME)
     A            CVDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            CVIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A*** BEGIN CHG *** 03/05/92 **************************************
     A            CVFOLD        80A         TEXT('FOLDER ID FOR OFFICE +
     A                                      INTERFACE OR DATA ENTRY KEY')
     A                                      COLHDG('FOLDER ID/' 'DE KEY')
     A*** END   CHG *** 03/05/92 **************************************
     A            CVDCDT    R               REFFLD(DT)
     A                                      COLHDG('DIARY' 'COMPLETION' 'DATE')
     A            CVDIFL    R               REFFLD(FLAG)
     A                                      COLHDG('DIARY' 'FLAG')
     ********************* NEW FLDS ADDED 4/10/91  ************************
     A            CVAPID    R               REFFLD(CODE)
     A                                      COLHDG('APPLICATION ' 'PRODUCT ID')
     A            CVIDOC    R               REFFLD(DCID)
     A                                      COLHDG('IMAGE DOCUMENT' 'ID')
     A            CVIQUE    R               REFFLD(USER)
     A                                      COLHDG('CURRENT' 'IMAGE ' 'QUEUE')
     A            CVIMGF    R               REFFLD(FLAG)
     A                                      COLHDG('IMAGE TYPE'  ' REMARK FLAG')
     A            CVIPTH    R               REFFLD(USER)
     A                                      COLHDG('IMAGE PATH' 'IDENTIFIER')
     A            CVPIDX    R               REFFLD(SEQ#)
     A                                      COLHDG('IMAGE PATH' 'INDEX')
     A            CVQPTY    R               REFFLD(FLAG)
     A                                      COLHDG('ADDTL OBJ' 'EXIST Y/N')
     A            CVDCTP         5A         TEXT('DOCUMENT TYPE')
     A                                      COLHDG('DOC' 'TYPE')
     ********************* NEW FLDS ADDED 4/10/91  ************************
     A            CVIPGM    R               REFFLD(PGM)
     A                                      TEXT('INITIAL PGM')
     A*** BEGIN ADD *** 03/05/92 **************************************
     A            CVSMCD    R               REFFLD(SMCD)
     A                                      COLHDG('REMARK SUMMARY CODE')
     A            CVFL01    R               REFFLD(FLAG)
     A                                      COLHDG('DE INTERFACE')
     A                                      TEXT('DATA ENTRY INTERFACE Y/BLANK')
     A            CVFL02    R               REFFLD(FLAG)
     A                                      COLHDG('PURGEABLE ITEM')
     A                                      TEXT('PURGEABLE ITEM')
     A            CVFL03    R               REFFLD(FLAG)
     A                                      TEXT('IN USE BY CLT#03')
     A            CVFL04    R               REFFLD(FLAG)
     A                                      TEXT('IN USE BY CLT#03')
     A            CVFL05    R               REFFLD(FLAG)
     A                                      TEXT('DOCUMENT LOCATION')
     A            CVRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('REMARK CODE')
     A            CVIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A*** END   ADD *** 03/05/92 **************************************
     A*  NEW DOC ID
     A            CVNDOC    R               REFFLD(DCID)
     A*  NEW FOLDER ID
     A            CVNFLD        80A
     A*  ERROR FLAG
     A            CVEFLG    R               REFFLD(FLAG)
     A* ERROR DESC
     A            CVERR     R               REFFLD(DS40)
     A*  PROCESSED FLAG  (STATUS)
     A            CVPRCS    R               REFFLD(FLAG)
     A*
