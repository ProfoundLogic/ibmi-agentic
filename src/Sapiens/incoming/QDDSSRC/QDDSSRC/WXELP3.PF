     A*  EDI 816 File - Employer Detail
     A*
     A          R PXL01                     TEXT('EDI 816 Format-Emplr Detail')
     A            XLTRTP         2A         COLHDG('TRANSACTION' 'TYPE' '= EL')
     A            XLPOL#         8A         COLHDG('12 - POLICY #')
     A            XLBEXT         3A         COLHDG('12 - EXT #')
     A            XLANPR        11A         COLHDG('13 - ANNUAL PREMIUM')
     A            XLPFDT         8A         COLHDG('POLICY FROM DATE')
     A            XLPTDT         8A         COLHDG('POLICY TO DATE')
     A            XLPROC         1A         COLHDG('PROCESSED')
     A            XLTRN#         5  0       COLHDG('TRANSACTION #')
     A*
     A          K XLPOL#
     A          K XLBEXT
     A          K XLTRN#
