     A*                                                              *
     A          R CZC01                     TEXT('CERTIFICATE HOLDERS')
     A            CZPEO         40          COLHDG('PEO Name')
     A                                      TEXT('PEO Name')
     A            CZFND          3          COLHDG('PEO' 'Group' 'Number')
     A                                      TEXT('PEO Group Number')
     A            CZCLT         40          COLHDG('PEO' 'Client')
     A                                      TEXT('PEO Client')
     A            CZFYR          3          COLHDG('Fund' 'Year')
     A                                      TEXT('Fund Year')
     A            CZDATE         8          COLHDG('PEO' 'Client' 'Effective')
     A                                      TEXT('PEO Client Effective Date')
     A            CZEMP#         9          COLHDG('Fiserv' 'Employer#')
     A                                      TEXT('Fiserv Employer#')
     A            CZDIV          5          COLHDG('Fiserv' 'Division#')
     A                                      TEXT('Fiserv Division#')
     A            CZNAME        40          COLHDG('Cert' 'Holder' 'Name')
     A                                      TEXT('Cert Holder Name')
     A            CSATTN        60          COLHDG('Attention' 'Name')
     A                                      TEXT('Attention Name')
     A            CZMAD1        40          COLHDG('Cert' 'Address 1')
     A                                      TEXT('Cert Address 1')
     A            CZMAD2        40          COLHDG('Cert' 'Address 2')
     A                                      TEXT('Cert Address 2')
     A            CZCTY         25          COLHDG('Cert' 'City')
     A                                      TEXT('Cert City')
     A            CZST           2          COLHDG('Cert' 'State')
     A                                      TEXT('Cert State')
     A            CZZIP          9          COLHDG('Cert' 'Zip')
     A                                      TEXT('Cert Zip')
     A            CZOPDS        60          COLHDG('Desc of' 'Operations')
     A                                      TEXT('Desc of Operations')
     A            CZPROC         1          COLHDG('Processed' '(Y/E/blank)')
     A                                      TEXT('Processed (Y/E/blank)')
     A            CZSTAT         1          COLHDG('Status')
     A                                      TEXT('Status')
     A            CZUSER        10          COLHDG('Current' 'user')
     A                                      TEXT('Current user')
     A            CZPGM         10          COLHDG('Current' 'program')
     A                                      TEXT('Current program')
     A            CZTIME         6S 0       COLHDG('Current' 'time')
     A                                      TEXT('Current time')
     A            CZDT           7S 0       COLHDG('Current' 'date')
     A                                      TEXT('Current date')
     A            CZIUSER       10          COLHDG('Last' 'user')
     A                                      TEXT('Current user')
     A            CZIPGM        10          COLHDG('Last' 'program')
     A                                      TEXT('Last program')
     A            CZITIME        6S 0       COLHDG('Last' 'time')
     A                                      TEXT('Last time')
     A            CZIDT          7S 0       COLHDG('Last' 'date')
     A                                      TEXT('Last date')
