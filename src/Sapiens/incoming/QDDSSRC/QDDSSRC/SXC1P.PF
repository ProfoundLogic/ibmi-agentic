     A                                      REF(SCREFP)
     A          R PC101                     TEXT('CVT FILE CM AND DL  ')
     A            CMKEY     R               REFFLD(KEY)
     A            CMCSID    R               REFFLD(CSID)
     A            CMCOMM    R               REFFLD(COMM)
     A            CMCDAT    R               REFFLD(DT)
     A                                      COLHDG('REMARK' 'DATE')
     A            CMCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            CMDCID    R               REFFLD(DCID)
     A*** BEGIN ADD *** 03/05/92 **************************************
     A                                      COLHDG('DOC ID/PGM ID')
     A                                      TEXT('OFFICE DOCUMENT ID +
                                            OR DATA ENTRY PROGRAM ID')
     A*** END   ADD *** 03/05/92 **************************************
     A            CMPNAM    R               REFFLD(PGM)
     A                                      TEXT('KEYED PGM')
     A            CMTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANS' 'DATE')
     A            CMTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANS' 'TIME')
     A            CMSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            CMSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            CMSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A******
     A            CMSTAT    R               REFFLD(STAT)
     A            CMUSER    R               REFFLD(USER)
     A            CMPGM     R               REFFLD(PGM)
     A            CMTIME    R               REFFLD(TIME)
     A            CMDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            CMIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A*** BEGIN CHG *** 03/05/92 **************************************
     A            CMFOLD        80A         TEXT('FOLDER ID FOR OFFICE +
     A                                      INTERFACE OR DATA ENTRY KEY')
     A                                      COLHDG('FOLDER ID/' 'DE KEY')
     A*** END   CHG *** 03/05/92 **************************************
     A            CMDCDT    R               REFFLD(DT)
     A                                      COLHDG('DIARY' 'COMPLETION' 'DATE')
     A            CMDIFL    R               REFFLD(FLAG)
     A                                      COLHDG('DIARY' 'FLAG')
     ********************* NEW FLDS ADDED 4/10/91  ************************
     A            CMAPID    R               REFFLD(CODE)
     A                                      COLHDG('APPLICATION ' 'PRODUCT ID')
     A            CMIDOC    R               REFFLD(DCID)
     A                                      COLHDG('IMAGE DOCUMENT' 'ID')
     A            CMIQUE    R               REFFLD(USER)
     A                                      TEXT('ADDT L REMARKS PRESENT')
     A            CMIMGF    R               REFFLD(FLAG)
     A                                      COLHDG('IMAGE TYPE'  ' REMARK FLAG')
     A            CMIPTH    R               REFFLD(USER)
     A                                      COLHDG('IMAGE PATH' 'IDENTIFIER')
     A            CMPIDX    R               REFFLD(SEQ#)
     A                                      COLHDG('IMAGE PATH' 'INDEX')
     A            CMQPTY    R               REFFLD(FLAG)
     A                                      COLHDG('ADDTL OBJ' 'EXIST Y/N')
     A            CMDCTP         5A         TEXT('DOCUMENT TYPE')
     A                                      COLHDG('DOC' 'TYPE')
     ********************* NEW FLDS ADDED 4/10/91  ************************
     A            CMIPGM    R               REFFLD(PGM)
     A                                      TEXT('INITIAL PGM')
     A*** BEGIN ADD *** 03/05/92 **************************************
     A            CMSMCD    R               REFFLD(SMCD)
     A                                      COLHDG('REMARK SUMMARY CODE')
     A            CMFL01    R               REFFLD(FLAG)
     A                                      COLHDG('DE INTERFACE')
     A                                      TEXT('DATA ENTRY INTERFACE Y/BLANK')
     A            CMFL02    R               REFFLD(FLAG)
     A                                      COLHDG('PURGEABLE ITEM')
     A                                      TEXT('PURGEABLE ITEM')
     A            CMFL03    R               REFFLD(FLAG)
     A                                      TEXT('PRIORITY-inhs + DIARY CAT-mc')
     A*
     A*  Inhouse PDS usage:  This field is used in the
     A*  base/client application by WCMS.  Because Inhouse
     A*  PDS never uses WCMS, this field is being used for the
     A*  purpose of tracking Priority.
     A*
     A*  Valid values in STGTP via 'PRTY'
     A*
     A            CMFL04    R               REFFLD(FLAG)
     A                                      TEXT('HILIGHT DIARY-mc')
     A            CMFL05    R               REFFLD(FLAG)
     A                                      TEXT('DOCUMENT LOCATION')
     A            CMRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('REMARK CODE')
     A            CMIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A*** END   ADD *** 03/05/92 **************************************
     A            DLKEY     R               REFFLD(KEY)
     A            DLSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            DLSYS          1A         TEXT('SYSTEM ID                  ')
     A            DLDCID        12A         TEXT('UNIQUE DOCUMENT ID         ')
     A            DLOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            DLOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            DLOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A            DL#BYT         5S 1       TEXT('NUMBER OF  KBYTES IN DOCUME')
     A            DLDTWR         7  0       TEXT('DATE WRITTEN TO OPT        ')
     A            DLTMWR         6S 0       TEXT('TIME WRITTEN TO OPT        ')
     A            DLUSWR         8A         TEXT('USER WROTE TO OPT          ')
     A            DLPAGS         4S 0       TEXT('DOCUMENT PAGES             ')
     A            DLOPTF         1A         TEXT('OPTICAL STORE FLAG         ')
     A            DLVOL1        10A         TEXT('VOLUME ID-1                ')
     A            DLVOL2        10A         TEXT('VOLUME ID-2                ')
     A            DLVOL3        10A         TEXT('VOLUME ID-3                ')
      *
      ****** TAPE LOCATION INFORMATION *****************************************
     A            DLTAPF         1A         TEXT('TAPE    STORE FLAG         ')
     A            DLDTWT         7  0       TEXT('DATE WRITTEN TO TAPE       ')
     A            DLTMWT         6S 0       TEXT('TIME WRITTEN TO TAPE       ')
     A            DLUSWT         8A         TEXT('USER WROTE TO TAPE         ')
     A            DLTVOL        10A         TEXT('VOLUME ID-OF TAPE          ')
     A*
     A            DLBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            DLFLD1        10A         TEXT('FUTURE USE                 ')
     A            DLSTAT    R               REFFLD(STAT)
     A            DLUSER    R               REFFLD(USER)
     A            DLPGM     R               REFFLD(PGM)
     A            DLTIME    R               REFFLD(TIME)
     A            DLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            DLIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            DLIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            DLTDOC        12A         TEXT('UNIQUE DOCUMENT ID-TAPE    ')
     A*  NEW DOC ID
     A            CVNDOC    R               REFFLD(DCID)
     A*  NEW FOLDER ID
