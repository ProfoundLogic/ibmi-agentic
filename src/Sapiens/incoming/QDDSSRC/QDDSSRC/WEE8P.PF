     A*
     A*  EDI Recoveries File
     A                                      REF(WREFP)
     A          R PE801                     TEXT('Recoveries')
     A*
     A            E8CO#     R               REFFLD(CO#)
     A            E8FND     R               REFFLD(FND)
     A            E8FYR     R               REFFLD(FYR)
     A            E8CASE    R               REFFLD(CASE)
     A            E8LGSQ    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            E8CODE         3          TEXT('Recovery code')
     A            E8AMT     R               REFFLD(A92)
     A                                      TEXT('Recovery amt.')
     A*
     A            E8USER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            E8PGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A            E8DT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            E8TIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
