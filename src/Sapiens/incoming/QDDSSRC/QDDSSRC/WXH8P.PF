     A**
     A** EDI/NOI Transmission Data - Header
     A**
     A                                      REF(WREFP)
     A**
     A          R PH801                     TEXT('EDI 148 Header Format')
     A*
     A***    Transaction
     A*
     A            H8THDR    R    3A         REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'HDR' 'ID')
     A            H8SEIN    R               REFFLD(DS9)
     A                                      COLHDG('SENDER' 'FEIN')
     A            H8FIL1         7A         TEXT('FILLER                      ')
     A            H8SZP     R    9A         REFFLD(ZIP)
     A                                      COLHDG('SENDER' 'POSTAL' 'CODE')
     A            H8REIN    R               REFFLD(DS9)
     A                                      COLHDG('RECEIVER' 'FEIN')
     A            H8FIL2         7A         TEXT('FILLER                      ')
     A            H8RZP     R    9A         REFFLD(ZIP)
     A                                      COLHDG('RECEIVER' 'POSTAL' 'CODE')
     A            H8LTDT    R    8A         REFFLD(DT)
     A                                      COLHDG('DATE' 'TRANSMISSION' 'SENT')
     A            H8LTTM    R    6A         REFFLD(TIME)
     A                                      COLHDG('TIME' 'TRANSMISSION' 'SENT')
     A            H8OTDT    R    8A         REFFLD(DT)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'DATE')
     A            H8OTTM    R    6A         REFFLD(TIME)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'TIME')
     A            H8TPFG    R               REFFLD(FLAG)
     A                                      COLHDG('TEST/' 'PRODUCTION' 'FLAG')
     A            H8TSET    R    3A         REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'SET' 'ID')
     A            H8TRN#    R               REFFLD(CODE)
     A                                      COLHDG('RELEASE' 'NUMBER')
