     A** EMP EXP MOD  FUND MASTER FILE
     A                                      REF(EREFP)
     A          R PFN01                     TEXT('FUND MASTER FILE')
     A            FNCO#     R               REFFLD(CO#)
     A            FNFND     R               REFFLD(FND)
     A            FNNAME    R               REFFLD(NM60)
     A            FNSHNM    R               REFFLD(NM30)
     A                                      COLHDG('FUND' 'SHORT' 'NAME')
     A            FNMAD1    R               REFFLD(ADR1)
     A                                      COLHDG('MAILING' 'ADDRESS 1')
     A            FNMAD2    R               REFFLD(ADR2)
     A                                      COLHDG('MAILING' 'ADDRESS 2')
     A            FNMCTY    R               REFFLD(CTY)
     A                                      COLHDG('MAILING' 'CITY')
     A            FNMST     R               REFFLD(ST)
     A                                      COLHDG('MAILING' 'STATE')
     A            FNMZIP    R               REFFLD(ZIP)
     A                                      COLHDG('MAILING' 'ZIP CODE')
     A            FNEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            FNSTAT    R               REFFLD(STAT)
     A            FNUSER    R               REFFLD(USER)
     A            FNPGM     R               REFFLD(PGM)
     A            FNTIME    R               REFFLD(TIME)
     A            FNDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            FNIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
