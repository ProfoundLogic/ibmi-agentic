     A**
     A** Utilization Review INTERQUAL CASE STATUS FILE
     A*
     A                                      REF(FSREFP)
     A          R PIQ01                     TEXT('INTERQUAL CASE STATUS')
     A            IQCO#     R               REFFLD(CO#) COLHDG('CARRIER#')
     A            IQSUB#    R               REFFLD(SUB#)
     A            IQFND     R               REFFLD(FND) COLHDG('GROUP#')
     A            IQCERT    R               REFFLD(CERT)
     A            IQEXT     R               REFFLD(EXT)
     A                                      COLHDG('PRE-CERT EXTENSION')
     A            IQSPCU    R               REFFLD(DS3) COLHDG('SPECIAL UNIT' +
     A                                      '(BDY SYS) CODE' 'IF SPCUNT')
      *  (2) ADMISSION REVIEW
      *
     A            IQARSN    R               REFFLD(DS40)
     A                                      COLHDG('(2) ADMISSION REASON')
     A            IQADIG    R               COLHDG('ADM DIAGNOSIS' 'CODE')
     A                                      REFFLD(ICD9)
      *  (3) ADMISSION REVIEW

     A            IQSRGS    R               REFFLD(DS40)
     A                                      COLHDG('(3) SURGERY SCHED')
     A            IQSCPT    R               COLHDG('SURGERY CPT4 CODE')
     A                                      REFFLD(CPT4)
     A            IQSDT     R               COLHDG('SURGERY DATE')
     A                                      REFFLD(DT)
      *  (4) CLINICAL
      *
     A            IQCLN1    R               REFFLD(DS40)
     A                                      COLHDG('(4) CLINICAL 1')
     A            IQCLN2    R               REFFLD(DS40)
     A                                      COLHDG('CLINICAL 2')
     A            IQCLN3    R               REFFLD(DS40)
     A                                      COLHDG('CLINICAL 3')
     A            IQCLN4    R               REFFLD(DS40)
     A                                      COLHDG('CLINICAL 4')
      *  (5) LABRATORY (PERTINENT)
      *
     A            IQLAB1    R               REFFLD(DS40)
     A                                      COLHDG('(5) LAB 1')
     A            IQLAB2    R               REFFLD(DS40)
     A                                      COLHDG('LAB 2')
     A            IQLAB3    R               REFFLD(DS40)
     A                                      COLHDG('LAB 3')
      *  (6) RADIOGRAPHY/ULTRASOUNOGRAPHY/TOMOGRAPHY
      *
     A            IQRAD1    R               REFFLD(DS40)
     A                                      COLHDG('(6) RADIOGRAPHY 1')
     A            IQRAD2    R               REFFLD(DS40)
     A                                      COLHDG('RADIOGRAPHY 2')
     A            IQRAD3    R               REFFLD(DS40)
     A                                      COLHDG('RADIOGRAPHY 3')
      *  (7) ORDERS (PERTINENT)
      *
     A            IQORD1    R               REFFLD(DS40)
     A                                      COLHDG('(7) ORDERS 1')
     A            IQORD2    R               REFFLD(DS40)
     A                                      COLHDG('ORDERS 2')
     A            IQORD3    R               REFFLD(DS40)
     A                                      COLHDG('ORDERS 3')
      * (9)   CONTINUING CARE PLAN
     A            IQCRDT    R               REFFLD(DT)
     A                                      COLHDG('(9) CONTINUED CARE' +
     A                                      'REFFERAL DATE')
     A            IQRSN1    R               REFFLD(DS40)
     A                                      COLHDG('REASON 1')
     A            IQRSN2    R               REFFLD(DS40)
     A                                      COLHDG('REASON 2')
     A            IQRSN3    R               REFFLD(DS40)
     A                                      COLHDG('REASON 3')
     A            IQPLN1    R               REFFLD(DS40)
     A                                      COLHDG('PLAN 1')
     A            IQPLN2    R               REFFLD(DS40)
     A                                      COLHDG('PLAN 2')
     A            IQPLN3    R               REFFLD(DS40)
     A                                      COLHDG('PLAN 3')
     A            IQDSP1    R               REFFLD(DS40)
     A                                      COLHDG('DISPOSITION 1')
     A            IQDSP2    R               REFFLD(DS40)
     A                                      COLHDG('DISPOSITION 2')
     A            IQDSP3    R               REFFLD(DS40)
     A                                      COLHDG('DISPOSITION 3')
     A            IQDSCD    R               REFFLD(DT)
     A                                      COLHDG('DISCHARGE DATE')
      *    CURRENT STATUS FLAGS/DATES
     A            IQPAFL    R               REFFLD(FLAG)
     A                                      COLHDG('PRE-ADM  PASSED')
     A            IQPADT    R               REFFLD(DT)
     A                                      COLHDG('PRE-ADM  DATE PASSED')
     A            IQADFL    R               REFFLD(FLAG)
     A                                      COLHDG('ADMISSION PASSED')
     A            IQADDT    R               REFFLD(DT)
     A                                      COLHDG('ADMISSION DAT PASSED')
     A            IQSUFL    R               REFFLD(FLAG)
     A                                      COLHDG('LAST SUBSEQUENT' +
     A                                      'PASSED')
     A            IQSUDT    R               REFFLD(DT)
     A                                      COLHDG('LAST SUBSEQUENT' +
     A                                      'DATE PASSED')
     A            IQDCFL    R               REFFLD(FLAG)
     A                                      COLHDG('DISCHARGE PASSED')
     A            IQDCDT    R               REFFLD(DT)
     A                                      COLHDG('DISCHARGE PASSED' +
     A                                      'DATE')
     A            IQPRFL    R               REFFLD(FLAG)
     A                                      COLHDG('PHYS REVIEW PASSED')
     A            IQPRDT    R               REFFLD(DT)
     A                                      COLHDG('PHYS REVIEW PASSED' +
     A                                      'DATE')
     A            IQVRFL    R               REFFLD(FLAG)
     A                                      COLHDG('VARIENCE REVW PASSED')
     A            IQVRDT    R               REFFLD(DT)
     A                                      COLHDG('VARIENCE REVW PASSED' +
     A                                      'DATE')
     A            IQUSER    R               REFFLD(USER)
     A            IQPGM     R               REFFLD(PGM)
     A            IQTIME    R               REFFLD(TIME)
     A            IQDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            IQIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            IQIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
