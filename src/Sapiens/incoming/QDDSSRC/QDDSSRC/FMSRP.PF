     A                                      COLHDG('Subscriber #')
     A            SREFDT    R               REFFLD(DT)
     A                                      COLHDG('Effective date')
     A            SRPRT1    R               REFFLD(HRRT)
     A                                      COLHDG('Prof rate')
     A            SRNRT1    R               REFFLD(HRRT)
     A                                      COLHDG('Non-prof rate')
     A            SRMRT1    R               REFFLD(MIRT)
     A                                      COLHDG('Mileage rate')
     A            SRSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            SRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance user')
     A            SRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance pgm')
     A            SRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance time')
     A            SRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance date')
     A            SRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial user')
     A            SRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial pgm')
     A            SRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial time')
     A            SRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial date')
