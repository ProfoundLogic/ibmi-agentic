     A** EDI/NOI Log File
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 07/03/97 C:15  PROJECT: 87MBN                                 *
     A*               -Added a flag to indicate whether or not the    *
     A*                837 payment data should be sent to the Anthem  *
     A*                flatfile.                                      *
     A*               -Added a field for the EFT Trace #.             *
     A*               -Changed the usage of LGAENT to indicate the    *
     A*                date the data was sent to the Anthem flatfile. *
     A*****************************************************************
     A                                      REF(FSREFP)
     A**
     A          R PLG01                     TEXT('EDI Record')
     A            LGCO#     R               REFFLD(CO#)
     A            LGSUB#    R               REFFLD(SUB#)
     A            LGFND     R               REFFLD(FND)
     A            LGFYR     R               REFFLD(FYR)
     A            LGCASE    R               REFFLD(CASE)
     A            LGEOB#    R               REFFLD(EOB#)
     A            LGTSET    R    3A         REFFLD(CODE)
     A                                      COLHDG('TRANSACTIONS' 'SET ID')
     A            LGMTC     R               REFFLD(CODE)
     A                                      COLHDG('MAINTENANCE' 'TYPE' 'CODE')
     A            LGJST     R               REFFLD(ST)
     A                                      COLHDG('JURISDICTION' 'STATE')
     A            LGDUE     R               REFFLD(DT)
     A                                      COLHDG('SUBMISSION' 'DUE' 'DATE')
     A            LGSTS     R    2A         REFFLD(STAT)
     A                                      COLHDG('ENTRY STATUS')
     A            LGSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('RELEASE/' 'HOLD' 'STATUS')
     A            LGEXDT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'OF' 'EXTRACT')
     A            LGMTCD    R               REFFLD(DT)
     A                                      COLHDG('MTC' 'DATE')
     A            LGSENT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'SENT TO' 'STATE')
     A            LGARCV    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'ACK' 'RECEIVED')
     A            LGAENT    R               REFFLD(DT)
     A                                      COLHDG('DATE SENT TO ANTHEM' -
     A                                      'FLATFILE')
     A*** 07/03/97 *********************    COLHDG('DATE' 'ACK' 'ENTERED')
     A            LGDSQA    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('MAN ADJUSTER DIARY          ')
     A            LGDSQB    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('MAN SUPERVISOR DIARY        ')
     A            LGDSQC    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('MAN LATE REVIEWER DIARY     ')
     A            LGDSQD    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('COND ADJUSTER DIARY         ')
     A            LGDSQE    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('COND SUPERVISOR DIARY       ')
     A            LGDSQF    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('COND LATE REVIEWER DIARY    ')
     A            LGDSQG    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('ERROR ADJUSTER DIARY        ')
     A            LGDSQH    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGDSQI    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGDSQJ    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGDSQK    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGDSQL    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGDSQM    R               REFFLD(A50)
     A                                      COLHDG('DARTS' 'SEQ #')
     A                                      TEXT('FUTURE USE                  ')
     A            LGHCPY    R    3A         REFFLD(CODE)
     A                                      COLHDG('HARDCOPY' 'FORMAT')
     A            LGSCHP    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'PAPER TO' 'PRINT')
     A            LGPRSQ    R               REFFLD(A50)
     A                                      COLHDG('FROI HARDCOPY' 'DARTS SEQ#')
     A*
     A            LGIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'CREATION' 'USER')
     A            LGIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'CREATION' 'DATE')
     A            LGITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'CREATION' 'TIME')
     A            LGIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'CREATION' 'PGM')
     A            LGUSER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            LGDT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            LGTIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
     A            LGPGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A*** BEGIN ADD *** 07/03/97 ***********************************************
     A            LGANTH    R               REFFLD(FLAG)
     A                                      COLHDG('ANTHEM FLATFILE FLAG')
     A            LGEFT#    R               REFFLD(DS20)
     A                                      COLHDG('EFT Trace #')
