     A          R PPP01AF                   TEXT('Accident Fund Payroll Export')
     A            PPCOID        10A         COLHDG('Company ID')
     A            PPPOL#        25A         COLHDG('Policy #')
     A            PPPOLEFFDT     8S 0       COLHDG('Policy Effective' +
     A                                      'Date')
     A            PPPOLST        2A         COLHDG('Policy State')
     A            PPCLASCOD      5S 0       COLHDG('Payroll Class Code')
     A            PPPERCAPFL     1A         COLHDG('Per Capita Flag')
     A            PPWRITPRAM    11S 2       COLHDG('Written Premium' +
     A                                      'Amount')
     A            PPWRITEXAM    11S 2       COLHDG('Written Exposure' +
     A                                      'Amount')

     A          K PPPOL#
     A          K PPPOLST
     A          K PPPOLEFFDT
     A          K PPCLASCOD
