     A**
     A** SYSTEM-WIDE DISPLAY FILE STATUS DATA STRUCTURE
     A*
     A                                      REF(SREFP)
     A          R PQ201                     TEXT('FILE INFO DS')
     A            Q2FILE    R               REFFLD(FLE)
     A                                      TEXT('FILE NAME')
     A            Q2OPEN    R               REFFLD(OPEN)
     A            Q2EOF     R               REFFLD(STAT)
     A                                      TEXT('END OF FILE 1=E')
     A            Q2STCD    R               REFFLD(STCD)
     A            Q2OPCD    R               REFFLD(OPCD)
     A            Q2RTN     R               REFFLD(RTN)
     A            Q2SSEQ    R               REFFLD(SSEQ)
     A            Q2RCPR    R               REFFLD(RCPR)
     A            Q2EXN1    R               REFFLD(EXN1)
     A            Q2MIO#    R               REFFLD(MIO#)
     A            Q2FL02    R               REFFLD(FL02)
     A            Q2ODPT    R               REFFLD(ODPT)
     A            Q2FL03        44          TEXT('FILLER 44        ')
     A            Q2SPL#         2B 0       TEXT('SPOOL FILE #     ')
     A            Q2FL07        27          TEXT('FILLER 27        ')
     A            Q2LNRW    R               REFFLD(LNRW)
     A            Q2CLCH    R               REFFLD(CLCH)
     A            Q2NREC    R               REFFLD(NREC)
     A            Q2FL04    R               REFFLD(FL04)
     A            Q2OVLN    R               REFFLD(OVLN)
     A            Q2FL05    R               REFFLD(FL05)
     A            Q2RECF    R               REFFLD(RECF)
     A            Q2FL06    R   98          REFFLD(FL05)
     A                                      COLHDG('FILLER 98      ')
     A            Q2IAID    R               REFFLD(OPEN)
     A                                      COLHDG('INPUT AID')
     A            Q2CPOS    R    4B 0       REFFLD(NREC)
     A                                      COLHDG('CURSOR POSITION')
     A            Q2FL08         6          TEXT('FILLER 6')
     A            Q2LSFR         4B 0       COLHDG('LOWEST' 'SUBFILE' +
     A                                      'RECORD #')
