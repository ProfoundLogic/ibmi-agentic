     A            B3CASE         7P 0       COLHDG('Case #')
     A            B3SEQ#         5P 0       COLHDG('Seq #')
     A            B3SS#          9A         COLHDG('Soc Sec #')
     A            B3LSN         30A         COLHDG('Last Name')
     A            B3FSN         15A         COLHDG('First Name')
     A            B3TRDT         8S 0       COLHDG('Transaction Date')
     A            B3AMT          9P 2       COLHDG('Amount')
     A            B3BR2          2A         COLHDG('Pmt Value 1')
     A            B3BR7          2A         COLHDG('Pmt Value 2')
     A            B3NCCI         2A         COLHDG('NCCI Code')
     A            B3FRDT         8S 0       COLHDG('Service From Date')
     A            B3TODT         8S 0       COLHDG('Service To Date')
     A            B3TRCD         2A         COLHDG('Transaction Code')
     A            B3TYPE         1A         COLHDG('Rec Type')
     A            B3DESC        30A         COLHDG('Description')
     A            B3EOB#         9P 0       COLHDG('EOMB#')
