     A                                      REF(WREFP)
     A          R PAU01                     TEXT('A/R Upload Work File')
     A            UPLDRTYPE      1A         COLHDG('Record Type')
     A            UPLDCOUNT      7A         COLHDG('Record Count')
     A            UPLDCO#        3A         COLHDG('Company')
     A            UPLDFND        3A         COLHDG('Group')
     A            UPLDFYR        3A         COLHDG('Fund Year')
     A            UPLDEMP#       9A         COLHDG('Employer')
     A            UPLDDIV        5A         COLHDG('Division')
     A            UPLDARCD       2A         COLHDG('A/R Code')
     A            UPLDDESC      30A         COLHDG('A/R Code Description')
     A            UPLDPODT      10A         COLHDG('Post Date')
     A            UPLDCHK#       7A         COLHDG('Check Number')
     A            UPLDCKAM      10A         COLHDG('Check Amount')
     A            UPLDAMT       10A         COLHDG('Posted Amount')
     A            UPLDTRDT      10A         COLHDG('Transaction Date')
     A            UPLDLATE       1A         COLHDG('Late Flag')
     A            UPLDACHF       1A         COLHDG('EFT Flag')
     A            UPLDCASH       1A         COLHDG('Cash Dissolve Flag')
