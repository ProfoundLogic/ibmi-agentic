     A                                      COLHDG('KEY FIELD' '3A')
     A            ATTYP1    R               REFFLD(FLAG) COLHDG('M/V')
     A*           VALID VALUES: FTGTP VIA "MVFL"
     A*
     A            ATTYP2    R               REFFLD(FLAG) COLHDG('P/N')
     A            ATDESC    R               REFFLD(DS40)
     A                                      COLHDG('ACTIVITY' 'CODE DESC')
     A            ATEXPN    R               REFFLD(FLAG)
     A                                      COLHDG('EXPENSE' 'Y/N')
     A            ATBNON    R               REFFLD(FLAG)
     A                                      COLHDG('BILLABLE' 'Y/N')
     A            ATMSCG    R               REFFLD(MSCG)
     A                                      COLHDG('DEFAULT' 'MISC. CHG')
     A            ATSTAT    R               REFFLD(STAT)
     A            ATUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A            ATPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PGM')
     A            ATTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A            ATDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A            ATIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ATIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
