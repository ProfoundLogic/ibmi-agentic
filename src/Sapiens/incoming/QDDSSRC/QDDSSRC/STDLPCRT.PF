     A                                      REF(SREFP)
     A          R PDL01                     TEXT('DOCUMENTS/LETTERS FILE')
     A            DLCO#     R     S         REFFLD(CO#)
     A            DLCAT     R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT CATEGORY')
     A            DLSUBC    R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT' 'SUB CATEGORY')
     A            DLDCID        60A         COLHDG('DOCUMENT NAME/ID')
     A            DLINID        60A         COLHDG('INTERACTIVE DOC ID')
     A            DLLANG        40A         COLHDG('DOCUMENT LANGUAGE')
     A            DLCRITID      25A         COLHDG('CRITERIA ID')
     A            DLCRITVAL     50A         COLHDG('CRITERIA VALUE')
     A*
     A            DLUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            DLPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            DLTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            DLDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            DLIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            DLIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            DLITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            DLIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            DLSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
