     A*********************************************************************
     A*  WORKERS' COMP WCPOLS ADDRESS REPORTING FILE
     A*
     A                                      REF(WREFP)
     A          R PAD01                     TEXT('WCPOLS ADDR REPORTING FILE')
     A            ADCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            ADFND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            ADEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            ADFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            ADUNID    R     S         REFFLD(A120)
     A                                      COLHDG('UNIQUE IDENTIFIER')
     A            ADST      R               REFFLD(ST)
     A                                      COLHDG('REPORTING BUREAU')
     A            ADTRDT         7S 0       COLHDG('TRANSACTION DATE')
     A            ADFRDT         7S 0       COLHDG('ADDR EFFECTIVE DATE')
     A            ADTODT         7S 0       COLHDG('ADDR EXPIRATION DATE')
     A            ADDLDT         7S 0       COLHDG('ADDR DELETION DATE')
     A            ADDRPD         7S 0       COLHDG('DELETION REPORT DATE')
     A            ADLINK         3S 0       COLHDG('NAME LINK CODE')
     A            ADLNKC         2S 0       COLHDG('NAME LINK COUNTER')
     A            ADSTCD         2S 0       COLHDG('STATE CODE LINK')
     A            ADELCD         5S 0       COLHDG('EXPOSURE LINK CODE')
     A            ADATYP    R               REFFLD(FLAG)
     A                                      COLHDG('ADDRESS TYPE')
     A            ADADDR       200A         COLHDG('FULL ADDRESS')
     A            ADSTRE        60A         COLHDG('ADDRESS STREET')
     A            ADCITY        30A         COLHDG('ADDRESS CITY')
     A            ADAST          2A         COLHDG('ADDRESS STATE')
     A            ADZIP          9S 0       COLHDG('ADDRESS ZIP CODE')
     A            ADFORA    R               REFFLD(FLAG)
     A                                      COLHDG('FOREIGN ADDRESS FLAG')
     A            ADGEOA        40A         COLHDG('GEOGRAPHIC AREA')
     A            ADCOUN         2A         COLHDG('COUNTRY CODE')
     A            ADAREA         3S 0       COLHDG('AREA CODE')
     A            ADPHN#         7S 0       COLHDG('PHONE NUMBER')
     A            ADEMPY         7S 0       COLHDG('NUMBER OF EMPLOYEES')
     A            ADSIC          6A         COLHDG('SIC/NAICS CODE')
     A            ADUSER    R               REFFLD(USER)
     A            ADPGM     R               REFFLD(PGM)
     A            ADTIME    R     S         REFFLD(TIME)
     A            ADDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ADIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ADIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            ADITM     R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            ADIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
