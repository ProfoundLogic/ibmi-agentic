     A                                      REF(FSREFP)
     A          R PMC01                     TEXT('MED SVC CODE TABLE FILE')
     A            MCCO#     R               REFFLD(CO#)
     A            MCKEY     R               REFFLD(KEY)
     A                                      COLHDG('MED SVC' 'CD 4-A')
     A            MCDESC    R               REFFLD(DS60)
     A            MCEXCM    R               REFFLD(FLAG)
     A                                      COLHDG('EXTERNAL' 'CASE MGMT')
     A***                                     Valid Values:
     A***                                        Y = External Case Mgmt done
     A***                                        N = External Case Mgmt NOT done
     A            MCSYS     R               REFFLD(FLAG)
     A                                      COLHDG('SYSTEM CODE')
     A            MCSTAT    R               REFFLD(STAT)
     A                                      COLHDG('RCD' 'STS')
     A            MCUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT' 'USER')
     A            MCPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT' 'PGM')
     A            MCTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT' 'TIME')
     A            MCDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT' 'DATE')
     A            MCIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            MCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            MCITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
      ***** BEG ADD ****** 04/16/98 ************************************
     A            MCSSVC    R               REFFLD(FLAG)
     A                                      COLHDG('Sub-service flag')
      *                                       Valid values:
      *                                          Y = Sub-service code
      *                                          N = Primary code
      *
     A            MCRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('Diary remark code')
      *                                       Valid values: STCTP
     A            MCCMFL    R               REFFLD(FLAG)
     A                                      COLHDG('IS THIS A CM CODE?')
      *                                       Valid values:
      *                                          Y = YES
      *                                          N = NO
