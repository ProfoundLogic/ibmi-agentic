     A*
     A*  EDI Benefits File
     A                                      REF(WREFP)
     A          R PE201                     TEXT('Benefits file')
     A*
     A            E2CO#     R               REFFLD(CO#)
     A            E2FND     R               REFFLD(FND)
     A            E2FYR     R               REFFLD(FYR)
     A            E2CASE    R               REFFLD(CASE)
     A            E2LGSQ    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            E2BTCD    R               REFFLD(CSCD)
     A                                      TEXT('Benefit type code')
     A            E2GRAM    R               REFFLD(A92)
     A                                      TEXT('Gross weekly amt.')
     A            E2GREF    R               REFFLD(DT)
     A                                      TEXT('Gross weekly eff DT')
     A            E2NTAM    R               REFFLD(A92)
     A                                      TEXT('Net weekly amt.')
     A            E2NTEF    R               REFFLD(DT)
     A                                      TEXT('Net weekly eff DT')
     A            E2FRDT    R               REFFLD(DT)
     A                                      TEXT('Benefit per. start DT')
     A            E2TODT    R               REFFLD(DT)
     A                                      TEXT('Benefit per. thru DT')
     A            E2WKS     R               REFFLD(A40)
     A                                      TEXT('Benefit type clm weeks')
     A            E2DAYS    R               REFFLD(DAYS)
     A                                      TEXT('Benefit type clm days')
     A            E2AMT     R               REFFLD(A92)
     A                                      TEXT('Benefit type amt pd')
     A            E2PIDT    R               REFFLD(DT)
     A                                      TEXT('Payment issue DT')
     A*
     A            E2USER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            E2PGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A            E2DT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            E2TIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
