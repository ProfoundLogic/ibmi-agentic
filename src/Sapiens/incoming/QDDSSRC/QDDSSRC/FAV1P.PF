     A*
     A* Corvel Payment File - Header
     A*
     A*****************************************************************
     A* Created on 08/30/2002 by c:62 for Project 128MAC
     A*****************************************************************
     A* Purpose: This file will house the 'bill header' record for the
     A*          associated Corvel records.  Additional fields will be
     A*          added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAV9P record via V1NAME.
     A*****************************************************************
     A* Revisions:
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PV101                     TEXT('Corvel Payment File - header')
     A            V1TYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Record Type')
     A            V1CNTL    R               REFFLD(DS12)
     A                                      COLHDG('Control Number')
     A            V1LOC     R               REFFLD(DS12)
     A                                      COLHDG('Customer Location')
     A            V1RCDT    R               REFFLD(DT8)
     A                                      COLHDG('Receive Date')
     A            V1PRSD    R               REFFLD(DT8)
     A                                      COLHDG('Process Date')
     A            V1CLID    R               REFFLD(DS20)
     A                                      COLHDG('Claim ID')
     A            V1REF1    R               REFFLD(DS5)
     A                                      COLHDG('Reference 1')
     A            V1REF2    R               REFFLD(DS10)
     A                                      COLHDG('Reference 2')
     A            V1DOI     R               REFFLD(DT8)
     A                                      COLHDG('Date of Injury')
     A            V1ICD1    R               REFFLD(DS10)
     A                                      COLHDG('ICD9 code 1')
     A            V1ICD2    R               REFFLD(DS10)
     A                                      COLHDG('ICD9 code 2')
     A            V1ICD3    R               REFFLD(DS10)
     A                                      COLHDG('ICD9 code 3')
     A            V1ICD4    R               REFFLD(DS10)
     A                                      COLHDG('ICD9 code 4')
     A            V1BTYP    R               REFFLD(DS3)
     A                                      COLHDG('Bill Type')
     A            V1BLTY    R               REFFLD(FLAG)
     A                                      COLHDG('Inpat/Outpat')
     A            V1PCON    R               REFFLD(DS9)
     A                                      COLHDG('Patient Control #')
     A            V1BLST    R               REFFLD(CODE)
     A                                      COLHDG('Bill Status')
     A            V1ADDT    R               REFFLD(DT8)
     A                                      COLHDG('Admit Date')
     A            V1DRG          3S 0
     A                                      COLHDG('DRG')
     A            V1CFDT    R               REFFLD(DT8)
     A                                      COLHDG('Covers from Date')
     A            V1CTDT    R               REFFLD(DT8)
     A                                      COLHDG('Covers to Date')
     A            V1COST         6S 2
     A                                      COLHDG('MedCheck Charge')
     A            V1FDTS    R               REFFLD(DT8)
     A                                      COLHDG('From date of Service')
     A            V1TDTS    R               REFFLD(DT8)
     A                                      COLHDG('Thru date of Service')
     A            V1LIN#         6S 0
     A                                      COLHDG('Number of Lines')
     A            V1CHRG    R     S         REFFLD(A112)
     A                                      COLHDG('Charged')
     A            V1MRA     R     S         REFFLD(A112)
     A                                      COLHDG('MRA Reduction')
     A            V1NDIS    R     S         REFFLD(A112)
     A                                      COLHDG('Network Reductions')
     A            V1PAID    R     S         REFFLD(A112)
     A                                      COLHDG('Paid Amount')
     A            V1BDAT    R               REFFLD(DT8)
     A                                      COLHDG('Date Bill Created')
     A            V1PPAY    R     S         REFFLD(A92)
     A                                      COLHDG('Prompt Pay Discount')
     A            V1PPYD    R               REFFLD(DT6)
     A                                      COLHDG('Prompt Pay Date')
     A            V1CHK#    R               REFFLD(DS10)
     A                                      COLHDG('Check Number')
     A            V1CHKD    R               REFFLD(DT8)
     A                                      COLHDG('Check Date')
     A            V1ADJ     R               REFFLD(DS6)
     A                                      COLHDG('Adjustor ID')
     A            V1REF3    R               REFFLD(DS15)
     A                                      COLHDG('Reference 3')
     A            V1REF4        32A
     A                                      COLHDG('Reference 4')
     A            V1ORIM    R               REFFLD(CODE)
     A                                      COLHDG('Original Machine')
     A            V1ORIS    R               REFFLD(CODE)
     A                                      COLHDG('Original State')
     A            V1ORIB    R               REFFLD(DS6)
     A                                      COLHDG('Original Batch #')
     A            V1ORSH    R               REFFLD(CODE)
     A                                      COLHDG('Original Sheet #')
     A            V1LOB     R               REFFLD(DS4)
     A                                      COLHDG('Line of Business')
     A            V1FILL         1A
     A                                      COLHDG('Filler')
     A*****************************************************************
     A            V1CSS#    R               REFFLD(SS#)
     A                                      COLHDG('(CRV) SS#')
     A            V1CNAM    R               REFFLD(DS30)
     A                                      COLHDG('(CRV) Claimant Name')
     A            V1NAME    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Member name')
     A            V1MBR#    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Member #')
     A            V1CO#     R               REFFLD(CO#)
     A                                      COLHDG('(PDS) Company #')
     A            V1SUB#    R               REFFLD(SUB#)
     A                                      COLHDG('(PDS) Subscriber #')
     A            V1FND     R               REFFLD(FND)
     A                                      COLHDG('(PDS) Group #')
     A            V1FYR     R               REFFLD(FYR)
     A                                      COLHDG('(PDS) Year')
     A            V1CASE    R               REFFLD(CASE)
     A                                      COLHDG('(PDS) Case #')
     A            V1SS#     R               REFFLD(SS#)
     A                                      COLHDG('(PDS) SS#')
     A            V1ACDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) ACDT')
     A            V1FEIN    R               REFFLD(FEIN)
     A                                      COLHDG('(PDS) FEIN')
     A            V1MOD     R               REFFLD(MOD)
     A                                      COLHDG('(PDS) Provider Mod')
     A            V1EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB')
     A            V1RCN     R               REFFLD(RCN)
     A                                      COLHDG('(PDS) RCN')
     A            V1DLUS    R               REFFLD(USER)
     A                                      COLHDG('(PDS) Delete User')
     A            V1DLPG    R               REFFLD(PGM)
     A                                      COLHDG('(PDS) Delete Pgm')
     A            V1DLTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Delete Time')
     A            V1DLDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Delete Date')
     A            V1DLRE    R               REFFLD(DS70)
     A                                      COLHDG('(PDS) Delete Reason')
     A            V1PRDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Process Date')
     A            V1PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A*
     A*                                     *blank = not processed yet
     A*                                     "D" = Deleted
     A*                                     "E" = Error
     A*                                     "Y" = written to WCMC
