     A**
     A** Utilization Review INTERQUAL CREITERIA RULES FILE
     A                                      REF(FSREFP)
     A          R PRL01                     TEXT('INTERQUAL CRITERIA RULES')
     A            RLTYPE    R               REFFLD(DS3) COLHDG('REVIEW TYPE')
     A            RLUNIT    R               REFFLD(DS3) COLHDG('SPECIAL UNIT' +
                                            'ICU ETC.')
     A            RLNEFL    R               REFFLD(FLAG) COLHDG('NEW OR' +
                                            'EXISTING' 'N/E')
     A            RL#IS     R               REFFLD(A30)
     A                                      COLHDG('# OF IS CRITERIA' +
                                            'TO BE MET')
     A            RL#SI     R               REFFLD(A30)
     A                                      COLHDG('# OF SI CRITERIA' +
                                            'TO BE MET')
     A            RLAOR     R               REFFLD(FLAG) COLHDG('AND/OR' 'FLAG +
     A                                      FOR IS/SI' '1/0')
     A            RLMSGI    R    7A         REFFLD(DS8)
     A                                      COLHDG('MESSAGE ID FOR ERROR')
     A            RLSTAT    R               REFFLD(STAT)
     A            RLUSER    R               REFFLD(USER)
     A            RLPGM     R               REFFLD(PGM)
     A            RLTIME    R               REFFLD(TIME)
     A            RLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            RLIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            RLIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
