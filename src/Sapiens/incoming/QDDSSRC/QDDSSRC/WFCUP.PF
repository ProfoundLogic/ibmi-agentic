     A*
     A* WFCUP - WORKERS' COMP CUMULATIVE LOSS RATIO OUTPUT WORKFILE
     A*****************************************************************
     A*                                                               *
     A* PROGRAM DESCRIPTION:                                          *
     A*                                                               *
     A* THIS PROGRAM IS AN OUTPUT FILE FROM THE CUMULATIVE LOSS RATIO *
     A* REPORT.  IT IS FOR USE BY THE CLIENT AS INPUT FOR QUERIES,    *
     A* SPREADSHEETS, ETC. RECORDS ARE WRITTEN AT DETAIL LEVEL.       *
     A*                                                               *
     A*****************************************************************
     A*                                                               *
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 06/18/00  C:61 PROJECT WC577                                  *
     A*                Adapted from CLT048, modified for BASE.        *
     A*                                                               *
     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PCF01                     TEXT('CUM LOSS RATIO OUTFILE')
      *
     A            CFCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
      *
     A            CFCNAM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY' 'NAME')
      *
     A            CFFND     R     S         REFFLD(FND)
     A                                      COLHDG('FUND')
      *
     A            CFFNAM    R               REFFLD(NM60)
     A                                      COLHDG('GROUP' 'NAME')
      *
     A            CFEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER NUMBER')
      *
     A            CFDIV     R     S         REFFLD(DIV)
     A                                      COLHDG('DIVISION')
      *
     A            CFFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
      *
     A            CFENAM    R               REFFLD(NAME)
     A                                      COLHDG('EMPLOYER NAME')
      *
     A            CFEFDT    R     S         REFFLD(DT8)
     A                                      COLHDG('EFFECTIVE DATE')
      *
     A            CFCNDT    R     S         REFFLD(DT8)
     A                                      COLHDG('CANCEL DATE')
      *
     A            CFWALS    R               REFFLD(FLAG)
     A                                      COLHDG('WATCH' 'LIST' 'FLAG')
      *
     A            CFEXM1    R     S         REFFLD(PC54)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 1')
      *
     A            CFEMD1    R     S         REFFLD(DT8)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 1')
      *
     A            CFEXM2    R     S         REFFLD(PC54)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 2')
      *
     A            CFEMD2    R     S         REFFLD(DT8)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 2')
      *
     A            CFEXM3    R     S         REFFLD(PC54)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 3')
      *
     A            CFEMD3    R     S         REFFLD(DT8)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 3')
      *
     A            CFPREM        15S 2       COLHDG('EARNED' 'PREMIUM')
      *
     A            CFTOTC         9S 0       COLHDG('TOTAL CLMS' 'COUNT')
      *
     A            CFOPEN         9S 0       COLHDG('OPEN CLAIMS' 'COUNT')
      *
     A            CFITOT        15S 2       COLHDG('TOTAL' 'INCURRED')
      *
     A            CFPTOT        15S 2       COLHDG('TOTAL' 'PAID')
      *
     A            CFLOSS         7S 2       COLHDG('LOSS' 'RATIO')
      *
     A            CFFREQ         6S 2       COLHDG('FREQUENCY')
      *
     A            CFCNTY    R               REFFLD(CODE)
     A                                      COLHDG('COUNTY' 'CODE')
      *
     A            CFCNDS    R               REFFLD(DS30)
     A                                      COLHDG('COUNTY' 'DESCRIPTION')
      *
     A            CFCHAP         3S 0
     A                                      COLHDG('CHAPTER')
      *
     A            CFCHDS    R               REFFLD(DS30)
     A                                      COLHDG('CHAP' 'DESCRIPTION')
      *
     A            CFRGN#         3S 0
      *
     A            CFREDS    R               REFFLD(DS30)
     A                                      COLHDG('REGION' 'DESCRIPTION')
      *
     A            CFAGT#         5S 0
     A                                      COLHDG('AGENT #')
      *
     A            CFANAM    R               REFFLD(NAME)
     A                                      COLHDG('AGENT' 'NAME')
      *
     A            CFUSER    R               REFFLD(USER)
     A            CFPGM     R               REFFLD(PGM)
     A            CFTIME    R               REFFLD(TIME)
     A            CFDT      R               REFFLD(DT7S)
      *
