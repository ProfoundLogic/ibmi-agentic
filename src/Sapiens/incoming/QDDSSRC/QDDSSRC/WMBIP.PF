     A**
     A*********************************************************************
     A** WORKERS' COMP BANK INFORMATION FILE (MICR CHECKS)                *
     A*                                                                   *
     A*  REVISIONS:                                                       *
     A*                                                                   *
     A*  03/06/19 C:180 Project 126WFR                                    *
     A*                 Increase size of text on check                    *
     A*                                                                   *
     A*  08/22/18 C:180 Project 126WFR                                    *
     A*                 Added following fields                            *
     A*                 1) Text on Check                                  *
     A*                                                                   *
     A*  05/21/18 C:062 Project 129WVC                                    *
     A*                 Add no blank comment for BI1A2                    *
     A*                                                                   *
     A*  04/17/12 C:282 Project WC2044                                    *
     A*                 Added following fields                            *
     A*                 1) EFT Flag                                       *
     A*                                                                   *
     A*  03/12/12 C:255 Project 114WDE                                    *
     A*                 Added following fields                            *
     A*                 1) EFT Credit Comp. Id                            *
     A*                 2) EFT Debit Comp. Id                             *
     A*                                                                   *
     A*  04/19/10 C:235 Project 25WRG                                     *
     A*                 CLAIMS GENERAL RETROFIT                           *
     A*                                                                   *
     A*  09/11/06 C:15  Support: WC051/54678                              *
     A*           04/05/98 C:02 PROJECT:                                  *
     A*           ADD FIELD BIPNET FOR USE IN CHECK PROCESSING FOR        *
     A*           WORKSRIGHT SOFTWARE EDITS                               *
     A*                                                                   *
     A*  02/25/00 C:112 Project 48WRK
     A*                 Add four new fields for Temporary and Permanent
     A*                 Total codes with corresponding Form types.        *
     A*                 These fields accommodate requirement for          *
     A*                 multiple spool files with different check         *
     A*                 stocks for each                                   *
     A*                                                                   *
     A*  02/24/00 C:112 Project: 48WUV                                    *
     A*                 Field BI50N3 will now be used to hold the number  *
     A*                 of days which will print on the check. The        *
     A*                 description for the field is changed to read      *
     A*                 'Void after x days'                               *
     A*                                                                   *
     A*  04/15/97 C:30  Project: WC500                                    *
     A*           Check/Voucher Process                                   *
     A*           Add 14 fields BIEFDT (Effective Date), BIAPPL (Applica- *
     A*           tion), BIFTYP (Formtype), BIOUTQ (OUTQ), BICPYQ (File   *
     A*           Copy OUTQ), BIANTH (Anthem Flag), BINAM1 (Signature     *
     A*           Name 1), BICMD1 (PCL5 string 1), BINAM2 (Signature Name *
     A*           2), BICMD2 (PCL5 string 2), BIMACR (Printer MACRO #),   *
     A*           BIHDCY (Hardcopy Produced?), BIACCT (Bank Acct), and    *
     A*           BICKTP (Check Type).                                    *
     A*********************************************************************
     A                                      REF(WREFP)
     A          R PBI01                     TEXT('BANK INFO FILE')
     A            BICO#     R               REFFLD(CO#)
     A            BIFND     R               REFFLD(FND)
     A            BICKH1    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADING' 'ONE')
     A            BICKH2    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADING' 'TWO')
     A            BIAI01    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'ONE')
     A            BIAI02    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'TWO')
     A            BIAI03    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'THREE')
     A            BIAI04    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'FOUR')
     **
     *****  ON-US 19A USUALLY = ACCOUNT NUMBER *** MAY NOT PRINT ENTIRE
     **                          19 CHARACTERS
     **
     A            BIONUS    R   19          REFFLD(DS20)
     A                                      COLHDG('ON-US FLD' 'UP TO 19A')
     **
     *****  TRANSIT # CONSISTING OF (TRANSIT SYMBOL + CK DIGIT + BANK# +
     **                              ROUTING# + TRANSIT SYMBOL) (11 A)
     **
     A            BICKDG    R    1          REFFLD(FLAG)
     A                                      COLHDG('TRANSIT' 'CHECK DIGIT')
     A            BIBNK#    R    4          REFFLD(DS10)
     A                                      COLHDG('TRANSIT' 'BANK #')
     A            BITRNS    R    4          REFFLD(DS10)
     A                                      COLHDG('TRANSIT' 'ROUTING #')
     **
     *****  AUXILLARY ON-US (DEFINED BY BANK) UPTO 21 A *** CHECK # ***
     **
     A            BIAXOU    R   21          REFFLD(ADR2)
     A                                      COLHDG( 'AUX' 'ON-US FLD' +
     A                                      'UPTO 21A(CHK#)')
     A            BISTAT    R               REFFLD(STAT)
     A            BIUSER    R               REFFLD(USER)
     A            BIPGM     R               REFFLD(PGM)
     A            BITIME    R               REFFLD(TIME)
     A            BIDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            BI#CF          2  0       COLHDG('# OF FILE COPIES')
     A            BIRTUP         7          COLHDG('ROUTING ENTRY UPPER')
     A            BIRTLW         7          COLHDG('ROUTING ENRTY LOWER')
     A            BITRST    R               REFFLD(FLAG)
     A                                      COLHDG('TRUST?' 'Y/N')
     A            BILOGO    R               REFFLD(FLAG)
     A                                      COLHDG('LOGO?' 'Y/N')
     A            BI$LMT    R               REFFLD(A90)
     A                                      COLHDG('$LIMIT' 'W/O SIGN')
     A*
     A*** ADDITIONAL FIELDS *** MAY BE USED FOR FUTURE PROCESSING
     A******* 1 ALPHA FIELDS
     A            BI1A1     R               REFFLD(FLAG)
     A                                      COLHDG('EFT PROCESSING FLAG')
     A            BI1A2     R               REFFLD(FLAG)
     A                                      COLHDG('Blank Signature Line')
     A            BI1A3     R               REFFLD(FLAG)
     A            BI1A4     R               REFFLD(FLAG)
     A            BI1A5     R               REFFLD(FLAG)
     A******* 10 ALPHA FIELDS
     A            BI10A1    R               REFFLD(DS10)
     A                                      COLHDG('SIG 1 STRING')
     A            BI10A2    R               REFFLD(DS10)
     A                                      COLHDG('SIG 2 STRING')
     A            BI10A3    R               REFFLD(DS10)
     A******* 5.0 NUMERIC FIELDS
     A            BI50N1    R               REFFLD(A50)
     A                                      COLHDG('SIG 1 SUBSCRIPT')
     A            BI50N2    R               REFFLD(A50)
     A                                      COLHDG('SIG 2 SUBSCRIPT')
     A            BI50N3    R               REFFLD(A50)
      *** BEGIN ADD *** 02/24/00 **************************************
     A                                      COLHDG('VOID AFTER x DAYS')
      *** END ADD ***** 02/24/00 **************************************
     A******* 9.2 NUMERIC FIELDS
     A            BI92N1    R               REFFLD(A92)
     A            BI92N2    R               REFFLD(A92)
     A            BI92N3    R               REFFLD(A92)
     A            BI92N4    R               REFFLD(A92)
     A            BI92N5    R               REFFLD(A92)
      *** BEGIN ADD *** 04/15/97 ******************************************
     A            BIEFDT    R               REFFLD(DT)
     A                                      COLHDG('Effective Date')
     A            BIAPPL    R               REFFLD(CODE)
     A                                      COLHDG('Application' 'Code')
     A            BIFTYP    R               REFFLD(DS10)
     A                                      COLHDG('Form Type')
     A            BINAM1    R               REFFLD(DS30)
     A                                      COLHDG('Signature 1' 'Full Name')
     A            BICMD1        23A
     A                                      COLHDG('Sig 1' 'PCL5 CMD')
     A            BINAM2    R               REFFLD(DS30)
     A                                      COLHDG('Signature 2' 'Full Name')
     A            BICMD2        23A
     A                                      COLHDG('Sig 2' 'PCL5 CMD')
     A            BIMACR         4S 0
     A                                      COLHDG('Macro ID')
     A            BIHDCY    R               REFFLD(FLAG)
     A                                      COLHDG('Hardcopy' 'Produced?' 'Y/N')
     A            BIOUTQ    R               REFFLD(DS10)
     A                                      COLHDG('Check OUTQ')
     A            BICPYQ    R               REFFLD(DS10)
     A                                      COLHDG('File Copy' 'OUTQ')
     A            BIANTH    R               REFFLD(FLAG)
     A                                      COLHDG('Anthem' 'Y/N')
     A            BIACCT    R               REFFLD(DS20)
     A                                      COLHDG('Bank Account #')
     A            BICKTP    R               REFFLD(DS10)
     A                                      COLHDG('Check' 'Type')
      *** END   ADD *** 04/15/97 ******************************************
     A            BIST      R               REFFLD(CODE)
     A                                      COLHDG('Acct' 'State')
     A            BI40A1    R               REFFLD(DS40)
     A                                      COLHDG('DESC 40A 1')
     A            BI40A2    R               REFFLD(DS40)
     A                                      COLHDG('DESC 40A 2')
     A            BI40A3    R               REFFLD(DS40)
     A                                      COLHDG('DESC 40A 3')
     A            BI40A4    R               REFFLD(DS40)
     A                                      COLHDG('DESC 40A 4')
      *** BEGIN ADD *** 02/25/00 **************************************
     A            BITTCD         2A
     A                                      COLHDG('Temporary Total Code')
     A            BIPTCD         2A
     A                                      COLHDG('Permanent Total Code')
     A            BITTFT        10A
     A                                      COLHDG('Temp Total Form Type')
     A            BIPTFT        10A
     A                                      COLHDG('Perm Total Form Type')
      *** END ADD ***** 02/25/00 **************************************
     A*** BEGIN ADD *** 09/11/06 **************************************
     A            BIPNET    R               REFFLD(FLAG)
     A                                      COLHDG('PRINT' 'POSTNET' +
     A                                      'BARCODE')
     A*** END ADD *** 09/11/06 ****************************************
      *******BEG ADD********04/19/10***********************************
     A            BICKPV    R               REFFLD(DS40)
     A                                      COLHDG('Claim check' +
     A                                      'print value')
      *******END ADD********04/19/10***********************************
      *******Beg Add********03/12/12***********************************
     A            BICCID    R               REFFLD(DS10)
     A                                      COLHDG('EFT CREDIT' +
     A                                      'COMP ID')
     A            BIDCID    R               REFFLD(DS10)
     A                                      COLHDG('EFT DEBIT' +
     A                                      'COMP ID')
      *******End Add********03/12/12***********************************
      *******Beg Add********04/17/12***********************************
     A            BIEFTC    R               REFFLD(FLAG)
     A                                      COLHDG('EFT FLAG')
      *******End Add********04/17/12***********************************
      *******Beg Add********08/22/18***********************************
     A            BITXTONCK R               REFFLD(DS20)
     A                                      COLHDG('Text On Check')
      *******End Add********08/22/18***********************************
      *******Beg Add********03/06/19***********************************
     A            BITXTONCK2R               REFFLD(DS20)
     A                                      COLHDG('Text On Check 2')
      *******End Add********03/06/19***********************************
