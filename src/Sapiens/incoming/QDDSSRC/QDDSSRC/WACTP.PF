     A** WORKERS' COMP CLAIM TRANSFER FILE
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 12/10/03 C:15  Project: WC1172                                *
     A*                Added 3 fields.  1st field will hold the total *
     A*                incurred on the claim when it was deleted or   *
     A*                transferred.  The 2nd field will hold reserve  *
     A*                changes the occurred within the month the claim*
     A*                was deleted or transferred.                    *
     A*                The 3rd field will hold the total paid within  *
     A*                the month the claim was transferred.           *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PCT01                     TEXT('CLAIM TRANSFER FILE')
     A            CTCO#     R               REFFLD(CO#)
     A            CTFND     R               REFFLD(FND)
     A            CTFYR     R               REFFLD(FYR)
     A                                      COLHDG('TO FYR')
     A            CTEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('TO EMP#')
     A            CTDIV     R               REFFLD(DIV)
     A                                      COLHDG('TO DIV')
     A            CTCASE    R               REFFLD(CASE)
     A                                      COLHDG('TO CASE')
     A            CTSS#     R               REFFLD(SS#)
     A                                      COLHDG('TO SS#')
     A            CTCLAS    R               REFFLD(CLAS)
     A                                      COLHDG('TO CLASS')
     A            CTACDT    R               REFFLD(DT)
     A                                      COLHDG('TO ACCIDENT' 'DATE')
     A            CTXFYR    R               REFFLD(FYR)
     A                                      COLHDG('FROM FYR')
     A            CTXEMP    R               REFFLD(EMP#)
     A                                      COLHDG('FROM EMP#')
     A            CTXDIV    R               REFFLD(DIV)
     A                                      COLHDG('FROM DIV')
     A            CTXCAS    R               REFFLD(CASE)
     A                                      COLHDG('FROM CASE')
     A            CTXSS#    R               REFFLD(SS#)
     A                                      COLHDG('FROM SS#')
     A            CTXCLS    R               REFFLD(CLAS)
     A                                      COLHDG('FROM CLASS')
     A            CTXACD    R               REFFLD(DT)
     A                                      COLHDG('FROM ACCIDENT' 'DATE')
     A            CTREQ     R               REFFLD(NM30)
     A                                      COLHDG('REQUEST' 'BY')
     A            CTDET#         5  0
     A                                      COLHDG('# DETAIL' 'CHANGES')
     A            CTPRT     R               REFFLD(FLAG)
     A                                      COLHDG('PRINT' 'FLAG')
     A            CTUSER    R               REFFLD(USER)
     A            CTPGM     R               REFFLD(PGM)
     A            CTTIME    R               REFFLD(TIME)
     A            CTDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            CTTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            CTAMT     R               REFFLD(A112)
     A                                      COLHDG('AMOUNT TRANSFERRED')
     A            CTDLTR    R               REFFLD(CODE)
     A                                      COLHDG('CLAIM DELETION CODE')
     A*** Begin add *** 12/10/03 **************************************
     A            CTTINC    R               REFFLD(A112)
     A                                      COLHDG('TOTAL INCURRED')
     A            CTRSV     R               REFFLD(A112)
     A                                      COLHDG('CURRENT MONTH' 'RSV CHG')
     A            CTPAID    R               REFFLD(A112)
     A                                      COLHDG('CURRENT MONTH' 'PAID')
     A*** End add ***** 12/10/03 **************************************
