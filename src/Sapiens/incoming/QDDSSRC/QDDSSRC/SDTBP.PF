     A                                      REF(SREFP)
     A          R PTB01                     TEXT('Application Config +
     A                                      Security File')
     A            TBCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TBFILE        10A         COLHDG('Display File Name')
     A            TBPGMNAME     50A         COLHDG('Program Name')
     A            TBTABNAME     50A         COLHDG('Tab Name')
     A            TBUSERPRF     10A         COLHDG('User Profile')
     A            TBUSRNAME     50A         COLHDG('User Name')
     A            TBUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TBPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            TBTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TBDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TBIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TBIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            TBITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TBIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
