     A*                                                               *
     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PCK01                     TEXT('MONTHLY CK REG WORKFILE')
      *
     A            CKCO#          3S 0
     A                                      COLHDG('COMPANY NUMBER')
      *
     A            CKCONM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY NAME')
      *
     A            CKFND          3S 0
     A                                      COLHDG('GROUP')
      *
     A            CKFNAM    R               REFFLD(DS60)
     A                                      COLHDG('GROUP NAME')
      *
     A            CKFYR          3S 0
     A                                      COLHDG('POLICY YEAR')
      *
     A            CKCASE         7S 0
     A                                      COLHDG('CASE #')
      *
     A            CKPYEE    R               REFFLD(DS30)
     A                                      COLHDG('PAYEE')
      *
     A            CKTRCD    R               REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'CODE')
      *
     A            CKTRDS        30A
     A                                      COLHDG('TRANSACTION' 'DESCRIPTION')
      *
     A            CKTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('RECORD' 'TYPE')
      *
     A            CKTRDT         8S 0
     A                                      COLHDG('TRANSACTION' 'DATE')
      *
     A            CKPODT         8S 0
     A                                      COLHDG('POSTING' 'DATE')
      *
     A            CKCHK#         7S 0
     A                                      COLHDG('CHECK #')
      *
     A            CKCOMP         9S 2
     A                                      COLHDG('COMPENSATION' 'AMOUNT')
      *
     A            CKMED          9S 2
     A                                      COLHDG('MEDICAL' 'AMOUNT')
      *
     A            CKLEG          9S 2
     A                                      COLHDG('LEGAL' 'AMOUNT')
      *
     A            CKEXP          9S 2
     A                                      COLHDG('EXPENSE' 'AMOUNT')
      *
     A            CKTOTL         9S 2
     A                                      COLHDG('TOTAL' 'AMOUNT')
      *
     A            CKRNDT         8S 0
     A                                      COLHDG('RUN' 'DATE')
      *
     A            CKMCSQ         5S 0
     A                                      COLHDG('ACT CURRENT OR PRIOR')
      *                 VALUES:  1  - Previous Activity
      *                         11  - Current Activity
      *                         18  - Manual
      *                         21  - Recoveries
      *                         31  - Adjustments
      *
     A            CKSQDS        40A
     A                                      COLHDG('SEQ CODE' 'DESCRIPTION')
      *
      *
     A            CKUSER        10A         COLHDG('USER')
     A            CKPGM         10A         COLHDG('PROGRAM')
     A            CKTIME         6S 0       COLHDG('TIME')
     A            CKDT           8S 0       COLHDG('DATE')
      *
     A          K CKCO#
     A          K CKFND
     A          K CKFYR
     A          K CKCASE
      *
      *
