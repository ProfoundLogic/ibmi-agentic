     A                                      REF(SREFP)
     A          R PSS01                     TEXT('Secured Storage File')
     A*
     A            SSCO#     R               REFFLD(CO#)
     A            SSTYPE         1A         COLHDG('Type of Record')
     A            SSKEY         50A         COLHDG('Record Key')
     A            SSIV          16          COLHDG('Initialization' 'Vector')
     A                                      CCSID(65535)
     A            SSFLD1       256A         COLHDG('Field #1')
     A                                      CCSID(65535)
     A            SSFLD2       256A         COLHDG('Field #2')
     A                                      CCSID(65535)
     A            SSFLD3       256A         COLHDG('Field #3')
     A                                      CCSID(65535)
     A            SSFLD4       256A         COLHDG('Field #4')
     A                                      CCSID(65535)
     A            SSFLD5       256A         COLHDG('Field #5')
     A                                      CCSID(65535)
     A            SSFLD6       256A         COLHDG('Field #6')
     A                                      CCSID(65535)
     A            SSFLD7       256A         COLHDG('Field #7')
     A                                      CCSID(65535)
     A            SSFLD8       256A         COLHDG('Field #8')
     A                                      CCSID(65535)
     A            SSFLD9       256A         COLHDG('Field #9')
     A                                      CCSID(65535)
     A            SSUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            SSPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            SSTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            SSDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            SSIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            SSIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            SSITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            SSIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
