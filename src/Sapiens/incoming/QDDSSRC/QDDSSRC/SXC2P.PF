     A*  (C) Copyright Progressive Data Solutions, Inc., 2004
     A**
     A** MD AND OL FILE COMBINED FOR USE WITH CONVERSION
     A**
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PC201                     TEXT('CVT FILE MD AND OL  ')
     A*
     A            MDKEY     R               REFFLD(KEY)
     A            MDSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            MDOID         40          COLHDG('OBJECT ID')
     A*
     A            MDOFLR        60          COLHDG('OBJECT FOLDER')
     A            MDOTYP    R               REFFLD(FLAG)
     A                                      COLHDG('OBJECT TYPE' +
     A                                      'F, I, O...')
     A            MDODSC    R               REFFLD(DS40)
     A                                      COLHDG('OBJ DESC.')
     A            MDDOCT         8          COLHDG('DOCUMENT TYPE')
     A            MDTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION DATE')
     A            MDTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANSACTION TIME')
     A            MDSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            MDCSID    R               REFFLD(CSID)
     A            MDCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            MDPNAM    R               REFFLD(PGM)
     A                                      TEXT('WROTE IT')
     A            MDSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            MDSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A            MDRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('REMARK' 'CODE')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            MDIUSR    R               REFFLD(USER)
     A                                      TEXT('INIT USER')
     A            MDIPGM    R               REFFLD(PGM)
     A                                      TEXT('INIT PGM')
     A            MDITIM    R               REFFLD(TIME)
     A                                      TEXT('INIT TIME')
     A            MDIDT     R               REFFLD(DT)
     A                                      TEXT('INIT DATE')
     A            MDLUSR    R               REFFLD(USER)
     A                                      TEXT('USER LAST MAINT')
     A            MDLPGM    R               REFFLD(PGM)
     A                                      TEXT('LAST MAINT PGM')
     A            MDLTIM    R               REFFLD(TIME)
     A                                      TEXT('LAST MAINT TIME')
     A            MDLDT     R               REFFLD(DT)
     A                                      TEXT('LAST MAINT DATE')
     A*
     A            MDFL01    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 01 **')
     A            MDFL02    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 02 **')
     A            MDFL03    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 03 **')
     A            MDFL04    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 04 **')
     A            MDFL05    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 05 **')
     A            MDCHR5         5A         TEXT('**FUTURE USE A5  01 **')
     A*
     A            MDSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A*
     A            OLKEY     R               REFFLD(KEY)
     A            OLSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            OLSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A            OLOFLR        60A         TEXT('OBJECT FOLDER(PATH)')
     A            OLOID         40A         TEXT('OBJECT ID')
     A*
     A            OLSYS          1A         TEXT('AS/400  SYSTEM ID          ')
     A            OLDCID        12A         TEXT('UNIQUE OBJECT ID (ON OPT)  ')
     A            OLOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            OLOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            OLOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A            OL#BYT         5S 1       TEXT('NUMBER OF  KBYTES IN DOCUME')
     A            OLDTWR         7  0       TEXT('DATE WRITTEN TO OPT        ')
     A            OLTMWR         6S 0       TEXT('TIME WRITTEN TO OPT        ')
     A            OLUSWR         8A         TEXT('USER WROTE TO OPT          ')
     A            OLPAGS         4S 0       TEXT('OBJECT   PAGES             ')
     A            OLOPTF         1A         TEXT('OPTICAL STORE FLAG         ')
     A            OLVOL1        10A         TEXT('VOLUME ID-1                ')
     A            OLVOL2        10A         TEXT('VOLUME ID-2                ')
     A            OLVOL3        10A         TEXT('VOLUME ID-3                ')
      *
      ****** TAPE LOCATION INFORMATION *****************************************
     A            OLTAPF         1A         TEXT('TAPE    STORE FLAG         ')
     A            OLDTWT         7  0       TEXT('DATE WRITTEN TO TAPE       ')
     A            OLTMWT         6S 0       TEXT('TIME WRITTEN TO TAPE       ')
     A            OLUSWT         8A         TEXT('USER WROTE TO TAPE         ')
     A            OLTVOL        10A         TEXT('VOLUME ID-OF TAPE          ')
     A*
     A            OLBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            OLFLD1        10A         TEXT('FUTURE USE                 ')
     A            OLSTAT    R               REFFLD(STAT)
     A            OLUSER    R               REFFLD(USER)
     A            OLPGM     R               REFFLD(PGM)
     A            OLTIME    R               REFFLD(TIME)
     A            OLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OLIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            OLIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            OLTDOC        12A         TEXT('UNIQUE OBJECT   ID-TAPE    ')
     A*  NEW DOC ID
     A            CVNDOC    R               REFFLD(DCID)
     A*  NEW FOLDER ID
     A            CVNFLD        80A
     A*  NEW OPTICAL FOLD
     A            CVOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A*  NEW OPTICAL SUBDIREC
     A            CVOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A*  NEW OPTICAL VOLID
     A            CVVOL1        10A         TEXT('OPTICAL VOLUME ID NEW')
     A*  ERROR FLAG
     A            CVEFLG    R               REFFLD(FLAG)
     A* ERROR DESC
     A            CVERR     R               REFFLD(DS40)
     A*  PROCESSED FLAG  (STATUS)
     A            CVPRCS    R               REFFLD(FLAG)
     A*
