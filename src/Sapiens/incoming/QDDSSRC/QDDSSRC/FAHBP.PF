     A** FEE SCHEDULE - HBA TRANSACTION FILE ***
     A**
     A**
     A** +++++ IMPORTANT +++++ IMPORTANT +++++ IMPORTANT +++++ IMPORTANT +++++
     A** +                                                                   +
     A** +  SEVERAL FILES ARE SIMILAR TO FAHBP AND MAY NEED TO BE UPDATED    +
     A** +       IF A DATABASE CHANGE IS MADE TO FAHBP:                      +
     A** +               1.  PAHBP                                           +
     A** +                                                                   +
     A** +++++ IMPORTANT +++++ IMPORTANT +++++ IMPORTANT +++++ IMPORTANT +++++
     A**
     A**
     A                                      REF(FSREFP)
     A          R PHB01                     TEXT('HBA TRANS FILE')
     A            HBCO#     R               REFFLD(CO#)
     A            HBFND     R               REFFLD(FND)
     A            HBFYR     R               REFFLD(FYR)
     A            HBCASE    R               REFFLD(CASE)
     A            HBSS#     R               REFFLD(SS#)
     A            HBACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE')
     A            HBEOB#    R               REFFLD(EOB#) COLHDG('EOB #')
     A            HBLVL     R               REFFLD(FLAG) COLHDG('HBA LEVEL')
     A                                      TEXT('HBA LEVEL-"1"-AUTOMATIC,+
     A                                      "2"-DESKTOP,"3"-ON SITE')
     A            HBTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            HBFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('PAYEE' 'FEDERAL' 'ID #')
     A            HBMOD     R               REFFLD(MOD)
     A            HBFRDT    R               REFFLD(DT)
     A                                      COLHDG('FROM' 'DATE')
     A            HBTODT    R               REFFLD(DT)
     A                                      COLHDG('TO' 'DATE')
     A            HBTALW    R               REFFLD(A92)
     A                                      COLHDG('RECOMMENDED' 'ALLOWANCE')
     A            HBTCHG    R               REFFLD(A92)
     A                                      COLHDG('TOTAL' 'CHARGED')
     A            HB1CAM    R               REFFLD(A92)
     A                                      COLHDG('CALCULATED' 'AMT TO BILL')
     A            HB1AAM    R               REFFLD(A92)
     A                                      COLHDG('ACTUAL' 'AMT TO BILL')
     A            HB1PM1    R               REFFLD(A52)
     A                                      COLHDG('% USED' 'TO CALCULATE' +
     A                                      'AMT TO BILL')
     A            HBTRCD    R               REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'CODE')
     A            HBHBAP    R               REFFLD(PC52) COLHDG('PERCENT' +
     A                                      'CHARGED' 'ON ARDA')
     A            HBARDA    R               REFFLD(A92) COLHDG('ADDITIONAL'  +
     A                                      'REDUCTIONS' 'AMOUNT')
     A            HBICD1    R               REFFLD(ICD9)
     A            HBICD2    R               REFFLD(ICD9)
     A            HBICD3    R               REFFLD(ICD9)
     A            HBICD4    R               REFFLD(ICD9)
     A            HBICD5    R               REFFLD(ICD9)
     A            HBAPNM    R               REFFLD(NAME) COLHDG('ADMITTING' +
     A                                      'PHYSICIAN' 'NAME')
     A            HBPCTL    R               REFFLD(LIC#)
     A                                      COLHDG('PATIENT' 'CONTROL' '#')
     A            HBATYP    R               REFFLD(FLAG) COLHDG('ADMIT' 'TYPE')
     A                                      TEXT('ADMIT TYPE 1-XXXX,2-XXXX,+
     A                                      3-XXXX,4-XXXX,5-XXXX ')
     A            HBPNAM    R               REFFLD(NAME)
     A            HBADR1    R               REFFLD(ADR1)
     A            HBADR2    R               REFFLD(ADR2)
     A            HBCTY     R               REFFLD(CTY)
     A            HBST      R               REFFLD(ST)
     A            HBZIP     R               REFFLD(ZIP)
     A            HBEOB1    R               REFFLD(SPEC)
     A                                      COLHDG('EOMB TABLE' 'CODE 1')
     A            HBEOB2    R               REFFLD(SPEC)
     A                                      COLHDG('EOMB TABLE' 'CODE 2')
     A            HBEOB3    R               REFFLD(SPEC)
     A                                      COLHDG('EOMB TABLE' 'CODE 3')
     A            HBSTAT    R               REFFLD(STAT) TEXT('STATUS - +
     A                                      "P"-PROCESSED/PRINTED')
     A            HBUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A            HBPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PGM')
     A            HBTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A            HBDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A            HBIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            HBIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            HBFLG1    R               REFFLD(FLAG) COLHDG('FLAG 1')
     A                                      TEXT('NOT USED YET FLAG')
     A            HBFLG2    R               REFFLD(FLAG) COLHDG('FLAG 2')
     A                                      TEXT('NOT USED YET FLAG')
     A            HBFLG3    R               REFFLD(FLAG) COLHDG('FLAG 2')
     A                                      TEXT('NOT USED YET FLAG')
     A            HBFLG4    R               REFFLD(FLAG) COLHDG('FLAG 4')
     A                                      TEXT('NOT USED YET FLAG')
     A            HBFLG5    R               REFFLD(FLAG) COLHDG('FLAG 5')
     A                                      TEXT('NOT USED YET FLAG')
     C*** BEG CHG *** 01/05/99 ***************************************
     A            HBINV#    R               REFFLD(A90)
     A**********  HBINV#    R               REFFLD(SEQ#)
     C*** END CHG *** 01/05/99 ***************************************
     A                                      COLHDG('INVOICE' 'NUMBER')
     A            HBSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A*** ADD FOR NETWORK PROCESSING SYSTEM ************************************
     A            HBHRFL    R               REFFLD(FLAG)
     A                                      COLHDG('HOLD/RELEASE' 'FLAG')
     A            HBBLFL    R               REFFLD(FLAG)
     A                                      COLHDG('BILLING' 'FLAG')
     A            HBNLFL    R               REFFLD(FLAG)
     A                                      COLHDG('NO LOST' 'TIME FLAG')
