     A                                      REF(SREFP)
     A          R PFP01                     TEXT('Scriptura Additional -
     A                                      Medical Info File')
     A*
     A            FPXML         60A         COLHDG('Unique XML File' -
     A                                      'Name Key')
     A            FPCO#          3S 0       COLHDG('Company #')
     A            FPFND          3S 0       COLHDG('Group #')
     A            FPFYR          3S 0       COLHDG('Year')
     A            FPCASE         7S 0       COLHDG('Case')
     A* Header Information
     A            FPCLM#        25A         COLHDG('Carrier File #')
     A* Claim Information
     A            FPCFSN        15A         COLHDG('Claimant First Name')
     A            FPCMID         1A         COLHDG('Claimant Middle Init')
     A            FPCLSN        30A         COLHDG('Claimant Last Name')
     A            FPCAD1        40A         COLHDG('Claimant Address 1')
     A            FPCAD2        40A         COLHDG('Claimant Address 2')
     A            FPCCTY        25A         COLHDG('Claim City')
     A            FPCST          2A         COLHDG('Claim State')
     A            FPCZIP         9S 0       COLHDG('Claim Zip Code')
     A            FPSS#          9A         COLHDG('SS#')
     A            FPINJD         8S 0       COLHDG('Date of Injury' -
     A                                      'or Death')
     A            FPDBDT         8S 0       COLHDG('Date of Disability')
     A            FPMMI          8S 0       COLHDG('Date of Max' -
     A                                      'Medical Improvement')
     A* Employer Information
     A            FPENAM        40A         COLHDG('Employer Name')
     A            FPEMAD1       40A         COLHDG('Employer Mailing' -
     A                                      'Address 1')
     A            FPEMAD2       40A         COLHDG('Employer Mailing' -
     A                                      'Address 2')
     A            FPEMCTY       25A         COLHDG('Employer Mailing' -
     A                                      'City')
     A            FPEMST         2A         COLHDG('Employer Mailing' -
     A                                      'State')
     A            FPEMZIP        9S 0       COLHDG('Employer Mailing' -
     A                                      'Zip')
     A            FPEPAD1       40A         COLHDG('Employer Physical' -
     A                                      'Address 1')
     A            FPEPAD2       40A         COLHDG('Employer Physical' -
     A                                      'Address 2')
     A            FPEPCTY       25A         COLHDG('Employer Physical' -
     A                                      'City')
     A            FPEPST         2A         COLHDG('Employer Physical' -
     A                                      'State')
     A            FPEPZIP        9S 0       COLHDG('Employer Physical' -
     A                                      'Zip')
     A* Insurance Carrier name
     A            FPCONM        40A         COLHDG('Company Name')
     A* Average weekly wage/Rate
     A            FPAWW         11S 2       COLHDG('Average Weekly Wage')
     A            FPCRT         11S 2       COLHDG('Weekly Comp Rate')
     A* Number of weeks temporary total
     A            FPWEEKSTT      5S 0       COLHDG('Temporary Total' +
     A                                      'Weeks')
     A            FPDAYSTT       5S 0       COLHDG('Temporary Total' +
     A                                      'Days')
     A            FPAMTTT       11S 2       COLHDG('Temporary Total' +
     A                                      'Amount')
     A* Number of weeks temporary partial
     A            FPWEEKSTP      5S 0       COLHDG('Temporary Partial' +
     A                                      'Weeks')
     A            FPDAYSTP       5S 0       COLHDG('Temporary Partial' +
     A                                      'Days')
     A            FPAMTTP       11S 2       COLHDG('Temporary Partial' +
     A                                      'Amount')
     A* Number of weeks permanent partial
     A            FPWEEKSPP      5S 0       COLHDG('Permanent Partial' +
     A                                      'Weeks')
     A            FPDAYSPP       5S 0       COLHDG('Temporary Partial' +
     A                                      'Days')
     A            FPAMTPP       11S 2       COLHDG('Permanent Partial' +
     A                                      'Amount')
     A* Death benefits paid
     A            FPWEEKSDB      5S 0       COLHDG('Death Benifits' +
     A                                      'Weeks')
     A            FPDAYSDB       5S 0       COLHDG('Death Benifits' +
     A                                      'Days')
     A            FPAMTDB       11S 2       COLHDG('Death Benefits' +
     A                                      'Paid')
     A            FPMEDEXP      11S 2       COLHDG('Medical Expenses')
     A            FPOTHEXP      11S 2       COLHDG('Other Expenses')
     A            FPCAREA        3S 0       COLHDG('Company Area Code')
     A            FPCPHN#        7S 0       COLHDG('Company Phone #')
     A            FPUSRNAME     50A         COLHDG('User Name')
     A            FPSYSDT        8S 0       COLHDG('System Date')
      *** Beg Add ***** 10/10/19 ****************************************
     A            FPWEEKSPT      5S 0       COLHDG('Permanent Total' +
     A                                      'Weeks')
     A            FPDAYSPT       5S 0       COLHDG('Permanent Total' +
     A                                      'Days')
     A            FPAMTPT       11S 2       COLHDG('Permanent Total' +
     A                                      'Amount')
      *** End Add ***** 10/10/19 ****************************************
      *** Beg Add ***** 02/17/20 ****************************************
     A            FPSTLUMS      11S 2       COLHDG('Settle Lump Sum' +
     A                                      'Amount')
     A            FPSTCMPR      11S 2       COLHDG('Settle Compromise' +
     A                                      'Amount')
     A            FPSTREPP      11S 2       COLHDG('Settle Reimburse' +
     A                                      'Prev Pd')
     A            FPSTCRFL      11S 2       COLHDG('Settle Credit' +
     A                                      'Futr Liab')
     A            FPSTLTOT      11S 2       COLHDG('Settle Total')
      *** End Add ***** 02/17/20 ****************************************
