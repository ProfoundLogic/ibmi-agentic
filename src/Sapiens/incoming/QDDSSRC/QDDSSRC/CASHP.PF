     A*
     A* CASHP - Policy Cash Transactions - Clarendon Pre-Processor
     A****************************************************************
      *
     A          R PSH01                     TEXT('Policy CASH Trans')
      *
     A            SHPGID         6          COLHDG('Program ID')
      *
     A            SHCAP#        30          COLHDG('Policy Number')
      *
     A            SHCHK#        15          COLHDG('Payment ID')
      *
     A            SHDATE        10          COLHDG('Cash Recieved Date')
      *
     A            SHBTYP         2          COLHDG('Billing Type')
      *                   Code  Description
      *                     __  ____________
      *                     10  Down payment
      *                     11  Installment
      *                     12  Annual
      *                     13  Monthly reporting
      *                     14  Final
      *                     15  Endorsement down payment
      *                     16  Cash for surcharges
      *                     17  Credits
      *                     18  Disbursements
      *
     A            SHAMT         22          COLHDG('Collected Amount')
      *
     A            SHPAMT        22          COLHDG('Premium' +
     A                                      'Collected Amount')
      *
     A            SHCAMT        22          COLHDG('Commission' +
     A                                      'Collected Amount')
      *
     A            SHCOMT        40          COLHDG('Payment Comments')
      *
     A            SHTRDT        10          COLHDG('Transaction Date')
      *
     A            SHACDT        10          COLHDG('Accounting Date')
      *
     A            SHPFDT        10          COLHDG('Policy Effective' +
     A                                      'Date')
      *
     A            SHJRST         2          COLHDG('Policy Risk State')
     A            SHFND          3  0       TEXT('Fund')
     A            SHFYR          3  0       TEXT('Fund Year')
     A            SHEMP#         9  0       TEXT('Employer')
      *
      **** BEGIN ADD **** 04/04/02 *********************************************
     A            SHAMT#        21  2       COLHDG('Collected Amount')
     A            SHPAMT#       21  2       COLHDG('Premium' +
     A                                      'Collected Amount')
     A            SHCAMT#       21  2       COLHDG('Commission' +
     A                                      'Collected Amount')
      **** END   ADD **** 04/04/02 *********************************************
      *
