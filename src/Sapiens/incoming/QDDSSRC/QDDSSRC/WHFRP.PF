     A          R PFR01                     TEXT('First Report of Injury Data ')
     A*
     A* Required fields - must have to import claim
     A*
     A            FRSTAT         1A         TEXT('D=DLT, P=PEND, T=TRNSFRD')
     A            FRERR          2A         TEXT('Error code')
     A            FRCO           3S 0       TEXT('Company number')
     A            FRFND          5S 0       TEXT('Fund Number')
     A            FREMP          9S 0       TEXT('Employer Number')
     A            FRDIV          5S 0       TEXT('Division')
     A            FRFEIN         9S 0       TEXT('EMPLOYER FEIN')
     A            FRSS           9A         TEXT('Social Security Number')
     A            FRLSN         30A         TEXT('Employee Last Name')
     A            FRFSN         15A         TEXT('Employee First Name')
     A            FRADR1        40A         TEXT('Address Line 1')
     A            FRCTY         25A         TEXT('City')
     A            FRST           2A         TEXT('State')
     A            FRZIP          9S 0       TEXT('Zip Code')
     A            FRCLAS         5S 0       TEXT('Class code')
     A            FRAWW          7S 2       TEXT('Average Weekly Rate')
     A            FRACDT         8A         TEXT('Accident Date')
     A                                      COLHDG('CCYYMMDD FORMAT')
     A            FRDTRP         8A         TEXT('Date Reported')
     A                                      COLHDG('CCYYMMDD FORMAT')
     A            FRLTFL         1A         TEXT('Lost Time Flag')
     A                                      COLHDG('I=LT,M=MED,R=RPT')
     A            FRNATR         2A         TEXT('Nature Code')
     A            FRPART         2A         TEXT('Part Code')
     A            FRCAUS         2A         TEXT('Cause Code')
     A            FRRCVD         8A         TEXT('Received Date')
     A                                      COLHDG('CCYYMMDD FORMAT')
