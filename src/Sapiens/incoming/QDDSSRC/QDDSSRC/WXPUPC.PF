     A*                         TURN ALL FIELDS TO CHARACTER FIELDS            *
     A**************************************************************************
     A          R PPU01                     TEXT('S/R P/R IMPORT FILE')
     A            PURTYP         1A         TEXT('REC TYPE')
     A                                      COLHDG('REC' 'TYPE')
     A            PUPOL#        25A         TEXT('POLICY NUMBER')
     A                                      COLHDG('POLICY #')
     A            PUFND          3A         TEXT('GROUP')
     A                                      COLHDG('GRP')
     A            PUEMP          9A         TEXT('EMPLOYER')
     A                                      COLHDG('EMPLOYER')
     A            PUDIV          5A         TEXT('DIVISION')
     A                                      COLHDG('DIV')
     A            PURDT          8A         TEXT('REPORT DATE')
     A                                      COLHDG('REPORT DT')
     A            PUPAMT        11A         TEXT('PAYROLL AMOUNT')
     A                                      COLHDG('PAYROLL AMT')
     A            PUPAS          1A         TEXT('P/R AMOUNT SIGN')
     A                                      COLHDG('SIGN')
     A            PUCLAS         5A         TEXT('P/R CLASS')
     A                                      COLHDG('PR CLAS')
     A            PUPSPC         1A         TEXT('CLASS SPEC CODE')
     A                                      COLHDG('SPEC')
     A            PUCXDT         8A         TEXT('CX DATE')
     A                                      COLHDG('CX DT')
     A            PUNEMP         7A         TEXT('NUMBER EMPLOYEES')
     A                                      COLHDG('NBR EMPL')
     A            PULSN         30A         TEXT('LAST NAME')
     A                                      COLHDG('LAST NAME')
     A            PUFSN         15A         TEXT('FIRST NAME')
     A                                      COLHDG('FIRST NAME')
     A            PUMID          1A         TEXT('MIDD INIT')
     A                                      COLHDG('INIT')
     A            PUTITL         5A         TEXT('COURTESY TITLE')
     A                                      COLHDG('TITLE')
     A            PUPOS         40A         TEXT('POSITION')
     A                                      COLHDG('POSITION')
     A            PUSSN          9A         TEXT('SOCIAL SECURITY')
     A                                      COLHDG('SOC SEC')
     A            PURCNT        13A         TEXT('RECORD COUNT')
     A                                      COLHDG('REC CNT')
     A            PUTAMP        17A         TEXT('TOTAL PAYROLL AMOUNT')
     A                                      COLHDG('TOT PAY AMT')
     A            PUECNT        11A         TEXT('EMPLOYEE COUNT')
     A                                      COLHDG('EMP CNT')
