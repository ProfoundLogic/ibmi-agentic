     A*  WORKERS' COMP WCPOLS ADDITIONAL UE# RECORDS FILE
     A*
     A                                      REF(WREFP)
     A          R PN201                     TEXT('WCPOLS UE# REPORTING FILE')
     A            N2CO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            N2FND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            N2EMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            N2FYR     R     S         REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            N2UNID    R     S         REFFLD(A120)
     A                                      COLHDG('UNIQUE IDENTIFIER')
     A            N2ST      R               REFFLD(ST)
     A                                      COLHDG('REPORTING BUREAU')
     A            N2LINK         3S 0       COLHDG('NAME LINK CODE')
     A            N2LNKC         2S 0       COLHDG('NAME LINK COUNTER')
     A            N2STU     R               REFFLD(ST)
     A                                      COLHDG('UE STATE')
     A            N2SUE         20A         COLHDG('STATE UNEMPLOYMENT')
     A            N2USER    R               REFFLD(USER)
     A            N2PGM     R               REFFLD(PGM)
     A            N2TIME    R     S         REFFLD(TIME)
     A            N2DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            N2IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            N2IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            N2ITM     R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            N2IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
