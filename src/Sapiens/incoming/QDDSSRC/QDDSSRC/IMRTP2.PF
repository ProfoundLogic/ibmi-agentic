     A            RTEPAG         6A         COLHDG('END PAGE')
     A            RTPDLT         1A         COLHDG('PRINT THEN' 'DELETE' +
     A                                      'Y/N')
     A            RTACTC        12A         COLHDG('ACTION CODE DESC')
     A*
     A            RTSTAT         1          COLHDG('STATUS')
     A***** LAST MAINT INFO  *****
     A*
     A            RTIUSR        10          TEXT('INIT USER')
     A            RTIPGM        10          TEXT('INIT PGM')
