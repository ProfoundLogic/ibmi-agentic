     A            RTFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            RTFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            RTFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            RTFL05         1          TEXT('**FUTURE USE FLG 05 **')
