     A                                      COLHDG('CLAIM/OCCUR' 'VERBIAGE' +
     A                                             '#1')
     A            LDOCV1    R               REFFLD(FLAG)
     A                                      COLHDG('CLAIM/OCCUR' 'VERBIAGE' +
     A                                             'FOR OCCUP DIS #1')
