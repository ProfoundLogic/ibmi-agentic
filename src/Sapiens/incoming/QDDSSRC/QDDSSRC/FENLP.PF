     A                                      REF(FSREFP)
     A          R PNL01                     TEXT('NCCI Medical Data Log File')
     A            NLEOB#        15S 0
     A                                      COLHDG('BILL' 'IDENTIFICATION' -
     A                                       'NUMBER')
     A            NLRCN          3S 0
     A                                      COLHDG('BILL' 'RECON#')
     A            NLFILE    R               REFFLD(DS30)
     A                                      COLHDG('LONG FILE' 'RECON#')
     A            NLQTR          1S 0
     A                                      COLHDG('REPORTING' 'QUARTER')
     A            NLYEAR    R               REFFLD(YEAR)
     A                                      COLHDG('REPORTING' 'YEAR')
     A            NLSBDT         8S 0
     A                                      COLHDG('SUBMISSION' 'DATE')
     A            NLSBTM    R               REFFLD(TIME)
     A                                      COLHDG('SUBMISSION' 'TIME')
     A            NLTRCD    R               REFFLD(DS2)
     A                                      COLHDG('TRANSACTION' 'CODE')
     A            NLPRFL    R               REFFLD(FLAG)
     A                                      COLHDG('PROCESSED' 'FLAG')
     A            NLIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            NLIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            NLIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            NLITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            NLUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            NLPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            NLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE')
     A            NLTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME')
