     A                                      REF(WREFP)
     A          R PRW101                    TEXT('Audit Request +
     A                                      Payroll Work File')
     A            RW1XML        60A         COLHDG('XML File Key')
     A            RW1CO#    R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            RW1FND    R     S         REFFLD(FND)
     A                                      COLHDG('Fund')
     A            RW1EMP#   R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            RW1DIV    R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            RW1FYR    R     S         REFFLD(FYR)
     A                                      COLHDG('Fund Year')
     A            RW1SEQ         5S 0       COLHDG('Sequence #')
     A            RW1HEAD        1A         COLHDG('Header Record')
     A                                      TEXT('Y or blank')
     A            RW1HDGT       20A         COLHDG('Header Type')
     A            RW1CLAS   R     S         REFFLD(CLAS)
     A                                      COLHDG('Payroll Class')
     A            RW1SPEC        1A         COLHDG('Payroll Spec')
     A            RW1EXT         5A         COLHDG('Payroll Extension')
     A            RW1DESC       50A         COLHDG('Payroll Description')
      **** BEGIN CHG **** 06/17/24 ************************************
     A*********** RW1RATE        7S 2       COLHDG('Payroll Rate')
     A            RW1RATE        8S 3
      **** END   CHG **** 06/17/24 ************************************
     A                                      COLHDG('Payroll Rate')
     A            RW1PEFD        8S 0       COLHDG('Payroll' 'Effective Date')
     A            RW1PEXD        8S 0       COLHDG('Payroll Exp. Date')
     A            RW1CXDT        8S 0       COLHDG('Payroll' 'Cancellation' -
     A                                             'Date')
     A            RW1NUME        9S 0       COLHDG('Number of Employees')
     A            RW1EPAY       11S 2       COLHDG('Estimated/SR' 'Payroll' -
     A                                             'Amount')
     A            RW1APAY       11S 2       COLHDG('Audited' 'Payroll' -
     A                                             'Amount')
     A            RW1EFDT        8S 0       COLHDG('Header' 'Effective Date')
     A            RW1MOD         5S 4       COLHDG('Header' 'Experience' -
     A                                             'Modifier')
     A            RW1HST         2A         COLHDG('Heading State')
     A            RW1IUSR   R               REFFLD(USER)
     A                                      COLHDG('Initial/User')
     A            RW1IPGM   R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            RW1IDT    R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            RW1ITIM   R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            RW1USER   R               REFFLD(USER)
     A                                      COLHDG('Maint. User')
     A            RW1PGM    R               REFFLD(PGM)
     A                                      COLHDG('Maint. Program')
     A            RW1DT     R     S         REFFLD(DT)
     A                                      COLHDG('Maint. Date')
     A            RW1TIME   R     S         REFFLD(TIME)
     A                                      COLHDG('Maint. Time')
