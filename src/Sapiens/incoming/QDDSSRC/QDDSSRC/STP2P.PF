     A                                      COLHDG('TIME')
     A            P2DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            P2IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            P2IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
