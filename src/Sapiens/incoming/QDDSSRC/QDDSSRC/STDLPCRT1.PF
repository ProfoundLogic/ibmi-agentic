     A                                      REF(SREFP)
     A          R PD101                     TEXT('DOCUMENTS/LETTERS FILE')
     A            D1CO#     R     S         REFFLD(CO#)
     A            D1CAT     R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT CATEGORY')
     A            D1SUBC    R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT' 'SUB CATEGORY')
     A            D1DCID        60A         COLHDG('DOCUMENT NAME/ID')
     A            D1INID        60A         COLHDG('INTERACTIVE DOC ID')
     A            D1LANG        40A         COLHDG('DOCUMENT LANGUAGE')
     A            D1CRITID      25A         COLHDG('CRITERIA ID')
     A            D1CRITVAL     50A         COLHDG('CRITERIA VALUE')
     A*
     A            D1USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            D1PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            D1TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            D1DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            D1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            D1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            D1ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            D1IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            D1STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
