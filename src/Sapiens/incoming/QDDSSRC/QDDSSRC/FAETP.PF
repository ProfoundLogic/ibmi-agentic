     A** WCMC Employer Transfer File

     A*****************************************************************
     A****                                                         ****
     A****  This file is used to hold information for the new and ****
     A****  former information when an Employer w/Claims is        ****
     A****  Transferred to a new Group                             ****
     A****                                                         ****
     A*****************************************************************
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                                *
     A*****************************************************************

     A                                      REF(WREFP)
     A          R PET01                     TEXT('WCMS EMPLOYER TRANSFER FILE')
     A            ETCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            ETSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER' 'NUMBER')
     A            ETFND     R               REFFLD(FND)
     A                                      COLHDG('NEW GROUP' 'NUMBER')
     A            ETEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('NEW EMPLOYER' 'NUMBER')
     A            ETDIV     R               REFFLD(DIV)
     A                                      COLHDG('NEW DIVISION' 'NUMBER')
     A            ETFYR     R               REFFLD(FYR)
     A                                      COLHDG('NEW CLAIM' 'YEAR')
     A            ETCASE    R               REFFLD(CASE)
     A                                      COLHDG('NEW CLAIM' 'NUMBER')
     A            ETOSUB    R               REFFLD(SUB#)
     A                                      COLHDG('OLD SUBSCRIBER' 'NUMBER')
     A            ETOFND    R               REFFLD(FND)
     A                                      COLHDG('OLD GROUP' 'NUMBER')
     A            ETOEMP    R               REFFLD(EMP#)
     A                                      COLHDG('OLD EMPLOYER' 'NUMBER')
     A            ETODIV    R               REFFLD(DIV)
     A                                      COLHDG('OLD DIVISION' 'NUMBER')
     A            ETOFYR    R               REFFLD(FYR)
     A                                      COLHDG('OLD CLAIM' 'YEAR')
     A            ETOCAS    R               REFFLD(CASE)
     A                                      COLHDG('OLD CLAIM' 'NUMBER')
     A            ETUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A            ETPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PROGRAM')
     A            ETDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A            ETTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A            ETIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ETIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            ETIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            ETITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
