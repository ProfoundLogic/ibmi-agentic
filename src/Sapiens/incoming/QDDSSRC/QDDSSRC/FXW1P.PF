     A                                      REF(FSREFP)
     A          R PW101                     TEXT('WORK HISTORY OUTFILE')
     A            W1CO#     R               REFFLD(CO#)
     A            W1CONM    R               REFFLD(NAME)
     A            W1SUB#    R               REFFLD(SUB#)
     A            W1SBNM    R               REFFLD(DS40)
     A                                      COLHDG('SUBSCRIBER NAME')
     A            W1FND     R               REFFLD(FND)
     A            W1FNNM    R               REFFLD(DS40)
     A                                      COLHDG('GROUP NAME')
     A            W1EMP#    R               REFFLD(EMP#)
     A            W1DIV     R               REFFLD(DIV)
     A            W1EMNM    R               REFFLD(DS40)
     A                                      COLHDG('EMPLOYER NAME')
     A            W1FYR     R               REFFLD(FYR)
     A            W1CASE    R               REFFLD(CASE)
     A            W1SCL#    R               REFFLD(DS25)
     A                                      COLHDG('CLAIM #')
     A            W1SS#     R               REFFLD(SS#)
     A                                      COLHDG('SOCIAL SECURITY #')
     A            W1ACDT    R               REFFLD(DT8)
     A                                      COLHDG('ACCIDENT DATE')
     A*                                     FMT:MDYY
     A*
     A            W1CLNM    R               REFFLD(DS40)
     A                                      COLHDG('CLAIMANT NAME')
     A            W1OCST    R               REFFLD(FLAG)
     A                                      COLHDG('CLAIM STATUS')
     A            W1TYPE    R               REFFLD(CODE)
     A                                      COLHDG('TYPE OF DUTY')
     A*                                     VALID VALUES:
     A*                                     ND = NO DUTY
     A*                                     LD = LIGHT DUTY
     A*
     A            W1BGDT    R               REFFLD(DT8)
     A                                      COLHDG('BEGIN DATE')
     A*                                     FMT:MDYY
     A*                                     NOTE: MAY CONTAIN FROM DATE
     A*                                     OF PROMPT RANGE
     A*
     A            W1ENDT    R               REFFLD(DT8)
     A                                      COLHDG('END DATE')
     A*                                     FMT:MDYY
     A*                                     NOTE: MAY CONTAIN TO DATE
     A*                                     OF PROMPT RANGE
     A*
     A            W1DAYS    R     S         REFFLD(A50)
     A                                      COLHDG('NUMBER OF DAYS')
     A            W1STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            W1USER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE USER')
     A            W1PGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE PGM')
     A            W1TIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE TIME')
     A            W1DT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE DATE')
     A            W1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            W1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            W1ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            W1IDT     R               REFFLD(DT8)
     A                                      COLHDG('INITIAL DATE')
