     A                                      REF(WREFP)
     A          R PMC01                     TEXT('Menu Command +
     A                                      Processing File')
      *
     A            MCID          25A         COLHDG('Process ID')
     A            MCTITLE       40A         COLHDG('Pop-Up Title')
     A            MCMSG        256A         COLHDG('Pop-Up Message')
     A            MCBTN1        10A         COLHDG('Run Button')
     A            MCBTN2        10A         COLHDG('Cancel Button')
     A            MCBTN3        10A         COLHDG('3rd Button')
     A            MCCMD1       256A         COLHDG('Process' +
     A                                      'COMMAND (Button 1)')
     A            MCCMD2       256A         COLHDG('Process' +
     A                                      'COMMAND (Button 2)')
     A            MCCMD3       256A         COLHDG('Process' +
     A                                      'COMMAND (Button 3)')
     A            MCUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            MCPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            MCTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            MCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
