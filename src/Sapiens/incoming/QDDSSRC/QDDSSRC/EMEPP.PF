     A            EPCO#     R               REFFLD(CO#)
     A            EPFND     R               REFFLD(FND)
     A            EPEMP#    R               REFFLD(EMP#)
     A            EPYEAR    R               REFFLD(AP3)
     A                                      COLHDG('BATCH YEAR')
     A            EPCLAS    R               REFFLD(CLAS)
     A                                      COLHDG('PAYROLL CLASS')
     A            EPAMT     R               REFFLD(BUL#1)
     A                                      COLHDG('PAYROLL AMOUNT')
     A            EPSTAT    R               REFFLD(STAT)
     A            EPUSER    R               REFFLD(USER)
     A            EPPGM     R               REFFLD(PGM)
     A            EPTIME    R               REFFLD(TIME)
     A            EPDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            EPIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            EPIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL ENTRY DATE')
     A            EPRDAT    R               REFFLD(DT)
     A                                      COLHDG('RATE DATE')
     A*** BEGIN ADD *** 11/07/94 ***
     A            EPDRSC    R               REFFLD(SPEC)
     A                                      TEXT('RATE SET CODE')
