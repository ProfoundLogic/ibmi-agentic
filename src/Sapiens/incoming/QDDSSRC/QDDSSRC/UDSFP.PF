     A*
     A*----------------------------------------------------------------
     A          R PSF01                     TEXT('NAIC UDS CLAIM NOTES FILE')
     A*
     A            SFRECT         1A         TEXT('Record type')
     A                                      COLHDG('RT')
     A            SFNAIC         5S 0       TEXT('NAIC number')
     A                                      COLHDG('NAIC #')
     A            SFLST          2A         TEXT('File location state')
     A                                      COLHDG('Loc' ' ST')
     A            SFLCD          2S 0       TEXT('File location code')
     A                                      COLHDG('Loc' ' CD')
     A            SFICLM        30A         TEXT('Insolvent claim #')
     A                                      COLHDG('Insolvent Co Clm #')
     A            SFRCLM        20A         TEXT('Receiver claim number')
     A                                      COLHDG('RCV Clm number')
     A            SFCLT#         5S 0       TEXT('Claimant number')
     A                                      COLHDG('Clmt #')
     A            SFENDT         8S 0       TEXT('Note entry date YYYYMMDD')
     A                                      COLHDG('Date')
     A*
     A            SFNTID         4S 0       TEXT('Note ID number')
     A                                      COLHDG('ID nbr')
     A            SFNLSQ         4S 0       TEXT('Note Line Seq #')
     A                                      COLHDG('Line' 'Seq#')
     A*
     A*     ---------------------------------------------------------------
     A*  1000 bytes
     A            SFTXT1       256A         TEXT('Note Text 1')
     A                                      COLHDG('Text 1')
     A            SFTXT2        19A         TEXT('Note Text 2')
     A                                      COLHDG('Text 2')
     A            SFTXT3       225A         TEXT('Note Text 3')
     A                                      COLHDG('Text 3')
     A            SFTXT4       225A         TEXT('Note Text 4')
     A                                      COLHDG('Text 4')
     A            SFTXT5       225A         TEXT('Note Text 5')
     A                                      COLHDG('Text 5')
     A            SFTXT6        50A         TEXT('Note Text 6')
     A                                      COLHDG('Text 6')
     A*     ---------------------------------------------------------------
     A            SFLCLM        30A         TEXT('Long claim #')
     A                                      COLHDG('Long Clm #')
     A            SF3CLM        30A         TEXT('TPA claim #')
     A                                      COLHDG('TPA Clm #')
