     A* REVISIONS:
     A*
     A* 04/03/09 C:61  Project: SY180
     A*                Add new fields for processing 3 license keys.
     A*
     A* 10/16/07 C:02  Project: ALLCLT - DTM DEPT LTRS (WORD) AND GO4 ISSUE
     A*               -SYFL11 - Pos 4 will be used to indicate VERSION OF GO
     A*                 beING USED.
     A*
     A* 08/08/06 C:33  Project: DR214
     A*               -SYFL11 - Pos 3 will be used to indicate iDarts has
     A*                 been implemented
     A*               -SYDT03 - iDarts implementation date
     A*
     A* 08/04/06 C:062 PROJECT 135WHU
     A*                SYAL05 Pos 1 will be used to indicate that this
     A*                client is using the Credit module
     A*
     A* 05/07/04 C:128 PROJECT SY100
     A*                SYFL11 Pos 2 will be used to indicate that this
     A*                client is a Data Center client.
     A*
     A* 11/14/03 C:15 PROJECT WC1170
     A*               Added 10 new system flags.  SYFL11 will be used
     A*               to indicate PDSQuest is installed and the reserve
     A*               buckets must be aligned.
     A*
     A* 10/08/02 C:62 PROJECT MC253
     A*               DEFINE - MULTI GROUP RESTRICTIONS INSTALL FLAG
     A*               SYFL06
     A*
     A*****************************************************************
      *
     A                                      REF(SYREFP)
     A*
     A          R SSY01                     TEXT('APPL SYSTEM CONTROL FILE')
     A
     A            SYKEY     R               REFFLD(APPKEY)
     A                                      TEXT('SY KEY TO ACCESS RCD')
     A*** HARDWARE INFORMATION ***
     A            SYTDNM    R               REFFLD(TDNM)
     A                                      TEXT('DEFAULT TAPE DRIVE +
     A                                           DEVICE NAME')
     A            SYTDEN    R               REFFLD(TDEN)
     A                                      TEXT('DEFAULT TAPE DENSITY +
     A                                           DEVICE NAME')
     A            SYDDNM    R               REFFLD(DDNM)
     A                                      TEXT('DEFAULT DISKETTE DRIVE +
     A                                           DEVICE NAME')
     A*** AS/400 OFFICE INFORMATION ***
     A            SYDFLR    R               REFFLD(FLR)
     A                                      TEXT('DEFAULT FOLDER ID')
     A*** APPLICATION INFORMATION, WHAT IS INSTALLED?  ***
     A*** SYPCIF: PCMS INSTALLED?
     A            SYPCIF    R               REFFLD(FLAG)
     A*** SYWCIF: WCMS INSTALLED?
     A            SYWCIF    R               REFFLD(FLAG)
     A*** SYFBIF: FSMS INSTALLED?
     A            SYFBIF    R               REFFLD(FLAG)
     A*** SYFIIF: FSMS INTERFACE TO WCMS INSTALLED?
     A            SYFIIF    R               REFFLD(FLAG)
     A*** SYRCIF: RCMS INSTALLED?
     A            SYRCIF    R               REFFLD(FLAG)
     A*************************************************************************
     A*** SYSCIF: DARTS INSTALLED?
     A            SYSCIF    R               REFFLD(FLAG)
     A*** SYSCIF Usage - DARTS Installed (Y/N or blank)
     A* PGM ID    SCRN#     Value     Indicator    Description
     A* --------------------------------------------------------------------
     A* F7060R               Y        *IN21 = 1    DARTS is installed
     A*                      -        *IN21 = 0    DARTS is NOT installed
     A* R7150R               Y        *IN21 = 1    DARTS is installed
     A*                      -        *IN21 = 0    DARTS is NOT installed
     A* W0050R               Y                     DARTS is installed
     A*                      -                     DARTS is NOT installed
     A* W0070R               Y                     DARTS is installed
     A*                      -                     DARTS is NOT installed
     A*************************************************************************
     A*** SYBCIF: BARCODE INSTALLED?
     A**     CONTROL REVERSE IMAGE MESSAGE IN WORK W CLMS HEADING (MAINT MODE)
     A**     CONTROLS CALL TO BAR CODE LABEL PRINT IN W6000C
     A            SYBCIF    R               REFFLD(FLAG)
     A*** SYCSIF: CL SCAN INSTALLED?
     A            SYCSIF    R               REFFLD(FLAG)
     A*************************************************************************
     A*** SYOFIF: OV/400 INSTALLED?
     A            SYOFIF    R               REFFLD(FLAG)
     A*** SYOFIF Usage - AS/400 Office Vision Installed (Y/N or blank)
     A* PGM ID    SCRN#     Value     Indicator    Description
     A* --------------------------------------------------------------------
     A* SC010R    ALL        Y        *IN03 = 0    AS/400 OV is installed
     A*                      -        *IN03 = 1    AS/400 OV NOT installed
     A* SC012R    SCR01      Y        *IN03 = 0    AS/400 OV is installed
     A*                      -        *IN03 = 1    AS/400 OV NOT installed
     A* SC014R    SCR01      Y        *IN03 = 0    AS/400 OV is installed
     A*                      -        *IN03 = 1    AS/400 OV NOT installed
     A* SC015R    SCR01      Y        *IN03 = 0    AS/400 OV is installed
     A*                      -        *IN03 = 1    AS/400 OV NOT installed
     A* SC030R    SCR01      Y        *IN03 = 0    AS/400 OV is installed
     A*                      -        *IN03 = 1    AS/400 OV NOT installed
     A*************************************************************************
     A*** SYIMIF: AS/400 IMG INSTALLED?
     A            SYIMIF    R               REFFLD(FLAG)
     A*** SYFXIF: AS/400 FAX INSTALLED?
     A            SYFXIF    R               REFFLD(FLAG)
     A*
     A*** DATE IT WAS INSTALLED ***
     A*
     A*** SYPCID: PCMS INSTALL DATE
     A            SYPCID    R               REFFLD(DT)
     A*** SYWCID: WCMS INSTALL DATE
     A            SYWCID    R               REFFLD(DT)
     A*** SYFBID: FSMS INSTALL DATE
     A            SYFBID    R               REFFLD(DT)
     A*** SYFIID: FSMS INTERFACE INSTALL DATE
     A            SYFIID    R               REFFLD(DT)
     A*** SYRCID: RCMS INSTALL DATE
     A            SYRCID    R               REFFLD(DT)
     A*** SYSCID: DARTS INSTALL DATE
     A            SYSCID    R               REFFLD(DT)
     A*** SYBCID: BARCODE INSTALL DATE
     A            SYBCID    R               REFFLD(DT)
     A*** SYCSID: CL SCAN INSTALL DATE
     A            SYCSID    R               REFFLD(DT)
     A*** SYOFID: OV/400  INSTALL DATE
     A            SYOFID    R               REFFLD(DT)
     A*** SYIMID: IMAGE INSTALL DATE
     A            SYIMID    R               REFFLD(DT)
     A*** SYFXID: FAX INSTALL DATE
     A            SYFXID    R               REFFLD(DT)
     A*** SYDT01: GL  INSTALL DATE
     A            SYDT01    R               REFFLD(DT)
     A*** SYDT02: WCMC INSTALL DATE
     A            SYDT02    R               REFFLD(DT)
     A*** DATE 6.0 N FUTURE USE ***
     A            SYDT03    R               REFFLD(DT)
     A*** iDarts implementation date
     A            SYDT04    R               REFFLD(DT)
     A            SYDT05    R               REFFLD(DT)
     A            SYDT06    R               REFFLD(DT)
     A            SYDT07    R               REFFLD(DT)
     A            SYDT08    R               REFFLD(DT)
     A            SYDT09    R               REFFLD(DT)
     A            SYDT10    R               REFFLD(DT)
     A*** FLAG 1 = GL INSTALLED ****
     A*      CONTROLS ENTRY OF GL CODES ON WCMS CODE MAINT: RSV; CLM PMT;
     A*      AGT COMM; A/R CODES
     A            SYFL01    R               REFFLD(FLAG)
     A*** FLAG 2 = WCMC INSTALLED ****
     A*      CONTROLS CALLS TO WCMC RELATED PGMS IN W6000C
     A*      CONTROLS WORK W WCMS CLM OPTIONS 81 AND OPTION 50: #3
     A            SYFL02    R               REFFLD(FLAG)
     A*** FLAG 3 = CHECK REC INSTALLED ****
     A*      CONTROLS PROMPT FOR CHK REC FLAG ON BANK ACCT MASTER MAINT
     A*      CONTROLS CALL TO RELATED PGM IN W6000C
     A            SYFL03    R               REFFLD(FLAG)
     A*** FLAG 4 = REINSURANCE INSTALLED ****
     A            SYFL04    R               REFFLD(FLAG)
     A*** FLAG 5 = Non-WCMS installation
     A            SYFL05    R               REFFLD(FLAG)
     A*** FLAG 6 = Multi Group Restriction Install?
     A            SYFL06    R               REFFLD(FLAG)
     A                                      TEXT('MULTI GROUP RESTRICTION +
     A                                           INSTALLED FLAG')
     A***                                   Y      = Installed/used
     A***                                   *blank = not installed
     A*** Flag 7 contains an "X" if DTMU is licensed
     A            SYFL07    R               REFFLD(FLAG)
     A*** Flags 8-10 will contain the suffix for the application
     A*** environment. This value will be appended to the library names
     A            SYFL08    R               REFFLD(FLAG)
     A            SYFL09    R               REFFLD(FLAG)
     A            SYFL10    R               REFFLD(FLAG)
     A**** Fields SYAL01-04 in use. Do NOT use.
     A            SYAL01    R               REFFLD(DS10)
     A            SYAL02    R               REFFLD(DS10)
     A            SYAL03    R               REFFLD(DS10)
     A            SYAL04    R               REFFLD(DS10)
     A            SYAL05    R               REFFLD(DS10)
     A*  Position 1 = Credit Module
     A**** ALPHA 10 A FUTURE USE
     A            SYAL06    R               REFFLD(DS10)
     A            SYAL07    R               REFFLD(DS10)
     A            SYAL08    R               REFFLD(DS10)
     A            SYAL09    R               REFFLD(DS10)
     A            SYAL10    R               REFFLD(DS10)
     A*** RECORD MAINTENANCE INFORMATION ***
     A            SYSTAT    R               REFFLD(STAT)
     A                                      TEXT('RECORD STATUS')
     A            SYUSER    R               REFFLD(USER)
     A                                      TEXT('USER LAST MAINTAINED BY')
     A            SYPGM     R               REFFLD(PGM)
     A                                      TEXT('PGM LAST MAINTAINED IN')
     A            SYTIME    R               REFFLD(TIME)
     A                                      TEXT('TIME LAST MAINTAINED')
     A            SYDT      R               REFFLD(DT)
     A                                      TEXT('DATE LAST MAINTAINED')
     A            SYIUSR    R               REFFLD(USER)
     A                                      TEXT('INITIAL USER ENTERED BY')
     A            SYIDT     R               REFFLD(DT)
     A                                      TEXT('INITIAL DATE ENTERED')
     A**** SYSTEM THRESHOLD FOR MAX DOCS IN AS/400 FOLDER
     A            SYMXDC         9  0       TEXT('OV/400 MAX DOC IN FOLDER')
     A**** ALPHA 10A FUTURE USE
     A            SYFL11    R               REFFLD(DS10)
     A***                           Pos 1 = PDSQuest Installed flag (Y/ )
     A***                           Pos 2 = Data Center Client flag (Y/ )
     A***                           Pos 4 = LATEST GO VERSION IN USE(I.E. "4")
     A            SYFL12    R               REFFLD(DS10)
     A***                           Pos 1 = Group Copy PID flag (Y/ )
     A            SYFL13    R               REFFLD(DS10)
     A            SYFL14    R               REFFLD(DS10)
     A            SYFL15    R               REFFLD(DS10)
     A            SYFL16    R               REFFLD(DS10)
     A            SYFL17    R               REFFLD(DS10)
     A            SYFL18    R               REFFLD(DS10)
     A            SYFL19    R               REFFLD(DS10)
     A            SYFL20    R               REFFLD(DS10)
