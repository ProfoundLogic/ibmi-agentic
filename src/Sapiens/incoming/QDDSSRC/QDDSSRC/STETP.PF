     A                                      REF(WREFP)
     A          R PET01                     TEXT('Email Tokens File')
     A            ETCO#          3S 0       TEXT('Company#')
     A                                      COLHDG('COMPANY#')
     A            ETTOKEN       50A         TEXT('Email Token')
     A                                      COLHDG('EMAIL TOKEN')
     A            ETPOLICY       1A         TEXT('Avail For Policy')
     A                                      COLHDG('AVAIL FOR POLICY')
     A            ETCLAIM        1A         TEXT('Avail For Claim')
     A                                      COLHDG('AVAIL FOR CLAIM')
     A            ETMANGC        1A         TEXT('Avail for Managed Care')
     A                                      COLHDG('AVAIL FOR MANAG CARE')
     A            ETAGENT        1A         TEXT('Avail for Agent')
     A                                      COLHDG('AVAIL FOR AGENT')
     A            ETREPORT       1A         TEXT('Avail for Report')
     A                                      COLHDG('AVAIL FOR REPORT')
     A            ETPRECERT      1A         TEXT('Avail for Pre-Cert')
     A                                      COLHDG('AVAIL FOR PRE-CERT')
     A            ETPAYGO        1A         TEXT('Avail for Connect PayGo')
     A                                      COLHDG('AVAIL CONNECT PAYGO')
     A            ETQUOTE        1A         TEXT('Avail for Connect Quote')
     A                                      COLHDG('AVAIL CONNECT QUOTE')
     A            ETPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            ETUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            ETDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            ETTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            ETIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            ETIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            ETIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            ETITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            ETSTAT         1A         TEXT('Rec Status')
     A                                      COLHDG('REC STATUS')
