     A** WCMC CASE TRANSFER HISTORY FILE
     A                                      REF(FSREFP)
     A          R PTH01                     TEXT('CASE TRANSFER HISTORY FILE')
     A* * * FROM CASE
     A            THFCO#    R               REFFLD(CO#)
     A                                      COLHDG('FROM' 'COMPANY #')
     A            THFSUB    R               REFFLD(SUB#)
     A                                      COLHDG('FROM' 'SUBSCRIBER #')
     A            THFFND    R               REFFLD(FND)
     A                                      COLHDG('FROM' 'GRP#/FND#')
     A            THFFYR    R               REFFLD(FYR)
     A            THFCAS    R               REFFLD(CASE)
     A                                      COLHDG('FROM' 'CASE#')
     A            THFSS#    R               REFFLD(SS#)
     A                                      COLHDG('FROM' 'SS#')
     A            THFACD    R               REFFLD(DT)
     A                                      COLHDG('FROM' 'ACC DT')
     A* * * TO CASE
     A            THTCO#    R               REFFLD(CO#)
     A                                      COLHDG('TO' 'COMPANY #')
     A            THTSUB    R               REFFLD(SUB#)
     A                                      COLHDG('TO' 'SUBSCRIBER #')
     A            THTFND    R               REFFLD(FND)
     A                                      COLHDG('TO' 'GRP#/FND#')
     A            THTFYR    R               REFFLD(FYR)
     A            THTCAS    R               REFFLD(CASE)
     A                                      COLHDG('TO' 'CASE#')
     A            THTSS#    R               REFFLD(SS#)
     A                                      COLHDG('TO' 'SS#')
     A            THTACD    R               REFFLD(DT)
     A                                      COLHDG('TO' 'ACC DT')
     A*
     A            THUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT' 'USER')
     A            THPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT' 'PROGRAM')
     A            THTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT' 'TIME')
     A            THDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT' 'DATE')
     A            THIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            THIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
     A            TH1A1     R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A*                                     D      = DELETED CASE
     A*                                     BLANKS = CASE TRANSFERED
     A            TH1A2     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 2')
     A            TH1A3     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 3')
     A            TH1A4     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 4')
     A            TH1A5     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 5')
     A            TH1A6     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 6')
     A            TH1A7     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 7')
     A            TH1A8     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 8')
     A            TH1A9     R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 9')
     A            TH1A10    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 10')
     A            TH40A1    R               REFFLD(DS40)
     A                                      COLHDG('DESCRIPTION')
