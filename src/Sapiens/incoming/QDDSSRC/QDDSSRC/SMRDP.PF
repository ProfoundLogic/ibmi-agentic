     A                                      REF(SREFP)
     A          R PRD01                     TEXT('Recurring Diary -
     A                                      Tracking File')
     A*
     A            RDKEY         40A         COLHDG('Darts Key')
     A            RDSEQ#         5S 0       COLHDG('Darts Seq#')
     A            RDRMCD         5          COLHDG('Remark Code')
     A            RDRD#          5S 0       COLHDG('# of Recurrences')
     A            RDSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            RDUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            RDPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            RDTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            RDDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            RDIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            RDIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            RDITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            RDIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
