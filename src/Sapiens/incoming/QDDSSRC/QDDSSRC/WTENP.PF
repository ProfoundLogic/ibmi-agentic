      *  98/05/04  C:57  CM027  SUPPORT
      *                  ADDED FLD ENSNGL TO ALLOW FOR MULTI STATE/DIVISION
      *                  PROCESSING.  SOME FORMS NEED TO BE PRODUCED FOR
      *                  EACH DIVISION TO WHICH THEY ARE ATTACHED, WHEREAS
      *                  OTHERS NEED TO BE PRODUCED ONLY ONCE FOR THE ACCT.
     A**************************************************************************
     A                                      REF(WREFP)
     A          R PEN01                     TEXT('ENDORSEMENT FORM TABLE FILE')
     A            ENCO#     R     S         REFFLD(CO#)
     A            ENFND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            ENFORM        15          COLHDG('ENDORSEMENT' 'FORM')
     A            ENDESC    R               REFFLD(DS30)
     A                                      COLHDG('ENDORSEMENT' 'FORM' 'DESC')
     A            ENST      R               REFFLD(ST)
     A                                      COLHDG('ENDORSEMENT' 'FORM' 'STATE')
     A            ENEDDT    R               REFFLD(DT)
     A                                      COLHDG('EDITION' 'DATE')
     A            ENMNAU    R               REFFLD(FLAG)
     A                                      COLHDG('MANUAL' '/AUTO' 'ATTACH')
     A            ENPRNT    R               REFFLD(FLAG)
     A                                      COLHDG('SYSTEM' 'PRINT' 'Y/N')
     A            ENRPFM        15          COLHDG('REPLACED' 'BY' 'FORM')
     A            ENRPDT    R               REFFLD(DT)
     A                                      COLHDG('REPLACED' 'DATE')
     A            ENFLDR    R   32          REFFLD(FLDR)
     A                                      COLHDG('FOLDER')
     A            ENPGM1    R               REFFLD(PGM)
     A                                      TEXT('PGM 1 TO CALL')
     A            ENPGM2    R               REFFLD(PGM)
     A                                      TEXT('PGM 2 TO CALL')
     A            ENPGM3    R               REFFLD(PGM)
     A                                      TEXT('PGM 3 TO CALL')
     A            ENSCF1    R               REFFLD(CLAS)
     A                                      COLHDG('FROM' 'STAT' 'CODE 1')
     A            ENSCT1    R               REFFLD(CLAS)
     A                                      COLHDG('TO' 'STAT' 'CODE 1')
     A            ENSCF2    R               REFFLD(CLAS)
     A                                      COLHDG('FROM' 'STAT' 'CODE 2')
     A            ENSCT2    R               REFFLD(CLAS)
     A                                      COLHDG('TO' 'STAT' 'CODE 2')
     A            ENSCF3    R               REFFLD(CLAS)
     A                                      COLHDG('FROM' 'STAT' 'CODE 3')
     A            ENSCT3    R               REFFLD(CLAS)
     A                                      COLHDG('TO' 'STAT' 'CODE 3')
     A            ENSTAT    R               REFFLD(STAT)
     A            ENUSER    R               REFFLD(USER)
     A            ENPGM     R               REFFLD(PGM)
     A            ENTIME    R               REFFLD(TIME)
     A            ENDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*** BEG ADD ***** 05/04/98 ***********************************************
     A            ENSNGL    R               REFFLD(FLAG)
     A                                      COLHDG('SINGLE' 'MULTIPLE' 'FORM')
     A*** END ADD ***** 05/04/98 ***********************************************
     A*** Beg Add ***** 11/10/16 ***********************************************
     A            ENDSC2    R               REFFLD(DS00)
     A                                      COLHDG('Extended Description')
     A*** End Add ***** 11/10/16 ***********************************************
     A*** Beg Add ***** 02/28/17 ***********************************************
     A            ENDPOS    R               REFFLD(FLAG)
     A                                      COLHDG('DOC' 'POSITION')
     A*** End Add ***** 02/28/17  **********************************************
     A*** BEGIN ADD *** 05/16/17 ***********************************************
     A            ENPATHC      250A         COLHDG('CLIENT DOCUMENT PATH')
     A*** END ADD ***** 05/16/17 ***********************************************
     A*** BEGIN ADD *** 10/06/17 ***********************************************
     A            ENPEOF    R               REFFLD(FLAG)
     A                                      COLHDG('PEO' 'RELATIONSHIP')
     A*** END ADD ***** 10/06/17  **********************************************
     A*** BEG ADD ***** 11/03/17 ***********************************************
     A            ENEXFL    R               REFFLD(FLAG)
     A                                      COLHDG('EXCLUDE FROM' 'SCHEDULE')
     A*** END ADD ***** 11/03/17 ***********************************************
     A*** BEGIN ADD *** 11/08/17 ***********************************************
     A            ENGPDF    R               REFFLD(FLAG)
     A                                      COLHDG('GENERATE FROM' 'PDF FILE')
     A*** END ADD ***** 11/08/17 ***********************************************
     A*** BEGIN ADD *** 01/08/18 ***********************************************
     A            ENADTE    R     S         REFFLD(DT7)
     A                                      COLHDG('ADDOPTION DATE')
     A*** END ADD ***** 01/08/18 ***********************************************
     A*** BEGIN ADD *** 01/31/18 ***********************************************
     A            ENFORMO   R               REFFLD(DS50)
     A                                      COLHDG('Optional Form #' +
                                            'Override')
     A            ENNATFM   R               REFFLD(DS15)
     A                                      COLHDG('National/State' +
     A                                      'Form #')
     A            ENEXCWC   R               REFFLD(FLAG)
     A                                      COLHDG('Exclude from' +
     A                                      'WCPOLS flag')
     A*** END ADD ***** 01/31/18 ***********************************************
     A*** BEGIN ADD *** 01/08/18 ***********************************************
     A            ENTYPE        10A         COLHDG('Endorsement Type')
     A*** END ADD ***** 01/08/18 ***********************************************
     A*** BEGIN ADD *** 03/11/20 ***********************************************
     A            ENOEF          1A         COLHDG('Officer' 'Endorsement' +
     A                                      'Flag')
     A            ENOTOBF        1A         COLHDG('Officer' +
     A                                      'Type of Business' 'Flag')
     A            ENOTOBV       50A         COLHDG('Officer' +
     A                                      'Type of Business' 'Values')
     A*** END ADD ***** 03/11/20 ***********************************************
     A*** BEGIN ADD *** 12/28/20 ***********************************************
     A            ENUNEXPDT R     S         REFFLD(DT7)
     A                                      COLHDG('UNEXPIRED DATE')
     A*** END ADD ***** 12/28/20 ***********************************************
     A*** BEG ADD ***** 02/02/21 ***********************************************
     A            ENBLKWVDS    500A         COLHDG('BLANKET WAIVER' -
     A                                      'DEFAULT DESCRIPTION')
     A*** END ADD ***** 02/02/21 ***********************************************
