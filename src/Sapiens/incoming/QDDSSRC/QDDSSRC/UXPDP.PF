     A                                      REF(FSREFP)
     A          R PPD01                     TEXT('PROC/DIAG ANALYSIS WORKFILE')
     A            PDCO#     R               REFFLD(CO#)
     A            PDSUB#    R               REFFLD(SUB#)
     A            PDFND     R               REFFLD(FND) COLHDG('GROUP#')
     A            PDEMP#    R               REFFLD(EMP#)
     A            PDFEIN    R               REFFLD(FEIN)
     A            PDMOD     R               REFFLD(MOD)
     A            PDCPT4    R               REFFLD(CPT4)
     A            PDICD9    R               REFFLD(ICD9)
     A            PDTACT    R               REFFLD(A50)
     A                                      COLHDG('# CERTS' 'TOTAL' 'ACTIVITY')
     A            PDAPPR    R               REFFLD(A50)
     A                                      COLHDG('# CERTS' 'APPROVED')
     A            PDDENY    R               REFFLD(A50)
     A                                      COLHDG('# CERTS' 'DENIED')
     A            PDREQD    R               REFFLD(A50)
     A                                      COLHDG('REQUESTED' 'DAYS')
     A            PDRECD    R               REFFLD(A50)
     A                                      COLHDG('RECOMMENDED' 'DAYS')
     A            PDASAV    R               REFFLD(A50)
     A                                      COLHDG('TOT APPR' 'DAYS' 'SAVED')
     A            PDDSAV    R               REFFLD(A50)
     A                                      COLHDG('TOT DENY' 'DAYS' 'SAVED')
     A            PDTSAV    R               REFFLD(A50)
     A                                      COLHDG('TOT' 'SAVED' 'DAYS')
     A*** BEGIN ADD *** 01/19/99 **************************************
     A            PDNEGO    R               REFFLD(A50)
     A                                      COLHDG('# CERTS' 'NEGOTIATED')
     A            PDNSAV    R               REFFLD(A50)
     A                                      COLHDG('TOT NEGO' 'DAYS' 'SAVED')
     A*** END   ADD *** 01/19/99 **************************************
     A*** Beg Add *** 08/05/13 ***************************************
     A            PDICD10   R               REFFLD(DS7)
     A                                      COLHDG('ICD-10' 'Code')
