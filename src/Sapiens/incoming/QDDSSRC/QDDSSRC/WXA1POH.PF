     A*
     A*  EDI/NOI Transmission Data - OHIO BWC - 824
     A*
     A                                      REF(WREFP)
     A*
     A          R PA101                     TEXT('EDI OH 824 Format')
     A*
     A*      Transaction
     A*
     A            A1DOC#        30A         TEXT('148 Document number         ')
     A            A1TRID        30A         TEXT('148 Transaction ID          ')
     A            A1ACKC         2A         TEXT('Applic. Accept/Reject code  ')
     A            A1BADD        60A         TEXT('Bad Data copy               ')
     A            A1BIAC        30A         TEXT('Billing Account Number      ')
     A            A1CLCT        30A         TEXT('Claim Info contact name     ')
     A            A1CNBR        30A         TEXT('Claim Number                ')
     A            A1CNAM        30A         TEXT('Claimant name               ')
     A            A1CSS#         9A         TEXT('Claimant SS#                ')
     A            A1CTEL        10A         TEXT('Claimant telephone number   ')
     A            A1ACDT         8A         TEXT('Date of accident            ')
     A            A1SVDT         8A         TEXT('Date of service             ')
     A            A1EEIN         9A         TEXT('Employer ID                 ')
     A            A1EMCO        20A         TEXT('MCO ID                      ')
     A            A1MED#        30A         TEXT('Medical record number       ')
     A            A1CASG        30A         TEXT('BWC Claim Assignment        ')
     A            A1PAT#        30A         TEXT('Patient account number      ')
     A            A1RBWC        20A         TEXT('Receiver BWC number         ')
     A            A1RNAM        30A         TEXT('Receiver name               ')
     A            A1SBWC        20A         TEXT('Submitter BWC number        ')
     A            A1SNAM        30A         TEXT('Submitter name              ')
     A            A1TXT         60A         TEXT('Text error description      ')
     A            A1#LIN         9A         TEXT('Number line items accepted  ')
     A            A1RSET         3A         TEXT('Trans response to/TSET      ')
     A            A1ACLC        25A         TEXT('Claim Administrator Claim # ')
     A*
     A            A1OTDT    R    8A         REFFLD(DT)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'DATE')
     A            A1OTTM    R    6A         REFFLD(TIME)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'TIME')
     A            A1CO#     R               REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            A1JST     R               REFFLD(ST)
     A                                      COLHDG('JURISDICTION' 'STATE')
     A            A1STAT    R               REFFLD(FLAG)
     A                                      COLHDG('RECORD STATUS')
     A*                       BLANK = NOT PROCESSED
     A*                       'P'   = PROCESSED
