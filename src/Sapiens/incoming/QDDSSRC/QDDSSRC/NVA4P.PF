      *  DESCRIPTION:                                                 *
      *                                                               *
      *  This file used as "intermediate" between the AMC's           *
      *  OH Statewide CPT4 file and the Carve-out discount records.   *
      *                                                               *
      *  CREATED:                                                     *
      *                                                               *
      *  09/18/97 C:61 PROJECT 87MAU                                  *
      *                                                               *
      *****************************************************************
      *                                                               *
      *  REVISIONS:                                                   *
      *                                                               *
      *  XX/XX/XX C:XX PROJECT XXXXX                                  *
      *                XXX.......................................XXX  *
      *                XXX.......................................XXX  *
      *                                                               *
      *****************************************************************
      *
     A                                      REF(FSREFP)
     A          R PA401                     TEXT('OH Statewide CPT4')
      *
     A            A4CPT4    R               REFFLD(DS5)
     A                                      COLHDG('CPT CODE')
     A            A4SMC     R               REFFLD(DS7)
     A                                      COLHDG('SERVICE MODE CODE')
     A            A4DESC    R               REFFLD(DS30)
     A                                      COLHDG('DESCRIPTION')
     A            A407FE    R               REFFLD(DS9)
     A                                      COLHDG('7/1/96 MC FEE')
     A            A4UNIT    R               REFFLD(DS9)
     A                                      COLHDG('UNITS')
      *               If "unit", then take units entered in Bill Entry,
      *               then multiply fee * units.
      *
      *               If *BLANK, then take straight fee.
      *
     A            A4BYPS    R               REFFLD(DS6)
     A                                      COLHDG('BYPASS')
      *               If "bypass", then pay each codes at Fee Schedule
      *               allowable.
      *
      *               If *BLANK, then pay per multiple surgery rules,
      *               same as BWC's guidelines.
      *
      * PDS Audit Fields
      *
     A            A4DISC    R               REFFLD(DS3)
     A                                      COLHDG('DISCOUNT CODE')
      *               Based on NMBDP/BDCODE
      *
     A            A4EFDT    R               REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE DATE')
      *               Based on NMBDP/BDEFDT
      *
     A            A4CONV    R               REFFLD(FLAG)
     A                                      COLHDG('CONVERSION' 'STATUS' -
     A                                      'CODE')
      *               E = Assignment not made
      *               L = Assignment made
      *               U = Updated
      *
     A            A4STAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            A4USER    R               REFFLD(USER)
     A                                      COLHDG('CVT USER')
     A            A4PGM     R               REFFLD(PGM)
     A                                      COLHDG('CVT PROGRAM')
     A            A4TIME    R               REFFLD(TIME)
     A                                      COLHDG('CVT TIME')
     A            A4DT      R               REFFLD(DT7)
     A                                      COLHDG('CVT DATE')
     A            A4IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL CVT' 'USER')
     A            A4IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL CVT' 'PROGRAM')
     A            A4ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL CVT' 'TIME')
     A            A4IDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL CVT' 'DATE')
