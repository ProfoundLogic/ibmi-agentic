     A                                      REF(WREFP)
     A          R PHI01                     TEXT('ISO EXPORT HISTORY FILE')
     A*
     A            HICO#     R               REFFLD(CO#)
     A            HIFND     R               REFFLD(FND)
     A            HIFYR     R               REFFLD(FYR)
     A            HICASE    R               REFFLD(CASE)

     A            HISEQ#    R               REFFLD(A30)
     A                                      COLHDG('SEQUENCE #')
     A            HISTYP    R               REFFLD(FLAG)
     A                                      COLHDG('SUBMISSION TYPE')
      * I=Initial  R=Replacement  S=Re-search  U=Update
      *
     A            HISTYC    R               REFFLD(FLAG)
     A                                      COLHDG('SUBMISSION TYPE CODE')
     A            HISSTS    R               REFFLD(FLAG)
     A                                      COLHDG('SUBMISSION STATUS')
      * 1=Missing data  2=Ready to send  3=Sent to ISO
      * 4=Data error on import  5=No match found 6=Match found
      *
     A            HITOTI    R               REFFLD(A90)
     A                                      COLHDG('TOTAL INCURRED AMT')
     A            HIEXDT    R               REFFLD(DT)
     A                                      COLHDG('EXPORT DT')
     A            HIIMDT    R               REFFLD(DT)
     A                                      COLHDG('IMPORT DT')

     A            HIUSER    R               REFFLD(USER)
     A            HIPGM     R               REFFLD(PGM)
     A            HITIME    R               REFFLD(TIME)
     A            HIDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            HIIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            HIIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            HIITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            HIIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
