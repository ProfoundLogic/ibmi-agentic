     A*
     A* Matrix Payment File - Header
     A*
     A*****************************************************************
     A* Created on 01/27/2003 by c:62 for Project 114MEK
     A*****************************************************************
     A* Purpose: This file will house the payment record for the
     A*          associated Matrix records.  Additional fields will be
     A*          added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAP9P record via P1NAME.
     A*****************************************************************
     A* Revisions:
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PP101                     TEXT('Matrix Payment File')
     A            P1PAYI    R               REFFLD(DS4)
     A                                      COLHDG('Payer indicator')
     A            P1CLM#    R               REFFLD(DS25)
     A                                      COLHDG('Claim#')
     A            P1CSS#    R               REFFLD(SS#)
     A                                      COLHDG('SS#')
     A            P1DOI     R               REFFLD(DT8)
     A                                      COLHDG('Date of Injury')
     A            P1INDT    R               REFFLD(DT8)
     A                                      COLHDG('Invoice Date')
     A            P1INV#    R               REFFLD(DS25)
     A                                      COLHDG('Invoice #')
     A            P1INVA    R     S         REFFLD(A92)
     A                                      COLHDG('Invoice Amount')
     A            P1CLSN    R               REFFLD(DS30)
     A                                      COLHDG('Last Name')
     A            P1CFSN    R               REFFLD(DS15)
     A                                      COLHDG('First Name')
     A            P1CDOB    R               REFFLD(DT8)
     A                                      COLHDG('Date of Birth')
     A            P1CADR        80A
     A                                      COLHDG('Claimant Address')
     A            P1CCTY    R               REFFLD(DS25)
     A                                      COLHDG('Claimant City')
     A            P1CST     R               REFFLD(ST)
     A                                      COLHDG('Claimant State')
     A            P1CZIP    R     S         REFFLD(A90)
     A                                      COLHDG('Claimant Zip')
     A*****************************************************************
     A            P1NAME    R               REFFLD(DS10)
     A                                      COLHDG('RXFINPT Member #')
     A            P1MBR#    R               REFFLD(DS10)
     A                                      COLHDG('FAP0P Member #')
     A            P1SCL#    R               REFFLD(SCL#)
     A                                      COLHDG('(PDS) Claim #')
     A            P1CO#     R               REFFLD(CO#)
     A                                      COLHDG('(PDS) Company #')
     A            P1SUB#    R               REFFLD(SUB#)
     A                                      COLHDG('(PDS) Subscriber #')
     A            P1FND     R               REFFLD(FND)
     A                                      COLHDG('(PDS) Group #')
     A            P1FYR     R               REFFLD(FYR)
     A                                      COLHDG('(PDS) Year')
     A            P1CASE    R               REFFLD(CASE)
     A                                      COLHDG('(PDS) Case #')
     A            P1PSS#    R               REFFLD(SS#)
     A                                      COLHDG('(PDS) SS#')
     A            P1PACD    R               REFFLD(DT)
     A                                      COLHDG('(PDS) ACDT')
     A            P1PFEI    R               REFFLD(FEIN)
     A                                      COLHDG('(PDS) FEIN')
     A            P1PMOD    R               REFFLD(MOD)
     A                                      COLHDG('(PDS) Mod')
     A            P1EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB')
     A            P1PRDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Process Date')
     A            P1PRTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Process Time')
     A            P1PRUS    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Process User')
     A            P1PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A*
     A*                                     *blank = not processed yet
     A*                                     "E" = Error
     A*                                     "W" = Written to Error File
     A*                                     "Y" = written to WCMC
     A*
     A            P1RDSC    R               REFFLD(DS50)
     A                                      COLHDG('Rejection Desc')
