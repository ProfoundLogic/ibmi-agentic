     A            FEJOB#         6          TEXT('JOB NUMBER OF SPLF')
     A            FEUSRN        10          TEXT('USER NAME OF SPLF')
     A            FEJOBN        10          TEXT('JOB NAME OF SPLF')
     A*
     A            FEFILN        10          TEXT('FILE"S NAME(IE QSYSPRT)')
     A            FEFIL#         3          TEXT('FILE"S NUMBER OF SPLF')
     A            FEMSGI         7          TEXT('FAX ERR MSG ID')
     A            FESTAT    R               REFFLD(STAT)
     A            FEUSER    R               REFFLD(USER)
     A            FEPGM     R               REFFLD(PGM)
     A            FETIME    R               REFFLD(TIME)
