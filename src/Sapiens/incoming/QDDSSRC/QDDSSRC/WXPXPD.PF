     A** WORKERS' COMP  POLICY EXPORT PAYROLL DETAIL CSV FILE
     A**************************************************************************
     A* REVISIONS:                                                             *
     A*                                                                        *
     A* 03/14/06 C:136 PROJECT: WC1320                                         *
     A*                ADD CSV ENHANCEMENT TO POLICY EXPORT PROCESS            *
     A**************************************************************************
     A          R PPX01D                    TEXT('PYRL DETL FOR POLICY EXPORT')
                  PARTYP         1A         COLHDG('REC_TYPE')
                  PACAP#        25A         COLHDG('POLICY#')
                  PAFND          3A         COLHDG('GRP#')
                  PAEMP#         9A         COLHDG('EMPLOYER #')
                  PADIV          5A         COLHDG('DIVISION')
                  PAEAPR         5A         COLHDG('EST ANNUAL PAYROLL')
                  PACLAS         6A         COLHDG('PAYROLL CLASS CODE')
                  PASPEC         5A         COLHDG('PAYROLL SPEC CODE')
                  PAADLD         1A         COLHDG('PAYROLL ADD LOAD')
                  PAEMPR         1A         COLHDG('MANUAL PREMIUM')
                  PAARAT         8A         COLHDG('PAYROLL MANUAL RATE')
                  PAECNT         8A         COLHDG('EMPLOYEE COUNT')
                  PANTRT        11A         COLHDG('PAYROLL NET RATE')
                  PABLRT         1A         COLHDG('PAYROLL BLENDED RATE')
                  PANBRT        25A         COLHDG('PYRL NET BLND RATE')
                  PACADT         3A         COLHDG('PAYROLL CX DATE')
                  PADESC         9A         COLHDG('PAYROLL CLASS DESC')
                  PAPPAY         5A         COLHDG('PRORATED PAYROLL AMT')
                  PAAAPR         5A         COLHDG('AUD ANNUAL PAYROLL')
                  PASAFL         6A         COLHDG('AMOUNT')
                  PAPCF         11A         COLHDG('EST/AUD FLAG')
                  PAMNPR         1A         COLHDG('PERCAP/NON-PERCAP')
                  PANETF         1A         COLHDG('MINIMUM PREMIUM AMT')
                  PAFPRM        11A         COLHDG('NET FACT FOR ADDL LD')
                  PAAMPR         5A         COLHDG('FINAL PREMIUM')
                  PAEFDT        11A         COLHDG('AUD MANUAL PREMIUM')
                  PAVDR#         5A         COLHDG('PAYROLL EFF DATE')
