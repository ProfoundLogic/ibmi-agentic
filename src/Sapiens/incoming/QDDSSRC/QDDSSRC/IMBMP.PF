     A          R PBM01                     TEXT('BATCH MASTER FILE')
     A*
     A*
     A            BMBCHI        12          COLHDG('BATCH ID')
     A            BMBSTS         2          COLHDG('BATCH STATUS')
      *  VALID STATUS CODES ARE KEPT IN THE BATCH STATUS TABLE FILE
      *   SC, RL, CM, IX, HD, RJ, RS, ER, QC, DL......
     A            BMDOCT         8          COLHDG('DOC TYPE')
     A            BMSREP        10          COLHDG('SCANNER USER')
     A            BMSDT          8  0       COLHDG('SCANNED DATE')
     A            BMSTM          6  0       COLHDG('SCANNED TIME')
     A            BME#DC         5  0       COLHDG('EXPECTED' '# OF DOCS')
     A            BMA#DC         5  0       COLHDG('ACTUAL' '# OF DOCS')
     A            BME#PG         6  0       COLHDG('EXPECTED' '# OF PAGES')
     A            BMA#PG         6  0       COLHDG('ACTUAL' '# OF PAGES')
     A            BM#PGP         3  0       COLHDG('# OF PAGES' 'PER DOC')
     A            BMDSEP         1          COLHDG('USED DOC SEPERATORS')
     A*
     A            BMBDSC        40          COLHDG('BATCH DESCRIP.')
     A*
     A***** LAST MAINT INFO  *****
     A            BMSTAT         1          COLHDG('RCD STATUS')
     A*
     A            BMIUSR        10          TEXT('INIT USER')
     A            BMIPGM        10          TEXT('INIT PGM')
     A            BMITIM         6S 0       TEXT('INIT TIME')
     A            BMIDT          6S 0       TEXT('INIT DATE')
     A            BMLUSR        10          TEXT('USER LAST MAINT')
     A            BMLPGM        10          TEXT('LAST MAINT PGM')
     A            BMLTIM         6S 0       TEXT('LAST MAINT TIME')
     A            BMLDT          6S 0       TEXT('LAST MAINT DATE')
     A*
     A            BMFL01         1          TEXT('**FUTURE USE FLG 01 **')
     A            BMFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            BMFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            BMFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            BMFL05         1          TEXT('**FUTURE USE FLG 05 **')
