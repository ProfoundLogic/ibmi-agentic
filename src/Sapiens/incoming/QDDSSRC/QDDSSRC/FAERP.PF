     A** WCMC - RECON/REFUND EOMB TRANSACTION FILE
     A****************************************************************
     A**
     A                                      REF(FSREFP)
     A          R PER01                     TEXT('RECON EOB TRANS FILE')
     A            ERCO#     R               REFFLD(CO#)
     A            ERSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A            ERFND     R               REFFLD(FND)
     A            ERFYR     R               REFFLD(FYR)
     A            ERCASE    R               REFFLD(CASE)
     A            ERSS#     R               REFFLD(SS#)
     A            ERACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE')
     A            ERREOB    R               REFFLD(EOB#)
     A                                      COLHDG('RECON EOB#')
     A            ERTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            EROEOB    R               REFFLD(EOB#)
     A                                      COLHDG('OLD EOB#')
     A            ERSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('RECON' 'SEQUENCE #')
     A            EROINV    R               REFFLD(SEQ#)
     A                                      COLHDG('OLD' 'INVOICE#')
     A            ERRECA    R               REFFLD(A92)
     A                                      COLHDG('RECON' 'AMOUNT')
     A            ERREFA    R               REFFLD(A92)
     A                                      COLHDG('REFUND' 'AMOUNT')
     A            ERSYS     R               REFFLD(FLAG)
     A                                      COLHDG('SYSTEM ID')
     A            ERFL01    R               REFFLD(FLAG)
     A                                      COLHDG('INVOICE' 'NOT PROCESSED')
     A*                                        Valid Values:
     A*                                        X = Inv NOT processed, No refund
     A*                                        Blank = Invoice Processed
     A            ERFL02    R               REFFLD(FLAG)
     A                                      COLHDG('DELETED' 'EOMB')
     A*                                        Valid Values: Y or N
     A            ERFL03    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 3')
     A            ERFL04    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 4')
     A            ERFL05    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 5')
     A            ERFL06    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 6')
     A            ERFL07    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 7')
     A            ERFL08    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 8')
     A            ERFL09    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 9')
     A            ERFL10    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG 10')
     A            ER92N1    R               REFFLD(A92)
     A                                      COLHDG('ORIGINAL' 'BILLING' +
     A                                      'AMOUNT')
     A            ER92N2    R               REFFLD(A92)
     A                                      COLHDG('AMOUNT' 'APPLIED'   +
     A                                      'TO MRA REDUCTIONS')
     A            ER92N3    R               REFFLD(A92)
     A                                      COLHDG('AMOUNT' 'APPLIED'   +
     A                                      'TO OTHER REDUCTIONS')
     A            ER92N4    R               REFFLD(A92)
     A                                      COLHDG('4 AMOUNT 9.2')
     A            ER92N5    R               REFFLD(A92)
     A                                      COLHDG('5 AMOUNT 9.2')
     A            ER10A1    R               REFFLD(DS10)
     A                                      COLHDG('1 DESC 10')
     A            ER10A2    R               REFFLD(DS10)
     A                                      COLHDG('2 DESC 10')
     A            ER10A3    R               REFFLD(DS10)
     A                                      COLHDG('3 DESC 10')
     A            ERUSER    R               REFFLD(USER)
     A            ERPGM     R               REFFLD(PGM)
     A            ERTIME    R               REFFLD(TIME)
     A            ERDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ERIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ERIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
