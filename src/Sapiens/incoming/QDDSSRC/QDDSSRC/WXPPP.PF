     A          R PPP01                     TEXT('PEO Payroll Import File')
     A            PPRECT         1A         COLHDG('Record Type')
     A            PPRCNT         9A         COLHDG('Record Count')
     A            PPPEOL        15A         COLHDG('Client Link')
     A            PPRST          2A         COLHDG('Rating State')
     A            PPCLAS         5A         COLHDG('Class Code')
     A            PPSPEC         1A         COLHDG('Class Special')
     A            PPEXT          5A         COLHDG('Class Extension')
     A            PPEAMT        11A         COLHDG('Estimated Amount')
     A            PPEFDT         8A         COLHDG('Eff Date')
     A            PPCXDT         8A         COLHDG('Cx Date')
     A            PPECNT         7A         COLHDG('Emp Count')
     A            PPREPL         1A         COLHDG('Replace Flag')
     A            PPCORT         1A         COLHDG('Correct Rate')
