     A                                      REF(WREFP)
     A          R PMU01                     TEXT('Endorsement Forms File')
     A            MUXML         60A         COLHDG('XML File Name')
     A            MUCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            MUFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group')
     A            MUFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('Group Year')
     A            MUEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer')
     A            MUSEQ#         9S 0       COLHDG('Sequence Number')
     A            MUFORM        25A         COLHDG('Form Name')
     A            MUDESC       100A         COLHDG('Form Description')
     A            MUATCH         1A         COLHDG('Form Attached')
     A            MUIMPRT        1A         COLHDG('Form Important')
     A            MUUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            MUPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            MUTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            MUDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            MUIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            MUIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            MUITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            MUIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
