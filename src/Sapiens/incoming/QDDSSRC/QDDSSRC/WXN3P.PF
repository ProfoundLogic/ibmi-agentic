     A                                      REF(WREFP)
     A**
     A          R PN301                     TEXT('EDI Cancel Elementsta')
     A            N3CO#     R               REFFLD(CO#)
     A            N3JRST    R               REFFLD(CODE)
     A                                      TEXT('Jurisdiction')
     A                                      COLHDG('Jurisdiction')
     A            N3EXDT    R               REFFLD(DT8)
     A                                      TEXT('Extract Date')
     A                                      COLHDG('Extract Date')
     A            N3TSET    R               REFFLD(DS3)
     A                                      TEXT('Transaction set ID')
     A                                      COLHDG('Transaction set ID')
     A            N3ACLC        25A         TEXT('Admin claim #')
     A                                      COLHDG('Admin claim #')
     A            N3MTC     R               REFFLD(CODE)
     A                                      TEXT('MTC')
     A                                      COLHDG('MTC')
     A            N3CXRC    R               REFFLD(FLAG)
     A                                      TEXT('Cancel Reason Code')
     A                                      COLHDG('Cancel Reason Code')
     A            N3JRC#        25A         TEXT('Jurisdiction Claim Number')
     A                                      COLHDG('Jurisdiction' +
     A                                             'Claim Number')
     A            N3CRNA       150A         TEXT('Cancel Reason Narrative')
     A                                      COLHDG('Cancel Reason' +
     A                                             'Narrative')
