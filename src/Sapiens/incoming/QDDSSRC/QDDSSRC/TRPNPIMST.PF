     A*===============================================================*
     A          R TRPNPIMSTR
     A            NPNPI         10  0       COLHDG('NPI #')
     A            NPENTY         1  0       COLHDG('ENTITY#')
     A            NPONAME       70          COLHDG('ORG NAME')
     A            NPLNAME       35          COLHDG('LAST NAME')
     A            NPFNAME       20          COLHDG('FIRST NAME')
     A            NPMNAME       20          COLHDG('MIDDLE NAME')
     A            NPPREFIX       5          COLHDG('PREFIX TEXT')
     A            NPSUFFIX       5          COLHDG('SUFFIX TEXT')
     A            NPADDR1       55          COLHDG('BILLING ADDR1')
     A            NPADDR2       55          COLHDG('BILLING ADDR2')
     A            NPCITY        40          COLHDG('BILLING CITY')
     A            NPSTATE       40          COLHDG('BILLING STATE')
     A            NPZIP         20          COLHDG('BILLING ZIP')
     A            NPCOU          2          COLHDG('COUNTRY CODE')
     A            NPPHN         20          COLHDG('BILLING PHONE')
     A            NPLIC1        20          COLHDG('PRV LICENSE1 #')
     A            NPLICS1        2          COLHDG('PRV LIC' 'ST CODE1')
     A            NPLIC2        20          COLHDG('PRV LICENSE2 #')
     A            NPLICS2        2          COLHDG('PRV LIC' 'ST CODE2')
     A            NPLIC3        20          COLHDG('PRV LICENSE3 #')
     A            NPLICS3        2          COLHDG('PRV LIC' 'ST CODE3')
     A            NPLIC4        20          COLHDG('PRV LICENSE4 #')
     A            NPLICS4        2          COLHDG('PRV LIC' 'ST CODE4')
     A            NPLIC5        20          COLHDG('PRV LICENSE5 #')
     A            NPLICS5        2          COLHDG('PRV LIC' 'ST CODE5')
     A            NPLIC6        20          COLHDG('PRV LICENSE6 #')
     A            NPLICS6        2          COLHDG('PRV LIC' 'ST CODE6')
     A            NPLIC7        20          COLHDG('PRV LICENSE7 #')
     A            NPLICS7        2          COLHDG('PRV LIC' 'ST CODE7')
     A            NPLIC8        20          COLHDG('PRV LICENSE8 #')
     A            NPLICS8        2          COLHDG('PRV LIC' 'ST CODE8')
     A            NPLIC9        20          COLHDG('PRV LICENSE9 #')
     A            NPLICS9        2          COLHDG('PRV LIC' 'ST CODE9')
     A            NPLIC10       20          COLHDG('PRV LICENSE 10#')
     A            NPLICS10       2          COLHDG('PRV LIC' 'ST CODE10')
     A            NPLIC11       20          COLHDG('PRV LICENSE 11#')
     A            NPLICS11       2          COLHDG('PRV LIC' 'ST CODE11')
     A            NPLIC12       20          COLHDG('PRV LICENSE 12#')
     A            NPLICS12       2          COLHDG('PRV LIC' 'ST CODE12')
     A            NPLIC13       20          COLHDG('PRV LICENSE 13#')
     A            NPLICS13       2          COLHDG('PRV LIC' 'ST CODE13')
     A            NPLIC14       20          COLHDG('PRV LICENSE 14#')
     A            NPLICS14       2          COLHDG('PRV LIC' 'ST CODE14')
     A            NPLIC15       20          COLHDG('PRV LICENSE 15#')
     A            NPLICS15       2          COLHDG('PRV LIC' 'ST CODE15')
     A            NPDATEC        8  0       COLHDG('DATE CREATED')
     A            NPDATEM        8  0       COLHDG('DATE MAINT')
     A          K NPNPI
