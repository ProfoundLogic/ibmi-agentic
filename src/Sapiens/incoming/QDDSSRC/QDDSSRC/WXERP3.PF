     A                                      REF(WREFP)
     A          R PER01                     TEXT('Froi Import Error File')
     A            ERRRN          9S 0       COLHDG('Import RRN')
     A            ERFSN         15A         COLHDG('Claimant first' +
     A                                      'Name')
     A            ERLSN         30A         COLHDG('Claimant Last' +
     A                                      'Name')
     A            ERMID          1A         COLHDG('Claimant Middle' +
     A                                      'Initial')
     A            ERERR        100A         COLHDG('Error message')
     A            ERACDT         8A         COLHDG('Accident Date')
