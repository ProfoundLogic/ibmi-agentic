     A                                      REF(WREFP)
     A          R PCX01                     TEXT('CANCELLATION DETAIL FILE')
     A            CXCO#     R               REFFLD(CO#)
     A            CXFND     R               REFFLD(FND)
     A            CXFYR     R               REFFLD(FYR)
     A            CXEMP#    R               REFFLD(EMP#)
     A            CXDIV     R               REFFLD(DIV)
     A            CXREQ#    R               REFFLD(SEQ#)
     A            CXCXDT    R               REFFLD(DT)
     A                                      COLHDG('CANCEL' 'DATE')
     A            CXCDAT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'CANCELLATION ISSUED')
     A            CXAGT#    R               REFFLD(AGT#)
     A            CXRSN     R               REFFLD(CODE)
     A                                      COLHDG('CANCEL REASON')
     A            CXCOM1    R               REFFLD(NM60)
     A                                      COLHDG('COMMENT 1')
     A            CXCOM2    R               REFFLD(NM60)
     A                                      COLHDG('COMMENT 2')
     A            CXCCRT    R               REFFLD(FLAG)
     A                                      COLHDG('CANCEL CERT')
     A            CXCDRT    R               REFFLD(CODE)
     A                                      COLHDG('CANCEL DART CODE')
     A            CXREIN    R               REFFLD(FLAG)
     A                                      COLHDG('REINSTATED FLAG')
     A            CXREDT    R               REFFLD(DT)
     A                                      COLHDG('REINSTATEMENT' 'DATE')
     A            CXRDAT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'REINSTATEMNT ISSUED')
     A            CXRCRT    R               REFFLD(FLAG)
     A                                      COLHDG('REINSTATEMENT CERT')
     A            CXRDRT    R               REFFLD(CODE)
     A                                      COLHDG('REINSTATEMENT' 'DART CODE')
     A            CXSTAT    R               REFFLD(STAT)
     A            CXUSER    R               REFFLD(USER)
     A            CXPGM     R               REFFLD(PGM)
     A            CXTIME    R               REFFLD(TIME)
     A            CXDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            CXREVL    R               REFFLD(FLAG)
     A                                      COLHDG('NCCI REINSTATE VALUE')
     A            CXIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            CXIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            CXITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            CXIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            CXCFFL    R               REFFLD(FLAG)
     A                                      COLHDG('CONFIRM OF CX FLAG')
     A            CXCFDT    R               REFFLD(DT)
     A                                      COLHDG('CANCELLATION' 'CONFIRMED' -
     A                                      'DATE')
     A            CXCEMN    R               REFFLD(DS10)
     A                                      COLHDG('CERTIFIED MAIL #')
     A            CXDOI#         9  0       COLHDG('DEPT OF INS #')
     A            CXCNC#         3  0       COLHDG('CANCELLATION' 'COUNT')
     A            CXERR     R               REFFLD(FLAG)
     A                                      COLHDG('CANCELLATION' 'IN ERROR')
     A            CXAMTD    R               REFFLD(A92)
     A                                      COLHDG('AMOUNT' 'DUE')
     A            CXRFEE    R               REFFLD(A72)
     A                                      COLHDG('REINSTATEMENT FEE')
     A            CXRFDS    R               REFFLD(DS40)
     A                                      COLHDG('REINSTATEMENT FEE' 'DESC')
     A            CXCAP#    R               REFFLD(DS25)
     A                                      COLHDG('CARRIER POLICY#')
     A            CXRPMY    R               REFFLD(RMY5)
     A                                      COLHDG('REPORTING MONTH/YEAR')
     A            CXCFPD    R               REFFLD(DT)
     A                                      COLHDG('CONFIRMATION' 'PROCESSED+
     A                                              DT')
     A            CXCARR    R               REFFLD(NAME)
     A                                      COLHDG('CARRIER NAME')
     A            CXENFL    R               REFFLD(FLAG)
     A                                      COLHDG('ENDORSEMENT' 'FLAG')
     A            CXRCM1    R               REFFLD(DS60)
     A                                      COLHDG('REINSTATE' 'COMMENT')
     A            CXRCM2    R               REFFLD(DS60)
     A                                      COLHDG('REINSTATE' 'COMMENT')
     A            CXRST     R               REFFLD(ST)
     A                                      COLHDG('PREMIUM RATING STATE')
      *
     A            CXCAFL    R               REFFLD(FLAG)
     A                                      COLHDG('CONFIRMED' +
     A                                      'AUDIT REQUEST')
      *
      *
     A            CXEAFL    R               REFFLD(FLAG)
     A                                      COLHDG('Current estimated, ' -
     A                                      'Prior Audited' 'or Both')
      *
      *
     A            CXAFLT    R               REFFLD(FLAG)
     A                                      COLHDG('Auto Flat CX of ' -
     A                                      'Renewal Year')
      *                     Values: (Y/ )
      *
      ***** BEG ADD ***** 06/21/12 ***********************************
      *
     A            CXRECD    R               REFFLD(CODE)
     A                                      COLHDG('Reinstatement' +
     A                                      'Reason Code')
      *
      ***** END ADD ***** 06/21/12 ***********************************
      **** BEGIN ADD **** 09/16/19 ************************************
     A            CXWEDT         7S 0
     A                                      COLHDG('WEEK ENDING' 'DATE')
      **** END   ADD **** 09/16/19 ************************************
      *** Beg Add *** 02/26/24 *** WC2956 **************************************
     A            CXPDPR    R               REFFLD(FLAG)
     A                                      COLHDG('PENDING/PROCESSING' 'FLAG')
      *** End Add *** 02/26/24 *** WC2956 **************************************
      *** Begin Add *** 07/21/25 **************************************
     A            CXBAT#    R     S         REFFLD(A90)
     A                                      COLHDG('Mass CX Batch #')
     A            CXLFEE    R     S         REFFLD(A72)
     A                                      COLHDG('Late Fee Amount')
      *** End   Add *** 07/21/25 **************************************
