     A** WC MANAGED CARE - BWC TREATMENT PLAN FILE
     A                                      REF(FSREFP)
     A          R PTR01                     TEXT('BWC TREATMENT PLAN FILE')
     A            TRCO#     R               REFFLD(CO#)
     A            TRSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A            TRFND     R               REFFLD(FND)
     A            TRFYR     R               REFFLD(FYR)
     A            TRCASE    R               REFFLD(CASE)
     A            TRTX#     R               REFFLD(A50)
     A                                      COLHDG('TREATMENT #')
     A            TRBGDT    R               REFFLD(DT)
     A                                      COLHDG('TX PLAN' 'BEGIN DATE')
     A            TRENDT    R               REFFLD(DT)
     A                                      COLHDG('TX PLAN' 'END DATE')
     A            TRMMI     R               REFFLD(FLAG)
     A                                      COLHDG('MAX MED' 'IMPROVEMENT')
     A            TRLTDT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'LAST TX')
     A            TRCONT    R               REFFLD(NAME)
     A                                      COLHDG('MCO CONTACT' 'NAME')
     A            TRAREA    R               REFFLD(AREA)
     A                                      COLHDG('MCO AREA' 'CODE')
     A            TRPHN#    R               REFFLD(PHN#)
     A                                      COLHDG('MCO PHONE')
     A            TRSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
