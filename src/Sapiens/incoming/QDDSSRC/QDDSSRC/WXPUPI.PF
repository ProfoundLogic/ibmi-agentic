     A                                      COLHDG('DIV')
     A            PURDT     R               REFFLD(DT8)
     A                                      COLHDG('REPORTG DT')
     A            PUPAMT        11S 2       TEXT('PAYROLL AMOUNT')
     A                                      COLHDG('PAYROLL AMT')
     A            PUPAS          1A         TEXT('P/R AMOUNT SIGN')
     A                                      COLHDG('SIGN')
     A            PUCLAS         5S 0       TEXT('P/R CLASS')
     A                                      COLHDG('PR CLAS')
     A            PUPSPC         1A         TEXT('CLASS SPEC CODE')
     A                                      COLHDG('SPEC')
     A            PUCXDT    R               REFFLD(DT8)
     A                                      COLHDG('P/R CX DT')
     A            PUNEMP         7S 0       TEXT('NUMBER EMPLOYEES')
     A                                      COLHDG('NBR EMPL')
     A            PULSN         30A         TEXT('LAST NAME')
