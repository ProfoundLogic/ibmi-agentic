     A                                      REF(CREFP)
     A          R PPE01                     TEXT('POLICY EXPIRATION WORK FILE')
     A            PECO#     R               REFFLD(CO#)
     A            PEPOL#    R               REFFLD(POL#)
     A            PEFIN     R               REFFLD(NAME)
     A                                      COLHDG('NAMED INSURED')
     A            PEFEIN    R               REFFLD(FEIN)
     A            PEMOD     R               REFFLD(MOD)
     A            PEEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            PEEXDT    R               REFFLD(DT)
     A                                      COLHDG('EXPIRATION DATE')
     A            PECNDT    R               REFFLD(DT)
     A                                      COLHDG('CANCELLATION DATE')
     A            PEACMY    R               REFFLD(ACMY)
     A            PEAGCO    R               REFFLD(AGT#)
     A                                      COLHDG('AGENT FOR' 'COMMISSIONS')
     A            PEPRCO    R               REFFLD(PRO#)
     A                                      COLHDG('PRODUCER FOR' 'COMMISSIONS')
     A            PEAGRC    R               REFFLD(AGT#)
     A                                      COLHDG('AGENT OF RECORD')
     A            PEPRRC    R               REFFLD(PRO#)
     A                                      COLHDG('PRODUCER OF RECORD')
     A            PEDTRC    R               REFFLD(DT)
     A                                      COLHDG('AGT OF REC EFF DT')
     A            PECC01    R               REFFLD(CDE)
     A                                      COLHDG('SECTION #')
     A            PECANC    R               REFFLD(FLAG)
     A                                      COLHDG('CANCELLATION FLAG')
     A            PETPOL    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE OF POLICY')
     A          K PECC01
     A          K PEPOL#
