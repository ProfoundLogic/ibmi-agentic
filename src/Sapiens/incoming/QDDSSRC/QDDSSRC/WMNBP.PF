     A                                      REF(WREFP)
     A          R PNB01                     TEXT('Renewal Tracking File')
     A            NBCO#     R               REFFLD(CO#)
     A            NBFND     R               REFFLD(FND)
     A            NBEMP#    R               REFFLD(EMP#)
      *
      *
     A            NBRCDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Received')
      *
     A            NBENDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Entered')
      *
     A            NBIWDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Initial Underwriter' 'Review')
      *
     A            NBQTDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Quoted')
      *
     A            NBDCDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Declined')
      *
     A            NBLSDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Lost' )
      *
     A            NBAADT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Agent Approval' 'Date')
      *
     A            NBPGDT         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Policy Generated')
      *
     A            NBPOLD         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Policy Mailed')
      *
     A            NBPAND         7S 0
     A                                      COLHDG('New Business' +
     A                                      'Panel Mailed')
      *
      *
     A            NBSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
      *
     A            NBUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
      *
     A            NBPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Program')
      *
     A            NBTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
      *
     A            NBDT      R               REFFLD(DT)
     A                                      COLHDG('Maint Date')
      *
     A            NBIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
      *
     A            NBIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
      *
     A            NBITM     R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
      *
     A            NBIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
      ***  begin add  ***  05/31/05 ***********************************
      *
     A            NBPRDT    R     S         REFFLD(DT)
     A                                      COLHDG('Panel Rqst Date')
      *
     A            NBPCDT    R     S         REFFLD(DT)
     A                                      COLHDG('Panel Crt Date')
      *
     A            NBPPDT    R     S         REFFLD(DT)
     A                                      COLHDG('Panel Post Date')
      *
      ***  end   add  ***  05/31/05 ***********************************
