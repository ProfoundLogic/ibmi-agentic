     A                                      REF(WREFP)
     A          R PXH01                     TEXT('CANCELLATION HISTORY FILE')
     A            XHCO#     R               REFFLD(CO#)
     A            XHFND     R               REFFLD(FND)
     A            XHFYR     R               REFFLD(FYR)
     A            XHEMP#    R               REFFLD(EMP#)
     A            XHDIV     R               REFFLD(DIV)
     A            XHREQ#    R               REFFLD(SEQ#)
     A            XHCXDT    R               REFFLD(DT)
     A                                      COLHDG('CANCEL' 'DATE')
     A            XHCDAT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'CANCELLATION ISSUED')
     A            XHAGT#    R               REFFLD(AGT#)
     A            XHRSN     R               REFFLD(CODE)
     A                                      COLHDG('CANCEL REASON')
     A            XHREDT    R               REFFLD(DT)
     A                                      COLHDG('REINSTATEMENT' 'DATE')
     A            XHRDAT    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'REINSTATEMNT ISSUED')
     A            XHTRDT    R               REFFLD(DT)
     A                                      COLHDG('CURRENT SYSTEM''DATE')
     A            XHRVFL    R               REFFLD(FLAG)
     A                                      COLHDG('REVISED FLAG')
     A            XHSTAT    R               REFFLD(STAT)
     A            XHUSER    R               REFFLD(USER)
     A            XHPGM     R               REFFLD(PGM)
     A            XHTIME    R               REFFLD(TIME)
     A            XHDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            XHCNC#         3  0       COLHDG('CANCELLATION' 'COUNT')
     A            XHERR     R               REFFLD(FLAG)
     A                                      COLHDG('CANCELLATION' 'IN ERROR')
     A            XHENFL    R               REFFLD(FLAG)
     A                                      COLHDG('ENDORSEMENT' 'FLAG')
     A*** BEGIN ADD *** 06/21/12 **************************************
     A            XHRECD    R               REFFLD(CODE)
     A                                      COLHDG('REINSTATEMENT' +
     A                                      'REASON CODE')
     A*** END   ADD *** 06/21/12 **************************************
