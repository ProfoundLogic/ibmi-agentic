     A          R CV2000R                   TEXT('Conversion Control Master')
     A            CVAPP         10A         TEXT('Application')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Application         ')
     A            CVFIL         10A         TEXT('File Name')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'File name           ')
     A            CVFFIL        10A         TEXT('From File (blank defaults +
                                                  to &CVFIL)')
                                            COLHDG('                    ' +
                                                   'From (Old)          ' +
                                                   'File name           ')
     A            CVCLR          1A         TEXT('Clear File - Y/X=Yes, +
                                                  N/blank=No')
                                            COLHDG('                    ' +
                                                   'Clear               ' +
                                                   'File                ')
     A            CVCPY          1A         TEXT('Copy File - Y/X=Yes, +
                                                  N/blank=No')
                                            COLHDG('                    ' +
                                                   'Copy                ' +
                                                   'File                ')
     A            CVCVT          1A         TEXT('Run Conversion Program +
                                                  Y/X=Yes, N/blank=No')
                                            COLHDG('                    ' +
                                                   'Run                 ' +
                                                   'Pgm                 ')
     A            CVPGM         10A         TEXT('Conversion Program')
                                            COLHDG('                    ' +
                                                   'Conversion          ' +
                                                   'Program             ')
     A            CVPTY          1A         TEXT('Processing Priority - +
                                                  1=Highest, 9=Lowest +
                                                  (defaults to 3)')
                                            DFT('3')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Pty                 ')
     A            CVPHS          2S 0       TEXT('Phase - 00-99')       +
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Phase               ')
     A            CVAI           1A         TEXT('Active/Inactive - A/I')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'A/I                 ')
