     A                                      REF(WREFP)
     A          R PRW501                    TEXT('Audit Request +
     A                                      Claimant Work File')
     A            RW5XML        60A         COLHDG('XML File Key')
     A            RW5CO#    R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            RW5FND    R     S         REFFLD(FND)
     A                                      COLHDG('Fund')
     A            RW5EMP#   R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            RW5DIV    R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            RW5FYR    R     S         REFFLD(FYR)
     A                                      COLHDG('Fund Year')
     A            RW5CASE   R     S         REFFLD(CASE)
     A                                      COLHDG('Claim Case #')
     A            RW5CLAS   R     S         REFFLD(CLAS)
     A                                      COLHDG('Claim Class' 'Code')
     A            RW5SPEC        1A         COLHDG('Claim Spec')
     A            RW5EXT         5A         COLHDG('Claim Extension')
     A            RW5DESC       50A         COLHDG('Class Description')
     A            RW5NAME       50A         COLHDG('Claimant Name')
     A            RW5FSN    R               REFFLD(FSN)
     A                                      COLHDG('Claimant First Name')
     A            RW5MID    R               REFFLD(MID)
     A                                      COLHDG('Claimant Middle' 'Initial')
     A            RW5LSN    R               REFFLD(LSN)
     A                                      COLHDG('Claimant Last Name')
     A            RW5ACDT        8S 0       COLHDG('Claim Accident Date')
     A            RW5ADR1   R               REFFLD(ADR1)
     A                                      COLHDG('Claimant Address #1')
     A            RW5ADR2   R               REFFLD(ADR1)
     A                                      COLHDG('Claimant Address #2')
     A            RW5CTY    R               REFFLD(CTY)
     A                                      COLHDG('Claimant City')
     A            RW5ST     R               REFFLD(ST)
     A                                      COLHDG('Claimant State')
     A            RW5ZIP    R     S         REFFLD(ZIP)
     A                                      COLHDG('Claimant Zip Code')
     A            RW5CNTY       30A         COLHDG('Claimant County')
     A            RW5OADR1  R               REFFLD(ADR1)
     A                                      COLHDG('Out of Country' 'Address 1')
     A            RW5OADR2  R               REFFLD(ADR1)
     A                                      COLHDG('Out of Country' 'Address 2')
     A            RW5OCTY   R               REFFLD(CTY)
     A                                      COLHDG('Out of Country' 'City')
     A            RW5OADR3      40A         COLHDG('Out of Country' +
     A                                            'Postal Code')
     A            RW5CTRY       30A         COLHDG('Claimant Country')
     A            RW5DOB         8S 0       COLHDG('Date of Birth')
     A            RW5MSTS        1A         COLHDG('Marital Status')
     A            RW5EMAIL      60A         COLHDG('Email')
     A            RW5PH#         7S 0       COLHDG('Phone Number')
     A            RW5ARA         3S 0       COLHDG('Area Code')
     A            RW5SEX         1A         COLHDG('Gender')
     A            RW5IUSR   R               REFFLD(USER)
     A                                      COLHDG('Initial/User')
     A            RW5IPGM   R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            RW5IDT    R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            RW5ITIM   R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            RW5USER   R               REFFLD(USER)
     A                                      COLHDG('Maint. User')
     A            RW5PGM    R               REFFLD(PGM)
     A                                      COLHDG('Maint. Program')
     A            RW5DT     R     S         REFFLD(DT)
     A                                      COLHDG('Maint. Date')
     A            RW5TIME   R     S         REFFLD(TIME)
     A                                      COLHDG('Maint. Time')
