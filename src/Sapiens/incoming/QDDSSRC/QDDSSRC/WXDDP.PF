     A                                      REF(SCREFP)
     A          R PDD01                     TEXT('DARTS DIARY WORK FILE')
     A            DDKEY     R               REFFLD(DS40)
     A                                      COLHDG('DARTS' 'KEY')
     A            DDSS#     R               REFFLD(SS#)
     A            DDLSN     R               REFFLD(LSN)
     A            DDFSN     R               REFFLD(FSN)
     A            DDMID     R               REFFLD(MID)
     A            DDCNAM    R               REFFLD(NM30)
     A                                      COLHDG('CLAIMANT' 'NAME')
     A            DDACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE')
     A            DDCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'CODE')
     A*** BEGIN ADD *** 04/27/92 8*************************************
     A            DDRMCD    R               REFFLD(RMCD *LIBL/SCREFP)
     A                                      COLHDG('REMARK ' 'CODE')
     A*** END ADD *** 04/27/92 ****************************************
     A            DD#KY         79A         TEXT('BUILT KEY')
     A            DDCOMM       275A         TEXT('COMMENT')
     A            DDCDAT    R               REFFLD(DT)
     A                                      COLHDG('COMMENT' 'DATE')
     A            DDSTAT    R               REFFLD(STAT)
     A            DDUSER    R               REFFLD(USER)
     A            DDDCDT    R               REFFLD(DT)
     A                                      COLHDG('DIARY' 'COMPLETION' +
                                                   'DATE')
     A            DDSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
