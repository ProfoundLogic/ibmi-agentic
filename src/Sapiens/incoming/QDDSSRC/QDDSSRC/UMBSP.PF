     A** Utilization Review INTERQUAL BODY SYSTEM FILE
     A                                      REF(FSREFP)
     A          R PBS01                     TEXT('INTERQUAL BODY SYSTEM FILE')
     A            BSUNTF    R               REFFLD(FLAG) COLHDG('UNIT OR BODY +
     A                                      SYSTEM' '1=UNIT,/" "=BDY SYS')
     A            BSBDSY    R               REFFLD(DS3) COLHDG('BODY SYSTEM' +
     A                                      'CODE')
     A            BSDESC    R               REFFLD(DS50) COLHDG('BODY SYSTEM' +
     A                                      'DESCRIPTION')
     A            BSSTAT    R               REFFLD(STAT)
     A            BSUSER    R               REFFLD(USER)
     A            BSPGM     R               REFFLD(PGM)
     A            BSTIME    R               REFFLD(TIME)
     A            BSDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            BSIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            BSIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
