     A            SPFRDT         8A         TEXT('File Transmission From Dt')
     A                                      COLHDG('FROM' 'DT')
     A            SPTODT         8A         TEXT('File Transmission To Dt')
     A                                      COLHDG('TO' 'DT')
     A            SPSEX          1A         TEXT('Gender')
     A                                      COLHDG('Genter')
     A            SPDTOB         8A         TEXT('Date of Birth')
     A                                      COLHDG('Date' 'of Birth')
