     A                                      COLHDG('Last name')
     A            SPFSN         15A         TEXT('Claimant First Name')
     A                                      COLHDG('First name')
     A            SPSS#          9A         TEXT('Claimant SS#')
     A                                      COLHDG('Social Sec#')
     A            SPACDT         8A         TEXT('Accident Date')
     A                                      COLHDG('Accident dt')
     A            SPADR1        35A         TEXT('Claimant Address')
     A                                      COLHDG('Address')
     A            SPCTY         30A         TEXT('Claimant City')
     A                                      COLHDG('City')
     A            SPST           2A         TEXT('Claimant State')
     A                                      COLHDG('ST')
     A            SPZIP          9A         TEXT('Claimant Zip')
     A                                      COLHDG('Zip code')
     A            SPLTFL         1A         TEXT('Lost Time')
     A                                      COLHDG('LT' 'flag')
     A            SPSTS          1A         TEXT('Claim Status')
     A                                      COLHDG('Status')
     A            SPCLDT         8A         TEXT('Claim Closed Date')
     A                                      COLHDG('Date closed')
     A            SPDNY          1A         TEXT('Denied claim')
     A                                      COLHDG('Deny' 'flag')
     A            SPDEDT         8A         TEXT('Date of death')
     A                                      COLHDG('Dt of Death')
     A            SPCLAD         3A         TEXT('Adjuster')
     A                                      COLHDG('Adjuster')
     A            SPJRST         2A         TEXT('Jurisdiction state')
