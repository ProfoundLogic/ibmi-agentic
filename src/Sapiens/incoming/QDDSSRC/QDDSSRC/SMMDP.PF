     A**  MULTI-DOC (OBJECT) FILE
     A*
     A*                                                               *
     A*  01/05/05 C:02  Project: DR189                                *
     A*                 ADDED IFS FLAG AND UNC PATH FOR THIS FILE     *
     A*
     A                                      REF(SCREFP)
     A          R PMD01                     TEXT('MULTI-OBJECT FILE')
     A*
     A*
     A            MDKEY     R               REFFLD(KEY)
     A            MDSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            MDOID         40          COLHDG('OBJECT ID')
     A*
     A            MDOFLR        60          COLHDG('OBJECT FOLDER')
     A            MDOTYP    R               REFFLD(FLAG)
     A                                      COLHDG('OBJECT TYPE' +
     A                                      'F, I, O...')
     A            MDODSC    R               REFFLD(DS40)
     A                                      COLHDG('OBJ DESC.')
     A            MDDOCT         8          COLHDG('DOCUMENT TYPE')
     A            MDTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION DATE')
     A            MDTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANSACTION TIME')
     A            MDSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            MDCSID    R               REFFLD(CSID)
     A            MDCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            MDPNAM    R               REFFLD(PGM)
     A                                      TEXT('WROTE IT')
     A            MDSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            MDSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A            MDRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('REMARK' 'CODE')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            MDIUSR    R               REFFLD(USER)
     A                                      TEXT('INIT USER')
     A            MDIPGM    R               REFFLD(PGM)
     A                                      TEXT('INIT PGM')
     A            MDITIM    R               REFFLD(TIME)
     A                                      TEXT('INIT TIME')
     A            MDIDT     R               REFFLD(DT)
     A                                      TEXT('INIT DATE')
     A            MDLUSR    R               REFFLD(USER)
     A                                      TEXT('USER LAST MAINT')
     A            MDLPGM    R               REFFLD(PGM)
     A                                      TEXT('LAST MAINT PGM')
     A            MDLTIM    R               REFFLD(TIME)
     A                                      TEXT('LAST MAINT TIME')
     A            MDLDT     R               REFFLD(DT)
     A                                      TEXT('LAST MAINT DATE')
     A*
     A            MDFL01    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 01 **')
     A            MDFL02    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 02 **')
     A            MDFL03    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 03 **')
     A            MDFL04    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 04 **')
     A            MDFL05    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 05 **')
     A            MDCHR5         5A         TEXT('**FUTURE USE A5  01 **')
     A*
     A            MDSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A*
     A**** 01/05/05 **** ADD **************************************************
     A            MDUNCF    R               REFFLD(FLAG)
     A                                      TEXT('UNC FLAG <> BLANK IS IFS USE')
     A            MDUNCP    R               REFFLD(UNCP)
     A                                      TEXT('UNC PATH FOR IFS')
     A**** 01/05/05 **** END ADD **********************************************
