     A*  DESCRIPTION: THIS FILE HOLDS THE SCRIPTURA DOCUMENTS SETUP   *
     A*               FOR POLICY PAGES.                               *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 03/27/23 C:65  Project: 153WAB                                *
     A*                ADD FIELD FOR LIST DEC PAGE ON FORMS SCHEDULE. *
     A*                                                               *
     A* 09/16/21 C:65  Project: 148WDC                                *
     A*                ADD FIELD FOR NATIONAL/STATE FORM.             *
     A*                                                               *
     A* 12/11/17 C:65  Project: 148WAN                                *
     A*                ADD FIELDS FOR ORIGINATING TRANSACTIONS.       *
     A*                                                               *
     A* 10/28/17 C:062 Project: 148WAN                                *
     A*                Add the following fields:                      *
     A*                List schedules on schedule of endorsement forms*
     A*                Client template form                           *
     A*                Edition date                                   *
     A*                SCHEDULE DESCRIPTION                           *
     A*                                                               *
     A* 10/24/17 C:136 Project: 150WBW                                *
     A*                Add endorsement signature fields               *
     A*                                                               *
     A* 08/17/17 C:291 PROJECT: 150WAO                                *
     A*                ADD FIELD ALWAYS PRODUCE SCHEDULE OF ENDORSEMNT*
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PPP01                     TEXT('SCRIPTURA POL PG DOC FILE')
     A            PPFND     R     S         REFFLD(FND)
     A            PPST      R               REFFLD(ST)
     A            PPTYPE    R               REFFLD(FLAG)
     A            PPSTYPE   R               REFFLD(FLAG)
     A                                      COLHDG('SCHEDULE TYPE')
     A            PPEFDT    R     S         REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A*
     A            PPPOLDOC      60A         COLHDG('DEF POLICY PG' 'TEMPLATE')
     A            PPPOLPTH     250A         COLHDG('DEF POLICY PG' 'PATH')
     A            PPLANGD       40A         COLHDG('DEFAULT DOC LANGUAGE')
     A            PPPOLDOCC     60A         COLHDG('CLIENT POL PG' 'TEMPLATE')
     A            PPPOLPTHC    250A         COLHDG('CLIENT POL PG' 'PATH')
     A            PPLANGC       40A         COLHDG('CLIENT DOC LANGUAGE')
     A*
     A            PPUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            PPPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            PPTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            PPDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            PPIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            PPIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            PPITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            PPIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A*** BEGIN ADD ***  08/17/17  *********************************************
     A            PPPSEN         1A         COLHDG('PRODUCE SCHEDULE' +
     A                                             'OF ENDORSEMENTS')
     A*** END ADD *****  08/17/17  *********************************************
     A*** Beg Add ***** 10/24/17 ***********************************************
     A            PPENDFRM      15A         COLHDG('End Form Name')
     A            PP1STSIG      60A         COLHDG('Primary Signature')
     A            PP1STSPTH    250A         COLHDG('Primary Signature' 'Path')
     A            PP2NDSIG      60A         COLHDG('Secondary Signature')
     A            PP2NDSPTH    250A         COLHDG('Secondary Signature' 'Path')
     A*** End Add ***** 10/24/17 ***********************************************
     A*** Beg Add ***** 10/30/17 ***********************************************
     A            PPLSTSCHD      1A         COLHDG('List Schedules')
     A            PPCLTFRM#     15A         COLHDG('Client Template' +
     A                                      'Form #')
     A            PPEDITDT       7S 0       COLHDG('Edition Date')
     A            PPDESC       100A         COLHDG('FORM DESCRIPTION')
     A*** End Add ***** 10/30/17 ***********************************************
     A*** BEGIN ADD ***  12/11/17  *********************************************
     A            PPPOLDOCO     60A         COLHDG('ORIG POL PG' 'TEMPLATE')
     A            PPPOLPTHO    250A         COLHDG('ORIG POL PG' 'PATH')
     A            PPLANGO       40A         COLHDG('ORIG DOC LANGUAGE')
     A            PPORGFRM#     15A         COLHDG('ORIG Template' +
     A                                      'Form #')
     A            PPEDITDTO      7S 0       COLHDG('ORIG Edition Date')
     A            PPORGDESC    100A         COLHDG('ORIG FORM DESC')
     A*** END ADD *****  12/11/17  *********************************************
     A*** BEGIN ADD ***  09/16/21  *********************************************
     A            PPNATFM   R               REFFLD(DS15)
     A                                      COLHDG('National/State' +
     A                                      'Form #')
     A*** END ADD *****  09/16/21  *********************************************
     A*** BEGIN ADD ***  03/27/23  *********************************************
     A            PPLSTDEC       1A         COLHDG('List Dec Page')
     A*** END ADD *****  03/27/23  *********************************************
