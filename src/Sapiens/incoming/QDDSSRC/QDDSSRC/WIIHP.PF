     A                                      REF(WREFP)
     A          R PIH01                     TEXT('Submit Invoice Info Workfile')
     A            IHCO#          3S 0       COLHDG('Company #')
     A            IHFND          3S 0       COLHDG('Group #')
     A            IHEMP#         9S 0       COLHDG('Employer #')
     A            IHDIV          5S 0       COLHDG('Division')
     A            IHFYR          3S 0       COLHDG('Year')
     A            IHTYPE         1A         COLHDG('Type of Invoice')
     A            IHINV#         9S 0       COLHDG('Invoice #')
     A            IHPODT         7S 0       COLHDG('Posting Date')
     A            IHAMT         13S 2       COLHDG('Invoice Amount')
     A            IHUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            IHPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            IHTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            IHDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            IHIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            IHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            IHITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            IHIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A
     A          K IHCO#
     A          K IHFND
     A          K IHEMP#
     A          K IHDIV
     A          K IHFYR
     A          K IHTYPE
     A          K IHPODT
