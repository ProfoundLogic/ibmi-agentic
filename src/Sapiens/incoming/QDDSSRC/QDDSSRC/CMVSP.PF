     A                                      COLHDG('ADDITIONAL' 'INTEREST #5 ')
     A            VSADI6    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #6 ')
     A            VSADI7    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #7 ')
     A            VSADI8    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #8 ')
     A            VSADI9    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #9 ')
