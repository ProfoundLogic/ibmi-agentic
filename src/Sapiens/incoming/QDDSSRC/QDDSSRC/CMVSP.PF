     A            VSVIN     R               REFFLD(VIN)
     A            VSAMNW    R               REFFLD(A60)
     A                                      COLHDG('VEH AMOUNT NEW')
     A            VSAMST    R               REFFLD(A60)
     A                                      COLHDG('VEH AMOUNT STATED')
     A            VSEXP     R               REFFLD(EXP)
     A            VSTERA    R               REFFLD(TERA)
     A            VSCTY     R               REFFLD(CTY)
     A                                      COLHDG('GARAGED CITY')
     A            VSCNTY    R               REFFLD(CNTY)
     A                                      COLHDG('GARAGED COUNTY')
     A            VSST      R               REFFLD(ST)
     A                                      COLHDG('GARAGED STATE')
     A            VSADI1    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #1 ')
     A            VSADI2    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #2 ')
     A            VSADI3    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #3 ')
     A            VSADI4    R               REFFLD(CDE)
     A                                      COLHDG('ADDITIONAL' 'INTEREST #4 ')
