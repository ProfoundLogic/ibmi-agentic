     A                                      REF(FSREFP)
     A          R PMU01                     TEXT('Mutuallu Exclusive Proc File')
     A            MUCOD1    R               REFFLD(DS5)
     A                                      COLHDG('Mutually exclusive' +
     A                                      'code 1')
     A            MUCOD2    R               REFFLD(DS5)
     A                                      COLHDG('Mutually exclusive' +
     A                                      'code 2')
     A            MUEFDT    R               REFFLD(DT)
     A                                      COLHDG('Effective Date')
     A            MUDLDT    R               REFFLD(DT)
     A                                      COLHDG('Deletion Date')
     A            MUDESC       100A
     A                                      COLHDG('Standard Policy' +
     A                                      'Statement' +
     A                                      'Description')
     A            MUPRCI    R               REFFLD(FLAG)
     A                                      COLHDG('Prior rebundled' +
     A                                      'code Indicator')
     A            MUGBMI    R               REFFLD(FLAG)
     A                                      COLHDG('Global Modifier' +
     A                                      'Indicator')
     A            MUSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            MUUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            MUPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Pgm')
     A            MUTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A            MUDT      R               REFFLD(DT)
     A                                      COLHDG('Maint Date')
     A            MUIUSR    R               REFFLD(USER)
     A                                      COLHDG('Init User')
     A            MUIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Init Pgm')
     A            MUITIM    R               REFFLD(TIME)
     A                                      COLHDG('Init Time')
     A            MUIDT     R               REFFLD(DT)
     A                                      COLHDG('Init Date')
