     A**                                                              *
     A** WCSTAT Record Format File - WCSTAT01                         *
     A** RECORD TYPE 01 - Header Record
     H*****************************************************************
     H*  Revisions:                                                   *
     H*                                                               *
     H* 11/23/10  C:190 Project: 139WPQ                               *
     H*                                                               *
     H*****************************************************************
     A          R PST01                     TEXT('Header Record')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1S 0       COLHDG('Record type code')
     A            STPOCN        12S 0       COLHDG('Policy Cond code')
     A            STFUT1         1A         COLHDG('Future use')
     A            STEXDT         6S 0       COLHDG('Policy exp. date')
     A            STRSID         9A         COLHDG('Risk ID number')
     A            STFUT2         1A         COLHDG('Future use')
     A            STOAID        10A         COLHDG('Original admin'+
                                            'ID')
     A            STTRCD         1S 0       COLHDG('Term code')
     A            STELCD         1A         COLHDG('Employee leasing' +
                                            'code')
     A            STPTCD         2S 0       COLHDG('Policy type' +
                                            'code')
     A            STFUT3        20A         COLHDG('Future use')
     A            STRRCD         1A         COLHDG('Replacement report' +
                                            'code')
     A            STFUT4        16A         COLHDG('Future use')
     A            STCTCD         1A         COLHDG('Correction type' +
                                            'code')
     A            STEFDT         6S 0       COLHDG('State effective' +
                                            'date')
     A            STFEIN         9S 0       COLHDG('FEIN')
     A            STFUT5         8A         COLHDG('Future use')
     A            STPOCO         7A         COLHDG('Policy conditions' +
                                            'indicator')
     A            STFUT6         4A         COLHDG('Future use')
     A            STPTID         6S 0       COLHDG('Policy type' +
                                            'ID codes')
     A            STFUT7         2A         COLHDG('Future use')
     A            STDTCD         4S 0       COLHDG('Deductible type' +
                                            'codes')
     A            STDPFR         2S 0       COLHDG('Deductible % factor')
     A            STDAPC         9S 0       COLHDG('Deductible amount' +
                                            'per claim/accident')
     A            STDAAG         9S 0       COLHDG('Deductible amount' +
                                            'aggregate')
     A            STPRLV         2S 0       COLHDG('Previous report' +
                                            'level')
     A            STFUT8         1A         COLHDG('Future use')
     A            STPCSN         1A         COLHDG('Previous correction' +
                                            'sequence number')
     A            STPCCD         5S 0       COLHDG('Previous carrier' +
                                            'code')
     A            STPPON        18A         COLHDG('Previous policy' +
                                            'number')
     A            STPPEF         6S 0       COLHDG('Previous policy' +
                                            'effective date')
     A            STPESC         2S 0       COLHDG('Previous exposure' +
                                            'state code')
     A            STPUID         7A         COLHDG('Previous unit/cert' +
                                            'number ID')
     A            STFUT9        12A         COLHDG('Future use')
     A            STFU10         6A         COLHDG('Future use')
     A            STFU11         1A         COLHDG('Future use')
     A            STAUSC         1A         COLHDG('ASWG unit' +
                                            'submission code')
