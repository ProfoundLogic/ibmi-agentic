     A                                      COLHDG('BATCH' 'TYPE' 'FLAG')
     A***  END ADD ***** 07/15/05 *****************************************
     A***  BEG ADD ***** 12/26/07 *****************************************
     A            RTCUST        20A         COLHDG('CUSTOMER ID')
     A            RTSDFL    R               REFFLD(FLAG)
     A                                      COLHDG('SURPLUS' 'DIST FLAG')
