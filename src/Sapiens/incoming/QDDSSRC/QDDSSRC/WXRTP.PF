     A                                      REF(WREFP)
     A          R PRT01                     TEXT('RTN PRM BCH DTL FILE')
     A            RTCO#     R               REFFLD(CO#)
     A            RTBAT#         9P 0       TEXT('BATCH NUMBER')
     A            RTFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            RTEMP#    R               REFFLD(EMP#)
     A            RTDIV     R               REFFLD(DIV)
     A            RTEMPN    R               REFFLD(NAME)
     A            RTAGT#    R               REFFLD(AGT#)
     A            RTAGTN    R               REFFLD(NAME)
     A            RTFEIN    R               REFFLD(EMP#)
     A            RTMOD     R               REFFLD(MOD)
     A            RTFYR     R               REFFLD(FYR)
     A            RTCOM1        60A         TEXT('COMMENT LINE 1')
     A            RTCOM2        60A         TEXT('COMMENT LINE 2')
     A            RTCOM3        60A         TEXT('COMMENT LINE 3')
     A            RTAMT     R               REFFLD(A112)
     A                                      COLHDG('RETURN AMT')
     A            RTSELC    R               REFFLD(FLAG)
     A                                      COLHDG('SELECTED')
     A            RTACFL    R               REFFLD(FLAG)
     A                                      COLHDG('ACCOUNT CURRENT FLAG')
     A            RTPTFL    R               REFFLD(FLAG)
     A                                      COLHDG('PAID TO')
     A            RTPFIN         5A
     A                                      COLHDG('PREM FINANCE CO.')
     A            RTCAFL    R               REFFLD(FLAG)
     A                                      COLHDG('CTST AUDIT FLAG')
     A            RTIUSR    R               REFFLD(USER)
     A                                      COLHDG('INT ENTRY USERD')
     A            RTIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INT ENTRY PGM')
     A            RTIDT     R               REFFLD(DT)
     A                                      COLHDG('INT ENTRY DATE')
     A            RTITIM    R               REFFLD(TIME)
     A                                      COLHDG('INT ENTRY TIME')
     A            RTUSER    R               REFFLD(USER)
     A                                      COLHDG('LAST UPD BY USER')
     A            RTPGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST UPD BY PGMR')
     A            RTDATE    R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            RTTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A***  Begin Add  ***  11/04/04  **************************************
     A            RTARCD    R               REFFLD(CODE)
     A                                      COLHDG('A/R' 'CODE')
     A***  End   Add  ***  11/04/04  **************************************
