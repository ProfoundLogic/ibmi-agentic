     A***************************************************************
     A                                      REF(CSREFP)
     A          R PCS01                     TEXT('EMPLOYEE DETAIL WORK RECORD')
     A            CSFRST    R               REFFLD(NM7)
     A                                      COLHDG('EMPLOYEE' ' FIRST' 'NAME')
     A            CSMI      R               REFFLD(NM1)
     A                                      COLHDG('EMPLOYEE' 'MIDDLE' 'INTIAL')
     A            CSLAST    R               REFFLD(NM10)
     A                                      COLHDG('EMPLOYEE' 'LAST' 'NAME')
     A            CSSS#     R               REFFLD(SS#)
     A                                      COLHDG('SOC' 'SEC#')
     A            CSACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE' 'MMDDYY')
     A            CSEMNM    R               REFFLD(NM35)
     A                                      COLHDG('EMPLOYER' 'NAME')
     A            CSEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER' 'NUMBER')
     A            CSDIV     R               REFFLD(DIV)
     A                                      COLHDG('EMP' 'SUFFIX')
     A            CSCARR    R               REFFLD(CARR)
     A                                      COLHDG('CARRIER' 'NUMBER')
     A            CSBTDT    R               REFFLD(DT)
     A                                      COLHDG('BATCH' 'DATE' 'YYMMDD')
     A            CSITYP    R               REFFLD(ITYP)
     A********* BEGIN CHG ********* 11/11/97 **************************
     A*********                             COLHDG('INJURY' 'TYPE')
     A                                      COLHDG('NO LONGER USED')
     A            CSSBBT    R               REFFLD(SBBT)
     A*********                             COLHDG('SUB' 'BATCH')
     A                                      COLHDG('NO LONGER USED')
     A********* END   CHG ********* 11/11/97 **************************
     A            CSSIC     R               REFFLD(SIC)
     A                                      COLHDG('SIC' 'IND #')
     A            CSAREA    R               REFFLD(AREA)
     A                                      COLHDG('AREA')
     A            CSDLCD    R               REFFLD(DLCD)
     A********* BEGIN CHG ********* 11/11/97 **************************
     A*********                             COLHDG('DELETE' 'CODE')
     A                                      COLHDG('NO LONGER USED')
     A            CSDLST    R               REFFLD(DLST)
     A*********                             COLHDG('DAYS' 'LOST')
     A                                      COLHDG('NO LONGER USED')
     A********* END   CHG ********* 11/11/97 **************************
     A            CSDTYP    R               REFFLD(DTYP)
     A                                      COLHDG('DISABILITY' 'TYPE')
     A            CSRRN3    R               REFFLD(RRN)
     A                                      COLHDG('RRN OF' 'CS010F/SCR03')
     A            CSXREF    R               REFFLD(XREF)
     A                                      COLHDG('SUMMARY' 'XREF#')
     A                                      TEXT('SUMMARY XREF#, SEE CWCLP')
     A********* BEGIN ADD ********* 11/11/97 **************************
     A            CSDEDT    R               REFFLD(DT)
     A                                      COLHDG('DEATH DATE')
     A            CSPART    R               REFFLD(CODE)
     A                                      COLHDG('PART OF BODY')
     A********* END   ADD ********* 11/11/97 **************************
     A*
     A          K CSSS#
     A          K CSACDT
