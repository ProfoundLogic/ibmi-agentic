     A*
     A                                      REF(WREFP)
     A**
     A          R PR301                     TEXT('R22 Reduced Earnings')
     A            R3CO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            R3FND     R               REFFLD(FND)
     A                                      COLHDG('FUND' 'NUMBER')
     A            R3FYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY' 'YEAR')
     A            R3CASE    R               REFFLD(CASE)
     A                                      COLHDG('CLAIM' 'NUMBER')
     A            R3REWK         2S 0
     A                                      COLHDG('REDUCED EARNINGS' -
     A                                      'WEEK NUMBER')
     A            R3ARE          9S 2       COLHDG('ACTUAL REDUCED' -
     A                                      'EARNINGS')
     A            R3DRE          9S 2       COLHDG('DEEMED REDUCED' -
     A                                      'EARNINGS')
     A*** Begin Add *** 05/30/18 ***********************************
     A            R3RESD    R               REFFLD(DT8)
     A                                      TEXT('Rdcd Earnings Week Strt Date')
     A                                      COLHDG('Reduced Earnings' +
     A                                             'Week Start Date')
     A            R3REED    R               REFFLD(DT8)
     A                                      TEXT('Rdcd Earnings Week End Date')
     A                                      COLHDG('Reduced Earnings' +
     A                                             'Week End Date')
     A            R3REWA         9S 2       COLHDG('Red Earn Net Weekly' +
     A                                             'Amt Due by Clm Admin')
     A*** End   Add *** 05/30/18 ***********************************
