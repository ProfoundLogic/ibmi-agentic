     A                                      DSPSIZ(24 80 *DS3)
     A                                      REF(*LIBL/CREFP)
     A                                      CF03
     A*
     A          R C0999F1
     A                                  2 24'Progressive Data Solutions, Inc.'
     A                                      DSPATR(HI)
     A                                  3 26'Sample SQL Sub-File Display'
     A                                      DSPATR(UL)
     A                                  2 70DATE
     A                                      EDTCDE(Y)
     A                                  3 70TIME
     A                                  2  1'C0999F'
     A                                  3  1'C0999F1'
     A                                  5  2'CO#   USER         USER NAME      -
     A                                                                         -
     A                                         CODE'
     A                                      DSPATR(HI)
     A*
     A          R C0999S1                   SFL
     A            SCUSR     R        O  6  8REFFLD(PUP01/UPUSR CMUPP)
     A            SCCO#     R        O  6  2REFFLD(PUP01/UPCO# CMUPP)
     A            SCUSNM    R        O  6 21REFFLD(PUP01/UPUSNM CMUPP)
     A            SCSTAF    R        O  6 74REFFLD(PUP01/UPSTAF CMUPP)
     A*
     A          R C0999C1                   SFLCTL(C0999S1)
     A                                      OVERLAY
     A N99                                  SFLDSP
     A N99                                  SFLDSPCTL
     A  99                                  SFLCLR
     A N99                                  SFLEND(*MORE)
     A                                      SFLSIZ(0016)
     A                                      SFLPAG(0015)
     A            RRN01          4S 0H
     A*
     A          R C0999B1
     A                                      OVERLAY
     A                                 24  1'F3=Exit'
     A                                      COLOR(BLU)
