     A                                      REF(FSREFP)
     A          R PAP01                     TEXT('OPPS HOSPITAL APC +
     A                                      FILE')
     A            APHCPC    R
     A                                      REFFLD(DS5)
     A                                      COLHDG('HCPCS Code')
     A            APEFDT    R               REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE DATE')
     A            APDESC       100
     A                                      COLHDG('Description')
     A            APCI      R
     A                                      REFFLD(DS2)
     A                                      COLHDG('CI')
     A            APSI      R
     A                                      REFFLD(FLAG)
     A                                      COLHDG('Status Indiactor')
     A            APAPC     R
     A                                      REFFLD(DS6)
     A                                      COLHDG('Ambulatory' +
     A                                      ' Payment' +
     A                                      ' Classification')
     A            APREL          8  4
     A                                      COLHDG('Relative Wt.')
     A            APALOW    R
     A                                      REFFLD(A92)
     A                                      COLHDG('Allowable' +
     A                                      'Payment Rate')
     A            APSTAT    R
     A                                      REFFLD(STAT)
     A                                      COLHDG('Status')
     A            APIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            APIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            APIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
     A            APITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            APUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            APPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM' 'MAINTAINED')
     A            APDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            APTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A****** Beg Add *** 05/30/16 **********************************************
     A            APCSI     R
