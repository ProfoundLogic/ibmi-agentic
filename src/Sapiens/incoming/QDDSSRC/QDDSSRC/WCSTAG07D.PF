     A          R PST7D                     TEXT('ICR 7-D RECORD')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STIIAT        10S 0       COLHDG('Indemnity incurred' +
     A                                      'amount total')
     A            STMIAT        10S 0       COLHDG('Medical incurred' +
     A                                      'amount total')
     A            STPIVD        10S 0       COLHDG('Paid indemnity' +
     A                                      'to valuation date')
     A            STPMVD        10S 0       COLHDG('Paid medical' +
     A                                      'to valuation date')
     A            STSSOA         9S 0       COLHDG('Social security' +
     A                                      'offset amount')
     A            STPIAM        10S 0       COLHDG('Pension indemnity' +
     A                                      'amount')
     A            STFUT1       137A         COLHDG('Future use')
     A            STGRP#         3S 0       COLHDG('Group #')
     A            STFYR          3S 0       COLHDG('Policy year')
     A            STEMP#         9S 0       COLHDG('Employer #')
