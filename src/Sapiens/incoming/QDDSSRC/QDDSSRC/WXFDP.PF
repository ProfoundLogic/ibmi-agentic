      * WXFDP - WORK FILE - FEE INVOICE DETAIL                       *
      *****************************************************************
      *****
      *****  NOTE: Files (WXFDP, WFFDP2, WMFHP) MUST be of the same
      *****        format.  Change made to any must be made to all.
      *****
      *****************************************************************
      * REVISIONS:                                                    *
      *                                                               *
      * 02/15/11 C:061 WC1851                                         *
      *          C:33  Created                                        *
      *                                                               *
      *****************************************************************
     A                                      REF(WREFP)
     A          R PFD01                     TEXT('FEE INVOICE DETAIL OUTFILE')
     A            FDCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            FDFND     R               REFFLD(FND)
     A                                      COLHDG('FUND NUMBER')
     A            FDFNAM    R               REFFLD(NAME)
     A                                      COLHDG('FUND NAME')
     A            FDENAM    R               REFFLD(NAME)
     A                                      COLHDG('EMPLOYER NAME' +
     A                                      'LINE 1')
     A            FDENM2        60A
     A                                      COLHDG('EMPLOYER NAME' +
     A                                      'LINE 2')
     A            FDEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER NUMBER')
     A            FDDIV     R               REFFLD(DIV)
     A                                      COLHDG('DIVISION')
      *
     A            FDASTS    R               REFFLD(FLAG)
     A                                      COLHDG('ACTIVITY STATUS')
      *                      N=NEW; C=CHANGED
      *
     A            FDFYR     R               REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            FDTYPE    R               REFFLD(KEY)
     A                                      COLHDG('FEE TYPE')
     A                                      TEXT('FEE TYPE')
     A            FDDESC    R               REFFLD(DS30)
     A                                      COLHDG('FEE TYPE DESCRIPTION')
     A                                      TEXT('FEE TYPE DESCRIPTION')
     A            FDBT      R               REFFLD(FLAG)
     A                                      COLHDG('BILL TYPE')
     A                                      TEXT('BILL TYPE')
     A            FDCAP#        25A
     A                                      COLHDG('CARRIER POLICY' +
     A                                      'NUMBER')
     A            FDCASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE')
     A            FDCNAM    R               REFFLD(NAME)
     A                                      COLHDG('CLAIMANT NAME')
     A            FDSS#     R               REFFLD(SS#)
     A                                      COLHDG('SOCIAL SECURITY #')
     A            FDOCCD        10
     A                                      COLHDG('OCCUPATION CODE')
     A            FDOCDS    R               REFFLD(DS30)
     A                                      COLHDG('OCCUPATION CODE' +
     A                                      'DESCRIPTION')
     A            FDACDT    R               REFFLD(DT8)
     A                                      COLHDG('ACCIDENT DATE')
     A            FDDTRP    R               REFFLD(DT8)
     A                                      COLHDG('REPORT DATE')
     A            FDSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('CLAIM STATUS')
     A            FDCINC    R               REFFLD(A112)
     A                                      COLHDG('COMP INCURRED')
     A            FDCPD     R               REFFLD(A112)
     A                                      COLHDG('COMP PAID')
     A            FDMINC    R               REFFLD(A112)
     A                                      COLHDG('MED INCURRED')
     A            FDMPD     R               REFFLD(A112)
     A                                      COLHDG('MED PAID')
     A            FDEINC    R               REFFLD(A112)
     A                                      COLHDG('EXPENSE INCURRED')
     A            FDEPD     R               REFFLD(A112)
     A                                      COLHDG('EXPENSE PAID')
     A            FDTINC    R               REFFLD(A112)
     A                                      COLHDG('TOTAL INCURRED')
     A            FDTPD     R               REFFLD(A112)
     A                                      COLHDG('TOTAL PAID')
     A            FDCLEX    R               REFFLD(STAF)
     A                                      COLHDG('ADJUSTOR CODE')
     A            FDAJNM    R               REFFLD(NAME)
     A                                      COLHDG('ADJUSTOR NAME')
     A            FDSUPV    R               REFFLD(STAF)
     A                                      COLHDG('SUPERVISOR CODE')
     A            FDSVNM    R               REFFLD(NAME)
     A                                      COLHDG('SUPERVISOR NAME')
     A            FDMNGR    R               REFFLD(STAF)
     A                                      COLHDG('MANAGER CODE')
     A            FDMNNM    R               REFFLD(NAME)
     A                                      COLHDG('MANAGER NAME')
     A            FDUWTR    R               REFFLD(STAF)
     A                                      COLHDG('UNDERWRITER CODE')
     A            FDUWNM    R               REFFLD(NAME)
     A                                      COLHDG('UNDERWRITER NAME')
     A            FDAGT#    R               REFFLD(AGT#)
     A                                      COLHDG('AGENT NUMBER')
     A            FDAGNM        60A
     A                                      COLHDG('AGENT NAME')
     A            FDPROD    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER NUMBER')
     A            FDPRNM        60A
     A                                      COLHDG('PRODUCER NAME')
     A*
     A            FDPRPR    R               REFFLD(A112)
     A                                      COLHDG('PRIOR' 'PREMIUM')
     A                                      TEXT('PRIOR PREMIUM')
     A            FDPRPY    R               REFFLD(A112)
     A                                      COLHDG('PRIOR' 'PAYROLL')
     A                                      TEXT('PRIOR PAYROLL')
     A            FDPRBL    R               REFFLD(A112)
     A                                      COLHDG('PRIOR' 'BILLED')
     A                                      TEXT('PRIOR BILLED')
     A            FDPRTY    R               REFFLD(FLAG)
     A                                      COLHDG('PRIOR' 'LOST TIME FLAG')
     A            FDPRDT    R               REFFLD(DT8)
     A                                      COLHDG('PRIOR DATE')
     A            FDCUPR    R               REFFLD(A112)
     A                                      COLHDG('CURRENT' 'PREMIUM')
     A                                      TEXT('CURRENT PREMIUM')
     A            FDCUPY    R               REFFLD(A112)
     A                                      COLHDG('CURRENT' 'PAYROLL')
     A                                      TEXT('CURRENT PAYROLL')
     A            FDCUBL    R               REFFLD(A112)
     A                                      COLHDG('CURRENT' 'BILLED')
     A                                      TEXT('CURRENT BILLED')
     A            FDCUTY    R               REFFLD(FLAG)
     A                                      COLHDG('CURRENT' 'LOST TIME FLAG')
     A            FDCUDT    R               REFFLD(DT8)
     A                                      COLHDG('CURRENT DATE')
     A            FDMINF        15
     A                                      COLHDG('MINIMUM FEE')
     A                                      TEXT('MINIMUM FEE')
     A            FDCPCT    R               REFFLD(PC52)
     A                                      COLHDG('PERCENTAGE')
     A                                      TEXT('PERCENTAGE')
     A            FDASOF    R               REFFLD(DT8)
     A                                      COLHDG('AS OF DATE')
     A                                      TEXT('AS OF DATE')
     A            FDIVDT    R               REFFLD(DT8)
     A                                      COLHDG('INVOICE DATE')
     A                                      TEXT('INVOICE DATE')
      *
     A            FDPGM     R               REFFLD(PGM)
     A            FDUSER    R               REFFLD(USER)
     A            FDDT      R               REFFLD(DT8)
     A            FDTIME    R               REFFLD(TIME)
