     A*
     A* Corvel Payment File - Provider Information
     A*
     A*****************************************************************
     A* Created on 08/30/2002 by c:62 for Project 128MAC
     A*****************************************************************
     A* Purpose: This file will house the 'provider info' record for
     A*          the associated Corvel records. It will be tied to
     A*          FAV1P via V1CNTL = V2CNTL.
     A*****************************************************************
     A* Revisions:
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PV201                     TEXT('Corvel Pmt File - Prov Info')
     A            V2TYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Record Type')
     A            V2CNTL    R               REFFLD(DS12)
     A                                      COLHDG('Control Number')
     A            V2PIDT    R               REFFLD(FLAG)
     A                                      COLHDG('Provider ID Type')
     A            V2PID#    R               REFFLD(DS10)
     A                                      COLHDG('Provider ID #')
     A            V2PIDE    R               REFFLD(DS3)
     A                                      COLHDG('Provider Extension')
     A            V2PTYP    R               REFFLD(DS3)
     A                                      COLHDG('Provider Type')
     A            V2PNAM    R               REFFLD(DS40)
     A                                      COLHDG('Provider Name')
     A            V2PAD1    R               REFFLD(DS40)
     A                                      COLHDG('Provider Address 1')
     A            V2PAD2    R               REFFLD(DS40)
     A                                      COLHDG('Provider Address 2')
     A            V2PCTY    R               REFFLD(DS25)
     A                                      COLHDG('Provider City')
     A            V2PST     R               REFFLD(CODE)
     A                                      COLHDG('Provider State')
     A            V2PZIP    R     S         REFFLD(ZIP)
     A                                      COLHDG('Provider Zip Code')
     A            V2ZIPA    R     S         REFFLD(ZIP)
     A                                      COLHDG('Provider Phys Zip')
     A            V2PPH#    R               REFFLD(DS10)
     A                                      COLHDG('Provider Phone #')
     A            V2PPID    R               REFFLD(DS10)
     A                                      COLHDG('PPO ID')
     A            V2PPNM    R               REFFLD(DS30)
     A                                      COLHDG('PPO Name')
     A            V2SS#     R               REFFLD(SS#)
     A                                      COLHDG('Patent SS#')
     A            V2CNAM    R               REFFLD(DS30)
     A                                      COLHDG('Patient Name')
     A            V2CDOB    R               REFFLD(DT8)
     A                                      COLHDG('Patient DOB')
     A            V2CADR    R               REFFLD(DS30)
     A                                      COLHDG('Patient Address')
     A            V2CCTY    R               REFFLD(DS16)
     A                                      COLHDG('Patient City')
     A            V2CST     R               REFFLD(CODE)
     A                                      COLHDG('Patient State')
     A            V2CZIP    R     S         REFFLD(ZIP)
     A                                      COLHDG('Patient Zip Code')
