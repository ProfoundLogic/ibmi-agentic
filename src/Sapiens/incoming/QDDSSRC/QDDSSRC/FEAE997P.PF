     A                                      REF(FSREFP)
     A          R P99701                    TEXT('997 Ack Error Table')
     A            AE997TSTIDR    9A         REFFLD(DS9)
     A                                      COLHDG('Transmission Set ID')
     A            AE997SGID R    3A         REFFLD(DS3)
     A                                      COLHDG('Segment, e.g. AK3,' +
     A                                      'AK5, etc.')
     A            AE997IDCD R    3A         REFFLD(DS3)
     A                                      COLHDG('Segment ID code, e.g' +
     A                                      'CAD')
     A            AE997ERCD R    3A         REFFLD(DS3)
     A                                      COLHDG('Error Code')
     A            AE997POS  R    2A         REFFLD(DS2)
     A                                      COLHDG('Position in Segment')
     A            AE997REF  R    4A         REFFLD(DS4)
     A                                      COLHDG('Data Element' +
     A                                      'Reference Number')
     A            AE997DATA     99A         COLHDG('COPY OF BAD' +
     A                                      'DATA ELEMENT')
     A            AE997PRDT R    7S 0       REFFLD(DT7)
     A                                      COLHDG('Process Date')
     A            AE997STAT R    1A         REFFLD(STAT)
     A                                      COLHDG('Status')
     A            AE997PGM  R   10A         REFFLD(PGM)
     A                                      COLHDG('Maint Program')
     A            AE997USER R   10A         REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            AE997DT   R    7S 0       REFFLD(DT7)
     A                                      COLHDG('Maint Date')
     A            AE997TIME R    6S 0       REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A            AE997IPGM R   10A         REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            AE997IUSR R   10A         REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            AE997IDT  R    7S 0       REFFLD(DT7)
     A                                      COLHDG('Initial Date')
     A            AE997ITIM R    6S 0       REFFLD(TIME)
     A                                      COLHDG('Initial Time')
