     A                                      COLHDG('PPO AMT')
     A            X5PAID    R               REFFLD(DS13)
     A                                      COLHDG('PAID AMT')
     A            X5BPRC    R               REFFLD(DS6 )
     A                                      COLHDG('BILLED' 'PROCEDURE')
     A            X5BRVC    R               REFFLD(DS4)
     A                                      COLHDG('BILLED' 'REVENUE')
     A            X5BTOS    R               REFFLD(DS2)
     A                                      COLHDG('BILLED' 'TOS')
     A            X5REB     R               REFFLD(CPT4)
     A                                      COLHDG('REBUNDLED' 'CODE')
     A            X5RX#     R               REFFLD(DS16)
     A                                      COLHDG('RX #')
     A            X5SVCD    R               REFFLD(DS25)
     A                                      COLHDG('SERVICE CODE')
     A            X5SVDS    R               REFFLD(DS60)
     A                                      COLHDG('SERVICE CODE' +
     A                                             'DESCRIPTION')
     A            X5PYCD    R               REFFLD(DS10)
     A                                      COLHDG('PAY CODE')
     A*
     A* BILL EDI INPUT EMERGENCY STATUS.
     A* THIS INDICATES EMERGENCY SERVICES ON THE LINE.
     A*
     A            X5EMG     R               REFFLD(CODE)
