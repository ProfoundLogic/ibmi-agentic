     A                                      COLHDG('PPO' 'FLAG')
     A            X5FDAT    R               REFFLD(DS10)
     A                                      COLHDG('FIRST DOS')
     A            X5TDAT    R               REFFLD(DS10)
     A                                      COLHDG('LAST DOS')
     A            X5PRCD    R               REFFLD(DS6)
     A                                      COLHDG('PROCEDURE')
     A            X5RVCD    R               REFFLD(DS4)
     A                                      COLHDG('REVENUE' 'CODE ')
     A            X5NDC     R               REFFLD(NDC)
     A                                      COLHDG('NAL''T DRUG CODE')
     A            X5DESC    R               REFFLD(DS60)
     A                                      COLHDG('DESCRIPTION OF' 'SERVICE')
     A            X5TOS     R               REFFLD(DS2)
     A                                      COLHDG('TOS')
     A            X5POS     R               REFFLD(DS2)
     A                                      COLHDG('POS')
     A            X5MOD1    R               REFFLD(PMOD)
     A                                      COLHDG('MODIFIER' '(1)')
     A            X5MOD2    R               REFFLD(PMOD)
     A                                      COLHDG('MODIFIER' '(2)')
     A            X5MOD3    R               REFFLD(PMOD)
     A                                      COLHDG('MODIFIER' '(3)')
     A            X5MOD4    R               REFFLD(PMOD)
     A                                      COLHDG('MODIFIER' '(4)')
     A            X5XREF        18A
     A                                      COLHDG('DIAGNOSIS' 'REFERENCE')
     A*
     A* IMPLIED DECIMAL 2 PLACES, 4.25 = 425, 12345.67 = 1234567
     A*
     A            X5UNTS    R               REFFLD(DS7)
     A                                      COLHDG('UNITS')
     A            X5CHRG    R               REFFLD(DS13)
     A                                      COLHDG('CHARGE')
     A            X5FS      R               REFFLD(DS13)
     A                                      COLHDG('FEE SCHEDULE/UCR' 'AMT')
