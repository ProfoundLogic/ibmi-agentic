     A                                      REF(FSREFP)
     A          R PII01                     TEXT('OPPS Hospital Impact File ')
     A            IIPROV    R               REFFLD(DS10)
     A                                      COLHDG('PROVIDER NUMBER')
     A            IINAME    R               REFFLD(DS40)
     A                                      COLHDG('PROVIDER NAME')
     A            IIEFDT    R               REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE DATE')
     A            IIGLMA    R               REFFLD(DS6)
     A                                      COLHDG('GEOGRAPHIC' 'LABOR MARKET'-
     A                                       'AREA')
     A            IICLMA    R               REFFLD(DS6)
     A                                      COLHDG('PRECLASS' 'LABOR MARKET'-
     A                                       'AREA')
     A            IIPLMA    R               REFFLD(DS6)
     A                                      COLHDG('PAYMENT' 'LABOR MARKET'-
     A                                       'AREA')
     A            IIW505    R               REFFLD(A64)
     A                                      COLHDG('SECTION 505' 'WAGE ADJ.')
     A            IIE505    R               REFFLD(FLAG)
     A                                      COLHDG('SECTION 505 ELIGIBLE')
     A            IIH401    R               REFFLD(FLAG)
     A                                      COLHDG('SECTION 401 HOSPITAL')
     A            IIPRWI    R               REFFLD(A64)
     A                                      COLHDG('POST RECLASS' 'WAGE INDEX')
     A            IICOLA    R               REFFLD(A32)
     A                                      COLHDG('COST OF LIVING' 'ADJUSTMENT-
     A                                      ')
     A            IIRBED    R               REFFLD(A64)
     A                                      COLHDG('RESBED')
     A****
     A*RESBED.  USED TO DETERMINE IME FACTOR FOR OPERATING PPS PAYMENTS
     A****
     A            IISCC     R               REFFLD(DS6)
     A                                      COLHDG('SSA COUNTY CODE')
     A            IIHRAT    R               REFFLD(A72)
     A                                      COLHDG('HOSPITAL SPECIFIC' 'RATES' -
     A                                      'SCH AND MDH')
     A            IIRDAY    R               REFFLD(A64)
     A                                      COLHDG('RDAYS')
     A****
     A*RDAYS.  USED TO CALCULATE THE IME ADJUSTMENT FOR CAPITAL PPS
     A****
     A            IIBEDS    R               REFFLD(A60)
     A                                      COLHDG('NUMBER OF BEDS')
     A            IIADC     R               REFFLD(A60)
     A                                      COLHDG('ADC')
     A****
     A*AVERAGE DAILY CENSUS FROM MEDICARE COST REPORT
     A****
     A            IIOCCR    R               REFFLD(A53)
     A                                      COLHDG('OPERATING COST TO' 'CHARGE'-
     A                                      'CHARGE RATIO')
     A            IICCCR    R               REFFLD(A53)
     A                                      COLHDG('CAPITAL COST TO' 'CHARGE'-
     A                                      'CHARGE RATIO')
     A            IIDSH     R               REFFLD(A64)
     A                                      COLHDG('DISPROPORTIONATE' 'SHARE' -
     A                                      'PATIENT PERCENT')
     A            IIPRLM    R               REFFLD(DS6)
     A                                      COLHDG('POST RECLASS LABOUR' -
     A                                      'MARKET')
     A            IIPRW1    R               REFFLD(A64)
     A                                      COLHDG('PUERTO RICO SPECIFIC' -
     A                                      'POST RECLASS' 'WAGE INDEX')
     A            IIPRTY    R               REFFLD(DS3)
     A                                      COLHDG('PROVIDER TYPE')
     A            IILUGR    R               REFFLD(FLAG)
     A                                      COLHDG('LUGAR')
     A****
     A*LUGAR.  PROVIDER IS LOCATED IN LUGAR COUNTY
     A****
     A            IIRECL    R               REFFLD(FLAG)
     A                                      COLHDG('RECLASSIFICATION' 'STATUS')
     A****
     A* N=DID NOT RECLASSIFY, W=RECLASSIFIED FOR WAGE INDEX, L=RECLASSIFIED
     A* UNDER 1886(D)(8)(B) OF THE SSA, S=REDESIGNATED AS RURAL
     A*
     A****
     A            IIBILL    R               REFFLD(A60)
     A                                      COLHDG('BILLS.  TOTAL CASES')
     A            IITA24    R               REFFLD(A72)
     A                                      COLHDG('CASETA24')
     A****
     A* CASETA24 -TRANSFER ADJUSTED CASES UNDER GROUPER V24
     A****
     A            IICM24         8P 5
     A                                      COLHDG('TACMIV24')
     A****
     A* TACMIV24.  TRANSFER ADJUSTED CASE MIX INDEX UNDER GROUPER 24.
     A****
     A            IISC24         8P 5
     A                                      COLHDG('CMIV24')
     A****
     A* CMIV24.  CASE MIX INDEX UNDER GROUPER V24 FOR SCH PROVIDERS PAID UNDER
     A**THEIR HOSPITAL SPECIFIC RATE
     A****
     A            IITA25    R               REFFLD(A72)
     A                                      COLHDG('CASETA25')
     A****
     A* CASETA25.  TRANSFER ADJUSTED CASES UNDER GROUPER V25
     A****
     A            IICM25         8P 5
     A                                      COLHDG('TACMIV25')
     A****
     A* TACMIV25.  TRANSFER ADJUSTED CASE MIX INDEX UNDER GROUPER 25.
     A****
     A            IISC25         8P 5
     A                                      COLHDG('CMIV25')
     A****
     A* CMIV25.  CASE MIX INDEX UNDER GROUPER V25 FOR SCH PROVIDERS PAID UNDER
     A**THEIR HOSPITAL SPECIFIC RATE
     A****
     A            IIRGN     R               REFFLD(DS6)
     A                                      COLHDG('REGION')
     A            IIURBN    R               REFFLD(DS7)
     A                                      COLHDG('URGEOA')
     A****
     A*URGEO.  LARGE URBAN, OTHER URBAN OR RURAL DESIGNATION OF THE PROVIDERS
     A*GEO CBSA
     A****
     A            IIURPA    R               REFFLD(DS7)
     A                                      COLHDG('URSPA')
     A****
     A*URSPA.  URBAN OR RURAL DESIGNATION BASED ON PAYMENT CBSA
     A****
     A            IITCOP         8P 5
     A                                      COLHDG('TCHOP')
     A****
     A*TCHOP.  IME ADJUSTMENT FACTOR FOR OPERATING PPS
     A****
     A            IITCCP         8P 5
     A                                      COLHDG('TCHCP')
     A****
     A*TCHCP.  ADJUSTMENT FACTOR FOR CAPITOL PPS
     A****
     A            IIPRGA    R               REFFLD(A64)
     A                                      COLHDG('POST RECLASS GAF')
     A****
     A*POST RECLASS GAF.  POST RECLASS GEOGRAPHIC FACTOR FOR CAPITOL
     A****
     A            IIPRFP    R               REFFLD(A64)
     A                                      COLHDG('PUERTO RICO' 'SPECIFIC' -
     A                                      'RECLASS GAF')
     A****
     A*PUERTO RICO SPECIFIC POST RECLASS GAF
     A****
     A            IIAKHI    R               REFFLD(A32)
     A                                      COLHDG('COLACP')
     A****
     A*COLACP.  COST OF LIVING ADJUSTMENT FOR PUERTO RICO
     A****
     A            IIODSH         8P 5
     A                                      COLHDG('DSHOPG')
     A****
     A*DSHOPG.  OPERATING DISPROPORTIONATE SHARE ADJUSTMENT
     A****
     A            IICDSH         8P 5
     A                                      COLHDG('DSHCPG')
     A****
     A*DSHCPG.   CAPITOL DISPROPORTIONATE SHARE ADJUSTMENT
     A****
     A            IIEOPM         8P 5
     A                                      COLHDG('OUT08F')
     A****
     A*OUT08F.  ESTIMATED OPERATING OUTLIER PAYMENTS AS A PERCENTAGE OF THE
     A*PROVIDERS FEDERAL OPERATING PPS PAYMENTS
     A****
     A            IIECPM         8P 5
     A                                      COLHDG('COUT08F')
     A****
     A*COUT08F.  ESTIMATED CAPITOL OUTLIER PAYMENTS AS A PERCENTAGE OF THE
     A*PROVIDERS FEDERAL OPERATING PPS PAYMENTS
     A****
     A            IIMDPC         8P 5
     A                                      COLHDG('MCR_PCT')
     A****
     A*MCR_PCT.  MEDICARE DAYS AS A PERCENT OF TOTAL INPATIENT DAYS
     A****
     A            IISTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            IIIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            IIIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PROGRAM')
     A            IIIDT     R               REFFLD(DT)
     A                                      COLHDG('INTIAL DATE')
     A            IIITIM    R               REFFLD(TIME)
     A                                      COLHDG('INTIAL TIME')
     A            IIUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            IIPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            IIDT      R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            IITIME    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
