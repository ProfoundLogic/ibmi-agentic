     A**
     A          R RAOLOG                    TEXT('WAIT TIME LOG FOR AO RESP')
     A            WHEN           7          COLHDG('BEFORE OR AFTER WAIT')
     A            QDATE          6          COLHDG('DATE  FROM SYSVAL')
     A            QDAY           2          COLHDG('DAY   FROM SYSVAL')
     A            QMONTH         2          COLHDG('MONTH FROM SYSVAL')
     A            QYEAR          2          COLHDG('YEAR  FROM SYSVAL')
     A            QTIME         12          COLHDG('TIME 12 POSITIONS')
     A            Q1USER        10          COLHDG('USER FOR JOB')
     A            Q1JOB         10          COLHDG('JOB NAME')
     A            Q1JOBN         6S 0       COLHDG('JOB NUMBER')
