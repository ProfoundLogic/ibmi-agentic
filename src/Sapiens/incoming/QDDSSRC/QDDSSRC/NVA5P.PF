     A                                      REF(FSREFP)
     A          R PA501                     TEXT('ZIPCODE FILE')
      *
     A            A5ZPNM    R               REFFLD(DS8)
     A                                      COLHDG('ZIPCODE NAME')
     A            A5ZPCD    R               REFFLD(DS5)
     A                                      COLHDG('ZIPCODE')
     A            A5RGN     R               REFFLD(DS9)
     A                                      COLHDG('REGION')
      *               eq 02 = Cincinnati
      *               <> 02 = Statewide
      *
     A            A5FIPS    R               REFFLD(DS8)
     A                                      COLHDG('FIPS')
     A            A5POST        22A
     A                                      COLHDG('POST OFFICE')
     A            A5CNTY    R               REFFLD(DS16)
     A                                      COLHDG('COUNTY')
     A            A5ST      R               REFFLD(ST)
     A                                      COLHDG('STATE')
      *
      * PDS Audit Fields
      *
     A            A5STAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            A5USER    R               REFFLD(USER)
     A                                      COLHDG('CVT USER')
     A            A5PGM     R               REFFLD(PGM)
     A                                      COLHDG('CVT PROGRAM')
     A            A5TIME    R               REFFLD(TIME)
     A                                      COLHDG('CVT TIME')
     A            A5DT      R               REFFLD(DT7)
     A                                      COLHDG('CVT DATE')
     A            A5IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL CVT' 'USER')
     A            A5IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL CVT' 'PROGRAM')
     A            A5ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL CVT' 'TIME')
     A            A5IDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL CVT' 'DATE')
