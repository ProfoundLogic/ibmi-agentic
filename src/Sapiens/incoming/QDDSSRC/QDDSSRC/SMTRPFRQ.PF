     A                                      REF(WREFP)
     A          R PTR01                     TEXT('Rules Engine')
     A            TRCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TRNAME        10A
     A                                      COLHDG('Rules Name')
     A            TRSEQ#         5S 0
     A                                      COLHDG('Name Seq#')
     A            TRTRGNAME    128A
     A                                      COLHDG('Trigger Name')
     A            TRLIBRARY     10A
     A                                      COLHDG('Library')
     A            TRFILE        10A
     A                                      COLHDG('File')
     A            TRTRGTIME      8A
     A                                      COLHDG('*BEFORE' '*AFTER')
     A            TRTRGEVENT     8A
     A                                      COLHDG('*INSERT' '*DELETE' +
     A                                      '*UPDATE')
     A            TRTRGPGM      10A
     A                                      COLHDG('Trigger' 'Program')
     A            TRTRGTMPL    500A
     A                                      COLHDG('Trigger' 'Template')
     A            TREXITPGM     21A
     A                                      COLHDG('Exit Lib/Pgm')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TRSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A
     A          K TRCO#
     A          K TRNAME
     A          K TRSEQ#
     A          K TRTRGNAME
