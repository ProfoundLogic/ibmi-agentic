     A                                      REF(WREFP)
     A          R PST01                     TEXT('Settlement Tracking File')
     A*
     A            STCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company #')
     A            STFND     R     S         REFFLD(FND)
     A                                      COLHDG('Fund')
     A            STFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('Policy' 'Year')
     A            STCASE    R     S         REFFLD(CASE)
     A                                      COLHDG('Case')
     A            STCURSAUT R     S         REFFLD(A112)
     A                                      COLHDG('Current Settlement' +
     A                                      'Authority')
     A            STAUTAPRDTR     S         REFFLD(DT)
     A                                      COLHDG('Date of Settlement' +
     A                                      'Authority Approved')
     A            STCURDOC  R     S         REFFLD(A112)
     A                                      COLHDG('Current Settlement' +
     A                                      'Demand from' +
     A                                      'Opposing Counsel')
     A            STDOCDT   R     S         REFFLD(DT)
     A                                      COLHDG('Date of' +
     A                                      'Settlement' +
     A                                      'Demand')
     A            STDT      R     S         REFFLD(DT)
     A                                      COLHDG('Date of update')
     A            STTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Time of update')
     A            STUSER    R               REFFLD(USER)
     A                                      COLHDG('User')
     A            STPGM     R               REFFLD(PGM)
     A                                      COLHDG('Program')
