     A**
     A** EDI/NOI A49 Transmission File - Required Segment
     A                                      REF(WREFP)
     A**
     A          R PDS01                     TEXT('EDI A49 Format')
     A*
     A***    Transaction
     A*
     A            DSTSET         3A         TEXT('TRANSACTION SET ID')
     A            DSMTC          2A         TEXT('MAINT TYPE CODE')
     A            DSTDT          8A         TEXT('MAINT TYPE CODE DATE')
     A*
     A***    Jurisdiction
     A*
     A            DSJRST         2A         TEXT('JURISDICTION')
     A*
     A***    Claim Administrator
     A*
     A            DSCLCD         9A         TEXT('INSURER FEIN')
     A            DSFEIN         9A         TEXT('3RD PTY FEIN')
     A            DSAZIP         9A         TEXT('CLM ADMIN ZIP')
     A*
     A***    Employee
     A*
     A            DSSS#          9A         TEXT('SOC SEC #')
     A            DSDEP          2A         TEXT('# OF DEPENDENTS')
     A            DSPRED         1A         TEXT('PRE-EXISTING DISABILITY')
     A            DSDBDT         8A         TEXT('DATE DISABILITY BEGAN')
     A            DSMAXI         8A         TEXT('DATE MAX MED IMPROV')
     A            DSRETW         1A         TEXT('RETURN TO WORK QUALIFIER')
     A            DSRTW          8A         TEXT('DATE RETURN TO WORK')
     A            DSEDTD         8A         TEXT('DATE OF EMPLOYEE DEATH')
     A*
     A*  WAGE
     A*
     A            DSWAGE        11A         TEXT('WAGE')
     A            DSWGPD         2A         TEXT('WAGE PERIOD')
     A            DSDAYS         1A         TEXT('DAYS WORKED')
     A            DSCSAL         1A         TEXT('CONTINUED SALARY')
     A*
     A*  ACCIDENT
     A*
     A            DSACDT         8A         TEXT('INJURY DATE')
     A            DSRPT#        25A         TEXT('INSURED REPORT NUMBER')
     A            DSACLC        25A         TEXT('ADMIN CLAIM #')
     A            DSACL#        25A         TEXT('AGENCY CLAIM #')
     A*
     A*  CLAIM STATUS
     A*
     A            DSCSTS         1A         TEXT('CLAIM STATUS')
     A            DSCTYP         1A         TEXT('CLAIM TYPE')
     A            DSACCD         1A         TEXT('AGREE COMPENSATE CODE')
     A            DSRPDT         8A         TEXT('DATE OF REPRESENTATION')
     A*
     A*  PAYMENT STATUS
     A*
     A            DSLATC         2A         TEXT('LATE REASON CODE')
     A*
     A*  VARIABLE SEGMENT NUMBERS
     A*
     A            DS#PI          2A         TEXT('# OF PERM IMPAIRMENTS')
     A            DS#PA          2A         TEXT('NUMBER OF PAY/ADJ')
     A            DS#BA          2A         TEXT('# OF BENEFIT ADJ')
     A            DS#RER         2A         TEXT('# OF PAID DT, RE, RVC')
     A            DS#DDR         2A         TEXT('# OF DEATH DEPENDENTS')
