     A**
     A                                      REF(WREFP)
     A**
     A*** Begin Add *** 05/30/18 ***********************************
     A***       R PT301                     TEXT('EDI A49, Death Dependent')
     A          R PT301                     TEXT('EDI - Dependent Payee')
     A*** End Add   *** 05/30/18 ***********************************
     A            T3CO#     R               REFFLD(CO#)
     A            T3EXDT    R               REFFLD(DT)
     A                                      COLHDG('EXTRACT DATE')
     A            T3TSET    R    3A         REFFLD(CODE)
     A                                      TEXT('TRANSACTION SET ID')
     A            T3MTC     R               REFFLD(CODE)
     A                                      TEXT('MAINT TYPE CODE')
     A            T3TDT     R    8S 0       REFFLD(DT)
     A                                      TEXT('MAINT TYPE CODE DATE')
     A            T3JRST    R               REFFLD(CODE)
     A                                      TEXT('JURISDICTION')
     A            T3ACLC    R   25A         REFFLD(DS20)
     A                                      COLHDG('ADMIN' 'CLAIM' '#')
     A*
     A            T3REL     R               REFFLD(FLAG)
     A                                      COLHDG('Dependent' 'Relationship')
     A            T3BODR    R               REFFLD(FLAG)
     A                                      COLHDG('Dependent' 'Birth Order')
     A*
     A            T3STAT    R               REFFLD(STAT)
     A            T3USER    R               REFFLD(USER)
     A            T3PGM     R               REFFLD(PGM)
     A            T3TIME    R               REFFLD(TIME)
     A            T3DT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*** Begin Add *** 05/30/18 ***********************************
     A            T3DFSN    R               REFFLD(FSN)
     A                                      TEXT('Dependant First Name')
     A                                      COLHDG('Dpndnt 1st Name')
     A            T3DLSN    R               REFFLD(NAME)
     A                                      TEXT('Dependant Last Name')
     A                                      COLHDG('Dpndnt Last Name')
     A            T3DDOB    R               REFFLD(DT8)
     A                                      TEXT('Dependant DOB')
     A                                      COLHDG('Dependant DOB')
     A            T3DSEX    R               REFFLD(FLAG)
     A                                      TEXT('Dependnt Gender Code')
     A                                      COLHDG('Dpndnt Gndr Cde')
     A            T3EXTD    R               REFFLD(FLAG)
     A                                      TEXT('Dependnt Extnt of Dependancy')
     A                                      COLHDG('Dpndnt Extnt Dpndncy')
     A*** End   Add *** 05/30/18 ***********************************
