     A*
     A*  EDI Reduced Earnings File
     A                                      REF(WREFP)
     A          R PE301                     TEXT('Reduced Earnings')
     A            E3CO#     R               REFFLD(CO#)
     A            E3FND     R               REFFLD(FND)
     A            E3FYR     R               REFFLD(FYR)
     A            E3CASE    R               REFFLD(CASE)
     A            E3LGSQ    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            E3WK#     R               REFFLD(A20)
     A                                      TEXT('Reduced earnings week #')
     A            E3ACTU    R               REFFLD(A92)
     A                                      TEXT('Actual reduced earnings')
     A            E3DEEM    R               REFFLD(A92)
     A                                      TEXT('Deemed reduced earnings')
     A*
     A            E3USER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            E3PGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A            E3DT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            E3TIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
