     A          R PER01                     TEXT('FROI CLAIM ADD ERROR')
     A*
     A            ERCO           3S 0       TEXT('Company number')
     A                                      COLHDG('COMPANY')
     A            ERFND          5S 0       TEXT('Fund Number')
     A                                      COLHDG('GROUP')
     A            EREMP          9S 0       TEXT('Employer Number')
     A                                      COLHDG('EMPLOYER')
     A            ERTIME         6S 0       TEXT('TIME')
     A                                      COLHDG('TIME')
     A            ERDATE         8A         TEXT('Date')
     A                                      COLHDG('DATE')
     A            ERSS           9A         TEXT('Social Security Number')
     A                                      COLHDG('SOCIAL SECURITY NO.')
     A            ERDESC       120A         TEXT('ERROR DESCRIPTION')
     A                                      COLHDG('ERROR DESCRIPTION')
     A          K ERFND
     A          K EREMP
     A          K ERTIME
     A          K ERDATE
     A          K ERSS
     A          K ERDESC
     A*
