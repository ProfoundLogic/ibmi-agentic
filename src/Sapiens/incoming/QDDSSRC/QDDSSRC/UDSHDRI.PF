     A          R PSH01                     TEXT('NAIC UDS CLAIM NOTES FILE')
     A*
01   A            SHRECT        20A         TEXT('Record type')
02   A            SHNAIC         5S 0       TEXT('NAIC number')
03   A            SHRTFN         1A         TEXT('Reciever To Fund')
04   A            SHFST          2A         TEXT('From State')
05   A            SHLCD          2S 0       TEXT('File location code')
06   A            SHSCT          2A         TEXT('State Codes Table')
07   A            SHFLCT         2A         TEXT('File Location Code Table')
08   A            SHBCH#         3S 0       TEXT('Batch Number')
09   A            SHBPDT         8S 0       TEXT('Batch Prepared Date YYYYMMDD')
10   A            SHBFDT         8S 0       TEXT('Batch From Date YYYYMMDD')
11   A            SHBTDT         8S 0       TEXT('Batch Through Date YYYYMMDD')
12   A            SHITYP         3A         TEXT('Insurance Type P&C')
13   A            SHRFIN         1A         TEXT('Replace File Indicator Y/N')
14   A            SHFILL       586A         TEXT('Filler')
15   A            SHUSER        10A         TEXT('User')
16   A            SHPGM         10A         TEXT('Program')
17   A            SHTIME         6S 0       TEXT('Time')
18   A            SHDT           7S 0       TEXT('Date')
19   A            SHROOT        40A         TEXT('Root Directory')
20   A            SHFLAG         1A         TEXT('Processed Flag')
