     A****************************************************************
     A                                      REF(WREFP)
     A          R PAP01                     TEXT('AGENT PRODUCER FILE')
     A            APCO#     R               REFFLD(CO#)
     A            APFEIN    R               REFFLD(FEIN)
     A            APMOD     R               REFFLD(MOD)
     A            APPROD    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER' 'NUMBER')
     A            APSEQ#        15S 0       COLHDG('Sequence #')
     A            APCRITID      25A         COLHDG('CRITERIA ID')
     A            APCRITVAL     50A         COLHDG('CRITERIA VALUE')
     A            APSTAT    R               REFFLD(STAT)
     A            APUSER    R               REFFLD(USER)
     A            APPGM     R               REFFLD(PGM)
     A            APTIME    R               REFFLD(TIME)
     A            APDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            APIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            APIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            APITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            APIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')

     A          K APCO#
     A          K APFEIN
     A          K APMOD
     A          K APPROD
     A          K APSEQ#
