     A                                      REF(FSREFP)
     A          R PMC01                     TEXT('Medicare Rate File')
     A
     A            MCPRCD         5A         COLHDG('Procedure Code')
     A            MCEFDT         7P 0       COLHDG('Effective Date')
     A            MCDSC1        50A         COLHDG('Procedure Code' +
     A                                      'Description 1')
     A            MCDSC2        50A         COLHDG('Procedure Code' +
     A                                      'Description 2')
     A            MCFA01         9P 2       COLHDG('Loc 1 Facility' +
     A                                      'Allowance')
     A            MCNF01         9P 2       COLHDG('Loc 1 Non-Facility' +
     A                                      'Allowance')
     A            MCF501         9P 2       COLHDG('Loc 1 Mod 53' +
     A                                      'Facility Allowance')
     A            MCN501         9P 2       COLHDG('Loc 1 Mod 53' +
     A                                      'Non-Facility' +
     A                                      'Allowance')
     A            MCFA99         9P 2       COLHDG('Loc 99 Facility' +
     A                                      'Allowance')
     A            MCNF99         9P 2       COLHDG('Loc 99 Non-Facility' +
     A                                      'Allownace')
     A            MCF599         9P 2       COLHDG('Loc 99 Mod 53' +
     A                                      'Facility Allowance')
     A            MCN599         9P 2       COLHDG('Loc 99 Mod 53' +
     A                                      'Non-Facility' +
     A                                      'Allownace')
     A            MC2601         9P 2       COLHDG('Loc 1 Professional' +
     A                                      'Component')
     A            MCTC01         9P 2       COLHDG('Loc 1 Technical' +
     A                                      'Component')
     A            MC2699         9P 2       COLHDG('Loc 99 Professional' +
     A                                      'Component')
     A            MCTC99         9P 2       COLHDG('Loc 99 Technical' +
     A                                      'Component')
     A            MCSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            MCUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            MCPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            MCTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            MCDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            MCIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            MCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            MCITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
