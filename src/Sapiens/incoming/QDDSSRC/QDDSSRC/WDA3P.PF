     A**
     A** EDI Extract - Employer paid info.
     A                                      REF(WREFP)
     A**
     A          R PA301                     TEXT('R22 Weekly Amount'   )
     A            A3CO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            A3FND     R               REFFLD(FND)
     A                                      COLHDG('FUND' 'NUMBER')
     A            A3FYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY' 'YEAR')
     A            A3CASE    R               REFFLD(CASE)
     A                                      COLHDG('CLAIM' 'NUMBER')
     A            A3BTC          3A
     A                                      COLHDG('BENIFIT TYPE CODE')
     A            A3PAID         9S 2       COLHDG('TOTAL PAID')
     A            A3STDT         8S         COLHDG('START DATE')
     A            A3ENDT         8S         COLHDG('END DATE')
     A            A3PID          8S         COLHDG('NOT USED')
     A****** BEGIN ADD ******* 07/30/08 *******************************
     A            A3USER    R               REFFLD(USER)
     A            A3PGM     R               REFFLD(PGM)
     A            A3DT           7S 0       COLHDG('DATE')
     A            A3TIME    R               REFFLD(TIME)
     A*
     A            A3IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            A3IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            A3IDT          7S 0       COLHDG('INITIAL' 'DATE')
     A            A3ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
