     A*
     A            D3ACLC        25A         COLHDG('CLAIM ADMIN' 'CLM #')
     A*
     A            D3CAFE         9A         COLHDG('CLAIM ADMIN' 'FEIN')
     A*
     A            D3CANM        40A         COLHDG('CLAIM' 'ADMIN' 'NAME')
     A*
     A            D3CARP        40A         COLHDG('CLM ADMIN' 'CLM REP' 'NAME')
     A*
     A            D3CAPH        15A         COLHDG('CLM ADM' 'CLM REP' 'BUSINES+
     A                                      S PH#')
