     A          R PD301                     TEXT('EDI 3.1 R22 Format')
     A*
     A            D3TSET         3A         COLHDG('TRANSACTION' 'SET ID')
     A*
     A            D3MTCC         2A         COLHDG('MAINT' 'TYPE' 'CORR CODE')
     A*
     A            D3MTC2         8A         COLHDG('MAINT TYPE' 'CORR CODE' +
     A                                      'DATE')
     A*
     A            D3CNLT         8A         COLHDG('CLAIM ADMIN' 'KNWLGE OF +
     A                                      LOST TIME' 'DATE')
     A*
