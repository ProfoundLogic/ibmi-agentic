     A*
     A* Medical Outbound File - Detail Information
     A*
     A*****************************************************************
     A* Created on 12/04/2007 by c:183 for Project MC315
     A*****************************************************************
     A* Purpose: This file will house the 'detail info' record for
     A*          the associated Medical records. It will be tied to
     A*          FOU1P via U1TRID = U2TRID.
     A*****************************************************************
     A* Revisions:
     A*
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PU201                     TEXT('Medical Out File - Det Info')
     A            U2TYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Record Type')
     A            U2TRID    R               REFFLD(DS15)
     A                                      COLHDG('Transaction ID')
     A            U2LIN#    R     S         REFFLD(A80)
     A                                      COLHDG('Line #')
     A            U2SVDT    R               REFFLD(DT8)
     A                                      COLHDG('Date of Service')
     A            U2RVCD    R               REFFLD(DS3)
     A                                      COLHDG('Revenue Code')
     A            U2CODE    R               REFFLD(DS8)
     A                                      COLHDG('Paid Code')
     A            U2CDSC    R               REFFLD(DS30)
     A                                      COLHDG('Code Description')
     A            U2UNTS    R     S         REFFLD(A70)
     A                                      COLHDG('Units')
     A            U2MOD     R               REFFLD(DS3)
     A                                      COLHDG('Paid Modifier')
     A            U2POS     R               REFFLD(CODE)
     A                                      COLHDG('Place of Service')
     A            U2CHRG        11A
     A                                      COLHDG('Charged')
     A            U2MRA         11A
     A                                      COLHDG('MRA Reductions')
     A            U2NDIS        11A
     A                                      COLHDG('Network Reductions')
     A            U2PAID        11A
     A                                      COLHDG('Paid Amount')
     A            U2NDC         18A         COLHDG('NDC drug Paid code')
     A            U2RX#         13A         COLHDG('Prescription Number')
     A            U2DXR     R               REFFLD(DS4)
     A                                      COLHDG('ICD9 x-ref')
     A            U2EOB     R               REFFLD(DS4)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code')
     A            U2EOBD    R               REFFLD(DS30)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code ' +
     A                                      'Description')
     A            U2RLIN    R               REFFLD(DT8)
     A                                      COLHDG('Recon Line Number')
     A            U2REAS    R               REFFLD(DS30)
     A                                      COLHDG('Recon Reason')
     A            U2FIL1       200A
     A            U2FIL2        64A
     A            U2MOD2    R               REFFLD(DS3)
     A                                      COLHDG('Modifier  ')
     A            U2MOD3    R               REFFLD(DS3)
     A                                      COLHDG('Modifier  ')
     A            U2MOD4    R               REFFLD(DS3)
     A                                      COLHDG('Modifier  ')
     A            U2TH#     R               REFFLD(DS2)
     A                                      COLHDG('Tooth Number')
     A            U2NWRF    R               REFFLD(FLAG)
     A                                      COLHDG('Prescription:New' +
     A                                      'or Refill')
     A            U2CERT    R               REFFLD(FLAG)
     A                                      COLHDG('Certification For' +
     A                                      'FL This is dispensed' +
     A                                      'as written')
     A            U2LIC#    R               REFFLD(DS13)
     A                                      COLHDG('Prescribers License#')
     A            U2NDCD        80A
     A                                      COLHDG('Drug Name')
     A            U2RXDY         5S 0
     A                                      COLHDG('Drugs/Supplies ' +
     A                                      'Numbre of Days')
     A            U2DFEE        11A
     A                                      COLHDG('Drugs/Supplies ' +
     A                                      'Dispensing Fee')
     A            U2RXDI    R               REFFLD(FLAG)
     A                                      COLHDG('Dispense' 'as' 'Written')
     A            U2BCDT    R               REFFLD(DS2)
     A                                      COLHDG('Basis' 'of Cost' 'Deter')
     A            U2BNDC        18A
     A                                      COLHDG('NDC' 'Billed' 'Code')
     A            U2BLFC    R               REFFLD(FLAG)
     A                                      COLHDG('DME Billing' +
     A                                      'Frequency Code')
     A            U2DUCD    R               REFFLD(DS2)
     A                                      COLHDG('Days/Units' 'Code')
     A            U2BPRC    R               REFFLD(DS8)
     A                                      COLHDG('Billed' 'Code')
     A            U2BMD1    R               REFFLD(DS3)
     A                                      COLHDG('Billed' 'Modifier')
     A            U2EOB1    R               REFFLD(DS4)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code 1' )
     A            U2SAG1    R               REFFLD(DS2)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code 1')
     A            U2EOD1       140A
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code ' +
     A                                      'Description 1')
     A            U2EOB2    R               REFFLD(DS4)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code 2' )
     A            U2SAG2    R               REFFLD(DS2)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code 2')
     A            U2EOD2       140A
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code ' +
     A                                      'Description 2')
     A            U2EOB3    R               REFFLD(DS4)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code 3' )
     A            U2SAG3    R               REFFLD(DS2)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code 3')
     A            U2EOD3       140A
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code ' +
     A                                      'Description 3')
     A            U2EOB4    R               REFFLD(DS4)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Reason code 4' )
     A            U2SAG4    R               REFFLD(DS2)
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code 4')
     A            U2EOD4       140A
     A                                      COLHDG('Service Adjustment' +
     A                                      'Group code ' +
     A                                      'Description 4')
     A            U2OTH2        11A
     A                                      COLHDG('Other reduction 2')
     A            U2RXPT    R               REFFLD(FLAG)
     A                                      COLHDG('Drugs/Equipment' +
     A                                      'and Supplies' 'Indicator')
     A            U2PRIN    R               REFFLD(FLAG)
     A                                      COLHDG('Purchase/Rental' +
     A                                      'Indicator')
     A            U2RNPR        35A         COLHDG('Rendering Provider' +
     A                                      'Last/Group name')
     A            U2RNPI        15A         COLHDG('Rendering Provider' +
     A                                      'NPI#')
     A            U2FILL       696A
     A                                      COLHDG('Future Expansion')
