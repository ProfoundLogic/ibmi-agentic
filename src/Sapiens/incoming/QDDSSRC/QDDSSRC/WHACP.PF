      *
     A                                      REF(WREFP)
      *
     A          R PAC01                     TEXT('Agent Commission File')
      *
     A            ACPOL#        25A         COLHDG('Policy Number')
      *                     GRP/EMPLYR/YR
      *
     A            ACAGT#        20A         COLHDG('Agent Number')
      *                     WFACP/ACFND + ACAGT#
      *
     A            ACPROD        10A         COLHDG('Producer Id')
      *                     WFACP/ACPROD
      *
     A            ACDIV          5S 0       COLHDG('Division Id')
      *                     WFACP/ACDIV
      *
     A            ACTRTP         1A         COLHDG('Transaction Type')
      *                     E=Part of commissions earned
      *                     P=Part of commissions paid
      *
     A            ACTYDS        30A         COLHDG('Description of' +
                                            'Transaction')
      *                     WFACP/ACTYDS
      *
     A            ACAMT         16S 2       COLHDG('Transaction Amount')
      *                     WFACP/ACAMT  (mult by -1 if ACCOTP='V')
      *
     A            ACTNDT        10A         COLHDG('Transaction Date')
      *                     WFACP/ACTNDT   mm/dd/ccyy
      *
     A            ACCHCK        10A         COLHDG('Check Number')
      *                     WFACP/ACCHCK
      *
     A            ACFND          3S 0       COLHDG('Owner Code')
      *                     WFACP/ACFND
      *
     A            ACPSDT        10A         COLHDG('Statement Date')
      *                     WFACP/ACPSDT   mm/dd/ccyy
      *
     A            ACTOCL        16S 2       COLHDG('Collected Premium')
      *                     WFACP/ACTOCL
      *
     A            ACRATE         7S 3       COLHDG('Commission Rate')
      *                     WFACP/ACRATE
      *
     A            ACKEY         50A         COLHDG('Unique Key')
      *                     CO#/FND/AGT#/EMP#/DIV/FYR/PODT/TRDT
      *
     A            ACAODT        10A         COLHDG('As of Date')
      *                     DSDATE         mm/dd/ccyy
     A* ============================================================ *
     A*
     A*  NOTE: ANY FIELDS ADDED TO THIS FILE NEED TO BE ADDED IN
     A*        FRONT OF THE AS OF DATE FIELD AT END OF THE FILE -
     A*        OR THIS COULD CAUSE RECORDS TO BE MISSED/SKIPPED
     A*        DURING THE IMPORT PROCESS AFTER THE EXTRACT IS RUN.
     A*
     A* ============================================================ *
      *
