     A          R ASC1                      TEXT('ASCENT CAPTURE DATA IDX INFO')
     A            IMDTYP         8          COLHDG('DOCUMENT TYPE')
     A            IMDCID        12          COLHDG('DOCUMENT ID' 'ORIG. FILE')
     A            IMASDI         9S 0       COLHDG('ASCENT DOCUMENT ID')
     A            IMDFS         10          COLHDG('FILE SYSTEM - QDLS')
     A            IMDDIR        80          COLHDG('DOCUMENT PATH' 'QDLS STG')
     A            IMSDAT         8P 0       COLHDG('SCAN DATE' )
     A            IMSTIM         6P 0       COLHDG('SCAN TIME')
     A            IMSUSR        10          COLHDG('SCAN USER')
     A            IMDKEY        40          COLHDG('DARTS KEY')
     A            IMSTAT         1          COLHDG('STATUS')
      ********** RELEASE VALUES FROM ASCENT **********************************
      *
     A            BCHCRD        15          COLHDG('BATCH CREATION DATE')
     A            BCHCTM        15          COLHDG('BATCH CREATION TIME')
     A            STNID         32          COLHDG('BATCH STATION ID')
     A            SITEID        32          COLHDG('BATCH SITE ID')
     A            USRNAM        15          COLHDG('ORIG USER NAME-PC-')
      *
      ********** VALUES FROM IMPORT PROCESSING *******************************
      *
     A            DRSEQ#         5S 0       COLHDG('DARTS SEQ#')
     A            DRIDOC        12          COLHDG('IMAGE DOC ID -DARTS')
     A            DRFOLD        60          COLHDG('DARTS FOLDER')
     A            INDEXD         1          COLHDG('INDEXED Y/N')
     A            ISBCHI        10          COLHDG('INFINITY BATCH ID')
