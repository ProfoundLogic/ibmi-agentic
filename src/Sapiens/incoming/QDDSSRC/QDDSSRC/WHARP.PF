      *
     A            ARDIV          5S 0       COLHDG('Division Id')
      *                  WFARP/ARDIV
      *
     A            ARTRTP         1A         COLHDG('Transaction Type')
      *                  I=INVOICE, C= PAYMENT, B=BALANCE, P=PAST DUE AMT
      *
     A            ARTRDS        30A         COLHDG('Description of' +
                                            'Transaction')
      *                  WFARP/ARDESC
      *
     A            ARAMT         16S 2       COLHDG('Transaction Amount')
      *                  WFARP/ARAMT
      *
     A            ARTRDT        10A         COLHDG('Transaction Date')
      *                  WFARP/ARTRDT
      *
     A            ARCHK#        10A         COLHDG('Check Number')
      *                  WFARP/ARCHK#
      *
     A            ARNINV        20A         COLHDG('Invoice Number')
      *                  WFARP/ARNINV
      *
     A            ARFND          3S 0       COLHDG('Owner Code')
      *                  WFARP/ARFND
      *
     A            ARDBIL         1A         COLHDG('Is Direct Bill' +
                                            'Policy')
      *                  WMARP/ARPLAN ?
      *
     A            ARPODT        10A         COLHDG('Posting Date')
      *                  WFARP/ARPODT
      *
     A            ARKEY         50A         COLHDG('UNIQUE KEY')
