     A                                      REF(SREFP)
     A          R PSP012                    TEXT('SCRIPTURA LOGO FILE')
     A            S2TYPE       100A         COLHDG('PROCESS TYPE/DESC')
     A            S2FND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            S2EFDT    R     S         REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            S2LOGO       100A         COLHDG('LOGO FILE NAME')
     A            S2PATH       250A         COLHDG('LOGO FOLDER/PATH')
     A            S2STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            S2USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            S2PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            S2TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            S2DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            S2IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            S2IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            S2ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            S2IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
      *** BEGIN ADD *** 09/25/24 **************************************
     A            S2URL        250A         COLHDG('LOGO URL')
