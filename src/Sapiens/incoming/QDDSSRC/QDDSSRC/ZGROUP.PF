     A          R ZGROUPR                   TEXT('Group Setup Defaults')
     A            ZCLT           3S 0       TEXT('Client/Company')
                                            COLHDG('                    ' +
                                                   'Clt                 ' +
                                                   'Co#                 ')
     A            ZGRP           3S 0       TEXT('Group Number')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Group               ')
     A            ZSTATE         2A         TEXT('State')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'State               ')
     A            ZRTCD          3A         TEXT('Rate Code')
                                            COLHDG('                    ' +
                                                   'Rate                ' +
                                                   'Code                ')
     A          K ZCLT
     A          K ZGRP
