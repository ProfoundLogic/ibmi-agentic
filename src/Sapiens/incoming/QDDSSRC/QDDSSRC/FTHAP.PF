     A                                      REF(FSREFP)
     A*
     A          R PHA01                     TEXT('Harbor and Longshormen -
     A                                      Anesthesia Conv Factor File')
     A*
     A            HAZIP     R               REFFLD(A50)
     A                                      COLHDG('Zip Code')
     A                                      TEXT('Zip Code')
     A            HAST      R               REFFLD(DS2)
     A                                      COLHDG('State')
     A                                      TEXT('State')
     A            HAMSA     R               REFFLD(DS2)
     A                                      COLHDG('MSA')
     A                                      TEXT('MSA')
     A            HAEFDT    R               REFFLD(DT7)
     A                                      COLHDG('Effective date')
     A                                      TEXT('Effective date')
     A            HACF      R     S         REFFLD(A52)
     A                                      COLHDG('Anes Conv Fac')
     A                                      TEXT('Anesthesia Conversion Factor')
     A            HASTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A                                      TEXT('Status')
     A            HAPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Program')
     A                                      TEXT('Maint Program')
     A            HAUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A                                      TEXT('Maint User')
     A            HADT      R               REFFLD(DT)
     A                                      COLHDG('Maint Date')
     A                                      TEXT('Maint Date')
     A            HATIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A                                      TEXT('Maint Time')
     A            HAIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A                                      TEXT('Initial Program')
     A            HAIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A                                      TEXT('Initial User')
     A            HAIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A                                      TEXT('Initial Date')
     A            HAITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A                                      TEXT('Initial Time')
     A*
