     A                                      REF(WREFP)
     A          R PIM01                     TEXT('Image Cross Reference File')
     A            IMCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company #')
     A            IMFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group #')
     A            IMEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            IMDIV     R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            IMINV#        10S 0       COLHDG('Invoice #')
     A            IMTYPE        50A         COLHDG('Type of' +
     A                                      'Invoice/Action')
     A            IMPODT    R     S         REFFLD(DT7)
     A                                      COLHDG('Posting Date')
     A            IMUNCN       255A         COLHDG('Full UNCN Path')
     A            IMSEQ#         5S 0       COLHDG('iDarts Sequence #')
     A            IMSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            IMUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            IMPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            IMTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            IMDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            IMIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            IMIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            IMITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            IMIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
