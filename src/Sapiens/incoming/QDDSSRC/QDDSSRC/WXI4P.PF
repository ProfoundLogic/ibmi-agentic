     A                                      REF(WREFP)
     A          R PI401                     TEXT('DRAFT DETAIL RECORD FILE')
     A            I4IND          3S 0       COLHDG('SUBCONTRACTOR #')
     A            I4BRCH    R               REFFLD(STAF)
     A                                      COLHDG('BRANCH OFFICE')
     A            I4CLCD         8          COLHDG('CLAIM CODE')
     A            I4SMBL         3S 0       COLHDG('SYMBOL')
     A            I4DRT#    R               REFFLD(DS15)
     A                                      COLHDG('DRAFT #')
     A            I4DRTI         8S 0       COLHDG('DRAFT ISSUE DATE')
     A            I4DRTS         1          COLHDG('DRAFT STATUS')
     A            I4DRTA        11S 0       COLHDG('DRAFT AMOUNT')
     A            I4MINR         3S 0       COLHDG('MINOR PAYMENT CODE')
     A            I4PNAM        26          COLHDG('PAYEE NAME')
     A            I4DRTT    R               REFFLD(STAF)
     A                                      COLHDG('TYPE OF DRAFT')
     A            I4TAX#         9S 0       COLHDG('TAX ID #')
     A            I4ACDT         8S 0       COLHDG('ACCOUNT DATE')
     A            I4CLID         6S 0       COLHDG('CLIENT ID')
     A            I4FIL2        13          COLHDG('FILLER')
