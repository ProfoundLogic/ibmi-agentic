     A                                      COLHDG('Policy Year')
     A            EL1CNAM       40A         COLHDG('Company Name')
     A            EL1FNAM       60A         COLHDG('Group Name')
     A            EL1ENAM      100A         COLHDG('Employer Name')
     A            EL1RGN#        3S 0       COLHDG('Region#')
     A            EL1RNAM       40A         COLHDG('Region# Name')
     A            EL1LREP        3A         COLHDG('Loss Control Rep')
     A            EL1EFDT        8S 0       COLHDG('Employer Eff Date')
