     A                                      REF(WREFP)
     A          R PSF01                     TEXT('CLAIM STAFF CODE DEFINITION -
     A                                            FILE')
     A            SFCO#     R               REFFLD(CO#)
     A            SFFND     R               REFFLD(FND)
     A            SFSTAF    R               REFFLD(STAF)
     A            SFTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('STAFF CODE' 'TYPE')
     A            SFFEMP    R               REFFLD(CODE)
     A                                      COLHDG('FROM' 'EMPLOYER')
     A            SFTEMP    R               REFFLD(CODE)
     A                                      COLHDG('TO' 'EMPLOYER')
     A            SFSTAT    R               REFFLD(STAT)
     A            SFUSER    R               REFFLD(USER)
     A            SFPGM     R               REFFLD(PGM)
     A            SFTIME    R               REFFLD(TIME)
     A            SFDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*** BEGIN ADD *** 09/23/94 **************************************
     A            SFLTFL    R               REFFLD(FLAG)
     A                                      COLHDG('LOST TIME' 'CLAIMS')
     A*** END ADD ***** 09/23/94 **************************************
     A***  BEGIN ADD  ***  10/04/95  *********************************
     A            SFRRFR    R               REFFLD(A112)
     A                                      COLHDG('RESERVE' 'RANGE' 'FROM')
     A            SFRRTO    R               REFFLD(A112)
     A                                      COLHDG('RESERVE' 'RANGE' 'TO')
     A***  END   ADD  ***  10/04/95  *********************************
     A***  BEGIN ADD  ***  03/14/96  *********************************
     A            SFADTF    R               REFFLD(DT)
     A                                      COLHDG('ACC DATE' 'RANGE' 'FROM')
     A            SFADTT    R               REFFLD(DT)
     A                                      COLHDG('ACC DATE' 'RANGE' 'TO')
     A            SFMCA     R               REFFLD(FLAG)
     A                                      COLHDG('MCA' 'FLAG')
     A***  END   ADD  ***  03/14/96  *********************************
