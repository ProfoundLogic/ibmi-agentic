     A*  REVISIONS:                                                   *
     A*                                                               *
     A*  10/28/20  C:079 Project: WC2671                              *
     A*                  Add Audit Request Fields                     *
     A*                                                               *
     A*  12/23/11  C:279 PROJECT 114WYM                               *
     A*                  File missing field CFSRFL.                   *
     A*                                                               *
     A*  05/03/10  C:220 PROJECT WC1881                               *
     A*                  Add Ctrl flag to Final Audit Request Form    *
     A*                                                               *
     A*  11/06/07  C:183 PROJECT 71WIL                                *
     A*                  Added new field 'Resolve to DARTS' flag.     *
     A*                                                               *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PCF01                     TEXT('CANX CONFIRMATION CONTROL')
     A
     A            CFCO#     R               REFFLD(CO#)
     A            CFFND     R               REFFLD(FND)
     A            CFCFSD    R               REFFLD(DT)
     A                                      COLHDG('CANX EFF START DATE')
     A            CFNOTC    R               REFFLD(FLAG)
     A                                      COLHDG('GENERATE CONF NOTICE')
     A            CFAURQ    R               REFFLD(FLAG)
     A                                      COLHDG('GENERATE AUDIT RQST')
     A            CFQTRK    R               REFFLD(FLAG)
     A                                      COLHDG('UPDATE QUOTE' 'TRACKING')
     A            CFRQCF    R               REFFLD(FLAG)
     A                                      COLHDG('REQUIRE CONF' 'FOR RPRTG')
     A            CFNECX    R               REFFLD(FLAG)
     A                                      COLHDG('ALLOW CONFIRM' 'DATE DIFF'+
     A                                                'FROM CANX' 'EFF DATE')
     A            CFCFDR    R               REFFLD(DS5)
     A                                      COLHDG('CONFIRMATION' 'DARTS CODE')
      *
     A            CFIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            CFIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            CFITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            CFIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            CFUSER    R               REFFLD(USER)
     A            CFDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            CFTIME    R               REFFLD(TIME)
     A            CFPGM     R               REFFLD(PGM)
     A***  BEG ADD ***** 11/06/07 *****************************************
     A            CFDART    R               REFFLD(FLAG)
     A                                      COLHDG('RESOLVE' 'TO' 'DARTS')
     A***  END ADD ***** 11/06/07 *****************************************
     A***  BEG ADD ***** 05/03/10 *****************************************
     A            CFSRFL    R               REFFLD(FLAG)
     A                                      COLHDG('S/R INFO' 'PRINT W' 'AUDIT')
     A***  END ADD ***** 05/03/10 *****************************************
     A***  Beg Add ***** 10/28/20 *****************************************
     A            CFG301E   R               REFFLD(FLAG)
     A                                      COLHDG('Generate WC000301' +
     A                                            'Endorsements')
     A            CFG311E   R               REFFLD(FLAG)
     A                                      COLHDG('Generate WC000311' +
     A                                            'Endorsements')
     A            CFGASRD   R               REFFLD(FLAG)
     A                                      COLHDG('Generate Audit' +
     A                                            'Req to State Rpt Div')
     A***  End Add ***** 10/28/20 *****************************************
