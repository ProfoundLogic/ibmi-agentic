     A                                      REF(FSREFP)
     A          R PBD01                     TEXT('NETWORK BILLING TRACKING FILE-
     A                                      ')
     A            BDCODE    R               REFFLD(BRCD)
     A                                      COLHDG('Billing Code')
     A            BDTYPE    R               REFFLD(CODE)
     A                                      COLHDG('Billing Type')
     A            BDRCDT    R               REFFLD(FLAG)
     A                                      COLHDG('Billing' 'Record' 'Type')
     A            BDEFDT    R               REFFLD(DT)
     A                                      COLHDG('Effective Date')
     A            BDCPT4    R               REFFLD(CPT4)
     A                                      COLHDG('Procedure Code')
     A            BDPMOD         2A         COLHDG('Proc Code' +
     A                                      'Modifier')
     A            BD10A1    R               REFFLD(DS10)
     A                                      COLHDG('From Rev Code')
     A            BD10A2    R               REFFLD(DS10)
     A                                      COLHDG('To Rev Code')
     A            BD10A3    R               REFFLD(DS10)
     A                                      COLHDG('From Procedure Code')
     A            BD10A4    R               REFFLD(DS10)
     A                                      COLHDG('To Procedure Code')
     A            BDFLD     R               REFFLD(DS10)
     A                                      COLHDG('Field Name')
     A            BDFVAL        80A
     A                                      COLHDG('Field From Value')
     A            BDTVAL        80A
     A                                      COLHDG('Field To Value')
     A            BDDT      R               REFFLD(DT)
     A                                      COLHDG('Change Date')
     A            BDTIME    R               REFFLD(TIME)
     A                                      COLHDG('Change Time')
     A            BDUSER    R               REFFLD(USER)
     A                                      COLHDG('Change User')
     A            BDPGM     R               REFFLD(PGM)
     A                                      COLHDG('Change Program')
