     A            H0MTC     R               REFFLD(CODE)
     A                                      TEXT('MTC')
     A                                      COLHDG('MTC')
     A            H0CDN#         4A         TEXT('Change Data Elmnt/Sgmnt Nmbr')
     A                                      COLHDG('Change Data Element' +
     A                                             '/Segment Number')
     A            H0CRCD    R               REFFLD(FLAG)
     A                                      TEXT('Change Reason Code')
     A                                      COLHDG('Change Reason Code')
