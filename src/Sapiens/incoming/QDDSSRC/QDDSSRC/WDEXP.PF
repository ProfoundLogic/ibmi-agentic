     A                                      REF(WREFP)
     A*
     A          R PEX01                     TEXT('EXPERIENCE MOD TRACKING FILE')
     A            EXCO#     R               REFFLD(CO#)
     A            EXFND     R               REFFLD(FND)
     A            EXEMP#    R               REFFLD(EMP#)
     A            EXDIV     R               REFFLD(DIV)
     A            EXFYR     R               REFFLD(FYR)
     A            EXEXM1    R               REFFLD(PC32)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 1')
     A            EXEXD1    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD 1' 'EFFECT DATE')
     A            EXEXM2    R               REFFLD(PC32)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 2')
     A            EXEXD2    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD 2' 'EFFECT DATE')
     A            EXEXM3    R               REFFLD(PC32)
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 3')
     A            EXEXD3    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD 3' 'EFFECT DATE')
     A            EXNEXM    R               REFFLD(PC32)
     A                                      COLHDG('NEW' 'EXPERIENCE' -
     A                                      'MODIFIER')
     A            EXNEXD    R               REFFLD(DT)
     A                                      COLHDG('NEW' 'EXP MOD' -
     A                                      'EFFECT DATE')
     A            EXRCVD    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD' 'RECEIVED' 'DATE')
     A            EXPODT    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD' 'POST' 'DATE')
     A            EXPROM         6P 0       COLHDG('INTERNAL' 'PROMULGATION')
     A            EXCTFL    R               REFFLD(FLAG)
     A                                      COLHDG('CONTINGENT' 'MODIFIER' -
     A                                      'Y/N')
     A            EXUSER    R               REFFLD(USER)
     A            EXPGM     R               REFFLD(PGM)
     A            EXTIME    R               REFFLD(TIME)
     A            EXDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            EXIUSR    R               REFFLD(USER)
     A                                      COLHDG('CREATED' 'BY USER')
     A            EXIPGM    R               REFFLD(PGM)
     A                                      COLHDG('CREATED' 'BY PGM')
     A            EXIDT     R               REFFLD(DT)
     A                                      COLHDG('CREATED' 'DATE')
