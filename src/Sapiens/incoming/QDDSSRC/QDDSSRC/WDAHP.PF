     A**
     A*** Beg Add *** 01/31/12 **********************************************
     A                                      REF(WREFP)
     A*** End Add *** 01/31/12 **********************************************
     A          R PAH01                     TEXT('History Format')
     A*
     A            AHCO#          3P 0       COLHDG('COMPANY' 'NUMBER')
     A*
     A            AHFND          3P 0       COLHDG('GROUP' 'NUMBER')
     A*
     A            AHFYR          3P 0       COLHDG('POLICY' 'YEAR')
     A*
     A            AHCASE         7P 0       COLHDG('CASE NUMBER')
     A*
     A            AHBAFL         1A         COLHDG('BEFORE/AFTER' 'FLAG')
     A*
     A            AHLSN         30A         COLHDG('LAST NAME')
     A*
     A            AHFSN         15A         COLHDG('FIRST NAME')
     A*
     A            AHMID          1A         COLHDG('MIDDLE INITIAL')
     A*
     A            AHADR1        40A         COLHDG('ADDRESS LINE 1')
     A*
     A            AHADR2        40A         COLHDG('ADDRESS LINE 2')
     A*
     A            AHCTY         25A         COLHDG('CITY')
     A*
     A            AHST           2A         COLHDG('STATE')
     A*
     A            AHZIP          9P 0       COLHDG('ZIP')
     A*
     A            AHCTRY         3A         COLHDG('COUNTRY' 'CODE')
     A*
     A            AHADR3        40A         COLHDG('PROVINCE/POSTAL CODE')
     A*
     A            AHCKAL         1A         COLHDG('ALLOW' 'CHECK')
     A*
     A            AHPGM         10A         COLHDG('PROGRAM')
     A*
     A            AHUSER        10A         COLHDG('USER')
     A*
     A            AHDT           7S 0       COLHDG('DATE THE CHANGE' +
     A                                      'WAS MADE')
     A*
     A            AHTIME         6S 0       COLHDG('TIME THE CHANGE' +
     A                                      'WAS MADE')
     A*** Beg Add *** 01/31/12 **********************************************
     A            AHEMAD    R               REFFLD(DS60)
     A                                      COLHDG('E-MAIL ADDRESS')
     A
     A*** End Add *** 01/31/12 **********************************************
