     A****************************************************************
     A**   MICR BANK INFORMATION FILE                               **
     A**                                                            **
     A**   NOTE: When the base checks are prepared for all systems  **
     A**   (WC, PC, Etc) data should move ta a common file: i.e.    **
     A**   SMBIP.                                                   **
     A**                                                            **
     A****************************************************************
     A** REVISIONS:                                                 **
     A**  11/18/96 *** C:107 *** V2000 ***                          **
     A**           1. Version 2 format changes.                     **
     A****************************************************************
     A*
     A                                      REF(CREFP)
     A          R PBI01                     TEXT('BANK INFO FILE')
     A            BICO#     R               REFFLD(CO#)
     A            BIFND          3  0       COLHDG('FUND')
     A                                      TEXT('NOT USED IN P&C')
     A            BICKH1    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADING' 'ONE')
     A            BICKH2    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADING' 'TWO')
     A            BIAI01    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'ONE')
     A            BIAI02    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'TWO')
     A            BIAI03    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'THREE')
     A            BIAI04    R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT INFO' 'TOP +
     A                                      LEFT' 'FOUR')
     **
     *****  ON-US 19A USUALLY = ACCOUNT NUMBER *** MAY NOT PRINT ENTIRE
     **                          19 CHARACTERS
     **
     A            BIONUS        19
     A                                      COLHDG('ON-US FLD' 'UP TO 19A')
     **
     *****  TRANSIT # CONSISTING OF (TRANSIT SYMBOL + CK DIGIT + BANK# +
     **                              ROUTING# + TRANSIT SYMBOL) (11 A)
     **
     A            BICKDG         1
     A                                      COLHDG('TRANSIT' 'CHECK DIGIT')
     A            BIBNK#         4
     A                                      COLHDG('TRANSIT' 'BANK #')
     A            BITRNS         4
     A                                      COLHDG('TRANSIT' 'ROUTING #')
     **
     *****  AUXILLARY ON-US (DEFINED BY BANK) UPTO 21 A *** CHECK # ***
     **
     A            BIAXOU    R   21          REFFLD(ADR2)
     A                                      COLHDG( 'AUX' 'ON-US FLD' +
     A                                      'UPTO 21A(CHK#)')
     A            BISTAT    R               REFFLD(STAT)
     A            BIUSER    R               REFFLD(USER)
     A            BIPGM     R               REFFLD(PGM)
     A            BITIME    R               REFFLD(TIME)
     A            BIDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            BI#CF          2  0       COLHDG('# OF FILE COPIES')
     A            BIRTUP         7          COLHDG('ROUTING ENTRY UPPER')
     A            BIRTLW         7          COLHDG('ROUTING ENRTY LOWER')
     A            BITRST    R               REFFLD(FLAG)
     A                                      COLHDG('TRUST?' 'Y/N')
     A            BILOGO    R               REFFLD(FLAG)
     A                                      COLHDG('LOGO?' 'Y/N')
     A            BI$LMT    R               REFFLD(A90)
     A                                      COLHDG('$LIMIT' 'W/O SIGN')
     A*
     A*** ADDITIONAL FIELDS *** MAY BE USED FOR FUTURE PROCESSING
     A******* 1 ALPHA FIELDS
     A            BI1A1     R               REFFLD(FLAG)
     A            BI1A2     R               REFFLD(FLAG)
     A            BI1A3     R               REFFLD(FLAG)
     A            BI1A4     R               REFFLD(FLAG)
     A            BI1A5     R               REFFLD(FLAG)
     A******* 10 ALPHA FIELDS
     A            BI10A1        10A
     A                                      COLHDG('SIG 1 STRING')
     A            BI10A2        10A
     A                                      COLHDG('SIG 2 STRING')
     A            BI10A3        10A         COLHDG('10A FIELD')
     A******* 5.0 NUMERIC FIELDS
     A            BI50N1         5  0
     A                                      COLHDG('SIG 1 SUBSCRIPT')
     A            BI50N2         5  0
     A                                      COLHDG('SIG 2 SUBSCRIPT')
     A            BI50N3         5  0       COLHDG('5/0 NUMERIC FIELD')
     A******* 9.2 NUMERIC FIELDS
     A            BI92N1    R               REFFLD(A92)
     A            BI92N2    R               REFFLD(A92)
     A            BI92N3    R               REFFLD(A92)
     A            BI92N4    R               REFFLD(A92)
     A            BI92N5    R               REFFLD(A92)
     A*
      *   Check Header Field 1 - 3 *** used at top/center  of Check
     A            BIHDR1    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADER' 'ONE')
     A            BIHDR2    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADER' 'TWO')
     A            BIHDR3    R               REFFLD(DS40)
     A                                      COLHDG('CHECK HEADER' '3')
     A*
      *   Check Footer Field 1 - 8 *** used at Bottom/Center of Check
     A            BIFTR1        70A
     A                                      COLHDG('CHECK FOOTER' 'ONE')
     A            BIFTR2        70A
     A                                      COLHDG('CHECK FOOTER' '2')
     A            BIFTR3        70A
     A                                      COLHDG('CHECK FOOTER' '3')
     A            BIFTR4        70A
     A                                      COLHDG('CHECK FOOTER' '4')
     A            BIFTR5        70A
     A                                      COLHDG('CHECK FOOTER' '5')
     A            BIFTR6        70A
     A                                      COLHDG('CHECK FOOTER' '6')
     A            BIFTR7        70A
     A                                      COLHDG('CHECK FOOTER' '7')
     A            BIFTR8        70A
     A                                      COLHDG('CHECK FOOTER' '8')
     A            BIACCT        20A
     A                                      COLHDG('FUND AUX' 'X-REF' +
     A                                      'BANK ACCT #')
     A            BISIG1    R               REFFLD(CTY)
     A                                      COLHDG('SIGNATURE MACRO' '1')
     A            BISIG2    R               REFFLD(CTY)
     A                                      COLHDG('SIGNATURE MACRO' '2')
     A            BIOVL          4          COLHDG('MACRO ID FOR OVERLAY')
     A            BICTYP         2          COLHDG('TYPE OF CK PROCESS' +
     A                                      'CO-COMP, PC-P&C')
     A            BICPGM        10          COLHDG('PGM NAME FOR' +
     A                                      'CHK OUTPUT')
     A            BICKH3        40          COLHDG('CHECK HEAD 3')
     A            BICKH4        40          COLHDG('CHECK HEAD 4')
     A***
