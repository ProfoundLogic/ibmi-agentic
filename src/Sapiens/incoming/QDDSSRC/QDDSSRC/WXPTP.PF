     A* 10/19/07  C:191  Project: WC1584                               *
     A*                  Created.                                      *
     A*                                                                *
     A*****************************************************************
     A                                      REF(WREFP)
     A*                                                                *
     A          R PPT01                     TEXT('EDI EXTRACT - R22 - PAYMENTS')
     A            PTCO#          3P 0       COLHDG('Company#')
     A            PTFND          3P 0       COLHDG('Fund')
     A            PTFYR          3P 0       COLHDG('Policy Year')
     A            PTCASE         7P 0       COLHDG('Case')
     A            PTPRCD         3A         COLHDG('Payment Reason Code')
     A            PTPAYE        40A         COLHDG('Payee')
     A            PTAMT          9P 2       COLHDG('Payment amount')
     A            PTSTDT         7P 0       COLHDG('Payment Covers' +
     A                                      'Period Start Date')
     A            PTENDT         7P 0       COLHDG('Payment Covers' +
     A                                      'Period Through Date')
     A            PTISDT         7P 0       COLHDG('Payment Issue'  +
     A                                      'Date')
     A            PTFILL         7P 0       COLHDG('Filler -' +
     A                                      'Future Defined Usage')
     A            PTUSER        10A         COLHDG('User')
     A            PTPGM         10A         COLHDG('Program')
     A            PTDT           7P 0       COLHDG('Date')
     A            PTTIME         6P 0       COLHDG('Time')
     A***
     A            PTEXDT    R               REFFLD(DT)
     A                                      COLHDG('EXTRACT DATE')
     A            PTTSET    R    3A         REFFLD(CODE)
     A                                      TEXT('TRANSACTION SET ID')
     A            PTMTC     R               REFFLD(CODE)
     A                                      TEXT('MAINT TYPE CODE')
     A*
     A***    Jurisdiction ST
     A            PTJRST    R               REFFLD(CODE)
     A                                      TEXT('JURISDICTION')
     A*  CLAIM
     A            PTACLC    R   25A         REFFLD(DS20)
     A                                      COLHDG('ADMIN' 'CLAIM' '#')
     A**********  AJTDT     R    8S 0       REFFLD(DT)
     A**********                            TEXT('MAINT TYPE CODE DATE')
