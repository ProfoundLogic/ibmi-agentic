     A** WORKERS' COMP EFT CENTRAL FILE
     A*
     A                                      REF(WREFP)
     A          R PEF01                     TEXT('EFT CENTRAL FILE')
     A            EFCO#     R               REFFLD(CO#)
     A            EFTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE OF PAYEE')
     A            EFACCT        20A         COLHDG('COMPANY BANK ACC')
     A            EFIDST        10A         COLHDG('IMMEDIATE' 'DESTINATION')
     A            EFIORG        10A         COLHDG('IMMEDIATE' 'ORIGIN')
     A            EFDEST        23A         COLHDG('HEADER' 'DESTINATION NAME')
     A            EFCNAM        23A         COLHDG('HEADER' 'COMPANY NAME')
     A            EFREF          8A         COLHDG('REFERENCE CODE')
     A            EFSERV         3A         COLHDG('SERVICE CLASS')
     A            EFBNAM        16A         COLHDG('BATCH' 'COMPANY NAME')
     A            EFCDTA        20A         COLHDG('BATCH' 'DISCRETIONARY DATA')
     A            EFCID         10A         COLHDG('BATCH' 'COMPANY ID')
     A            EFEDES        10A         COLHDG('BATCH ENTRY' 'DESCRIPTION')
     A            EFCDDT         6S 0       COLHDG('COMPANY' 'DESCRIPTIVE DATE')
     A            EFEEDT         6S 0       COLHDG('EFFECTIVE' 'ENTRY DATE')
     A            EFBDFI         8A         COLHDG('BATCH DFI')
     A            EFTRCD         2A         COLHDG('TRANSACTION CODE')
     A            EFDFI          8A         COLHDG('DETAIL BANK DFI')
     A            EFCKDG         1A         COLHDG('DETAIL BANK' 'CHECK DIGIT')
     A            EFDACT        17A         COLHDG('DETAIL BANK' 'ACCOUNT#')
     A            EFAMT         10S 2       COLHDG('DETAIL AMOUNT')
     A            EFID#         15A         COLHDG('DETAIL ID#')
     A            EFINAM        22A         COLHDG('NAME OF' 'RECIEVER')
     A            EFTRC#        15S         COLHDG('TRACE NUMBER')
     A            EFARIN         1A         COLHDG('ADDENDA' 'RECORD INDICATOR')
     A            EFPRIN        80A         COLHDG('ADDENDA' 'PAYMENT INFO')
     A            EFTIME    R               REFFLD(TIME)
     A            EFDT      R               REFFLD(DT)
     A            EFPGM     R               REFFLD(PGM)
     A            EFUSER    R               REFFLD(USER)
