     A*****************************************************************
     A* SCRIPTURA DATA WORK FILE FOR ESTIMATED/AUDITED BILL PAYROLLS  *
     A*****************************************************************
     A*                                                               *
     A*  PROJECT:  SY371        PROGRAMMER:  C:65                     *
     A*  CREATED:  01/29/16 - REVAMPED 04/22/21                       *
     A*  DESCRIPTION:  THIS IS THE WORK FILE TO HOLD THE PAYROLL DATA *
     A*                FOR BILLS - ESTIMATED, AUDITED, QUOTE, ETC.    *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:
     A*
     A* 06/17/24 C:344 PROJECT: WC2952
     A*                Expand rate field from 7.2 to 8.3 zoned.
     A*
     A* 04/09/24 C:291 Project: WC2670
     A*                Change Additional Load field size to 11,2
     A*
     A* 08/31/23 C:291 Project: WC2670
     A*                Add BLMPRMSN.
     A*
     A* 05/02/22 C:136 Project: WC2670
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PBL011                    TEXT('SCRIPTURA PAYROLL WORKFILE')
     A            BLXML         60A         COLHDG('XML FILE NAME')
     A            BLCO#     R     S         REFFLD(CO#)
     A            BLFND     R     S         REFFLD(FND)
     A            BLEMP#    R     S         REFFLD(EMP#)
     A            BLDIV     R     S         REFFLD(DIV)
     A            BLFYR     R     S         REFFLD(FYR)
     A            BLTYPE        50A         COLHDG('TYPE OF BILL')
     A            BLKEY          9S 0       COLHDG('INCREMENTING' 'KEY')
     A            BLPAYDIV  R     S         REFFLD(DIV)
     A            BLCLAS    R     S         REFFLD(CLAS)
     A                                      COLHDG('CLASS CODE')
     A            BLSPEC    R               REFFLD(FLAG)
     A                                      COLHDG('SPECIAL DESIGNATION')
     A            BLEXT     R               REFFLD(CLA2)
     A                                      COLHDG('CLASS EXTENSION')
     A            BLDESC    R               REFFLD(DS00)
     A                                      COLHDG('CLASS DESCRIPTION')
      *** Beg Chg ***** 06/17/24 **********************************
     A*********** BLRATE    R     S         REFFLD(A72)
     A            BLRATE         8S 3
      *** End Chg ***** 06/17/24 **********************************
     A                                      COLHDG('PAYROLL RATE')
     A            BLNETRT        9S 4       COLHDG('NET PAYROLL RATE')
     A            BLPAY     R     S         REFFLD(A112)
     A                                      COLHDG('ESTM ANNUAL PAYROLL')
     A            BLPREM    R     S         REFFLD(A90)
     A                                      COLHDG('MANUAL PREMIUM')
      *** Beg Chg ***** 04/09/24 **********************************
     A***         BLADDLOAD R     S         REFFLD(A72)
     A            BLADDLOAD R     S         REFFLD(A112)
      *** End Chg ***** 04/09/24 **********************************
     A                                      COLHDG('ADDITIONAL LOAD')
     A            BLCLFRDT       8S 0       COLHDG('CLASS CODE FROM DATE')
     A            BLCLTODT       8S 0       COLHDG('CLASS CODE TO DATE')
     A            BLRATEST  R               REFFLD(DS10)
     A                                      COLHDG('RATING STATE')
     A            BLCLEFDT       8S 0       COLHDG('CLASS CODE EFF DATE')
     A            BLUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            BLPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            BLTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            BLDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
      *** beg add ***** 05/02/22 ***************************
     A            BLADDTXT     100A         COLHDG('Additional Load Text')
      *** end add ***** 05/02/22 ***************************
      *** Beg add ***** 08/31/23 ***************************
     A            BLMPRMSN       1A         COLHDG('Manual Prm Sign')
      *** End add ***** 08/31/23 ***************************
