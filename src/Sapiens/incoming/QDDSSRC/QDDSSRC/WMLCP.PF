     A                                      REF(WREFP)
     A          R PLC01                     TEXT('LOSS CONTROL TRACKING FILE')
     A            LCCO#     R               REFFLD(CO#)
     A            LCFND     R               REFFLD(FND)
     A            LCEMP#    R               REFFLD(EMP#)
     A            LCDIV     R               REFFLD(DIV)
     A            LCVSDT    R               REFFLD(DT)
     A                                      COLHDG('VISIT DATE')
     A            LCSTF     R               REFFLD(STAF)
     A                                      COLHDG('STAFF MEMBER')
     A            LCCOM1    R               REFFLD(DS40)
     A                                      COLHDG('COMMENT 1')
     A            LCCOM2    R               REFFLD(DS40)
     A                                      COLHDG('COMMENT 2')
     A            LCCOM3    R               REFFLD(DS40)
     A                                      COLHDG('COMMENT 3')
     A*
     A            LCIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            LCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            LCITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            LCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            LCUSER    R               REFFLD(USER)
     A            LCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            LCTIME    R               REFFLD(TIME)
     A            LCPGM     R               REFFLD(PGM)
      *
     A**** BEG ADD ***** 10/26/00 *************************************
      *
     A            LCOPER    R               REFFLD(A50)
