     A                                      WINDOW(10 14 13 48)
     A                                      OVERLAY
     A                                      CF02
     A                                  1  1'C0060F'
     A                                  1 18'DELETE VEHICLE'
     A                                  1 43'WIN05A'
     A                                  3  4'CONFIRM DELETE OF FOLLOWING ITEM:'
     A                                  3 40'(Y/N)'
     A            WNFLAG    R     A  B  3 38REFFLD(FLAG)
     A                                  5 10'Item Number.:'
     A            WNITM#    R     S  O  5 24REFFLD(ITM#)
     A                                  6 10'Vehicle Year:'
     A            WNYR      R     S  O  6 24REFFLD(YR)
     A                                  7 10'        Make:'
     A            WNMAKE    R     A  O  7 24REFFLD(MAKE)
     A                                  8 10'       Model:'
     A            WNMODL    R     A  O  8 24REFFLD(MODL)
     A                                  9 10'   Body Type:'
     A            WNBODY    R     A  O  9 24REFFLD(BODY)
     A                                 10 10'  VIN Number:'
     A            WNVIN     R     A  O 10 24REFFLD(VIN)
     A                                 12  8'F1=Exit      '
     A                                      COLOR(BLU)
     A                                 12 27'F2=Cancel      '
     A                                      COLOR(BLU)
     A*----------------------------------------------------------------
