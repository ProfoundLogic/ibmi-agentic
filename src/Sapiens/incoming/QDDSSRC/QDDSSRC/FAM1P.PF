     A                                      REF(FSREFP)
     A          R PM101                     TEXT('EPS Claim Header')
     A            M1RID#    R               REFFLD(FLAG)
     A                                      COLHDG('Record Identifier')
     A            M1PID#    R               REFFLD(DS10)
     A                                      COLHDG('Processor Number')
     A            M1BID#    R               REFFLD(DS5)
     A                                      COLHDG('Batch Number')
     A            M1PHAR    R               REFFLD(DS12)
     A                                      COLHDG('Pharmacy Number')
     A            M1FSN     R               REFFLD(DS12)
     A                                      COLHDG('Patient First Name')
     A            M1LSN     R               REFFLD(DS15)
     A                                      COLHDG('Patient Last Name')
     A            M1DOB          8A
     A                                      COLHDG('Date of Birth')
     A            M1SEX     R               REFFLD(FLAG)
     A                                      COLHDG('Sex Code')
     A*                                     '0' = Not Specified
     A*                                     '1' = Male
     A*                                     '2' = Female
     A            M1TDOI    R               REFFLD(DS6)
     A                                      COLHDG('ID Assigned to' +
     A                                      'Cardholder - DOI')
     A            M1TSS#    R               REFFLD(SS#)
     A                                      COLHDG('ID Assigned to' +
     A                                      'Cardholder - SS#')
     A            M1INV#    R               REFFLD(DS10)
     A                                      COLHDG('Invoice #')
     A            M1CVDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Convert Date')
     A            M1NAME    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Document ID')
     A            M1TRN#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) Transaction #')
     A            M1PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A            M1PRDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Process' +
     A                                            'Date')
     A            M1CO#     R               REFFLD(CO#)
     A                                      COLHDG('(PDS) Company #')
     A            M1SUB#    R               REFFLD(SUB#)
     A                                      COLHDG('(PDS) Subscriber #')
     A            M1FND     R               REFFLD(FND)
     A                                      COLHDG('(PDS) Group #')
     A            M1FYR     R               REFFLD(FYR)
     A                                      COLHDG('(PDS) Year')
     A            M1CASE    R               REFFLD(CASE)
     A                                      COLHDG('(PDS) Case #')
     A            M1SS#     R               REFFLD(SS#)
     A                                      COLHDG('(PDS) SS#')
     A            M1ACDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) ACDT')
     A            M1FEIN    R               REFFLD(FEIN)
     A                                      COLHDG('(PDS) FEIN')
     A            M1MOD     R               REFFLD(MOD)
     A                                      COLHDG('(PDS) Provider Mod')
     A            M1EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB #')
     A            M1DLUS    R               REFFLD(USER)
     A                                      COLHDG('(PDS) Delete User')
     A            M1DLPG    R               REFFLD(PGM)
     A                                      COLHDG('(PDS) Delete Pgm')
     A            M1DLTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Delete Time')
     A            M1DLDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Delete Date')
     A            M1DLRE    R               REFFLD(DS70)
     A                                      COLHDG('(PDS) Delete Reason')
     A*** BEG ADD 07/01/05 ********************************************
     A            M1PLIC    R               REFFLD(DS10)
     A                                      COLHDG('Prescriber' 'License #')
     A*** END ADD 07/01/05 ********************************************
