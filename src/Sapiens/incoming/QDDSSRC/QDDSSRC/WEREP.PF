     A*
     A*  EDI Reduced Earnings File
     A                                      REF(WREFP)
     A          R PRE01                     TEXT('Reduced Earnings')
     A            RECO#     R               REFFLD(CO#)
     A            REFND     R               REFFLD(FND)
     A            REFYR     R               REFFLD(FYR)
     A            RECASE    R               REFFLD(CASE)
     A            RESEQ#    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            RECODE         3          TEXT('Reduced earnings code')
     A            REAAMT    R               REFFLD(A92)
     A                                      TEXT('Actual reduced earnings')
     A            REDAMT    R               REFFLD(A92)
     A                                      TEXT('Deemed reduced earnings')
     A            REWK#     R               REFFLD(A30)
     A                                      TEXT('Reduced earnings week #')
     A*
     A            RESTAT    R               REFFLD(STAT)
     A            REIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'CREATION' 'USER')
     A            REIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'CREATION' 'DATE')
     A            REITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'CREATION' 'TIME')
     A            REIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'CREATION' 'PGM')
     A            REUSER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            REDT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            RETIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
     A            REPGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
