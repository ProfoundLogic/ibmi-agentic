     A                                      REF(WREFP)
     A          R PQS01                     TEXT('Quote Status Table File')
     A            QSCO#     R               REFFLD(CO#)
     A            QSKEY     R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            QSQTE     R               REFFLD(FLAG)
     A                                      COLHDG('QUOTE' 'FLAG')
     A            QSDESC    R               REFFLD(DS30)
     A            QSUSED    R               REFFLD(FLAG)
     A                                      COLHDG('USE' 'DESC' 'FROM')
     A            QSAARH    R               REFFLD(DS40)
     A                                      COLHDG('AGENT ACTIVITY' -
     A                                             'REPORT HEADING')
     A            QSAARO         3S 0
     A                                      COLHDG('AGENT ACTIVITY' -
     A                                             'REPORT ORDER')
     A            QSAARS         3S 0
     A                                      COLHDG('AGENT ACTIVITY' -
     A                                             'REPORT SELECTION' -
     A                                             'ORDER')
     A            QSSTAT    R               REFFLD(STAT)
     A            QSUSER    R               REFFLD(USER)
     A            QSPGM     R               REFFLD(PGM)
     A            QSTIME    R               REFFLD(TIME)
     A            QSDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            QSIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            QSIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            QSITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            QSIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            QSRENEW   R               REFFLD(FLAG)
     A                                      COLHDG('Renewal')
     A            QSLOCKING R               REFFLD(FLAG)
     A                                      COLHDG('Locking')
