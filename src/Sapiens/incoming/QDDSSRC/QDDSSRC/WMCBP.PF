     A                                      COLHDG('CO#')
     A            CBIDST        10  0       COLHDG('IMMED DEST #')
     A            CBIORG        10  0       COLHDG('IMMED ORIGIN #')
     A            CBBNAM        23A         COLHDG('DESTINATION NAME')
     A            CBCONM        23A         COLHDG('ORIGIN NAME')
     A            CBRFCD         8A         COLHDG('REF CODE')
     A            CBORDI         8  0       COLHDG('ORIG DFI ID')
     A            CBARCD         2A         COLHDG('DFLT A/R' 'PAY CODE')
     A            CBSYCD         2A         COLHDG('DFLT A/R BATCH' -
     A                                      ' SYS CODE')
     A            CBSVCL         3  0       COLHDG('SERVICE CLASS CODE')
     A            CBUSER    R               REFFLD(USER)
     A            CBPGM     R               REFFLD(PGM)
     A            CBTIME    R               REFFLD(TIME)
     A            CBDT      R               REFFLD(DT)
     A            CBIUSR    R               REFFLD(USER)
     A            CBIPGM    R               REFFLD(PGM)
     A            CBITIM    R               REFFLD(TIME)
     A            CBIDT     R               REFFLD(DT)
