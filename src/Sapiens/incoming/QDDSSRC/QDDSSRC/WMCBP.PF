     A            CBECAR         2A         TEXT('Exp Constant, Pay Code')
     A            CBIFAR         2A         TEXT('Installment Fee, Pay Code')
     A            CBMFAR         2A         TEXT('Membership Fee, Pay Code')
     A            CBSFAR         2A         TEXT('Safety Fee, Pay Code')
     A            CBTXAR         2A         TEXT('Tax, Pay Code')
     A            CB1AAR         2A         TEXT('1st Assessment, Pay Code')
     A            CB2AAR         2A         TEXT('2nd Assessment, Pay Code')
     A            CB3AAR         2A         TEXT('3rd Assessment, Pay Code')
