     A*                                                               *
     A*****************************************************************
     A* SYSTEM DOCUMENTS AND LETTERS SETUP FILE                       *
     A*****************************************************************
     A*                                                               *
     A*  PROJECT:  SY251        PROGRAMMER:  C:65                     *
     A*  CREATED:  03/12/15                                           *
     A*  DESCRIPTION:  THIS IS THE NEW SETUP FILE FOR DOCUMENTS,      *
     A*                FORMERLY KNOWN AS DEPARTMENT LETTERS. THE      *
     A*                CATEGORY WILL BE USED TO SPECIFY IF THE        *
     A*                DOCUMENT WILL BE FOR POLICIES, CLAIMS, ETC.    *
     A*                THE SUB CATEGORY FIELD WILL ALLOW THE LETTERS  *
     A*                TO BE GROUPED WITHIN EACH CATEGORY.  THIS      *
     A*                SETUP WILL POINT TO SCRIPTURA TEMPLATE DOCS.   *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 01/16/24 C:340 PROJECT: 153WAD                                *
     A*                Add flag to copy when not emailed.             *
     A*                                                               *
     A* 04/23/21  C:33  Project: WC2278                               *
     A*                 Add default email fields.                     *
     A*                                                               *
     A* 05/08/18 C:65  PROJECT: SY395                                 *
     A*                ADD PATH AND TEMPALTE FIELDS FOR SCRIPTURA     *
     A*                FORMS (DIFFERENT FROM NON-INTERACTIVE OR       *
     A*                LIVE DOC).                                     *
     A*                                                               *
     A* 11/16/17 C:65  PROJECT: 102WHK                                *
     A*                ADD SCHEMA TYPE FOR DOCUMENTS.                 *
     A*                                                               *
     A* 02/25/16 C:65  PROJECT: SY251                                 *
     A*                ADD FLAG FOR AUTO-LETTER ONLY DOCUMENTS.       *
     A*                                                               *
     A* 10/12/15 C:65  PROJECT: SY251                                 *
     A*                ADD PATH FIELD FOR NON-INTERACTIVE DOCUMENTS   *
     A*                TO HOLD THE FOLDER THE TEMPLATE IS STORED IN.  *
     A*                                                               *
     A* 09/14/15 C:65  PROJECT: SY251                                 *
     A*                ADD TURNAROUND FLAG AND ISERIES LIBRARY FIELDS *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SREFP)
     A          R PDL01                     TEXT('DOCUMENTS/LETTERS FILE')
     A            DLCO#     R     S         REFFLD(CO#)
     A            DLCAT     R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT CATEGORY')
     A            DLSUBC    R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT' 'SUB CATEGORY')
     A            DLDCID        60A         COLHDG('DOCUMENT NAME/ID')
     A            DLDESC       250A         COLHDG('DOCUMENT DESCRIPTION')
     A            DLINTR    R               REFFLD(FLAG)
     A                                      COLHDG('INTERACTIVE DOCUMENT')
     A            DLINID        60A         COLHDG('INTERACTIVE DOC ID')
     A            DLCOPY    R     S         REFFLD(A30)
     A                                      COLHDG('# OF COPIES')
     A            DLRMCD    R               REFFLD(RMCD)
     A                                      COLHDG('DOCUMENT REMARK CODE')
     A            DLPRIN    R               REFFLD(KEY)
     A                                      COLHDG('DEFAULT' 'PRINTER NAME')
     A            DLSUBJ       250A         COLHDG('DEFAULT' 'EMAIL SUBJECT')
     A            DLBODY       500A         COLHDG('DEFAULT' 'EMAIL BODY')
     A            DLUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            DLPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            DLTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            DLDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            DLIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            DLIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            DLITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            DLIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            DLSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            DLHARD    R               REFFLD(FLAG)
     A                                      COLHDG('ALLOW HARDCOPY' 'CHANGES')
     A            DLMAIL    R               REFFLD(FLAG)
     A                                      COLHDG('ALLOW EMAIL' 'CHANGES')
     A            DLLANG        40A         COLHDG('DOCUMENT LANGUAGE')
     A            DLTRAY        50A         COLHDG('DEFAULT' 'PRINTER TRAY')
     A*** BEGIN ADD ***  09/14/15  ************************************************
     A            DLTURN    R               REFFLD(FLAG)
     A                                      COLHDG('TURNAROUND' 'FLAG')
     A*** THE DLQLIB FIELD IS NOT NEEDED/USED.  LIBRARY IS RETRIEVED FROM PRINTER SETUP
     A            DLQLIB    R               REFFLD(KEY)
     A                                      COLHDG('OUTQUEUE' 'LIBRARY')
     A*** END ADD *****  09/14/15  ************************************************
     A*** BEGIN ADD ***  10/12/15  ************************************************
     A            DLPATH       250A         COLHDG('NON-INTERACTIVE' 'DOC PATH')
     A*** END ADD *****  10/12/15  ************************************************
     A*** BEGIN ADD ***  02/25/16  ************************************************
     A            DLAUTO    R               REFFLD(FLAG)
     A                                      COLHDG('AUTO LETTER ONLY' 'FLAG')
     A*** END ADD *****  02/25/16  ************************************************
     A*** BEGIN ADD ***  11/16/17  ************************************************
     A            DLTYPE       100A         COLHDG('SCHEMA TYPE')
     A*** END ADD *****  11/16/17  ************************************************
     A*** BEGIN ADD ***  05/08/18  ************************************************
     A            DLFORMT       60A         COLHDG('FORM' 'TEMPLATE NAME/ID')
     A            DLFORMP      250A         COLHDG('FORM' 'DOCUMENT PATH')
     A*** END ADD *****  05/08/18  ************************************************
     A***  Begin Add  ***  04/23/21  ********************************
     A            DLEMLCLMT R               REFFLD(FLAG)
     A                                      COLHDG('Email' 'To' 'Claimaint')
     A            DLEMLUSRO R               REFFLD(FLAG)
     A                                      COLHDG('Email' 'User' 'Overrride')
     A            DLEMLSUB     100          COLHDG('Email Subject')
     A            DLEMLBODY  16000          COLHDG('Email Body')
     A***  End   Add  ***  04/23/21  ********************************
     A***  Beg Add  ***  01/16/24  *** 153WAD ***********************
     A            DLCOPYE        1A         COLHDG('Copy if not Emailed')
     A***  End Add  ***  01/16/24  *** 153WAD ***********************
