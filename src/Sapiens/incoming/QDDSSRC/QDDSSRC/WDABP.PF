     A** WORKERS' COMP AGENCY BILLING DETAIL FILE
     A**
     A                                      REF(WREFP)
     A          R PAB01                     TEXT('AGENCY BILLING DETAIL FILE')
     A            ABCO#     R               REFFLD(CO#)
     A            ABAGT#    R               REFFLD(AGT#)
     A            ABPROD    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER')
     A            ABSTDT    R               REFFLD(RMY5)
     A                                      COLHDG('STATEMENT' 'YEAR/MONTH')
     A            ABDUE     R               REFFLD(DT)
     A                                      COLHDG('DUE DATE')
     A            ABFND     R               REFFLD(FND)
     A            ABEMP#    R               REFFLD(EMP#)
     A            ABDIV     R               REFFLD(DIV)
     A            ABFYR     R               REFFLD(FYR)
     A            ABARTY    R               REFFLD(FLAG)
     A                                      COLHDG('A/R TYPE')
     A            ABARCD    R               REFFLD(CODE)
     A                                      COLHDG('A/R TYPE CODE')
     A            ABDESC    R               REFFLD(DS30)
     A                                      COLHDG('A/R DESCRIPTION')
     A            ABPODT    R               REFFLD(DT)
     A                                      COLHDG('A/R POSTING DATE')
     A            ABTRDT    R               REFFLD(DT)
     A                                      COLHDG('A/R TRANSACTION DATE')
     A            ABCHK#    R               REFFLD(CHK#)
     A            ABAMT     R               REFFLD(A112)
     A                                      COLHDG('A/R AMOUNT')
     A            ABRATE    R               REFFLD(A52)
     A                                      COLHDG('COMMISSION RATE')
     A            ABCOMM    R               REFFLD(A112)
     A                                      COLHDG('COMMISSION AMOUNT')
     A            ABNET     R               REFFLD(A112)
     A                                      COLHDG('NET AMOUNT')
     A            ABMADJ    R               REFFLD(FLAG)
     A                                      COLHDG('MANUAL' 'ENTRY' '(Y/ )')
     A            ABRST     R               REFFLD(ST)
     A                                      COLHDG('RATING' 'STATE')
     A            ABCHAP    R               REFFLD(A30)
     A                                      COLHDG('CHAPTER')
     A            ABOPEN    R               REFFLD(FLAG)
     A                                      COLHDG('OPEN' 'ITEM' '(Y/ )')
     A            ABCOM1    R               REFFLD(DS60)
     A                                      COLHDG('COMMENTS')
     A            ABSTAT    R               REFFLD(STAT)
     A            ABUSER    R               REFFLD(USER)
     A            ABPGM     R               REFFLD(PGM)
     A            ABTIME    R               REFFLD(TIME)
     A            ABDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ABIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ABIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            ABITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            ABIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            ABFEIN    R               REFFLD(FEIN)
     A            ABMOD     R               REFFLD(MOD)
