     A*  AGENT LOSS RATIO REPORT WORKFILE
     A*****************************************************************
     A*  DESCRIPTION:                                                 *
     A*        This file will contain the information from the last   *
     A*        Agent Loss Ratio Report run.                           *
     A*                                                               *
     A*  PROGRAMMER: C:90                                             *
     A*  CREATED:    04/16/02    PROJECT: WC577                       *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A*                                                               *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A
     A          R PAL01                     TEXT('AGENT LOSS RATIO WORKFILE')
     A            ALCO#          3S 0       COLHDG('Company#')
     A            ALCNAM        40A         COLHDG('Company Name')
     A            ALFND          3S 0       COLHDG('Group')
     A            ALFNAM        40A         COLHDG('Group Name')
     A            ALAGT#         5S 0       COLHDG('Agent')
     A            ALANAM        40A         COLHDG('Agent Name')
     A            ALACH#         5S 0       COLHDG('Agent Chapter #')
     A            ALACHD        40A         COLHDG('Agent Chapter Desc')
     A            ALAAD1        40A         COLHDG('Agent Address 1')
     A            ALACSZ        40A         COLHDG('Agent City/State/Zip')
     A            ALEMP#         9S 0       COLHDG('Employer')
     A            ALDIV          5S 0       COLHDG('Division')
     A            ALENAM        40A         COLHDG('Employer Name')
     A            ALECH#         5S 0       COLHDG('Employer Chapter #')
     A            ALECHD        40A         COLHDG('Employer' 'Chapter Desc')
     A            ALPROD         5S 0       COLHDG('Producer #')
     A            ALPNAM        40A         COLHDG('Producer Name')
     A            ALFYR          3S 0       COLHDG('Policy Year')
     A            ALPFDT         8S 0       COLHDG('Policy From Date')
     A            ALPTDT         8S 0       COLHDG('Policy To Date')
     A            ALCXDT         8S 0       COLHDG('Cancel Date')
     A            ALPRTD        11S 2       COLHDG('Premium to Date')
     A            ALCLMS         5S 0       COLHDG('Claims')
     A            ALRESV        11S 2       COLHDG('Reserves')
     A            ALPAID        11S 2       COLHDG('Paid')
     A            ALINCR        11S 2       COLHDG('Incurred')
     A            ALLOSR         7S 2       COLHDG('Loss Ratio')
     A            ALFRQR         7S 2       COLHDG('Freq. Ratio')
     A            ALDATE         8S 0       COLHDG('Date')
     A            ALTIME         6S 0       COLHDG('Time')
     A            ALPGM         10A         COLHDG('Program name')
     A            ALUSER        10A         COLHDG('User name')
