     A                                      REF(SREFP)
     A          R POR01                     TEXT('OUTPUT ROUTING FILE')
     A            ORPNAM    R               REFFLD(PGM)
     A                                      COLHDG('OUTPUT PROGRAM' 'NAME')
     A            ORFIL#    R               REFFLD(FLAG) TEXT('FILE NUMBER')
     A                                      COLHDG('FILE NUMBER')
     A            OROUTQ    R               REFFLD(OUTQ)
     A                                      COLHDG('ROUTING OUTQUEUE')
     A            ORCOPY    R               REFFLD(COPY)
     A            ORTITL    R               REFFLD(DS60)
     A                                      COLHDG('REPORT TITLE')
     A            ORSAVE    R               REFFLD(SAVE)
     A                                      COLHDG('SAVE RPT')
     A            ORHOLD    R               REFFLD(HOLD)
     A                                      COLHDG('HOLD RPT')
     A            ORFORM    R               REFFLD(FORM)
     A            ORDIS1    R               REFFLD(DISI)
     A            ORDIS2    R               REFFLD(DISI)
     A            ORDIS3    R               REFFLD(DISI)
     A            ORDIS4    R               REFFLD(DISI)
     A            ORSTAT    R               REFFLD(STAT)
     A            ORUSER    R               REFFLD(USER)
     A            ORPGM     R               REFFLD(PGM)
     A            ORTIME    R               REFFLD(TIME)
     A            ORDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OROFLD       560          COLHDG(' OVERRIDE CMD')
