     A                                      REF(WREFP)
     A          R PLD01                     TEXT('ADD ENT/LOC DETAIL FILE')
     A
     A            LDCO#     R               REFFLD(CO#)
     A            LDFND     R               REFFLD(FND)
     A            LDEMP#    R               REFFLD(EMP#)
     A            LDDIV     R               REFFLD(DIV)
     A            LDELTP    R               REFFLD(FLAG)
     A                                      COLHDG('ENT/LOC FLAG')
     A            LDELID    R               REFFLD(CTGY)
     A                                      COLHDG('LOCATION ID#')
     A            LDFYR     R               REFFLD(FYR)
     A            LDEMPY    R               REFFLD(A70)
     A                                      COLHDG('NUMBER OF' 'EMPLOYEES')
      *  Maintenance fields
     A            LDUSER    R               REFFLD(USER)
     A            LDPGM     R               REFFLD(PGM)
     A            LDTIME    R               REFFLD(TIME)
     A            LDDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            LDIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            LDIPGM    R               REFFLD(USER)
     A                                      COLHDG('INITIAL PROGRAM')
     A            LDITM     R               REFFLD(DT)
     A                                      COLHDG('INITIAL TIME')
     A            LDIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            LDTYPB    R               REFFLD(DS3)
     A                                      TEXT('TYPE OF BUILDING CODE')
     A                                      COLHDG('TYPE OF' 'BLDG CD')
     A            LDTPYR        13S 2       TEXT('TOTAL PAYROLL AMOUNT')
     A                                      COLHDG('TOTAL PAYROLL' 'AMOUNT')
     A            LDM#EM         7S 0       COLHDG('MAX# OF EMP PERSHIFT')
      **** BEGIN ADD **** 03/02/15
     A            LDBUILDYR      4S 0       COLHDG('Building Constracted' -
     A                                             'Year')
     A            LD#STORIES     3S 0       COLHDG('Building' -
     A                                             '# of Stories')
     A            LDPEAKEMP      7S 0       COLHDG('Peak # of Employees')
      ***** END ADD ***** 03/02/15
