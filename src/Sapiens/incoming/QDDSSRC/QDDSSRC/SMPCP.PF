     A**
     A** SYSTEM PRINTER CONTROL FILE
     A**
     A                                      REF(SREFP)
     A          R PPC01                     TEXT('SYSTEM PRINTER CONTROL FILE')
     A            PCCO#     R               REFFLD(CO#)
     A            PCPGMN    R               REFFLD(PGM)
     A            PCPRTF    R               REFFLD(FLAG)
     A                                      COLHDG('PRINTER FILE' '#')
     A            PCDATA        70A         TEXT('PRINTER COMMANDS')
     A                                      COLHDG('PRINTER' 'COMMAND' 'STRING')
     A            PCPCMT    R               REFFLD(FLAG)
     A                                      COLHDG('PRNTR CMD TYP' '1-PRESCRIB+
                                            E,2-HP,' '3-PMP,4-IPDS,5-OTHER')
     A            PCGRID        10A         TEXT('GROUPING ID')
     A                                      COLHDG('GROUPING' 'IDENTIFIER')
     A            PCSEQ#         5  0       TEXT('SEQUENCE WITHIN GROUPING ID')
     A                                      COLHDG('GROUPING ID' 'SEQUENCE #')
     A            PCNUM5         5  0       TEXT('XTRA 5/0 FLD FOR FUTURE USE')
     A                                      COLHDG('5/0 FIELD' 'FOR FUTURE USE')
     A            PCFLG1    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG FOR' 'FUTURE USE')
     A            PCFLG2    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG FOR' 'FUTURE USE')
     A            PCFLG3    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG FOR' 'FUTURE USE')
     A            PCFLG4    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG FOR' 'FUTURE USE')
     A            PCFLG5    R               REFFLD(FLAG)
     A                                      COLHDG('FLAG FOR' 'FUTURE USE')
     A            PCSYS     R               REFFLD(FLAG)
     A                                      COLHDG('SYSTEM CODE')
     A            PCFRNM        10A         TEXT('FORM NAME')
     A                                      COLHDG('OUTPUT FORM' 'NAME')
     A            ORSTAT    R               REFFLD(STAT)
     A            PCUSER    R               REFFLD(USER)
     A            PCPGM     R               REFFLD(PGM)
     A            PCTIME    R               REFFLD(TIME)
     A            PCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            PCIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
