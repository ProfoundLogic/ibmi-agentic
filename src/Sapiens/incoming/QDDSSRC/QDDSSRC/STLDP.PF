     A                                      REF(SREFP)
     A          R PLD01                     TEXT('Scriptura LIST DOCS FILE')
     A            LDSTAMP       14S 0       COLHDG('DATE/TIME STAMP')
     A            LDDOC        100A         COLHDG('DOCUMENT NAME')
     A            LDDOCID      100A         COLHDG('D&C DOCUMENT ID')
     A            LDPROC         1A         COLHDG('PROCESSING IN PLACE')
     A            LDUSER    R               REFFLD(USER)
     A                                      COLHDG('User')
     A            LDPGM     R               REFFLD(PGM)
     A                                      COLHDG('Program')
     A            LDTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Time')
     A            LDDT      R     S         REFFLD(DT)
     A                                      COLHDG('Date')
