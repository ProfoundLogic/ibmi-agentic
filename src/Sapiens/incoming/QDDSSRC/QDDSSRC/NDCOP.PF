      *
      *  NDCOP - "Carve-out" Discount code file
      *****************************************************************
      *  REVISIONS:                                                   *
      *                                                               *
      *  04/30/13 C:277  PROJECT 147MAS                               *
      *              - Add fields - COPCT1, COPCT2 and COPCT3         *
      *                                                               *
      *  03/19/09 C:079  PROJECT 25MPA                                *
      *              - Uncomment fields that were commented out for   *
      *                114MRY: COPMD3 and CORATE                      *
      *                                                               *
      *  10/17/08 C:189  PROJECT 114MRY                               *
      *              - ADD NEW FIELD:                                 *
      *                   COFFEE - FACILITY FEE                       *
      *                                                               *
      *  09/08/08 C:62 PROJECT 25MPA                                  *
      *              - Add new fields: MOD1-3 AND RATE                *
      *                                                               *
      *  09/02/08 C:212 PROJECT 114MQM                                *
      *              - Add new fields:                                *
      *                   COPMD2 - Prpcedure Modifier 2               *
      *                   COSMOD - Service Modifier 1                 *
      *                   COPMD2 - Service Modifier 2                 *
      *                                                               *
      *  09/18/97 C:61 PROJECT 87MAU                                  *
      *              - Add new fields:                                *
      *                   COITIM - Initial Time                       *
      *                   COIPGM - Initial Program                    *
      *                   COPMOD - Proc Code modifier                 *
      *                   COUNIT - Units                              *
      *                                                               *
      *              - Change text/column headings:                   *
      *                   COFL01   Type Code                          *
      *                       Valid values: FTGTP vai 'TYCD'          *
      *                   COFL02   Type Amount                        *
      *                       Valid values: FTGTP via 'TYAM'          *
      *                   COFL03   By report                          *
      *                       Valid values: FTGTP via 'BRPT'          *
      *                   COFL04   Mult surg bypass                   *
      *                       Valid values: FTGTP via 'MSBY'          *
      *                                                               *
      *              - Change column headings to "NOT USED":          *
      *                   COAAMT, COFL05-10, CO10A1-5, C06N1-5        *
      *                                                               *
      *****************************************************************
      *                                                               *
     A                                      REF(FSREFP)
     A          R PCO01                     TEXT('CARVE-OUT TRANSACTION FILE')
     A            COCODE    R               REFFLD(BRCD)
     A                                      COLHDG('BILL RATE/DISCOUNT' 'CODE')
     A            COEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            COCPT4    R               REFFLD(CPT4)
     A            COFEE     R               REFFLD(A92)
     A                                      COLHDG('FEE' '$ AMOUNT')
     A            COAAMT    R               REFFLD(A92)
     A                                      COLHDG('NOT USED')
     A            COANES    R               REFFLD(A52)
     A                                      COLHDG('ANES' 'UNIT' 'VALUE')
     A* FLAG FIELDS
      *
     A            COFL01    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE CODE')
      *               Valid values:  FTGTP via 'TYCD'
      *
     A            COFL02    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE AMOUNT')
      *               Valid values:  FTGTP via 'TYAM'
      *
     A            COFL03    R               REFFLD(FLAG)
     A                                      COLHDG('BY REPORT')
      *               Valid values:  FTGTP via 'BRPT'
      *
     A            COFL04    R               REFFLD(FLAG)
     A                                      COLHDG('MULT SURG BYPASS')
      *               Valid values:  FTGTP via 'MSBY'
      *
     A            COFL05    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A            COFL06    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A            COFL07    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A            COFL08    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A            COFL09    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A            COFL10    R               REFFLD(FLAG)
     A                                      COLHDG('NOT USED')
     A* 10 ALPHA FIELDS
     A            CO10A1    R               REFFLD(DS10) COLHDG('NOT USED')
     A            CO10A2    R               REFFLD(DS10) COLHDG('NOT USED')
     A            CO10A3    R               REFFLD(DS10) COLHDG('NOT USED')
     A            CO10A4    R               REFFLD(DS10) COLHDG('NOT USED')
     A            CO10A5    R               REFFLD(DS10) COLHDG('NOT USED')
     A* 6.0 NUMERIC FIELDS
     A            CO6N1     R               REFFLD(A60)
     A                                      COLHDG('NOT USED')
     A            CO6N2     R               REFFLD(A60)
     A                                      COLHDG('NOT USED')
     A            CO6N3     R               REFFLD(A60)
     A                                      COLHDG('NOT USED')
     A            CO6N4     R               REFFLD(A60)
     A                                      COLHDG('NOT USED')
     A            CO6N5     R               REFFLD(A60)
     A                                      COLHDG('NOT USED')
     A            COSTAT    R               REFFLD(STAT)
     A            COUSER    R               REFFLD(USER)
     A            COPGM     R               REFFLD(PGM)
     A            COTIME    R               REFFLD(TIME)
     A            CODT      R               REFFLD(DT)
     A            COIUSR    R               REFFLD(USER) COLHDG('RECORD' +
     A                                      'CREATED BY')
     A            COIDT     R               REFFLD(DT) COLHDG('INITIAL'  +
     A                                      'ENTRY' 'DATE')
      ***** BEG ADD ******* 09/18/97 **********************************
     A            COPMOD    R               REFFLD(CODE)
     A                                      COLHDG('PROC CODE MODIFIER')
     A            COUNIT    R               REFFLD(DS4)
     A                                      COLHDG('UNITS')
      *              Valid values:
      *                 'Unit' = take units entered in Bill Entry,
      *                          then multiply fee * units
      *                 *BLANK = take straight fee regardless of units
      *
     A            COITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            COIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
      ***** END ADD ******* 09/18/97 **********************************
      ***** BEG ADD ******* 09/02/08 **********************************
     A            COPMD2         2A
     A                                      COLHDG('PROCEDURE' 'MODIFIER 2')
     A            COSMOD         2A
     A                                      COLHDG('SERVICE' 'MODIFIER 1')
     A            COSMD2         2A
     A                                      COLHDG('SERVICE' 'MODIFIER 2')
      ***** END ADD ******* 09/02/08 **********************************
     A*** BEGIN ADD *** 09/08/08 **************************************
     A            COPMD3    R               REFFLD(PMOD)
     A                                      COLHDG('PROCEDURE MODIFIER 3')
     A            CORATE    R               REFFLD(A92)
     A                                      COLHDG('FLAT RATE')
     A*** END   ADD *** 09/08/08 **************************************
      ***** BEG ADD ******* 10/17/08 **********************************
     A            COFFEE    R               REFFLD(A92)
     A                                      COLHDG('FACILITY FEE')
      ***** END ADD ******* 10/17/08 **********************************
      ***** BEG ADD ******* 04/30/13 **********************************
     A            COPCT1    R     S         REFFLD(A52)
     A                                      COLHDG('Percent' 'Field 1')
     A*
     A            COPCT2    R     S         REFFLD(A52)
     A                                      COLHDG('Percent' 'Field 2')
     A*
     A            COPCT3    R     S         REFFLD(A52)
     A                                      COLHDG('Percent' 'Field 3')
     A*
      ***** END ADD ******* 04/30/13 **********************************
