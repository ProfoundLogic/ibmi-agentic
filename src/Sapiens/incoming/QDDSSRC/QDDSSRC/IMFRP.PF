     A          R PFR01                     TEXT('FAX RECIPIENT FILE')
     A            FRRCID        10          TEXT('RECIPIENT ID')
     A            FRDESC        40          TEXT('DESCRIPTION')
     A            FRKEY         40          TEXT('FAX KEY (DARTS/LIKE)')
     A            FROUTC         2          TEXT('FAX OUTPUT CLASS')
     A*
     A            FRFPH#        32          TEXT('TO FAX PHONE#')
     A            FRCPTI        40          TEXT('FAX COVER PAGE TITLE')
     A            FRCPT1        40          TEXT('FAX COVER PAGE TO LN1')
     A            FRCPT2        40          TEXT('FAX COVER PAGE TO LN2')
     A            FRCPT3        40          TEXT('FAX COVER PAGE TO LN3')
     A            FRCPF1        40          TEXT('FAX COVER PAGE FROM LN1')
     A            FRCPF2        40          TEXT('FAX COVER PAGE FROM LN2')
     A            FRCPF3        40          TEXT('FAX COVER PAGE FROM LN3')
     A            FRCPCM        40          TEXT('FAX COVER PAGE COMMENT')
     A*
     A            FRDSTM         6S 0       TEXT('DFLT TIME FOR SEND')
     A                                      COLHDG('DEFAULT' 'SEND' 'TIME')
     A*
     A            FRSTAT         1          TEXT('RECORD STATUS')
     A            FRUSER        10          TEXT('LAST MAINT. USER')
     A            FRPGM         10          TEXT('LAST MAINT. PGM')
     A            FRTIME         6S         TEXT('LAST MAINT. TIME')
     A            FRDT           7  0       TEXT('LAST MAINT. DATE')
     A*** ADD 8/8/98 *********************************************
     A            FRTYPE         2          TEXT(' KEY TYPE ')
     A                                      COLHDG('KEY TYPE')
