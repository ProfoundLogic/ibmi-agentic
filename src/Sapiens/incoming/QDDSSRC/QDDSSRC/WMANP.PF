     A                                      REF(WREFP)
     A          R PAN01                     TEXT('NAMED INSUREDS')
     A            ANCO#     R               REFFLD(CO#)
     A            ANFND     R               REFFLD(FND)
     A            ANEMP#    R               REFFLD(EMP#)
     A            ANDIV     R               REFFLD(DIV)
     A            ANSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('NAMED' 'INSURED #')
     A            ANSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            ANNAME    R               REFFLD(NAME)
     A                                      COLHDG('NAME')
     A            ANFEIN    R               REFFLD(FEIN)
     A            ANUSER    R               REFFLD(USER)
     A            ANPGM     R               REFFLD(PGM)
     A            ANTIME    R               REFFLD(TIME)
     A            ANDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ANIUSR    R               REFFLD(USER)
     A            ANIPGM    R               REFFLD(PGM)
     A            ANIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
      **** BEGIN ADD **** 10/05/99 *********************************************
     A            ANEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            ANDLDT    R               REFFLD(DT)
     A                                      COLHDG('DELETION' 'DATE')
      **** END   ADD **** 10/05/99 *********************************************
      *
      **** BEGIN ADD **** 05/02/03 *********************************************
     A            ANNAM2    R               REFFLD(NAME)
