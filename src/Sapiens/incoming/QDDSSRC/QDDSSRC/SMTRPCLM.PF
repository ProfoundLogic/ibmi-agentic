     A                                      REF(WREFP)
     A          R PTR01                     TEXT('Auto-Diary Triggers')
     A            TRCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TRNAME        10A
     A                                      COLHDG('Trigger Name')
     A            TRSEQ#         5S 0
     A                                      COLHDG('Name Seq#')
     A            TRCLMSTS      10A
     A                                      COLHDG('Claim Status')
     A            TRCLMTYPE     15A
     A                                      COLHDG('Claim Type')
     A            TRAMT         15S 2
     A                                      COLHDG('Amount')
     A            TRPAYCOUNT     3S 0
     A                                      COLHDG('Payment Count')
     A            TRRETEN        3S 0
     A                                      COLHDG('% of Specific' +
     A                                      'Retention')
     A            TRTOTPAID     15S 2
     A                                      COLHDG('Total Paid')
     A            TRTOTINC      15S 2
     A                                      COLHDG('Total Incurred')
     A            TRWEEKSPD      5S 0
     A                                      COLHDG('Compensation Weeks' +
     A                                      'Paid')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
      *** Beg Add ** 05/24/16
     A            TRRSET         1A         COLHDG('Retro Settlement')
      *** End Add ** 05/24/16
      ***  Begin Add  ***  11/04/17  *****************************
     A            TRSPLTWG  R               REFFLD(FLAG)
     A                                      COLHDG('Split' 'Wage')
     A            TRSPLTWG0 R               REFFLD(FLAG)
     A                                      COLHDG('Split' 'Wage=0')
      ***  End   Add  ***  11/04/17  *****************************
     A
     A          K TRCO#
     A          K TRNAME
     A          K TRSEQ#
