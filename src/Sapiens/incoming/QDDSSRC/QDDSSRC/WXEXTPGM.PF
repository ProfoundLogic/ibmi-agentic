     A          R PEX01                     TEXT('EXIT PROGRAM PARAMETERS')
     A*
     A            EXTRGNAME    128A         COLHDG('Trigger' 'Name')
     A            EXUSER        10A         COLHDG('User')
     A            EXPGM         10A         COLHDG('Program')
     A            EXLIBFILE     10A         COLHDG('File Library')
     A            EXLIBOBJ      10A         COLHDG('Object Library')
     A            EXLIBENV      10A         COLHDG('Env Library')
     A            EXCHGOLD    5000A         COLHDG('Change field' -
     A                                       'values -Prior')
     A            EXCHGNEW    5000A         COLHDG('Change field' -
     A                                       'values -New')
     A            EXRPTOLD    5000A         COLHDG('Report field' -
     A                                       'values -Prior')
     A            EXRPTNEW    5000A         COLHDG('Report field' -
     A                                       'values -New')
