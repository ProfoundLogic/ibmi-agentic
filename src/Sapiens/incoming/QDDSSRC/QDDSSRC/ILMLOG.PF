     A          R RLOG                      TEXT('ILM API LOG FILE')
     A            QQRTCD         2          COLHDG('RTCD PARM')
     A            QQEMSG        79          COLHDG('EMSG PARM  ')
     A            $#DOR1       256          COLHDG('DORCD PART 1 PARM')
     A            $#DOR2        19          COLHDG('DORCD PART 2 PARM')
     A            QQDRKY        30          COLHDG('DRKY PARM')
     A            QQDCID        12          COLHDG('DCID PARM')
     A            QQOUTQ        10          COLHDG('OUTQ PARM')
     A            QQPATH        60          COLHDG('PATH PARM')
     A            QQCPTH        60          COLHDG('CPTH PARM')
     A            QQDCTP         8          COLHDG('DCTP PARM')
     A            QQFIL1       256          COLHDG('FIL1 PARM')
     A            QQFIL2       232          COLHDG('FIL2 PARM')
     A            #LCPGM        10          COLHDG('LOG CALLING PGM')
     A            #LSCOD         2          COLHDG('LOG STEP CODE')
     A******************************* 'IN', 'OT' SC-SCAN COMPLETE(SCIMGS)
     A*** SB - SCAN BEFORE, SU-SCAN UPDATE RCDS, SD-SCN DEL (NO VALID)
     A*
     A            #LDT           7S 0       COLHDG('LOG DATE')
     A            #LTM           6S 0       COLHDG('LOG TIME')
     A            #JOB          10          COLHDG('JOB THAT LOGGED')
     A            #JOBN          6S 0       COLHDG('JOB NUMBER LOGGED')
     A            #USER         10          COLHDG('JOB USER LOGGED')
     A            #TEXT        256          COLHDG('VARIABLE TEXT')
     A*
