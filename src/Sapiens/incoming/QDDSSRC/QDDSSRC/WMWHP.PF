     A                                      REF(WREFP)
     A          R PWH01                     TEXT('WORK HISTORY FILE')
     A            WHCO#     R               REFFLD(CO#)
     A            WHFND     R               REFFLD(FND)
     A            WHFYR     R               REFFLD(FYR)
     A            WHCASE    R               REFFLD(CASE)
     A            WHDATE    R               REFFLD(DT)
     A                                      COLHDG('WORK HISTORY DATE')
     A            WHWKST    R               REFFLD(FLAG)
     A                                      COLHDG('WORK' 'HIST STATUS (R/L/E)')
     A            WHSTAT    R               REFFLD(STAT)
     A            WHUSER    R               REFFLD(USER)
     A            WHPGM     R               REFFLD(PGM)
     A            WHTIME    R               REFFLD(TIME)
     A            WHDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
      **** BEGIN ADD **** 07/06/00 *********************************************
     A            WHLDWK    R               REFFLD(DT)
     A                                      COLHDG('LAST DAY' 'WORKED (IF L)')
      **** END   ADD **** 07/06/00 *********************************************
      **** BEGIN ADD **** 06/04/04 *********************************************
     A            WHIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            WHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            WHITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            WHIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
      **** END   ADD **** 06/04/04 *********************************************
      **** BEGIN ADD **** 05/04/09 *********************************************
     A            WHRTWQ    R               REFFLD(CODE)
     A                                      COLHDG('RETURN/RELEASE' +
     A                                      'TO WORK QUALIFIER')
      **** END   ADD **** 05/04/09 *********************************************
      **** Beg Add *** 05/30/18 ************************************************
     A            WHCDLW    R     S         REFFLD(DT)
     A                                      COLHDG('Date Last Worked')
     A            WHCDEK    R     S         REFFLD(DT)
     A                                      COLHDG('Date Emp had' +
     A                                             'Knowledge of' +
     A                                             'Disability')
     A            WHCDAK    R     S         REFFLD(DT)
     A                                      COLHDG('Date Administator' +
     A                                             'had Knowledge of' +
     A                                             'Disability')
     A            WHLRSE    R               REFFLD(FLAG)
     A                                      COLHDG('RTW w/Same Employer')
      **** End Add *** 05/30/18 ************************************************
