     A                                      COLHDG('COMPANY')
     A            SFRPID    R               REFFLD(PGM)
     A                                      COLHDG('REPORT PROMPT ID')
     A            SFDESC    R               REFFLD(DS40)
     A                                      COLHDG('REPORT' 'PROMPT/DESC')
     A            SFFLAG    R               REFFLD(FLAG)
     A                                      COLHDG('SSN/FEIN' 'DEFAULT' +
     A                                      'CRITERIA FLAG')
     A            SFLVL     R     S         REFFLD(A30)
     A                                      COLHDG('MINIUM SECURITY' +
     A                                      'LEVEL')
     A            SFTY01    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 01')
     A            SFTY02    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 02')
     A            SFTY03    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 03')
     A            SFTY04    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 04')
     A            SFTY05    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 05')
     A            SFTY06    R               REFFLD(FLAG)
     A                                      COLHDG('SECURITY TYPE 06')
      *
     A            SFIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            SFIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            SFITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            SFIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            SFUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT' 'USER')
     A            SFPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT' 'PROGRAM')
     A            SFTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT' 'TIME')
     A            SFDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT' 'DATE')
