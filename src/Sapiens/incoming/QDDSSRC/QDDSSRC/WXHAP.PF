     A**
     A** EDI/NOI Transmission Data - Header
     A**
     A                                      REF(WREFP)
     A**
     A          R PHA01                     TEXT('EDI AK1 Header Format')
     A*
     A***    Transaction
     A*
     A            HATHDR    R    3A         REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'HDR' 'ID')
     A            HASEIN    R               REFFLD(DS9)
     A                                      COLHDG('SENDER' 'FEIN')
     A            HAFIL1         7A         TEXT('FILLER')
     A            HASZP     R    9A         REFFLD(ZIP)
     A                                      COLHDG('SENDER' 'POSTAL' 'CODE')
     A            HAREIN    R               REFFLD(DS9)
     A                                      COLHDG('RECEIVER' 'FEIN')
     A            HAFIL2         7A         TEXT('FILLER')
     A            HARZP     R    9A         REFFLD(ZIP)
     A                                      COLHDG('RECEIVER' 'POSTAL' 'CODE')
     A            HALTDT    R    8A         REFFLD(DT)
     A                                      COLHDG('DATE' 'TRANSMISSION' 'SENT')
     A            HALTTM    R    6A         REFFLD(TIME)
     A                                      COLHDG('TIME' 'TRANSMISSION' 'SENT')
     A            HAOTDT    R    8A         REFFLD(DT)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'DATE')
     A            HAOTTM    R    6A         REFFLD(TIME)
     A                                      COLHDG('ORIG' 'TRANSMISSION' 'TIME')
     A            HATPFG    R               REFFLD(FLAG)
     A                                      COLHDG('TEST/' 'PRODUCTION' 'FLAG')
     A            HATSET    R    3A         REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'SET' 'ID')
     A            HATRN#    R               REFFLD(CODE)
     A                                      COLHDG('RELEASE' 'NUMBER')
     A            HASTAT    R               REFFLD(FLAG)
     A                                      COLHDG('LAST' 'TRANS' 'STATUS')
     A            HAERRF    R               REFFLD(FLAG)
     A                                      COLHDG('TRANS' 'ERROR' 'FLAG')
     A            HARCNT    R               REFFLD(DS9)
     A                                      COLHDG('RECORD' 'COUNT')
     A            HACO#     R               REFFLD(CO#)
     A            HAJST     R               REFFLD(ST)
     A                                      COLHDG('JURISDICTION' 'STATE')
