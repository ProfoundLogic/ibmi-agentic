      *
      * FDOSP - WCMC Outcome/Savings Transaction File
      *******************************************************************
      *
      *   This file linked to the main Pre/Re-cert record via
      *   CO/SUB/FND/FYR/CASE/CERT or a Case's service record via
      *   CO/SUB/FND/FYR/CASE/MSCD and will hold the outcome/savings
      *   information.
      *
      *******************************************************************
      *
      *
     A                                      REF(FSREFP)
     A          R POS01                     TEXT('Outcome/Savings'+
     A                                      'Transaction File')
     A            OSCO#     R               REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            OSSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('Subscriber Number')
     A            OSFND     R               REFFLD(FND)
     A                                      COLHDG('Fund Number')
     A            OSFYR     R               REFFLD(FYR)
     A                                      COLHDG('Fund Year')
     A            OSCASE    R               REFFLD(CASE)
     A                                      COLHDG('Case Number')
     A            OSMSCD    R               REFFLD(MSCD)
     A                                      COLHDG('Case' 'Mgmt'+
     A                                      'Service code')
     A            OSSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('Case' 'Mgmt'+
     A                                      'Service seq#')
     A            OSCERT    R               REFFLD(CERT)
     A                                      COLHDG('Pre-cert'+
     A                                      'Number')
     A            OSURSV    R               REFFLD(MSCD)
     A                                      COLHDG('UR service code')
     A            OSCODE    R               REFFLD(KEY)
     A                                      COLHDG('Outcome/Savings code')
     A            OSDATE    R               REFFLD(DT)
     A                                      COLHDG('Outcome/Savings date')
     A            OSRATE    R               REFFLD(A92)
     A                                      COLHDG('Savings rate')
     A            OSNUMB    R               REFFLD(A72)
     A                                      COLHDG( 'Days/'+
     A                                      'visits/' 'Each/'+
     A                                      'Mileage value')
     A            OSPERC    R               REFFLD(A52)
     A                                      COLHDG('Less' 'percentage')
     A            OSCSAV    R               REFFLD(A112)
     A                                      COLHDG('Calculated' 'savings')
     A            OSSAVE    R               REFFLD(A112)
     A                                      COLHDG('Savings' 'Amount')
     A            OSNEGO    R               REFFLD(FLAG)
     A                                      COLHDG('Negotiated')
      *                          valid values:  Y or N
      *
     A            OSCOM1    R               REFFLD(DS70)
     A                                      COLHDG('Comment 1')
     A            OSCOM2    R               REFFLD(DS70)
     A                                      COLHDG('Comment 2')
     A            OSCOM3    R               REFFLD(DS70)
     A                                      COLHDG('Comment 3')
     A            OSCOM4    R               REFFLD(DS70)
     A                                      COLHDG('Comment 4')
     A            OSCOM5    R               REFFLD(DS70)
     A                                      COLHDG('Comment 5')
      *
      *
     A            OSSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('RCD' 'STATUS')
     A            OSUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT' 'USER')
     A            OSPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT' 'PGM')
     A            OSTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT' 'TIME')
     A            OSDT      R               REFFLD(DT7)
     A                                      COLHDG('MAINT' 'DATE')
      *
     A            OSIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            OSIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            OSITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            OSIDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL' 'DATE')
      *
