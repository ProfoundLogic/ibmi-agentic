     A* WFRBP - Check Register by Bank Account Report
     A*****************************************************************
     A* CREATED: 05/18/01     C:61   Project: 114WBY                  *
     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PRB01                     TEXT('CHK REG by Bank Acct')
      *
     A            RBCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
      *
     A            RBCNAM    R               REFFLD(NM50)
     A                                      COLHDG('Company' 'Name')
      *
     A            RBFND     R               REFFLD(FND)
     A                                      COLHDG('Group')
      *
     A            RBFNAM    R               REFFLD(NM60)
     A                                      COLHDG('Group' 'Name')
      *
     A            RBACCT    R               REFFLD(DS20)
     A                                      COLHDG('Bank' 'Account' 'Number')
      *
     A            RBCHK#    R               REFFLD(CHK#)
     A                                      COLHDG('Check' 'Number')
      *
     A            RBAMT     R               REFFLD(A92)
     A                                      COLHDG('Amount')
      *
     A            RBTRDT    R               REFFLD(DT)
     A                                      COLHDG('Transaction' 'Date')
      *
     A            RBPODT    R               REFFLD(DT)
     A                                      COLHDG('Post' 'Date')
      *
     A            RBPNAM    R               REFFLD(NAME)
     A                                      COLHDG('Payee' 'Name')
      *
     A            RBCASE    R               REFFLD(CASE)
     A                                      COLHDG('Case' 'Number')
      *
     A            RBFYR     R               REFFLD(FYR)
     A                                      COLHDG('Policy' 'Year')
      *
     A            RBACL#    R               REFFLD(DS25)
     A                                      COLHDG('Claim' 'Number')
      *
     A            RBCLNM    R               REFFLD(NAME)
     A                                      COLHDG('Claimant' 'Name')
      *
     A            RBTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Record' 'Type')
      *
     A            RBBR2     R               REFFLD(CODE)
     A                                      COLHDG('Payment' 'Value 1')
      *
     A            RBBR2D    R               REFFLD(DS40)
     A                                      COLHDG('Payment' 'Value 1' +
     A                                      'Description')
      *
     A            RBPTYP         4A
     A                                      COLHDG('Pay' 'Type')
      *
     A            RBFRDT    R               REFFLD(DT)
     A                                      COLHDG('Service' 'From Date')
      *
     A            RBTODT    R               REFFLD(DT)
     A                                      COLHDG('Service' 'TO Date')
      *
     A            RBSS#     R               REFFLD(SS#)
     A                                      COLHDG('Social' 'Security' +
     A                                      'Number')
      *
     A            RBTRCD    R               REFFLD(CODE)
     A                                      COLHDG('Transaction' 'Code')
      *
     A            RBTDES    R               REFFLD(DS40)
     A                                      COLHDG('Transaction' 'Description')
      *
     A            RBRECD    R               REFFLD(CODE)
     A                                      COLHDG('Reserve' 'Code')
      *
     A            RBRDES    R               REFFLD(DS30)
     A                                      COLHDG('Reserve' 'Description')
      *
     A            RBRETP    R               REFFLD(FLAG)
     A                                      COLHDG('Reserve' 'Type')
      *
     A            RBCKTP    R               REFFLD(DS10)
     A                                      COLHDG('Bank' 'Acct#' 'Code')
      *
     A            RBEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('Employer' 'Number')
      *
     A            RBDIV     R               REFFLD(DIV)
     A                                      COLHDG('Employer' 'Division')
      *
     A            RBENAM    R               REFFLD(NAME)
     A                                      COLHDG('Employer' 'Name')
      *
     A            RBFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('Payee' 'Federal' 'ID #')
      *
     A            RBMOD     R               REFFLD(MOD)
     A                                      COLHDG('Payee' 'Modifier')
      *
     A            RBADR1    R               REFFLD(ADR1)
     A                                      COLHDG('Payee' 'Address 1')
      *
     A            RBADR2    R               REFFLD(ADR2)
     A                                      COLHDG('Payee' 'Address 2')
      *
     A            RBCTY     R               REFFLD(CTY)
     A                                      COLHDG('Payee' 'City')
      *
     A            RBST      R               REFFLD(ST)
     A                                      COLHDG('Payee' 'State')
      *
     A            RBZIP     R               REFFLD(ZIP)
     A                                      COLHDG('Payee' 'Zip code')
      *
     A            RBUSER    R               REFFLD(USER)
     A                                      COLHDG('Report' 'Requester')
      *
     A            RBDT      R               REFFLD(DT)
     A                                      COLHDG('Report' 'Date')
      *
     A            RBTIME    R               REFFLD(TIME)
     A                                      COLHDG('Report' 'Time')
      *
      *
     A          K RBCO#
     A          K RBFND
     A          K RBACCT
     A          K RBCHK#
     A          K RBTRDT
      *
