     A*  AGING REPORT WORKFILE
     A*****************************************************************
     A*  DESCRIPTIONS:                                                *
     A*  AN OUTPUT WORKFILE FOR THE CLIENT'S USE IN QUERY, ETC.       *
     A*  THIS FILE CONTAINS DETAIL LEVEL RECORDS AS PRINTED IN        *
     A*  QSYSPRT IN W7291R1.                                          *
     A*                                                               *
     A*  CREATED: 09/24/98       PROJECT: 95WCQ       PROGRAMMER: 90  *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 09/10/99 C:87  PROJECT: 100BH                                 *
     A*                Added fields to workfile to accomodate clt100  *
     A*                                                               *
     A*****************************************************************
     A
     A                                      REF(WREFP)
     A
     A          R PRA01                     TEXT('AGING REPORT WORKFILE')
     A
     A            RACO#     R               REFFLD(CO#)
     A            RAFND     R               REFFLD(FND)
     A            RAFYR     R               REFFLD(FYR)
     A                                      TEXT('POLICY YEAR')
     A            RAEMP#    R               REFFLD(EMP#)
     A            RADIV     R               REFFLD(DIV)
     A            RAENAM    R               REFFLD(NAME)
     A                                      TEXT('EMPLOYER NAME')
     A            RAPFDT    R               REFFLD(DT)
     A                                      TEXT('POLICY FROM DATE')
     A            RAPTDT    R               REFFLD(DT)
     A                                      TEXT('POLICY TO DATE')
     A            RABLDT    R               REFFLD(DT)
     A                                      TEXT('BALANCE DATE')
     A            RAAGT#    R               REFFLD(AGT#)
     A                                      TEXT('AGENT NUMBER')
     A            RAESSR    R               REFFLD(FLAG)
     A                                      TEXT('ACCOUNT TYPE')
     A            RAACST    R               REFFLD(FLAG)
     A                                      TEXT('ACCOUNT STATUS')
     A            RAAUST    R               REFFLD(FLAG)
     A                                      TEXT('AUDIT STATUS')
     A            RACRDB    R               REFFLD(FLAG)
     A                                      TEXT('REPORT TYPE')
     A            RACURR    R               REFFLD(A92)
     A                                      TEXT('0-30 DAYS PAST DUE')
     A            RA30DY    R               REFFLD(A92)
     A                                      TEXT('31-60 DAYS PAST DUE')
     A            RA60DY    R               REFFLD(A92)
     A                                      TEXT('61-90 DAYS PAST DUE')
     A            RA90DY    R               REFFLD(A92)
     A                                      TEXT('OVER 90 DAYS PAST DUE')
     A            RAAMTD    R               REFFLD(A92)
     A                                      TEXT('TOTAL DUE')
     A            RACUTL    R               REFFLD(A112)
     A                                      TEXT('0-30 DAYS TOTAL')
     A            RA30TL    R               REFFLD(A112)
     A                                      TEXT('31-60 DAYS TOTAL')
     A            RA60TL    R               REFFLD(A112)
     A                                      TEXT('61-90 DAYS TOTAL')
     A            RA90TL    R               REFFLD(A112)
     A                                      TEXT('OVER 90 DAYS TOTAL')
     A            RAFTOT    R               REFFLD(A112)
     A                                      TEXT('TOTAL OF ACCOUNTS')
     A            RAOV90    R               REFFLD(A112)
     A                                      TEXT('TOTAL DUE OF ACCTS OVER 90')
     A***  BEGIN ADD  ***  09/10/99  **********************************
     A            RACNAM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY' 'NAME')
     A            RAGNAM    R               REFFLD(NM60)
     A            RAEFDT    R               REFFLD(DT8)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            RACXDT    R               REFFLD(DT8)
     A                                      COLHDG('CANCEL DATE')
     A            RADEFR    R               REFFLD(A112)
     A                                      COLHDG('DEFERRED DUE')
     A            RATLDU    R               REFFLD(A112)
     A                                      COLHDG('TOTAL DUE')
     A            RARST     R               REFFLD(ST)
     A                                      COLHDG('RATING STATE')
     A            RACHAP    R               REFFLD(RGN#)
     A                                      COLHDG('CHAPTER')
     A            RACDES    R               REFFLD(DS30)
     A                                      COLHDG('CHAPTER DESCRIPTION')
     A            RARGN#    R               REFFLD(RGN#)
     A            RARDES    R               REFFLD(DS30)
     A                                      COLHDG('REGION' 'DESCRIPTION')
     A            RAPEFF    R               REFFLD(DT8)
     A                                      COLHDG('POLICY EFF' 'FROM DT')
     A            RAPEXP    R               REFFLD(DT8)
     A                                      COLHDG('POLICY EFF' 'TO DATE')
     A            RABALD    R               REFFLD(DT8)
     A                                      COLHDG('BALANCE DATE')
     A            RADT      R               REFFLD(DT8)
     A                                      COLHDG('LAST RUN DATE')
     A            RATIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST RUN TIME')
     A            RAPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM NAME')
     A            RAUSER    R               REFFLD(USER)
     A***  END   ADD  ***  09/10/99  **********************************
