     A** EDI Extract - R22 Concurrent Employer Detail file
     A                                      REF(WREFP)
     A**
     A          R PE301                     TEXT('R22 Concurrent Employer')
     A            E3CO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY' 'NUMBER')
     A            E3FND     R               REFFLD(FND)
     A                                      COLHDG('FUND' 'NUMBER')
     A            E3FYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY' 'YEAR')
     A            E3CASE    R               REFFLD(CASE)
     A                                      COLHDG('CLAIM' 'NUMBER')
     A            E3ENAM        40
     A                                      COLHDG('CONCURRENT' 'EMPLOYER -
     A                                      NAME')
     A            E3PHON        15
     A                                      COLHDG('CONCURRENT' 'EMPLOYER -
     A                                      CONTACT' 'BUSINESS PHONE #')
     A            E3WAGE        11
     A                                      COLHDG('CONCURRENT' 'EMPLOYER -
     A                                      WAGE')
     A            E3FIL         20
     A                                      COLHDG('FILLER')
