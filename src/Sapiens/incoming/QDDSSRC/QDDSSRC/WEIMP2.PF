     A                                      COLHDG('SEQUENCE #')
     A            IMISO#        11A         COLHDG('ISO SEQUENCE #')
     A            IMINAM        55A         COLHDG('INSURING COMPANY')
     A            IMIAD1        50A         COLHDG('INS CO ADDRESS')
     A            IMIAD2        50A         COLHDG('INS CO ADDRESS 2')
     A            IMICTY        25A         COLHDG('INS CO CITY')
     A            IMIST          2A         COLHDG('INS CO ST')
     A            IMIZIP         9A         COLHDG('INS CO ZIP')
     A            IMIPH#        10A         COLHDG('INS CO PHONE #')

     A            IMPOL#        30A         COLHDG('POLICY #')
     A            IMPTYP         4A         COLHDG('POL TYPE')
