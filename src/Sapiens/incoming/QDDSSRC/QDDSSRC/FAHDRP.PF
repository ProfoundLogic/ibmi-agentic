     A                                      REF(FSREFP)
     A          R PFAHDR                    TEXT('Bill Import Hdr Holding File')
      *
      * Control Information
      *
     A            HDBUNID      100A         COLHDG('Unique Id')
     A            HDICNTL        9A         COLHDG('Interchg' 'Ctl Number')
      *
      * Beginning Hierarchical Transaction
      *
     A            HDTSHGCTL      9A         COLHDG('TSH Group' 'Cntl')
     A            HDTSHIDCD      3A         COLHDG('TSH ID' 'Code')
     A            HDTSHCNTL      9A         COLHDG('TSH Control#')
     A            HDTSHICR      35A         COLHDG('TSH Impl' 'Conv Ref')
     A            HDBHTHSC       4A         COLHDG('BHT Hierarch' 'Struct Code')
     A            HDBHTTSPC      2A         COLHDG('BHT TS' 'Purpose Code')
     A            HDBHTOATI     50A         COLHDG('BHT Orig' 'App Trans ID')
     A            HDBHTCRDT      8A         COLHDG('BHT TS' 'Creation Date')
     A            HDBHTCRTM      8A         COLHDG('BHT TS' 'Creation Time')
     A            HDBHTID        2A         COLHDG('Claim' 'Encounter ID')
      *
      * Submitter Name
      *
     A            HDSBIDCD       3A         COLHDG('Entity Id' 'Code')
     A            HDSBENQU       1A         COLHDG('Entity Type' 'Qualifier')
     A            HDSBNAME      60A         COLHDG('Submitter' 'Last-Org Name')
     A            HDSBFSN       35A         COLHDG('Submitter' 'First Name')
     A            HDSBMID       25A         COLHDG('Submitter' 'Middle' 'Name')
     A            HDSBIDQU       2A         COLHDG('Id Code' 'Qualifier')
     A            HDSBID        80A         COLHDG('Submitter' 'Identifier')
      *
      * Submitter EDI contact Information
      *
     A            HDSBCFC        2A         COLHDG('Contact' 'Function Code')
     A            HDSBCTNM      60A         COLHDG('Submitter' 'Contact' 'Name')
     A            HDSBCN1QU      2A         COLHDG('Communicat' 'Nbr Qualifier')
     A            HDSBCN1      256A         COLHDG('Communicat' 'Number')
     A            HDSBCN2QU      2A         COLHDG('Communicat' 'Nbr Qualifier')
     A            HDSBCN2      256A         COLHDG('Communicat' 'Number')
     A            HDSBCN3QU      2A         COLHDG('Communicat' 'Nbr Qualifier')
     A            HDSBCN3      256A         COLHDG('Communicat' 'Number')
      *
      * Receiver Name
      *
     A            HDRCVEIC       3A         COLHDG('Entity Id' 'Code')
     A            HDRCVETQ       1A         COLHDG('Entity Type' 'Qualifier')
     A            HDRCVNM       60A         COLHDG('Receiver' 'Name')
     A            HDRCVIDQU      2A         COLHDG('Id Code' 'Qualifier')
     A            HDRCVPID      80A         COLHDG('Recvr' 'Primary Identifier')
      *
      * Billing Provider Hierarchical
      *
     A            HDBPCODE       3A         COLHDG('Provider' 'Code')
     A            HDBPSPQU       3A         COLHDG('Reference' 'Id Qualifier')
     A            HDBPSPID      50A         COLHDG('Provider' 'Taxonomy')
      *
      * Billing Provider Name
      *
     A            HDBPENIDCD     3A         COLHDG('Entity Id' 'Code')
     A            HDBPENQU       1A         COLHDG('Entity Type' 'Qualifier')
     A            HDBPNM        60A         COLHDG('BP' 'Last-Org Name')
     A            HDBPFNM       35A         COLHDG('BP' 'First' 'Name')
     A            HDBPMNM       25A         COLHDG('BP' 'Middle' 'Name')
     A            HDBPSUFF      10A         COLHDG('BP' 'Name' 'Suffix')
     A            HDBPNMQU       2A         COLHDG('Id Code' 'Qualifier')
     A            HDBPNMID      80A         COLHDG('BP' 'Identifier')
      *
      * Billing Provider Address
      *
     A            HDBPADR1      55A         COLHDG('BP' 'Address' 'Line 1')
     A            HDBPADR2      55A         COLHDG('BP' 'Address' 'Line 2')
      *
      * Billing Provider City/State/Zip
      *
     A            HDBPCTY       30A         COLHDG('BP' 'City')
     A            HDBPST         2A         COLHDG('BP' 'State')
     A            HDBPPOST      15A         COLHDG('BP' 'Zip')
     A            HDBPCNTRY      3A         COLHDG('BP' 'Country')
      *
      * Billing Provider Tax Identification
      *
     A            HDBPTAXQU      3A         COLHDG('BP' 'Ref Id' 'Qualifier')
     A            HDBPTAXID     50A         COLHDG('BP' 'Addtl' 'Identifier')
      *
      * Pay-To Address Name
      *
     A            HDPPRNMID      3A         COLHDG('Entity Id' 'Code')
     A            HDPPRNMQU      1A         COLHDG('Entity Type' 'Qualifier')
      *
      * Pay-To Address Address
      *
     A            HDPPRADR1     55A         COLHDG('Pay-to' 'Address Line 1')
     A            HDPPRADR2     55A         COLHDG('Pay-to' 'Address Line 2')
      *
      * Pay-To Address City/State/Zip
      *
     A            HDPPRCTY      30A         COLHDG('PPR' 'City')
     A            HDPPRST        2A         COLHDG('PPR' 'State')
     A            HDPPRPOST     15A         COLHDG('PPR' 'Zip')
     A            HDPPRCNTRY     3A         COLHDG('PPR' 'Country')
