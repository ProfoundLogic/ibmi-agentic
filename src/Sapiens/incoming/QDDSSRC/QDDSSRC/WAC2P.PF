     A                                      REF(WREFP)
     A          R PC201                     TEXT('CHECK SCHEDULE FILE')
     A            C2CO#     R               REFFLD(CO#)
     A            C2FND     R               REFFLD(FND)
     A            C2PRDT    R               REFFLD(DT)
     A                                      COLHDG('PROCESS DATE')
     A            C2CHK#    R               REFFLD(CHK#)
     A                                      COLHDG('STARTING CHECK #')
     A            C2STA0    R               REFFLD(FLAG)
     A                                      COLHDG('CHECKS PRINTED')
     A            C2STA1    R               REFFLD(FLAG)
     A                                      COLHDG('CHECKS UPDATED')
     A            C2USER    R               REFFLD(USER)
     A            C2PGM     R               REFFLD(PGM)
     A            C2TIME    R               REFFLD(TIME)
     A            C2DT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            C2RSTR    R               REFFLD(CHK#)
     A                                      COLHDG('RESTART CHECK #')
     A            C2WAST    R               REFFLD(FLAG)
     A                                      COLHDG('WASTE CHECKS ?')
      *** BEGIN ADD *** 12/02/97 ***********************************************
     A            C2ACCT    R               REFFLD(DS20)
     A                                      COLHDG('BANK ACCT #')
      *** END   ADD *** 12/02/97 ***********************************************
      *** BEGIN ADD *** 04/17/12 ***********************************************
     A            C2EFTC    R               REFFLD(FLAG)
