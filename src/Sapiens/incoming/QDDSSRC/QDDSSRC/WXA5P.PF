     A*  WORKERS' COMP  POLICY PAGE ADDRESS REPORTING FILE
     A*
     A                                      REF(WREFP)
     A          R PA501                     TEXT('POLICY PAGE ADDRESS REPORTI+
     A                                      NG FILE')
     A            A5CO#     R               REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            A5FND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            A5EMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            A5FYR     R               REFFLD(FYR)
     A                                      COLHDG('YEAR')
     A            A5ADDR       120A         TEXT(' ADR1,ADR2,CITY,,STATE,ZIP')
     A                                      COLHDG('CONCAT ADR1' +
     A                                      'ADR1, CITY, ST, ZIP')
     A            A5ADR1    R               REFFLD(ADR1)
     A                                      COLHDG('ADDRESS 1')
     A            A5ADR2    R               REFFLD(ADR2)
     A                                      COLHDG('ADDRESS 2')
     A            A5CITY    R               REFFLD(CTY)
     A                                      COLHDG('CITY ')
     A            A5ST      R               REFFLD(ST)
     A                                      COLHDG('STATE')
     A            A5ZIP     R               REFFLD(ZIP)
     A                                      COLHDG('ZIP')
     A            A5SIC     R        B      REFFLD(SIC)
     A                                      COLHDG('SIC CODE')
     A            A5NAIC        10A  B
     A                                      COLHDG('NAIC CODE')
     A            A5SCTY    R               REFFLD(CTY)
     A                                      COLHDG('SORT CITY')
     A            A5SST     R               REFFLD(ST)
     A                                      COLHDG('SORT STATE')
     A            A5NLNK         3  0
     A                                      COLHDG('NAME LINK CODE')
     A            A5NLKC         2  0
     A                                      COLHDG('NAME LINK COUNTER')
     A*** Beg add ***** 12/14/10 ******************************************
     A            A5ELID    R               REFFLD(DS10)
     A                                      COLHDG('LOCATION' 'ID')
     A            A5DIV     R     S         REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A*** End add ***** 12/14/10 ******************************************
     A*** Beg add ***** 03/25/11 ******************************************
     A            A5EFDT    R     S         REFFLD(DT)
     A            A5DLDT    R     S         REFFLD(DT)
     A*** End add ***** 03/25/11 ******************************************
     A*** Beg add ***** 10/06/14 ******************************************
     A            A5ADTP         1A
     A                                      COLHDG('ADDRESS' 'TYPE P/M')
     A*** Beg add ***** 10/06/14 ******************************************
     A*** BEGIN ADD ***  11/08/17  ****************************************
     A            A5NAENCD  R     S         REFFLD(A30)
     A                                      COLHDG('ENTITY' 'CODE')
     A            A5NANLKC  R     S         REFFLD(A20)
     A                                      COLHDG('NAME LINK' 'COUNTER')
     A            A5NAEMPY  R     S         REFFLD(A70)
     A                                      COLHDG('NUMBER' 'OF EMPLOYEES')
     A*** END ADD *****  11/08/17  ****************************************
     A*** BEGIN ADD ***  11/22/17  ****************************************
     A            A5EMLINK  R               REFFLD(DS15)
     A                                      COLHDG('EMPLOYER LINK CODE')
     A*** END ADD *****  11/22/17  ****************************************
     A*** BEGIN ADD ***  02/08/18  ****************************************
     A            A5NAENCDF R     S         REFFLD(A30)
     A                                      COLHDG('ENTITY' 'CODE FED')
     A            A5NANLKCF R     S         REFFLD(A20)
     A                                      COLHDG('NAME LINK' 'COUNTER FED')
     A*** END ADD *****  02/08/18  ****************************************
     A*** BEGIN ADD ***  06/09/21  ****************************************
     A            A5ELTYPE  R               REFFLD(FLAG)
     A                                      COLHDG('ENTITY/LOCATION FLAG')
     A            A5BUSTYPE R               REFFLD(DS40)
     A                                      COLHDG('LOC TYPE OF BUSINESS')
     A*** END ADD *****  06/09/21  ****************************************
     A*** BEGIN ADD ***  06/23/23  ****************************************
     A            A5PHN          7S 0       COLHDG('LOCATION PHONE#')
     A            A5AREA         3S 0       COLHDG('LOCATION AREA CODE')
     A            A5FAX          7S 0       COLHDG('LOCATION FAX#')
     A            A5FARA         3S 0       COLHDG('LOCATION FAX' 'AREA CODE')
     A*** END ADD *****  06/23/23  ****************************************
