     A*****************************************************************
     A* SCRIPTURA DATA WORK FILE FOR BILLING INOVICE                  *
     A*****************************************************************
     A*                                                               *
     A*  PROJECT:  150WBV       PROGRAMMER:  C:267                    *
     A*  CREATED:  01/30/18                                           *
     A*  DESCRIPTION:  This is the work file to hold the data for     *
     A*                Billing Invoice Header                         *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 01/16/19 C:300 Support: 76224 (FMIC)                          *
     A*                Add new fields                                 *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PBI01                     TEXT('BILLING INVOICE WORKFILE')
     A*
     A* KEY FIELDS
     A*  THIS IS XML LINK CODE - SAME AS DETAIL FILE
     A            BIXML         60A         COLHDG('XML FILE NAME')
     A*
     A            BICO#     R               REFFLD(CO#)
     A            BIFND     R               REFFLD(FND)
     A            BIEMP#    R               REFFLD(EMP#)
     A            BIDIV     R               REFFLD(DIV)
     A            BIFYR     R               REFFLD(FYR)
     A** Invoice # - not available in the system at this time
     A**          BIINV#    R               REFFLD(DS25)
     A**                                    COLHDG('INVOICE #')
     A* Invoice date
     A            BIINVDAT       8S 0
     A                                      COLHDG('INVOICE DATE')
     A* Insured info
     A            BIINSNAME R               REFFLD(DS50)
     A                                      COLHDG('INSURED NAME')
     A            BIINSADR1 R               REFFLD(DS50)
     A                                      COLHDG('INSURED ADDR #1')
     A            BIINSADD2 R               REFFLD(DS50)
     A                                      COLHDG('INSURED ADDR #2')
     A            BIINSCITY R               REFFLD(CTY)
     A                                      COLHDG('INSURED CITY')
     A            BIINSST   R               REFFLD(ST)
     A                                      COLHDG('INSURED STATE')
     A            BIINSZIP  R               REFFLD(ZIP)
     A                                      COLHDG('INSURED ZIP')
     A* Payment due date
     A            BIDUEDAT       8S 0
     A                                      COLHDG('PYMT DUE DATE')
     A* Reporting Period
     A            BIRPTPRD  R               REFFLD(DS20)
     A                                      COLHDG('REPORTING PERIOD')
     A* Policy Number
     A            BIPOLICY# R               REFFLD(DS20)
     A                                      COLHDG('MAIN POLICY NUMBER')
     A*  REMIT TO
     A            BIABANUM  R               REFFLD(DS20)
     A                                      COLHDG('ABA NUMBER')
     A            BIACTNUM  R               REFFLD(DS20)
     A                                      COLHDG('ACCT NUMBER')
     A*
     A            BIABAWIR  R               REFFLD(DS20)
     A                                      COLHDG('WIRE' 'ABA NUMBER')
     A            BIWIRBNK  R               REFFLD(DS40)
     A                                      COLHDG('WIRE BANK NAME')
     A            BIWIRADR1 R               REFFLD(ADR1)
     A                                      COLHDG('WIRE ADDRESS1')
     A            BIWIRADR2 R               REFFLD(ADR2)
     A                                      COLHDG('WIRE ADDRESS2')
     A            BIWIRCITY R               REFFLD(CTY)
     A                                      COLHDG('WIRE CITY')
     A            BIWIRST   R               REFFLD(ST)
     A                                      COLHDG('WIRE STATE')
     A            BIWIRZIP  R               REFFLD(ZIP)
     A                                      COLHDG('WIRE ZIP')
     A* Credit To, Account Name
     A            BIACCNAM  R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT NAME')
     A            BIACCNBR  R               REFFLD(DS40)
     A                                      COLHDG('ACCOUNT NUMBER')
     A            BIATTNNM  R               REFFLD(DS40)
     A                                      COLHDG('ATTENTION' 'NAME')
     A* Mail to Info
     A            BIMAILNAM R               REFFLD(DS50)
     A                                      COLHDG('MAIL TO NAME')
     A            BIMAILAD1 R               REFFLD(DS50)
     A                                      COLHDG('MAIL TO ADDR #1')
     A            BIMAILDD2 R               REFFLD(DS50)
     A                                      COLHDG('MAIL TO ADDR #2')
     A            BIMAILCTY R               REFFLD(CTY)
     A                                      COLHDG('MAIL TO CITY')
     A            BIMAILST  R               REFFLD(ST)
     A                                      COLHDG('MAIL TO STATE')
     A            BIMAILZIP R               REFFLD(ZIP)
     A                                      COLHDG('MAIL TO ZIP')
     A* Text
     A            BIRMTTXT     200          COLHDG('REMIT TO TEXT')
     A*
     A* COMPANY/CARRIER
     A            BICONAME  R               REFFLD(DS50)
     A                                      COLHDG('COMPANY NAME')
     A            BICARR    R               REFFLD(DS40)
     A                                      COLHDG('CARRIER')
     A            BIFROMDT       8  0       COLHDG('PAYROLL' 'FROM DATE')
     A            BITODT         8  0       COLHDG('PAYROLL' 'TO DATE')
     A            BIPRTDT        8  0       COLHDG('PRINT DATE')
      *** beg add ***** 01/16/19 *************
     A*
     A* FEDERAL NAME
     A            BIFEDNAME R               REFFLD(DS50)
     A                                      COLHDG('FEDERAL NAME')
      *** end add ***** 01/16/19 *************
