     A                                      REF(CREFP)
     A          R PSB01                     TEXT('SUBROGATION MASTER FILE')
     A            SBCO#     R               REFFLD(CO#)
     A            SBCLM#    R               REFFLD(CLM#)
     A            SBCLID    R               REFFLD(CLID)
     A            SBCC      R               REFFLD(CDE)
     A                                      COLHDG('SECTION CODE')
     A            SBVAL     R               REFFLD(FLAG)
     A                                      COLHDG('COVERAGE VALUE')
     A            SBLOC#    R               REFFLD(LOC#)
     A            SBPRM#    R               REFFLD(PRM#)
     A            SBCOVF    R               REFFLD(COVF)
     A            SBSUBL    R               REFFLD(SUBL)
     A            SBCLAS    R               REFFLD(CLAS)
     A            SBCOVL    R               REFFLD(FLAG)
     A                                      COLHDG('COV LINE' 'AUTO, L,M,U')
     A            SBITM#    R               REFFLD(ITM#)
     A                                      COLHDG('VEH OR ITM #')
     A            SBFRM     R               REFFLD(FRM)
     A            SBRTGP    R               REFFLD(RTGP)
     A            SBSPDD    R               REFFLD(DT)
     A                                      COLHDG('SUBR. PAYMENT' 'DUE DATE')
     A            SBLIND    R               REFFLD(DT)
     A                                      COLHDG('DATE LEIN FILED')
     A            SBESTR    R               REFFLD(A112)
     A                                      COLHDG('ESTIMATED RECOVERY')
     A            SBACTR    R               REFFLD(A112)
     A                                      COLHDG('ACTUAL RECOVERY')
     A            SBFCRD    R               REFFLD(DT)
     A                                      COLHDG('1ST CORRESPONDENCE' 'DATE')
     A            SBFOLD    R               REFFLD(DT)
     A                                      COLHDG('FOLLOW-UP DATE')
     A            SBPAYE    R               REFFLD(NM40)
     A                                      COLHDG('SUBR. PYMT' 'RECIEVED FROM')
     A            SBATT     R               REFFLD(NM40)
     A                                      COLHDG('DEFENSE ATTORNEY')
     A            SBADR     R               REFFLD(ADR1)
     A            SBCTY     R               REFFLD(CTY)
     A            SBST      R               REFFLD(ST)
     A            SBZIP     R               REFFLD(ZIP)
     A            SBAREA    R               REFFLD(AREA)
     A                                      COLHDG('ACNTG AREA CODE')
     A            SBPHN#    R               REFFLD(PHN#)
     A                                      COLHDG('ACNTG PHONE #')
     A            SBCOM1    R               REFFLD(COMM)
     A                                      COLHDG('COMMENT #1')
     A            SBCOM2    R               REFFLD(COMM)
     A                                      COLHDG('COMMENT #2')
     A            SBDIDT    R               REFFLD(DT)
     A                                      COLHDG('DIARY DATE')
     A            SBSTAT    R               REFFLD(STAT)
     A            SBUSER    R               REFFLD(USER)
     A            SBPGM     R               REFFLD(PGM)
     A            SBTIME    R               REFFLD(TIME)
     A            SBDT      R               REFFLD(DT)
