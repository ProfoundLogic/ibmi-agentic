      *
     A                                      REF(WREFP)
     A          R PPT01                     TEXT('LOSS RATIO BY POLICY TYPE')
      *
     A            PTCO#          3S 0
     A                                      COLHDG('COMPANY #')
      *
     A            PTCNAM        40A
     A                                      COLHDG('COMPANY' 'NAME')
      *
     A            PTFND          3S 0
     A                                      COLHDG('GROUP')
      *
     A            PTGNAM        40A
     A                                      COLHDG('GROUP' 'NAME')
      *
     A            PTFYR          3S 0
     A                                      COLHDG('POLICY' 'YEAR')
      *
     A            PTEMP#         9S 0
     A                                      COLHDG('EMPLOYER #')
      *
     A            PTENAM        40A
     A                                      COLHDG('EMPLOYER' 'NAME')
      *
      *
     A            PTDIV          5S 0
     A                                      COLHDG('DIVISION')
      *
     A            PTPOL#        25A
     A                                      COLHDG('POLICY #')
      *
     A            PTPFDT         8S 0
     A                                      COLHDG('POLICY' 'FROM' 'DATE')
      *
     A            PTPTDT         8S 0
     A                                      COLHDG('POLICY' 'TO' 'DATE')
      *
     A            PTCXDT         8S 0
     A                                      COLHDG('CANCEL' 'DATE')
      *
     A            PTAGT#         5S 0
     A                                      COLHDG('AGENT' 'NUMBER')
      *
     A            PTAGNM        40A
     A                                      COLHDG('AGENT' 'NAME')
      *
     A            PTPTYP         2A
     A                                      COLHDG('POLICY' 'TYPE CODE')
      *
     A            PTPDES        40A
     A                                      COLHDG('POLICY' 'TYPE' +
     A                                      'DESCRIPTION')
      *
     A            PTRST          2A
     A                                      COLHDG('RATING' 'STATE')
      *
     A            PTPREM        11S 2
     A                                      COLHDG('EARNED' 'PREMIUM')
      *
     A            PTOPEN         9S 0
     A                                      COLHDG('OPEN' 'CLAIM COUNT')
      *
     A            PTCLOS         9S 0
     A                                      COLHDG('CLOSED' 'CLAIM COUNT')
      *
     A            PTTLCL         9S 0
     A                                      COLHDG('TOTAL' 'CLAIM COUNT')
      *
     A            PTPAID        11S 2
     A                                      COLHDG('TOTAL' 'PAID')
      *
     A            PTINCU        11S 2
     A                                      COLHDG('TOTAL' 'INCURRED')
      *
     A            PTLOSS         7S 2
     A                                      COLHDG('LOSS' 'RATIO')
      *
     A            PTFRDT         8S 0
     A                                      COLHDG('FROM POLICY DATE' +
     A                                      'ENTERED ON PROMPT')
      *
     A            PTTODT         8S 0
     A                                      COLHDG('TO POLICY DATE' +
     A                                      'ENTERED ON PROMPT')
      *
     A            PTRNDT         8S 0
     A                                      COLHDG('RUN' 'DATE')
      *
     A            PTDT           8S 0
     A            PTTIME         6S 0
     A            PTPGM         10A
     A            PTUSER        10A
      *
      *
     A          K PTCO#
     A          K PTFND
     A          K PTPTYP
     A          K PTEMP#
     A          K PTDIV
     A          K PTFYR
      *
