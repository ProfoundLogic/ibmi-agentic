     A**  FAX ROUTING/ FILE
     A*
     A          R PRT01                     TEXT('FAX ROUTING FILE')
     A*
     A            RTTSID        20          COLHDG('FAX TS ID')
     A*
     A            RTDESC        40          COLHDG('DESCRIPTION ')
     A            RTFXPT         1          COLHDG('FAX PORT' 'Y/N')
     A*
     A            RTQFAX         1          COLHDG('QUEUE' 'THE FAX')
     A            RTPFAX         1          COLHDG('PRINT FAX ' 'FLG')
     A            RTNFAX         1          COLHDG('NOTIFY MSG'   'FLG')
     A            RTIFAX         1          COLHDG('INDEX'  'FLG')
     A            RTEFAX         1          COLHDG('EMAIL ' 'FLG')
     A            RTRFAX         1          COLHDG('ROUTE PGM' 'FLG')
     A***
     A            RTSTAT         1          COLHDG('STATUS')
     A***** LAST MAINT INFO  *****
     A*
     A            RTIUSR        10          TEXT('INIT USER')
     A            RTIPGM        10          TEXT('INIT PGM')
     A            RTITIM         6S 0       TEXT('INIT TIME')
     A            RTIDT          6S 0       TEXT('INIT DATE')
     A            RTLUSR        10          TEXT('USER LAST MAINT')
     A            RTLPGM        10          TEXT('LAST MAINT PGM')
     A            RTLTIM         6S 0       TEXT('LAST MAINT TIME')
     A            RTLDT          6S 0       TEXT('LAST MAINT DATE')
     A            RTFL01         1          TEXT('**FUTURE USE FLG 01 **')
     A            RTFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            RTFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            RTFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            RTFL05         1          TEXT('**FUTURE USE FLG 05 **')
     A            RTCHR5         5          TEXT('**FUTURE USE A5 01 **')
     A            RTIFXP        12          TEXT('INCOMING FAX PORT')
