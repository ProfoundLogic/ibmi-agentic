     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STBCRP         1S 0       COLHDG('Beneficiary code' +
     A                                      '- relationship')
     A            STBCDP         1A         COLHDG('Beneficiary code' +
     A                                      '- dependency')
     A            STBRDT         6S 0       COLHDG('Beneficiary birth dt')
     A            STBCR2         1S 0       COLHDG('Beneficiary code' +
     A                                      '- relationship 2')
     A            STBCD2         1A         COLHDG('Beneficiary code' +
     A                                      '- dependency 2')
     A            STBRD2         6S 0       COLHDG('Benef birth dt 2')
     A            STBCR3         1S 0       COLHDG('Beneficiary code' +
     A                                      '- relationship 3')
     A            STBCD3         1A         COLHDG('Beneficiary code' +
     A                                      '- dependency 3')
     A            STBRD3         6S 0       COLHDG('Benef birth dt 3')
     A            STBCR4         1S 0       COLHDG('Beneficiary code' +
     A                                      '- relationship 4')
     A            STBCD4         1A         COLHDG('Beneficiary code' +
     A                                      '- dependency 4')
     A            STBRD4         6S 0       COLHDG('Benef birth dt 4')
     A            STBCR5         1S 0       COLHDG('Beneficiary code' +
     A                                      '- relationship 5')
     A            STBCD5         1A         COLHDG('Beneficiary code' +
     A                                      '- dependency 5')
     A            STBRD5         6S 0       COLHDG('Benef birth dt 5')
     A            STFUT1         2A         COLHDG('Future use')
     A            STNINS        24A         COLHDG('Name of insured')
     A            STFUT2       130A         COLHDG('Future use')
