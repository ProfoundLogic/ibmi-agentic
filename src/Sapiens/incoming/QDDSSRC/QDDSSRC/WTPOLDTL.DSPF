     A                                      rue","overlay":"true","overlay rang-
     A                                      e":"1:1","onload":"// define new fu-
     A                                      nction to load endorsement Form inf-
     A                                      ormation\n\nwindow.endorsementInfo -
     A                                      = function() {\n  \nvar comp= parse-
     A                                      Int(get(\"TxbCompNo\"));\nvar fnd =-
     A                                       parseInt(get(\"TxbGroup\"));\nvar -
     A                                      endf = get(\"TxbEndForm\");\nvar n1-
     A                                       = endf.search(\" -\");\nif (n1 > 0-
     A                                      ){\n  endf = endf.substr(0,n1);}\n\-
     A                                      ndebugger;\n\nif (endf !== ''''){\n-
     A                                        \n  changeElementValue(''TxbEndFr-
     A                                      mExtDesc'', '''');\n  changeElement-
     A                                      Value(''TxbEndState'', '''');\n  ch-
