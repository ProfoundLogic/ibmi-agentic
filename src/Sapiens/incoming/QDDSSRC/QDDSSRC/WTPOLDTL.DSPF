     A                                      jaxProgram\t(''999999999'', ''WTPOL-
     A                                      DTL01'',\t{\n  ''params'':'','' + c-
     A                                      omp + '','' + fnd + '','' + endf + -
     A                                      '',''\n   },  function(results)\t{\-
     A                                      n    if(''Points1'' in results){\n -
     A                                           changeElementValue(''TxbEndFrm-
     A                                      ExtDesc'', results.Points1);}\n    -
     A                                      if(''Points2'' in results){\n    ch-
     A                                      angeElementValue(''TxbEndState'', r-
     A                                      esults.Points2);}\n    if(''Points3-
     A                                      '' in results){\n    changeElementV-
