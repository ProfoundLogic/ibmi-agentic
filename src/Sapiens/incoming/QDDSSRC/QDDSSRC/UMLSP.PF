     A                                      COLHDG('TOTAL PATIENTS')
     A            LSASTY    R               REFFLD(DS3)
     A                                      COLHDG('AVERAGE STAY')
     A                                      TEXT('XX.X = IMPLIED DECIMAL')
     A            LSVARI    R               REFFLD(DS4)
     A                                      COLHDG('VARIANCE')
     A            LS10P     R               REFFLD(CODE)
     A                                      COLHDG('10TH PERCENTILE')
