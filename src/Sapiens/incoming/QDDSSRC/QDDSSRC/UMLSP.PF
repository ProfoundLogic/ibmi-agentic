     A                                      COLHDG('+ 10TH' 'PERCENTILE')
     A            LS25P     R               REFFLD(CODE)
     A                                      COLHDG('25TH PERCENTILE')
     A            LS25P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 25TH' 'PERCENTILE')
     A            LS50P     R               REFFLD(CODE)
     A                                      COLHDG('50TH PERCENTILE')
     A            LS50P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 50TH' 'PERCENTILE')
     A            LS75P     R               REFFLD(CODE)
     A                                      COLHDG('75TH PERCENTILE')
     A            LS75P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 75TH' 'PERCENTILE')
     A            LS90P     R               REFFLD(CODE)
     A                                      COLHDG('90TH PERCENTILE')
     A            LS90P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 90TH' 'PERCENTILE')
     A            LS95P     R               REFFLD(CODE)
     A                                      COLHDG('95TH PERCENTILE')
     A            LS95P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 95TH' 'PERCENTILE')
     A            LS99P     R               REFFLD(CODE)
     A                                      COLHDG('99TH PERCENTILE')
     A            LS99P1    R               REFFLD(FLAG)
     A                                      COLHDG('+ 99TH' 'PERCENTILE')
     A            LSBLK2    R               REFFLD(DS4)
     A                                      COLHDG('NOT USED (BLANKS)')
     A            LSSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            LSUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE USER')
     A            LSPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE PGM')
     A            LSTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE TIME')
     A            LSDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE DATE')
     A            LSIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            LSIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            LSLOST    R               REFFLD(FLAG)
     A                                      COLHDG('LOS TYPE' 'DIAG OR OPER')
