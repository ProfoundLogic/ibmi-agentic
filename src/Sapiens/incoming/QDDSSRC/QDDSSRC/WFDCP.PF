     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PDC01                     TEXT('DEBIT/CREDIT OUTPUT')
     A            DCCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY#')
     A            DCCONM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY' 'NAME')
     A            DCFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            DCFNNM    R               REFFLD(NM60)
     A                                      COLHDG('GROUP' 'NAME')
     A            DCFANM    R               REFFLD(NM60)
     A                                      COLHDG('ALT GRP NAME')
     A            DCEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            DCDIV     R               REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A            DCEMNM    R               REFFLD(NAME)
     A                                      COLHDG('EMPLOYER' 'NAME')
     A            DCFYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY' 'YEAR')
     A            DCDAMT    R               REFFLD(A112)
     A                                      COLHDG('DEBIT AMOUNT')
     A            DCCAMT    R               REFFLD(A112)
     A                                      COLHDG('CREDIT AMOUNT')
     A            DCRNDT    R               REFFLD(DT8)
     A                                      COLHDG('RUN DATE')
     A            DCEFDT    R               REFFLD(DT8)
     A                                      COLHDG('EFFECTIVE DATE')
     A            DCCXDT    R               REFFLD(DT8)
     A                                      COLHDG('CANCEL DATE')
     A            DCAGT#    R               REFFLD(AGT#)
     A                                      COLHDG('AGT#')
     A            DCANAM    R               REFFLD(NAME)
     A                                      COLHDG('AGENT' 'NAME')
     A            DCPROD    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER')
     A            DCPNAM    R               REFFLD(NAME)
     A                                      COLHDG('PRODUCER' 'NAME')
      *
      *
     A            DCUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            DCPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            DCTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            DCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE')
     A            DCIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            DCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            DCITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            DCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            DCFAF     R               REFFLD(FLAG)
     A                                      COLHDG('FINAL AUD. FLAG')
     A            DCNWRT    R               REFFLD(A52)
     A                                      COLHDG('NEW BUS RATE')
