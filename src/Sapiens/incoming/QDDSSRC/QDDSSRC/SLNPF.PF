     A                                      REF(SREFP)
     A          R PLN01                     TEXT('Launcher interface control')
     A            LNUSE     R               REFFLD(FLAG)
                                            COLHDG('Use' +
                                                   'Launcher' +
                                                   '                    ')
     A            LNDFTSVR  R               REFFLD(NM10)
                                            COLHDG('Launcher' +
                                                   'default' +
                                                   'server')
     A            LNNETSVR  R               REFFLD(NM50)
                                            COLHDG('Net server' +
                                                   'and shared' +
                                                   'directory')
      *
      *  Standard maintenance fields
      *
     A            LNPGM     R               REFFLD(NM10)
                                            COLHDG('Program' +
                                                   'maintained' +
                                                   '                    ')
     A            LNUSER    R               REFFLD(NM10)
                                            COLHDG('Maintained' +
                                                   'by' +
                                                   '                    ')
     A            LNDT      R               REFFLD(DT)
                                            COLHDG('Date' +
                                                   'maintained' +
                                                   '                    ')
     A            LNTIME    R               REFFLD(TIME)
                                            COLHDG('Time' +
                                                   'maintained' +
                                                   '                    ')
