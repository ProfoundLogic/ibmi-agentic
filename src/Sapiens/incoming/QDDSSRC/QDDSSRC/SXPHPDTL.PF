     A                                      REF(SREFP)
     A          R PPHD01                    TEXT('Scriptura Payment -
     A                                      History Work File -
     A                                      Detail')
     A*
     A            PHDXML        60A         COLHDG('Unique XML File' -
     A                                      ' Name Key')
     A            PHDCO#         3S 0       COLHDG('Company Number')
     A            PHDFND         3S 0       COLHDG('Group Number')
     A            PHDFYR         3S 0       COLHDG('Policy Year')
     A            PHDCASE        7S 0       COLHDG('Case Number')
     A            PHDTRCD        2A         COLHDG('Transaction Code')
     A            PHDDESC       40A         COLHDG('Transaction Desc')
     A            PHDTYPE        1A         COLHDG('Transaction Type')
     A            PHDTYPEDS     40A         COLHDG('Transaction Type' +
     A                                      'Description')
     A            PHDRECD        2A         COLHDG('Reserve Code')
     A            PHDRECDDS     40A         COLHDG('Reserve Code' +
     A                                      'Description')
     A            PHDRETP        1A         COLHDG('Reserve Type')
     A            PHDRETPDS     40A         COLHDG('Reserve Type' +
     A                                      'Description')
     A            PHDTRDT        8S 0       COLHDG('Transaction Date')
     A            PHDPODT        8S 0       COLHDG('Post Date')
     A            PHDFRDT        8S 0       COLHDG('From Date')
     A            PHDTODT        8S 0       COLHDG('To Date')
     A            PHDWKS         3S 0       COLHDG('Number of Weeks')
     A            PHDDYS         1S 0       COLHDG('# of Days Over a' -
     A                                      ' Week')
     A            PHDPV1         2A         COLHDG('Payment Value 1')
     A            PHDPV1DS      30A         COLHDG('Pmt Value 1 Desc')
     A            PHDPV2         2A         COLHDG('Payment Value 2')
     A            PHDPV2DS      30A         COLHDG('Pmt Value 2 Desc')
     A            PHDFEIN        9S 0       COLHDG('Payee Federal ID')
     A            PHDMOD         3S 0       COLHDG('Payee Modifier')
     A            PHDNAME       40A         COLHDG('Payable to')
     A            PHDCHK#        7S 0       COLHDG('Check #')
     A            PHDAMT         9S 2       COLHDG('Amount')
     A            PHDEOB#        9S 0       COLHDG('Eomb#')
     A            PHDPGTP        1A         COLHDG('Check Type ' -
     A                                      'Group/Non-Group')
     A            PHDFNAL        1A         COLHDG('Final Payment')
     A            PHDRADJ        1A         COLHDG('Recovery?')
     A            PHDIDT         7S 0       COLHDG('Init Date')
