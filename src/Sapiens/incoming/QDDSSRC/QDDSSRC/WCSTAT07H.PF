     A          R PST7H                     TEXT('ICR 7-H RECORD')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STHRDT         6S 0       COLHDG('Hire date')
     A            STEMSC         2S 0       COLHDG('Empl status code')
     A            STPTDA        10S 0       COLHDG('Paid temp disability' +
     A                                      'valuation date amt')
     A            STPPPA        10S 0       COLHDG('Paid perm partial' +
     A                                      'valuation date amt')
     A            STPVRA        10S 0       COLHDG('Paid voc rehab' +
     A                                      'valuation date amt')
     A            STPPTA        10S 0       COLHDG('Paid perm total' +
     A                                      'valuation date amt')
     A            STPDBA        10S 0       COLHDG('Paid death benefits' +
     A                                      'valuation date amt')
     A            STFUT1       138A         COLHDG('Future use')
