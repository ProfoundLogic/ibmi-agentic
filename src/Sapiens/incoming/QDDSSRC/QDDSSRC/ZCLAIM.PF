     A          R ZCLAIMR                   TEXT('Claim Setup Defaults')
     A            ZCLT           3S 0       TEXT('Client/Company')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Co#                 ')
     A            ZGRP           3S 0       TEXT('Group Number')
                                            COLHDG('                    ' +
                                                   '                    ' +
                                                   'Group               ')
     A            ZDLTR          2A         TEXT('Claim Deletion Code')
                                            COLHDG('Claim               ' +
                                                   'Delete              ' +
                                                   ' Code               ')
     A          K ZCLT
     A          K ZGRP
