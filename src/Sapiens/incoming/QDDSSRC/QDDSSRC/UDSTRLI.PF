11   A            STBTDT         8S 0       TEXT('Batch Through Date YYYYMMDD')
12   A            STITYP         3A         TEXT('Insurance Type P&C')
13   A            STRCNT         9S 0       TEXT('Record Count')
14   A            STTAMT        15S 2       TEXT('Total Amount')
15   A            STFILL       563A         TEXT('Filler')
16   A            STUSER        10A         TEXT('User')
17   A            STPGM         10A         TEXT('Program')
