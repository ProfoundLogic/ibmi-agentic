     A                                      REF(FSREFP)
     A          R PPB01                     TEXT('Possible Duplicate Workfile')
     A            PBCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company number')
     A            PBSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('Subscriber number')
     A            PBFND     R               REFFLD(FND)
     A                                      COLHDG('Group number')
     A            PBFYR     R               REFFLD(FYR)
     A                                      COLHDG('Year')
     A            PBCASE    R               REFFLD(CASE)
     A                                      COLHDG('Case number')
     A            PBSS#     R               REFFLD(SS#)
     A                                      COLHDG('Social Security #')
     A            PBACDT    R               REFFLD(DT)
     A                                      COLHDG('Accident Date')
     A            PBEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('EOMB#')
     A            PBDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('Detail Sequence #')
     A            PBFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('Provider FEIN')
     A            PBMOD     R               REFFLD(MOD)
     A                                      COLHDG('Provider Mod')
     A            PBEUSR    R               REFFLD(USER)
     A                                      COLHDG('Entry User')
     A            PBTRDT    R               REFFLD(DT)
     A                                      COLHDG('Transaction date')
     A            PBFDAT    R               REFFLD(DT)
     A                                      COLHDG('From Service date')
     A            PBTDAT    R               REFFLD(DT)
     A                                      COLHDG('To Service date')
     A            PBCODE    R               REFFLD(DS5)
     A                                      COLHDG('Procedure Code')
     A*
     A*           Bill type             Data retrieved from
     A*           FAEOP/EOBTYP = "N"    FDDHP/DHPRCD
     A*           FAEOP/EOBTYP = "H"    FDDUP/DURVCD
     A*
     A            PBPMOD    R               REFFLD(PMOD)
     A                                      COLHDG('Proc code modifier')
     A*
     A*           Bill type             Data retrieved from
     A*           FAEOP/EOBTYP = "N"    FDDHP/DHMOD1
     A*           FAEOP/EOBTYP = "H"    n/a
     A*
     A            PBCHRG    R               REFFLD(A92)
     A                                      COLHDG('Charge amount')
     A            PBPAID    R               REFFLD(A92)
     A                                      COLHDG('Paid amount')
     A            PBSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            PBUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance user')
     A            PBPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance pgm')
     A            PBTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance time')
     A            PBDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance date')
     A            PBIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial user')
     A            PBIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial pgm')
     A            PBITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial time')
     A            PBIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial date')
