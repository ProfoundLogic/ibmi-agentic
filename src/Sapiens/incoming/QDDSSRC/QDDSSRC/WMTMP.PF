     A                                      REF(WREFP)
     A          R PTM01                     TEXT('WCPOLS/WCSTAT Transmittal')
      *
     A            TMCO#          3S 0       COLHDG('COMPANY')
      *
     ****  Del Add  ***  03/07/22  *********************************************
     A***         TMMAIL        31
     A***                                   COLHDG('CONTACT' 'EMAIL ADDR')
      *
     A***         TMNAME        25A         COLHDG('CONTACT NAME')
      *
     A***         TMPHN#        10S 0       COLHDG('CONTACT PHONE#')
      *
     A***         TMEXT#         6S 0       COLHDG('CONTACT EXTENSION')
      *
     A***         TMFAX#        10S 0       COLHDG('CONTACT FAX#')
      *
     A***         TMADR1        60A         COLHDG('CONTACT STREET ADDR')
      *
     A***         TMCTY         30A         COLHDG('CONTACT CITY')
      *
     A***         TMST           2A         COLHDG('CONTACT STATE')
      *
     A***         TMZIP          9S 0       COLHDG('CONTACT ZIP CODE')
      *
     A***         TMFLAG         1A         COLHDG('PROCESS INDICATIOR' +
     A***                                    'P=WCPOLS; S=WCSTAT')
     A*** End Del *** 03/07/22 ********************************************
     ****  Beg Add  ***  03/07/22  *********************************************
     A            TMMAIL        31A         COLHDG('WCPOLS' +
     A                                             'CONTACT EMAIL ADDR')
      *
     A            TMNAME        25A         COLHDG('WCPOLS' +
     A                                             'CONTACT NAME')
      *
     A            TMPHN#        10S 0       COLHDG('WCPOLS' +
     A                                             'CONTACT PHONE#')
      *
     A            TMEXT#         6S 0       COLHDG('WCPOLS' +
     A                                             'CONTACT EXTENSION')
      *
     A            TMFAX#        10S 0       COLHDG('WCPOLS' +
     A                                             'CONTACT FAX#')
      *
     A            TMADR1        60A         COLHDG('WCPOLS' +
     A                                             'CONTACT STREET ADDR')
      *
     A            TMCTY         30A         COLHDG('WCPOLS' +
     A                                             'CONTACT CITY')
      *
     A            TMST           2A         COLHDG('WCPOLS' +
     A                                             'CONTACT STATE')
      *
     A            TMZIP          9S 0       COLHDG('WCPOLS' +
     A                                             'CONTACT ZIP CODE')
      *
     A            TMFLAG         1A         COLHDG('NOT USED')
      *
     A*** End Add *** 03/07/22 ********************************************
