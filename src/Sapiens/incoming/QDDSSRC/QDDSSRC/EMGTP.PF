     A*
     A                                      REF(EREFP)
     A          R PGT01                     TEXT('GERT VALUES')
     A            GTCO#     R               REFFLD(CO#)
     A            GTST      R               REFFLD(ST)
     A                                      COLHDG('STATE' 'CODE')
     A            GTEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            GTGERT         7S 4
     A                                      COLHDG('GERT FACTOR' '5/3')
     A*
     A            GTSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            GTUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            GTPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            GTTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A            GTDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            GTIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            GTIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
