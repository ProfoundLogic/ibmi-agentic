     A***** FILE HOLDS THE IMG DOC ID'S USED.
     A*
     A          R PNX01                     TEXT('IMG DOCS ID"S USED')
     A*
     A****(PREFIX || DATE || "." || IMG#)= IMG DOCID (EX.-PC920115.001)
     A*
     A            NXPREF         2          TEXT('PRE-FIX')
     A            NXDATE         6S 0       TEXT('IMG DATE')
     A            NXIMG#         3S 0       TEXT('NEXT IMG #')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            NXUSER        10          TEXT('USER LAST MAINT')
     A            NXPGM         10          TEXT('LAST MAINT PGM')
     A            NXTIME         6S 0       TEXT('LAST MAINT TIME')
     A            NXDT           6S 0       TEXT('LAST MAINT DATE')
     A            NXFL01         1          TEXT('**FUTURE USE 01 **')
     A            NXFL02         1          TEXT('**FUTURE USE 02 **')
     A            NXFL03         1          TEXT('**FUTURE USE 03 **')
     A            NXFL04         1          TEXT('**FUTURE USE 04 **')
     A            NXFL05         1          TEXT('**FUTURE USE 05 **')
     A*
     A********* KEY FIELDS ******************
     A*
     A          K NXPREF
     A          K NXDATE
     A          K NXIMG#
     A*
