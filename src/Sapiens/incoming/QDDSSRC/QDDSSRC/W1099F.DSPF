     A*%%TS  SD  20000202  153112  ROGULSKI    REL-V4R2M0  5769-PW1
     A                                      CF13
     A                                      SETOF(20)
     A                                      SETOF(21)
     A                                      SETOF(22)
     A                                      SETOF(40)
     A                                      SETOF(72)
     A                                  1  2USER
     A            SCCONM    R        O  1 21REFFLD(NAME)
     A                                      TEXT('COMPANY NAME')
     A                                      DSPATR(HI)
     A                                  1 73DATE
     A                                      EDTCDE(Y)
     A            Q1PGM         10A  O  2  2
     A            SCPRDS    R        O  2 21REFFLD(NAME)
     A                                      TEXT('PROGRAM NAME')
     A                                      DSPATR(HI)
     A                                  2 76'SCR01'
     A                                  4  2'Group:'
     A            SCFND     R        O  4 10REFFLD(FND)
     A                                      EDTCDE(4)
     A            SCNAME    R        O  4 15REFFLD(NM60)
     A                                      TEXT('FUND NAME')
     A                                  6  2'Type information, press Enter.'
     A                                      COLOR(BLU)
     A                                  8  4'Reporting year  . . . . . . . . . -
     A                                      :'
     A            SCYR      R        B  8 40REFFLD(YR4)
     A                                      CHECK(RB)
     A                                      TEXT('CALANDER YEAR FOR 1099S')
     A  20                                  ERRMSGID(WCR0502 *LIBL/WMESGG)
     A                                      EDTCDE(4)
     A                                      DSPATR(HI)
     A  72                                  DSPATR(PC)
     A                                  8 46'(must be 4 digit year)'
     A                                      DSPATR(RI)
     A                                 10  4'Type of 1099''s to generate (P/A/B-
     A                                      ):'
     A            SCCOMM    R        B 10 40REFFLD(FLAG)
     A  21                                  ERRMSGID(WC30205 *LIBL/WMESGG)
     A                                      TEXT('FLAG')
     A                                      DSPATR(HI)
     A                                 10 43'P=Providers'
     A                                 11 43'A=Agents'
     A                                 12 43'B=Both'
     A                                 13  4'Include manual entries  . . .(Y/N)-
     A                                      :'
     A            SCINCL    R        B 13 40REFFLD(FLAG)
     A  22                                  ERRMSGID(WCR0501 *LIBL/WMESGG)
     A                                      DSPATR(HI)
     A                                 15  4'Print option  . . . . . . . . . . -
     A                                      :'
     A            SCPOFL    R        B 15 40REFFLD(FLAG)
     A  40                                  ERRMSGID(WCR1357 *LIBL/WMESGG)
     A                                      TEXT('PRINT OPTION FLAG')
     A                                      DSPATR(HI)
     A                                 15 43'P=Pinfeed forms'
     A                                 16 43'L=Laser forms(3 copies)'
     A                                 23  2'F3=Exit   F13=Chg user parms'
     A                                      COLOR(BLU)
