      *  NVA1P - E & E Provider File
      *****************************************************************
      *                                                               *
      *  DESCRIPTION:                                                 *
      *                                                               *
      *  This file used as "intermediate" between the AMC's provider  *
      *  file and the PDS provider files (FMPDP, FMP1P, NMPHP, NMHSP) *
      *  This will be used in the AMCOH conversion programs.          *
      *                                                               *
      *  CREATED:                                                     *
      *                                                               *
      *  09/18/97 C:61 PROJECT 87MAU                                  *
      *                                                               *
      *****************************************************************
      *                                                               *
      *  REVISIONS:                                                   *
      *                                                               *
      *  XX/XX/XX C:XX PROJECT XXXXX                                  *
      *                XXX.......................................XXX  *
      *                XXX.......................................XXX  *
      *                                                               *
      *****************************************************************
      *
     A                                      REF(FSREFP)
     A          R PA101                     TEXT('E & E PROVIDER FILE')
     A            A1NWCD    R               REFFLD(DS5)
     A                                      COLHDG('NETWORK CODE')
     A            A1TYPE    R               REFFLD(FLAG)
     A                                      COLHDG('PROVIDER TYPE')
      *              F = Facility = 1
      *              P = Professional = 4
      *
     A            A1FEIN    R               REFFLD(DS13)
     A                                      COLHDG('PROVIDER ID')
      *              For 'P': 1st 9 digits of ID are FEIN and last 4 are
      *                       proprietary Anthem modifier.
      *
     A            A1TXID         9P 0
     A                                      COLHDG('FACILITY TAXID')
     A            A1SS#          9P 0
     A                                      COLHDG('PROFESSIONAL SSN')
     A            A1FRDT         8P 0
     A                                      COLHDG('PROVIDER FROM DATE')
     A            A1TODT         8P 0
     A                                      COLHDG('PROVIDER TO DATE')
     A            A1FCNM        26A
     A                                      COLHDG('FACILITY NAME')
     A            A1LSN     R               REFFLD(DS15)
     A                                      COLHDG('LAST NAME')
     A            A1FSN     R               REFFLD(DS10)
     A                                      COLHDG('FIRST NAME')
     A            A1MID     R               REFFLD(MID)
     A                                      COLHDG('MIDDLE INITIAL')
     A            A1NMSX    R               REFFLD(DS4)
     A                                      COLHDG('PHYSICAL NAME SUFFIX')
     A            A1DGR     R               REFFLD(DS4)
     A                                      COLHDG('PHYSICAL DEGREE')
     A            A1DGSX    R               REFFLD(DS8)
     A                                      COLHDG('PHYSICAL DEGREE' 'SUFFIX')
     A            A1BSSX    R               REFFLD(DS4)
     A                                      COLHDG('PHYSICAL BUSINESS' 'SUFFIX')
     A            A1GRNM        26A
     A                                      COLHDG('GROUP NAME')
     A            A1MAIL    R               REFFLD(FLAG)
     A                                      COLHDG('MAIL INDICATOR')
     A            A1PAD1    R               REFFLD(DS25)
     A                                      COLHDG('PHYSICAL ADDRESS 1')
     A            A1PAD2    R               REFFLD(DS25)
     A                                      COLHDG('PHYSICAL ADDRESS 2')
     A            A1PCTY        16A
     A                                      COLHDG('PHYSICAL CITY')
     A            A1PST     R               REFFLD(ST)
     A                                      COLHDG('PHYSICAL STATE')
     A            A1PSTD        18A
     A                                      COLHDG('PHYSICAL STATE DESC')
     A            A1PZIP    R               REFFLD(DS9)
     A                                      COLHDG('PHYSICAL ZIP CODE')
     A            A1CNT     R               REFFLD(DS3)
     A                                      COLHDG('COUNTY CODE')
     A            A1CNTD    R               REFFLD(DS17)
     A                                      COLHDG('COUNTY DESC')
     A            A1PPHN    R               REFFLD(A100)
     A                                      COLHDG('PHYSICAL AREA CODE')
     A            A1MNM1        26A
     A                                      COLHDG('MAIL/REMIT NAME 1')
     A            A1MNM2        26A
     A                                      COLHDG('MAIL/REMIT NAME 2')
     A            A1MAD1    R               REFFLD(DS25)
     A                                      COLHDG('MAIL/REMIT ADDRESS 1')
     A            A1MAD2    R               REFFLD(DS25)
     A                                      COLHDG('MAIL/REMIT ADDRESS 2')
     A            A1MCTY    R               REFFLD(DS16)
     A                                      COLHDG('MAIL/REMIT CITY')
     A            A1MST     R               REFFLD(ST)
     A                                      COLHDG('MAIL/REMIT STATE' 'CODE')
     A            A1MSTD        18A
     A                                      COLHDG('MAIL/REMIT STATE' 'DESC')
     A            A1MZIP    R               REFFLD(DS9)
     A                                      COLHDG('MAIL/REMIT ZIP' 'CODE')
     A            A1MCTR    R               REFFLD(DS3)
     A                                      COLHDG('MAIL/REMIT COUNTRY')
     A            A1MCON        26A
     A                                      COLHDG('MAIL/REMIT CONTACT' 'NAME')
     A            A1MPHN    R               REFFLD(A100)
     A                                      COLHDG('MAIL/REMIT AREA CODE')
     A            A1FAX#    R               REFFLD(A100)
     A                                      COLHDG('MAIL/REMIT FAX' 'AREA CODE')
     A            A1SP1     R               REFFLD(DS3)
     A                                      COLHDG('SPECIALTY 1 CODE')
     A            A1SP1D    R               REFFLD(DS17)
     A                                      COLHDG('SPECIALTY 1 CODE' 'DESC')
     A            A1SP2     R               REFFLD(DS3)
     A                                      COLHDG('SPECIALTY 2 CODE')
     A            A1SP2D    R               REFFLD(DS17)
     A                                      COLHDG('SPECIALTY 2 CODE' 'DESC')
     A            A1SP3     R               REFFLD(DS3)
     A                                      COLHDG('SPECIALTY 3 CODE')
     A            A1SP3D    R               REFFLD(DS17)
     A                                      COLHDG('SPECIALTY 3 CODE' 'DESC')
     A            A1CNT#    R               REFFLD(A50)
     A                                      COLHDG('CONTRACT NUMBER')
     A            A1RTYP    R               REFFLD(A30)
     A                                      COLHDG('REIMBURSEMENT TYPE')
     A            A1RMTH    R               REFFLD(A30)
     A                                      COLHDG('REIMBURSEMENT' -
     A                                      'METHOD CODE')
     A            A1RMTD    R               REFFLD(DS16)
     A                                      COLHDG('REIMBURSEMENT' -
     A                                      'METHOD DESC')
     A            A1STYP    R               REFFLD(FLAG)
     A                                      COLHDG('PLACE OF SERVICE')
      *              1 = Inpatient  ==> "IN"
      *              2 = Outpatient ==> "OUT"
      *
     A            A1DISP         6P 2
     A                                      COLHDG('METHOD VALUE /' -
     A                                      'CHARGE VALUE')
      *              Percent different from 100% for pricing file
      *
     A            A1PLAT    R               REFFLD(FLAG)
     A                                      COLHDG('PLATINUM PROVIDER')
     A            A1NSDT    R               REFFLD(A80)
     A                                      COLHDG('NETWORK START DATE')
      *              CCYYMMDD
      *
     A            A1NEDT    R               REFFLD(A80)
     A                                      COLHDG('NETWORK END DATE')
      *              CCYYMMDD
      *
     A            A1PLOC    R               REFFLD(FLAG)
     A                                      COLHDG('WC PRIMARY' -
     A                                      'LOCATION' 'CODE')
     A            A1OCC     R               REFFLD(FLAG)
     A                                      COLHDG('OCC CENTER FLAG')
     A            A1EXDT    R               REFFLD(A80)
     A                                      COLHDG('EXTRACT DATE')
      *              CCYYMMDD
      *
     A            A1FILL    R               REFFLD(DS6)
     A                                      COLHDG('FILLER')
     A            A1GSEQ        15P 0
     A                                      COLHDG('GENERIC SEQUENCE' -
     A                                      'NUMBER')
     A            A1CONV    R               REFFLD(FLAG)
     A                                      COLHDG('ASSIGNMENT')
      *              E = Assignment not made
      *              L = Assignment made
      *              U = Updated
      *
     A            A1FEI2         9P 0
     A                                      COLHDG('ASSIGNED FEIN')
     A            A1MOD     R               REFFLD(A30)
     A                                      COLHDG('ASSIGNED MODIFIER')
      *
     A            A1STAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            A1USER    R               REFFLD(USER)
     A                                      COLHDG('CVT USER')
     A            A1PGM     R               REFFLD(PGM)
     A                                      COLHDG('CVT PROGRAM')
     A            A1TIME    R               REFFLD(TIME)
     A                                      COLHDG('CVT TIME')
     A            A1DT      R               REFFLD(DT7)
     A                                      COLHDG('CVT DATE')
     A            A1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL CVT' 'USER')
     A            A1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL CVT' 'PROGRAM')
     A            A1ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL CVT' 'TIME')
     A            A1IDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL CVT' 'DATE')
