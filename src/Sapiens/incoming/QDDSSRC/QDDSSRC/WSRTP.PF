     A                                      REF(WREFP)
     A          R PRT01                     TEXT('BANK ROUTING FILE')
     A            RTCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company')
     A            RTKEY         10A         COLHDG('Routing Information')
     A            RTCMWC    R               REFFLD(FLAG)
     A                                      COLHDG('Combine EFT - WC')
     A            RTCMWP    R               REFFLD(FLAG)
     A                                      COLHDG('Combine EFT - WP')
     A            RTCMAG    R               REFFLD(FLAG)
     A                                      COLHDG('Combine EFT - AG')
     A            RTSPAD    R               REFFLD(FLAG)
     A                                      COLHDG('Suppress Addenda Rec')

     A            RTIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            RTITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            RTIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            RTIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PROGRAM')
     A            RTDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE DATE')
     A            RTTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE TIME')
     A            RTUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE USER')
     A            RTPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE PROGRAM')

