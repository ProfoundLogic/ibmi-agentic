     A                                      COLHDG('RUN DATE')
     A            LSPREV    R               REFFLD(A112)
     A                                      COLHDG('PREVIOUS' 'PAID TO DATE')
     A            LSPMTS    R               REFFLD(A112)
     A                                      COLHDG('PAYMENTS' 'CURRENT MONTH')
     A            LSRECV    R               REFFLD(A112)
     A                                      COLHDG('CURRENT RECOVERIES')
     A            LSADJ     R               REFFLD(A112)
     A                                      COLHDG('CURRENT ADJUSTMENTS')
     A            LSRSVO    R               REFFLD(A112)
     A                                      COLHDG('OPEN RESERVES')
     A            LSTLEX    R               REFFLD(A112)
     A                                      COLHDG('EXCESS' 'OVER RETENTION')
     A            LSSDF     R               REFFLD(A112)
     A                                      COLHDG('SDF AMOUNT')
     A            LSEAPR    R               REFFLD(A112)
     A                                      COLHDG('EARNED PREMIUM')
     A            LSAGGR    R               REFFLD(A112)
     A                                      COLHDG('AGGREGATE AMT')
     A            LSATTP    R               REFFLD(PC52)
     A                                      COLHDG('ATTACHMENT POINT')
     A            LSTLCL    R               REFFLD(CNT)
     A                                      COLHDG('TOTAL CLAIMS')
     A            LSOPEN    R               REFFLD(CNT)
     A                                      COLHDG('OPEN CLAIMS')
     A            LSSPPD    R               REFFLD(A112)
     A                                      COLHDG('SPECIFIC PAID')
     A            LSSTAT    R               REFFLD(STAT)
     A            LSUSER    R               REFFLD(USER)
     A            LSPGM     R               REFFLD(PGM)
     A            LSTIME    R               REFFLD(TIME)
     A            LSDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*
     A            LSPOL#        13          COLHDG('POLICY NUMBER')
     A            LSCLM#        12          COLHDG('FULL CLAIMANT NUMBER')
     A            LSCLID         5          COLHDG('CLAIMANT ID')
     A            LSCC      R               REFFLD(CODE)
     A                                      COLHDG('SECTION CODE')
     A            LSVAL     R               REFFLD(FLAG)
     A                                      COLHDG('COVERAGE VALUE')
     A            LSLOC#         3  0       COLHDG('LOCATION NUMBER')
     A            LSPRM#         3  0       COLHDG('PREMISIS #')
     A            LSCOVF         1          COLHDG('COV CODE FIRE ISO')
     A            LSSUBL         3          COLHDG('SUBLINE ISO')
     A            LSCLAS         6          COLHDG('CLASS CODE ISO')
     A            LSCOVL    R               REFFLD(FLAG)
     A                                      COLHDG('COV LINE' 'AUTO, L,M,U')
     A            LSITM#    R               REFFLD(AGT#)
     A                                      COLHDG('VEH OR ITM #')
     A            LSFRM     R               REFFLD(CODE)
     A                                      COLHDG('FORM CODE ISO')
     A            LSRTGP    R               REFFLD(CODE)
     A                                      COLHDG('RATE GROUP ISO')
     A            LSEMP#    R               REFFLD(EMP#)
     A            LSDIV     R               REFFLD(DIV)
     A            LSEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
