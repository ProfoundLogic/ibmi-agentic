     A*                 CorVel Network format changes
     A*                 1. Increase size of CAIPID
     A*****************************************************************
     A**
     A                                      REF(FSREFP)
     A          R PCP01                     TEXT('CORVEL PPO/PROV AUDIT FILE')
     A            CPID          10          TEXT('IRS ID Number for provider')
     A            CPEXT          3          TEXT('CorVel Extension')
     A            CPNAMS        12          TEXT('First 12 Char of last name')
     A            CPNAME        40          TEXT('Name - first last title')
     A            CPBADR        50          TEXT('Mailing Address')
     A            CPBCTY        25          TEXT('Mailing City')
     A            CPBST          2          TEXT('Mailing State Code')
     A            CPBZIP         9          TEXT('Mailing Zip')
     A            CPPADR        50          TEXT('Geographical Address')
     A            CPPCTY        25          TEXT('Geographical City')
     A            CPPST          2          TEXT('Geographical State Code')
     A            CPPZIP         9          TEXT('Geographical Zip Code')
     A            CPPHN         10          TEXT('Phone Number')
     A            CPSPEC         4          TEXT('Speciality Type')
     A            CPLIC          9          TEXT('Physician''s License Number')
     A            CPIDTY         1          TEXT('Type of Provider ID')
     A*                                     T = EIN#
     A*                                     S = Social Security Number
     A            CPEFDT         8          TEXT('Contract effective MDY')
     A            CPTRDT         8          TEXT('Contract termination MDY')
     A            CPAFEE        10          TEXT('Alternate fee schedule ID')
     A            CPMRA          5          TEXT('Discount % off fee schedule')
     A            CPUC           5          TEXT('U&C Discount %')
     A            CPCHG          5          TEXT('Billed amount discount %')
     A            CPCND          2          TEXT('Discount condition')
     A*                                     LS = Take lesser of discounts
     A*                                     FS = Use fee sched and PPO discount
     A*                                     GT = Take greater of discounts
     A            CPCAP          9          TEXT('Discount cap - max disc')
     A*** BEGIN CHG *** 10/12/99 **************************************
     A********    CPIPID        24          TEXT('PPO''s internal provider ID')
     A            CPIPID        25          TEXT('PPO''s internal provider ID')
     A*** END CHG *** 10/12/99 ****************************************
     A            CPIFEE        10          TEXT('Inpatient alt fee sched ID')
     A            CPIPER         5          TEXT('Inpatient discount %')
     A            CPIUC          5          TEXT('Inpatient U&C discount %')
     A            CPICHG         5          TEXT('Inpatient bill amt discnt %')
     A            CPICND         2          TEXT('Inpatient discount condition')
     A*                                     LS = Take lesser of discounts
     A*                                     FS = Use fee sched and PPO discount
     A*                                     GT = Take greater of discounts
     A            CPICAP         5          TEXT('Inpatient discount cat')
     A            CPISL          5          TEXT('Inpatient stop loss %')
     A            CPIMD          5          TEXT('Inpatient max discount %')
     A            CPIDAY         3          TEXT('Inpatient discount days')
     A            CPACID        10          TEXT('Alt conversion factor ID')
     A            CPICID        10          TEXT('Inpatient alt conv factor ID')
     A            CPCPPO        10          TEXT('CorVel PPO Identifer')
     A            CPCVID        24          TEXT('CorVel provider identifer')
     A*
     A*-------------------------------------------------------------------------
     A*           The following fields are used for PDS audit tracking
     A*-------------------------------------------------------------------------
     A            CPGSEQ        15P 0       TEXT('Generic Sequence #')
     A            CPCONV    R               REFFLD(FLAG)
     A                                      COLHDG('Status of Assignment')
     A*                                            A = Assignment made by user
     A*                                            E = Assignment not made
     A*                                            L = Assignment made by NPEN
     A*                                            U = Update done by NPEN
     A            CPFEI2    R               REFFLD(FEIN)
     A                                      COLHDG('Assigned FEIN')
     A            CPMOD2    R               REFFLD(MOD)
     A                                      COLHDG('Assigned Modifer')
     A            CPUSER    R               REFFLD(USER)
     A                                      COLHDG('Cvt User')
     A            CPPGM     R               REFFLD(PGM)
     A                                      COLHDG('Cvt Pgm')
     A            CPTIME    R               REFFLD(TIME)
     A                                      COLHDG('Cvt Time')
     A            CPDT      R               REFFLD(DT7)
     A                                      COLHDG('Cvt Date')
     A            CPIUSR    R               REFFLD(USER)
     A                                      COLHDG('Init Cvt User')
     A            CPIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Init Cvt Pgm')
     A            CPITIM    R               REFFLD(TIME)
     A                                      COLHDG('Init Cvt Time')
     A            CPIDT     R               REFFLD(DT7)
     A                                      COLHDG('Init Cvt Date')
