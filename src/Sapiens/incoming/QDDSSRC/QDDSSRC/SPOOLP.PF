     A** FAX/400 SPOOL FILE INFORMATION
     A**
     A          R SPLFRCD                   TEXT('Spool File/FAX Information')
     A            FILNAM        10          TEXT('File name')
     A            JOBNAM        10          TEXT('Job name')
     A            JOBNUM         6          TEXT('Job number')
     A            FILNUM         4S 0       TEXT('File number')
     A            USRNAM        10          TEXT('User name')
     A            FRMTYP        10          TEXT('Form type')
     A            USRDTA        10          TEXT('User Data')
     A            STATUS        10          TEXT('Spool File Status')
     A            HLDF          10          TEXT('Hold Spool File?')
     A            SAVF          10          TEXT('Save Spool File?1')
     A            TOTPAG         4S 0       TEXT('Total pages')
     A            PAGWRT         4S 0       TEXT('# pages written')
     A            STRPAG         4S 0       TEXT('Starting page')
     A            ENDPAG         4S 0       TEXT('Ending page')
     A            LASPAG         4S 0       TEXT('Last page')
     A            TOTCPY         4S 0       TEXT('Total copies')
     A            CPYLFT         4S 0       TEXT('# copies left')
     A            OUTPRI         2          TEXT('Output priority')
     A            OUTQNM        10          TEXT('Output queue name')
     A            OUTQLB        10          TEXT('Output queue library')
     A            DATFOP         7          TEXT('Date file opened')
     A            TIMFOP         6          TEXT('Time file opened')
     A            PGMOPF        10          TEXT('Pgm that opened file')
     A            PGMOPL        10          TEXT('Library that opened file')
     A            PRTTXT        30          TEXT('Print Text')
     A            RCDLEN         4S 0       TEXT('Record length')
     A            PAGLEN         4S 0       TEXT('Page length')
     A            PAGWID         4S 0       TEXT('Page width')
     A            NUMSEP         4S 0       TEXT('# of separators')
     A            FORNAM        10          TEXT('Form name')
     A            FORLIB        10          TEXT('Form library')
     A            TOTRCD         4S 0       TEXT('Total records')
     A            RCDSTS         1          TEXT('Record Status')
     A            LMUSER        10          TEXT('Last Maint User')
     A            LMPGM         10          TEXT('Last Maint Pgm')
     A            LMTIME         6S         TEXT('Last Maint Time')
     A            LMDT           6S         TEXT('Last Maint Date')
