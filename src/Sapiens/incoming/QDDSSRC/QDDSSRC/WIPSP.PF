     A                                      REF(WREFP)
     A          R PPS01                     TEXT('3rd Party Payment Service')
     A            PSCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company #')
     A            PSFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group #')
     A            PSEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            PSSERVICER    30A         COLHDG('3RD PARTY' +
     A                                      'Servicer')
     A            PSOPTFLAG R               REFFLD(FLAG)
     A                                      COLHDG('Opt In/Opt Out')
     A            PSPAPER        7S 0       COLHDG('Paperless Start' +
     A                                      'Date')
     A            PSAUTOPAY      7S 0       COLHDG('Autopay Start' +
     A                                      'Date')
     A            PSQTEXFER       Z         COLHDG('Quote Transfer' +
     A                                      'Timestamp')
     A            PS3PTYUPD       Z         COLHDG('Quote Transfer' +
     A                                      '3rd Party Update' +
     A                                      'Timestamp')
     A            PSSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            PSUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            PSPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            PSTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            PSDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            PSIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            PSIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            PSITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            PSIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
