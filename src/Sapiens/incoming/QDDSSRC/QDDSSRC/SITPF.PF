     A                                      REF(SREFP)
     A          R PIT01                     TEXT('ITP interface control')
     A            ITUSE     R               REFFLD(FLAG)
                                            COLHDG('Use' +
                                                   'ITP' +
                                                   '                    ')
     A            ITPRCSVR  R               REFFLD(NM10)
                                            COLHDG('ITP' +
                                                   'processing' +
                                                   'server')
     A            ITDOCSTG  R               REFFLD(NM50)
                                            COLHDG('ITP document' +
                                                   'storage' +
                                                   'server')
     A            ITDOCDIR  R               REFFLD(NM50)
                                            COLHDG('ITP' +
                                                   'document' +
                                                   'directory')
     A            ITTMPDIR  R               REFFLD(NM50)
                                            COLHDG('ITP' +
                                                   'temporary' +
                                                   'directory')
      *
      *  Standard maintenance fields
      *
     A            ITPGM     R               REFFLD(NM10)
                                            COLHDG('Program' +
                                                   'maintained' +
                                                   '                    ')
     A            ITUSER    R               REFFLD(NM10)
                                            COLHDG('Maintained' +
                                                   'by' +
                                                   '                    ')
     A            ITDT      R               REFFLD(DT)
                                            COLHDG('Date' +
                                                   'maintained' +
                                                   '                    ')
     A            ITTIME    R               REFFLD(TIME)
                                            COLHDG('Time' +
                                                   'maintained' +
                                                   '                    ')
