     A*
     A*  EDI Medical 824 Header file
     A*
     A                                      REF(FSREFP)
     A*
     A          R PAH01                     TEXT('EDI Med 824 Header Format')
     A            AHTHDR         3A         COLHDG('TRANSACTION ID')
     A            AHSEIN        15A         COLHDG('SENDER FEIN')
     A            AHFIL1         1A         TEXT('FILLER')
     A            AHSZP          9A         COLHDG('SENDER POSTAL CODE')
     A            AHREIN        15A         COLHDG('RECEIVER FEIN')
     A            AHFIL2         1A         TEXT('FILLER')
     A            AHRZP          9A         COLHDG('RECEIVER POSTAL CODE')
     A            AHLTDT         8A         COLHDG('DATE TRANS SENT')
     A            AHLTTM         6A         COLHDG('TIME TRANS SENT')
     A            AHOTDT         8A         COLHDG('ORIGINAL TRANS DATE')
     A            AHOTTM         6A         COLHDG('ORIGINAL TRANS TIME')
     A            AHTPFG         1A         COLHDG('TEST/PRODUCTION' 'FLAG')
     A            AHTSET         3A         COLHDG('TRANSACTION SET ID')
     A            AHRLS#         2A         COLHDG('RELEASE NUMBER')
     A            AHAGCD         2A         COLHDG('AGENCY CODE')
     A            AHRPER        16A         COLHDG('REPORTING PERIOD')
     A            AHTYPE         2A         COLHDG('TRANSMISSION TYPE')
     A            AHSTAT         1A         COLHDG('LAST TRANS STATUS')
     A            AHERRF         1A         TEXT('ERROR FLAG')
     A            AHRCNT         9A         TEXT('RECORD COUNT')
     A            AHCO#     R               REFFLD(CO#)
     A            AHJST     R               REFFLD(ST)
     A                                      COLHDG('JURISDICTION' 'STATE')
     A            AHAKDT    R               REFFLD(DT)
     A                                      COLHDG('ACKNOWLEDGEMENT DATE')
     A            AHPROC         1A         COLHDG('PROCESSED FLAG (Y/N)')
