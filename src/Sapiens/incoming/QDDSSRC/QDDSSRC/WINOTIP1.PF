     A                                      REF(WREFP)
     A          R PN101                     TEXT('Portal Consumer -
     A                                      Configuration')
     A            N1CO#     R     S         REFFLD(CO#)
     A            N1PORTIP      60A         COLHDG('Portal IP Address')
     A            N1RETRIES      2S 0       COLHDG('Notification Retry ' -
                                            'Limit')
     A            N1LCKRSBMT     1A         COLHDG('Lock S/R Resubmit')
     A            N1ALLWPEND     1A         COLHDG('Allow S/R Pending ' -
     A                                      'Payment')
     A            N1INCLPEND     1A         COLHDG('Include Pending ' -
                                            'In Balance')
     A            N1USER    R               REFFLD(USER)
     A            N1PGM     R               REFFLD(PGM)
     A            N1DT      R               REFFLD(DT)
     A            N1TIME    R               REFFLD(TIME)
     A            N1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            N1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PROGRAM')
     A            N1IDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            N1ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            N1ALWCX        1A         COLHDG('Allow S/R' -
     A                                      'Cancelled')
     A            N1ALWCXPND     1A         COLHDG('Allow S/R' -
     A                                      'Cancel Pending')
     A            N1DFTUW       10A         COLHDG('Default' -
     A                                      'Underwriter')
     A            N1PMTCXPND     1A         COLHDG('Allow Payment' -
     A                                      'Cancel Pending')
     A***** Beg Add ***** 08/02/21 *****************************
     A            N1SCRVND      25A         COLHDG('Scoring' -
     A                                      'Vendor')
     A            N1SCRVNDEFR     S         REFFLD(DT)
     A                                      COLHDG('Scoring Vendor' -
     A                                      'Effective Date')
     A***** End Add ***** 08/02/21 *****************************
     A
     A          K N1CO#
