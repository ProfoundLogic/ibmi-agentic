     A*  PROJECT:  SY371        PROGRAMMER:  C:65                     *
     A*  CREATED:  08/04/16                                           *
     A*  DESCRIPTION:  THIS FILE HOLDS ANY ADDITIONAL TEMPLATES THAT  *
     A*                ARE NEEDED FOR THE CREATION OF A DOCUMENT.     *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 02/06/25 C:291 Support: 118418                                *
     A*                Add Co#, Fnd, Emp#, Div, Year and Data flag.   *
     A*                                                               *
     A* 02/08/18 C:65  PROJECT: 148WAT                                *
     A*                ADD PAGE BUNDLE FIELD.                         *
     A*                                                               *
     A* 11/08/17 C:65  PROJECT: 150WCC                                *
     A*                ADD GENERATE FROM PDF FLAG.                    *
     A*                                                               *
     A* 10/24/17 C:65  PROJECT: 150WBW                                *
     A*                ADD IMAGE FILE NAME FIELDS FOR FORM SPECIFIC   *
     A*                SIGNATURES (PRIMARY AND SECONDARY) AND ADD     *
     A*                                                               *
     A* 09/21/16 C:65  PROJECT: SY371                                 *
     A*                ADD AN ORDER FIELD TO SEQUENCE THE TEMPLATES.  *
     A*                                                               *
     A* 09/15/16 C:65  PROJECT: SY371                                 *
     A*                ADD PATH FIELD FOR LOGO.                       *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SREFP)
     A          R XT100                     TEXT('XML TEMPLATE PREP FILE')
     A            XTFILE        60A         COLHDG('OUTPUT FILE NAME')
     A            XTXMLT        60A         COLHDG('XML FILE NAME')
     A            XTXMLF       100A         COLHDG('XML FOLDER NAME')
     A            XTTYPE       100A         COLHDG('TYPE OF PROCESS')
     A            XTCAT     R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT CATEGORY')
     A            XTSUBC    R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT' 'SUB CATEGORY')
     A            XTDCID        60A         COLHDG('DOCUMENT TEMPLATE')
     A            XTINTR    R               REFFLD(FLAG)
     A                                      COLHDG('INTERACTIVE DOCUMENT')
     A            XTINID        60A         COLHDG('INTERACTIVE DOC ID')
     A            XTPATH       250A         COLHDG('NON-INTERACTIVE' 'DOC PATH')
     A            XTLANG        40A         COLHDG('DOCUMENT LANGUAGE')
     A            XTUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            XTPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            XTTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            XTDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            XTLOGO       100A         COLHDG('LOGO NAME')
     A            XTSIG        100A         COLHDG('SIGNATURE NAME')
     A            XTTEMPIFS    250A         COLHDG('TEMPORARY' 'IFS FLR')
     A            XTTEMPWIN    250A         COLHDG('TEMPORARY' 'WIN DIR')
     A            XTTEXT1      250A         COLHDG('FREEFORM TEXT 1')
     A            XTTEXT2      250A         COLHDG('FREEFORM TEXT 2')
     A            XTTEXT3      250A         COLHDG('FREEFORM TEXT 3')
     A*** BEGIN ADD ***  09/15/16  *********************************************
     A            XTLOGOPTH    250A         COLHDG('LOGO PATH')
     A*** END ADD *****  09/15/16  *********************************************
     A*** BEGIN ADD ***  09/21/16  *********************************************
     A            XTORDER        5S 0
     A                                      COLHDG('TEMPLATE ORDER')
     A*** END ADD *****  09/21/16  *********************************************
     A*** BEGIN ADD ***  10/24/17  *********************************************
     A            XTSIG2       100A         COLHDG('SIGNATURE NAME #2')
     A            XTFRMSIG     100A         COLHDG('FORM SIGNATURE NAME')
     A            XTFRMSIG2    100A         COLHDG('FORM SIGNATURE NM #2')
     A*** END ADD *****  10/24/17  *********************************************
     A*** BEGIN ADD ***  11/08/17  *****************************************
     A            XTGPDF         1          COLHDG('GENERATE FROM PDF')
     A*** END ADD *****  11/08/17  *****************************************
     A*** BEGIN ADD ***  02/08/18  *****************************************
     A            XTBUNDLE       5S 0       COLHDG('PAGE BUNDLE INDEX')
     A*** END ADD *****  02/08/18  *****************************************
     A*** Beg Add *****  02/06/25  *****************************************
     A            XTCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('COMPANY #')
     A            XTFND     R     S         REFFLD(FND)
     A                                      COLHDG('FUND')
     A            XTEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER #')
     A            XTDIV     R     S         REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A            XTFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            XTDATA    R               REFFLD(FLAG)
     A                                      COLHDG('WORKFILE DATA' 'REQUESTED')
     A*** End Add *****  02/06/25  *****************************************
