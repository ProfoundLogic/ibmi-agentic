     A            RWCOM2        30A         COLHDG('Comment #2')
     A            RWCOM3        30A         COLHDG('Comment #3')
     A            RWCOM4        30A         COLHDG('Comment #4')
     A            RWCOM5        30A         COLHDG('Comment #5')
     A            RWNOPAY        1A         COLHDG('No Payroll Flag')
     A            RWEXM1    R     S         REFFLD(PC54)
     A                                      COLHDG('Exp. Mod #1')
     A            RWEXM2    R     S         REFFLD(PC54)
     A                                      COLHDG('Exp. Mod #2')
