     A** WCMC TREATMENT REPORT TRANSACTION FILE                       *
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*  08/25/97 C:31  Project: 87MAZ  CO# 49
     A*                 Remove treatment report fields
     A*                 1/ Add comments that following fields are no
     A*                    longer used by client.
     A*                    . MCO Response within 24 hours
     A*                    . Appropriate referal made
     A*                 2/ Add treatment provider name (missing from
     A*                    the AMC version)
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PTX01                     TEXT('TREATMENT RPT TRANS FILE')
     A            TXCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            TXSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER NUMBER')
     A            TXFND     R               REFFLD(FND)
     A                                      COLHDG('FUND NUMBER')
     A            TXFYR     R               REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            TXCASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE NUMBER')
     A            TXFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('TREATING PROV FEIN')
     A            TXMOD     R               REFFLD(MOD)
     A                                      COLHDG('TREATING PROV MOD')
     A            TXR24     R               REFFLD(FLAG)
     A*           >>> Field no longer used by client <<<
     A                                      COLHDG('MCO RESPONSE 24HRS?')
     A*                          VALID VALUES = Y OR N OR U
     A            TXICMP    R               REFFLD(FLAG)
     A                                      COLHDG('DATA COMPL/ACCURATE?')
     A*                          VALID VALUES = Y OR N
     A            TXILEG    R               REFFLD(FLAG)
     A                                      COLHDG('INFO LEGIBLE?')
     A*                          VALID VALUES = Y OR N
     A            TXIFAX    R               REFFLD(FLAG)
     A                                      COLHDG('INFO FAXED ON TIME?')
     A*                          VALID VALUES = Y OR N OR U OR A
     A            TXRINJ    R               REFFLD(FLAG)
     A                                      COLHDG('WAS THIS A REINJURY?')
     A*                          VALID VALUES = Y OR N OR U OR A
     A            TXAREF    R               REFFLD(FLAG)
     A*           >>> Field no longer used by client <<<
     A                                      COLHDG('APPROPRIATE REFERRAL')
     A*                          VALID VALUES = Y OR N OR U OR A
     A            TXR48     R               REFFLD(FLAG)
     A                                      COLHDG('SPECIALIST REF 48HRS')
     A*                          VALID VALUES = Y OR N OR U OR A
     A            TXR45     R               REFFLD(FLAG)
     A                                      COLHDG('PATIENT SEEN 45MIN?')
     A*                          VALID VALUES = Y OR N OR U OR A
     A            TXITDT    R               REFFLD(DT)
     A                                      COLHDG('INITIAL TREAT DATE')
     A*                          AKA APPOINTMENT DATE
     A            TXTVST    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE OF VISIT')
     A*                          VALID VALUES = E = ER
     A*                                         S = SPECIALIST
     A*                                         O = OCC
     A            TXRFTX    R               REFFLD(FLAG)
     A                                      COLHDG('REFUSAL OF TREAT')
     A*                          VALID VALUES = Y OR N
     A*       THIS FIELD IS NOT USED AT THIS TIME
     A            TXSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            TXUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            TXPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            TXTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            TXDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            TXIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            TXIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            TXITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            TXIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A*** BEGIN ADD ** 08/25/97 ************************************************
     A            TXPNAM    R               REFFLD(NAME)
     A                                      COLHDG('PROVIDER NAME')
     A*** END ADD ** 08/25/97 **************************************************
