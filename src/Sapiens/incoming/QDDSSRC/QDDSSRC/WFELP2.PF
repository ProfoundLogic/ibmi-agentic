     A                                      REF(WREFP)
     A          R PEL201                    TEXT('Excess Loss Report Mth File')
     A            EL2CO#    R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            EL2FND    R     S         REFFLD(FND)
     A                                      COLHDG('Group')
     A            EL2EMP#   R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer')
     A            EL2DIV    R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            EL2FYR    R     S         REFFLD(FYR)
     A                                      COLHDG('Policy Year')
     A            EL2CNAM       40A         COLHDG('Company Name')
     A            EL2FNAM       60A         COLHDG('Group Name')
     A            EL2ENAM      100A         COLHDG('Employer Name')
     A            EL2RGN#        3S 0       COLHDG('Region#')
     A            EL2RNAM       40A         COLHDG('Region# Name')
     A            EL2PREM       11S 2       COLHDG('Premium')
     A            EL2MONTH       9A         COLHDG('Month')
     A            EL2YEAR        4S 0       COLHDG('Year')
     A            EL2OVRF        1A         COLHDG('Overflow')
     A            EL2LSR         8S 3       COLHDG('Loss Ratio')
     A            EL2USER   R               REFFLD(USER)
     A                                      COLHDG('Report User')
     A            EL2PGM    R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            EL2DT     R     S         REFFLD(DT7)
     A                                      COLHDG('Maintenance Date')
     A            EL2TIME   R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
