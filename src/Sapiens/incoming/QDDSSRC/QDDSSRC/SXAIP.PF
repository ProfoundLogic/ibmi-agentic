     A                                      REF(SREFP)
     A          R PAI01                     TEXT('Scriptura Additional -
     A                                      Medical Info File')
     A*
     A            AIXML         60A         COLHDG('Unique XML File' -
     A                                      ' Name Key')
     A            AICO#          3S 0       COLHDG('Company #')
     A            AIFND          3S 0       COLHDG('Group #')
     A            AIFYR          3S 0       COLHDG('Year')
     A            AICASE         7S 0       COLHDG('Case')
     A* Header Information
     A            AIACL#        25A         COLHDG('IC File #')
     A            AICLM#        25A         COLHDG('Carrier File #')
     A            AIEFEI         9S 0       COLHDG('Employer FEIN')
     A* Claim Information
     A            AICFSN        15A         COLHDG('Claimant First Name')
     A            AICMID         1A         COLHDG('Claimant Middle Init')
     A            AICLSN        30A         COLHDG('Claimant Last Name')
     A            AICAD1        40A         COLHDG('Claimant Address 1')
     A            AICAD2        40A         COLHDG('Claimant Address 2')
     A            AICCTY        25A         COLHDG('Claim City')
     A            AICST          2A         COLHDG('Claim State')
     A            AICZIP         9S 0       COLHDG('Claim Zip Code')
     A            AICAREA        3S 0       COLHDG('Claimant Area Code')
     A            AICPHN#        7S 0       COLHDG('Claimant Phone #')
     A            AIWAREA        3S 0       COLHDG('Work Area Code')
     A            AIWPHN#        7S 0       COLHDG('Work Phone #')
     A            AISS#          9A         COLHDG('SS#')
     A            AISEX          1A         COLHDG('Gender')
     A            AIDTOB         8S 0       COLHDG('Date of Birth')
     A* Employer Information
     A            AIENAM        40A         COLHDG('Employer Name')
     A            AIEAREA        3S 0       COLHDG('Employer Area Code')
     A            AIEPHN#        7S 0       COLHDG('Employer Phone #')
     A            AIEMAD1       40A         COLHDG('Employer Mailing' -
     A                                      ' Address 1')
     A            AIEMAD2       40A         COLHDG('Employer Mailing' -
     A                                      ' Address 2')
     A            AIEMCTY       25A         COLHDG('Employer Mailing' -
     A                                      ' City')
     A            AIEMST         2A         COLHDG('Employer Mailing' -
     A                                      ' State')
     A            AIEMZIP        9S 0       COLHDG('Employer Mailing' -
     A                                      ' Zip')
     A            AIEPAD1       40A         COLHDG('Employer Physical' -
     A                                      ' Address 1')
     A            AIEPAD2       40A         COLHDG('Employer Physical' -
     A                                      ' Address 2')
     A            AIEPCTY       25A         COLHDG('Employer Physical' -
     A                                      ' City')
     A            AIEPST         2A         COLHDG('Employer Physical' -
     A                                      ' State')
     A            AIEPZIP        9S 0       COLHDG('Employer Physical' -
     A                                      ' Zip')
     A* Insurance Carrier Information
     A            AIFNAME       60A         COLHDG('Group Name')
     A            AIFMAD1       40A         COLHDG('Group Mailing' -
     A                                      ' Address 1')
     A            AIFMAD2       40A         COLHDG('Group Mailing' -
     A                                      ' Address 2')
     A            AIFMCTY       25A         COLHDG('Group Mailing City')
     A            AIFMST         2A         COLHDG('Group Mailing State')
     A            AIFMZIP        9S 0       COLHDG('Group Mailing' -
     A                                      ' Zip Code')
     A            AIFPAD1       40A         COLHDG('Group Physical' -
     A                                      ' Address 1')
     A            AIFPAD2       40A         COLHDG('Group Physical' -
     A                                      ' Address 2')
     A            AIFPCTY       25A         COLHDG('Group Physical City')
     A            AIFPST         2A         COLHDG('Group Physical State')
     A            AIFPZIP        9S 0       COLHDG('Group Physical' -
     A                                      ' Zip Code')
     A            AIFAREA        3S 0       COLHDG('Group Area Code')
     A            AIFPHN#        7S 0       COLHDG('Group Phone Number')
     A            AIFFAXA        3S 0       COLHDG('Group Fax Area' -
     A                                      ' Code')
     A            AIFFAX         7S 0       COLHDG('Group fax #')
     A* 1. Date of Accident
     A            AIACDT         8S 0       COLHDG('Accident Date')
     A* 2. Full salary
     A            AIFSAL         1A         COLHDG('Full Salary' -
     A                                      ' Continued')
     A* 3. Number of weeks temporary total
     A            AIWEEKSTT      5S 0       COLHDG('Temporary Total' +
     A                                      'Weeks')
     A            AIDAYSTT       5S 0       COLHDG('Temporary Total' +
     A                                      'Days')
     A            AIFRDTTT       8S 0       COLHDG('Temporary Total' +
     A                                      'From Date')
     A            AITODTTT       8S 0       COLHDG('Temporary Total' +
     A                                      'To Date')
     A            AIAMTTT       11S 2       COLHDG('Temporary Total' +
     A                                      'Amount')
     A* 4. Number of weeks temporary partial
     A            AIWEEKSTP      5S 0       COLHDG('Temporary Partial' +
     A                                      'Weeks')
     A            AIDAYSTP       5S 0       COLHDG('Temporary Partial' +
     A                                      'Days')
     A            AIFRDTTP       8S 0       COLHDG('Temporary Partial' +
     A                                      'From Date')
     A            AITODTTP       8S 0       COLHDG('Temporary Partial' +
     A                                      'To Date')
     A            AIAMTTP       11S 2       COLHDG('Temporary Partial' +
     A                                      'Amount')
     A* 5. Number of weeks permanent partial
     A            AIWEEKSPP      5S 0       COLHDG('Permanent Partial' +
     A                                      'Weeks')
     A            AIDAYSPP       5S 0       COLHDG('Permanent Partial' +
     A                                      'Days')
     A            AIFRDTPP       8S 0       COLHDG('Permanent Partial' +
     A                                      'From Date')
     A            AITODTPP       8S 0       COLHDG('Permanent Partial' +
     A                                      'To Date')
     A            AIAMTPP       11S 2       COLHDG('Permanent Partial' +
     A                                      'Amount')
     A* 6. Disfigurement amount paid
     A            AIAMTDF       11S 2       COLHDG('Disfigurement' +
     A                                      'Amount')
     A* 7. Death benefits paid
     A            AIAMTDB       11S 2       COLHDG('Death Benefits' +
     A                                      'Paid')
     A* 9. Total of lines 3 thru 8
     A            AIAMTCMP      11S 2       COLHDG('Compensation' +
     A                                      'Totals')
     A* 10. Compromise settlement agreement amount
     A            AIAMTCL       11S 2       COLHDG('Compromise' +
     A                                      'Settlement Amount')
     A            AIAMTCLCA     11S 2       COLHDG('Compromise' +
     A                                      'Settlement Amount' +
     A                                      '- With CA')
     A* 11a. Total medical paid
     A            AIAMTMP       11S 2       COLHDG('Total Medical' +
     A                                      'Paid')
     A* 11b. Total rehabilitation paid
     A            AIAMTRH       11S 2       COLHDG('Total Rehab' +
     A                                      'Paid')
     A* 12. Total of lines 9, 10, 11a and 11b
     A            AIAMTTOT      11S 2       COLHDG('Total Paid' +
     A                                      'Amount')
     A* 13. Miscellaneous payments
     A            AIFUNBEN      11S 2       COLHDG('Funeral Benefits')
     A            AIHEARCST     11S 2       COLHDG('Hearing Cost')
     A            AIEXPWIT      11S 2       COLHDG('Expert Witness')
     A            AITOTMSC      11S 2       COLHDG('Total' +
     A                                      'Miscellaneous Amount')
     A* 15. Date last compensation check forwarded
     A            AILASTCMP      8S 0       COLHDG('Last Compensation' +
     A                                      'Check')
     A* 16. Date last medical compensation paid
     A            AILASTMED      8S 0       COLHDG('Last Medical' +
     A                                      'Check')
     A* Footer Information
     A            AICONM        40A         COLHDG('Company Name')
     A            AITITLE       15A         COLHDG('Supervisor Title')
     A            AISUPNAME     50A         COLHDG('Supervisor Name')
     A            AISYSDT        8S 0       COLHDG('System Date')
     A* Scriptura Initial Date
     A            AIIDT          7S 0       COLHDG('Init Date')
