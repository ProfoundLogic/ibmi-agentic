      *  CONTACT EMAIL LOG FILE                                       *
      *===============================================================*
      *  DESCRIPTION:                                                 *
      *    LOG DETAILS OF EACH EMAIL THAT GENERATES FROM STLETTER     *
      *    FOR SCRIPTURA ENABLED PROCESSES. LOG RECORDS WILL ALSO     *
      *    BE WRITTEN IF NO EMAIL WAS SENT BECAUSE OF NO CONTACT      *
      *    EMAIL ADDRESSES.                                           *
      *                                                               *
      *    PROJECT: PHW105625 (COVERISK)      PGMR: C:65              *
      *    DATE:    01/13/23                                          *
      *                                                               *
      *===============================================================*
      *  REVISIONS:                                                   *
      *                                                               *
      *                                                               *
      *===============================================================*
     A                                      REF(SREFP)
     A          R PEM01                     TEXT('EMAIL LOG FILE')
     A            EMCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('COMPANY #')
     A            EMSUB#    R     S         REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER #')
     A            EMFND     R     S         REFFLD(FND)
     A                                      COLHDG('FUND')
     A            EMEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER #')
     A            EMDIV     R     S         REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A            EMFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            EMCASE    R     S         REFFLD(CASE)
     A                                      COLHDG('CASE #')
     A            EMCERT        15A
     A                                      COLHDG('PRE-CERT NUMBER')
     A            EMEXT          3S 0
     A                                      COLHDG('PRE-CERT EXTENSION')
     A            EMFEIN         9S 0       COLHDG('AGENCY FEIN')
     A            EMMOD          3S 0       COLHDG('AGENCY MOD')
     A            EMEOB#    R     S         REFFLD(EOB#)
     A*
     A            EMTRDT    R     S         REFFLD(DT)
     A                                      COLHDG('TRANSACTION DATE')
     A*
     A            EMDIR        100A         COLHDG('OUTPUT DIRECTORY')
     A            EMFILE        60A         COLHDG('OUTPUT FILE NAME')
     A*
     A            EMCAT     R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT CATEGORY')
     A            EMSUBC    R               REFFLD(DS5)
     A                                      COLHDG('DOCUMENT' 'SUB CATEGORY')
     A            EMTYPE       100A         COLHDG('TYPE OF PROCESS')
     A*
     A            EMUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            EMPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            EMTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            EMDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A*
     A            EMINSMAIL      1A         COLHDG('Insured Email')
     A            EMAGTMAIL      1A         COLHDG('Agent Email')
     A            EMMAILREC    750A         COLHDG('EMAIL RECIPIENTS')
     A            EMSUBJ       250A         COLHDG('EMAIL SUBJECT')
     A            EMBODY      4000A         COLHDG('EMAIL BODY')
     A            EMCMD       6000A         COLHDG('COMMAND')
     A            EMAGTEMAIL  1000A         COLHDG('AGENCY EMAIL')
     A            EMINSEMAIL  1000A         COLHDG('INSURED EMAIL')
     A            EMFROMUNCN   256A         COLHDG('FROM UNCN PATH')
     A            EMTOUNCN     256A         COLHDG('TO UNCN PATH')
     A            EMMSGID        7A         COLHDG('ERROR MSG ID')
     A            EMMSGTXT      50A         COLHDG('ERROR MSG TEXT')
     A            EMJOB#         6S 0       COLHDG('JOB NUMBER')
     A            EMJOBUSER     10A         COLHDG('JOB USER')
     A            EMJOBNAME     10A         COLHDG('JOB NAME')
     A            EMRESULTS    100A         COLHDG('RESULTS')
