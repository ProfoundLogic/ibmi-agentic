     A*
     A* KEY FIELDS
     A*
     A            M2XML         60A         COLHDG('XML FILE NAME')
     A*
     A            M2TYPE         1A         COLHDG('PAYROLL/DISCOUNT')
     A*
     A* PAYROLL FIELDS
     A*
     A            M2EPCLAS       5S 0       COLHDG('PAYROLL CLASS')
     A            M2EPSPEC       1A         COLHDG('PAYROLL SPEC')
     A            M2EPEXT        5A         COLHDG('PAYROLL EXT')
     A            M2DESC        40A         COLHDG('PAYROLL DESCRIPTION')
     A*** BEGIN CHG ***  06/17/24  ********************************************
     A*********** M2RATE         7S 2       COLHDG('PAYROLL RATE')
     A            M2RATE         8S 3
     A                                      COLHDG('PAYROLL RATE')
     A*** BEGIN CHG ***  06/17/24  ********************************************
     A            M2NETRT        7S 4       COLHDG('PAYROLL NET RATE')
     A            M2PAYROLL     11S 0       COLHDG('PAYROLL AMOUNT')
     A            M2PREMIUM     11S 0       COLHDG('PAYROLL PREMIUM')
     A*** BEGIN CHG ***  07/27/16  ********************************************
     A*********   M2TERDIFF      1A         COLHDG('PAYROLL TER DIFF FLG')
