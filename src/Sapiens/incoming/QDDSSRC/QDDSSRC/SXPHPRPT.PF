     A                                      REF(SREFP)
     A          R PPHR01                    TEXT('Scriptura Payment -
     A                                      History Work File -
     A                                      Report Summary')
     A*
     A            PHRXML        60A         COLHDG('Unique XML File' -
     A                                      ' Name Key')
     A            PHRCO#         3S 0       COLHDG('Company Number')
     A            PHRCONM       40A         COLHDG('Company Name')
     A            PHRFND         3S 0       COLHDG('Group Number')
     A            PHRFNAM       60A         COLHDG('Group Name')
     A            PHRFYR         3S 0       COLHDG('Policy Year')
     A            PHREMP#        9S 0       COLHDG('Employer Number')
     A            PHRDIV         5S 0       COLHDG('Division')
     A            PHREMNM      100A         COLHDG('Employer Name')
     A            PHRFCAS        7S 0       COLHDG('From Case Number')
     A            PHRTCAS        7S 0       COLHDG('To Case Number')
     A            PHRSORT        1A         COLHDG('Sort Order')
     A            PHRSORTD      40A         COLHDG('Sort Order' +
     A                                      'Description')
     A            PHRFRDT        8S 0       COLHDG('From Date')
     A            PHRTODT        8S 0       COLHDG('To Date')
     A            PHRTRCD        2A         COLHDG('Transaction Code')
     A            PHRTRCDS      40A         COLHDG('Transaction Desc')
     A            PHRTYPE        2A         COLHDG('Transaction Type')
     A            PHRTYPDS      40A         COLHDG('Transaction Type' +
     A                                      'Description')
     A            PHRRECD1       2A         COLHDG('Reserve Code 1')
     A            PHRRECDS1     40A         COLHDG('Reserve Code Desc 1')
     A            PHRRECD2       2A         COLHDG('Reserve Code 2')
     A            PHRRECDS2     40A         COLHDG('Reserve Code Desc 2')
     A            PHRRECD3       2A         COLHDG('Reserve Code 3')
     A            PHRRECDS3     40A         COLHDG('Reserve Code Desc 3')
     A            PHRRECD4       2A         COLHDG('Reserve Code 4')
     A            PHRRECDS4     40A         COLHDG('Reserve Code Desc 4')
     A            PHRRECD5       2A         COLHDG('Reserve Code 5')
     A            PHRRECDS5     40A         COLHDG('Reserve Code Desc 5')
     A            PHRRETP1       2A         COLHDG('Reserve Type 1')
     A            PHRRETDS1     40A         COLHDG('Reserve Type Desc 1')
     A            PHRRETP2       2A         COLHDG('Reserve Type 2')
     A            PHRRETDS2     40A         COLHDG('Reserve Type Desc 2')
     A            PHRRETP3       2A         COLHDG('Reserve Type 3')
     A            PHRRETDS3     40A         COLHDG('Reserve Type Desc 3')
     A            PHRRETP4       2A         COLHDG('Reserve Type 4')
     A            PHRRETDS4     40A         COLHDG('Reserve Type Desc 4')
     A            PHRPV1         2A         COLHDG('Payment Value 1')
     A            PHRPV1DS      40A         COLHDG('Payment Value 1' +
     A                                      'Description')
     A            PHROUTTYP      1A         COLHDG('Output Type')
     A            PHRIDT         7S 0       COLHDG('Init Date')
