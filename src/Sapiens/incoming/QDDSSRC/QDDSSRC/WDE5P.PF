     A*  MEDICARE 2ND PAY DATA ERROR CODE DETAIL FILE
     A*
     A                                      REF(WREFP)
     A          R PE501                     TEXT('MEDICARE ERROR -
     A                                           DETAIL FILE')
     A            E5CO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            E5FND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            E5FYR     R     S         REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            E5CASE    R     S         REFFLD(CASE)
     A            E5EXDT    R     S         REFFLD(DT)
     A                                      COLHDG('EXTRACT DATE')
     A            E5CODE         5A
     A                                      COLHDG('ERROR CODE')
     A            E5STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS (C/N)')
     A*
     A* MAINTENANCE INFORMATION
     A*
     A            E5USER    R               REFFLD(USER)
     A            E5PGM     R               REFFLD(PGM)
     A            E5TIME    R     S         REFFLD(TIME)
     A            E5DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            E5IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            E5IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            E5ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            E5IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
