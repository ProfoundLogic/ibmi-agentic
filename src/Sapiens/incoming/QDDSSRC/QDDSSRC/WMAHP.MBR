     A*  WORKERS' COMP AGENT HISTORY MASTER FILE
     A******************************************************************
     A* REVISIONS:                                                     *
     A*                                                                *
     A* 01/22/10  C:246  PROJECT: 139WNQ                               *
     A*                  ADD FIELD FOR AGENT OF RECORD PRODUCER, RATE, *
     A*                  RATE# FOR TRITIARY AGENT.                     *
     A*                                                                *
     A* 05/22/09  C:62  PROJECT: 133WGW                                *
     A*                 ADD FOUR CONTROL AGENT FLAGS.                  *
     A*                                                                *
     A* 01/21/09  C:65  PROJECT: 114WTB                                *
     A*                 ADD FIELDS FOR THIRD AGENT OF RECORD,          *
     A*                 PRODUCER AND RATE.                             *
     A*                                                                *
     A* 10/19/99  C:33  PROJECT: WC948                                 *
     A*                 ADD FIELDS FOR SECONDARY AGENT OF RECORD,      *
     A*                 PRODUCER AND RATE.                             *
     A*                                                                *
     A* 10/12/99  C:35   PROJECT: WC948                                *
     A*                  ADD FIELD FOR AGENT OF RECORD PRODUCER, RATE  *
     A*                  AND EFFECTIVE DATE.                           *
     A******************************************************************
     A*
     A                                      REF(WREFP)
     A          R PAH01                     TEXT('AGENT HISTORY MASTER FILE')
     A            AHCO#     R               REFFLD(CO#)
     A            AHFND     R               REFFLD(FND)
     A            AHEMP#    R               REFFLD(EMP#)
     A            AHDIV     R               REFFLD(DIV)
     A            AHFYR     R               REFFLD(FYR)
     A            AHEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A            AHAGT#    R               REFFLD(AGT#)
     A                                      COLHDG('AGENT #' 'ASSIGNED BY FUND')
     A            AHRT#     R               REFFLD(RT#)
     A            AHPROD    R               REFFLD(AGT#)
     A            AHSAGT    R               REFFLD(AGT#)
     A                                      COLHDG('SECONDARY' 'AGENT #')
     A            AHSRT#    R               REFFLD(RT#)
     A                                      COLHDG('SECONDARY' 'RATE #')
     A            AHSPRD    R               REFFLD(AGT#)
     A                                      COLHDG('SECONDARY' 'PRODUCER')
     A            AHSTAT    R               REFFLD(STAT)
     A            AHUSER    R               REFFLD(USER)
     A            AHPGM     R               REFFLD(PGM)
     A            AHTIME    R               REFFLD(TIME)
     A            AHDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            AHIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            AHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            AHITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            AHIDT     R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            AHAGRC    R               REFFLD(AGT#)
     A                                      COLHDG('AGT OF' 'RECORD')
     A            AHRTDT    R               REFFLD(DT)
     A                                      COLHDG('RETRO COMMISSION' 'DATE')
      **** BEGIN ADD **** 10/12/99 *********************************************
     A            AHPRRC    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER' 'AGT OF RECORD')
     A            AHRTRC    R               REFFLD(RT#)
     A                                      COLHDG('RATE#' 'AGT OF RECORD')
     A            AHEFRC    R               REFFLD(DT)
     A                                      COLHDG('EFF DT' 'AGT OF RECORD')
      **** END   ADD **** 10/12/99 *********************************************
     A**** BEGIN ADD **** 10/19/99 *********************************************
     A            AH2ARC    R               REFFLD(AGT#)
     A                                      COLHDG('SECONDARY' 'AGT OF RECORD')
     A            AH2PRC    R               REFFLD(AGT#)
     A                                      COLHDG('SECONDARY' 'PRODUCER' -
     A                                      'AGT OF RECORD')
     A            AH2RRC    R               REFFLD(RT#)
     A                                      COLHDG('SECONDARY' 'RATE #' -
     A                                      'AGT OF RECORD')
     A**** END   ADD **** 10/19/99 *********************************************
     A**** BEGIN ADD **** 01/21/09 *********************************************
     A            AHCAF1    R               REFFLD(FLAG)
     A                                      COLHDG('CTRL AGT=PRIMARY')
     A            AHCAF2    R               REFFLD(FLAG)
     A                                      COLHDG('CTRL AGT=SECONDARY')
     A            AHCRF1    R               REFFLD(FLAG)
     A                                      COLHDG('CTRL AGT=' +
     A                                      'PRM AGT OF RCD')
     A            AHCRF2    R               REFFLD(FLAG)
     A                                      COLHDG('CTRL AGT=' +
     A                                      'SEC AGT OF RCD')
     A**** END   ADD **** 01/21/09 *********************************************
     A**** BEGIN ADD **** 01/22/10 *********************************************
     A            AH3AGT    R               REFFLD(AGT#)
     A                                      COLHDG('TERTIARY'  'AGENT #')
     A            AH3RT#    R               REFFLD(RT#)
     A                                      COLHDG('TERTIARY'  'RATE #')
     A            AH3PRD    R               REFFLD(AGT#)
     A                                      COLHDG('TERTIARY'  'PRODUCER')
     A            AH3ARC    R               REFFLD(AGT#)
     A                                      COLHDG('TERTIARY'  'AGT OF RECORD')
     A            AH3RRC    R               REFFLD(RT#)
     A                                      COLHDG('TERTIARY'  'RATE #' -
     A                                      'AGT OF RECORD')
     A            AH3PRC    R               REFFLD(AGT#)
     A                                      COLHDG('TERTIARY'  'PRODUCER' -
     A                                      'AGT OF RECORD')
     A**** END  ********* 01/22/10 *********************************************
