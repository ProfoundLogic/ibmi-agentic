     A                                      REF(WREFP)
     A          R PRW401                    TEXT('Audit Request +
     A                                      S/R Payroll Work File')
     A            RW4XML        60A         COLHDG('XML File Key')
     A            RW4CO#    R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            RW4FND    R     S         REFFLD(FND)
     A                                      COLHDG('Fund')
     A            RW4EMP#   R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            RW4DIV    R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            RW4FYR    R     S         REFFLD(FYR)
     A                                      COLHDG('Fund Year')
     A            RW4SEQ         5S 0       COLHDG('Sequence #')
     A            RW4TYPE       20A         COLHDG('Reporting' 'Period Type')
     A            RW4TODT        8S 0       COLHDG('Reporting Period' -
     A                                             'To Date')
     A            RW4CLAS   R     S         REFFLD(CLAS)
     A                                      COLHDG('Reporting' 'Period Class')
     A            RW4SPEC        1A         COLHDG('Reporting' 'Period Spec')
     A            RW4EXT         5A         COLHDG('Reporting Period' -
     A                                             'Extension')
     A            RW4PAY    R     S         REFFLD(A112)
     A                                      COLHDG('Reporting Period' -
     A                                             'Payroll')
     A            RW4HDG        20A         COLHDG('Reporting' 'Heading')
     A            RW4NORPT       1A         COLHDG('Reporting' 'No Report Flag')
     A            RW4DESC       30A         COLHDG('Class Code Desc')
      **** BEGIN CHG **** 06/17/24 ************************************
     A*********** RW4RATE        7S 2       COLHDG('Class Code Rate')
     A            RW4RATE        8S 3
      **** END   CHG **** 06/17/24 ************************************
     A                                      COLHDG('Class Code Rate')
     A            RW4IUSR   R               REFFLD(USER)
     A                                      COLHDG('Initial/User')
     A            RW4IPGM   R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            RW4IDT    R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            RW4ITIM   R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            RW4USER   R               REFFLD(USER)
     A                                      COLHDG('Maint. User')
     A            RW4PGM    R               REFFLD(PGM)
     A                                      COLHDG('Maint. Program')
     A            RW4DT     R     S         REFFLD(DT)
     A                                      COLHDG('Maint. Date')
     A            RW4TIME   R     S         REFFLD(TIME)
     A                                      COLHDG('Maint. Time')
