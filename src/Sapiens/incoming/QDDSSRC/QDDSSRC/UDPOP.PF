     A**
     A** PRE-CERT PROCEDURE CODE FILE
     A*****************************************************************
     A*  REVISIONS:
     A*  11/03/04 C:79 PROJECT: MC257
     A*                ADD POPAMT - PRE-AUTHORIZED AMOUNT
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PPO01                     TEXT('PRE-CERT PROCEDURE CODE FILE')
     A            POCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            POSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER NUMBER')
     A            POFND     R               REFFLD(FND)
     A                                      COLHDG('FUND NUMBER')
     A            POFYR     R               REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            POCASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE NUMBER')
     A            POCERT    R               REFFLD(CERT)
     A                                      COLHDG('PRE-CERTIFICATION#')
     A            POEXT     R               REFFLD(EXT)
     A                                      COLHDG('EXTENSION NUMBER')
     A            POPROC    R               REFFLD(CPT4)
     A                                      COLHDG('PROCEDURE CODE')
     A            POSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('SEQUENCE#')
     A*           (NEXT AVAILABLE FOR CO/SUB/FND/FYR/CASE/CERT/EXT)
     A            PODESC    R               REFFLD(DS40)
     A                                      COLHDG('DESCRIPTION')
     A            POTOS     R               REFFLD(DS3)
     A                                      COLHDG('TYPE OF SERVICE')
     A            POVST     R               REFFLD(A30)
     A                                      COLHDG('AUTHORIZED VISITS')
     A            POFRDT    R               REFFLD(DT7)
     A                                      COLHDG('FROM SERVICE DATE')
     A            POTODT    R               REFFLD(DT7)
     A                                      COLHDG('TO SERVICE DATE')
     A            POALLW    R               REFFLD(FLAG)
     A                                      COLHDG('ALLOWANCE CODE')
     A*                         VALID VALUES: FTGTP VIA "PCAL"
     A            POAUTH    R               REFFLD(DS10)
     A                                      COLHDG('ALLOWANCE AUTHORITY')
     A*                         VALID VALUES: FTGTP VIA "PCAU"
     A            POEOB     R               REFFLD(SPEC)
     A                                      COLHDG('ALLOWANCE EOB CODE')
     A*                         DEFAULT FROM FTGTP/GTCF01
     A*                         VALID VALUES: FTEBPXX
     A            POSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            POUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            POPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            POTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            PODT      R               REFFLD(DT7)
     A                                      COLHDG('MAINT DATE')
     A            POIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            POIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            POITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            POIDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL DATE')
     A*** BEG ADD *** 11/03/04 ****************************************
     A            POPAMT         9S 2       COLHDG('PRE-AUTH AMT')
     A*** END ADD *** 11/03/04 ****************************************
