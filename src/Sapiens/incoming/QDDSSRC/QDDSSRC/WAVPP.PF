     A          R PVP01                     TEXT('VPay Payment Import File')
     A            VPYEAR         4A         COLHDG('Year')
     A            VPCLT         10A         COLHDG('Client')
     A            VPBECD        20A         COLHDG('BE Code')
     A            VPGNAM       100A         COLHDG('Group Name')
     A            VPGNUM        10A         COLHDG('Group Number')
     A            VPTYPE        10A         COLHDG('Payment Type')
     A            VPCLMID       16A         COLHDG('Claim ID')
     A            VPCLTREFID    20A         COLHDG('Client Reference ID')
     A            VPPMTID      100A         COLHDG('Payment ID')
     A            VPPAYNAM     100A         COLHDG('Payee Name')
     A            VPPAYFEIN     10A         COLHDG('Payee Fein')
     A            VPLOADDATE    10A         COLHDG('Load Date')
     A            VPORGAMT      15S 2       COLHDG('Original Amount')
     A            VPPAYAMT      15S 2       COLHDG('Payment Amount')
     A            VPCLRAMT      15S 2       COLHDG('Cleared Amount')
     A            VPRFNAMT      15S 2       COLHDG('Refund Amount')
