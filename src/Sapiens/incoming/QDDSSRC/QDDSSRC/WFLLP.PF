      *
     A                                      REF(WREFP)
     A          R PLL01                     TEXT('Large Loss Outfile')
      *
     A            LLCO#          3S 0
     A                                      COLHDG('Company')
      *
     A            LLCNAM        60A
     A                                      COLHDG('Company name')
      *
     A            LLFND          3S 0
     A                                      COLHDG('Group')
      *
     A            LLFNAM        60A
     A                                      COLHDG('Group name')
      *
     A            LLEMP#         9S 0
     A                                      COLHDG('Employer')
      *
     A            LLDIV          5S 0
     A                                      COLHDG('Division')
      *
     A            LLENAM        40A
     A                                      COLHDG('Employer name')
      *
     A            LLFYR          3S 0
     A                                      COLHDG('Policy' 'Year')
      *
     A            LLCASE         7S 0
     A                                      COLHDG('Case')
      *
     A            LLCLNM        45A
     A                                      COLHDG('Claimant' 'Name')
      *
     A            LLSTAT         1A
     A                                      COLHDG('Claim' 'Status')
      *
     A            LLACDT         8S 0
     A                                      COLHDG('Accident' 'Date' +
     A                                      'CCYYMMDD')
      *
     A            LLACDS        60A
     A                                      COLHDG('Accident' 'Description')
      *
     A            LLCLAS         5S 0
     A                                      COLHDG('Class' 'Code')
      *
     A            LLTINC        11S 2
     A                                      COLHDG('Total' +
     A                                      'Incurred')
      *                   accumulation of WDPAP records
      *
     A            LLPAID        11S 2
     A                                      COLHDG('Total' 'Paid')
      *                   accumulation of WMRHP records
      *
     A            LLOUTS        11S 2
     A                                      COLHDG('Outstanding' +
     A                                      'reserves')
      *                   LLOUTS = LLTINC - LLPAID
      *
     A            LLEXCS        11S 2
     A                                      COLHDG('Amount in' +
     A                                      'excess')
      *
     A            LLRNDT         8S 0
     A                                      COLHDG('Run Date')
      *
     A            LLLAMT        11S 2
     A                                      COLHDG('Loss Amount')
      *
     A            LLLREP    R               REFFLD(STAF)
     A                                      COLHDG('Loss Control Rep' +
     A                                      'Staff Code')
      *
     A            LLLRNM    R               REFFLD(DS50)
     A                                      COLHDG('Loss Control Rep' +
     A                                      'Name')
      *
      *
      *
     A            LLUSER        10A
     A                                      COLHDG('User')
     A            LLPGM         10A
     A                                      COLHDG('Program')
     A            LLTIME         6S 0
     A                                      COLHDG('Time')
     A            LLDT           7S 0
     A*** BEG ADD *** 06/21/02 *************
     A                                      COLHDG('Date')
     A*** Begin chg *** 11/04/02 *****************************************
     A*********** LLECS#        10A
     A            LLECS#        20A
     A*** End chg ***** 11/04/02 *****************************************
     A                                      COLHDG('Employer claim #')
     A*** END ADD *** 06/21/02 *************
      *
