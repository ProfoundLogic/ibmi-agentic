     A                                      REF(WREFP)
     A          R PEE01                     TEXT('Employer Eligibility File')
     A            EEEMP#         9S 0       COLHDG('Employer #')
     A            EEDIV          5S 0       COLHDG('Division')
     A            EEDBA         40A         COLHDG('Employer DBA Name')
     A            EEMAD1        40A         COLHDG('Employer Mailing' +
     A                                      'Address 1')
     A            EEMAD2        40A         COLHDG('Employer Mailing' +
     A                                      'Address 2')
     A            EEMCTY        25A         COLHDG('Employer City')
     A            EEMST          2A         COLHDG('Employer State')
     A            EEMZIP         9S 0       COLHDG('Employer Zip')
     A            EEPAD1        40A         COLHDG('Employer Physical' +
     A                                      'Address 1')
     A            EEPAD2        40A         COLHDG('Employer Physical' +
     A                                      'Address 2')
     A            EEPCTY        25A         COLHDG('Employer Physical' +
     A                                      'City')
     A            EEPST          2A         COLHDG('Employer Physica' +
     A                                      'State')
     A            EEPZIP         9S 0       COLHDG('Employer Physical' +
     A                                      'Zip')
     A            EEPHN         10S 0       COLHDG('Employer Phone #')
     A            EEICDT         8S 0       COLHDG('Inception Date')
     A            EECXDT         8S 0       COLHDG('Cancellation Date')
     A            EEFYR          3A         COLHDG('Policy Year')
     A            EERST          2A         COLHDG('Rating State')
