     A                                      REF(CREFP)
     A          R PAI01                     TEXT('ADDITIONAL INTEREST FILE')
     A            AICO#     R               REFFLD(CO#)
     A            AIPOL#    R               REFFLD(POL#)
     A            AIADI     R               REFFLD(ADI)
     A            AINAME    R               REFFLD(NM60)
     A            AIADR1    R               REFFLD(ADR1)
     A            AIADR2    R               REFFLD(ADR2)
     A            AICTY     R               REFFLD(CTY)
     A            AIST      R               REFFLD(ST)
     A            AIZIP     R               REFFLD(ZIP)
     A            AIIN      R               REFFLD(FLAG)
     A                                      COLHDG('INTEREST TYPE')
     A* VALID VALUES ARE 1=MORGAGEE,2=CERTIFICATE HOLDER,3=LESSOR
     A* 4=ADDITIONAL NAMED INSURED,5 = ADDITIONAL INSURED,6=LOSS PAYEE
     A            AINOR     R               REFFLD(FLAG)
     A                                      COLHDG('NOTICE REQUIRED?')
     A            AINOD     R               REFFLD(DAYS)
     A            AICOMM    R               REFFLD(COMM)
     A            AISTAT    R               REFFLD(STAT)
     A            AIUSER    R               REFFLD(USER)
     A            AIPGM     R               REFFLD(PGM)
     A            AITIME    R               REFFLD(TIME)
     A            AIDT      R               REFFLD(DT)
     A            AIOWN     R               REFFLD(FLAG)
     A                                      COLHDG('OWNER/DRIVER Y/N')
     A            AIAEP     R               REFFLD(FLAG)
     A                                      COLHDG('APPLIES' 'ENTIRE POLICY')
