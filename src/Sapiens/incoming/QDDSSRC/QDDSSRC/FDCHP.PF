     A* CodeReview History File                                       *
     A*                                                               *
     A*****************************************************************
     A* Created on 05/22/2002 by C:62 for Project 114MDC              *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PCH01                     TEXT('CodeReview History File')
     A            CHCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company #')
     A            CHSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('Subscriber #')
     A            CHFND     R               REFFLD(FND)
     A                                      COLHDG('Group #')
     A            CHFYR     R               REFFLD(FYR)
     A                                      COLHDG('Year')
     A            CHCASE    R               REFFLD(CASE)
     A                                      COLHDG('Case #')
     A            CHEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('Bill #')
     A            CHRCN     R               REFFLD(RCN)
     A                                      COLHDG('Recon #')
     A            CHDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('Detail Sequence #')
     A            CHTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Bill Type')
     A*           Valid values are: 'H' = History
     A*                             'C' = Current
     A*
     A            CHCRB#    R               REFFLD(A120)
     A                                      COLHDG('CodeReview Batch#')
     A            CHCRL#    R               REFFLD(SEQ#)
     A                                      COLHDG('CodeReview Batch' +
     A                                      'Line #')
     A            CHCRM#    R               REFFLD(SEQ#)
     A                                      COLHDG('CodeReview Batch' +
     A                                      'Message #')
     A            CHCRST    R               REFFLD(CODE3)
     A                                      COLHDG('CodeReview Status')
     A            CHCRET    R               REFFLD(DS15)
     A                                      COLHDG('CodeReview Edit' +
     A                                      'Type')
     A            CHXRL#    R               REFFLD(SEQ#)
     A                                      COLHDG('CodeReview X-Ref' +
     A                                      'Result Line #')
     A            CHCRPC    R               REFFLD(CPT4)
     A                                      COLHDG('CodeReview Result' +
     A                                      'Procedure Code')
     A            CHCRM1    R               REFFLD(PMOD)
     A                                      COLHDG('CodeReview Result' +
     A                                      'Modifier 1')
     A            CHCRM2    R               REFFLD(PMOD)
     A                                      COLHDG('CodeReview Result' +
     A                                      'Modifier 2')
     A            CHPMM#    R               REFFLD(SEQ#)
     A                                      COLHDG('ProMatch Error'    +
     A                                      'Message #')
     A            CHPMST    R               REFFLD(CODE3)
     A                                      COLHDG('ProMatch Status'   +
     A                                      'Message #')
     A            CHPMET    R               REFFLD(DS15)
     A                                      COLHDG('ProMatch Edit'     +
     A                                      'Type')
     A            CHSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            CHUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            CHPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            CHTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            CHDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            CHIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            CHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            CHIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            CHITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
