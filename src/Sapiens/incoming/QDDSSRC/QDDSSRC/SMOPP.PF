     A* * * MULTIPLE OBJECT OPTICAL PURGE/DELETE REQUEST FILE
     A*
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*   DR189  C:02                                                 *
     A***  1/05/05 -  ADDED UNCP AND UNCF FIELDS FOR IFS
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R POP01                     TEXT('OBJECT PURGE DELE-
     A                                      TE REQUEST FILE')
     A            OPKEY     R               REFFLD(KEY)
     A            OPSEQ#    R               REFFLD(SEQ#)
     A                                      TEXT('REMARK SEQ')
     A            OPSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A            OPOFLR        60A         TEXT('OBJECT FOLDER(PATH)')
     A            OPOID         40A         TEXT('OBJECT ID')
     A            OPSYS          1A         TEXT('SYSTEM ID        ')
     A            OPHCMD         1A         TEXT('HEX CMD TO OLS             ')
     A            OPCPRY         1A         TEXT('COMMAND PRIORITY           ')
     A            OPOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            OPOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            OPOSBD        12A         TEXT('OPTICAL SUBDIRECTORY       ')
     A            OPFOLD         8A         TEXT('FOLDER NAME                ')
     A            OPSUBD        12A         TEXT('SUBDIRECTORY NAME          ')
     A            OPDCID        12A         TEXT('UNIQUE DOCUMENT ID         ')
     A            OPDELF         1A         TEXT('DELETE FLAG                ')
     A            OPSTAT    R               REFFLD(STAT)
     A            OPUSER    R               REFFLD(USER)
     A            OPPGM     R               REFFLD(PGM)
     A            OPTIME    R               REFFLD(TIME)
     A            OPDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OPIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            OPIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            OPPNAM    R               REFFLD(PGM)
     A                                      TEXT('KEYED PGM')
     A            OPASTT         1A         TEXT('ALLOW SAVE TO TAPE (Y/N)   ')
     A            OPBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            OPERDS        80A         TEXT('80B ERROR DESCRIPTION')
     A            OPTSFL         1A         TEXT('TAPE STATUS FLAG')
     A**** 01/05/05 **** ADD **************************************************
     A            OPUNCF    R               REFFLD(FLAG)
     A                                      TEXT('UNC FLAG <> BLANK IS IFS USE')
     A            OPUNCP    R               REFFLD(UNCP)
     A                                      TEXT('UNC PATH FOR IFS')
     A**** 01/05/05 **** END ADD **********************************************
