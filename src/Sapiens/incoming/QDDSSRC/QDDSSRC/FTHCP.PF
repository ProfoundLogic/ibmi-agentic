     A                                      REF(FSREFP)
     A*
     A          R PHC01                     TEXT('HL Cost To Charge Ratio -
     A                                      Table File')
     A*
     A            HCST      R               REFFLD(DS2)
     A                                      COLHDG('State Abbr.')
     A                                      TEXT('State abbreviation')
     A            HCNAME    R               REFFLD(DS25)
     A                                      COLHDG('State Name')
     A                                      TEXT('State Name')
     A            HCCCR     R     S         REFFLD(A53)
     A                                      COLHDG('CC Ratio')
     A                                      TEXT('Cost to Charge Ratio')
     A            HCEFDT    R               REFFLD(DT7)
     A                                      COLHDG('Effective date')
     A                                      TEXT('Effective date')
     A            HCSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A                                      TEXT('Status')
     A            HCPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint Program')
     A                                      TEXT('Maint Program')
     A            HCUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A                                      TEXT('Maint User')
     A            HCDT      R               REFFLD(DT)
     A                                      COLHDG('Maint Date')
     A                                      TEXT('Maint Date')
     A            HCTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A                                      TEXT('Maint Time')
     A            HCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A                                      TEXT('Initial Program')
     A            HCIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A                                      TEXT('Initial User')
     A            HCIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A                                      TEXT('Initial Date')
     A            HCITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A                                      TEXT('Initial Time')
     A*
