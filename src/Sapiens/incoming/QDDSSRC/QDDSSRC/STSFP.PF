     A                                      REF(SREFP)
     A          R PSF01                     TEXT('Scriptura XML Files')
     A            SFFILE        10A         COLHDG('File name')
     A            SFDTFLD       10A         COLHDG('File creation' 'date field')
     A*
     A            SFSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            SFUSER    R               REFFLD(USER)
     A                                      COLHDG('User')
     A            SFPGM     R               REFFLD(PGM)
     A                                      COLHDG('Program')
     A            SFTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Time')
     A            SFDT      R     S         REFFLD(DT)
     A                                      COLHDG('Date')
     A            SFIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial' 'user')
     A            SFIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial' 'program')
     A            SFITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial' 'time')
     A            SFIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial' 'date')

     A          K SFFILE
