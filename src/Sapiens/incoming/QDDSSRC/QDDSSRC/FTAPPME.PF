     A                                      TEXT('INITIAL PROGRAM')
     A*
     A            APIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A                                      TEXT('INITIAL USER')
     A*
     A            APIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A                                      TEXT('INITIAL DATE')
     A*
     A            APITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A                                      TEXT('INITIAL TIME')
