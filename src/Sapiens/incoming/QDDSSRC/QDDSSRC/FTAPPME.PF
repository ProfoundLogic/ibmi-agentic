     A                                      REF(FSREFP)
     A*
     A          R PAP01                     TEXT('Maine OPPS APC File')
     A*
     A            APHCPC    R               REFFLD(DS5)
     A                                      COLHDG('HCPCS' 'CODE')
     A                                      TEXT('HCPCS CODE')
     A*
     A            APDESC       100A
     A                                      COLHDG('CODE' 'DESCRIPTION')
     A                                      TEXT('CODE DESCRIPTION')
     A*
     A            APEFDT    R     S         REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE' 'DATE')
     A                                      TEXT('EFFECTIVE DATE')
     A*
     A***** Beg Chg *** 12/23/16 **************************************
     A*****       APSTS     R               REFFLD(STAT)
     A            APSTS     R               REFFLD(CODE)
     A***** End Chg *** 12/23/16 **************************************
     A                                      COLHDG('CODE' 'STATUS')
     A                                      TEXT('CODE STATUS')
     A*
     A*
     A            APAPC     R               REFFLD(DS5)
     A                                      COLHDG('APC')
     A                                      TEXT('APC')
     A*
     A            APRELW         7S 4
     A                                      COLHDG('RELATIVE' 'WEIGHT')
     A                                      TEXT('RELATIVE WEIGHT')
     A*
     A            APAFEE    R     S         REFFLD(A112)
     A                                      COLHDG('ACH FEE')
     A                                      TEXT('ACH FEE')
     A*
     A            APCFEE    R     S         REFFLD(A112)
     A                                      COLHDG('CAH' 'FEE')
     A                                      TEXT('CAH FEE')
     A*
     A            APASCF    R     S         REFFLD(A112)
     A                                      COLHDG('ASC' 'FEE')
     A                                      TEXT('ASC FEE')
     A*
     A            APSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A                                      TEXT('STATUS')
     A*
     A            APPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PROGRAM')
     A                                      TEXT('MAINTENANCE PROGRAM')
     A*
     A            APUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A                                      TEXT('MAINTENANCE USER')
     A*
     A            APDT      R     S         REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A                                      TEXT('MAINTENANCE DATE')
     A*
     A            APTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A                                      TEXT('MAINTENANCE TIME')
     A*
     A            APIPGM    R               REFFLD(PGM)
