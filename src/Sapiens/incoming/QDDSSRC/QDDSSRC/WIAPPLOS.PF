      * Portal Application Loss File
      *=====================================================
      * Revisions:
      *
      * 08/02/21 C:298 Project: WC2820
      *                Add Losses flags.
      *
      * 11/04/19 C:298 Project: WC2820
      *                Deposit Cap at Policy Level
      *
      *=====================================================
     A                                      REF(WREFP)
     A          R PAP01                     TEXT('Portal Application')
     A            APCO#     R               REFFLD(CO#)
     A            APAPP#         9S 0       COLHDG('APP NUMBER')
     A            APYEAR         3S 0       COLHDG('LOSS YEAR #')
     A            APANNPREM     13S 2       COLHDG('ANNUAL PREMIUM')
     A            AP#LOSSES      5S 0       COLHDG('# OF LOSSES')
     A            APPAID        13S 2       COLHDG('PAID AMOUNT')
     A            APRESERVE     13S 2       COLHDG('RESERVE AMT')
     A            APSTAT         1A         COLHDG('A/I STATUS')
     A            APUSER    R               REFFLD(USER)
     A            APPGM     R               REFFLD(PGM)
     A            APDT      R               REFFLD(DT)
     A            APTIME    R               REFFLD(TIME)
     A            APIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            APIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PROGRAM')
     A            APIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            APITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
      ***** BEG ADD ***** 08/02/21 *************************************
     A            APANNPREMZ     1A         COLHDG('ANNUAL PREMIUM' +
     A                                      '(ZERO ENTERED)')
     A            AP#LOSSESZ     1A         COLHDG('# OF LOSSES' +
     A                                      '(ZERO ENTERED)')
     A            APPAIDZ        1A         COLHDG('PAID AMOUNT' +
     A                                      '(ZERO ENTERED)')
     A            APRESERVEZ     1A         COLHDG('RESERVE AMOUNT' +
     A                                      '(ZERO ENTERED)')
      ***** END ADD ***** 08/02/21 *************************************

