     A                                      COLHDG('Initial Time')
     A            RW2USER   R               REFFLD(USER)
     A                                      COLHDG('Maint. User')
     A            RW2PGM    R               REFFLD(PGM)
     A                                      COLHDG('Maint. Program')
     A            RW2DT     R     S         REFFLD(DT)
     A                                      COLHDG('Maint. Date')
     A            RW2TIME   R     S         REFFLD(TIME)
     A                                      COLHDG('Maint. Time')
