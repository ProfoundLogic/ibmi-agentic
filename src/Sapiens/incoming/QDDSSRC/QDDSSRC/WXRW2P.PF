     A                                      REF(WREFP)
     A          R PRW201                    TEXT('Audit Request +
     A                                      Officer Work File')
     A            RW2XML        60A         COLHDG('XML File Key')
     A            RW2CO#    R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A            RW2FND    R     S         REFFLD(FND)
     A                                      COLHDG('Fund')
     A            RW2EMP#   R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer #')
     A            RW2DIV    R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
     A            RW2FYR    R     S         REFFLD(FYR)
     A                                      COLHDG('Fund Year')
     A            RW2SEQ         5S 0       COLHDG('Sequence #')
     A            RW2ODIV        5S 0       COLHDG('Officer Division #')
     A            RW2OLOC       10A         COLHDG('Officer' -
     A                                             'Entity/Location #')
     A            RW2EXFL        1A         COLHDG('Officer' 'Include/Exclude' -
     A                                             'Status')
     A            RW2CLAS   R     S         REFFLD(CLAS)
     A                                      COLHDG('Officer Payroll' 'Class')
     A            RW2NAME       60A         COLHDG('Officer Name')
     A            RW2TITL       40A         COLHDG('Officer Title')
     A            RW2OEFD        8S 0       COLHDG('Officer' 'Effective Date')
     A            RW2OEXD        8S 0       COLHDG('Officer' 'Expiration Date')
     A            RW2IUSR   R               REFFLD(USER)
     A                                      COLHDG('Initial/User')
     A            RW2IPGM   R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            RW2IDT    R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
