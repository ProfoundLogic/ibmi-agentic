     A                                      REF(WREFP)
     A
     A          R PZH01                     TEXT('Zurich Date History-
     A                                            file')
     A
     A            ZHCO#     R               REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            ZHTPAC        10A         TEXT('TPA Code')
     A                                      COLHDG('TPA Code')
     A            ZHLRDT    R               REFFLD(DT)
     A                                      COLHDG('Last Run Date')
     A            ZHSTAT         1A         TEXT('Status')
     A                                      COLHDG('Status')
     A            ZHUSER    R               REFFLD(USER)
     A                                      COLHDG('Maint User')
     A            ZHPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maint PGM')
     A            ZHDT      R               REFFLD(DT)
     A                                      COLHDG('Maint DAT')
     A            ZHTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maint Time')
     A            ZHIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            ZHIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial PGM')
     A            ZHIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial DAT')
     A            ZHITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
