     A*
     A**  INDEX ENTRIES FILE
     A****************************************************************
     A*  REVISIONS:                                                  *
     A*                                                              *
     * 07/09/07 C:191 Project: 10IJI                                *
     *               -Include IERCVD to capture received date       *
     *                when scanning.                                *
     A*
     A****************************************************************
     A*
     A          R PIE01                     TEXT('INDEX QUE ENTRIES')
     A*
     A*
     A            IEQID         10          COLHDG('INDEX QUEUE ID')
     A            IEDOCT         8          COLHDG('DOCUMENT TYPE')
     A            IESDT          8  0       COLHDG('SCANNED DATE')
     A            IESTM          6  0       COLHDG('SCANNED TIME')
     A            IEDCID        12          COLHDG('DOCUMENT ID')
     A            IESREP        10          COLHDG('SCANNER USER')
     A            IESTAT         1          COLHDG('STATUS')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            IEIUSR        10          TEXT('INIT USER')
     A            IEIPGM        10          TEXT('INIT PGM')
     A            IEITIM         6S 0       TEXT('INIT TIME')
     A            IEIDT          6S 0       TEXT('INIT DATE')
     A            IELUSR        10          TEXT('USER LAST MAINT')
     A            IELPGM        10          TEXT('LAST MAINT PGM')
     A            IELTIM         6S 0       TEXT('LAST MAINT TIME')
     A            IELDT          6S 0       TEXT('LAST MAINT DATE')
     A*
     A            IEFL01         1          COLHDG('IMAGE/FAX FLAG' +
                                            'F=FAX, " " OR' '"I" IS AN IMAGE')
     A            IEFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            IEFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            IEFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            IEFL05         1          TEXT('**FUTURE USE FLG 05 **')
     A            IECHR5         5          TEXT('**FUTURE USE A5  01 **')
     A*
     A            IEDSTS         2          TEXT('DOC STATUS')
     A*
     *** BEG ADD ******07/09/07 ***********************
     A            IERCVD         8S 0       TEXT('RECEIVED DATE')
      *                                     < YYYYMMDD format >
     *** END ADD ******07/09/07 ***********************
