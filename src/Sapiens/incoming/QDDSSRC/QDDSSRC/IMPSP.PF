     A**  PRINT SERVER  FILE
     A*
     A          R PPS01                     TEXT('PRINT SVR FILE')
     A*
     A            PSPSID         2          COLHDG('PRT SVR   ' 'ID')
     A*
     A            PSLUNM        10          COLHDG('LU NAME' 'APPC CTLR-
     A                                       NAME')
     A            PSJBNM        10          COLHDG('JOB NM ' '         -
     A                                       NAME')
     A            PSPQUE        10          COLHDG('PRINTER' 'DTAQ NAME' +
     A                                      'RECEIVE')
     A            PSPQLB        10          COLHDG('PRINTER' 'DTAQ LIBR' +
     A                                      'RECEIVE')
     A            PSIDRV         1          COLHDG('IMG DRIVE' +
     A                                      'SHARED FOLDER')
     A            PSSTAT         1          COLHDG('STATUS')
     A            PSDESC        40          COLHDG('DESCRIPTION OF Q')
     A***** LAST MAINT INFO  *****
     A*
     A            PSIUSR        10          TEXT('INIT USER')
     A            PSIPGM        10          TEXT('INIT PGM')
     A            PSITIM         6S 0       TEXT('INIT TIME')
     A            PSIDT          6S 0       TEXT('INIT DATE')
     A            PSLUSR        10          TEXT('USER LAST MAINT')
     A            PSLPGM        10          TEXT('LAST MAINT PGM')
     A            PSLTIM         6S 0       TEXT('LAST MAINT TIME')
     A            PSLDT          6S 0       TEXT('LAST MAINT DATE')
     A            PSFL01         1          TEXT('PRT SVR LOAD BALANCING')
     A            PSFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            PSFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            PSFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            PSFL05         1          TEXT('**FUTURE USE FLG 05 **')
     A            PSCHR5         5          TEXT('**FUTURE USE A5 01 **')
     A*
