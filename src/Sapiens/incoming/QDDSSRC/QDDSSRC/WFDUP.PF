     A*
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PDU01                     TEXT('DUPLICATE PAYMENT FILE')
     A            DUCO#          3S 0       COLHDG('Company #')
     A            DUFND          3S 0       COLHDG('Fund #')
     A            DUFNNM        40          COLHDG('Fund Name')
     A            DUFYR          3S 0       COLHDG('Fund Year')
     A            DUADJ     R               REFFLD(STAF)
     A                                      TEXT('Staff Adjuster')
     A            DUADNM        30          COLHDG('Adjuster' 'Name')
     A            DUCASE         7S 0       COLHDG('Case #')
     A            DUFEIN         9S 0       COLHDG('Payee' 'Federal' 'ID #')
     A            DUMOD          3S 0       COLHDG('Payee' 'Mod')
     A            DUPNAM    R               REFFLD(NAME)
     A                                      COLHDG('PROVIDER' 'NAME')
     A            DUCNAM    R               REFFLD(NAME)
     A                                      COLHDG('CLAIMANT' 'NAME')
     A            DUAST     R               REFFLD(STAT)
     A                                      COLHDG('Exact vs.' 'Possible')
     A*
     A*   First Payment of the Duplication detected
     A*
     A            DU1SQ#         5S 0       COLHDG('Seq #')
     A            DU1SDT    R               REFFLD(DT)
     A                                      COLHDG('Transaction' 'Date')
     A            DU1AMT         9S 2       COLHDG('Payment Amount')
     A            DU1BR2    R               REFFLD(CODE)
     A                                      COLHDG('Payment' 'Value 1')
     A            DU1PVD        30          COLHDG('Paymnt Val 1' 'Description')
     A            DU1FDT    R               REFFLD(DT)
     A                                      COLHDG('From' 'Date')
     A            DU1TDT    R               REFFLD(DT)
     A                                      COLHDG('To' 'Date')
     A            DU1RTP    R               REFFLD(FLAG)
     A                                      COLHDG('Reserve' 'Type')
     A            DU1RCD    R               REFFLD(CODE)
     A                                      COLHDG('Reserve' 'Code')
     A            DU1STT    R               REFFLD(STAT)
     A            DU1CK#         7S 0       COLHDG('Check' 'Number')
     A            DU1EOB         9S 0       COLHDG('Schec EOB#'        )
     A            DU1GTP    R               REFFLD(FLAG)
     A                                      COLHDG('Group Type')
     A            DU1RQT    R               REFFLD(DS10)
     A                                      COLHDG('Initial' 'Requestor')
     A*
     A*   Second Payment of the Duplication Detected
     A*
     A            DU2SQ#         5S 0       COLHDG('Seq #')
     A            DU2SDT    R               REFFLD(DT)
     A                                      COLHDG('Transaction' 'Date')
     A            DU2AMT         9S 2       COLHDG('Payment Amount')
     A            DU2BR2    R               REFFLD(CODE)
     A                                      COLHDG('Payment' 'Value 1')
     A            DU2PVD        30          COLHDG('Paymnt Val 1' 'Description')
     A            DU2FDT    R               REFFLD(DT)
     A                                      COLHDG('From' 'Date')
     A            DU2TDT    R               REFFLD(DT)
     A                                      COLHDG('To' 'Date')
     A            DU2RTP    R               REFFLD(FLAG)
     A                                      COLHDG('Reserve' 'Type')
     A            DU2RCD    R               REFFLD(CODE)
     A                                      COLHDG('Reserve' 'Code')
     A            DU2STT    R               REFFLD(STAT)
     A            DU2CK#         7S 0       COLHDG('Check' 'Number')
     A            DU2EOB         9S 0       COLHDG('Schec EOB#'        )
     A            DU2GTP    R               REFFLD(FLAG)
     A                                      COLHDG('Group Type')
     A            DU2RQT    R               REFFLD(DS10)
     A                                      COLHDG('Initial' 'Requestor')
