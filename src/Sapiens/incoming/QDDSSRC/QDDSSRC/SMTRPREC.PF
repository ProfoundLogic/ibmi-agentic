     A                                      REF(WREFP)
     A          R PTR01                     TEXT('Auto-Diary Triggers')
     A            TRCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TRNAME        10A
     A                                      COLHDG('Trigger Name')
     A            TRSEQ#         5S 0
     A                                      COLHDG('Name Seq#')
     A            TRTYPE        10A
     A                                      COLHDG('Recipient Type')
     A            TRRECIP       10A
     A                                      COLHDG('Recipient')
     A            TRALTTYPE     10A
     A                                      COLHDG('Alternate Recipient' +
     A                                      'Type')
     A            TRALTRECIP    10A
     A                                      COLHDG('Alternate Recipient')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TREMAIL      100A
     A                                      COLHDG('Recipient Email')
     A            TRTEXT        10S
     A                                      COLHDG('Recipient Text')
     A            TRDIGEST  R     A         REFFLD(TIME)
     A                                      COLHDG('Daily' 'Digest' 'Time')
     A            TRDIGESTALR     A         REFFLD(TIME)
     A                                      COLHDG('Alt Daily' 'Digest' 'Time')
