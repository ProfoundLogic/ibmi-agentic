     A                                      REF(FSREFP)
     A          R PWN01                     TEXT('NCCI Data Call WorkFile')
     A*
     A            WNCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
     A*
     A            WNFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group')
     A*
     A            WNRPYMTHF R     S         REFFLD(A50)
     A                                      COLHDG('Reporting Yr/' 'Month From')
     A*
     A            WNRPYMTHT R     S         REFFLD(A50)
     A                                      COLHDG('Reporting Yr/' 'Month To')
     A*
     A            WNRPLVL   R               REFFLD(FLAG)
     A                                      COLHDG('Reporting Lvl' 'Mth/Qtr')
     A*
     A            WNRPMTH   R     S         REFFLD(A60)
     A                                      COLHDG('Reporting ' 'Month/Year')
     A*
     A            WNSBDT    R     S         REFFLD(DT7)
     A                                      COLHDG('Submission Date')
     A*
     A            WNPRST    R               REFFLD(FLAG)
     A                                      COLHDG('Process Status')
     A*
     A            WNEXTDTA  R               REFFLD(FLAG)
     A                                      COLHDG('Extract Data Flag')
     A*
     A            WNPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A*
     A            WNUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A*
     A            WNDT      R     S         REFFLD(DT7)
     A                                      COLHDG('Maintenance Date')
     A*
     A            WNTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
