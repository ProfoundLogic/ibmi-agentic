     A                                      REF(FSREFP)
     A          R PES01                     TEXT('EOMB STATUS TRANS FILE')
     A            ESCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY#')
     A            ESSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A            ESFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            ESFYR     R               REFFLD(FYR)
     A                                      COLHDG('YEAR')
     A            ESCASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE#')
     A            ESSS#     R               REFFLD(SS#)
     A                                      COLHDG('SOC SEC#')
     A            ESACDT    R               REFFLD(DT)
     A                                      COLHDG('ACC DATE')
     A            ESEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('EOMB#')
     A            ESBLST    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS' 'TYPE')
     A*******      Valid values: FTGTP via 'BLST'
     A            ESSTCD    R               REFFLD(CODE3)
     A                                      COLHDG('STATUS' 'CODE')
     A*******      Valid values: based on FTBSP
     A            ESREAS    R               REFFLD(DS60)
     A                                      COLHDG('STATUS' 'CHANGE' 'REASON')
     A*******      Either filled w/status code desc, or user entered,
     A*******      or system generated
     A            ESRCN     R               REFFLD(RCN)
     A                                      COLHDG('RECON#')
     A            ESRRDT    R               REFFLD(DT)
     A                                      COLHDG('RECON' 'RECVD' 'DATE')
     A            ESRSDT    R               REFFLD(DT)
     A                                      COLHDG('RECON' 'SENT' 'DATE')
     A            ESSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            ESUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            ESPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            ESTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            ESDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            ESIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            ESIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            ESITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            ESIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
     A            ESDIAL    R               REFFLD(A10)
     A                                      COLHDG('# DIARIES ALLOWED')
     A            ESDICM    R               REFFLD(A10)
     A                                      COLHDG('# DIARIES COMPLETED')
     A            ESDIDT    R               REFFLD(DT7)
     A                                      COLHDG('DIARY DATE')
     A            ESDKEY    R               REFFLD(DS40)
     A                                      COLHDG('DARTS KEY')
     A            ESDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('DARTS KEY SEQ#')
     A            ESLTR#    R               REFFLD(A90)
     A                                      COLHDG('PEND LETTER')
     A*** BEGIN ADD *** 06/12/02 **************************************
     A            ESBRDT    R               REFFLD(DT8)
     A                                      COLHDG('BILL RVW BILL' +
     A                                      'RECON RCVD DATE')
     A*                                 Format: CCYYMMDD
     A*** END   ADD *** 06/12/02 **************************************
