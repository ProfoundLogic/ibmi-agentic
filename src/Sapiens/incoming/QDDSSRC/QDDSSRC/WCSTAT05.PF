     A          R PST05                     TEXT('Loss Record')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STFUT1         1A         COLHDG('Future use')
     A            STCLCD         4S 0       COLHDG('Classification code')
     A            STFUT2         1A         COLHDG('Future use')
     A            STPRCD         1S 0       COLHDG('Previously reported' +
     A                                      'code')
     A            STLCCD         2S 0       COLHDG('Loss coverage code')
     A            STCLCT         4S 0       COLHDG('Claim count')
     A            STACDT         6S 0       COLHDG('Accident date')
     A            STCLNM        12A         COLHDG('Claim number')
     A            STCSCD         1S 0       COLHDG('Claim status code')
     A            STWWAM         5S 0       COLHDG('Weekly wage amount')
     A            STINCD         2S 0       COLHDG('Injury code')
     A            STCTNM         2S 0       COLHDG('Catastrophe number')
     A            STIIAM         9S 0       COLHDG('Incurred indemnity' +
     A                                      'amount')
     A            STIMAM         9S 0       COLHDG('Incurred medical' +
     A                                      'amount')
     A            STSSN#         9S 0       COLHDG('SSN#')
     A            STFUT3        11A         COLHDG('Future use')
     A            STUTCD         1A         COLHDG('Update type code')
     A            STFUT4         1A         COLHDG('Future use')
     A            STLCAC         2S 0       COLHDG('Loss condition' +
     A                                      'code - Act')
     A            STLCLS         2S 0       COLHDG('Loss condition' +
     A                                      'code - Loss')
     A            STTYRC         2S 0       COLHDG('Loss condition code' +
     A                                      '- Type of recovery')
     A            STTYCV         2S 0       COLHDG('Loss condition code' +
     A                                      '- Type of coverage')
     A            STTYST         2S 0       COLHDG('Loss condition code' +
     A                                      '- Type of settlement')
     A            STVCAM         7S 0       COLHDG('Tot.incurred voc.' +
     A                                      'rehabilitation amt')
     A            STJRST         2S 0       COLHDG('Jurisdiction state')
     A            STMCCD         2S 0       COLHDG('Managed care org' +
     A                                      'type code')
     A            STIJCD         2S 0       COLHDG('Injury part code')
     A            STNTCD         2S 0       COLHDG('Injury nature code')
     A            STICCD         2S 0       COLHDG('Injury cause code')
     A            STOCDS        18A         COLHDG('Occupation desc.')
     A            STVCRH         1A         COLHDG('Voc rehab ind.')
     A            STLUSU         1A         COLHDG('Lump sum indicator')
     A            STFRCD         2S 0       COLHDG('Fraudulent claim cd')
     A            STFUT5         2A         COLHDG('Future use')
     A            STPDAM         9S 0       COLHDG('Paid indemnity amt')
     A            STPMAM         9S 0       COLHDG('Paid medical amt')
     A            STCLAT         9S 0       COLHDG('Claimants attorney' +
     A                                      'fees incurred amt')
     A            STEMAT         9S 0       COLHDG('Employers attorney' +
     A                                      'fees incurred amt')
     A            STDRAM         9S 0       COLHDG('Ded reimb amt')
     A            STTGAM         9S 0       COLHDG('Tot gross incur amt')
     A            STFUT6         2A         COLHDG('Future use')
     A            STPAEX         9S 0       COLHDG('Paid allocated loss' +
     A                                      'adjustment expense')
     A            STIAEX         9S 0       COLHDG('Incu allocated loss' +
     A                                      'adjustment expense')
     A            STSIPR         3S 0       COLHDG('Scheduled indemnity' +
     A                                      'disability %')
