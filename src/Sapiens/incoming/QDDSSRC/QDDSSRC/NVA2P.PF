     A                                      REF(FSREFP)
     A          R PA201                     TEXT('CINC RURAL/URBAN FILE')
     A            A2CPT4    R               REFFLD(DS9)
     A                                      COLHDG('CPT CODE')
     A            A2SMC     R               REFFLD(DS4)
     A                                      COLHDG('SERVICE MODE CODE')
     A            A2DESC    R               REFFLD(DS30)
     A                                      COLHDG('DESCRIPTION')
     A            A2RVU     R               REFFLD(DS9)
     A                                      COLHDG('RBRVS RVU')
     A            A205UC    R               REFFLD(DS9)
     A                                      COLHDG('5/1/96 URBAN CVT' -
     A                                      'FACTOR')
     A            A205RC    R               REFFLD(DS9)
     A                                      COLHDG('5/1/96 RURAL CVT' -
     A                                      'FACTOR')
     A            A205UF    R               REFFLD(DS9)
     A                                      COLHDG('5/1/96 URBAN FEE')
     A            A205RF    R               REFFLD(DS9)
     A                                      COLHDG('5/1/96 RURAL FEE')
     A            A207UC    R               REFFLD(DS9)
     A                                      COLHDG('7/1/96 URBAN CVT' -
     A                                      'FACTOR')
     A            A207RC    R               REFFLD(DS9)
     A                                      COLHDG('7/1/96 RURAL CVT' -
     A                                      'FACTOR')
     A            A207UF    R               REFFLD(DS9)
     A                                      COLHDG('7/1/96 URBAN FEE')
     A            A207RF    R               REFFLD(DS9)
     A                                      COLHDG('7/1/96 RURAL FEE')
     A            A2UNIT    R               REFFLD(DS4)
     A                                      COLHDG('UNITS')
      *              If "unit" entered, then take units entered in
      *              Bill Entry, then multiply fee * units.
      *
      *              If *BLANK then take straight fee
      *
     A            A2BYPS    R               REFFLD(DS6)
     A                                      COLHDG('BYPASS')
      *              If "bypass", then pay each codes at Fee Schedule
      *              allowable.
      *
      *              If *BLANK, then pay per multiple surgery rules,
      *              same as BWC's guidelines.
      *
      * PDS Audit Fields
      *
     A            A2DISC    R               REFFLD(DS3)
     A                                      COLHDG('DISCOUNT CODE')
      *               Based on NMBDP/BDCODE
      *
     A            A2EFDT    R               REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE DATE')
      *               Based on NMBDP/BDEFDT
      *
     A            A2CONV    R               REFFLD(FLAG)
     A                                      COLHDG('CONVERSION' 'STATUS' -
     A                                      'CODE')
      *               E = Assignment not made
      *               L = Assignment made
      *               U = Updated
      *
     A            A2STAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            A2USER    R               REFFLD(USER)
     A                                      COLHDG('CVT USER')
     A            A2PGM     R               REFFLD(PGM)
     A                                      COLHDG('CVT PROGRAM')
     A            A2TIME    R               REFFLD(TIME)
     A                                      COLHDG('CVT TIME')
     A            A2DT      R               REFFLD(DT7)
     A                                      COLHDG('CVT DATE')
     A            A2IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL CVT' 'USER')
     A            A2IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL CVT' 'PROGRAM')
     A            A2ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL CVT' 'TIME')
     A            A2IDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL CVT' 'DATE')
