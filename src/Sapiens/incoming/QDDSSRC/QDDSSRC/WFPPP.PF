     A*  06/16/04  C: 132  PROJECT: 81WWH                             *
     A*                    ADD Area Name and Cancel Date to end       *
     A*                                                               *
     A*****************************************************************
     A
     A          R PPP01                     TEXT('PROD. PERFORMANCE WORKFILE')
     A            PPCO#          3S 0       COLHDG('Company#')
     A            PPCNAM        40A         COLHDG('Company Name')
     A            PPFND          3S 0       COLHDG('Group')
     A            PPFNAM        40A         COLHDG('Group Name')
     A            PPAGT#         5S 0       COLHDG('Agent')
     A            PPANAM        40A         COLHDG('Agent Name')
     A            PPACH#         5S 0       COLHDG('Agent Chapter #')
     A            PPACHD        40A         COLHDG('Agent Chapter Desc')
     A            PPAAD1        40A         COLHDG('Agent Address 1')
     A            PPACSZ        40A         COLHDG('Agent City/State/Zip')
     A            PPAREA         3S 0       COLHDG('Area')
     A            PPCNTY         2A         COLHDG('County')
     A            PPCTYD        40A         COLHDG('County Desc'       )
     A            PPEMP#         9S 0       COLHDG('Employer')
     A            PPDIV          5S 0       COLHDG('Division')
     A            PPENAM        40A         COLHDG('Employer Name')
     A            PPACOD         3S 0       COLHDG('Area Code')
     A            PPPHN#         7S 0       COLHDG('Phone #')
     A            PPECH#         5S 0       COLHDG('Employer Chapter #')
     A            PPECHD        40A         COLHDG('Employer' 'Chapter Desc')
     A            PPPROD         5S 0       COLHDG('Producer #')
     A            PPPNAM        40A         COLHDG('Producer Name')
     A            PPFYR          3S 0       COLHDG('Policy Year')
     A            PPPFDT         8S 0       COLHDG('Policy From Date')
     A            PPPTDT         8S 0       COLHDG('Policy To Date')
     A            PPEFDT         8S 0       COLHDG('Effective Date')
     A            PPWPRM        11S 2       COLHDG('Written Premium')
     A            PPEPRM        11S 2       COLHDG('Earned Premium')
     A            PPCLMS         5S 0       COLHDG('Claims')
     A            PPRESV        11S 2       COLHDG('Reserves')
     A            PPPAID        11S 2       COLHDG('Paid')
     A            PPINCR        11S 2       COLHDG('Incurred')
     A            PPLOSR         7S 2       COLHDG('Loss Ratio')
     A            PPFRQR         7S 2       COLHDG('Freq. Ratio')
     A            PPRATE         7S 2       COLHDG('Rate')
     A            PPDATE         8S 0       COLHDG('Date')
     A            PPTIME         6S 0       COLHDG('Time')
     A            PPPGM         10A         COLHDG('Program name')
     A            PPUSER        10A         COLHDG('User name')
      ***** BEG ADD ****** 06/16/04 ********************************************
     A            PPARNM        40A         COLHDG('Area Name')
     A            PPCXDT         8S 0       COLHDG('Cancelled Date')
      ***** END ADD ****** 06/16/04 ********************************************
      ***** BEG ADD ****** 04/03/06 ********************************************
     A            PPGRCD         3A         COLHDG('Agt Group Code')
     A            PPCONT        40A         COLHDG('Marketing Contact')
     A            PPMKRP         3A         COLHDG('Marketing Rep')
     A            PPMKTR         3A         COLHDG('Mktg Rep Staff Code')
     A                                      TEXT('Marketing Rep Staff Code')
     A            PPRT#          3S 0       COLHDG('Rate #')
     A            PPDESC        30A         COLHDG('Rate Description')
     A            PPPLAN         1A         COLHDG('Plan Type')
     A            PPNWRT         5S 2       COLHDG('New Rate')
     A            PPRNRT         5S 2       COLHDG('Renew Rate')
     A            PPSAGT         5S 0       COLHDG('Secondary Agent#')
     A            PPSRT#         3S 0       COLHDG('Secondary' 'Agt Rate #')
     A                                      TEXT('Secondary Agent Rate #')
     A            PPSNAM        40A         COLHDG('Secondary' 'Agt Name')
     A                                      TEXT('Secondary Agent Name')
     A            PPSFIN         9S 0       COLHDG('Secondary Agent FEIN')
     A            PPSMOD         3S 0       COLHDG('Secondary Agent Mod')
     A            PPSNWR         5S 2       COLHDG('Secondary Rate #')
     A            PPSDES        30A         COLHDG('Secondary' 'Rate Descptn')
     A                                      TEXT('Secondary Rate Description')
     A            PPSRNR         5S 2       COLHDG('Secondary Renew Rate')
     A            PPSPRD         5S 0       COLHDG('Secondary Prod #')
     A            PPSLSN        30A         COLHDG('Secondary' 'Prod Last')
     A                                      TEXT('Secondary Prod Last Name')
     A            PPSFSN        15A         COLHDG('Secondary' 'Prod First')
     A                                      TEXT('Secondary Prod First Name')
     A            PPSPLN         1A         COLHDG('Secondary' 'Plan Type')
     A            PPSADR        40A         COLHDG('Secondary Prod Addr')
     A                                      TEXT('Secondary Producer Address')
     A            PPSCTY        25A         COLHDG('Secondary Prod City')
     A            PPSST          2A         COLHDG('Secondary Prod State')
     A            PPSZIP         9S 0       COLHDG('Secondary' 'Prod Zipcode')
     A                                      TEXT('Secondary Producer Zipcode')
     A            PPFIDT         8S 0       COLHDG('Date filed' 'w/Carrier')
     A                                      TEXT('Date Filed With Carrier')
     A            PPMLDT         8S 0       COLHDG('Date Mailed to State')
     A                                      TEXT('Date Filed With Carrier')
     A            PPCFDT         8S 0       COLHDG('Date Confirmed')
     A            PPDNDT         8S 0       COLHDG('Date Denied')
     A            PPLST          2A         COLHDG('License State' '(Resident)')
     A            PPLIC#        15A         COLHDG('Resident License #e')
     A            PPLEXD         8S 0       COLHDG('License Exp Date')
     A            PPLRND         8S 0       COLHDG('License Renew Date')
      ***** BEG CHG ****** 04/30/06 ********************************************
     A**********  PPACXD         8S 0       COLHDG('Agent Cancel Date')
     A            PPACXD         8S 0       COLHDG('Producer Cancel Date')
      ***** END CHG ****** 04/30/06 ********************************************
      ***** END ADD ****** 04/03/06 ********************************************
      *
      ***** BEG ADD ****** 04/30/06 ********************************************
     A            PPAEFD         8S 0       COLHDG('Agent Effective Date')
     A            PPAGCD         8S 0       COLHDG('Agent Cancel Date')
      ***** END ADD ****** 04/30/06 ********************************************
