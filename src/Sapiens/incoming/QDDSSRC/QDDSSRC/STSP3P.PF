     A                                      REF(SREFP)
     A          R PSP013                    TEXT('SCRIPTURA SIG FILE')
     A            S3TYPE       100A         COLHDG('PROCESS TYPE/DESC')
     A            S3FND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            S3EFDT    R     S         REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            S3SIG        100A         COLHDG('SIGNATURE FILE NAME')
     A            S3PATH       250A         COLHDG('SIGNATURE' 'FOLDER/PATH')
     A            S3STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            S3USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            S3PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            S3TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            S3DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            S3IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            S3IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            S3ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            S3IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
