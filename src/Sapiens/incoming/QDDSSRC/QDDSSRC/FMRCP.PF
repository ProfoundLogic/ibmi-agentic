     A******* 1 ALPHA FIELDS
     A            RC1A1     R               REFFLD(FLAG)
     A                                      COLHDG('PROF COMP FLAG')
     A*                                                A = PC ANE
     A*                                                B = PC BR
     A*                                                T = PT Value
     A*                                                blank = "normal" code
     A*                                                I = PC I.C. (-1)
     A            RC1A2     R               REFFLD(FLAG)
     A                                      COLHDG('ANES FLAG')
     A*                                                Y = Anes w/ Amount
     A*                                                B = Anes BR or I.C. (-1)
     A*                                                blank = "normal" code
     A            RC1A3     R               REFFLD(FLAG)
     A                                      COLHDG('BILATERAL FLAG')
     A*                                     FOR 'OH'   Y = BILATERAL
     A*                                                N = NOT BI
     A*                                                blank = "normal" code
     A            RC1A4     R               REFFLD(FLAG)
     A                                      COLHDG('ASC GROUP')
     A*                                     FOR 'OH'   0 - 8 VALID VALU
     A*                                                blank = "normal" code
     A            RC1A5     R               REFFLD(FLAG)
