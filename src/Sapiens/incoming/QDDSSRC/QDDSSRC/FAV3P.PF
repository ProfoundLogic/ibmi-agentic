     A*
     A* Corvel Payment File - Detail Information
     A*
     A*****************************************************************
     A* Created on 08/30/2002 by c:62 for Project 128MAC
     A*****************************************************************
     A* Purpose: This file will house the 'detail info' record for
     A*          the associated Corvel records. It will be tied to
     A*          FAV1P via V1CNTL = V3CNTL.
     A*****************************************************************
     A* Revisions:
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PV301                     TEXT('Corvel Pmt File - Det Info')
     A            V3TYPE    R               REFFLD(FLAG)
     A                                      COLHDG('Record Type')
     A            V3CNTL    R               REFFLD(DS12)
     A                                      COLHDG('Control Number')
     A            V3LIN#    R     S         REFFLD(A60)
     A                                      COLHDG('Line Number')
     A            V3SVDT    R               REFFLD(DT8)
     A                                      COLHDG('Date of Service')
     A            V3CODE    R               REFFLD(DS8)
     A                                      COLHDG('Code')
     A            V3CDSC    R               REFFLD(DS30)
     A                                      COLHDG('Code Description')
     A            V3UNTS    R     S         REFFLD(A70)
     A                                      COLHDG('Units')
     A            V3MOD     R               REFFLD(DS3)
     A                                      COLHDG('Modifier')
     A            V3MDS1        39A         COLHDG('Modifier Description')
     A            V3MDS2        39A         COLHDG('Mod Additional Desc')
     A            V3POS     R               REFFLD(CODE)
     A                                      COLHDG('Place of Service')
     A            V3CHRG    R     S         REFFLD(A92)
     A                                      COLHDG('Charged')
     A            V3MRA     R     S         REFFLD(A92)
     A                                      COLHDG('MRA Reductions')
     A            V3NDIS    R     S         REFFLD(A92)
     A                                      COLHDG('Network Discount')
     A            V3PAID    R     S         REFFLD(A92)
     A                                      COLHDG('Paid Amount')
     A            V3ID      R               REFFLD(DS35)
     A                                      COLHDG('DS ID #')
     A            V3NDC         18A         COLHDG('NDC Drug Code')
     A            V3QTY     R     S         REFFLD(A90)
     A                                      COLHDG('Number of Units')
     A            V3QALW    R     S         REFFLD(A90)
     A                                      COLHDG('Quantity Allowed')
     A            V3AWP     R     S         REFFLD(A90)
     A                                      COLHDG('Average wholesale')
     A            V3DXR     R               REFFLD(DS4)
     A                                      COLHDG('ICD9 x-ref')
     A            V3IRDT    R               REFFLD(DT8)
     A                                      COLHDG('Insurer Date Receive')
     A            V3FILL        66A         COLHDG('Filler')
     A            V3EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB#')
     A            V3DSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('(PDS) Detail' +
     A                                      'Sequence #')
     A            V3PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('Process Flag')
