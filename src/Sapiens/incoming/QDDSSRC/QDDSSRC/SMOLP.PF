     A**
     A* * * OPTICAL OBJECT   LOCATION * *
     A*
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*  01/05/05 C:02  Project: DR189                                *
     A*                 ADDED IFS FLAG AND UNC PATH FOR THIS FILE     *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R POL01                     TEXT('OBJECT   LOCATION -
     A                                      FILE(OPTICAL)')
     A            OLKEY     R               REFFLD(KEY)
     A            OLSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            OLSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A            OLOFLR        60A         TEXT('OBJECT FOLDER(PATH)')
     A            OLOID         40A         TEXT('OBJECT ID')
     A*
     A            OLSYS          1A         TEXT('AS/400  SYSTEM ID          ')
     A            OLDCID        12A         TEXT('UNIQUE OBJECT ID (ON OPT)  ')
     A            OLOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            OLOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            OLOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A            OL#BYT         5S 1       TEXT('NUMBER OF  KBYTES IN DOCUME')
     A            OLDTWR         7  0       TEXT('DATE WRITTEN TO OPT        ')
     A            OLTMWR         6S 0       TEXT('TIME WRITTEN TO OPT        ')
     A            OLUSWR         8A         TEXT('USER WROTE TO OPT          ')
     A            OLPAGS         4S 0       TEXT('OBJECT   PAGES             ')
     A            OLOPTF         1A         TEXT('OPTICAL STORE FLAG         ')
     A            OLVOL1        10A         TEXT('VOLUME ID-1                ')
     A            OLVOL2        10A         TEXT('VOLUME ID-2                ')
     A            OLVOL3        10A         TEXT('VOLUME ID-3                ')
      *
      ****** TAPE LOCATION INFORMATION *****************************************
     A            OLTAPF         1A         TEXT('TAPE    STORE FLAG         ')
     A            OLDTWT         7  0       TEXT('DATE WRITTEN TO TAPE       ')
     A            OLTMWT         6S 0       TEXT('TIME WRITTEN TO TAPE       ')
     A            OLUSWT         8A         TEXT('USER WROTE TO TAPE         ')
     A            OLTVOL        10A         TEXT('VOLUME ID-OF TAPE          ')
     A*
     A            OLBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            OLFLD1        10A         TEXT('FUTURE USE                 ')
     A            OLSTAT    R               REFFLD(STAT)
     A            OLUSER    R               REFFLD(USER)
     A            OLPGM     R               REFFLD(PGM)
     A            OLTIME    R               REFFLD(TIME)
     A            OLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OLIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            OLIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            OLTDOC        12A         TEXT('UNIQUE OBJECT   ID-TAPE    ')
     A**** 01/05/05 **** ADD **************************************************
     A            OLUNCF    R               REFFLD(FLAG)
     A                                      TEXT('UNC FLAG <> BLANK IS IFS USE')
     A            OLUNCP    R               REFFLD(UNCP)
     A                                      TEXT('UNC PATH FOR IFS')
     A**** 01/05/05 **** END ADD **********************************************
