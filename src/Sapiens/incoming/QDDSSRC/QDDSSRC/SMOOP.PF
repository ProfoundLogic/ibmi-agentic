     A**
     A* * * OPTICAL OBJECT   LOCATION * *
     A*
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R POO01                     TEXT('OBJECT   LOCATION -
     A                                      FILE(OPTICAL)')
     A            OOKEY     R               REFFLD(KEY)
     A            OOSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            OOSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A            OOOFLR        60A         TEXT('OBJECT FOLDER(PATH)')
     A            OOOID         40A         TEXT('OBJECT ID')
     A*
     A            OOSYS          1A         TEXT('AS/400  SYSTEM ID          ')
     A            OODCID        12A         TEXT('UNIQUE OBJECT ID (ON OPT)  ')
     A            OOOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            OOOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            OOOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A            OO#BYT         5S 1       TEXT('NUMBER OF  KBYTES IN DOCUME')
     A            OODTWR         7  0       TEXT('DATE WRITTEN TO OPT        ')
     A            OOTMWR         6S 0       TEXT('TIME WRITTEN TO OPT        ')
     A            OOUSWR         8A         TEXT('USER WROTE TO OPT          ')
     A            OOPAGS         4S 0       TEXT('OBJECT   PAGES             ')
     A            OOOPTF         1A         TEXT('OPTICAL STORE FLAG         ')
     A            OOVOL1        10A         TEXT('VOLUME ID-1                ')
     A            OOVOL2        10A         TEXT('VOLUME ID-2                ')
     A            OOVOL3        10A         TEXT('VOLUME ID-3                ')
      *
      *  Backup Location Information
      *
     A            OOBKID        12A         TEXT('OPTICAL BACKUP DOC ID      ')
     A            OOBKFD         8A         TEXT('OPTICAL BACKUP FOLDER NAME ')
     A            OOBKSD        12A         TEXT('OPTICAL BACKUP SUBDIR NAME ')
     A            OOBKV1        10A         TEXT('BACKUP VOLUME ID-1         ')
     A            OOBKV2        10A         TEXT('BACKUP VOLUME ID-2         ')
     A            OOBKV3        10A         TEXT('BACKUP VOLUME ID-3         ')
      *
      ****** TAPE LOCATION INFORMATION *****************************************
     A            OOTAPF         1A         TEXT('TAPE    STORE FLAG         ')
     A            OODTWT         7  0       TEXT('DATE WRITTEN TO TAPE       ')
     A            OOTMWT         6S 0       TEXT('TIME WRITTEN TO TAPE       ')
     A            OOUSWT         8A         TEXT('USER WROTE TO TAPE         ')
     A            OOTVOL        10A         TEXT('VOLUME ID-OF TAPE          ')
     A*
     A            OOBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            OOFLD1        10A         TEXT('FUTURE USE                 ')
     A            OOSTAT    R               REFFLD(STAT)
     A            OOUSER    R               REFFLD(USER)
     A            OOPGM     R               REFFLD(PGM)
     A            OOTIME    R               REFFLD(TIME)
     A            OODT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OOIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            OOIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            OOTDOC        12A         TEXT('UNIQUE OBJECT   ID-TAPE    ')
