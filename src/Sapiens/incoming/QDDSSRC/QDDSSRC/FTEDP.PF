     A                                      REF(FSREFP)
     A          R PED01                     TEXT('PROV BILL ERROR DESC TABLE')
     A            EDCODE    R               REFFLD(DS3)
     A                                      COLHDG('ERROR' 'CODE')
     A                                      TEXT('ERROR CODE')
     A            EDDESC    R               REFFLD(DS00)
     A                                      COLHDG('ERROR' 'CODE' 'DESCRIPTION')
     A                                      TEXT('ERROR CODE DESCRIPTION')
     A            EDSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A                                      TEXT('STATUS')
     A            EDUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT' 'USER')
     A                                      TEXT('MAINT USER')
     A            EDPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT' 'PGM')
     A                                      TEXT('MAINT PGM')
     A            EDTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT' 'TIME')
     A                                      TEXT('MAINT TIME')
     A            EDDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT' 'DATE')
     A                                      TEXT('MAINT DATE')
     A            EDIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT' 'USER')
     A                                      TEXT('INIT USER')
     A            EDIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT' 'PGM')
     A                                      TEXT('INIT PGM')
     A            EDITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT' 'TIME')
     A                                      TEXT('INIT TIME')
     A            EDIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT' 'DATE')
     A                                      TEXT('INIT DATE')
