     A                                      REF(FSREFP)
     A          R PLC01                     TEXT('Invalid License Number +
     A                                      Prefixes Table File.')
     A            LCST      R               REFFLD(ST)
     A                                      COLHDG('STATE')
     A            LCLIPR    R               REFFLD(DS5)
     A                                      COLHDG('LICENSE NUMBER' +
     A                                             'PREFIX')
     A            LCDESC    R               REFFLD(DS00)
     A                                      COLHDG('DESCRIPTION')
     A*** Beg Add ************ 03/20/08 ***********************************
     A            LCBTYP         1A
     A                                      COLHDG('BILL' +
     A                                             'TYPE')
     A*** End Add ************ 03/20/08 ***********************************
     A            LCSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            LCUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' +
     A                                             'USER')
     A            LCPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' +
     A                                             'PROGRAM')
     A            LCTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' +
     A                                             'TIME')
     A            LCDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' +
     A                                             'DATE')
     A            LCIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' +
     A                                             'USER')
     A            LCIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' +
     A                                             'PROGRAM')
     A            LCITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' +
     A                                             'TIME')
     A            LCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' +
     A                                             'DATE')
     A*** BEG ADD *** 03/11/10 ********************************************
     A            LCREVI    R               REFFLD(FLAG)
     A                                      COLHDG('MEIG REVISION' +
     A                                             'INDICATOR')
     A            LCEFDT    R     S         REFFLD(DT)
     A                                      COLHDG('EFFECTIVE' +
     A                                             'DATE')
     A            LCCNDT    R     S         REFFLD(DT)
     A                                      COLHDG('CANCELLATION' +
     A                                             'DATE')
     A*** END ADD *** 03/11/10 ********************************************
