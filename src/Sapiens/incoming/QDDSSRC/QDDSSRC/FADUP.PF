     A** WCMC - DUPLICATE CLAIMS WORK FILE **
     A**
     A                                      REF(FSREFP)
     A          R PDU01                     TEXT('DUP WORK FILE')
     A            DUCO#     R               REFFLD(CO#)
     A            DUFND     R               REFFLD(FND)
     A            DUFYR     R               REFFLD(FYR)
     A            DUCASE    R               REFFLD(CASE)
     A            DUSS#     R               REFFLD(SS#)
     A            DUACDT    R               REFFLD(DT)
     A                                      COLHDG('ACCIDENT' 'DATE')
     A            DUFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('PAYEE' 'FEDERAL' 'ID #')
     A            DUMOD     R               REFFLD(MOD)
     A            DUTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            DUFDAT    R               REFFLD(DT)
     A                                      COLHDG('FROM SERV' 'DATE')
     A            DUTDAT    R               REFFLD(DT)
     A                                      COLHDG('TO SERV' 'DATE')
     A            DUDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('DETAIL' 'SEQUENCE #')
     A            DUFLG1    R               REFFLD(FLAG) COLHDG('EOB PRTD')
     A                                      TEXT('EOB PRTD FLAG')
     A            DUFLG2    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED YET FLAG')
     A            DUFLG3    R               REFFLD(FLAG)
     A                                      TEXT('NOT USED YET FLAG')
     A            DUSTAT    R               REFFLD(STAT)
     A            DUUSER    R               REFFLD(USER)
     A            DUPGM     R               REFFLD(PGM)
     A            DUTIME    R               REFFLD(TIME)
     A            DUDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            DUCODE    R               REFFLD(CPT4)
     A                                      COLHDG('CODE')
     A            DUPMOD    R               REFFLD(PMOD)
     A                                      COLHDG('PROC' 'MOD')
     A            DUAMT     R               REFFLD(A92)
     A                                      COLHDG('TOTAL' 'CHARGES')
     A            DUEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('EOB #')
     A            DUSVCD    R               REFFLD(SVCD)
     A                                      COLHDG('SERV CODE')
     A            DUUNTS    R               REFFLD(A52)
     A                                      COLHDG('UNITS')
     A            DUSUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A            DUNDC     R               REFFLD(NDC)
     A                                      COLHDG('NDC DRUG' 'CODE')
     A          K DUCO#
     A          K DUSUB#
     A          K DUFND
     A          K DUFYR
     A          K DUCASE
     A          K DUDSEQ
