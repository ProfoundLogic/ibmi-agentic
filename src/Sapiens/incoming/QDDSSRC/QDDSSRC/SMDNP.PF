     A**
     A** SYSTEM WIDE REMARKS ****
     A**
     A* * * OPTICAL DOCUMENT LOCATION * *
     A*
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PDN01                     TEXT('DOCUMENT LOCATION -
     A                                      FILE(OPTICAL)')
     A            DNKEY     R               REFFLD(KEY)
     A            DNSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            DNSYS          1A         TEXT('SYSTEM ID                  ')
     A            DNDCID        12A         TEXT('UNIQUE DOCUMENT ID         ')
     A            DNOSYS         1A         TEXT('OPTICAL SYSTEM ID          ')
     A            DNOFLD         8A         TEXT('OPTICAL FOLDER NAME        ')
     A            DNOSBD        12A         TEXT('OPTICAL SUBDIRECTORY NAME  ')
     A            DN#BYT         5S 1       TEXT('NUMBER OF  KBYTES IN DNCUME')
     A            DNDTWR         7  0       TEXT('DATE WRITTEN TO OPT        ')
     A            DNTMWR         6S 0       TEXT('TIME WRITTEN TO OPT        ')
     A            DNUSWR         8A         TEXT('USER WROTE TO OPT          ')
     A            DNPAGS         4S 0       TEXT('DOCUMENT PAGES             ')
     A            DNOPTF         1A         TEXT('OPTICAL STORE FLAG         ')
     A            DNVOL1        10A         TEXT('VOLUME ID-1                ')
     A            DNVOL2        10A         TEXT('VOLUME ID-2                ')
     A            DNVOL3        10A         TEXT('VOLUME ID-3                ')
      *
      *  Backup Location Information
      *
     A            DNBKID        12A         TEXT('OPTICAL BACKUP DOC ID      ')
     A            DNBKFD         8A         TEXT('OPTICAL BACKUP FOLDER NAME ')
     A            DNBKSD        12A         TEXT('OPTICAL BACKUP SUBDIR NAME ')
     A            DNBKV1        10A         TEXT('BACKUP VOLUME ID-1         ')
     A            DNBKV2        10A         TEXT('BACKUP VOLUME ID-2         ')
     A            DNBKV3        10A         TEXT('BACKUP VOLUME ID-3         ')
      *
      ****** TAPE LOCATION INFORMATION *****************************************
     A            DNTAPF         1A         TEXT('TAPE    STORE FLAG         ')
     A            DNDTWT         7  0       TEXT('DATE WRITTEN TO TAPE       ')
     A            DNTMWT         6S 0       TEXT('TIME WRITTEN TO TAPE       ')
     A            DNUSWT         8A         TEXT('USER WROTE TO TAPE         ')
     A            DNTVOL        10A         TEXT('VOLUME ID-OF TAPE          ')
     A*
     A            DNBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            DNFLD1        10A         TEXT('FUTURE USE                 ')
     A            DNSTAT    R               REFFLD(STAT)
     A            DNUSER    R               REFFLD(USER)
     A            DNPGM     R               REFFLD(PGM)
     A            DNTIME    R               REFFLD(TIME)
     A            DNDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            DNIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            DNIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            DNTDOC        12A         TEXT('UNIQUE DOCUMENT ID-TAPE    ')
     A            DNVALD         1A         TEXT('LINK VALIDATION FLAG       ')
