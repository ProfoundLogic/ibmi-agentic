     A* 08/19/19  C:291  Project: 150WEA                                   *
     A*                  Add Effective and Expiration date.                *
     A*                  Rename the From Zip field to Zip Code             *
     A*                  Remove the To Zip Code field.                     *
     A*                                                                    *
     A**********************************************************************
     A                                      REF(SREFP)
     A          R PTZ01                     TEXT('Factor by Zip -
     A                                      Code File')
     A*
     A            TZCAR#         5S 0       COLHDG('Carrier #')
     A            TZFND          3S 0       COLHDG('Group#')
      *** Beg Chg ***** 08/19/19 *****************************************
      ***         TZFRMZIP       5S 0       COLHDG('From Zip Code')
      ***         TZTOZIP        5S 0       COLHDG('To Zip Code')
     A            TZZIP          5S 0       COLHDG('Zip Code')
      *** End Chg ***** 08/19/19 *****************************************
      *** Beg Add ***** 08/19/19 *****************************************
     A            TZEFDT    R               REFFLD(DT)
     A                                      COLHDG('Effective Date')
     A            TZEXDT    R               REFFLD(DT)
     A                                      COLHDG('Expiration Date')
      *** End Add ***** 08/19/19 *****************************************
     A            TZTDF          5S 4       COLHDG('Territorial' -
     A                                      ' Differential Factor')
     A            TZSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Status')
     A            TZUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TZPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Program')
     A            TZTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TZDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TZIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TZIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Program')
     A            TZITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TZIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
