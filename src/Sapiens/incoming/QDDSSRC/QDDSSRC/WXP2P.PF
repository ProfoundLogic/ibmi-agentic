     A*** END ADD *****  11/22/17  ****************************************
     A*** BEGIN ADD ***  02/08/18  ****************************************
     A            P2ENCDFED R     S         REFFLD(A30)
     A                                      COLHDG('ENTITY' 'CODE')
     A            P2NLKCFED R     S         REFFLD(A20)
     A                                      COLHDG('NAME LINK' 'COUNTER')
     A*** END ADD *****  02/08/18  ****************************************
     A*** BEGIN ADD ***  06/09/21  ****************************************
     A            P2LOCELTY R               REFFLD(FLAG)
     A                                      COLHDG('ENTITY/LOCATION FLAG')
     A            P2LOCBTYP R               REFFLD(DS40)
     A                                      COLHDG('LOC TYPE OF BUSINESS')
     A*** END ADD *****  06/09/21  ****************************************
     A*** BEGIN ADD ***  06/23/23  ****************************************
     A            P2LOCPHN       7S 0       COLHDG('LOCATION PHONE#')
     A            P2LOCAREA      3S 0       COLHDG('LOCATION AREA CODE')
     A            P2LOCFAX       7S 0       COLHDG('LOCATION FAX#')
     A            P2LOCFARA      3S 0       COLHDG('LOCATION FAX' 'AREA CODE')
