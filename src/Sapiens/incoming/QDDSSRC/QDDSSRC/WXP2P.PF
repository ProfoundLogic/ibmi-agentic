     A                                      COLHDG('MAILING CITY/ST/ZIP')
     A*** BEGIN ADD ***  06/20/16  ********************************************
     A            P2MAILCTY R               REFFLD(CTY)
     A                                      COLHDG('PHYSICAL' 'CITY')
     A            P2MAILST  R               REFFLD(ST)
     A                                      COLHDG('PHYSICAL' 'STATE')
     A            P2MAILZIP R     S         REFFLD(ZIP)
     A                                      COLHDG('PHYSICAL' 'ZIP CODE')
     A*** END ADD *****  06/20/16  ********************************************
     A*
     A            P2STUE#   R               REFFLD(DS20)
     A                                      COLHDG('STATE UE #')
     A            P2TAXID   R               REFFLD(DS20)
     A                                      COLHDG('NJ TAX ID')
     A            P2RISKID  R               REFFLD(DS20)
     A                                      COLHDG('STATE RISK ID')
     A            P2NAICS   R               REFFLD(DS10)
     A                                      COLHDG('NAICS CODE')
     A            P2SIC     R               REFFLD(SIC)
     A                                      COLHDG('SIC CODE')
     A            P2LEASEID R               REFFLD(FLAG)
     A                                      COLHDG('LEASING ID')
     A            P2LEASEDS R               REFFLD(DS40)
     A                                      COLHDG('LEASING DESCRIPTION')
     A            P2DIV#    R     S         REFFLD(DIV)
     A                                      COLHDG('DIVISION #')
     A            P2LOC#        10A
     A                                      COLHDG('ENTITY/LOCATION #')
     A*
     A* MAINTENANCE FIELDS
     A*
     A            P2USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            P2PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            P2TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            P2DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A*
     A*** BEGIN ADD ***  11/08/17  ****************************************
     A            P2ENCD    R     S         REFFLD(A30)
     A                                      COLHDG('ENTITY' 'CODE')
     A            P2NLKC    R     S         REFFLD(A20)
     A                                      COLHDG('NAME LINK' 'COUNTER')
     A            P2EMPY    R     S         REFFLD(A70)
     A                                      COLHDG('NUMBER' 'OF EMPLOYEES')
     A            P2SEQ#    R     S         REFFLD(SEQ#)
     A                                      COLHDG('ADDL NAMED' 'INSURED #')
     A*** END ADD *****  11/08/17  ****************************************
     A*** BEGIN ADD ***  11/22/17  ****************************************
     A            P2LINK    R               REFFLD(DS15)
