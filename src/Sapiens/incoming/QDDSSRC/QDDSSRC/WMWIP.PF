     A          R PWI01                     TEXT('Witness Format')
     A*
     A            WICO#          3P 0       COLHDG('COMPANY #')
     A*
     A            WIFND          3P 0       COLHDG('FUND')
     A*
     A            WIFYR          3P 0       COLHDG('POLICY YEAR')
     A*
     A            WICASE         7P 0       COLHDG('CASE')
     A*
     A            WINAME        40A         COLHDG('WITNESS' 'NAME')
     A*
     A            WIBPH#        15S 0       COLHDG('WITNESS' 'BUSINESS' +
     A                                      'PHONE NUMBER')
     A*
     A            WIUSER        10A         COLHDG('USER')
     A*
     A            WIPGM         10A         COLHDG('PROGRAM')
     A*
     A            WIDT           7S 0       COLHDG('DATE')
     A*
     A            WITIME         6S 0       COLHDG('TIME')
