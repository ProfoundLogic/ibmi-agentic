     A                                      REF(WREFP)
     A          R PPS01                     TEXT('PROD ST INFO (NON-RES) FILE')
     A            PSCO#     R               REFFLD(CO#)
     A            PSFEIN    R               REFFLD(FEIN)
     A            PSMOD     R               REFFLD(MOD)
     A            PSPROD    R               REFFLD(AGT#)
     A                                      COLHDG('PRODUCER' 'NUMBER')
     A            PSST      R               REFFLD(ST)
     A                                      COLHDG('NON-RESIDENT STATE')
     A            PSFIDT    R               REFFLD(DT)
     A                                      COLHDG('DATE FILED W/CARRIER')
     A            PSMLDT    R               REFFLD(DT)
     A                                      COLHDG('DATE MAILED TO STATE')
     A            PSCFDT    R               REFFLD(DT)
     A                                      COLHDG('DATE CONFIRMED')
     A            PSDNDT    R               REFFLD(DT)
     A                                      COLHDG('DATE DENIED')
     A            PSLFLG    R               REFFLD(FLAG)
     A                                      COLHDG('LICENSE FLAG')
     A            PSLIC#    R               REFFLD(DS15)
     A                                      COLHDG('RESIDENT LICENSE #')
     A            PSEXDT    R               REFFLD(DT)
     A                                      COLHDG('LICENSE EXP DATE')
     A            PSRWDT    R               REFFLD(DT)
     A                                      COLHDG('LICENSE RENEWAL DATE')
     A            PSLTYP    R               REFFLD(DS5)
     A                                      COLHDG('TYPE OF LICENSE 1')
     A            PSLTP2    R               REFFLD(DS5)
     A                                      COLHDG('TYPE OF LICENSE 2')
     A            PSLTP3    R               REFFLD(DS5)
     A                                      COLHDG('TYPE OF LICENSE 3')
     A            PSLTP4    R               REFFLD(DS5)
     A                                      COLHDG('TYPE OF LICENSE 4')
     A            PSLTP5    R               REFFLD(DS5)
     A                                      COLHDG('TYPE OF LICENSE 5')
     A            PSCOM1    R               REFFLD(DS40)
     A                                      COLHDG('COMMENT 1')
     A            PSCOM2    R               REFFLD(DS40)
     A                                      COLHDG('COMMENT 2')
     A            PSSTAT    R               REFFLD(STAT)
     A            PSUSER    R               REFFLD(USER)
     A            PSPGM     R               REFFLD(PGM)
     A            PSTIME    R               REFFLD(TIME)
     A            PSDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            PSIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            PSIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            PSITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            PSIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
