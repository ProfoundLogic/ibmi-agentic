     A*TITLE WXCUP - WORKERS' COMP CUMULATIVE LOSS RATIO WORKFILE
     A*****************************************************************
     A* PROGRAM DESCRIPTION:                                          *
     A*                                                               *
     A* THIS PROGRAM IS A COPY FROM PCA VERSION OF CUMULATIVE RATIO   *
     A* REPORT WITH THE THE EXCEPTION OF EMPLOYER UNDERWRITER.        *
     A* USES A WORKFILE TO SAVE THE REPORT OF CUMULATIVE LOSS RATIO.  *
     A*                                                               *
     A* CALLED FROM:                                                  *
     A*   WXCUL                                                       *
     A* CALLS TO:                                                     *
     A*   NONE                                                        *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 05/10/02 C:132 PROJECT: 71WDS                                 *
     A*               ADD NEW SIC CODE FIELD FOR SORT                 *
     A*                                                               *
     A* 06/26/97 C:62 PROJECT: WC710                                  *
     A*               ADD NEW 4A COUNTY CODE THAT HAS STATE CAT TO IT *
     A*                                                               *
     A* 08/12/97 C:78 PROJECT: WC577                                  *
     A*               CHANGE FIELDS CUEXM1/2/3 TO PRINT 4 DECIMAL     *
     A*               PLACES.                                         *
     A*                                                               *
     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PCU01                     TEXT('CUM LOSS RATIO WORKFILE')
     A            CUCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            CUFND     R               REFFLD(FND)
     A                                      COLHDG('FUND')
     A            CUFYR     R               REFFLD(FYR)
     A                                      COLHDG('FUND YEAR')
     A            CUEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER NUMBER')
     A            CUDIV     R               REFFLD(DIV)
     A                                      COLHDG('TO EMPLR DIVISION')
     A            CUENAM    R               REFFLD(NAME)
     A                                      COLHDG('EMPLOYER NAME')
     A            CUEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            CUCNDT    R               REFFLD(DT)
     A                                      COLHDG('CANCEL DATE')
     A            CUWALS    R               REFFLD(FLAG)
     A                                      COLHDG('WATCH' 'LIST' 'FLAG')
     A            CUCHAP    R               REFFLD(RGN#)
     A                                      COLHDG('CHAPTER')
     A*** BEGIN ADD *** 07/07/97 **************************************
     A**********  CUCNTY    R               REFFLD(CODE)
     A            CUCNTY    R               REFFLD(SVC1)
     A*** END   ADD *** 07/07/97 **************************************
     A                                      COLHDG('COUNTY CODE')
     A            CURGN#    R               REFFLD(RGN#)
     A            CUAGT#    R               REFFLD(AGT#)
     A                                      COLHDG('AGENT #' 'ASSIGNED BY FUND')
      **** BEGIN CHG **** 08/12/97 ************************************
     A************CUEXM1****R***************REFFLD(PC32)
     A            CUEXM1    R               REFFLD(PC54)
      **** END   CHG **** 08/12/97 ************************************
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 1')
     A            CUEMD1    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 1')
      **** BEGIN CHG **** 08/12/97 ************************************
     A************CUEXM2****R***************REFFLD(PC32)
     A            CUEXM2    R               REFFLD(PC54)
      **** END   CHG **** 08/12/97 ************************************
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 2')
     A            CUEMD2    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 2')
      **** BEGIN CHG **** 08/12/97 ************************************
     A************CUEXM3****R***************REFFLD(PC32)
     A            CUEXM3    R               REFFLD(PC54)
      **** END   CHG **** 08/12/97 ************************************
     A                                      COLHDG('EXPERIENCE' 'MODIFIER 3')
     A            CUEMD3    R               REFFLD(DT)
     A                                      COLHDG('EXP MOD' 'EFFECT DATE 3')
     A            CUSRT1    R               REFFLD(NAME)
     A                                      COLHDG('SORT FIELD')
     A            CUUSER    R               REFFLD(USER)
     A            CUPGM     R               REFFLD(PGM)
     A            CUTIME    R               REFFLD(TIME)
     A            CUDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
      **** BEGIN CHG **** 05/10/02 ************************************
     A            CUSIC     R               REFFLD(SIC)
     A                                      COLHDG('SIC' 'CODE')
      **** END CHG ****** 05/10/02 ************************************
