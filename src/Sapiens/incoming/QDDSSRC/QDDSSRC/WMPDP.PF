     A            PDIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL USER')
     A            PDIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL PGM')
     A            PDITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            PDIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A***** END   ADD **** 06/04/04 ***********************************
