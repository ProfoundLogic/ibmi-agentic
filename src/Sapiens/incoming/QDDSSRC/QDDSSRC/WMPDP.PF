     A                                      REF(WREFP)
     A          R PPD01                     TEXT('PAYEE DEMOGRAPHICS MSTR FILE')
     A            PDFEIN    R               REFFLD(FEIN)
     A            PDMOD     R               REFFLD(MOD)
     A            PDNAME    R               REFFLD(NAME)
     A            PDFSN     R               REFFLD(FSN)
     A            PDTITL    R               REFFLD(TITL)
     A            PDADR1    R               REFFLD(ADR1)
     A            PDCTY     R               REFFLD(CTY)
     A            PDST      R               REFFLD(ST)
     A            PDZIP     R               REFFLD(ZIP)
     A            PDAREA    R               REFFLD(AREA)
     A            PDPHN#    R               REFFLD(PHN#)
     A            PDSHNM    R               REFFLD(NM10)
     A                                      COLHDG('SHORT' 'NAME')
     A            PD1099    R               REFFLD(FLAG)
     A                                      COLHDG('1099' 'FLAG')
     A            PDTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('PAYEE' 'TYPE')
     A            PDSPCD    R               REFFLD(SPEC)
     A            PDSTAT    R               REFFLD(STAT)
     A            PDUSER    R               REFFLD(USER)
     A            PDPGM     R               REFFLD(PGM)
     A            PDTIME    R               REFFLD(TIME)
     A            PDDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*** BEGIN ADD FOR FEE SCHEDULE FL STATE TAPE SUBMISSION *************
     A            PDFLIC    R               REFFLD(FEI2)
     A                                      COLHDG('PHYS' 'FL LIC#')
     A            PDVFLG    R               REFFLD(FLAG)
     A                                      COLHDG('LIC#' 'VERIFICATION' 'FLAG')
     A***** END ADD FOR FEE SCHEDULE FL STATE TAPE SUBMISSION *************
     A*** BEGIN ADD *** 11/05/96 ****************************************
     A            PD109M    R               REFFLD(MOD)
     A                                      COLHDG('1099 MAILED' 'TO MOD')
     A            PDADR2    R               REFFLD(ADR2)
     A                                      COLHDG('Address Line 2')
     A            PDDBA1    R               REFFLD(FLAG)
     A                                      COLHDG('ADDR1' 'Used as DBA' '(Y/bl-
     A                                      ank')
     A            PDFXAR    R               REFFLD(AREA)
     A                                      COLHDG('FAX#' 'Area' 'Code')
     A            PDFAX#    R               REFFLD(PHN#)
     A                                      COLHDG('FAX#' 'Phone')
     A            PDW9SE    R               REFFLD(DT7)
     A                                      COLHDG('W9' 'Sent' 'Date')
     A            PDW9RC    R               REFFLD(DT7)
     A                                      COLHDG('W9' 'Received' 'Date')
     A            PDBKUP    R               REFFLD(FLAG)
     A                                      COLHDG('Backup' 'Withholding' 'Y/N')
     A            PDWCCE    R               REFFLD(FLAG)
     A                                      COLHDG('WC' 'Certified' 'Y/N')
     A*** END   ADD *** 11/05/96 ****************************************
     A*** BEGIN ADD ** 03/06/97 ************************************************
     A            PDWCDT    R               REFFLD(DT7)
     A                                      COLHDG('WC' 'Cert' 'Date')
