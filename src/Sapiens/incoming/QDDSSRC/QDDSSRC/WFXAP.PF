     A                                      REF(WREFP)
     A          R PXA01                     TEXT('ACTIVE POLICY WORKFILE')
      *
     A            XACO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
     A            XACONM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY NAME')
     A            XAFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            XAFNAM    R               REFFLD(DS60)
     A                                      COLHDG('GROUP NAME')
     A            XAEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER NUMBER')
     A            XADIV     R               REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A            XAFYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            XAENAM    R               REFFLD(NAME)
     A                                      COLHDG('EMPLOYER NAME')
     A            XATOTC    R               REFFLD(A70)
     A                                      COLHDG('TOTAL CLAIMS ENTERED')
     A            XA02      R               REFFLD(A70)
     A                                      COLHDG('COUNT RECEIVED' +
     A                                      'WITHIN' '0-2 DAYS')
     A***** BEG CHG ***** 05/26/00 ************************************
     A**********  XA2PCT    R               REFFLD(A30)
     A            XA2PCT         4S 1
     A***** END CHG ***** 05/26/00 ************************************
     A                                      COLHDG('PERCENT RECEIVED' +
     A                                      'WITHIN' '0-2 DAYS')
     A            XA37      R               REFFLD(A70)
     A                                      COLHDG('COUNT RECEIVED' +
     A                                      'WITHIN' '3-7 DAYS')
     A***** BEG CHG ***** 05/26/00 ************************************
     A**********  XA7PCT    R               REFFLD(A30)
     A            XA7PCT         4S 1
     A***** END CHG ***** 05/26/00 ************************************
     A                                      COLHDG('PERCENT RECEIVED' +
     A                                      'WITHIN' '3-7 DAYS')
     A            XAOVER    R               REFFLD(A70)
     A                                      COLHDG('COUNT RECEIVED' +
     A                                      'OVER 7 DAYS')
     A***** BEG CHG ***** 05/26/00 ************************************
     A**********  XAOPCT    R               REFFLD(A30)
     A            XAOPCT         4S 1
     A***** END CHG ***** 05/26/00 ************************************
     A                                      COLHDG('PERCENT RECEIVED' +
     A                                      'OVER 7 DAYS')
     A            XAPFDT    R               REFFLD(DT)
     A                                      COLHDG('POLICY EFFECTIVE' +
     A                                      'DATE')
     A            XATOTI    R               REFFLD(A112)
     A                                      COLHDG('TOTAL INCURRED')
     A            XARGN#    R               REFFLD(RGN#)
     A                                      COLHDG('REGION NUMBER')
     A            XARNAM    R               REFFLD(DS30)
     A                                      COLHDG('REGION NAME')
      *
     A            XAPGM         10A         COLHDG('PROGRAM')
     A            XAUSER        10A         COLHDG('USER')
     A            XATIME         6S 0       COLHDG('TIME')
     A            XADT           7S 0       COLHDG('DATE')
      *
     A          K XACO#
     A          K XARGN#
     A          K XAEMP#
     A          K XADIV
