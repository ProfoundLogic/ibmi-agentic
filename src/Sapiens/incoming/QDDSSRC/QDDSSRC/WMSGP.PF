     A                                      REF(WREFP)
     A          R PSG01                     TEXT('Signature File')
     A            SGCO#     R               REFFLD(CO#)
     A            SGNAME    R               REFFLD(DS30)
     A                                      COLHDG('Full Name')
     A            SGFONT    R               REFFLD(DS10)
     A                                      COLHDG('Font' 'Characters')
     A            SGCMD         23A         COLHDG('PCL5 Command String')
     A            SGID           3S 0       COLHDG('Printer' 'Font ID')
     A            SGFLR     R               REFFLD(DS40)
     A                                      COLHDG('PDS' 'Folder')
     A            SGDOC         12A
     A                                      COLHDG('PDS' 'Document')
     A            SGSTAT    R               REFFLD(STAT)
     A            SGUSER    R               REFFLD(USER)
     A            SGPGM     R               REFFLD(PGM)
     A            SGTIME    R               REFFLD(TIME)
     A            SGDT      R               REFFLD(DT)
     A                                      COLHDG('Date' 'Maintained')
