     A          R PST7I                     TEXT('ICR 7-I')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STPSSA        10S 0       COLHDG('Paid single sum' +
     A                                      'settlement amount')
     A            STPPVA        10S 0       COLHDG('Paid physician' +
     A                                      'valuation date amt')
     A            STPAMA        10S 0       COLHDG('Paid applicant' +
     A                                      'medical date amt')
     A            STPDMA        10S 0       COLHDG('Paid defense' +
     A                                      'medical date amt')
     A            STPIMA        10S 0       COLHDG('Paid independent' +
     A                                      'medical date amt')
     A            STSRCD         1S 0       COLHDG('Surgery code')
     A            STARCD         1S 0       COLHDG('Attor or auth rep')
     A            STADRD         6S 0       COLHDG('Attor disc rec date')
     A            STFUT1       138A         COLHDG('Future use')
     A            STGRP#         3S 0       COLHDG('Group #')
     A            STFYR          3S 0       COLHDG('Policy year')
     A            STEMP#         9S 0       COLHDG('Employer #')
