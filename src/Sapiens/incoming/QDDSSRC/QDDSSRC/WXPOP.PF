     A                                      REF(WREFP)
     A          R PPO01                     TEXT('MADISON DATA DOWNLOAD - POL')
     A            POCARR    R               REFFLD(DS5)
     A                                      COLHDG('CARRIER #')
     A            POPOL#        18          COLHDG('POLICY #')
     A            POCERT         7          COLHDG('CERTIFICATE #')
     A            POSTCD         2          COLHDG('STATE CODE')
     A            POPFDT         6          COLHDG('POLICY EFF DATE')
     A
     A            POPTDT         6          COLHDG('POLICY EXP DATE')
     A            PORSK#         9          COLHDG('RISK ID#')
     A            POSTEF         6          COLHDG('STATE EFFECTIVE DATE')
     A            POFEIN         9          COLHDG('FEDERAL EMP ID#')
     A            POCOND         7          COLHDG('POLICY CONDITIONS')
     A            POPOTP         6          COLHDG('POLICY TYPE ID')
     A            PODTYP         4          COLHDG('DEDUCTIBLE TYPE')
     A            PODPCT         2          COLHDG('DEDUCTIBLE PERCENT')
     A            PODAMT         9          COLHDG('DEDUCTIBLE AMT/CLAIM')
     A            PODAGG         9          COLHDG('DEDUCTIBLE-AGGREGATE')
     A            PONAME        79          COLHDG('NAME OF INSURED')
     A*** Begin add *** 05/30/03 **************************************
     A            POMAD1        60          COLHDG('Mail addr line 1')
     A            POMAD2        60          COLHDG('Mail addr line 2')
     A            POMCTY        30          COLHDG('Mail addr city')
     A            POMST          2          COLHDG('Mail addr state')
     A            POMZIP         9          COLHDG('Mail addr zip')
     A            POPPOL        18          COLHDG('Prior policy #')
     A*** End add ***** 05/30/03 **************************************
     A*** Begin dlt *** 05/30/03 **************************************
     A*********** POADDR        79          COLHDG('ADDRESS OF INSURED')
