     A* WORKERS' COMP PROFESSIONAL EMP ORG EXCLUSION ENDORSEMENT FILE*
     A****************************************************************
     A*  REVISIONS:                                                  *
     A*                                                              *
     A*  11/27/06 C:184 PROJECT: WC1505                              *
     A*                 Added an employer effective date field to    *
     A*                 allow only changed employers to print on     *
     A*                 midterm endorsement.                         *
     A*                                                              *
     A* ------------------------------------------------------------ *
     A*  NOTE: PLEASE ADD COMMENTS TO THE TOP OF REVISIONS.          *
     A* ------------------------------------------------------------ *
     A****************************************************************
     A                                      REF(WREFP)
     A          R PLE01                     TEXT('ALTERNATE EMPLOYERS')
     A            LECO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY #')
     A            LEFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            LEEMP#    R               REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER #')
     A            LEDIV     R               REFFLD(DIV)
     A                                      COLHDG('DIVISION')
     A            LEFYR     R               REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            LESEQ#    R               REFFLD(CER#)
     A                                      COLHDG('ALT EMPLR #')
     A            LECNAM    R               REFFLD(NAME)
     A                                      COLHDG('CLIENT NAME')
     A            LEADR1    R               REFFLD(ADR1)
     A                                      COLHDG('CLT EMPLR' 'ADDRESS 1')
     A            LEADR2    R               REFFLD(ADR2)
     A                                      COLHDG('CLT EMPLR' 'ADDRESS 2')
     A            LECTY     R               REFFLD(CTY)
     A                                      COLHDG('CLT EMPLR CITY')
     A            LEST      R               REFFLD(ST)
     A                                      COLHDG('CLT EMPLR STATE')
     A            LEZIP     R               REFFLD(ZIP)
     A                                      COLHDG('CLT EMPLR ZIP')
     A            LEUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            LEPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            LETIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A            LEDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            LEIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            LEIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            LEITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            LEIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            LEEFDT         7S 0       COLHDG('EMPLOYER EFFECTIVE')
