     A**
     A** Utilization Review INTERQUAL CREITERIA FILE
     A                                      REF(FSREFP)
     A          R PIS01                     TEXT('INTERQUAL CRITERIA FILE')
     A            ISBDSY    R               REFFLD(DS3) COLHDG('BODY SYS CODE')
     A            ISCRTP    R               REFFLD(FLAG) COLHDG('CRITERIA TYP' +
                                            '1-SI, 2-IS, 3-DISCHG')
     A            ISLIN#    R               REFFLD(A30) COLHDG('LINE NUMBER')
                  ISLNTP    R               REFFLD(FLAG) COLHDG('LINE TYPE H+
                                            -HEAD,' 'S-SUBHEAD,B-BLA+
                                            NK' 'C-CRITERIA, --CONT')
                  ISDESC    R               REFFLD(DS50) COLHDG('CRITERIA DESC')
                  ISSFTF    R               REFFLD(FLAG) COLHDG('SOFT IS FLG' +
                                            '"*" TYPE?' '1/0(YES/NO)')
     A            ISSTAT    R               REFFLD(STAT)
     A            ISUSER    R               REFFLD(USER)
     A            ISPGM     R               REFFLD(PGM)
     A            ISTIME    R               REFFLD(TIME)
     A            ISDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ISIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            ISIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
