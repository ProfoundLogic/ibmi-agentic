      *
     A                                      REF(WREFP)
     A          R PMP01                     TEXT('MPN Provider')
      *
     A            MPCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('Company')
      *
     A            MPFND     R     S         REFFLD(FND)
     A                                      COLHDG('Group')
      *
     A            MPEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('Employer')
      *
     A            MPDIV     R     S         REFFLD(DIV)
     A                                      COLHDG('Division')
      *
     A            MPELFL         1A         COLHDG('Entity/Location' +
     A                                       'Flag')
      *             *** value is 'Y' for records associated with
      *             *** Entity/Location
      *
     A            MPELID        10A         COLHDG('Entity/Location ID')
      *             *** value is blank, if associated with employer
      *
      *
     A            MPNAME       100A         COLHDG('MPN Provider Name')
      *
     A            MPADR1        40A         COLHDG('MPN Provider' +
     A                                       'Address Line 1')
      *
     A            MPADR2        40A         COLHDG('MPN Provider' +
     A                                       'Address Line 2')
      *
     A            MPCITY        25A         COLHDG('MPN Provider' +
     A                                       'City')
      *
     A            MPST           2A         COLHDG('MPN Provider' +
     A                                       'State')
      *
     A            MPZIP          9S 0       COLHDG('MPN Provider' +
     A                                       'ZIP Code')
      *
     A            MPPTYP        20A         COLHDG('MPN Provider' +
     A                                       'Type')
      *
     A            MPSTAT    R               REFFLD(STAT)
     A            MPUSR     R               REFFLD(USER)
     A            MPPGM     R               REFFLD(PGM)
     A            MPTIM     R     S         REFFLD(TIME)
     A            MPDT      R     S         REFFLD(DT)
     A            MPIUSR    R               REFFLD(USER)
     A            MPIPGM    R               REFFLD(PGM)
     A            MPITIM    R     S         REFFLD(TIME)
     A            MPIDT     R     S         REFFLD(DT)
      *
