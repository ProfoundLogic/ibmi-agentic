     A                                      COLHDG('REMAINING RESERVES')
     A            SERETN    R               REFFLD(A112)
     A                                      COLHDG('FUND RETENTION')
     A            SESTAT    R               REFFLD(STAT)
     A            SEUSER    R               REFFLD(USER)
     A            SEPGM     R               REFFLD(PGM)
     A            SETIME    R               REFFLD(TIME)
     A            SEDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*
     A            SEPOL#        13          COLHDG('POLICY NUMBER')
     A            SECLM#        12          COLHDG('FULL CLAIMANT NUMBER')
