     A                                      REF(SCREFP)
     A          R PDC01                     TEXT('DELETE CONTROL   -
     A                                      FILE(DELETE PROCESS)')
     A            DCDPFL         1A         TEXT('DELETE IN PROGRESS - Y/N ')
     A            DCSTAT    R               REFFLD(STAT)
     A            DCUSER    R               REFFLD(USER)
     A            DCPGM     R               REFFLD(PGM)
     A            DCTIME    R               REFFLD(TIME)
     A            DCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            DCIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            DCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
