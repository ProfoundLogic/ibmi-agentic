     A*                                                               *
     A* 11/06/23  C:291 PROJECT WC2934                                *
     A*                 Add Batch Type and Description                *
     A*                                                               *
     A* 06/23/16 C:136 PROJECT: SY371                                 *
     A*                ADD SCRIPTURA PHASE 2 PROCESSING               *
     A*                                                               *
     A* 07/07/08  C:61  PROJECT 132WKR                                *
     A*                 Add new fields:                               *
     A*                   ARBSCD - Billing schedule code              *
     A*                   ARBDSC - Bill Sched Code Description        *
     A*                   ARSEFL - Billing Sched Code Type            *
     A*                   ARABFL - Agency Bill Flag                   *
     A*                                                               *
     A* 04/30/02  C:61  PROJECT 81WTZ                                 *
     A*                 Add new field to designate QUOTE or LIVE.     *
     A*                                                               *
     A* 04/15/02  C:35   PROJECT: WC970                               *
     A*                  ADD CATEGORY TYPE.                           *
     A*                                                               *
     A*****************************************************************
     A
     A          R PAR01                     TEXT('A/R DETAIL REPORT WORKFILE')
     A            ARKEY         40A         COLHDG('UNIQUE KEY')
     A            ARCO#          3S 0       COLHDG('Company#')
     A            ARCNAM        40A         COLHDG('Company Name')
     A            ARFND          3S 0       COLHDG('Group')
     A            ARGNAM        40A         COLHDG('Group Name')
     A            ARFYR          3S 0       COLHDG('Policy Year')
     A            AREMP#         9S 0       COLHDG('Employer')
     A            ARDIV          5S 0       COLHDG('Division')
     A            ARPOL#        25A         COLHDG('Policy #')
     A            ARENAM        40A         COLHDG('Employer Name')
     A            ARARCD         2A         COLHDG('A/R Code')
     A            ARARTY         1A         COLHDG('A/R Type')
     A            ARDESC        30A         COLHDG('Description')
     A            ARAMT          9S 2       COLHDG('A/R Amount')
     A            ARCOLL         9S 2       COLHDG('Collection Amount')
     A            ARBILL         9S 2       COLHDG('Billing Amount')
     A            AROTHR         9S 2       COLHDG('Other Amount')
     A            ARTRDT         8S 0       COLHDG('Transaction date')
     A            ARPODT         8S 0       COLHDG('Posting date')
     A            ARCHK#         7S 0       COLHDG('Check#')
     A            ARNINV        10S 0       COLHDG('Invoice#')
     A            ARLATE         1A         COLHDG('Late Flag')
     A            ARFAF          1A         COLHDG('Final Audit Flag')
     A            ARRST          2A         COLHDG('Rating state')
     A            ARRGN#         3S 0       COLHDG('Region')
     A            ARRGDS        40A         COLHDG('Region Description')
     A            ARCHAP         3S 0       COLHDG('Chapter')
     A            ARCDES        40A         COLHDG('Chapter Description')
     A            AROFF#         5A         COLHDG('Office #')
     A            AROFNM        40A         COLHDG('Office Name')
     A            ARPFIN         5A         COLHDG('Premium' 'Finance' 'Co.')
     A            ARFNAM        40A         COLHDG('Prem Finance Co Name')
     A            ARPFDT         8S 0       COLHDG('Policy' 'From Date')
     A            ARPTDT         8S 0       COLHDG('Policy' 'To Date')
     A            ARCXDT         8S 0       COLHDG('Cancellation Date')
     A            ARSUR          1A         COLHDG('Surcharge flag')
     A            ARAGT#         5S 0       COLHDG('Agent #')
     A            ARAGNM        40A         COLHDG('Agent Name')
     A            ARCAG#         5S 0       COLHDG('Commission' 'Agent #')
     A            ARCAGN        40A         COLHDG('Commission' 'Agent Name')
     A            ARPROD         5S 0       COLHDG('Commission' 'Producer')
     A            ARPRNM        40A         COLHDG('Commission' 'Producer Name')
     A            ARFEIN         9S 0       COLHDG('Commission' 'Agent FEIN')
     A            ARMOD          3S 0       COLHDG('Commission' 'Agent Mod')
     A            ARCRAT         5S 2       COLHDG('Commission' 'Agent Rate')
     A            ARCOMM         9S 2       COLHDG('Commission' 'Amount')
     A            AR2AGT         5S 0       COLHDG('2nd Agent #')
     A            AR2ANM        40A         COLHDG('2nd Agent Name')
     A            AR2CAG         5S 0       COLHDG('2nd Commission' 'Agent #')
     A            AR2CAN        40A         COLHDG('2nd Comm' 'Agent Name')
     A            AR2PRD         5S 0       COLHDG('2nd Commission' 'Producer')
     A            AR2PNM        40A         COLHDG('2nd Comm' 'Producer Name')
     A            AR2FIN         9S 0       COLHDG('2nd Comm' 'Agent FEIN')
     A            AR2MOD         3S 0       COLHDG('2nd Commission' 'Agent Mod')
     A            AR2CRT         5S 2       COLHDG('2nd Comm' 'Agent Rate')
     A            AR2COM         9S 2       COLHDG('2nd Commission' 'Amount')
     A            ARFRDT         8S 0       COLHDG('From date' '(from prompt)')
     A            ARTODT         8S 0       COLHDG('To date' '(from prompt)')
     A            ARDT           8S 0       COLHDG('Last run date')
     A            ARTIME         6S 0       COLHDG('Last run time')
     A            ARPGM         10A         COLHDG('Program name')
     A            ARUSER        10A         COLHDG('User name')
      **** BEGIN ADD **** 04/15/02 *********************************************
     A            ARCTYP         1A         COLHDG('Category Type')
      **** END   ADD **** 04/15/02 *********************************************
      **** BEGIN ADD **** 04/30/02 *********************************************
     A            AREFLG         1A         COLHDG('Q=Quote, L=Live')
      **** END   ADD **** 04/30/02 *********************************************
      **** beg add ****** 07/07/08 *********************************************
     A            ARBSCD         3A         COLHDG('Bill Sched Code')
     A            ARBDSC        30A         COLHDG('Bill Sched Code ' +
     A                                      'Description')
     A            ARSEFL         1A         COLHDG('Bill Sched Type')
     A            ARABFL         1A         COLHDG('Agency Bill Flag')
      **** end add ****** 07/07/08 *********************************************
      **** BEG ADD ***** 06/23/16 **********************************************
     A            ARXMLFILE     60A         COLHDG('XML FILE NAME')
      **** BEG ADD ***** 06/23/16 **********************************************
      **** Beg Add **** 11/06/23 *********************************************
     A            ARBTYP         1A         COLHDG('A/R Batch Type')
     A            ARBDESC       50A         COLHDG('A/R Batch Type' -
     A                                       'Description')
     A            ARRDIV         5S 0       COLHDG('S/R Division')
     A            ARINVTYPID    15S 0       COLHDG('Invoice Type ID')
     A            ARREF#        40A         COLHDG('Reference #')
     A            ARBAT#         9S 0       COLHDG('A/R Batch #')
      **** End Add **** 11/06/23 *********************************************
