     A                                      COLHDG('State')
      *
     A            ECZIP     R               REFFLD(ZIP)
     A                                      COLHDG('Zip Code')
      *
     A            ECAREA    R               REFFLD(AREA)
     A                                      COLHDG('Area Code')
      *
     A            ECPHN#    R               REFFLD(PHN#)
     A                                      COLHDG('Phone #')
      *
     A            ECEXT#         5P 0
     A                                      COLHDG('Extension #')
      *
     A            ECFARA    R               REFFLD(AREA)
     A                                      COLHDG('FAX Area Code')
      *
     A            ECFPHN    R               REFFLD(PHN#)
     A                                      COLHDG('FAX Phone #')
      *
     A            ECCARA    R               REFFLD(AREA)
     A                                      COLHDG('Cell Area Code')
      *
     A            ECCPHN    R               REFFLD(PHN#)
     A                                      COLHDG('Cell Phone #')
