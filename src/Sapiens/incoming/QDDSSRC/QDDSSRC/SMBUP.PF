     A                                      REF(SREFP)
     A          R PBU01                     TEXT('Month-end backup control')
     A            BUDEVN    R               REFFLD(NM10)
                                            COLHDG('Device' +
                                                   'name' +
                                                   '                    ')
     A            BUWCMS    R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'WCMS' +
                                                   'files               ')
     A            BUWCMC    R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'WCMC' +
                                                   'files')
     A            BUDART    R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'DARTS' +
                                                   'files')
     A            BUPCMS    R               REFFLD(FLAG)
                                            COLHDG('Save'  +
                                                   'PCMS' +
                                                   'files')
     A            BUAP      R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'AP' +
                                                   'files')
     A            BUGL      R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'GL' +
                                                   'files')
     A            BUFIL     R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'base' +
                                                   'files')
     A            BUMFIL    R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'modified' +
                                                   'files')
     A            BUQTE     R               REFFLD(FLAG)
                                            COLHDG('Save' +
                                                   'quote' +
                                                   'files')
     A            BUPRTR    R               REFFLD(FLAG)
                                            COLHDG('Print' +
                                                   'reports' +
                                                   '                    ')
      *
      *  Standard maintenance fields
      *
     A            BUPGM     R               REFFLD(NM10)
                                            COLHDG('Program' +
                                                   'maintained' +
                                                   '                    ')
     A            BUUSER    R               REFFLD(NM10)
                                            COLHDG('Maintained' +
                                                   'by' +
                                                   '                    ')
     A            BUDT      R               REFFLD(DT)
                                            COLHDG('Date' +
                                                   'maintained' +
                                                   '                    ')
     A            BUTIME    R               REFFLD(TIME)
                                            COLHDG('Time' +
                                                   'maintained' +
                                                   '                    ')
     A***  Begin add  ***  11/06/00  *********************************
     A            BUSAVF    R               REFFLD(FLAG)
                                            COLHDG('Save to' +
                                                   'save files' +
                                                   '                    ')
     A            BUSFLB    R               REFFLD(NM10)
                                            COLHDG('Save file' +
                                                   'library' +
                                                   'name')
     A            BUPRMT    R               REFFLD(FLAG)
                                            COLHDG('Prompt' +
                                                   'operator to' +
                                                   'load tape')
     A***  End   add  ***  11/06/00  *********************************
     A***  Begin add  ***  11/21/02  *********************************
     A            BUCRPT    R               REFFLD(FLAG)
                                            COLHDG('Calendar'    +
                                                   'Earned/Unearned' +
                                                   'Flag')
     A            BUMRPT    R               REFFLD(FLAG)
                                            COLHDG('Member Profile' +
                                                   'Flag')
     A            BUCQUE        10
                                            COLHDG('Calendar'    +
                                                   'Earned/Unearned' +
                                                   'JOBQ')
     A            BUMQUE        10
                                            COLHDG('Member Profile' +
                                                   'JOBQ')
     A***  End   add  ***  11/21/02  *********************************
