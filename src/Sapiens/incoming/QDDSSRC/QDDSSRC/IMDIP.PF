     A          R PDI01                     TEXT('DOCUMENT ID CTL FILE')
     A*
     A            DIWSID         2          COLHDG('WORK STATAION' 'ID')
     A*
     A            DISEQ#         6  0       COLHDG('DOC ID SEQ#')
     A            DISUFX         3          COLHDG('DOC ID SUFFIX')
     A            DISTAT         1          COLHDG('STATUS')
     A            DIBCHS         4  0       COLHDG('DOC ID' 'BATCH SEQ#')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            DIIUSR        10          TEXT('INIT USER')
     A            DIIPGM        10          TEXT('INIT PGM')
     A            DIITIM         6S 0       TEXT('INIT TIME')
     A            DIIDT          6S 0       TEXT('INIT DATE')
     A            DILUSR        10          TEXT('USER LAST MAINT')
     A            DILPGM        10          TEXT('LAST MAINT PGM')
     A            DILTIM         6S 0       TEXT('LAST MAINT TIME')
     A            DILDT          6S 0       TEXT('LAST MAINT DATE')
     A            DIFL01         1          TEXT('**FUTURE USE FLG 01 **')
     A            DIFL02         1          TEXT('**FUTURE USE FLG 02 **')
     A            DIFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            DIFL04         1          TEXT('**FUTURE USE FLG 04 **')
