     A*
     A                                      REF(CREFP)
     A          R PCR01                     TEXT('Claim Report by LOB')
     A            CRCO#     R               REFFLD(CO#)
     A            CRCC      R               REFFLD(CDE)
     A                                      COLHDG('LOB CODE')
     A            CRCCTP    R               REFFLD(FLAG)
     A                                      COLHDG('SECTION TYPE CODE')
     A            CRCCDS    R               REFFLD(DS40)
     A                                      COLHDG('SECTION CODE DESC')
     A            CRSORT    R               REFFLD(KEY)
     A                                      COLHDG('SORT FIELD')
     A            CRPOL#    R               REFFLD(POL#)
     A            CRCLM#    R               REFFLD(CLM#)
     A            CRCLMT    R               REFFLD(CLID)
     A            CRCLNM    R               REFFLD(NM40)
     A            CRADJR    R               REFFLD(STAF)
     A                                      COLHDG('ADJUSTOR')
     A            CRACDT    R               REFFLD(DT)
     A                                      COLHDG('DATE OF LOSS')
     A            CRRPDT    R               REFFLD(DT)
     A                                      COLHDG('DATE REPORTED')
     A            CRINAM    R               REFFLD(NAME)
     A                                      COLHDG('INSURED NAME')
     A            CRDESC    R               REFFLD(DS40)
     A                                      COLHDG('LOSS DESCRIPTION')
     A            CROCST    R               REFFLD(STAT)
     A                                      COLHDG('CLAIM STATUS')
     A            CRCLDT    R               REFFLD(DT)
     A                                      COLHDG('CLOSED DATE')
     A            CRSUBL         3          COLHDG('SUBLINE')
     A            CRRSV     R               REFFLD(DS25)
     A                                      COLHDG('RESERVE DESCRIPTION')
     A            CRPAID    R               REFFLD(A92)
     A                                      COLHDG('NET PAID')
     A            CRRCVD    R               REFFLD(A92)
     A                                      COLHDG('NET RECOVERED')
     A            CROUTS    R               REFFLD(A92)
     A                                      COLHDG('OUTSTANDING RESERVES')
     A            CRINC     R               REFFLD(A92)
     A                                      COLHDG('TOTAL INCURRED')
     A            CRDEDU    R               REFFLD(A92)
     A                                      COLHDG('DEDUCTIBLE USED')
     A*
     A            CRSTAT    R               REFFLD(STAT)
     A            CRUSER    R               REFFLD(USER)
     A            CRPGM     R               REFFLD(PGM)
     A            CRTIME    R               REFFLD(TIME)
     A            CRDT      R               REFFLD(DT)
     A*** Begin add *** 08/12/03 *************************************
     A            CRGPD     R               REFFLD(A92)
     A                                      COLHDG('Gross paid')
     A            CRDEDA         7P 0
     A                                      COLHDG('Policy deductible' +
     A                                      'amount')
     A*** End add ***** 08/12/03 *************************************
