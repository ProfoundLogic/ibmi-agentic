     A*    EDI Log Import file                                        *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 09/06/19 c:62 Project 152WAU                                 *
     A*               Expand date fields to 8.0                       *
     A*                                                               *
     A*****************************************************************
     A*
     A          R PLX01                     TEXT('EDI Import Record')
     A
     A            LXACLC        25A         COLHDG('CLAIM ADMIN' 'CLAIM #')
     A
     A            LXTSET         3A         COLHDG('TRANSACTIONS' 'SET ID')

     A            LXMTC          2A         COLHDG('MAINTENANCE' 'TYPE' 'CODE')
     A
     A            LXJST          2A         COLHDG('JURISDICTION' 'STATE')
     A
     A            LXSTS          3A         COLHDG('ENTRY STATUS')
     A
     A            LXMTCD         8S 0       COLHDG('MTC' 'DATE')
     A
     A            LXDUE          8S 0       COLHDG('SUBMISSION' 'DUE' 'DATE')
     A
     A            LXSENT         8S 0       COLHDG('DATE' 'SENT TO' 'STATE')
     A
     A            LXARCV         8S 0       COLHDG('DATE' 'ACK' 'RECEIVED')
     A
     A            LXACL#        25A         COLHDG('STATE' 'CLAIM #')
     A
