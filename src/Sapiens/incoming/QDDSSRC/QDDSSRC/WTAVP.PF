     A            AVKEY     R               REFFLD(KEY)
     A            AVDESC    R               REFFLD(DS30)
     A                                      COLHDG('ACTIVITY STS' 'DESCRIPTION')
     A            AVSTAT    R               REFFLD(STAT)
     A            AVUSER    R               REFFLD(USER)
     A            AVPGM     R               REFFLD(PGM)
     A            AVTIME    R               REFFLD(TIME)
     A            AVDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            AVIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            AVIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            AVITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            AVIDT     R               REFFLD(DT)
     A                                      COLHDG('INTIIAL' 'DATE')
