     A*
     A**  MULTI-DOC (OBJECT) FILE
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*  11/10/04 C:15  Project: DR189                                *
     A*                 Added fields for UNC name, Share path, and    *
     A*                 IFS path.                                     *
     A*****************************************************************
     A*
     A*
     A                                      REF(SCREFP)
     A          R PMO01                     TEXT('MULTI-OBJECT FILE')
     A*
     A*
     A            MOKEY     R               REFFLD(KEY)
     A            MOSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            MOOID         40          COLHDG('OBJECT ID')
     A*
     A            MOOFLR        60          COLHDG('OBJECT FOLDER')
     A            MOOTYP    R               REFFLD(FLAG)
     A                                      COLHDG('OBJECT TYPE' +
     A                                      'F, I, O...')
     A            MOODSC    R               REFFLD(DS40)
     A                                      COLHDG('OBJ DESC.')
     A            MODOCT         8          COLHDG('DOCUMENT TYPE')
     A            MOTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION DATE')
     A            MOTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANSACTION TIME')
     A            MOSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS')
     A            MOCSID    R               REFFLD(CSID)
     A            MOCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            MOPNAM    R               REFFLD(PGM)
     A                                      TEXT('WROTE IT')
     A            MOSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            MOSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A            MORMCD    R               REFFLD(RMCD)
     A                                      COLHDG('REMARK' 'CODE')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            MOIUSR    R               REFFLD(USER)
     A                                      TEXT('INIT USER')
     A            MOIPGM    R               REFFLD(PGM)
     A                                      TEXT('INIT PGM')
     A            MOITIM    R               REFFLD(TIME)
     A                                      TEXT('INIT TIME')
     A            MOIDT     R               REFFLD(DT)
     A                                      TEXT('INIT DATE')
     A            MOLUSR    R               REFFLD(USER)
     A                                      TEXT('USER LAST MAINT')
     A            MOLPGM    R               REFFLD(PGM)
     A                                      TEXT('LAST MAINT PGM')
     A            MOLTIM    R               REFFLD(TIME)
     A                                      TEXT('LAST MAINT TIME')
     A            MOLDT     R               REFFLD(DT)
     A                                      TEXT('LAST MAINT DATE')
     A*
     A            MOFL01    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 01 **')
     A            MOFL02    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 02 **')
     A            MOFL03    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 03 **')
     A            MOFL04    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 04 **')
     A            MOFL05    R               REFFLD(FLAG)
     A                                      TEXT('**FUTURE USE FLG 05 **')
     A            MOCHR5         5A         TEXT('**FUTURE USE A5  01 **')
     A*
     A            MOSYSN        20A         TEXT('SYSTEM NETWORK NAME')
     A*
     A*** Begin add *** 11/10/04 **************************************
     A            MOUNCN       132A         TEXT('UNC name')
     A            MOSHRN       132A         TEXT('Share name')
     A            MOIFSP       132A         TEXT('IFS path')
     A*** End add ***** 11/10/04 **************************************
