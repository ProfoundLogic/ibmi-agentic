     A* DESCRIPTION:                                                 *
     A* STOPP - SYSTEM OVERLAY AND PAGE SEGMENT TABLE
     A****************************************************************
     A*  CREATED: 08/05/10       PROJECT: WC1920         C:220        *
     A*****************************************************************
     A* REVISIONS:                                                    *
      *
      * 05/22/11 C:061 PROJECT 114WZD
      *                Add field for Carrier #.
      *
     A****************************************************************
     A*
     A          R POP01                     TEXT('SYSTEM OVERLAY/PAGE-SEG FILE')
     A*                                                              *
     A            OPCLT#         3A         TEXT('CLIENT ID')
     A                                      COLHDG('CLIENT ID')
     A            OPCO#          3S 0       TEXT('COMPANY NUMBER')
     A                                      COLHDG('COMPANY NUMBER')
     A            OPOVPS         8A         TEXT('OVERLAY / PAGE SEGMENT NAME')
     A                                      COLHDG('OVER/PAGE' 'SEGMENT NAME')
     A            OPDESC        40A         TEXT('OVERLAY/PAGE SEGMENT DESC')
     A                                      COLHDG('OVER/PAGE' 'SEGMENT DESC')
     A            OPOPFL         1A         TEXT('FLAG TO INDICATE O OR P')
     A                                      COLHDG('FLG O/P')
     A            OPLIB         10A         TEXT('LIB OF OVR/PAGE')
     A                                      COLHDG('LIB OF OVR/PAGE')
     A            OPVPOS         5S 3       TEXT('VERTICAL POSITION')
     A                                      COLHDG('VERTICAL POS')
     A            OPHPOS         5S 3       TEXT('HORIZON POS')
     A                                      COLHDG('HORIZONT POS')
     A            OPWIDE         5S 3       TEXT('WIDTH')
     A                                      COLHDG('WIDTH')
     A            OPHIGH         5S 3       TEXT('HEIGHT')
     A                                      COLHDG('HEIGHT')
     A            OPROTA         3S 0       TEXT('ROTATE')
     A                                      COLHDG('ROTATE')
     A            OPFORM        15A         TEXT('ENDORSEMENT FORM NAME')
     A                                      COLHDG('END FORM NAME')
     A            OPPRNM        10A         TEXT('PROGRAM NAME')
     A                                      COLHDG('PROGRAM NAME')
     A            OPPRTF        10A         TEXT('OUTPUT PRINTER FILE NAME')
     A                                      COLHDG('OUTPUT PRINTER' 'FILE NAME')
     A            OPPAGE         7S 0       TEXT('PAGE NUMBER')
     A                                      COLHDG('PAGE NUMBER')
     A            OPSEQ#         7S 0       TEXT('SEQUENCE NUMBER')
     A                                      COLHDG('SEQ NUMBER')
     A            OPFND          3S 0       TEXT('GROUP NUMBER')
     A                                      COLHDG('GROUP NUMBER')
     A            OPUSR         10A         TEXT('USER')
     A                                      COLHDG('USER')
     A            OPPGM         10A         TEXT('PROGRAM')
     A                                      COLHDG('PROGRAM')
     A            OPTIM          6S 0       TEXT('TIME')
     A                                      COLHDG('TIME')
     A            OPDAT          7S 0       TEXT('DATE')
     A                                      COLHDG('MAINT DATE')
     A            OPIUSR        10A         TEXT('INITIAL USER')
     A                                      COLHDG('INT USER')
     A            OPIPGM        10A         TEXT('INITIAL PROGRAM')
     A                                      COLHDG('INT PROGRAM')
     A            OPITIM         6S 0       TEXT('INITIAL TIME')
     A                                      COLHDG('INT TIME')
     A            OPIDAT         7S 0       TEXT('INITIAL DATE')
     A                                      COLHDG('INT MAINT DATE')
      ****** beg add ****** 05/22/11 **********************************
     A            OPCAR#         5S 0       COLHDG('CARRIER NUMBER')
      ****** end add ****** 05/22/11 **********************************
     A*                                                              *
