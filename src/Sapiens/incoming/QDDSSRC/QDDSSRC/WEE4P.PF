     A*
     A*  EDI Impairments File
     A                                      REF(WREFP)
     A          R PE401                     TEXT('Impairments File')
     A*
     A            E4CO#     R               REFFLD(CO#)
     A            E4FND     R               REFFLD(FND)
     A            E4FYR     R               REFFLD(FYR)
     A            E4CASE    R               REFFLD(CASE)
     A            E4LGSQ    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            E4PART    R               REFFLD(CODE)
     A                                      TEXT('Perm impairment body code')
     A            E4IPCT    R               REFFLD(PC52)
     A                                      TEXT('Perm impairment %')
     A            E4MINP    R               REFFLD(FLAG)
     A                                      TEXT('Perm impairment min pmt ind')
     A*
     A            E4USER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            E4PGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A            E4DT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            E4TIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
