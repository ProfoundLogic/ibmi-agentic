      *       (C) Copyright Progressive Data Solutions, Inc., 1997         *
      *  AFTWMEPP2O: Conversion query for new WMEPP                        *
      **********************************************************************
      *  DESCRIPTION:                                                      *
      *  This query produces a record count and payroll totals on the      *
      *  new file.                                                         *
      *                                                                    *
      *  CREATED: 12/17/97         PROGRAMMER: 84         PROJECT: 60ANY   *
      **********************************************************************
      *  REVISIONS:                                                        *
      *                                                                    *
      **********************************************************************
     A                                      REF(WMEPP)
     A          R PRTHDR                    SKIPB(2)           SPACEA(2)
     A            PTRDAT        10A        1
     A            PTTITL        50A       41
     A                                   125'Page'
     A            PTPAGE         4S 0    129                   EDTCDE(4)
     A            PTRTIM         8A        1SPACEB(1)          SPACEA(2)
     A                                     1'File:'
     A            PTQFIL        21A        7                   SPACEA(2)
     A                                     3'Company/Fund'
     A                                    +4'Year'
     A                                    +7'Count'
     A                                    +5'Self Rpt Payr'
     A                                    +7'Est Anl Payr'
     A                                    +8'Est Man Payr'
     A                                    +7'Audited Payr'
     A                                    +8'Aud Man Payr'

      * Print totals on EPFYR break

     A          R PRTBK1                                       SPACEA(1)
     A            XXCO#     R              5REFFLD(EPCO#)      EDTCDE(3)
     A  61                                                     UNDERLINE
     A            XXFND     R             +4REFFLD(EPFND)      EDTCDE(3)
     A  61                                                     UNDERLINE
     A            XXFYR     R             +5REFFLD(EPFYR)      EDTCDE(3)
     A            XXCOUNT1       9S 0     +3                   EDTCDE(3)
     A  61                                                     UNDERLINE
     A            XXSAPR1   R   +2        +1REFFLD(EPSAPR)     EDTCDE(J)
     A  61                                                     UNDERLINE
     A            XXEAPR1   R   +2        +1REFFLD(EPEAPR)     EDTCDE(J)
     A  61                                                     UNDERLINE
     A            XXEMPR1   R   +5        +1REFFLD(EPEMPR)     EDTCDE(J)
     A  61                                                     UNDERLINE
     A            XXAAPR1   R   +2        +1REFFLD(EPAAPR)     EDTCDE(J)
     A  61                                                     UNDERLINE
     A            XXAMPR1   R   +5        +1REFFLD(EPAMPR)     EDTCDE(J)
     A  61                                                     UNDERLINE

      * Print totals on EPCO#/EPFND break

     A          R PRTBK2                                       SPACEA(2)
     A                                     1'*'
     A            XXCO#     R              5REFFLD(EPCO#)      EDTCDE(3)
     A            XXFND     R             +4REFFLD(EPFND)      EDTCDE(3)
     A            XXCOUNT2       9S 0    +11                   EDTCDE(3)
     A            XXSAPR2   R   +2        +1REFFLD(EPSAPR)     EDTCDE(J)
     A            XXEAPR2   R   +2        +1REFFLD(EPEAPR)     EDTCDE(J)
     A            XXEMPR2   R   +5        +1REFFLD(EPEMPR)     EDTCDE(J)
     A            XXAAPR2   R   +2        +1REFFLD(EPAAPR)     EDTCDE(J)
     A            XXAMPR2   R   +5        +1REFFLD(EPAMPR)     EDTCDE(J)

      * Print grand totals

     A          R PRTTOT                                       SPACEA(1)
     A                                     1'Grand totals:'
     A            XXCOUNT        9S 0    +12                   EDTCDE(3)
     A            XXSAPR    R   +2        +1REFFLD(EPSAPR)     EDTCDE(J)
     A            XXEAPR    R   +2        +1REFFLD(EPEAPR)     EDTCDE(J)
     A            XXEMPR    R   +5        +1REFFLD(EPEMPR)     EDTCDE(J)
     A            XXAAPR    R   +2        +1REFFLD(EPAAPR)     EDTCDE(J)
     A            XXAMPR    R   +5        +1REFFLD(EPAMPR)     EDTCDE(J)
