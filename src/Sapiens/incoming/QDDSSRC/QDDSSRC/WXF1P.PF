     A                                      REF(WREFP)
     A          R PF101                     TEXT('DCI EXTRACT SUBMISSION CONTRO-
     A                                      L FILE')
     A            F1CO#     R               REFFLD(CO#)
     A            F1FND     R               REFFLD(FND)
     A            F1NAME    R               REFFLD(NM60)
     A            F1ST      R               REFFLD(CODE)
     A                                      COLHDG('STATE')
     A            F1RTIO         2P 0       COLHDG('STATE SAMPLING' 'RATIO')
     A            F1FLAG    R               REFFLD(FLAG)
     A**********                            E - EXCLUDE  I - INCLUDE
     A            F1USER    R               REFFLD(USER)
     A            F1PGM     R               REFFLD(PGM)
     A            F1DT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            F1TIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A            F1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            F1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            F1IDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            F1ITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A***** Beg Add ***** 03/08/11 ***********************************
     A            F1RTOP         3S 0       COLHDG('State sampling' -
     A                                       'Ratio Open')
     A*
     A            F1RTCL         3S 0       COLHDG('State sampling' -
     A                                       'Ratio Closed')
