     A                                      COLHDG('TOTAL MISCELLANEOUS')
     A            PFATTY    R               REFFLD(A112)
     A                                      COLHDG('TOTAL ATTORNEY')
     A            PFDEF     R               REFFLD(A112)
     A                                      COLHDG('TOTAL DEFENSE PAID')
