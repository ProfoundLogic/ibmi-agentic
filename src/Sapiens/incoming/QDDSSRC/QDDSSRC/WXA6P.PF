     A*  PROJECT:  WC2446       PROGRAMMER:  C:65                     *
     A*  CREATED:  08/15/16                                           *
     A*  DESCRIPTION:  THIS FILE HOLDS THE ADDRESSES WHEN THEY        *
     A*                GET REPORTED, TO COMPARE ON FUTURE             *
     A*                SUBMISSIONS.                                   *
     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A*                                                               *
     A*                                                               *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PA601                     TEXT('REPORTED ADDRESS WORK FILE')
     A            A6CO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO #')
     A            A6FND     R     S         REFFLD(FND)
     A                                      COLHDG('FUND')
     A            A6FYR     R     S         REFFLD(FYR)
     A                                      COLHDG('FUND' 'YEAR')
     A            A6EMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            A6UNID    R     S         REFFLD(A120)
     A                                      COLHDG('UNIQUE' 'IDENTIFIER')
     A            A6TYPE         1S 0       COLHDG('ADDRESS TYPE CODE')
     A            A6FORA         1A         COLHDG('FOREIGN ADDR' 'INDICATOR')
     A            A6ADDR       101A         COLHDG('ADDRESS')
     A            A6NEL         10A         COLHDG('NAME/STATE/EXP LINK')
     A            A6NLK          2S 0       COLHDG('NAME LINK COUNTER')
     A            A6PH#         10S 0       COLHDG('PHONE #')
     A            A6NOE          6S 0       COLHDG('# OF EMPLOYEES')
     A            A6SIC          6A         COLHDG('INDUSTRY CODE')
     A            A6GEOA        16A         COLHDG('GEOGRAPHIC AREA')
     A            A6MAIL        39A         COLHDG('EMAIL ADDRESS')
     A            A6CNTRY        2A         COLHDG('COUNTRY CODE')
     A            A6EFD          6S 0       COLHDG('CHANGE EFF DATE')
     A            A6EXD          6S 0       COLHDG('CHANGE EXP DATE')
     A            A6USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            A6PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            A6TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            A6DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
