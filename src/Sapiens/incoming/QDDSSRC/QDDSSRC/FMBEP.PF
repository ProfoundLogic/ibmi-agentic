     A*  Created by: C:05    Project: MC152    Date: 01/05/98         *
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*  03/11/10 C:227 Project: FL083                                *
     A*                 Added BEREVI field                            *
     A*                                                               *
     A*  09/10/99 C:56  Project: KY010                                *
     A*                 Add BEEDHD and BEEDDT                         *
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PBE01                     TEXT('BILL ENTRY CONTROLLING FILE')
     A            BEAST     R               REFFLD(ST)
     A                                      COLHDG('ADJ ST')
     A            BESYS     R               REFFLD(SYS)
     A                                      COLHDG('SYSTEM')
     A********           Valid values based on STSTL
     A            BEBTYP    R               REFFLD(BTYP)
     A                                      COLHDG('BILL TYPE')
     A********           Valid values based on FTGTP via 'STYP'
     A            BESTYP    R               REFFLD(STYP)
     A                                      COLHDG('BILL SUB-TYPE')
     A********           Valid values based on FTGTP via 'BTYP'
     A            BEHEPG    R               REFFLD(PGM)
     A                                      COLHDG('HEADER' 'ENTRY' 'PGM')
     A********           Used for workflow of data entry in F035x series
     A            BEHESM    R               REFFLD(PGM)
     A                                      COLHDG('HEADER' 'SUMMARY' 'PGM')
     A********           Used to determine what summary pgm to see in F7=Header
     A            BEDEPG    R               REFFLD(PGM)
     A                                      COLHDG('DETAIL' 'ENTRY' 'PGM')
     A********           Used for workflow of detail data entry in F035x series
     A            BEEDI     R               REFFLD(FLAG)
     A                                      COLHDG('EDI' 'DEFAULT')
     A********           Valid values: Y = eligible for EDI/data submission
     A********                         N = NOT eligible for EDI/data submission
     A            BEPPLN    R               REFFLD(CODE)
     A                                      COLHDG('PAYMENT' 'PLAN' 'DEFAULT')
     A********           Valid values based on FTGTP via 'xxPP' where xx =Adj St
     A            BESTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            BEUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            BEPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            BETIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            BEDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            BEIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            BEIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            BEITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            BEIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
     A            BEADCD    R               REFFLD(CSCD)
     A                                      COLHDG('DEFAULT ADJ CODE')
     A*** BEG ADD *** 09/10/99 ****************************************
     A            BEEDHD    R               REFFLD(PGM)
     A                                      COLHDG('EDI HEADER PROGRAM')
     A            BEEDDT    R               REFFLD(PGM)
     A                                      COLHDG('EDI DETAIL PROGRAM')
     A*** END ADD *** 09/10/99 ****************************************
     A*** BEG ADD *** 03/11/10 ****************************************
     A            BEREVI    R               REFFLD(FLAG)
     A                                      COLHDG('MEIG Revision' 'indicator')
     A*** END ADD *** 03/11/10 ****************************************
