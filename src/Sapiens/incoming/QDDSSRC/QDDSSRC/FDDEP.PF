     A                                      REF(FSREFP)
     A          R PDE01                     TEXT('EOMB DETAIL EOB/NOTES FILE')
     A            DECO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY#')
     A            DESUB#    R               REFFLD(SUB#)
     A                                      COLHDG('SUBSCRIBER')
     A            DEFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            DEFYR     R               REFFLD(FYR)
     A                                      COLHDG('YEAR')
     A            DECASE    R               REFFLD(CASE)
     A                                      COLHDG('CASE#')
     A            DESS#     R               REFFLD(SS#)
     A                                      COLHDG('SOC SEC#')
     A            DEACDT    R               REFFLD(DT)
     A                                      COLHDG('ACC DATE')
     A            DEEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('EOMB#')
     A            DEDSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('DTL' 'SEQ#')
     A            DESEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('SEQ#')
     A            DEEOB     R               REFFLD(CODE3)
     A                                      COLHDG('EOB' 'CODE')
     A*****             Valid values based on FTEBPxx
     A            DENOT1    R               REFFLD(DS70)
     A                                      COLHDG('NOTE 1')
     A            DENOT2    R               REFFLD(DS70)
     A                                      COLHDG('NOTE 2')
     A            DESTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            DEUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            DEPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            DETIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            DEDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            DEIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            DEIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            DEITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            DEIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
     A*** BEG ADD *** 11/19/98 ****************************************
     A*
     A            DEESRC    R               REFFLD(FLAG)
     A                                      COLHDG('EOB SOURCE')
     A*                       VALID VALUES:
     A*                           From Generic Table using id EOMG
     A*
     A            DERCN     R               REFFLD(RCN)
     A                                      COLHDG('RECON NUMBER')
     A*** END ADD *** 11/19/98 ****************************************
     A*** BEG ADD *** 11/30/00 ****************************************
     A*** VALID VALUES:
     A*                 Y or *blank=print on EOMB
     A*                 N = Do NOT print on EOMB
     A*   Note:  *blank will be used by the adj pgm to indicate the item
     A*          WILL print.  Y/N will be used on the interactive screen
     A*          so that the user consciously makes the decision.
     A*
     A            DEPRNT    R               REFFLD(FLAG)
     A                                      COLHDG('PRINT' 'FLAG')
     A*** END ADD *** 11/30/00 ****************************************
     A*** BEG ADD *** 10/25/05 ****************************************
     A            DESAGP    R               REFFLD(DS2)
     A                                      COLHDG('Serv Adj' 'Group' 'Code')
     A*** END ADD *** 10/25/05 ****************************************
