     A                                      REF(SCREFP)
     A          R PPW01                     TEXT('OPTICAL PURGE DELE-
     A                                      TE REQUEST FILE')
     A            PWKEY     R               REFFLD(KEY)
     A            PWSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            PWSYS          1A         TEXT('SYSTEM ID                   ')
     A            PWHCMD         1A         TEXT('HEX CMD TO OLS              ')
     A            PWCPRY         1A         TEXT('COMMAND PRIORITY            ')
      *
      * Optical system/subdir/folder/docid
      *
     A            PWOSYS         1A         TEXT('OPTICAL SYSTEM ID           ')
     A            PWOSBD        12A         TEXT('OPTICAL SUBDIRECTORY        ')
     A            PWOFLD         8A         TEXT('OPTICAL FOLDER NAME         ')
     A            PWOPDI        12A         TEXT('UNIQUE OPTICAL DOC ID       ')
      *
      * Optical backup subdir/folder/docid
      *
     A            PWOBSD        12A         TEXT('OPTICAL BACKUP SUBDIRECTORY ')
     A            PWOBFL         8A         TEXT('OPTICAL BACKUP FOLDER NAME  ')
     A            PWOBDI        12A         TEXT('UNIQUE BACKUP OPTICAL DOC ID')
      *
      * DASD subdir/folder/docid
      *
     A            PWSUBD        12A         TEXT('SUBDIRECTORY                ')
     A            PWFOLD         8A         TEXT('FOLDER NAME - DASD          ')
     A            PWDCID        12A         TEXT('DOCUMENT ID - DASD          ')
      *
     A            PWDELF         1A         TEXT('DELETE FLAG                 ')
     A            PWSTAT    R               REFFLD(STAT)
     A            PWUSER    R               REFFLD(USER)
     A            PWPGM     R               REFFLD(PGM)
     A            PWTIME    R               REFFLD(TIME)
     A            PWDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            PWIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            PWIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            PWPNAM    R               REFFLD(PGM)
     A                                      TEXT('KEYED PGM')
     A            PWASTT         1A         TEXT('ALLOW SAVE TO TAPE (Y/N)    ')
     A            PWBUL#    R               REFFLD(BUL#1)
     A                                      COLHDG('BATCH LOG NO.')
     A            PWERDS        80A         TEXT('80B ERROR DESCRIPTION')
     A            PWTSFL         1A         TEXT('TAPE STATUS FLAG')
