     A          R PST7B                     TEXT('ICR 7-B RECORD')
     A            STLINK        40A         COLHDG('Link data')
     A            STRTYP         1A         COLHDG('Record type code')
     A            STSRTC         1A         COLHDG('Sub-record type code')
     A            STCLM#        12A         COLHDG('Claim #')
     A            STAWWA         5S 0       COLHDG('Average weekly' +
     A                                      'wage amount')
     A            STIJCD         2S 0       COLHDG('Inj code - body part')
     A            STNRIJ         2S 0       COLHDG('Inj cd-nature of inj')
     A            STCAIJ         2S 0       COLHDG('Inj cd-cause of inj')
     A            STCTID         9S 0       COLHDG('Incur cost of temp' +
     A                                      'indemnity amt total')
     A            STSCID         3S 0       COLHDG('Sched indemnity %')
     A            STSCBM         2S 0       COLHDG('Sched indemnity -' +
     A                                      'body member code')
     A            STWKBN         4S 0       COLHDG('Sched indemnity -' +
     A                                      '# of weeks')
     A            STSHLT         9S 0       COLHDG('Sched indemnity -' +
     A                                      'incu loss amt total')
     A            STWKTB         4S 0       COLHDG('# of weeks for' +
     A                                      'temporary benefit')
     A            STFUT1         6A         COLHDG('Future use')
     A            STSCP2         3S 0       COLHDG('Sch indemnity % 2')
     A            STSIM2         2S 0       COLHDG('Sch indemnity' +
     A                                      'body member code 2')
     A            STWKB2         4S 0       COLHDG('Sch indemnity' +
     A                                      '- # of weeks 2')
     A            STSHL2         9S 0       COLHDG('Sched indemnity -' +
     A                                      'incu loss amt tot 2')
     A            STFUT2       130A         COLHDG('Future use')
     A            STGRP#         3S 0       COLHDG('Group #')
     A            STFYR          3S 0       COLHDG('Policy year')
     A            STEMP#         9S 0       COLHDG('Employer #')
