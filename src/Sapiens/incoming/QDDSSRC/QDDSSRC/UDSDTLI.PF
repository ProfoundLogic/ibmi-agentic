     A*
     A*----------------------------------------------------------------
     A          R PSD01                     TEXT('NAIC UDS DETAIL FILE')
     A*
     A            SDRECT         1A         TEXT('Record type')
     A            SDNAIC         5S 0       TEXT('NAIC number')
     A            SDFMST         2A         TEXT('From State')
     A            SDFMLC         2S 0       TEXT('From Location Code')
     A            SDCO#         20A         TEXT('Incolvent Company Number')
     A            SDRCL#        20A         TEXT('Reciever Claim Number')
     A            SDTPA#        30A         TEXT('TPA Claim Number')
     A            SDLCLM        30A         TEXT('Long Claim Number')
     A            SDFCLM        20A         TEXT('Fund Claim Number')
     A            SDAID1        50A         TEXT('Alternate Index 1')
     A            SDAID2        50A         TEXT('Alternate Index 2')
     A            SDAID3        50A         TEXT('Alternate Index 3')
     A            SDAID4        50A         TEXT('Alternate Index 4')
     A            SDDCID        30A         TEXT('Document ID')
     A            SDDCPG         9S 0       TEXT('Document Page Number')
     A            SDCDT          8S 0       TEXT('Capture Date')
     A            SDCTM          8S 0       TEXT('Capture Time')
     A            SDFOLD         6A         TEXT('Folder Type')
     A            SDDTYP        30A         TEXT('Document Type')
     A            SDDESC       128A         TEXT('Document Description')
     A            SDPOL#        20A         TEXT('Policy Number')
     A            SDLSDT         8S 0       TEXT('Date of Loss')
     A            SDINM1        30A         TEXT('Insured Name Line 1')
     A            SDINM2        30A         TEXT('Insured Name Line 2')
     A            SDCLM#         5S 0       TEXT('Claimant Number')
     A            SDCNM1        30A         TEXT('Claimant Name Line 1')
     A            SDCNM2        30A         TEXT('Claimant Name Line 2')
     A            SDPATH       256A         TEXT('Document Path')
     A            SDDOCN       256A         TEXT('Document File Name')
     A            SDFILE         4A         TEXT('File Type')
     A            SDDOCI        12A         TEXT('Document Id')
     A            SDDFLD        80A         TEXT('Document Folder')
     A            SDUNCN       255A         TEXT('Full UNC Path')
     A            SDUSER        10A         TEXT('User')
     A            SDPGM         10A         TEXT('Program')
     A            SDTIME         6S 0       TEXT('Time')
     A            SDDT           7S 0       TEXT('Date')
     A            SDFLAG         1A         TEXT('Processed Flag')
     A            SDACL#        25A         TEXT('Agency Claim #')
     A            SDFND          3S 0       TEXT('Group')
     A            SDEMP#         9S 0       TEXT('Employer #')
