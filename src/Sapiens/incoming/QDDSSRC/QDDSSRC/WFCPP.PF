      *
     A                                      REF(WREFP)
     A          R PCP01                     TEXT('COMMERCIAL PAYROLL BY CLASS W-
     A                                      ORKFILE')
      *
     A            CPCO#     R               REFFLD(CO#)
     A                                      COLHDG('COMPANY NUMBER')
      *
     A            CPCONM    R               REFFLD(NAME)
     A                                      COLHDG('COMPANY NAME')
      *
     A            CPFND     R               REFFLD(FND)
     A                                      COLHDG('GROUP' 'NUMBER')
      *
     A            CPFNAM    R               REFFLD(NAME)
     A                                      COLHDG('GROUP NAME')
      *
     A            CPST      R               REFFLD(ST)
     A                                      COLHDG('STATE')
      *
     A            CPCLAS    R               REFFLD(CLAS)
     A                                      COLHDG('CLASS' 'CODE')
      *
     A            CPSPEC    R               REFFLD(STAT)
     A                                      COLHDG('SPECIAL' 'DESIGNATION')
      *
     A            CPDESC    R               REFFLD(DS30)
     A                                      COLHDG('CLASS DESCRIPTION')
      *
     A            CPEAPR    R               REFFLD(A132)
     A                                      COLHDG('ESTIMATED' 'PAYROLL')
      *
     A            CPSAPR    R               REFFLD(A132)
     A                                      COLHDG('SELF-RPTD' 'PAYROLL')
      *
     A            CPAAPR    R               REFFLD(A132)
     A                                      COLHDG('AUDITED' 'PAYROLL')
      *
     A            CPRNDT    R               REFFLD(DT8)
     A                                      COLHDG('RUN' 'DATE')
     A*** Beg Add *** 04/20/09 **************************************  *********
     A            CPEXT     R               REFFLD(CLA2)
     A                                      COLHDG('Payroll Class' +
     A                                      'Extension')
     A*** End Add *** 04/20/09 **************************************  *********
