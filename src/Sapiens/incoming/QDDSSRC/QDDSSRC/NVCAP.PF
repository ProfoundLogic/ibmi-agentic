     A*****************************************************************
     A** REVISIONS:
     A*  10/12/99 C:31  Project: 51MDN
     A*                 CorVel Network format changes
     A*                 1. Increase size of CACON#
     A*****************************************************************
     A**
     A                                      REF(FSREFP)
     A          R PCA01                     TEXT('CORVEL ACCESS FEE FILE')
     A            CAST           2          COLHDG('Provider State')
     A            CAREF#        12S 0       COLHDG('CorVel Internal' ' Ref no.')
     A            CAFEIN        10S 0       COLHDG('Provider Federal' ' Tax ID')
     A            CAPGRP         3          COLHDG('PPO group code')
     A            CAFAC         35          COLHDG('Facility Name')
     A            CAPLSN        35          COLHDG('Provider Last Name')
     A            CAPFSN        12          COLHDG('Provider First Name')
     A            CAPAT#        16S 0       COLHDG('Patient account #')
     A            CASS#          9          COLHDG('Patient SS #')
     A            CACLID        20          COLHDG('Insurer''s Claim No')
     A            CACLSN        35          COLHDG('Patient Last Name')
     A            CACFSN        12          COLHDG('Patient First Name')
     A            CADOB         10          COLHDG('Date of Birth')
     A*                                        (MM/DD/YYYY)
     A            CASEX          1          COLHDG('Sex')
     A*                                        (M=male, F=female)
     A            CAFRDT        10          COLHDG('First date' 'of service')
     A*                                        (MM/DD/YYYY)
     A            CATODT        10          COLHDG('Last date of service')
     A*                                        (MM/DD/YYYY)
     A            CAAMTC        12S 2       COLHDG('Billed charges')
     A*                                        (999999999.99)
     A            CAMRA         12S 2       COLHDG('FS/U&C Reductions')
     A*                                        (999999999.99)
     A            CAEXCL        12S 2       COLHDG('Charges not approved')
     A*                                        (999999999.99)
     A            CANDIS        12S 2       COLHDG('PPO savings')
     A*                                        (999999999.99)
     A            CAAMTP        12S 2       COLHDG('Amount paid')
     A*                                        (999999999.99)
     A            CAICD1         6          COLHDG('ICD9 Code 1')
     A            CAICD2         6          COLHDG('ICD9 Code 2')
     A            CAICD3         6          COLHDG('ICD9 Code 3')
     A            CACPT1         5          COLHDG('CPT4 Code 1')
     A            CACPT2         5          COLHDG('CPT4 Code 2')
     A            CACPT3         5          COLHDG('CPT4 Code 3')
     A            CACPT4         5          COLHDG('CPT4 Code 4')
     A            CACPT5         5          COLHDG('CPT4 Code 5')
     A            CALOB          1          COLHDG('Line of business')
     A*                                        (W=Workers' comp)
     A            CAPOS          2          COLHDG('Place of service')
     A*                                        (HI=Hospital inpatient)
     A*                                        (HO=Hospital outpatient)
     A*                                        (PO=Outpatient provider)
     A            CATOS          3          COLHDG('Type of service')
     A*                                        (LAB=Lab)
     A*                                        (HHC=Home health care)
     A*                                        (DME=Durable medical equipment)
     A*                                        (RAD=Radiology)
     A*                                        (PAT=Pathology)
     A*                                        (MED=Medical)
     A*                                        (SUR=Suggical)
     A            CACLT#         5          COLHDG('Client Code')
     A*                                        (Not presently used)
     A            CAPPOI        10          COLHDG('CorVel PPO Identifer')
     A            CAAFEE        10S 2       COLHDG('PPO Access fee')
     A*                                        (9999999.99)
     A            CACONM        30          COLHDG('Customer Name')
     A*** BEGIN CHG *** 10/12/99 **************************************
     A********    CACON#        24          COLHDG('Contract')
     A            CACON#        25          COLHDG('Contract')
     A*** END CHG *** 10/12/99 ****************************************
