     A                                      REF(WREFP)
     A          R PCK01                     TEXT('Check schd purge log file')
     A            CKIUSR    R               REFFLD(USER)
     A                                      COLHDG('Intial User')
     A
     A            CKIDT     R               REFFLD(DT)
     A                                      COLHDG('Intial Date')
     A
     A            CKITM     R               REFFLD(TIME)
     A                                      COLHDG('Intial Time')
     A
     A            CKIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Intial Program')
     A
     A            CKPRGCNT       7S 0       COLHDG('Number Records' +
     A                                      'Purged')
     A
     A            CKFRDT    R               REFFLD(DT)
     A                                      COLHDG('From Date')
     A
     A            CKTODT    R               REFFLD(DT)
     A                                      COLHDG('To Date')
     A
     A            CKGRP          3S 0       COLHDG('Group')
     A
     A            CKGRPCHK  R               REFFLD(FLAG)
     A                                      COLHDG('Group checks')
     A
