     A*  WCSTAT RESUBMISSION FILE DATA-LINK, HEADER, NAME, ADDRESS    *
     A*****************************************************************
     A*  DESCRIPTION:                                                 *
     A*    FILE WITH FIELDS FOR LINK, HEADER, NAME AND ADDRESS DATA   *
     A*****************************************************************
     A*  CREATED: 08/19/05       PROJECT: WCxxxx      PROGRAMMER: 15  *
     A*****************************************************************
     A*  REVISIONS:                                                   *
     A*                                                               *
     A*  01/04/18 C:267 PROJECT C150WCI                               *
     A*                Add BUSINESS SEGMENT ID# field in header rcd   *
     A*                                                               *
     A*  05/06/06 C:15  Project: 114WNI                               *
     A*                 Added field for claim #, to allow for ICR     *
     A*                 re-submission of individual claims.           *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PSR01                     TEXT('LINK, HEADER, NAME, ADDRESS')
     A            SRCO#     R               REFFLD(CO#)
     A            SRFND     R               REFFLD(FND)
     A            SRRPMY    R               REFFLD(RMY5)
     A                                      COLHDG('REPORTING' 'MONTH/YEAR')
     A*
     A*  LINK DATA
     A            SRCARR    R               REFFLD(CLAS)
     A                                      COLHDG('CARRIER' 'CODE')
     A            SREMP#    R               REFFLD(EMP#)
     A            SRFYR     R               REFFLD(FYR)
     A            SRCRT#    R               REFFLD(ICD9)
     A                                      COLHDG('CERTIFICATE' 'NUMBER')
     A            SRSTCD    R               REFFLD(A20)
     A                                      COLHDG('STATE' 'CODE')
     A            SREFDT    R               REFFLD(DT)
     A                                      COLHDG('POLICY' 'EFFECTIVE DATE')
     A            SRRPT#    R               REFFLD(FLAG)
     A                                      COLHDG('REPORT' 'NUMBER')
     A            SRCORR    R               REFFLD(FLAG)
     A                                      COLHDG('CORRECTION' 'INDICATOR')
     A*
     A*  HEADER DATA
     A            SRPCON    R               REFFLD(A120)
     A                                      COLHDG('POLICY' 'CONDITIONS')
     A            SRCNDT    R               REFFLD(DT)
     A                                      COLHDG('EXP/CANX' 'DATE')
     A            SRRSK#    R               REFFLD(RSK#)
     A            SRPND#    R               REFFLD(DS10)
     A                                      COLHDG('PENDING' 'FILE#')
     A            SRTERM    R               REFFLD(DAYS)
     A                                      COLHDG('TERM')
     A            SRURRI    R               REFFLD(FLAG)
     A                                      COLHDG('UNIT RPRT' 'RESUBMISSION' +
     A                                             'INDICATOR')
     A            SRPTYP    R               REFFLD(A20)
     A                                      COLHDG('POLICY' 'TYPE')
     A            SRRRPT    R               REFFLD(FLAG)
     A                                      COLHDG('REPLACEMENT' 'REPORT' +
     A                                             'INDICATOR')
     A            SRCTYP    R               REFFLD(FLAG)
     A                                      COLHDG('CORRECTION' 'TYPE')
     A            SRSTED    R               REFFLD(DT)
     A                                      COLHDG('STATE' 'EFFECTIVE DATE')
     A            SRFEIN    R               REFFLD(EMP#)
     A                                      COLHDG('FEDERAL ID')
     A            SRPOLC    R               REFFLD(ICD9)
     A                                      COLHDG('POLICY' 'CONDITIONS')
     A            SRPID#    R               REFFLD(A60)
     A                                      COLHDG('POLICY ID#')
     A            SRDTYP    R               REFFLD(A40)
     A                                      COLHDG('DEDUCTIBLE' 'TYPE')
     A            SRDPCT    R               REFFLD(DISC)
     A                                      COLHDG('DEDUCTIBLE' 'PERCENT')
     A            SRDAMP    R               REFFLD(A90)
     A                                      COLHDG('DEDUCTIBLE' 'AMT PER CLAIM')
     A            SRDAGG    R               REFFLD(A90)
     A                                      COLHDG('DEDUCTIBLE' 'AGGREGATE')
     A            SRPRP#    R               REFFLD(A20)
     A                                      COLHDG('PREVIOUS' 'REPORT#')
     A            SRPCOR    R               REFFLD(FLAG)
     A                                      COLHDG('PREVIOUS' 'CORRECTION IND')
     A            SRPCAR    R               REFFLD(CLAS)
     A                                      COLHDG('PREVIOUS' 'CARRIER CODE')
     A            SRPPOL        18
     A                                      COLHDG('PREVIOUS' 'POLICY#')
     A            SRPEFD    R               REFFLD(DT)
     A                                      COLHDG('PREVIOUS' 'EFF DATE')
     A            SRPEXP    R               REFFLD(A20)
     A                                      COLHDG('PREVIOUS' 'EXPOSURE STATE')
     A            SRPCER    R               REFFLD(ICD9)
     A                                      COLHDG('PREVIOUS' 'CERTIFICATE#')
     A            SRASWG    R               REFFLD(FLAG)
     A                                      COLHDG('ASWG UNIT' 'SUBMISSION')
     A*
     A*  NAME
     A            SRNAME        79
     A                                      COLHDG('NAME OF' 'INSURED')
     A*
     A*  ADDRESS
     A            SRADDR        79
     A                                      COLHDG('ADDRESS OF' 'INSURED')
     A*
     A            SRSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('PROCESS' 'STATUS')
     A            SRUSER    R               REFFLD(USER)
     A            SRPGM     R               REFFLD(PGM)
     A            SRTIME    R               REFFLD(TIME)
     A            SRDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            SRIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            SRIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
     A*** Begin add *** 05/06/08 *************************************
     A            SRCLM#    R               REFFLD(DCID)
     A                                      COLHDG('Claim' 'Number')
     A*** End add ***** 05/06/08 *************************************
     A***** BEG ADD ***** 01/04/18 *****************************************
     A            SRBSI#         7S 0
     A                                      COLHDG('BUS SEG ID#')
     A***** END ADD ***** 01/04/18 *****************************************
