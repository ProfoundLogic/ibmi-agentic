     A                                      COLHDG('CASE#')
     A            EPSS#     R               REFFLD(SS#)
     A                                      COLHDG('SOC SEC#')
     A            EPACDT    R               REFFLD(DT)
     A                                      COLHDG('ACC DATE')
     A            EPEOB#    R               REFFLD(EOB#)
     A                                      COLHDG('EOMB#')
     A            EPRCN     R               REFFLD(RCN)
     A                                      COLHDG('RECON#')
     A*                                           Most current Recon#
     A            EPPHAR    R               REFFLD(DS15)
     A                                      COLHDG('PHARMACY' 'NUMBER')
     A            EPEDI     R               REFFLD(FLAG)
     A                                      COLHDG('ELIGIBLE' 'DATA' 'SUBM')
     A*                                           Valid values:  Y or N   ')
     A            EPSTAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A*                                           "A"
     A            EPUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            EPPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PGM')
     A            EPTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            EPDT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A            EPIUSR    R               REFFLD(USER)
     A                                      COLHDG('INIT USER')
     A            EPIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INIT PGM')
     A            EPITIM    R               REFFLD(TIME)
     A                                      COLHDG('INIT TIME')
     A            EPIDT     R               REFFLD(DT)
     A                                      COLHDG('INIT DATE')
     A*** BEGIN CHG *** 11/22/00 **************************************
     A            EPACCT    R               REFFLD(DS30)
     A*** END   CHG *** 11/22/00 **************************************
     A                                      COLHDG('PATIENT' 'CONTROL#')
