     A                                      COLHDG('COMMENT LINE 1')
     A            CCCOM2    R               REFFLD(DS60)
     A                                      COLHDG('COMMENT LINE 2')
     A            CCFRDT    R               REFFLD(DT)
     A                                      COLHDG('POLICY EFF LOW DATE')
     A            CCTODT    R               REFFLD(DT)
     A                                      COLHDG('POLICY EFF HI DATE')
     A            CCDAY          2  0
     A                                      COLHDG('EXCL NW ACCTS' 'FROM DAY')
