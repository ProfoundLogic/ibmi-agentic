      **** BEGIN CHG **** 08/12/99 ************************************
     A************************************* COLHDG('BALANCE DATE')
     A                                      COLHDG('BILLING' 'THROUGH DATE')
      **** END   CHG **** 08/12/99 ************************************
     A            CCMIN     R               REFFLD(A72)
     A                                      COLHDG('MINIMUM BALANCE')
     A            CCRPMY    R               REFFLD(RMY5)
     A                                      COLHDG('REPORTING MONTH/YEAR')
     A            CCSTAT    R               REFFLD(STAT) COLHDG('STATUS')
     A            CCUSER    R               REFFLD(USER)
     A            CCPGM     R               REFFLD(PGM)
     A            CCTIME    R               REFFLD(TIME)
     A            CCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
