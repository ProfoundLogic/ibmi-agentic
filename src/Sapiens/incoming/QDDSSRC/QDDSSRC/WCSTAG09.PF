     A          R PST09                     TEXT('Subm Control Record')
     A            STFLLR        40A         COLHDG('Filler')
     A            STRTYP         1S 0       COLHDG('Record type code')
     A            STDRCT         8S 0       COLHDG('Det record count tot')
     A            STURST         7S 0       COLHDG('Unit rep subm total')
     A            STPEMY         6A         COLHDG('Primary effective' +
     A                                      'month/year')
     A            STICRT         8S 0       COLHDG('ICR total')
     A            STFUT1       179A         COLHDG('Future use')
     A            STASWG         1A         COLHDG('ASWG tap' +
     A                                      'submission code')
     A            STGRP#         3S 0       COLHDG('Group #')
     A            STFYR          3S 0       COLHDG('Policy year')
     A            STEMP#         9S 0       COLHDG('Employer #')
