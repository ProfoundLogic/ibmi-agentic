     A** WORKERS' COMP  POLICY EXPORT HEADER CSV FILE
     A**************************************************************************
     A* REVISIONS:                                                             *
     A*                                                                        *
     A* 03/14/06 C:136 PROJECT: WC1320                                         *
     A*                ADD CSV ENHANCEMENT TO POLICY EXPORT PROCESS            *
     A*                                                                        *
     A**************************************************************************
     A          R PPX01H                    TEXT('CSV HEADER FOR POLICY EXPORT')
     A            VHRTYP         1A         COLHDG('REC' 'TYPE')
     A                                      TEXT('RECORD TYPE')
     A            VHVDR#         5S 0       COLHDG('VENDOR #')
     A                                      TEXT('VENDOR NUMBER')
     A            VHFTYP         1A         COLHDG('FILE' 'TYPE')
     A                                      TEXT('FILE TYPE')
     A            VHDTYP         1A         COLHDG('DATE' 'TYPE')
     A                                      TEXT('DATE TYPE')
     A            VHDFMT         8A         COLHDG('DATE FORMAT')
     A                                      TEXT('DATE FORMAT')
     A            VHNAME        40A         COLHDG('VENDOR NAME')
     A                                      TEXT('VENDOR NAME')
     A            VHMAIL        60A         COLHDG('VENDOR EMAIL')
     A                                      TEXT('VENDOR EMAIL')
     A            VHADR1        40A         COLHDG('VENDOR ADDR LINE 1')
     A                                      TEXT('VENDOR ADDR LINE 1')
     A            VHADR2        40A         COLHDG('VENDOR ADDR LINE 2')
     A                                      TEXT('VENDOR ADDR LINE 2')
     A            VHCITY        25A         COLHDG('VENDOR CITY')
     A                                      TEXT('VENDOR CITY')
     A            VHST           2A         COLHDG('VENDOR' 'ST')
     A                                      TEXT('VENDOR ST')
     A            VHZIP          9S 0       COLHDG('VENDOR ZIP')
     A                                      TEXT('VENDOR ZIP')
