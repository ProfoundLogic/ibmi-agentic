     A                                      REF(WREFP)
     A          R PPV01                     TEXT('TAX ID# CHANGE HIST. FILE')
     A            PVFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('OLD' 'FEDERAL' 'ID #')
     A            PVMOD     R               REFFLD(MOD)
     A                                      COLHDG('OLD' 'MODIFIER')
     A            PVFEI2    R               REFFLD(FEIN)
     A                                      COLHDG('NEW' 'FEDERAL' 'ID #')
     A            PVMOD2    R               REFFLD(MOD)
     A                                      COLHDG('NEW' 'MODIFIER')
     A            PVUSER    R               REFFLD(USER)
     A            PVPGM     R               REFFLD(PGM)
     A            PVTIME    R               REFFLD(TIME)
     A            PVDT      R               REFFLD(DT)
