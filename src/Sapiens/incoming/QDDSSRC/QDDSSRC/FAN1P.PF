     A*
     A* CONCENTRA EOB Export File - Header
     A*
     A*****************************************************************
     A* Created on 05/12/2003 by c:62 for Project 129MBO
     A*****************************************************************
     A* Purpose: This file will house the billing record for the
     A*          associated CONCENTRA records.  Additional fields will
     A*          be added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAN9P record via N1DCID.
     A*****************************************************************
     A* Revisions:
     A*
     A* 10/26/06 C:053 53674
     A*                ADD N1TFEE FOR TOTAL.
     A*
     A* 11/17/05 C:79 PROJECT: 135MET
     A*               ADDITIONAL CHANGES FOR REMITTANCE FILE PROCESS
     A*
     A* 12/11/03 C:62 PROJECT: 129MEQ
     A*               CHANGE COMMENT ON N1PRFL
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PN101                     TEXT('CONCENTRA EOB Export File')
     A            N1RCDT         1A         COLHDG('Record Type')
     A            N1HDRI        10A         COLHDG('Header ID')
     A            N1BLID        25A         COLHDG('Bill ID')
     A            N1REF#        15A         COLHDG('Reference #')
     A            N1CLM#        20A         COLHDG('Claim number')
     A            N1DOI         10A         COLHDG('Injury Date')
     A            N1IPBF         1A         COLHDG('Invoice Pay Bill')
     A            N1AST          2A         COLHDG('Analysis State')
     A            N1JST          2A         COLHDG('Jurisdiction State')
     A            N1DUP          1A         COLHDG('Duplicate Flag')
     A            N1CHRG        10A         COLHDG('Charges')
     A            N1TALL        10A         COLHDG('Total Paid')
     A            N1PALL        10A         COLHDG('Total Previous Paid')
     A            N1RRED        10A         COLHDG('Total Revised Paid')
     A            N1BRED        10A         COLHDG('Total MRA')
     A            N1PBRD        10A         COLHDG('Total Previous MRA')
     A            N1NRED        10A         COLHDG('Total Network')
     A            N1PNRD        10A         COLHDG('Total Prev. Network')
     A            N1ORED        10A         COLHDG('Total Other')
     A            N1BFEE        10A         COLHDG('BRS Fee')
     A            N1NFEE        10A         COLHDG('Network Fee')
     A            N1OFEE        10A         COLHDG('Other Fee')
     A            N1REDT        10A         COLHDG('Payor Receive Date')
     A            N1BLDT        10A         COLHDG('Billing Date')
     A            N1BRDT        10A         COLHDG('BR Receive Date')
     A            N1AUDT        10A         COLHDG('Last Audit Date')
     A            N1FRDT        10A         COLHDG('From Service Date')
     A            N1TODT        10A         COLHDG('To Service Date')
     A            N1DIA1         6A         COLHDG('Diagnosis Code 1')
     A            N1DIA2         6A         COLHDG('Diagnosis Code 2')
     A            N1DIA3         6A         COLHDG('Diagnosis Code 3')
     A            N1DIA4         6A         COLHDG('Diagnosis Code 4')
     A            N1DDS1        48A         COLHDG('Dx 1 Description')
     A            N1DDS2        48A         COLHDG('Dx 2 Description')
     A            N1DDS3        48A         COLHDG('Dx 3 Description')
     A            N1DDS4        48A         COLHDG('Dx 4 Description')
     A            N1PX1          5A         COLHDG('Procedure Code 1')
     A            N1PX2          5A         COLHDG('Procedure Code 2')
     A            N1PX3          5A         COLHDG('Procedure Code 3')
     A            N1PX4          5A         COLHDG('Procedure Code 4')
     A            N1PDS1       255A         COLHDG('Px 1 Description')
     A            N1PDS2       255A         COLHDG('Px 2 Description')
     A            N1PDS3       255A         COLHDG('Px 3 Description')
     A            N1PDS4       255A         COLHDG('Px 4 Description')
     A            N1UBTY         3A         COLHDG('UB Bill Type')
     A            N1ADDT        10A         COLHDG('Admit Date')
     A            N1DCDT        10A         COLHDG('Discharge Date')
     A            N1ADHR        10A         COLHDG('Admit Hour')
     A            N1DCHR        10A         COLHDG('Discharge Hour')
     A            N1ADTY         1A         COLHDG('Admission Type')
     A            N1ADSC         1A         COLHDG('Admission Source')
     A            N1PATS         2A         COLHDG('PT Status')
     A            N1ADDI         6A         COLHDG('Admit Dx Code')
     A            N1IDOC        25A         COLHDG('Scan Image ID')
     A            N1PSPC        12A         COLHDG('Provider Spec Code')
     A            N1LIC#        15A         COLHDG('Ind License #')
     A            N1MCAR         9A         COLHDG('Medicare Provider ID')
     A            N1ITIN         9A         COLHDG('Ind Provider TIN')
     A            N1PNAM        35A         COLHDG('Ind Last Name')
     A            N1PFSN        35A         COLHDG('Ind First Name')
     A            N1PMID         1A         COLHDG('Ind Middle Initial')
     A            N1PAD1        35A         COLHDG('Ind Address 1')
     A            N1PAD2        35A         COLHDG('Ind Address 2')
     A            N1PCTY        20A         COLHDG('Ind City')
     A            N1PST          2A         COLHDG('Ind State')
     A            N1PZIP         9A         COLHDG('Ind Zip Code')
     A            N1GPID         9A         COLHDG('Group Provider ID')
     A            N1GTIN         9A         COLHDG('Group Provider TIN')
     A            N1GNAM        35A         COLHDG('Group Name')
     A            N1GAD1        35A         COLHDG('Group Address 1')
     A            N1GAD2        35A         COLHDG('Group Address 2')
     A            N1GCTY        20A         COLHDG('Group City')
     A            N1GST          2A         COLHDG('Group State')
     A            N1GZIP         9A         COLHDG('Group Zip Code')
     A            N1NTWK         9A         COLHDG('Network Number')
     A            N1NWNM        30A         COLHDG('Network Name')
     A            N1SSN          9A         COLHDG('Patient ID #')
     A            N1ACCT        25A         COLHDG('Patient Account #')
     A            N1INPE        10A         COLHDG('NY Inpatient' +
     A                                      'HOS Elector')
     A            N1INPN        10A         COLHDG('NY Inpatient' +
     A                                      'HOS Non-Elector')
     A            N1OUTE        10A         COLHDG('NY Outpatient' +
     A                                      'HOS Elector')
     A            N1OUTN        10A         COLHDG('NT Outpatient' +
     A                                      'HOS Non-Elector')
     A            N1ASCE        10A         COLHDG('NY ASC Elector')
     A            N1ASCN        10A         COLHDG('NY ASC Non-Elector')
     A            N1CLNE        10A         COLHDG('NY CLN Elector')
     A            N1CLNN        10A         COLHDG('NY CLN Non-Elector')
     A            N1LABE        10A         COLHDG('NY LAB Elector')
     A            N1LABN        10A         COLHDG('NY LAB Non-Elector')
     A            N1GRPE        10A         COLHDG('Group NY Surcharge' +
     A                                      'Elector')
     A            N1GRPN        10A         COLHDG('Group NY Surcharge' +
     A                                      'Non-Elector')
     A            N1INDE        10A         COLHDG('Ind NY Surcharge' +
     A                                      'Elector')
     A            N1INDN        10A         COLHDG('Ind NY Surcharge' +
     A                                      'Non-Elector')
     A            N1NOTE       255A         COLHDG('Description Text')
     A            N1REAS        50A         COLHDG('Reason Code')
     A            N1FIL1       250A         COLHDG('Filler 1')
     A            N1FIL2       250A         COLHDG('Filler 2')
     A            N1FIL3       250A         COLHDG('Filler 3')
     A            N1FIL4       250A         COLHDG('Filler 4')
     A            N1FIL5       250A         COLHDG('Filler 5')
     A            N1FIL6       250A         COLHDG('Filler 6')
     A            N1FIL7       250A         COLHDG('Filler 7')
     A            N1FIL8        80A         COLHDG('Filler 8')
     A*****************************************************************
     A* PDS Tracking Fields
     A*****************************************************************
     A            N1DCID    R               REFFLD(DCID)
     A                                      COLHDG('IMPORT Doc ID')
     A            N1MBR#    R               REFFLD(DS10)
     A                                      COLHDG('FAN0P Member #')
     A            N1CO#     R               REFFLD(CO#)
     A                                      COLHDG('(PDS) Company #')
     A            N1SUB#    R               REFFLD(SUB#)
     A                                      COLHDG('(PDS) Subscriber #')
     A            N1FND     R               REFFLD(FND)
     A                                      COLHDG('(PDS) Group #')
     A            N1FYR     R               REFFLD(FYR)
     A                                      COLHDG('(PDS) Year')
     A            N1CASE    R               REFFLD(CASE)
     A                                      COLHDG('(PDS) Case #')
     A            N1SS#     R               REFFLD(SS#)
     A                                      COLHDG('(PDS) SS#')
     A            N1ACDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) ACDT')
     A            N1FEIN    R               REFFLD(FEIN)
     A                                      COLHDG('(PDS) FEIN')
     A            N1MOD     R               REFFLD(MOD)
     A                                      COLHDG('(PDS) Mod')
     A            N1EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB')
     A            N1RCN     R               REFFLD(RCN)
     A                                      COLHDG('(PDS) RCN')
     A            N1DLUS    R               REFFLD(USER)
     A                                      COLHDG('(PDS) Delete User')
     A            N1DLPG    R               REFFLD(PGM)
     A                                      COLHDG('(PDS) Delete Pgm')
     A            N1DLTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Delete Time')
     A            N1DLDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Delete Date')
     A            N1DLRE    R               REFFLD(DS70)
     A                                      COLHDG('(PDS) Delete Reason')
     A            N1PRDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Process Date')
     A            N1PRTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Process Time')
     A            N1PRUS    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Process User')
     A            N1PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A*
     A*                                     *blank = not processed yet
     A*                                     "D" = Deleted
     A*                                     "E" = Error
     A*                                     "I" = Duplicate Error
     A*                                     "R" = Recon Error
     A*                                     "Y" = written to WCMC
     A*                                     "P" = Payment Error
     A*
     A            N1RCNE    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Recon Error')
     A*
     A*                                     *blank = no recon error
     A*                                     "1" = Can't determine recon
     A*                                     "2" = Original/Previous
     A*                                           recon not uploaded
     A*** BEG ADD *** 11/17/05 ****************************************
     A            N1ULDT         7S 0
     A                                      COLHDG('(PDS) Upload Date')
     A            N1RMFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Remitt' 'Proc Flag')
     A            N1CHK#         9S 0
     A                                      COLHDG('(PDS) Remitt' 'Check#')
     A*** END ADD *** 11/17/05 ****************************************
     A*** BEG ADD *** 10/26/06 ****************************************
     A            N1TFEE         9S 2       COLHDG('Total Fees')
     A*** END ADD *** 10/26/06 ****************************************
     A*
