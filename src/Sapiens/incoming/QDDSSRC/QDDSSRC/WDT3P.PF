     A*
     A          R PT301                     TEXT('WDSTP TYPE 30')
     A            T3SERV         2S 0       COLHDG('SERVICE' 'COMPANY')
     A            T31RIS         2S 0       COLHDG('RISK PLANT CODE')
     A            T32RIS         1S 0       COLHDG('RISK TYPE')
     A            T3RISK         9S 0       COLHDG('RISK NUMBER')
     A            T3TYPE         2S 0       COLHDG('RECORD' 'TYPE')
     A            T31MAN         4S 0       COLHDG('MANUAL')
     A            T32MAN         2S 0       COLHDG('SUB-MANUAL')
     A*                                        EQUALS 0 FOR RCD TYPE 10
     A            T3RESC         2A         COLHDG('RESERVE' 'CODE')
     A*                                       NOT VALID FOR TYPE 10 &
     A*                                       20 RECORDS. _M FOR TYPE
     A*                                       30 = MEDICAL ONLY. ALL
     A*                                       OTHER CODES = LOST TIME
     A            T3CLAM        10A         COLHDG('ST CLAIM #')
     A            T3CNAM        26A         COLHDG('CLAIMANT' 'NAME')
     A            T3GFYR         2S 0       COLHDG('FISCAL' 'YEAR')
     A            T3INJY         2S 0       COLHDG('INJURY' 'YEAR')
     A            T3COMP         7S 0       COLHDG('COMP')
     A            T3COMS         1A         COLHDG('COMP' 'SIGN')
     A            T3CMPR         7S 0       COLHDG('COMP' 'RESERVE')
     A***                                      THIS IS REMAINING RESERVES
     A            T3CMPS         1A         COLHDG('COMP' 'RESERVE' 'SIGN')
     A            T3MEDI         7S 0       COLHDG('MEDICAL')
     A            T3SEDI         1A         COLHDG('MEDICAL' 'SIGN')
     A            T3MEDR         7S 0       COLHDG('MEDICAL' 'RESERVE')
     A***                                      THIS IS REMAINING RESERVES
     A            T3SEDR         1A         COLHDG('MEDICAL' 'RESERVE' 'SIGN')
     A            T3HCCM         7S 0       COLHDG('HANDICAP' 'COMP')
     A            T3HCCS         1A         COLHDG('HANDICAP' 'COMP' 'SIGN')
     A            T3HCRE         7S 0       COLHDG('HANDICAP' 'RESV')
     A*                                        THIS IS REMAINING RESERVES
     A            T3HCRS         1A         COLHDG('HANDICAP' 'RESV' 'SIGN')
     A            T3HCMD         7S 0       COLHDG('HANDICAP' 'MED')
     A            T3SCMD         1A         COLHDG('HANDICAP' 'MED' 'SIGN')
     A            T3HCMR         7S 0       COLHDG('HC' 'MED RESV')
     A*                                        THIS IS REMAINING RESERVES
     A            T3SCMR         1A         COLHDG('HC' 'MED RESV' 'SIGN')
     A*
     A            T31SUR         1S 0       COLHDG('SURPLUS' 'CODE')
     A            T32SUR         3S 0       COLHDG('SURPLUS' '%')
     A            T3FND          3S 0       COLHDG('FUND' 'NMBR')
     A            T3EMP#         9S 0       COLHDG('EMPLOYER')
     A            T3DIV          5S 0       COLHDG('DIVISION')
