     A*                  Add field for                                *
     A*                   "CX processing sort order"                  *
     A*
     A* 09/02/05  C:61   PROJECT: WC1359 129WLT                       *
     A*                  Created to enable process of                 *
     A*                  Mass Cancellations in Agent Number order.    *
     A*                                                               *
     A*****************************************************************
      *
     A                                      REF(WREFP)
     A          R PC601                     TEXT('MASS CX WORK FILE')
      *
     A            C6CO#          3S 0
     A                                      COLHDG('COMPANY')
     A            C6FND          3S 0
     A                                      COLHDG('GROUP')
     A            C6FYR          3S 0
     A                                      COLHDG('POLICY YEAR')
     A            C6EMP#         9S 0
     A                                      COLHDG('EMPLOYER')
     A            C6DIV          5S 0
     A                                      COLHDG('DIVISION')
     A            C6REQ#         5S 0
     A                                      COLHDG('REQUEST #')
     A            C6CCRT         1A
     A                                      COLHDG('CERTIFICATE' +
     A                                      'HOLDER LETTER FLAG')
     A            C6REPR         1A
     A                                      COLHDG('REPRINT FLAG')
     A            C6OUTQ        10A
     A                                      COLHDG('OUTPUT QUEUE')
     A            C6BAT#         9A
     A                                      COLHDG('BATCH #')
     A            C6TYPE         1A
     A                                      COLHDG('TYPE OF MAILING' +
     A                                      'LABEL')
     A            C6CERT         1A
     A                                      COLHDG('FLAG - ADDITIONAL' +
     A                                      'OUTPUT FOR CERTIFIED' +
     A                                      'MAILING')
     A            C6AGT#         5S 0
     A                                      COLHDG('AGENT #')
      *
      *
     A            C6USER    R               REFFLD(USER)
     A                                      COLHDG('MAINT USER')
     A            C6PGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINT PROGRAM')
     A            C6TIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINT TIME')
     A            C6DT      R               REFFLD(DT)
     A                                      COLHDG('MAINT DATE')
     A***** BEG ADD ***** 07/03/07 ***********************************
     A            C6SORT       200A         COLHDG('CX proc.sort order')
     ***** END ADD ***** 07/03/07 ***********************************
