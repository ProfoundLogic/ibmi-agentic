     A*
     A* MAINTENANCE FIELDS
     A*
     A            P4USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            P4PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            P4TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            P4DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A*
     A            P4ST           2A
     A                                      COLHDG('END FORM STATE')
     A            P4DESC       100A
     A                                      COLHDG('END FORM DESCRIPTION')
     A*** BEGIN ADD ***  10/30/17  *******************************************
     A            P4EFFDT        8S 0
     A                                      COLHDG('END FORM EFF DATE')
