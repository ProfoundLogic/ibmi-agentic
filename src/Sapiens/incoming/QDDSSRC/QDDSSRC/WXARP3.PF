     A                                      REF(WREFP)
     A          R PXARP3                    TEXT('A/R DTL EMP XML WORKFILE')
     A            ARXMLFILE     60          COLHDG('XML File Name')
     A            ARCO#          3S 0       COLHDG('Company')
     A            ARFND          3S 0       COLHDG('Fund')
     A            ARFYR          3S 0       COLHDG('Fyr')
     A            AREMP#         9S 0       COLHDG('Emp#')
     A            ARDIV          5S 0       COLHDG('Div')
     A            ARENAM        40A         COLHDG('Emp Name')
     A            ARPFDT         8S 0       COLHDG('Policy From Date')
     A            ARPTDT         8S 0       COLHDG('Policy To Date')
     A            ARANPREM      11S 2       COLHDG('Annual Premium')
     A            ARAGT#         5S 0       COLHDG('Agent #')
     A            ARAGTNAM      40A         COLHDG('Agent Name')
     A            ARCXDT         8S 0       COLHDG('CX Date')
     A            ARPRVBAL      13S 2       COLHDG('Prev Balance')
     A            AREMPCOLTT    13S 2       COLHDG('Emp Collection' 'Total')
     A            AREMPOTHTT    13S 2       COLHDG('Emp Other' 'Total')
     A            AREMPBILTT    13S 2       COLHDG('Emp Billing' 'Total')
     A            AREMPCURTT    13S 2       COLHDG('Emp Current' 'Total')
