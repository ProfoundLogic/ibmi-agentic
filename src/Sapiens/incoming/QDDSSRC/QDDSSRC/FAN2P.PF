     A*
     A* CONCENTRA EOB Export File - Detail
     A*
     A*****************************************************************
     A* Created on 05/12/2003 by c:62 for Project 129MBO
     A*****************************************************************
     A* Purpose: This file will house the billing record for the
     A*          associated CONCENTRA records.  Additional fields will
     A*          be added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAN1P record via N2BLID.
     A*****************************************************************
     A* Revisions:
     A*
     A* 10/21/03 c:62 Project 129MDB
     A*               add eob code and description
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PN201                     TEXT('CONCENTRA EOB Detail')
     A            N2RCDT         1A         COLHDG('Record Type')
     A            N2BLID        20A         COLHDG('Bill ID')
     A            N2LIN#        10A         COLHDG('Line Number')
     A            N2SEQ#        10A         COLHDG('Line Sequence #')
     A            N2FDAT        10A         COLHDG('Service Date')
     A            N2CHRG        10A         COLHDG('Line Charge')
     A            N2HCHG        10A         COLHDG('Bill Charge')
     A            N2HBRD        10A         COLHDG('Bill MRA')
     A            N2HNRD        10A         COLHDG('Bill Network')
     A            N2BRED        10A         COLHDG('Line MRA Reduction')
     A            N2NRED        10A         COLHDG('Line Network' +
     A                                      'Reduction')
     A            N2ORED        10A         COLHDG('Line Other Reduction')
     A            N2TALL        10A         COLHDG('Line Paid Amount')
     A            N2PALL        10A         COLHDG('Line Revised Paid')
     A            N2DALL        10A         COLHDG('Line Duplicate Allow')
     A            N2PRCD        12A         COLHDG('Submitted Code')
     A            N2PRDS       255A         COLHDG('Code Description')
     A            N2MOD1        12A         COLHDG('Modifier 1')
     A            N2MOD2        12A         COLHDG('Modifier 2')
     A            N2ACD1        12A         COLHDG('Adjusted Code 1')
     A            N2ADS1       255A         COLHDG('Adj Code 1 Desc')
     A            N2ACD2        12A         COLHDG('Adjusted Code 2')
     A            N2ADS2       255A         COLHDG('Adj Code 2 Desc')
     A            N2AMD1        12A         COLHDG('Adj Modifier 1')
     A            N2AMD2        12A         COLHDG('Adj Modifier 2')
     A            N2AMD3        12A         COLHDG('Adj Modifier 3')
     A            N2POS         12A         COLHDG('Place of Service')
     A            N2TOS          2A         COLHDG('Type of Service')
     A            N2XREF         9A         COLHDG('ICD9 X-ref')
     A            N2UNTS        10A         COLHDG('Units')
     A            N2MIN         10A         COLHDG('Minutes')
     A            N2PART         2A         COLHDG('Body Part')
     A            N2SZIP         9A         COLHDG('Analysis Zip Code')
     A            N2CDTY        50A         COLHDG('Service Code Type')
     A*** BEGIN ADD *** 10/21/03 **************************************
     A            N2EC01        12A         COLHDG('Explanation code 01')
     A            N2ED01       255A         COLHDG('Explanation desc 01')
     A            N2EC02        12A         COLHDG('Explanation code 02')
     A            N2ED02       255A         COLHDG('Explanation desc 02')
     A            N2EC03        12A         COLHDG('Explanation code 03')
     A            N2ED03       255A         COLHDG('Explanation desc 03')
     A            N2EC04        12A         COLHDG('Explanation code 04')
     A            N2ED04       255A         COLHDG('Explanation desc 04')
     A            N2EC05        12A         COLHDG('Explanation code 05')
     A            N2ED05       255A         COLHDG('Explanation desc 05')
     A            N2EC06        12A         COLHDG('Explanation code 06')
     A            N2ED06       255A         COLHDG('Explanation desc 06')
     A            N2EC07        12A         COLHDG('Explanation code 07')
     A            N2ED07       255A         COLHDG('Explanation desc 07')
     A            N2EC08        12A         COLHDG('Explanation code 08')
     A            N2ED08       255A         COLHDG('Explanation desc 08')
     A            N2EC09        12A         COLHDG('Explanation code 09')
     A            N2ED09       255A         COLHDG('Explanation desc 09')
     A            N2EC10        12A         COLHDG('Explanation code 10')
     A            N2ED10       255A         COLHDG('Explanation desc 10')
     A            N2EC11        12A         COLHDG('Explanation code 11')
     A            N2ED11       255A         COLHDG('Explanation desc 11')
     A            N2EC12        12A         COLHDG('Explanation code 12')
     A            N2ED12       255A         COLHDG('Explanation desc 12')
     A*** END   ADD *** 10/21/03 **************************************
     A*****************************************************************
     A* PDS Tracking Fields
     A*****************************************************************
     A            N2EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB')
     A            N2RCN     R               REFFLD(RCN)
     A                                      COLHDG('(PDS) RCN')
     A            N2DSEQ    R               REFFLD(SEQ#)
     A                                      COLHDG('(PDS) Detail Seq#')
     A            N2PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A*
     A*                                     *blank = not processed yet
     A*                                     "Y" = written to WCMC
     A*
