     A            KTSRC2        10A         COLHDG('DART MAIL' 'SEARCH PGM')
     A            KTSRC3        10A         COLHDG('DART MAIL' 'KEY SEARCH')
     A            KTSRC4        10A         COLHDG('CPY/TRANS' 'KEY SEARCH')
     A            KTSRC5        10A         COLHDG('DARTS' 'GENERIC PROMPT')
     A            KTSRC6        10A         COLHDG('WEB IMG SCN DTL')
     A            KTSRC7        10A         COLHDG('SEARCH PGM 7')
     A            KTSRC8        10A         COLHDG('SEARCH PGM 8')
     A            KTSRC9        10A         COLHDG('DIRECT SCAN' 'PROMPT PGM')
     A            KTSRCA        10A         COLHDG('EXT APP' 'AUTO FOLDER PGM')
