     A                                      COLHDG('PROGRAM' 'DESCRIPTION')
     A** Maintenance fields
     A            KTSTAT    R               REFFLD(STAT)
     A            KTUSER    R               REFFLD(USER)
     A            KTPGM     R               REFFLD(PGM)
     A            KTTIME    R               REFFLD(TIME)
     A            KTDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            KTIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY' 'USER')
     A            KTIPGM    R               REFFLD(PGM)
     A                                      COLHDG('RECORD CREATED BY' 'PROGRM')
     A            KTIDT     R               REFFLD(DT)
     A                                      COLHDG('DATE' 'CREATED')
     A*** BEGIN ADD *** 01/24/2000 *********************************************
     A            KTDESC    R               REFFLD(DS20)
     A                                      COLHDG('APPLICATION DESCRIP')
     A            KTINPG        10A         COLHDG('INDEX PGM')
     A            KTVPGM        10A         COLHDG('VERIFY PGM')
     A            KTSPLT        10A         COLHDG('SPLIT PGM')
