     A            CLDCID        60A         COLHDG('Document Name/ID')
     A            CLLANG        40A         COLHDG('Document Language')
     A            CLLTFR         1A         COLHDG('Lost Time Begin')
     A            CLLTTO         1A         COLHDG('Lost Time To')
     A            CLCSFR         1A         COLHDG('Claim Status Begin')
     A            CLCSTO         1A         COLHDG('Claim Status To')
     A            CLANDR         1A         COLHDG('And/Or')
     A*
     A            CLPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            CLUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            CLDT      R     S         REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            CLTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            CLIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            CLIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            CLIDT     R     S         REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            CLITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            CLSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
