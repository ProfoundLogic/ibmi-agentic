     A                                      REF(WREFP)
     A          R PTM01                     TEXT('Portal Template File')
     A            TMCO#          3S 0       COLHDG('Company #')
     A            TMNAME        40          COLHDG('Template Name')
     A            TMMINPRM      11S 0       COLHDG('Minimum Premium')
     A            TMMAXPRM      11S 0       COLHDG('Maximum Premium')
     A            TMMAXMOD       5S 4       COLHDG('Maximum Experience' +
     A                                      'Modifier')
     A            TMMINYRS       9S 0       COLHDG('Minimum Years in'   +
     A                                      'Business')
     A            TMMAXLRA       9S 4       COLHDG('Maximum Loss Ratio')
     A            TMMAXCLR       9S 4       COLHDG('Maximum Current'    +
     A                                      'Loss Ratio')
     A            TMMAXSCORE     5S 4       COLHDG('Analytic Score' 'Maximum')
     A            TMMINSCORE     5S 4       COLHDG('Analytic Score' 'Minimum')
     A            TMREQCON       1A         COLHDG('Require Contact'    +
     A                                      'Information')
     A            TMREQLHS       1A         COLHDG('Require Loss'       +
     A                                      'History')
     A            TMIECLCD       1A         COLHDG('Include/Exclude'    +
     A                                      'Class Codes')
     A            TMRATECD       3A         COLHDG('Rate Set Code')
     A            TMUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TMPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TMDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TMTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TMIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TMIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TMIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TMITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TMSTAT         1A         COLHDG('Status')
