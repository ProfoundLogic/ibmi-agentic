     A                                      REF(WREFP)
     A          R PDP01                     TEXT('DOCUMENTH PATH')
     A            DPTYPE        15A         COLHDG('DOCUMENT TYPE')
     A            DPKEY         60A         COLHDG('KEY VALUE FOR LOOKUP')
     A            DPPATH       256A         COLHDG('DOC PATH')
     A            DPUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            DPPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            DPTIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            DPDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A
     A          K DPTYPE
     A          K DPKEY
