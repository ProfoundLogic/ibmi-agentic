     A                                      REF(FSREFP)
     A          R PA301                     TEXT('OH Statewide HCPCS')
      *
     A            A3CODE    R               REFFLD(DS8)
     A                                      COLHDG('CPT CODE')
     A            A3DESC    R               REFFLD(DS40)
     A                                      COLHDG('DESCRIPTION')
     A            A307FE    R               REFFLD(DS12)
     A                                      COLHDG('7/1/96 RURAL FEE')
     A            A3UNIT    R               REFFLD(DS4)
     A                                      COLHDG('UNITS')
      *               If "unit", then take units entered in Bill Entry,
      *               then multiply fee * units.
      *
      *               If *BLANK, then take straight fee.
      *
      * PDS Audit Fields
      *
     A            A3DISC    R               REFFLD(DS3)
     A                                      COLHDG('DISCOUNT CODE')
      *               Based on NMBDP/BDCODE
      *
     A            A3EFDT    R               REFFLD(DT7)
     A                                      COLHDG('EFFECTIVE DATE')
      *               Based on NMBDP/BDEFDT
      *
     A            A3CONV    R               REFFLD(FLAG)
     A                                      COLHDG('CONVERSION' 'STATUS' -
     A                                      'CODE')
      *               E = Assignment not made
      *               L = Assignment made
      *               U = Updated
      *
     A            A3STAT    R               REFFLD(STAT)
     A                                      COLHDG('STATUS')
     A            A3USER    R               REFFLD(USER)
     A                                      COLHDG('CVT USER')
     A            A3PGM     R               REFFLD(PGM)
     A                                      COLHDG('CVT PROGRAM')
     A            A3TIME    R               REFFLD(TIME)
     A                                      COLHDG('CVT TIME')
     A            A3DT      R               REFFLD(DT7)
     A                                      COLHDG('CVT DATE')
     A            A3IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL CVT' 'USER')
     A            A3IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL CVT' 'PROGRAM')
     A            A3ITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL CVT' 'TIME')
     A            A3IDT     R               REFFLD(DT7)
     A                                      COLHDG('INITIAL CVT' 'DATE')
