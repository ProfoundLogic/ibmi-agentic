     A**
     A                                      DSPSIZ(24 80 *DS3)
     A                                      REF(*LIBL/CREFP)
     A                                      CHGINPDFT
     A                                      MSGLOC(24)
     A                                      PRINT
     A                                      CF03
     A                                      CF12
     A                                      HELP(10)
     A                                      VLDCMDKEY(11)
     A*----------------------------------------------------------------
     A*    SCR01S - SCREEN 1 SUBFILE RECORD
     A*----------------------------------------------------------------
     A          R SCR01S                    SFL
     A            SCFL      R        B  6  2REFFLD(FLAG)
     A                                      DSPATR(ND)
     A            SCNAM         47A  O  6  4
     A                                      COLOR(WHT)
     A            SCNUM          3A  O  6 62
     A                                      COLOR(WHT)
     A            SCSTAT         1A  O  6 77
     A                                      COLOR(WHT)
     A            SCADR         73A  O  7  7
     A                                      COLOR(GRN)
     A*----------------------------------------------------------------
     A*    SCR01C - SCREEN 1 SUBFILE CONTROL RECORD
     A*----------------------------------------------------------------
     A          R SCR01C                    SFLCTL(SCR01S)
     A                                      ROLLUP(18)
     A                                      SETOF(20)
     A                                      KEEP
     A                                      OVERLAY
     A  90                                  SFLCLR
     A  91                                  SFLDSP
     A N90                                  SFLDSPCTL
     A                                      SFLSIZ(09)
     A                                      SFLPAG(08)
     A  99                                  SFLEND(*MORE)
     A                                      SFLCSRRRN(&SFRRN)
     A  20                                  SFLMSG('NO RECORDS FOUND')
     A                                      CSRLOC(SFROW SFCOL)
     A            SFROW          3S 0H
     A            SFCOL          3S 0H
     A            SFRNO          4S 0H
     A                                      SFLRCDNBR(CURSOR)
     A            SFRRN          5S 0H
     A            SCUSER    R        O  1  2REFFLD(USER)
     A            SCCONM    R        O  1 21REFFLD(NAME)
     A                                      TEXT('COMPANY NAME')
     A                                  1 73DATE
     A                                      EDTWRD('  /  /  ')
     A                                  2  2'C0622F'
     A            SCPRDS    R        O  2 21REFFLD(NAME)
     A                                      TEXT('PROGRAM NAME')
     A                                  2 76'SCR01'
     A                                  4  4'Agent Producer Number:'
     A            SCPROD    R        B  4 27REFFLD(PRO#)
     A*                                     DSPATR(CS)
     A                                  5  4'Agent Producer Name/Address       -
     A                                                   '
     A                                      DSPATR(UL)
     A                                  5 61'Number'
     A                                      DSPATR(UL)
     A                                  5 75'Status'
     A                                      DSPATR(UL)
     A*----------------------------------------------------------------
     A*    SCR01R - SCREEN 1 SUBFILE OPTION LINE RECORD
     A*----------------------------------------------------------------
     A          R SCR01R
     A                                      OVERLAY
     A                                 24  8'F3=Exit      '
     A                                      COLOR(BLU)
     A                                 24 29'F12=Cancel     '
     A                                      COLOR(BLU)
