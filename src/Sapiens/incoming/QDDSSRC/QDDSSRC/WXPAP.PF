     A                                      REF(WREFP)
     A          R PPA01                     TEXT('EXTRACT PAYMENT DETAIL')
     A            PACO#          3S 0       COLHDG('COMPANY#')
     A            PAFND          3S 0       COLHDG('GROUP')
     A            PAFNAM        60          COLHDG('GROUP NAME')
     A            PAFYR          3S 0       COLHDG('POLICY YEAR')
     A            PACASE         7S 0       COLHDG('CASE')
     A            PACLSN    R               REFFLD(LSN)
     A                                      COLHDG('CLAIMANT' 'LAST NAME')
     A            PACFSN    R               REFFLD(FSN)
     A                                      COLHDG('CLAIMANT' 'FIRST NAME')
     A            PACHK#         7S 0       COLHDG('CHECK#')
     A            PATRDT    R               REFFLD(DT8)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            PAFEIN         9S 0       COLHDG('PAYEE' 'FEDERAL' 'ID')
     A            PAMOD          9S 0       COLHDG('PAYEE' 'MOD')
     A            PAPNAM        40          COLHDG('PAYEE' 'NAME')
     A            PAAMT          9S 2       COLHDG('PMT AMOUNT')
     A            PAPV1     R               REFFLD(CODE)
     A                                      COLHDG('PAYMENT' 'VALUE 1')
     A            PAP1DS    R               REFFLD(DS30)
     A                                      COLHDG('PV1 DESCRIPTION')
     A            PAFRDT    R               REFFLD(DT8)
     A                                      COLHDG('FROM' 'DATE')
     A            PATODT    R               REFFLD(DT8)
     A                                      COLHDG('TO' 'DATE')
     A            PAWKS          3S 0       COLHDG('WEEKS')
     A            PADAYS         1S 0       COLHDG('DAYS')
     A            PATRCD    R               REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'CODE')
     A            PATRDS    R               REFFLD(DS30)
     A                                      COLHDG('TRANS DESCRIPTION')
     A            PATYPE    R               REFFLD(FLAG)
     A                                      COLHDG('RECORD' 'TYPE')
     A            PATDES    R               REFFLD(DS20)
     A                                      COLHDG('TYPE' 'DESC')
     A            PARECD    R               REFFLD(CODE)
     A                                      COLHDG('RESERVE' 'CODE')
     A            PAREDS    R               REFFLD(DS30)
     A                                      COLHDG('RSV DESCRIPTION')
     A            PARETP    R               REFFLD(FLAG)
     A                                      COLHDG('RESERVE' 'TYPE')
     A            PADESC    R               REFFLD(DS30)
     A            PAPGTP    R               REFFLD(FLAG)
     A                                      COLHDG('CHECK TYPE' 'GROUP/+
     A                                            NON-GROUP')
     A            PAEOB#         9S 0       COLHDG('EOMB#')
     A            PAACCT    R               REFFLD(DS20)
     A                                      COLHDG('BANK ACCT' 'NUMBER')
     A            PAOFF#         5S 0       COLHDG('OFFICE#')
     A            PAONAM        40          COLHDG('OFFICE NAME')
     A            PARCVD    R               REFFLD(DT8)
     A                                      COLHDG('DATE' 'RECEIVED')
     A            PADUE     R               REFFLD(DT8)
     A                                      COLHDG('DUE' 'DATE')
     A            PALTCD    R               REFFLD(CODE)
     A                                      COLHDG('PMT LATE' 'CODE')
     A            PARQST    R               REFFLD(DS10)
     A                                      COLHDG('INITIAL REQUESTOR')
     A            PAFNAL    R               REFFLD(FLAG)
     A                                      COLHDG('FINAL COMP PMT Y/N')
     A            PARADJ    R               REFFLD(FLAG)
     A                                      COLHDG('RECOVERY ADJ' ' FLAG Y/N')
     A            PAEMP#         9S 0       COLHDG('EMPLR#')
     A            PADIV          5S 0       COLHDG('DIV')
     A            PAENAM        40          COLHDG('EMPLR NAME')
     A            PARGN#         3S 0       COLHDG('RGN#')
     A            PARDES        40          COLHDG('REGION' 'DESC')
     A            PAACL#    R               REFFLD(DS25)
     A                                      COLHDG('STATE CLAIM#')
     A            PACTG1    R               REFFLD(DS10)
     A                                      COLHDG('CATEGORY 1' 'LOCATION')
     A            PALNAM    R               REFFLD(DS40)
     A                                      COLHDG('LOCATION' 'NAME')
     A            PACTG2    R               REFFLD(DS10)
     A                                      COLHDG('CATEGORY 2')
     A            PADEPT    R               REFFLD(DS10)
     A                                      COLHDG('DEPARTMENT')
     A            PADDES        40          COLHDG('DEPT DESC')
