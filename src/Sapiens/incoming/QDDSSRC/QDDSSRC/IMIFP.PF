     A**
     A** INCOMING FAX MESSAGES FROM DATA QUEUE ***
     A**
     A*
     A          R PIF01                     TEXT('INCOMING FAX FILE')
     A            IFLFM         30A         TEXT('LIB/OF INC. FAX')
     A                                      COLHDG('LIBRARY')
     A            IF#PGS         5A         TEXT('# OF PAGES')
     A                                      COLHDG('NBR OF PAGES')
     A            IFTSI         20A         TEXT('SENDERS TSI')
     A                                      COLHDG('SENDING PRTIES TSI')
     A            IFCSTS         1A         TEXT('COMPLETION STATUS')
     A                                      COLHDG('COMPL. STATUS S/U')
     A            IFCNAM         8A         TEXT('CNTRLR NAME ')
     A                                      COLHDG('CNTRLR NAME(FAXD01)')
     A            IFPORT         4A         TEXT('PORT OR FAX CRD RECVD ON')
     A                                      COLHDG('PORT FAX CRD')
     A            IFRDAT         6A         TEXT('RECEIVED DATE')
     A                                      COLHDG('RECEIVED DATE')
     A            IFRTIM         6A         TEXT('RECEIVED TIME')
     A                                      COLHDG('RECEIVED TIME')
     A            IFLIBN        10A         TEXT('LIB OF FAX MBR  ')
     A                                      COLHDG('FX MBR LIB')
     A            IFDBFN        10A         TEXT('DATA BASE FILE FX MBR NAME')
     A                                      COLHDG('FX MBR FILE NAME')
     A            IFMBRN        10A         TEXT('MEMBER NAME')
     A                                      COLHDG('MBR NAME')
     A            IFSTS          8A         TEXT('DESCRIPTIVE STATUS')
     A                                      COLHDG('STATUS DESCRIPTION')
     A            IFDCID        12A         TEXT('FAX DOC ID')
     A            IFFOLD        63A         TEXT('FAX FOLDER ID')
     A            IFDKEY        40A         TEXT('DARTS KEY')
     A*
     A            IFSTAT         1A
     A            IFUSER        10A
     A            IFPGM         10A
     A            IFTIME         6S 0
     A            IFDT           7P 0
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            IFIUSR        10A
     A                                      COLHDG('RECORD CREATED BY')
     A****************************************************************
     A            IFDESC        40A         TEXT('FAX DESCRIPTION')
     A            IFRDT8         8S 0       TEXT('RECEIVED DT YYYYMMDD')
     A                                      COLHDG('RECEIVED DT YYYYMMDD')
     A            IFRTM          6S 0       TEXT('RECEIVED TIME(NUMERIC)')
     A                                      COLHDG('RECEIVED TIME(NUM)')
                  IFROUT        10A         TEXT('ROUTING INFO')
     A                                      COLHDG('ROUTING INFO')
