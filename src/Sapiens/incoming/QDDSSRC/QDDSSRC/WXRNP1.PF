     A****************************************************************
     A          R RN001                     TEXT('Renewal Reminder'  )
     A            RNXML         60A         COLHDG('       ' 'XML Key'   )
     A            RNCO#          3S 0       COLHDG('Company' 'Number'    )
     A            RNFND          3S 0       COLHDG('Group'  'Number'     )
     A            RNEMP#         9S 0       COLHDG('Employer' 'Number'   )
     A            RNDIV          5S 0       COLHDG('        ' 'Division' )
     A            RNFYR          3S 0       COLHDG('Policy' 'Year'       )
     A            RNPFDT         8S 0       COLHDG('Policy' 'From Date'  )
     A            RNPTDT         8S 0       COLHDG('Policy' 'To Date'    )
     A            RNDATE         8S 0       COLHDG('Balance/Run' 'Date'  )
     A            RNDUED         8S 0       COLHDG('Due Date'            )
     A            RNBAL         11S 0       COLHDG('A/R Balance'         )
     A
     A            RNUSER        10A         COLHDG('User' 'Maintained'   )
     A            RNPGM         10A         COLHDG('Program' 'Maintained')
     A            RNTIME         6S 0       COLHDG('Time' 'Maintained'   )
     A            RNDT           8S 0       COLHDG('Date' 'Maintained'   )
     A            RNIUSR        10A         COLHDG('Initial' 'User'      )
     A            RNIPGM        10A         COLHDG('Initial' 'Program'   )
     A            RNITIM         6S 0       COLHDG('Initial' 'Time'      )
     A            RNIDT          8S 0       COLHDG('Initial' 'Date'      )
     A
