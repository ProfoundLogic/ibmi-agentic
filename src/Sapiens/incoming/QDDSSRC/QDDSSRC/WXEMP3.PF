     A*
     A*  EDI 816 File - Employer Master
     A*
     A          R PXM01                     TEXT('EDI 816 Format-Emplr Master')
     A            XMTRTP         2A         COLHDG('TRANSACTION' 'TYPE' '= EM')
     A            XMPOL#         8A         COLHDG('12 - POLICY #')
     A            XMBEXT         3A         COLHDG('12 - EXT #')
     A            XMFDNM        40A         COLHDG('11 - EMPLOYER NAME')
     A            XMDBA         40A         COLHDG('07 - DBA NAME')
     A            XMFEIN         9A         COLHDG('08 - EMPLOYER' 'FED ID #')
     A            XMEFDT         8A         COLHDG('03 - EFFECTIVE' 'DATE')
     A            XMCXDT         8A         COLHDG('18 - EXPIRATION' 'DATE')
     A            XMDTAS         8A         COLHDG('02 - DATE' 'ASSIGNED')
     A            XMACT          1A         COLHDG('   - ACTIVITY' 'INDICATOR')
     A            XMACTN         1A         COLHDG('01 - ACTION' 'CODE')
     A            XMMNTN         3A         COLHDG('19 - MAINT' 'TYPE CODE')
     A            XMMAD1        40A         COLHDG('09 - MAILING' 'ADDRESS 1')
     A            XMMAD2        40A         COLHDG('10 - MAILING' 'ADDRESS 2')
     A            XMMCTY        25A         COLHDG('04 - MAILING CITY')
     A            XMMST          2A         COLHDG('14 - MAILING' 'STATE')
     A            XMMZIP         9A         COLHDG('17 - MAILING' 'ZIP')
     A            XMCONT        40A         COLHDG('05 - CONTACT')
     A            XMAREA         3A         COLHDG('06 - AREA' 'CODE')
     A            XMPHN#         7A         COLHDG('06 - PHONE #')
     A            XMSTS          1A         COLHDG('15 - EMPLOYER' 'STATUS')
     A            XMSTDT         8A         COLHDG('16 - STATUS DATE')
     A            XMMCO#        20A         COLHDG('20 - MCO ID #')
     A            XMMCO         10A         COLHDG('21 - MCO NAME')
     A            XMOMCO        20A         COLHDG('23 - OLD MCO ID #')
     A            XMCNTY         2A         COLHDG('24 - COUNTY' 'CODE')
     A            XMSLCT         1A         COLHDG('25 - SLCTN' 'MTHD')
     A            XMSIC          4A         COLHDG('   - SIC CODE')
     A            XMSRVC        40A         COLHDG('26 - SERVICE COMPANY')
     A            XMPROC         1A         COLHDG('PROCESSED')
     A            XMTRN#         5  0       COLHDG('TRANSACTION #')
     A*
     A          K XMPOL#
     A          K XMBEXT
     A          K XMTRN#
