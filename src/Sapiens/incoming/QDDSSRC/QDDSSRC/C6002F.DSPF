     A                                      DSPATR(HI)
     A N90                                  DSPATR(ND)
     A                                  8 65'Date:'
     A N90                                  DSPATR(ND)
     A            SCSDT     R        O  8 71REFFLD(DT8)
     A                                      DSPATR(HI)
     A                                      EDTWRD('  /  /    ')
     A N90                                  DSPATR(ND)
     A                                 10  6'Weekly :'
     A            SCWKLY    R        B 10 15REFFLD(FLAG)
     A                                      TEXT('FLAG')
     A                                      OVRDTA
     A  25                                  ERRMSGID(CCR0513 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A            SCFWDT    R        B 10 17REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  23                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  26                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 10 26'to'
     A            SCTWDT    R        B 10 29REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  24                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  26                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 10 38'Submitting job:'
     A N90                                  DSPATR(ND)
