     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A                                      TEXT('DATE')
     A  20                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                  8 21'Co#'
     A N90                                  DSPATR(ND)
