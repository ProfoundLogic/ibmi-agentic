     A                                      TEXT('FLAG')
     A                                      OVRDTA
     A  21                                  ERRMSGID(CCR0513 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A            SCFMDT    R        B 12 17REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  27                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  29                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 12 26'to'
     A            SCTMDT    R        B 12 29REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  28                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  29                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 12 38'Current job step:'
     A N90                                  DSPATR(ND)
     A            SCTAG     R        O 12 57REFFLD(TAG)
     A                                      DSPATR(HI)
     A N90                                  DSPATR(ND)
     A                                 14  6'Yearly :'
     A            SCYEAR    R        B 14 15REFFLD(FLAG)
     A                                      TEXT('FLAG')
     A                                      OVRDTA
     A  22                                  ERRMSGID(CCR0507 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A            SCFYDT    R        B 14 17REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  30                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  32                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 14 26'to'
     A            SCTYDT    R        B 14 29REFFLD(DT8)
     A                                      CHECK(RB)
     A                                      EDTWRD('  /  /    ')
     A                                      OVRDTA
     A  31                                  ERRMSGID(CCR0502 *LIBL/CMESGG)
     A  32                                  ERRMSGID(CCR0570 *LIBL/CMESGG)
     A  90                                  DSPATR(HI)
     A  90                                  DSPATR(PR)
     A                                 15  8'Press enter to re-submit the job w-
     A                                      ith the current attributes'
     A                                      DSPATR(HI)
     A N90                                  DSPATR(ND)
     A                                 17  6'Key the execution date for the dai-
     A                                      ly batch process. Then indicate'
     A                                 18  6'whether this is a Weekly, Monthly,-
     A                                       or Yearly execution, and press'
     A                                 19  6'ENTER to submit the job.'
     A                                 23  6'F3=Exit      '
     A                                      COLOR(BLU)
     A                                 23 29'F13=Change user parms'
     A                                      COLOR(BLU)
