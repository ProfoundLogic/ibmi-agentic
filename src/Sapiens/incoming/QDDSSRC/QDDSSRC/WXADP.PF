      *  02/17/25 C:340 PROJECT: WC3001                               *
      *                 Add Group Field.                              *
      *                                                               *
      *  05/04/17 C:136 PROJECT: WC2479                               *
      *                 CONVERT TO COMPSUITE (CHANGE ALL FIELDS TO    *
      *                 CHARS)                                        *
      *                                                               *
      *===============================================================*
     A                                      REF(WREFP)
     A          R PAD01                     TEXT('AUDIT PAYROLL UPLOAD')
     A            ADRECT         1A         COLHDG('REC TYPE')
     A            ADRCNT        11A         COLHDG('REC COUNT')
     A            ADEMPLINK     15A
     A            ADJRST         2A
     A            ADCAP#    R               REFFLD(DS25)
     A                                      COLHDG('CARR' 'POL#')
     A            ADEMP#    R     A         REFFLD(EMP#)
     A            ADDIV     R     A         REFFLD(DIV)
     A            ADFYR     R     A         REFFLD(FYR)
     A            ADCLAS    R     A         REFFLD(CLAS)
     A            ADSPEC    R               REFFLD(FLAG)
     A                                      COLHDG('SPEC')
     A            ADEXT     R               REFFLD(CLA2)
     A                                      COLHDG('CLASS DESC' 'EXTENSION')
     A            ADEFDT        10A         COLHDG('EFF' 'DATE')
     A            ADCXDT        10A         COLHDG('CX' 'DATE')
     A            ADAMT     R     A         REFFLD(A112)
     A                                      COLHDG('AUDIT' 'AMT')
     A            ADACNT    R     A         REFFLD(DT)
     A                                      COLHDG('AUDIT' 'EMP CNT')
     A*** Beg Add *** 02/17/25 *** WC3001 ******************************
     A            ADFND          3A         COLHDG('FUND')
     A*** End Add *** 02/17/25 *** WC3001 ******************************
