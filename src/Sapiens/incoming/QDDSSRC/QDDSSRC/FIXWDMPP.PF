      * REVISIONS:                                                    *
      *                                                               *
      * 12/24/24 C:300 Support: 118189 (SUNZ)                         *
      *                V24 update appears to have cleared data in WDMPP
      *                and WDEHP                                      *
      *                                                               *
      *****************************************************************
     A                                      REF(WREFP)
     A          R PXM01                     TEXT('FIXWDMPP OUTFILE')
     A            XMCO#     R               REFFLD(CO#)
     A            XMFND     R               REFFLD(FND)
     A            XMEMP#    R               REFFLD(EMP#)
     A            XMDIV     R               REFFLD(DIV)
     A            XMFYR     R               REFFLD(FYR)
     A            XMDT      R               REFFLD(DT)
     A                                      COLHDG('Date' 'Maintained')
     A*** ANNUAL PREMIUM from WDMPP
     A            XMANPR    R               REFFLD(A112)
     A                                      COLHDG('MP EST ANNUAL PREM')
     A            XMAAPR    R               REFFLD(A112)
     A                                      COLHDG('MP AUD ANNUAL PREM')
     A*** MINIMUM PREMIUM from WDMPP
     A            XMEBAL    R     S         REFFLD(A112)
     A                                      COLHDG('EST BALANCE TO MIN')
     A            XMABAL    R     S         REFFLD(A112)
     A                                      COLHDG('AUD BALANCE TO MIN')
     A*** Fields from WDELP
     A            XMFAF     R               REFFLD(FLAG)
     A                                      COLHDG('FINAL AUD. FLAG')
     A            XMEMNP    R               REFFLD(FLAG)
     A                                      COLHDG('EST MINIMUM PREM')
     A            XMAMNP    R               REFFLD(FLAG)
     A                                      COLHDG('AUD MINIMUM PREM')
     A            XMMAPR    R               REFFLD(A112)
     A                                      COLHDG('EL EST' 'MANUAL PREMIUM')
     A            XMAMPR    R               REFFLD(A112)
     A                                      COLHDG('EL AUDIT' 'MANUAL PREMIUM')
     A            XM1APR    R               REFFLD(A112)
     A                                      COLHDG('1ST ASSESSMENT PREM')
     A            XMEMNA    R               REFFLD(A112)
     A                                      COLHDG('EL EST MIN PREM AMT')
     A            XMAMNA    R               REFFLD(A112)
     A                                      COLHDG('EL AUD MIN PREM AMT')
     A*** NEW MINIMUM PREMIUM
     A            XMEBAL2   R     S         REFFLD(A112)
     A                                      COLHDG('NEW EST' 'BALANCE TO MIN')
     A            XMABAL2   R     S         REFFLD(A112)
     A                                      COLHDG('NEW AUD' 'BALANCE TO MIN')
