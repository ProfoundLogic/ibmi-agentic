     A                                      REF(FSREFP)
     A          R PFALIN                    TEXT('Bill Imp Svc Lin Holdng File')
      *
      * StoneRiver process fields
      *
     A            LINPRFL   R               REFFLD(FLAG)
     A                                      COLHDG('Process Flag')
      *
      * StoneRiver Key fields
      *
     A            LINCO#    R     S         REFFLD(CO#)
     A            LINSUB#   R     S         REFFLD(SUB#)
     A            LINFND    R     S         REFFLD(FND)
     A            LINFYR    R     S         REFFLD(FYR)
     A            LINCASE   R     S         REFFLD(CASE)
     A            LINEOB#   R     S         REFFLD(EOB#)
     A            LINRCN    R     S         REFFLD(RCN)
     A            LINDSEQ   R     S         REFFLD(SEQ#)
      *
      * Control information
      *
     A            LINUNID      100A         COLHDG('Unique Id')
     A            LINICNTL       9A         COLHDG('Interchg' 'Ctl Number')
     A            LINGCTL        9A         COLHDG('Group' 'Control' 'Number')
     A            LINTSCNTL      9A         COLHDG('TS Ctl Nbr' 'From' 'TS Hdr')
     A            LINBHTTID     50A         COLHDG('TS Id' 'From' 'BHT')
      *
      * Professional Service
      *
     A            LINPACCT      38A         COLHDG('Patient' 'Account' 'Number')
     A            LINQU          2A         COLHDG('Product-Svc Id' 'Qualifier')
     A            LINCODE       48A         COLHDG('Procedure' 'Code')
     A            LINMOD1        2A         COLHDG('Procedure' 'Modifier')
     A            LINMOD2        2A         COLHDG('Procedure' 'Modifier')
     A            LINMOD3        2A         COLHDG('Procedure' 'Modifier')
     A            LINMOD4        2A         COLHDG('Procedure' 'Modifier')
     A            LINDESC       80A         COLHDG('Description')
     A            LINCHRG       18A         COLHDG('Line Item' 'Charge Amount')
     A            LINUNBAS       2A         COLHDG('Unt-Basis' 'Measurmnt Code')
     A            LINSVCUNIT    15A         COLHDG('Service' 'Unit Count')
     A            LINPOS         2A         COLHDG('Place of' 'Service')
     A            LINSVTYCD      2A         COLHDG('Service' 'Type Code')
     A            LINDGPTR1      2A         COLHDG('Diagnostic' 'Code Pointer')
     A            LINDGPTR2      2A         COLHDG('Diagnostic' 'Code Pointer')
     A            LINDGPTR3      2A         COLHDG('Diagnostic' 'Code Pointer')
     A            LINDGPTR4      2A         COLHDG('Diagnostic' 'Code Pointer')
      *
      * Service Date
      *
     A            LINDTQ         3A         COLHDG('Date Time' 'Qualifier   r')
     A            LINTFQ         3A         COLHDG('DT-Tim' 'Per-Fmt Qualifier')
     A            LINSVDT       35A         COLHDG('Service' 'Date')
      *
      * Contract Information
      *
     A            LINCTTYCD1     2A         COLHDG('Contract' 'Type'  'Code')
     A            LINCTTYCD2    50A         COLHDG('Contract' 'Code')
      *
      * Line Item Control Number
      *
     A            LINCTLRID      2A         COLHDG('Reference Id' 'Qualifier')
     A            LINLICTL#     50A         COLHDG('Line Item' 'Control Number')
      *
      * Drug Identification
      *
     A            LINDRGIDQU     2A         COLHDG('Prod-Svc Id' 'Qualifier')
     A            LINDRGNDC     48A         COLHDG('National' 'Drug Code')
      *
      * Drug Pricing
      *
     A            LINDRGUNIT    15A         COLHDG('National' 'Drug Unit Count')
     A            LINDRGUNBS     2A         COLHDG('Unit-Basis' 'Measrmnt Code')
      *
      * Prescription or Compound Drug
      *
     A            LINPRRIDQU     3A         COLHDG('Reference' 'Id Number' )
     A            LINPR#        50A         COLHDG('Prescription' 'Number')
      *
      * Rendering Provider Name
      *
     A            LINRNENCD      3A         COLHDG('Entity Id' 'Code')
     A            LINRNENQU      1A         COLHDG('Entity Type' 'Qualifier')
     A            LINRNNM       60A         COLHDG('Rend Provider' 'Last Name')
     A            LINRNFNM      35A         COLHDG('Rend Provider' 'First Name')
     A            LINRNMNM      25A         COLHDG('Rend Provider' 'Middl Name')
     A            LINRNPNM      10A         COLHDG('Rend Provider' 'Name Prfx')
     A            LINRNSNM      10A         COLHDG('Rend Provider' 'Name Suffx')
     A            LINRNIDQU      2A         COLHDG('Id Code' 'Qualifier')
     A            LINRNNMID     80A         COLHDG('Rend Provider' 'Id')
      *
      * Rendering Provider Specialty Information
      *
     A            LINRNSCODE     3A         COLHDG('Provider Code')
     A            LINRNSPQU      3A         COLHDG('Reference Id' 'Qualifier')
     A            LINRNSPID     50A         COLHDG('Provider' 'Taxonomy Code')
      *
      * Rendering Provider Secondary Information
      *
     A            LINRN2UPQU     3A         COLHDG('Reference Id' 'Qualifier')
     A            LINRN2UPID    50A         COLHDG('Rend Provider' 'Secndry Id')
     A            LINRNUPQU      3A         COLHDG('Reference Id' 'Qualifier')
     A            LINRNUPID     50A         COLHDG('Other Payer' 'Primary Id')
      *
      * Service Facility Location Name
      *
     A            LINSFNMID      3A         COLHDG('Entity Id' 'Code')
     A            LINSFNMQU      1A         COLHDG('Entity Type' 'Qualifier')
     A            LINSFPRNM     60A         COLHDG('Name Last' 'Org Name')
     A            LINSFIDQU      2A         COLHDG('Id Code' 'Qualifier')
     A            LINSFOTHID    80A         COLHDG('Other Payer' 'Primary Id')
      *
      * Service Facility Location Address
      *
     A            LINSFADR1     55A         COLHDG('Lab-Facility' 'Addr Line 1')
     A            LINSFADR2     55A         COLHDG('Lab-Facility' 'Addr Line 2')
      *
      * Service Facility Location City/State/Zip
      *
     A            LINSFCTY      30A         COLHDG('Lab-Facility' 'City')
     A            LINSFST        2A         COLHDG('Lab-Facility' 'State')
     A            LINSFPOST     15A         COLHDG('Lab-Facility' 'Country')
     A            LINSFCNTRY     3A         COLHDG('Lab-Facility' 'Country')
      *
      * Service Facility Secondary Identification
      *
     A            LINSF2NDQU     3A         COLHDG('Reference Id' 'Qualifier')
     A            LINSF2NDID    50A         COLHDG('Lab-Facility' 'Loc 2nd Id')
      *
      * Ordering Provider Name
      *
     A            LINORENICD     3A         COLHDG('Entity Id' 'Code')
     A            LINORENQU      1A         COLHDG('Entity Type' 'Qualifier')
     A            LINORNM       60A         COLHDG('Ordering Prvdr' 'Last Name')
     A            LINORFNM      35A         COLHDG('Ordering Prvdr' 'First Nam')
     A            LINORMNM      25A         COLHDG('Ordering Prvdr' 'Midl Name')
      *
      * Ordering Provider Address
      *
     A            LINORADR1     55A         COLHDG('Ordering Prvdr' 'Addr Line')
     A            LINORADR2     55A         COLHDG('Ordering Prvdr' 'Addr Line')
      *
      * Ordering Provider City/State/Zip
      *
     A            LINORCTY      30A         COLHDG('Ordering Prvdr' 'City')
     A            LINORST        2A         COLHDG('Ordering Prvdr' 'State')
     A            LINORPOST     15A         COLHDG('Ordering Prvdr' 'Zip Code')
     A            LINORCNTRY     3A         COLHDG('Ordering Prvdr' 'Country')
      *
      * Ordering Provider Secondary Identification
      *
     A            LINOR2IDQU     3A         COLHDG('Reference Id' 'Qualifier')
     A            LINOR2ID      50A         COLHDG('Ordering Prvdr' 'Scndry Id')
      *
      * Referring Provider Name
      *
     A            LINRPENICD     3A         COLHDG('Entity Id' 'Code')
     A            LINRPENQU      1A         COLHDG('Entity Type' 'Qualifier')
     A            LINRPNM       60A         COLHDG('Ordering Prvdr' 'Last Name')
     A            LINRPFNM      35A         COLHDG('Ordering Prvdr' 'First Nam')
     A            LINRPMNM      25A         COLHDG('Ordering Prvdr' 'Midl Name')
     A            LINRPIDQU      2A         COLHDG('Id Code' 'Qualifier')
     A            LINRPOTHID    80A         COLHDG('Other Payer' 'Primary Id')
      *
      * Referring Provider Secondary ID.
      *
     A            LINRP2NIQ      3A         COLHDG('Ref Id' 'Qualifier')
     A            LINRP2NID     50A         COLHDG('Referring' 'Prov 2nd Id')
     A            LINRP2NIDQ     3A         COLHDG('Ref Id' 'Qualifier')
     A            LINRP2OPPI    50A         COLHDG('Other Payer' 'Primary Id')
      *
      * Institutional Service Line
      *
     A            LINLIN#        6A         COLHDG('Assigned' 'Number')
     A            LINRVCD       48A         COLHDG('Revenue' 'Code')
      *
      * Operating Physician Name
      *
     A            LINOPPIDCD     3A         COLHDG('Entity Id' 'Code')
     A            LINOPPENQU     1A         COLHDG('Entity Type' 'Qualifier')
     A            LINOPPNM      60A         COLHDG('Oper Physician' 'Last Name')
     A            LINOPPFNM     35A         COLHDG('Oper Physician' 'Frst Name')
     A            LINOPPMNM     25A         COLHDG('Oper Physician' 'Midl Name')
     A            LINOPPPNM     10A         COLHDG('Oper Physician' 'Name Prfx')
     A            LINOPPSNM     10A         COLHDG('Oper Physician' 'Name Sufx')
     A            LINOPPIDQU     2A         COLHDG('Id Code' 'Qualifier')
     A            LINOPPNMID    80A         COLHDG('Identifier')
      *
      * Operating Physician Secondary Identification
      * 2NDQA changed to 2NDQU for consistency
      *
     A            LINOP2NDQU     3A         COLHDG('Ref Identification' 'Qual')
     A            LINOP2NDID    50A         COLHDG('Secondary' 'Identifier')
     A            LINOP2INQ      3A         COLHDG('Ref Identifier' 'Qualifier')
     A            LINOP2ID      50A         COLHDG('Identifier')
      *
      * Other Operating Physician Name
      *
     A            LINOOPIDCD     3A         COLHDG('Entity Id' 'Code')
     A            LINOOPENQU     1A         COLHDG('Entity Type' 'Qualifier')
     A            LINOOPNM      60A         COLHDG('Othr Physician' 'Last Name')
     A            LINOOPFNM     35A         COLHDG('Othr Physician' 'Frst Name')
     A            LINOOPMNM     25A         COLHDG('Othr Physician' 'Midl Name')
     A            LINOOPPNM     10A         COLHDG('Othr Physician' 'Name Prfx')
     A            LINOOPSNM     10A         COLHDG('Othr Physician' 'Name Sufx')
     A            LINOOPIDQU     2A         COLHDG('Id Code' 'Qualifier')
     A            LINOOPNMID    80A         COLHDG('Identifier')
      *
      * Other Operating Physician Secondary Identification
     A            LINOOP2NQU     3A         COLHDG('Ref Identification' 'Qual')
     A            LINOOP2NID    50A         COLHDG('Secondary' 'Identifier')
     A            LINOOP2IQU     3A         COLHDG('Ref Identifier' 'Qualifier')
     A            LINOOP2ID     50A         COLHDG('Identifier')
      *
      *  Additional processing key information
      *
     A            LININSID      15A         COLHDG('Interchg' 'Sender Id')
     A            LINPASFX       3  0       COLHDG('Patient' 'Account' 'Suffix')
