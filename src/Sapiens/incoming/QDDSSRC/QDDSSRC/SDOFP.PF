     A*
     A*  Option/Function Special Authority
     A*
     A*****************************************************************
     A*  Revisions:                                                   *
     A*                                                               *
     A*  10/31/12 C:191  PROJECT TRANSFORM                            *
     A*                  ADD MULTIPLE SECURITY LEVELS                 *
     A*                                                               *
     A*  01/12/11 C:235  PROJECT WC1795                               *
     A*                  MAKE SECURITY LEVEL DIFF IN QUOTE/LIVE       *
     A*                                                               *
     A*  11/01/00 C:33 PROJECT: SY043                                 *
     A*                ADDED SEQ#                                     *
     A*                                                               *
     A*  04/02/97 C:69 Project SY018                                  *
     A*                Created file                                   *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SREFP)
     A          R POF01                     TEXT('Option/Function Special +
     A                                      Authority')
     A            OFPGID    R               REFFLD(PGM)
     A                                      COLHDG('Program' 'ID')
     A            OFTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('1=Option' 'or' '2=Function')
     A            OFNBR     R               REFFLD(A20)
     A                                      COLHDG('Option /' 'function' +
     A                                      'number')
     A            OFLVL     R               REFFLD(A30)
     A                                      COLHDG('Minimum' 'security' 'level')
     A            OFTY01    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 1')
     A            OFTY02    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 2')
     A            OFTY03    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 3')
     A            OFTY04    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 4')
     A            OFTY05    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 5')
     A            OFTY06    R               REFFLD(FLAG)
     A                                      COLHDG('Security' 'type 6')
     A            OFSTAT    R               REFFLD(STAT)
     A                                      COLHDG('Record' 'status')
     A            OFIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial' 'maintained' +
     A                                      'program')
     A            OFIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial' 'maintained' +
     A                                      'user')
     A            OFIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial' 'maintained' +
     A                                      'date')
     A            OFITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial' 'maintained' +
     A                                      'time')
     A            OFPGM     R               REFFLD(PGM)
     A                                      COLHDG('Last' 'maintained' +
     A                                      'program')
     A            OFUSER    R               REFFLD(USER)
     A                                      COLHDG('Last' 'maintained' 'user')
     A            OFDT      R               REFFLD(DT)
     A                                      COLHDG('Last' 'maintained' 'date')
     A            OFTIME    R               REFFLD(TIME)
     A                                      COLHDG('Last' 'maintained' 'time')
     A***  BEGIN ADD  ***  11/01/00  *********************************
     A            OFSEQ#    R               REFFLD(SEQ#)
     A***  END   ADD  ***  11/01/00  *********************************
     A***  BEG   ADD  ***  01/12/11  *********************************
     A            OFQTLV    R               REFFLD(FLAG)
     A                                      COLHDG('Quote/Live')
     A***  END   ADD  ***  01/12/11  *********************************
     A***  BEG   ADD  ***  10/31/12  *********************************
     A            OFLV02    R               REFFLD(A30)
     A                                      COLHDG('MINIMUM' 'SECURITY' 'LVL 2')
     A            OFLV03    R               REFFLD(A30)
     A                                      COLHDG('MINIMUM' 'SECURITY' 'LVL 3')
     A            OFLV04    R               REFFLD(A30)
     A                                      COLHDG('MINIMUM' 'SECURITY' 'LVL 4')
     A            OFLV05    R               REFFLD(A30)
     A                                      COLHDG('MINIMUM' 'SECURITY' 'LVL 5')
     A            OFLV06    R               REFFLD(A30)
     A                                      COLHDG('MINIMUM' 'SECURITY' 'LVL 6')
     A***  END   ADD  ***  10/31/12  *********************************
