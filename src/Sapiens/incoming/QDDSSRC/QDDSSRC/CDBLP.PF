     A* * * BILLING TRANSACTION FILE * * *
     A*
     A                                      REF(CSREFP)
     A          R PBL01                     TEXT('BILLING TRANSACTION FILE')
     A            BLCLT#    R               REFFLD(CLT#)
     A                                      COLHDG('CLIENT' 'NUMBER')
     A            BLSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('UNIQUE' 'SEQUENCE' 'NUMBER')
     A*** CLIENT SEARCH INFORMATION ***
     A******** NUMBER (#) OF SEARCHES *****
     A            BL#M      R               REFFLD(A50)
     A                                      COLHDG('MAIL' 'SEARCHES')
     A            BL#T      R               REFFLD(A50)
     A                                      COLHDG('TELEPHONE' 'SEARCHES')
     A            BL#F      R               REFFLD(A50)
     A                                      COLHDG('FAX' 'SEARCHES')
     A            BLSRDT    R               REFFLD(DT)
     A                                      COLHDG('SEARCH' 'DATE')
     A*** MISC. INFORMATION ***
     A            BLFLG1    R               REFFLD(FLAG)
     A                                      TEXT('FLAG 1 NOT USED YET')
     A            BLFLG2    R               REFFLD(FLAG)
     A                                      TEXT('FLAG 2 NOT USED YET')
     A            BLFLG3    R               REFFLD(FLAG)
     A                                      TEXT('FLAG 3 NOT USED YET')
     A            BLFLG4    R               REFFLD(FLAG)
     A                                      TEXT('FLAG 4 NOT USED YET')
     A            BLFLG5    R               REFFLD(FLAG)
     A                                      TEXT('FLAG 5 NOT USED YET')
     A            BLDT1     R               REFFLD(DT)
     A                                      TEXT('DATE 1 NOT USED YET')
     A            BLDT2     R               REFFLD(DT)
     A                                      TEXT('DATE 2 NOT USED YET')
     A            BLAMT1    R               REFFLD(A92)
     A                                      TEXT('AMT 1 NOT USED YET')
     A            BLAMT2    R               REFFLD(A92)
     A                                      TEXT('AMT 2 NOT USED YET')
     A*** MAINTENANCE INFORMATION ***
     A            BLSTAT    R               REFFLD(STAT)
     A            BLUSER    R               REFFLD(USER)
     A                                      COLHDG('RECORD' 'MAINTAINED BY')
     A            BLPGM     R               REFFLD(PGM)
     A                                      COLHDG('PGM' 'MAINTAINED' 'IN')
     A            BLTIME    R               REFFLD(TIME)
     A                                      COLHDG('TIME' 'MAINTAINED')
     A            BLDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            BLIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD' 'CREATED BY')
     A            BLIDT     R               REFFLD(DT)
     A                                      COLHDG('DATE' 'CREATED')
     A*
