     A*
     A*  - EPS Claim (Bill Detail) File               C:62 06/27/00
     A*                                               PROJ: 25MIC
     A*****************************************************************
     A* REVISIONS
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PM201                     TEXT('EPS Claim Detail File')
     A            M2RX#     R               REFFLD(DS7)
     A                                      COLHDG('Prescription' +
     A                                      'Number')
     A            M2DOS     R               REFFLD(DS8)
     A                                      COLHDG('Date Filled')
     A            M2NDC     R               REFFLD(NDC)
     A                                      COLHDG('NDC Description')
     A*   For Legend Compounds Use: 99999999999
     A*   Schedule II : 99999999992
     A*   Schedule III: 99999999993
     A*   Schedule IV : 99999999994
     A*   Schedule V  : 99999999995
     A*   Compounds   : 99999999992
     A*
     A            M2DESC    R               REFFLD(DS30)
     A                                      COLHDG('Drug Description')
     A            M2CODE    R               REFFLD(CODE)
     A                                      COLHDG('New/Refill Code')
     A*                                     00=New Presription
     A*                                     01-99=Number of Refills
     A*
     A            M2RXMQ    R               REFFLD(DS5)
     A                                      COLHDG('Metric Quantity')
     A            M2RXDY    R               REFFLD(DS3)
     A                                      COLHDG('Days Supply')
     A            M2CST1    R               REFFLD(DS2)
     A                                      COLHDG('Basis of Cost' +
     A                                      'Determination')
     A*                                     00=Not Specified
     A*                                     01=AWP
     A*                                     02=Local Wholesaler
     A*                                     03=Direct
     A*                                     04=EAC
     A*                                     05=Acquisition
     A*                                     06=MAC
     A*                                     6X=Brand Medically Necessary
     A*                                     07=Usual and Customary
     A*                                     08=Unit Dose
     A*                                     09=Other
     A*                                     Used on Tape and Diskette Only
     A*
     A            M2CST2    R               REFFLD(A62)
     A                                      COLHDG('Ingredient Cost')
     A            M2CST3    R               REFFLD(A62)
     A                                      COLHDG('Dispensing Fee' +
     A                                      'Submitted')
     A            M2CST4    R               REFFLD(A62)
     A                                      COLHDG('Co-Pay Amount')
     A            M2CST5    R               REFFLD(A62)
     A                                      COLHDG('Sales Tax')
     A            M2AMT     R               REFFLD(A62)
     A                                      COLHDG('Amount Billed')
     A            M2DIAG    R               REFFLD(DS6)
     A                                      COLHDG('Diagnosis Code')
     A            M2DTPW    R               REFFLD(DS8)
     A                                      COLHDG('Date Prescription' +
     A                                      'Written')
     A            M2DAWP    R               REFFLD(FLAG)
     A                                      COLHDG('Dispense as Written' +
     A                                      '(DAW)/Product' +
     A                                      'Selection Code')
     A*  0=No Product Selection Indicated
     A*  1=Substitution Not Allowed by Prescriber
     A*  2=Substitution Allowed - Patient Requested Product Dispensed
     A*  3=Substitution Allowed - Pharmacist Selected Product Dispensed
     A*  4=Substitution Allowed - Generic Drug Not in Stock
     A*  5=Substitution Allowed - Brand Drug Dispensed as a Generic
     A*  6=Override
     A*  7=Substitution Not Allowed - Brand Drug Mandated by Law
     A*  8=Substitution Allowed - Generic Drug Not Available in Marketplace
     A*  9=Other
     A*
     A            M2RXRF    R               REFFLD(CODE)
     A                                      COLHDG('Number of Refills' +
     A                                            'Authorized')
     A            M2PAMT    R               REFFLD(A42)
     A                                      COLHDG('Postage Amount' +
     A                                      'Claimed')
     A            M2UNDS    R               REFFLD(FLAG)
     A                                      COLHDG('Unit Dose Indicator')
     A*                                     0=Not Specified
     A*                                     1=Not Unit Dose
     A*                                     2=Manufacturer Unit Dose
     A*                                     3=Pharmacy Unit Dose
     A*
     A            M2OPAM    R               REFFLD(A62)
     A                                      COLHDG('Other Payor Amount')
     A            M2ACCT    R               REFFLD(DS15)
     A                                      COLHDG('Account#')
     A            M2INV#    R               REFFLD(DS10)
     A                                      COLHDG('Invoice#')
     A            M2TRN#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) Transaction#')
     A            M2EXT     R               REFFLD(RCN)
     A                                      COLHDG('(PDS) Trans Ext#')
