     A******  DARTS EXTRACT HISTORY FILE
     A***        THIS FILE HOLDS EACH SUBMISSION OF THE DARTS EXTRACT
     A***
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PEH01                     TEXT('EXTRACT HISTORY RCD ')
     A*** DATE AND TIME JOB ENTERED SYSTEM
     A            EHTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANS' 'DATE')
     A            EHTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANS' 'TIME')
     A*** FROM AND TO DATE FROM PROMPT
     A            EHFRDT    R    8S 0       REFFLD(DT8)
     A                                      COLHDG('FROMS' 'DATE')
     A            EHTODT    R    8S 0       REFFLD(DT8)
     A                                      COLHDG('TO  DATE')
     A**
     A            EHCLMF    R               REFFLD(FLAG)
     A                                      COLHDG('CLAIMS SELECTED')
     A**
     A            EHPOLF    R               REFFLD(FLAG)
     A                                      COLHDG('POLICY SELECTED')
     ***  PATHS THAT ARE BEING USED TO STORE RESULTS OF THE PROCESS
     ****
     A            EHCPTH       255A         COLHDG('CLAIMS PATH')
     A            EHPPTH       255A         COLHDG('POLICY PATH')
     ***
     A            EHGRP          3A         COLHDG('GROUP')
     ****
     *** STATUS FIELDS ***
     A            EHSTAT    R               REFFLD(STAT)
     A            EHIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            EHIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL DATE')
     A            EHITIM    R               REFFLD(TIME)
     A                                      COLHDG('INITIAL TIME')
     A            EHUSER    R               REFFLD(USER)
     A                                      COLHDG('LAST MAINT USR')
     A            EHPGM     R               REFFLD(PGM)
     A                                      COLHDG('JOB # PROCESSED')
     A            EHTIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST MAINT TIM')
     A            EHDT      R               REFFLD(DT)
     A                                      COLHDG('LAST MAIN DT')
     A*** BEGIN ADD *** 09/20/17 *************************************
     A            EHAGTF    R               REFFLD(FLAG)
     A                                      COLHDG('AGENCY SELECTED')
     A            EHAPTH       255A         COLHDG('AGENCY PATH')
     A*** END   ADD *** 09/20/17 *************************************
