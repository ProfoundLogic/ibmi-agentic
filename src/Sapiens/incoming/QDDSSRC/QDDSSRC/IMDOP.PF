     A*
     A**  DOCUMENT OBJECT FILE
     A*
     A****************************************************************
     A*  REVISIONS:                                                  *
     A*                                                              *
     A* 10/17/11 C:279 Project: SY195                                *
     A*               - Add DOUNCN and DOIFSP to retrieve the        *
     A*                correct document directory.                   *
     A*
     * 07/09/07 C:191 Project: 10IJI                                *
     *               - Add DORCVD to capture received date          *
     *                when scanning.                                *
     A*
     A****************************************************************
     A          R PDO01                     TEXT('DOCUMENT OBJECT FILE')
     A*
     A*
     A            DODCID        12          COLHDG('DOCUMENT ID')
     A            DOFLR          8          COLHDG('FOLDER NAME')
     A            DOSFLR        12          COLHDG('SUB-FOLDER')
     A            DOOSYS         1          COLHDG('OPTICAL SUBSYSTEM ID')
     A            DOLIBN        10          COLHDG('OPTICAL LIB NAME')
     A            DOOFLD         8          COLHDG('CURRNT OPTICAL FOLD' +
     A                                      'NAME')
     A            DOOSFL        12          COLHDG('CURRNT OPTICAL SUB-' +
     A                                      'FOLDER')
     A            DOODCI        12          COLHDG('OPTICAL DOC ID')
     A            DOARQS         4  0       COLHDG('ACTIVE REQESTS FOR ' +
     A                                      'THIS DOCUMENT')
     A            DODTYP         8          COLHDG('DOCUMENT TYPE')
     A            DOBYTD         5  1       COLHDG('BYTES IN THIS DOC')
     A            DOWSID         2          COLHDG('SCANNING WS ID')
     A            DOSDT          8  0       COLHDG('SCAN DATE')
     A            DOSTMD         6  0       COLHDG('SCAN TIME')
     A            DOSREP         8          COLHDG('SCANNING USR ID')
     A            DOBCHI        12          COLHDG('SCANNING BCH ID')
     A            DOPGS          4  0       COLHDG('# OF PAGES THIS DOC')
     A            DOAIFL         1          COLHDG('AUTO INDEX FLAG')
     A            DOOPTF         1          COLHDG('OPTICAL STORAGE FLAG')
     A            DOIDFX         1          COLHDG('DOCUMENT INDXD?')
     A            DOVOL1        10          COLHDG('OPTICAL VOLUME')
     A            DOVOL2        10          COLHDG('TAPE VOL ID 2')
     A            DOVOL3        10          COLHDG('TAPE VOL ID 3')
     A            DODKEY        40          COLHDG('DARTS KEY')
     A            DODSQ#         5  0       COLHDG('DARTS SEQ#')
     A*
     A***** LAST MAINT INFO  *****
     A*
     A            DOIUSR        10          TEXT('INIT USER')
     A            DOIPGM        10          TEXT('INIT PGM')
     A            DOITIM         6S 0       TEXT('INIT TIME')
     A            DOIDT          6S 0       TEXT('INIT DATE')
     A            DOLUSR        10          TEXT('USER LAST MAINT')
     A            DOLPGM        10          TEXT('LAST MAINT PGM')
     A            DOLTIM         6S 0       TEXT('LAST MAINT TIME')
     A            DOLDT          6S 0       TEXT('LAST MAINT DATE')
     A*
     A            DOFL01         1          COLHDG('IMAGE/FAX FLAG' +
     A                                      'F=FAX, " " OR' '"I" IS AN IMAGE')
     A            DOFL02         1          TEXT('REMOVED FROM DASD')
     A            DOFL03         1          TEXT('**FUTURE USE FLG 03 **')
     A            DOFL04         1          TEXT('**FUTURE USE FLG 04 **')
     A            DOFL05         1          TEXT('**FUTURE USE FLG 05 **')
     A            DOCHR5         5          TEXT('**FUTURE USE A5  01 **')
     A**
     A            DODSTS         2          TEXT('DOC STATUS')
     A*
     *** BEG ADD ******07/09/07 ***********************
     A            DORCVD         8S 0       TEXT('RECEIVED DATE')
      *                                     < YYYYMMDD format >
     *** END ADD ******07/09/07 ***********************
     A*
     A*** BEG ADD ******10/17/11 **************************************
     A            DOUNCN       255          TEXT('FULL UNC PATH')
     A            DOIFSP         1          TEXT('IFS FLAG - IS IN IFS')
     A*** END ADD ******10/17/11 **************************************
