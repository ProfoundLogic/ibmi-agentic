     A**   FL TAPE SUBMISSION  - EOB WORK FILE ***                   **
     A**                                                             **
     A*****************************************************************
     A** REVISIONS:
     A*  06/17/99 C:117 Project: FL021
     A*                 Adding fields EOCNTL & EOSBDT for the FL
     A*                 Tape Submission project
     A*
     A*  03/27/98 C:31  Project: MC145
     A*                 Yr 2000, RISC Developemnt
     A*
     A*  10/13/95 C:33  PROJECT# FL006
     A*                 ADD FIELDS EOEFID, EOEZIP, EONDIS, EOSYS
     A*****************************************************************
     A**
     A                                      REF(FSREFP)
     A          R PEO01                     TEXT('EOB WORK FILE')
     A            EOCO#     R               REFFLD(CO#)
     A            EOSUB#    R               REFFLD(SUB#)
     A            EOFND     R               REFFLD(FND)
     A            EOEMP#    R               REFFLD(EMP#)
     A            EOFYR     R               REFFLD(FYR)
     A            EOCASE    R               REFFLD(CASE)
     A            EOEOB#    R               REFFLD(EOB#) COLHDG('EOB# BE-4'+
     A                                      'PROCESSED')
     A            EOFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('PAYEE' 'FEDERAL' 'ID #')
     A            EOMOD     R               REFFLD(MOD)
     A            EOAMT     R               REFFLD(A92)
     A                                      COLHDG('RECOMMENDED' 'ALLOWANCE')
     A            EODIA1    R               REFFLD(DIA)
     A                                      TEXT('DIAGNOSTIC CODE 1')
     A            EODIA2    R               REFFLD(DIA)
     A                                      TEXT('DIAGNOSTIC CODE 2')
     A            EODIA3    R               REFFLD(DIA)
     A                                      TEXT('DIAGNOSTIC CODE 3')
     A            EODIA4    R               REFFLD(DIA)
     A                                      TEXT('DIAGNOSTIC CODE 4')
     A            EOEMPL    R               REFFLD(FLAG)
     A                                      TEXT('PATIENT EMPLMNT')
     A            EODFC     R               REFFLD(DT)
     A                                      TEXT('DATE 1ST CONSULTED')
     A            EOFLIC    R               REFFLD(FEI2)
     A                                      COLHDG('PHYS FL LIC#')
     A            EOTAPE    R               REFFLD(FLAG)
     A                                      TEXT('SUBMIT ON TAPE FLAG')
     A            EOSEMP    R               REFFLD(A70)
     A                                      COLHDG('STATE' 'EMP#')
     A            EOUSER    R               REFFLD(USER)
     A            EOPGM     R               REFFLD(PGM)
     A            EOTIME    R               REFFLD(TIME)
     A            EODT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            EOIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            EOIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'ENTRY' 'DATE')
     A            EODBA     R               REFFLD(NAME)
     A                                      COLHDG('DOING' 'BUSINESS' 'AS')
     A            EOEFID    R               REFFLD(SS#)
     A                                      COLHDG('EMPLOYER' 'FEDERAL' 'ID#')
     A            EOEZIP    R               REFFLD(ZIP)
     A                                      COLHDG('EMPLOYER' 'ZIP CODE')
     A            EONDIS    R               REFFLD(A92)
     A                                      COLHDG('NETWORK' 'DISCOUNT' +
     A                                      'REDUCTION')
     A            EOSYS     R               REFFLD(FLAG) COLHDG('SYSTEM ID')
     A                                      TEXT('NOT USED YET FLAG')
     A*** BEG ADD *** 06/17/99 ** FL TAPE SUBMISSION ******************
     A            EOCNTL    R               REFFLD(DS20)
     A                                      COLHDG('DATA SUBM EOMB ')
     A            EOSBDT    R               REFFLD(DS8)
     A                                      COLHDG(' ')
     A*                                 This date will be updated in
     A*                                 F9511R with date EOMB is sent
     A*                                 to state.  If "processed" thru
     A*                                 F0348R correction program,
     A*                                 this date will be blanked out.
     A*** END ADD *** 06/17/99 ****************************************
