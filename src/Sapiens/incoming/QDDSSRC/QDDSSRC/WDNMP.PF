     A*  WORKERS' COMP WCPOLS NAME REPORTING FILE
     A*
     A                                      REF(WREFP)
     A          R PNM01                     TEXT('WCPOLS NAME REPORTING FILE')
     A            NMCO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            NMFND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            NMEMP#    R     S         REFFLD(EMP#)
     A                                      COLHDG('EMPLOYER')
     A            NMFYR     R     S         REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            NMUNID    R     S         REFFLD(A120)
     A                                      COLHDG('UNIQUE IDENTIFIER')
     A            NMST      R               REFFLD(ST)
     A                                      COLHDG('REPORTING BUREAU')
     A            NMTRDT         7S 0       COLHDG('TRANSACTION DATE')
     A            NMFRDT         7S 0       COLHDG('NAME EFFECTIVE DATE')
     A            NMTODT         7S 0       COLHDG('NAME EXPIRATION DATE')
     A            NMDLDT         7S 0       COLHDG('NAME DELETION DATE')
     A            NMDRPD         7S 0       COLHDG('DELETION REPORT DATE')
     A            NMLINK         3S 0       COLHDG('NAME LINK CODE')
     A            NMLNKC         2S 0       COLHDG('NAME LINK COUNTER')
     A            NMNAME       450A         COLHDG('FULL NAME')
     A            NMPNMF    R               REFFLD(FLAG)
     A                                      COLHDG('PERSONAL NAME FLAG')
     A            NMFEIN         9S 0       COLHDG('FEDERAL ID #')
     A            NMLEGN    R               REFFLD(FLAG)
     A                                      COLHDG('LEGAL NATURE CODE')
     A            NMNAOB    R               REFFLD(DS40)
     A                                      COLHDG('NATURE OF BUSINESS')
     A            NMPEOF    R               REFFLD(FLAG)
     A                                      COLHDG('PEO/CLIENT FLAG')
     A            NMST1     R               REFFLD(ST)
     A                                      COLHDG('UE #1 STATE')
     A            NMSUE1        20A         COLHDG('STATE UNEMPLOYMENT#1')
     A            NMST2     R               REFFLD(ST)
     A                                      COLHDG('UE #2 STATE')
     A            NMSUE2        20A         COLHDG('STATE UNEMPLOYMENT#2')
     A            NMST3     R               REFFLD(ST)
     A                                      COLHDG('UE #3 STATE')
     A            NMSUE3        20A         COLHDG('STATE UNEMPLOYMENT#3')
     A            NMUSER    R               REFFLD(USER)
     A            NMPGM     R               REFFLD(PGM)
     A            NMTIME    R     S         REFFLD(TIME)
     A            NMDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            NMIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            NMIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PGM')
     A            NMITM     R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            NMIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
