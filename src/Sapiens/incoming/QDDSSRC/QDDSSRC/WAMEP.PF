     A                                      COLHDG('SEQUENCE #')
     A            MESSEQ#   R               REFFLD(SEQ#)
     A                                      COLHDG('SUB SEQUENCE #')
     A            MECALC    R               REFFLD(FLAG)
     A                                      COLHDG('HAS' 'BEEN CALC,D (Y/ )')
     A            MESTDT    R               REFFLD(DT)
     A                                      COLHDG('FIRST DT OF PERIOD')
     A            MELSDT    R               REFFLD(DT)
     A                                      COLHDG('LAST DT OF PERIOD')
     A            MEHOURS   R               REFFLD(A72)
     A                                      COLHDG('HOURS WORKED')
     A            MEWAGE    R               REFFLD(A92)
     A                                      COLHDG('WAGES EARNED')
