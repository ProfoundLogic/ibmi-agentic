     A                                      REF(SREFP)
     A          R PPH201                    TEXT('Scriptura Payment -
     A                                      History Work File -
     A                                      Report Totals')
     A*
     A            PH2XML        60A         COLHDG('Unique XML File' -
     A                                      ' Name Key')
     A            PH2TRCDTOT     2A         COLHDG('Transaction Code' +
     A                                      'Totals')
     A            PH2TRCDDS     40A         COLHDG('Transaction Code' +
     A                                      'Description')
     A            PH2TRCDAMT    15S 2       COLHDG('Transaction Code' +
     A                                      'Total Amount')
     A            PH2PV1TOT      2A         COLHDG('Payment Value 1' +
     A                                      'Totals')
     A            PH2PV1DS      40A         COLHDG('Payment Value 1' +
     A                                      'Description')
     A            PH2WEEKS       4S 0       COLHDG('Weeks')
     A            PH2DAYS        2S 0       COLHDG('Days')
     A            PH2PV1AMT     15S 2       COLHDG('Pmt Value 1' +
     A                                      'Total Amount')
     A            PH2IDT         7S 0       COLHDG('Init Date')
