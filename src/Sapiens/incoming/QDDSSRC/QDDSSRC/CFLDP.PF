     A                                      REF(CREFP)
     A          R PLF01                     TEXT('LOSS DEVELOPMENT DOWNLOAD')
     A            LFCO#          3S 0       TEXT('CO#')
     A            LFCLM#        12A         TEXT('CLAIM NUMBER')
     A            LFDSLS        40A         TEXT('LOSS DESCRIPTION')
     A            LFCLID         5A         TEXT('CLAIMANT NUMBER')
     A            LFCNAM        40A         TEXT('CLAIMANT NAME')
     A            LFCOV          3A         TEXT('COVERAGE')
     A            LFLIM         18A         TEXT('LIMITS/DEDUCTIONS')
     A            LFPOL#        13A         TEXT('POL#')
     A            LFFIN         40A         TEXT('INSURED NAME')
     A            LFLSDT    R               REFFLD(DT)
     A                                      COLHDG('LOSS DATE')
     A            LFTER          3A         TEXT('TERRITORY')
     A            LFMPL         11S 2       TEXT('MTD PAID LOSS')
     A            LFMRL         11S 2       TEXT('MTD RESERVE LOSS')
     A            LFMPE         11S 2       TEXT('MTD PAID EXPENSE')
     A            LFMRE         11S 2       TEXT('MTD RESERVE EXPENSE')
     A            LFMSV         11S 2       TEXT('MTD SALVAGE')
     A            LFMSR         11S 2       TEXT('MTD SUBROGATION')
     A            LFMTT         11S 2       TEXT('MTD TOTAL')
     A            LFCPL         11S 2       TEXT('CUMM PAID LOSS')
     A            LFCRL         11S 2       TEXT('CUMM RESERVE LOSS')
     A            LFCPE         11S 2       TEXT('CUMM PAID EXPENSE')
     A            LFCRE         11S 2       TEXT('CUMM RESERVE EXPENSE')
     A            LFCSV         11S 2       TEXT('CUMM SALVAGE')
     A            LFCSR         11S 2       TEXT('CUMM SUBROGATION')
     A            LFCTT         11S 2       TEXT('CUMM TOTAL')
     A            LFADJ          3A         TEXT('ADJUSTER')
     A            LFOCST         1A         TEXT('OPEN/CLOSED')
     A            LFSTAT         1A         TEXT('STATUS')
     A            LFUSER        10A         TEXT('USER')
     A            LFPGM         10A         TEXT('PROGRAM')
     A            LFTIME         6S 0       TEXT('TIME')
     A            LFDT      R               REFFLD(DT)
     A                                      COLHDG('DATE')
