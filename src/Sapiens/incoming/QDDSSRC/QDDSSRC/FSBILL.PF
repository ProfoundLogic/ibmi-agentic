     A          R FSBILL                    TEXT('CS Check/EOB Detail File')
     A            CLR02         12A         COLHDG('Control Number')
     A            CLR03          6S 0       COLHDG('Bill Line #')
     A            CLR04          8A         COLHDG('Date of Service')
     A            CLR05          8A         COLHDG('Procedure Code')
     A            CLR06         30A         COLHDG('Procedure Code' +
     A                                      'Description')
     A            CLR07          7S 2       COLHDG('Number of Units')
     A            CLR08          3A         COLHDG('Procedure Code' +
     A                                      'Modifier')
     A            CLR09         39A         COLHDG('Modifier Code Desc 1')
     A            CLR10         39A         COLHDG('Modifier Code Desc 2')
     A            CLR11          2A         COLHDG('Service Location')
     A            CLR12          9S 2       COLHDG('Total Bill on Line')
     A            CLR13          9S 2       COLHDG('Line MRA Reduction')
     A            CLR14          9S 2       COLHDG('Line Network' +
     A                                      'Reduction')
     A            CLR15          9S 2       COLHDG('Line Paid')
     A            CLR16         35A         COLHDG('Drug/Supply Code')
     A            CLR17         18A         COLHDG('Drug Class')
     A            CLR18          9S 2       COLHDG('Drug Units Dispensed')
     A            CLR19          9S 2       COLHDG('Drug Units Allowed')
     A            CLR20          9S 4       COLHDG('Average Wholesale' +
     A                                      'Price')
     A            CLR20A         4A         COLHDG('DRX Code')
     A            CLC04         30A         COLHDG('Claim Comment 1')
     A            CLC05         30A         COLHDG('Claim Comment 2')
     A            CLC06         30A         COLHDG('Claim Comment 3')
     A            CLC07         30A         COLHDG('Claim Comment 4')
     A            CLC08         30A         COLHDG('Claim Comment 5')
     A            CLC09         30A         COLHDG('Claim Comment 6')
     A            CLC10         30A         COLHDG('Claim Comment 7')
     A            CLC11         30A         COLHDG('Claim Comment 8')
     A            QUA04         39A         COLHDG('Qualifier' +
     A                                      'Description 1')
     A            QUA05         39A         COLHDG('Qualifier' +
     A                                      'Description 2')
     A            QUA06         39A         COLHDG('Qualifier' +
     A                                      'Description 3')
     A            QUA07         39A         COLHDG('Qualifier' +
     A                                      'Description 4')
     A            QUA08         39A         COLHDG('Qualifier' +
     A                                      'Description 5')
     A            QUA09         39A         COLHDG('Qualifier' +
     A                                      'Description 6')
     A            QUA10         39A         COLHDG('Qualifier' +
     A                                      'Description 7')
     A            QUA11         39A         COLHDG('Qualifier' +
     A                                      'Description 8')
     A            QUA12          3A         COLHDG('Qualifier Code 1')
     A            QUA13          3A         COLHDG('Qualifier Code 2')
     A            QUA14          3A         COLHDG('Qualifier Code 3')
     A            QUA15          3A         COLHDG('Qualifier Code 4')
     A            QUA16          3A         COLHDG('Qualifier Code 5')
     A            QUA17          3A         COLHDG('Qualifier Code 6')
     A***** BEG ADD ***** 03/21/14 *********************************************
     A            CLR21          3S 0       COLHDG('Revenue Code')
     A            CLR22          2A         COLHDG('Proc Code Mod 2')
