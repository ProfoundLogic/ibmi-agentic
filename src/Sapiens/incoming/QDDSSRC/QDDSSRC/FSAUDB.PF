     A*  03/21/14 C:212 Project 144MCO                                *
     A*                 Add new field BLR31 to allow revenue code and *
     A*                 patient account no available for check print  *
     A*                                                               *
     A*****************************************************************
     A          R FSAUDB                    TEXT('CS Check/EOB Header File')
     A            BLR02         12A         COLHDG('Control Number')
     A            BLR04          8A         COLHDG('Date CVL Received' +
     A                                      'Bill')
     A            BLR05          8A         COLHDG('Date CVL Processed' +
     A                                      'Bill')
     A            BLR06         20A         COLHDG('Claim number')
     A            BLR07          5A         COLHDG('Ref 1 Adjuster Code')
     A            BLR09          8A         COLHDG('Bill Date of Inujury')
     A            BLR10         10A         COLHDG('ICD9 Code 1')
     A            BLR11         10A         COLHDG('ICD9 Code 2')
     A            BLR12         10A         COLHDG('ICD9 Code 3')
     A            BLR13         10A         COLHDG('ICD9 Code 4')
     A            BLR14          3A         COLHDG('Type of Bill')
     A            BLR15          1A         COLHDG('Patient Type')
     A            BLR16          9A         COLHDG('Patient Ctl#')
     A            BLR17          2A         COLHDG('Bill Status')
     A            BLR18          8A         COLHDG('Date Hospital' +
     A                                      'Admission')
     A            BLR19          3A         COLHDG('DRG')
     A            BLR20          8A         COLHDG('From Date')
     A            BLR21          8A         COLHDG('To Date')
     A            BLR22          6S 2       COLHDG('Cost to Process' +
     A                                      'Date')
     A            BLR23          8A         COLHDG('Earliest Date of' +
     A                                      'Service')
     A            BLR24          8A         COLHDG('Latest Date of' +
     A                                      'Service')
     A            BLR25          6A         COLHDG('# of Lines')
     A            BLR26         11S 2       COLHDG('Total Charge')
     A            BLR27         11S 2       COLHDG('MRA Reduction')
     A            BLR28         11S 2       COLHDG('Network Reductions')
     A            BLR29         11S 2       COLHDG('Paid')
     A            BLR30          8A         COLHDG('Batch Date')
     A            PPR03          1A         COLHDG('Type of Provider')
     A            PPR04         10A         COLHDG('Fein')
     A            PPR05          3A         COLHDG('Modifier')
     A            PPR06          3A         COLHDG('Provider Type')
     A            PPR07         40A         COLHDG('Provider Name')
     A            PPR08         40A         COLHDG('Provider Address 1')
     A            PPR09         40A         COLHDG('Provider Address 2')
     A            PPR10         25A         COLHDG('Provider City')
     A            PPR11          2A         COLHDG('Provider State')
     A            PPR12          9A         COLHDG('Provider Mailing' +
     A                                      'Zip')
     A            PPR13          9A         COLHDG('Provider Physical' +
     A                                      'Zip')
     A            PPR14         10A         COLHDG('Provider Phone #')
     A            PPR15         10A         COLHDG('PPO Fein')
     A            PPR16         30A         COLHDG('PPO Name')
     A            PPR17          9A         COLHDG('Patient SS#')
     A            PPR18         30A         COLHDG('Patient Name')
     A            PPR19          8A         COLHDG('Patient DOB')
     A            PPR20         30A         COLHDG('Patient Address')
     A            PPR21         16A         COLHDG('Patient City')
     A            PPR22          2A         COLHDG('Patient State')
     A            PPR23          9A         COLHDG('Patient Zip')
     A            AUTHLV         2A         COLHDG('Authorized Level')
     A            AUTHUS        10A         COLHDG('Authorizing User')
     A            AUTHDT         8A         COLHDG('Authorizing Date')
     A            CSVNDR         7S 0       COLHDG('CS Vendor Code')
     A            CSPCD1         2A         COLHDG('CS Pay Code 1')
     A            CSPCD2         2A         COLHDG('CS Pay Code 2')
     A            TRNSCS         1A         COLHDG('Transferred to CS' +
     A                                      'Flag')
     A            PPOUSR        10A         COLHDG('Who Ran PPOI Update')
     A            PPODAT         8A         COLHDG('PPO Authorizing Date')
     A            PPOPCT         7S 2       COLHDG('PPO % Amount')
     A            PPOCHK        10A         COLHDG('PPO Check Amount')
     A            PPONMB         8A         COLHDG('Run Date Seq')
     A            RECDTE         8A         COLHDG('Date Received')
     A***** BEG ADD ***** 03/21/14 *********************************************
     A            BLR31         30A         COLHDG('Patient Account /'  -
     A                                      'Control Number')
     A***** END ADD ***** 03/21/14 *********************************************
