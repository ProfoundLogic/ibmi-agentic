     A          R POL01                     TEXT('OBJECT LOCATION WORKFILE')
     A            OLKEY         40A         TEXT('DARTS KEY')
     A            OLSEQ#         5S 0       TEXT('DART RMK SEQ#')
     A****
     A****  MUST ALSO INCLUDE OID AND FLR AS THESE DETERMINE UNIQUENESS
     A            OLOID         40A         COLHDG('OBJECT ID')
     A*
     A            OLOFLR        60A         COLHDG('OBJECT FOLDER')
     A**************************************************************************
     A***
     A**************************************************************************
     A            OLOTYP         1A
     A                                      COLHDG('OBJECT TYPE' +
     A                                      'O-OTHER, F-FAX' +
     A                                      ' I-IMAGE')
     A************ ABOVE WILL BE FOR MAJOR OR FOR ATTACHMENTS OBJTYPE
     A***
     A            OLRMCD         5A         TEXT('REMARK CODE/DOC TYPE')
     A*                   THE ABOVE IS FILLED FROM EITHER THE SDCMP OR THE SMMDP
     A*
     A            OLCRDT         8S 0       TEXT('OBJECT CREATION DATE 8/0')
     A*                        SHOULD THIS BE YYYYMMDD OR MMDDYYYY?
     A*                          WILL COME FROM CMTRDT OR MDTRDT
     A*
     A**** CHANGED 12/16/04 *****************************************
     A*********** OLDESC       256A         TEXT('OBJECT DESCRIPTION')
     A            OLDESC       275A         TEXT('OBJECT DESCRIPTION')
     A*** END CHANGE 12/16/04 *****************************************
     A            OLPATH       132A         TEXT('PATH TO OBJECT')
     A*                   THIS WILL BE INCLUDING THE QDLS INFO.  & OBJ NAME
     A            OLONAM        40A         TEXT('OBJECT NAME - ORIGINAL')
     A*====================================================================
     **** FIELD USED FOR ONLY SIS APPLICATIONS ****************************
     A*====================================================================
     A***
     A***KEYS BROKEN OUT INTO INDIVIDUAL FIELDS.  USE THE CMPGM VALUE FOR THIS?
     A***
     A            OLRTYP         1A         TEXT('TYPE CLAIMS-C OR POLICY-P')
     A*
     A            OLCOMP         2A         TEXT('SIS COMPANY ')
     A            OLPREF         4A         TEXT('SIS PREFIX')
     A            OLPOL#         9A         TEXT('SIS POLICY#')
     A            OLBRCH         2A         TEXT('SIS BRANCH')
     A            OLCLM#        10A         TEXT('SIS CLAIM#')
     A*====================================================================
