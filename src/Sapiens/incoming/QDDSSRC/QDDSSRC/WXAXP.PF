      *
     A                                      REF(WREFP)
     A          R PAX01                     TEXT('ACH Letter Merge Data')
      *
     A            AXFNNM        60A
     A                                      COLHDG('Group Name')
      *
     A            AXACCT        17A
     A                                      COLHDG('Account Number')
      *
     A            AXABA          9A
     A                                      COLHDG('ABA Number')
      *
     A            AXMBRN         9A
     A                                      COLHDG('Employer # /' +
     A                                             'Member Number')
      *
     A            AXENAM        40A
     A                                      COLHDG('Employer Name' +
     A                                             'Member Name')
      *
     A            AXFDNM        40A
     A                                      COLHDG('Federal Name')
      *
     A            AXEAD1        40A
     A                                      COLHDG('Employer Address 1')
      *
     A            AXEAD2        40A
     A                                      COLHDG('Employer Address 2')
      *
     A            AXECSZ        40A
     A                                      COLHDG('Employer City' +
     A                                             'State Zip')
      *
     A            AXYEAR         4P 0
     A                                      COLHDG('Certificate Year')
      *
     A            AXEFDT    R               REFFLD(DT8)
     A                                      COLHDG('Effective Date')
      *
     A            AXEXDT    R               REFFLD(DT8)
     A                                      COLHDG('Expiration Date')
      *
     A            AXCXDT    R               REFFLD(DT8)
     A                                      COLHDG('Cancel Date')
      *
     A            AXSTDS        15A
     A                                      COLHDG('Status Description')
      *
     A            AXDDDT    R               REFFLD(DT8)
     A                                      COLHDG('Direct Debit' +
     A                                             'Start Date')
      *
     A            AXFRDS        15A
     A                                      COLHDG('Frequency' +
     A                                             'Description')
      *
     A            AXPAMT    R               REFFLD(A112)
     A                                      COLHDG('One time' +
     A                                             'Payment Amount')
      *
     A            AXFBAL    R               REFFLD(A112)
     A                                      COLHDG('Future Balance' +
     A                                             'Subj to Transfers')
      *
     A            AXPTDT    R               REFFLD(A112)
     A                                      COLHDG('Automatic Transfer' +
     A                                             'Payments to Date')
      *
     A            AXNPDT    R               REFFLD(DT8)
     A                                      COLHDG('Next Payment Date')
      *
     A            AXLPDT    R               REFFLD(DT8)
     A                                      COLHDG('Last Payment Date')
      *
     A            AX#PMT         3P 0
     A                                      COLHDG('Total Number' +
     A                                             'Remaining Payments')
      *
     A            AXAPMT    R               REFFLD(A112)
     A                                      COLHDG('New Payment Amount')
      *
     A            AXENDS        40A
     A                                      COLHDG('Endorsement' +
     A                                             'Description')
      *
     A            AXAGT#    R               REFFLD(AGT#)
     A                                      COLHDG('Agent Number')
      *
     A            AXANAM        40A
     A                                      COLHDG('Agent Name')
      *
     A            AXAAD1        40A
     A                                      COLHDG('Agent Address 1')
      *
     A            AXACSZ        40A
     A                                      COLHDG('Agent City' +
     A                                             'State Zip')
      *
     A            AXEMP1        40A
     A                                      COLHDG('Empl Addr' +
     A                                             'Print 1')
      *
     A            AXEMP2        40A
     A                                      COLHDG('Empl Addr' +
     A                                             'Print 2')
      *
     A            AXEMP3        40A
     A                                      COLHDG('Empl Addr' +
     A                                             'Print 3')
      *
     A            AXEMP4        40A
     A                                      COLHDG('Empl Addr' +
     A                                             'Print 4')
      *
     A            AXEMP5        40A
     A                                      COLHDG('Empl Addr' +
     A                                             'Print 5')
     A**** BEG ADD ****** 06/11/03 ************************************
      *
     A            AXCTOT        11S 2
     A                                      COLHDG('Coverage Total')
      *
     A            AXRNDT    R               REFFLD(DT8)
     A                                      COLHDG('Current Date')
      *
     A            AXNPSD    R               REFFLD(DT8)
     A                                      COLHDG('New Payment' +
     A                                       'Direct Debit' +
     A                                       'Start Date')
      *
     A**** END ADD ****** 06/11/03 ************************************
     A**** BEG ADD ****** 06/22/03 ************************************
      *
     A            AXFRD2    R               REFFLD(DS70)
     A                                      COLHDG('Statement' +
     A                                       'of payment' +
     A                                       'frequency')
     A**** END ADD ****** 06/22/03 ************************************
     A**** BEG ADD ****** 08/05/03 ************************************
      *
     A            AXDDTD    R               REFFLD(DT8)
     A                                      COLHDG('Direct Deposit' +
     A                                       'Transfer Date')
      *
     A            AXPCMT    R               REFFLD(DS70)
     A                                      COLHDG('Printed Comment')
      *
     A**** END ADD ****** 08/05/03 ************************************
