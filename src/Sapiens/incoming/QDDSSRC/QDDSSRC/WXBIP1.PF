     A*                                                               *
     A*****************************************************************
     A* REVISIONS:                                                    *
     A*                                                               *
     A* 06/17/24  C:344 PROJECT: WC2952                               *
     A*                 Expand rate field from 7.2 to 8.3 zoned.      *
     A*                                                               *
     A*****************************************************************
     A                                      REF(WREFP)
     A          R PBD01                     TEXT('DETAIL INVOICE WORKFILE')
     A*
     A* KEY FIELDS
     A*  XML LINK CODE - SAME AS HEADER FILE
     A            BDXML         60          COLHDG('XML KEY')
     A*
     A            BDCO#     R               REFFLD(CO#)
     A            BDFND     R               REFFLD(FND)
     A            BDEMP#    R               REFFLD(EMP#)
     A            BDDIV     R               REFFLD(DIV)
     A            BDFYR     R               REFFLD(FYR)
     A*
     A* Reporting Period - Ending Date
     A            BDRPTPRD       7  0       COLHDG('REPORTING PERIOD')
     A            BDRPRDWK       7  0       COLHDG('REPORTING PERIOD' +
     A                                       'WEEKLY')
     A            BDRPRDMTH      5  0       COLHDG('REPORTING PERIOD' +
     A                                       'MONTHLY')
     A*
     A* DETAIL WAGES
     A            BDPOLNBR      25          COLHDG('MAIN POLICY #')
     A            BDPOLNBRI     25          COLHDG('INDIVIDUAL POLICY #')
     A*
     A*   DETAIL LINE ITEMS
     A            BDEMPLNK      15          COLHDG('EMPLOYER' 'LINK CODE')
     A            BDCLTNAME     45          COLHDG('CLIENT NAME')
     A            BDSTATE        2          COLHDG('STATE')
     A            BDWCCODE       5  0       COLHDG('WC CODE')
     A            BDWAGEAMT     11  2       COLHDG('WAGE AMT')
      **** BEGIN CHG **** 06/17/24 ************************************
     A*********** BDWCRATE       5  2       COLHDG('WC RATE')
     A            BDWCRATE       8S 3
      **** END   CHG **** 06/17/24 ************************************
     A                                      COLHDG('WC RATE')
     A            BDMANPREM     11  2       COLHDG('MANUAL PREMIUM')
     A*
     A*   Manual Premium and Collateral Percentage - Policy Level
     A            BDMANPPCT      5  2       COLHDG('PCT' 'MAN PRM')
     A            BDCOLLPCT      5  2       COLHDG('PCT' 'COLLATERAL')
     A*
