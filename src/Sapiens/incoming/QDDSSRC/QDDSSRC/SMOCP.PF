     A                                      REF(SCREFP)
     A          R POC01                     TEXT('OPTICAL CONTROL   -
     A                                      FILE(CURRENT VALUES)')
     A            OCOSYS         1A         TEXT('OPTICAL SYSTEM             ')
     A            OCLIBN        10A         TEXT('OPTICAL LIBRARY NAME       ')
     A            OCOFLD         8A         TEXT('CURNT OPT FOLDER NAME      ')
     A            OCOSBD        12A         TEXT('CURNT OPT SUBDIRECTORY NAME')
     A            OCDCID        12A         TEXT('LAST OPT DOC ID FOR STORE  ')
     A            OC#STG         4S 0       TEXT('# OF STAGED OBJECTS        ')
     A            OCVOLI         6A         TEXT('CURRENT OPTICAL VOLUME ID  ')
     A            OCM#DC         5S 0       TEXT('MAX #  OF DOCS IN SUBDIRECT')
     A            OCM#SD         3S 0       TEXT('MAX #  OF SUBDIRECTS IN FLR')
     A            OCC#DC         5S 0       TEXT('CURRENT # OF DOCS IN SUBDRC')
     A            OCC#SD         3S 0       TEXT('CURRENT # OF SUBDIRC IN FLR')
     A            OCSTAT    R               REFFLD(STAT)
     A            OCUSER    R               REFFLD(USER)
     A            OCPGM     R               REFFLD(PGM)
     A            OCTIME    R               REFFLD(TIME)
     A            OCDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            OCIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
     A            OCIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            OCPPFL         1A         TEXT('OPT PURGE IN PROGRESS - Y/N ')
