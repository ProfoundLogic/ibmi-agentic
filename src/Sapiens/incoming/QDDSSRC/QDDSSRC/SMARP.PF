     A*                                                               *
     A*****************************************************************
     A                                      REF(SCREFP)
     A          R PAR01                     TEXT('ADDITIONAL REMARKS RCD')
     A            ARKEY     R               REFFLD(KEY)
     A            ARSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('REMARK' 'SEQ')
     A            ARCM75    R   75          REFFLD(COMM)
     A            ARASQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('ADDITIONAL' 'RMRK SEQ#')
     A            ARCSID    R               REFFLD(CSID)
     A            ARCDAT    R               REFFLD(DT)
     A                                      COLHDG('REMARK' 'DATE')
     A            ARCODE    R               REFFLD(CODE)
     A                                      COLHDG('REMARK' 'TYPE')
     A            ARPNAM    R               REFFLD(PGM)
     A                                      TEXT('WROTE IT')
     A            ARTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANS' 'DATE')
     A            ARTRTM    R               REFFLD(TIME)
     A                                      COLHDG('TRANS' 'TIME')
     A            ARSECL    R               REFFLD(SECL)
     A                                      COLHDG('SECURITY' 'LEVEL')
     A            ARSBYL    R               REFFLD(FLAG)
     A                                      COLHDG('SECURE' 'BY' 'LEVEL-Y/N')
     A******
     A            ARSTAT    R               REFFLD(STAT)
     A            ARUSER    R               REFFLD(USER)
     A            ARPGM     R               REFFLD(PGM)
     A            ARTIME    R               REFFLD(TIME)
     A            ARDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            ARIUSR    R               REFFLD(USER)
     A                                      COLHDG('RECORD CREATED BY')
