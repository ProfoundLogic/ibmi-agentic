     A**  FAX TRANSACTION  FILE
     A                                      REF(SCREFP)
     A          R PFT01                     TEXT('FAX TRANSACTION  FILE')
     A            FTRCID        10          TEXT('RECIPIENT ID')
     A            FTDESC        40          TEXT('DESCRIPTION')
     A            FTFPH#        32          TEXT('TO FAX PHONE#')
     A            FTOUTC         2          TEXT('FAX OUTPUT CLASS')
     A            FTCPTI        40          TEXT('FAX COVER PAGE TITLE')
     A            FTCPT1        40          TEXT('FAX COVER PAGE TO LN1')
     A            FTCPT2        40          TEXT('FAX COVER PAGE TO LN2')
     A            FTCPT3        40          TEXT('FAX COVER PAGE TO LN3')
     A            FTCPF1        40          TEXT('FAX COVER PAGE FROM LN1')
     A            FTCPF2        40          TEXT('FAX COVER PAGE FROM LN2')
     A            FTCPF3        40          TEXT('FAX COVER PAGE FROM LN3')
     A            FTCPCM        40          TEXT('FAX COVER PAGE COMMENT')
     A*
     A*
     A            FTFAXC    R               REFFLD(FLAG)
     A                                      COLHDG('FAX COMPLETE Y/N')
     A            FTFCDT    R               REFFLD(DT)
     A                                      COLHDG('FAX COMPLETE' 'DATE')
     A            FTFCTM    R               REFFLD(DT)
     A                                      COLHDG('FAX COMPLETE' 'TIME')
     A            FTJOB#         6          TEXT('JOB NUMBER OF SPLF')
     A            FTUSRN        10          TEXT('USER NAME OF SPLF')
     A            FTJOBN        10          TEXT('JOB NAME OF SPLF')
     A*
     A            FTFILN        10          TEXT('FILE"S NAME(IE QSYSPRT)')
     A            FTFIL#         3          TEXT('FILE"S NUMBER OF SPLF')
     A***** # OF RETRY"S COUNTER
     A            FTRCNT         3S         TEXT('RETRY COUNT')
     A            FTSUSR        10          TEXT('SUBMITTING USER')
     A            FTSJOB        10          TEXT('SUBMITTING JOB')
     A*
     A            FTSTAT    R               REFFLD(STAT)
     A            FTUSER    R               REFFLD(USER)
     A            FTPGM     R               REFFLD(PGM)
     A            FTTIME    R               REFFLD(TIME)
     A            FTDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A*** DARTS VALUES
     A            FTKEY         40A         TEXT('DARTS KEY FOR DOC')
     A            FTSEQ#         5S 0       TEXT('SEQUENCE # OF DARTS')
