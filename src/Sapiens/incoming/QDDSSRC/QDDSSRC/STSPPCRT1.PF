     A                                      REF(SREFP)
     A          R PS101                     TEXT('Scripture Processes file 1')
     A            S1TYPE       100A         COLHDG('PROCESS TYPE/DESC')
     A            S1CRITID      25A         COLHDG('CRITERIA ID')
     A            S1CRITVAL     50A         COLHDG('CRITERIA VALUE')
     A*
     A            S1STAT    R               REFFLD(STAT)
     A            S1USER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            S1PGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            S1TIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            S1DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            S1IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            S1IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            S1ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            S1IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')

     A          K S1TYPE
     A          K S1CRITID
     A          K S1CRITVAL
