     A*  MEDICARE 2ND PAY DATA COMPLIANCE CODE DETAIL FILE
     A*
     A                                      REF(WREFP)
     A          R PC501                     TEXT('MEDICARE COMPLIANCE -
     A                                           DETAIL FILE')
     A            C5CO#     R     S         REFFLD(CO#)
     A                                      COLHDG('CO#')
     A            C5FND     R     S         REFFLD(FND)
     A                                      COLHDG('GROUP')
     A            C5FYR     R     S         REFFLD(FYR)
     A                                      COLHDG('POLICY YEAR')
     A            C5CASE    R     S         REFFLD(CASE)
     A            C5EXDT    R     S         REFFLD(DT)
     A                                      COLHDG('EXTRACT DATE')
     A            C5CODE         2A
     A                                      COLHDG('COMPLIANCE CODE')
     A            C5STAT    R               REFFLD(FLAG)
     A                                      COLHDG('STATUS (C/N)')
     A*
     A* MAINTENANCE INFORMATION
     A*
     A            C5USER    R               REFFLD(USER)
     A            C5PGM     R               REFFLD(PGM)
     A            C5TIME    R     S         REFFLD(TIME)
     A            C5DT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            C5IUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            C5IPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            C5ITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            C5IDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
