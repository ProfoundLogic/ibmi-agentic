     A*
     A* - EOS Payment File - Header
     A*
     A*****************************************************************
     A* Created on 10/31/2001 by C:62 for Project 96MEN
     A*****************************************************************
     A* Purpose: This file will house the 'bill header' record for the
     A*          associated EOS records.  Additional fields will be
     A*          added to the end of the file to hold information
     A*          specific to the matchup of the claim in PDS.  It will
     A*          be tied to the FAO9P record via O1DCID.
     A*****************************************************************
     A* REVISIONS
     A*
     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PO101                     TEXT('EOS Payment File - header')
     A            O1RCDE    R               REFFLD(FLAG)
     A                                      COLHDG('Record Type')
     A            O1EID#    R               REFFLD(DS8)
     A                                      COLHDG('Bill ID')
     A            O1CID#    R               REFFLD(DS20)
     A                                      COLHDG('Patient Claim Number')
     A            O1RTYP    R               REFFLD(CODE)
     A                                      COLHDG('Bill Type')
     A            O1BGDT    R     S         REFFLD(DT8)
     A                                      COLHDG('Start Service Date')
     A            O1ENDT    R     S         REFFLD(DT8)
     A                                      COLHDG('End Service Date')
     A            O1EDOI    R     S         REFFLD(DT8)
     A                                      COLHDG('Injury date')
     A            O1BAMT        12S 0
     A                                      COLHDG('Billed Amount')
     A            O1PAMT        12S 0
     A                                      COLHDG('Paid Amount')
     A            O1BID#         4S 0
     A                                      COLHDG('Batch number')
     A            O1CNAM    R               REFFLD(DS30)
     A                                      COLHDG('Patient Name')
     A            O1PID#         9A
     A                                      COLHDG('Provider Tax ID')
     A            O1FSFX    R               REFFLD(DS3)
     A                                      COLHDG('Provider multiple' -
     A                                      'location code')
     A            O1PNAM    R               REFFLD(DS30)
     A                                      COLHDG('Provider Name')
     A            O1PAD1    R               REFFLD(DS30)
     A                                      COLHDG('Provider Address 1')
     A            O1PAD2    R               REFFLD(DS30)
     A                                      COLHDG('Provider Address 2')
     A            O1PCTY    R               REFFLD(DS15)
     A                                      COLHDG('Provider City')
     A            O1PST     R               REFFLD(ST)
     A                                      COLHDG('Provider State')
     A            O1PZIP         9A
     A                                      COLHDG('Provider Zip code')
     A            O1ESS#    R               REFFLD(SS#)
     A                                      COLHDG('Patient SS#')
     A            O1PAT#    R               REFFLD(DS14)
     A                                      COLHDG('Patient ID')
     A            O1HATY    R               REFFLD(FLAG)
     A                                      COLHDG('Hospitial Admission' -
     A                                      'Type')
     A            O1NAMT        12S 0
     A                                      COLHDG('PPO Reduction')
     A            O1ICD1    R               REFFLD(DS6)
     A                                      COLHDG('ICD9 code 1')
     A            O1IDD1    R               REFFLD(DS25)
     A                                      COLHDG('ICD9 description 1')
     A            O1ICD2    R               REFFLD(DS6)
     A                                      COLHDG('ICD9 code 2')
     A            O1IDD2    R               REFFLD(DS25)
     A                                      COLHDG('ICD9 description 2')
     A            O1ICD3    R               REFFLD(DS6)
     A                                      COLHDG('ICD9 code 3')
     A            O1IDD3    R               REFFLD(DS25)
     A                                      COLHDG('ICD9 description 3')
     A            O1ICD4    R               REFFLD(DS6)
     A                                      COLHDG('ICD9 code 4')
     A            O1IDD4    R               REFFLD(DS25)
     A                                      COLHDG('ICD9 description 4')
     A            O1FILL        49A
     A                                      COLHDG('Filler')
     A            O1DCID    R               REFFLD(DCID)
     A                                      COLHDG('(PDS) Document ID')
     A            O1MBR#    R               REFFLD(DS10)
     A                                      COLHDG('(PDS) Member #')
     A            O1PRFL    R               REFFLD(FLAG)
     A                                      COLHDG('(PDS) Processed Flag')
     A*
     A*                                     *blank = not processed yet
     A*                                     "D" = Deleted
     A*                                     "E" = Error
     A*                                     "Y" = written to WCMC
     A*
     A            O1PRDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Process Date')
     A            O1PRTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Process Time')
     A            O1CO#     R               REFFLD(CO#)
     A                                      COLHDG('(PDS) Company #')
     A            O1SUB#    R               REFFLD(SUB#)
     A                                      COLHDG('(PDS) Subscriber #')
     A            O1FND     R               REFFLD(FND)
     A                                      COLHDG('(PDS) Group #')
     A            O1FYR     R               REFFLD(FYR)
     A                                      COLHDG('(PDS) Year')
     A            O1CASE    R               REFFLD(CASE)
     A                                      COLHDG('(PDS) Case #')
     A            O1SS#     R               REFFLD(SS#)
     A                                      COLHDG('(PDS) SS#')
     A            O1ACDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) ACDT')
     A            O1FEIN    R               REFFLD(FEIN)
     A                                      COLHDG('(PDS) FEIN')
     A            O1MOD     R               REFFLD(MOD)
     A                                      COLHDG('(PDS) Provider Mod')
     A            O1EOB#    R               REFFLD(EOB#)
     A                                      COLHDG('(PDS) EOMB')
     A            O1DLUS    R               REFFLD(USER)
     A                                      COLHDG('(PDS) Delete User')
     A            O1DLPG    R               REFFLD(PGM)
     A                                      COLHDG('(PDS) Delete Pgm')
     A            O1DLTM    R               REFFLD(TIME)
     A                                      COLHDG('(PDS) Delete Time')
     A            O1DLDT    R               REFFLD(DT)
     A                                      COLHDG('(PDS) Delete Date')
     A            O1DLRE    R               REFFLD(DS70)
     A                                      COLHDG('(PDS) Delete Reason')
