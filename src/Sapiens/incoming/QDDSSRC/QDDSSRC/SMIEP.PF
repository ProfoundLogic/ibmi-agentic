     A* REVISIONS:                                                    *
     A* 07/25/18 C:180   Project: C146MIC                             *
     A*                  Add Field for re-opened satus.               *
     A*                                                               *
     A* 04/12/17 C:180   Project: MC325                               *
     A*                  Add Fields 'Exclude Record only Claims', and *
     A*                  'Exclude Death Claims'.                      *
     A*                                                               *
     A* 11/11/16 C:079   Project: 90MHT                               *
     A*                  Add Field Include 0 Pays in Paid Date Export *
     A*                                                               *
     A* 11/10/16 C:309   Project: 90MIB                               *
     A*                  Added new field.                             *
     A*                  "Number of Days Since Claim Was Closed"      *
     A*                                                               *
     A*****************************************************************
     A                                      REF(SREFP)
     A          R PIE01                     TEXT('IMPORT/EXPORT PROCESSES')
     A            IECCHG         1A         COLHDG('CHANGED CLAIMS ONLY')
     A            IECIFS         1A         COLHDG('CLAIM FILE TO IFS')
     A            IECSTS         1A         COLHDG('CLAIM STATUS')
     A            IECDNY         1A         COLHDG('CLAIM DENIAL')
     A            IECCVFL        1A         COLHDG('CLAIM CONTROVERTED')
     A            IECGRP         1A         COLHDG('EXCLUDE BY GROUP')
     A            IECEMP         1A         COLHDG('USE EMP RESTRICTIONS')
     A            IEEIFS         1A         COLHDG('EMPLOYER FILE TO IFS')
     A            IEEAGT         1A         COLHDG('EXCLUDE BY AGENT')
     A            IEEEMP         1A         COLHDG('EXCLUDE BY EMPLOYER')
     A            IEFIFS         1A         COLHDG('PROVIDER FILE TO IFS')
     A            IEFTYP         1A         COLHDG('PROVIDER TYPE')
     A            IEUDUP         1A         COLHDG('CHECK FOR DUPLICATES')
     A            IEUDRC         1A         COLHDG('DEFAULT RESERVE CODE')
     A            IEUREL         1A         COLHDG('AUTO RELEASE')
     A            IEUPCL         1A         COLHDG('PEND IF CLOSED')
     A            IEUPDN         1A         COLHDG('PEND IF DENIED')
     A            IEUDPN         1A         COLHDG('PEND IF DENIED')
     A            IEUEDI         1A         COLHDG('DEFAULT PEND CODE')
     A            IEUSER    R               REFFLD(USER)
     A                                      COLHDG('USER')
     A            IEPGM     R               REFFLD(PGM)
     A                                      COLHDG('PROGRAM')
     A            IETIME    R     S         REFFLD(TIME)
     A                                      COLHDG('TIME')
     A            IEDT      R     S         REFFLD(DT)
     A                                      COLHDG('DATE')
     A            IEIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            IEIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            IEITIM    R     S         REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            IEIDT     R     S         REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A*** Beg Add ***** 11/10/16 ***********************************************
     A            IECLDAYS  R     S         REFFLD(A50)
     A                                      COLHDG('No. of Days Since' -
     A                                      'Claim was Closed')
     A*** End Add ***** 11/10/16 ***********************************************
     A*** Beg Add ***** 11/11/16 ***********************************************
     A            IEINCZRO  R               REFFLD(FLAG)
     A                                      COLHDG('Include 0 Pays'    -
     A                                      'in Paid Date Export')
     A*** End Add ***** 11/11/16 ***********************************************
     A*** Beg Add ***** 04/12/17 ***********************************************
     A            IECRCD    R               REFFLD(FLAG)
     A                                      COLHDG('Exclude Record'    -
     A                                      ' only Claims')
     A            IECDTH    R               REFFLD(FLAG)
     A                                      COLHDG('Exclude Death '    -
     A                                      'Claims')
     A*** End Add ***** 04/12/17 ***********************************************
     A*** Beg Add ***** 07/25/18 ***********************************************
     A            IERSTS    R               REFFLD(FLAG)
     A                                      COLHDG('Re-opened' 'Status')
     A*** End Add ***** 07/25/18 ***********************************************
