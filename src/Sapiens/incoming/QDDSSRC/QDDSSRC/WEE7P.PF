     A*
     A*  EDI Payments File
     A                                      REF(WREFP)
     A          R PE701                     TEXT('Payments')
     A*
     A            E7CO#     R               REFFLD(CO#)
     A            E7FND     R               REFFLD(FND)
     A            E7FYR     R               REFFLD(FYR)
     A            E7CASE    R               REFFLD(CASE)
     A            E7LGSQ    R               REFFLD(A50)
     A                                      TEXT('EDI Log sequence #')
     A*
     A            E7PAYE    R               REFFLD(DS40)
     A                                      TEXT('Payee')
     A            E7AMT     R               REFFLD(A92)
     A                                      TEXT('Payment amt.')
     A            E7FRDT    R               REFFLD(DT)
     A                                      TEXT('Payment from DT')
     A            E7TODT    R               REFFLD(DT)
     A                                      TEXT('Payment to DT')
     A            E7TRDT    R               REFFLD(DT)
     A                                      TEXT('Payment DT')
     A            E7REAS    R               REFFLD(DS3)
     A                                      TEXT('Payment reason code')
     A            E7STYP    R               REFFLD(FLAG)
     A                                      TEXT('Settlement type code')
     A*
     A            E7USER    R               REFFLD(USER)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'USER')
     A            E7PGM     R               REFFLD(PGM)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'PGM')
     A            E7DT      R               REFFLD(DT)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'DATE')
     A            E7TIME    R               REFFLD(TIME)
     A                                      COLHDG('LAST' 'MAINTENANCE' 'TIME')
