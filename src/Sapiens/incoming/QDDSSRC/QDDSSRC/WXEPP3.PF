     A*
     A*  EDI 816 File - Employer Payroll
     A*
     A          R PXP01                     TEXT('EDI 816 Format-Emplr Payroll')
     A            XPTRTP         2A         COLHDG('TRANSACTION' 'TYPE' '= EP')
     A            XPPOL#         8A         COLHDG('12 - POLICY #')
     A            XPBEXT         3A         COLHDG('12 - EXT #')
     A            XPCLAS         5A         COLHDG('22 - CLASS' 'CODE')
     A            XPEFDT         8A         COLHDG('EFFECTIVE' 'DATE')
     A            XPPROC         1A         COLHDG('PROCESSED')
     A            XPTRN#         5  0       COLHDG('TRANSACTION #')
     A*
     A          K XPPOL#
     A          K XPBEXT
     A          K XPTRN#
