     A*****************************************************************
     A                                      REF(FSREFP)
     A          R PTR01                     TEXT('NETWORK TRANSACTION REC FILE')
     A            TRCO#     R               REFFLD(CO#)
     A            TRFND     R               REFFLD(FND)
     A            TRFYR     R               REFFLD(FYR)
     A            TRCASE    R               REFFLD(CASE)
     A            TRTRDT    R               REFFLD(DT)
     A                                      COLHDG('TRANSACTION' 'DATE')
     A            TRFEIN    R               REFFLD(FEIN)
     A                                      COLHDG('PAYEE' 'FEDERAL' 'ID #')
     A            TRMOD     R               REFFLD(MOD)
     A            TRBAMT    R               REFFLD(A92)
     A                                      COLHDG('BILLING' 'AMOUNT')
     A            TRFRDT    R               REFFLD(DT)
     A                                      COLHDG('FROM' 'DATE')
     A            TRTODT    R               REFFLD(DT)
     A                                      COLHDG('TO' 'DATE')
     A            TRTRCD    R               REFFLD(CODE)
     A                                      COLHDG('TRANSACTION' 'CODE')
     A            TRFLG1    R               REFFLD(FLAG) COLHDG('FLAG 1')
     A                                      TEXT('NOT USED YET')
     A            TRFLG2    R               REFFLD(FLAG) COLHDG('FLAG 2')
     A                                      TEXT('NOT USED YET')
     A            TRFLG3    R               REFFLD(FLAG) COLHDG('FLAG 3')
     A                                      TEXT('NOT USED YET')
     A            TRFLG4    R               REFFLD(FLAG) COLHDG('FLAG 4')
     A                                      TEXT('NOT USED YET')
     A            TRFLG5    R               REFFLD(FLAG) COLHDG('FLAG 5')
     A                                      TEXT('NOT USED YET')
     A            TRSTAT    R               REFFLD(STAT) TEXT('STATUS')
     A                                      COLHDG('STATUS' 'FLAG')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('MAINTENANCE' 'USER')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('MAINTENANCE' 'PGM')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('MAINTENANCE' 'TIME')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('MAINTENANCE' 'DATE')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
     A            TREOB#    R               REFFLD(EOB#) COLHDG('EOB#')
     A            TRSYS     R               REFFLD(FLAG) COLHDG('SYSTEM ID')
     A                                      TEXT('SYSTEM CODE-"N"-NETWORK, +
     A                                      "P"-PROVIDER BILL REVIEW, "H"-+
     A                                      HOSPITAL BILL AUDIT')
     A
     A*** BEG CHG *** 01/05/99 ***************************************
     A            TRINV#    R               REFFLD(A90)
     A**********  TRINV#    R               REFFLD(SEQ#)
     C*** END CHG *** 01/05/99 ***************************************
     A                                      COLHDG('INVOICE' 'NUMBER')
     A            TRSUB#    R               REFFLD(SUB#)
     A*** ADD FOR NETWORK PROCESSING SYSTEM ************************************
     A            TRHRFL    R               REFFLD(FLAG)
     A                                      COLHDG('HOLD/RELEASE' 'FLAG')
     A            TRBLFL    R               REFFLD(FLAG)
     A                                      COLHDG('BILLING' 'FLAG')
     A            TRNLFL    R               REFFLD(FLAG)
     A                                      COLHDG('NO LOST' 'TIME FLAG')
