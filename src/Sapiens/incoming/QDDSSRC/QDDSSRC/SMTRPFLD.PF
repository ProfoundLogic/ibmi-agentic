     A                                      REF(WREFP)
     A          R PTR01                     TEXT('Rules Engine')
     A            TRCO#     R               REFFLD(CO#)
     A                                      COLHDG('Company Number')
     A            TRNAME        10A
     A                                      COLHDG('Rules Name')
     A            TRSEQ#         5S 0
     A                                      COLHDG('Name Seq#')
     A            TRTYPE        10A
     A                                      COLHDG('Change/Report')
     A            TRFIELD       10A
     A                                      COLHDG('Field')
     A            TRPOSITION    15S 0
     A                                      COLHDG('Field Position')
     A            TRFLDB         5S 0
     A                                      COLHDG('Field Length' 'in Bytes')
     A            TRFLDD         2S 0
     A                                      COLHDG('Number of Digits')
     A            TRFLDP         2S 0
     A                                      COLHDG('Number of' +
     A                                      'Decimal Positions')
     A            TRFLDT         1
     A                                      COLHDG('Field Type')
     A            TRUSER    R               REFFLD(USER)
     A                                      COLHDG('Maintenance User')
     A            TRPGM     R               REFFLD(PGM)
     A                                      COLHDG('Maintenance Pgm')
     A            TRTIME    R               REFFLD(TIME)
     A                                      COLHDG('Maintenance Time')
     A            TRDT      R               REFFLD(DT)
     A                                      COLHDG('Maintenance Date')
     A            TRIUSR    R               REFFLD(USER)
     A                                      COLHDG('Initial User')
     A            TRIPGM    R               REFFLD(PGM)
     A                                      COLHDG('Initial Pgm')
     A            TRITIM    R               REFFLD(TIME)
     A                                      COLHDG('Initial Time')
     A            TRIDT     R               REFFLD(DT)
     A                                      COLHDG('Initial Date')
     A            TRSTAT    R               REFFLD(FLAG)
     A                                      COLHDG('Status')
     A            TRFIELDTYP    25
     A                                      COLHDG('Field Type')
     A            TROPERCUR     25
     A                                      COLHDG('Current' -
     A                                      'Relational Operator')
     A            TRCMPVALC    100
     A                                      COLHDG('Current' -
     A                                      'Comparison Value')
     A            TRCMPTYPC     25
     A                                      COLHDG('Current' -
     A                                      'Comparison Type')
     A            TROPERPRV     25
     A                                      COLHDG('Previous' -
     A                                      'Relational Operator')
     A            TRCMPVALP    100
     A                                      COLHDG('Previous' -
     A                                      'Comparison Value')
     A            TRCMPTYPP     25
     A                                      COLHDG('Previous' -
     A                                      'Comparison Type')
     A
     A          K TRCO#
     A          K TRNAME
     A          K TRSEQ#
     A          K TRTYPE
     A          K TRFIELD
