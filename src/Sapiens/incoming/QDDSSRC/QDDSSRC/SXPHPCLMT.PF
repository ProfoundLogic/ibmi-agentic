     A                                      REF(SREFP)
     A          R PPH101                    TEXT('Scriptura Payment -
     A                                      History Work File -
     A                                      Claim Totals')
     A*
     A            PH1XML        60A         COLHDG('Unique XML File' -
     A                                      ' Name Key')
     A            PH1CO#         3S 0       COLHDG('Company Number')
     A            PH1FND         3S 0       COLHDG('Group Number')
     A            PH1FYR         3S 0       COLHDG('Policy Year')
     A            PH1CASE        7S 0       COLHDG('Case Number')
     A            PH1TRCDTOT     2A         COLHDG('Transaction Code')
     A            PH1TRCDDS     40A         COLHDG('Transaction Code' +
     A                                      'Description')
     A            PH1TRCDAMT    15S 2       COLHDG('Transaction Code' +
     A                                      'Amount')
     A            PH1PV1TOT      2A         COLHDG('Payment Value 1')
     A            PH1PV1DS      40A         COLHDG('Payment Value 1' +
     A                                      'Description')
     A            PH1WEEKS       4S 0       COLHDG('Weeks')
     A            PH1DAYS        2S 0       COLHDG('Days')
     A            PH1PV1AMT     15S 2       COLHDG('Pmt Value 1 Amount')
     A            PH1IDT         7S 0       COLHDG('Init Date')
