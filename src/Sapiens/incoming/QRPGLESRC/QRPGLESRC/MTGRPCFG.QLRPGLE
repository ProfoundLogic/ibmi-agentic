     fMTGRPCFG  cf   e             workstn
     f                                     handler('PROFOUNDUI(HANDLER)')
     f                                     Sfile(sflGrpCfg:scSflRRN)
     f                                     Sfile(sflModInfo:scSflRRN2)
     f                                     Sfile(sflNetInfo:scSflRRN3)
     fstactpnl  cf   e             workstn
     f                                     handler('PROFOUNDUI(HANDLER)')
      * Company file
     fsmcol     if   e           k disk    rename(pco01:pco00)
      * Fund Master file
     ffmfnp     if a e             disk    rename(pfn01:pfn0p)
     ffmfnl     if   e           k disk    rename(pfn01:pfn00)
     f                                     infds(dbfds)
     ffmfnl1    if   e           k disk    rename(pfn01:pfn01)
      * Fund Auxiliary File
     ffmf1p     if a e             disk    rename(pf101:pf10p)
     ffmf1l     if   e           k disk    rename(pf101:pf100)
      * WCMC Control File
     ffmcxp     if a e             disk    rename(pcx01:pcx0p)
      * Group State Information File
     ffdf2p     if a e             disk    rename(pf201:pf20p)
      * Network (All systems) Billing Rate/Discount Master
     fnmbdl     if   e           k disk    rename(pbd01:pbd00)
      * User Parameter File
     fsmupl     if   e           k disk    rename(pup01:pup00)

     d psds          esds                  extname(szq1p)
     d dbfds           ds
     d  dbrrn                397    400b 0
     d dbfds2          ds
     d  dbrrn2               397    400b 0

      // work variables
     d i               s              3  0
     d j               s              3  0
     d clientID        s              3    inz('000')
     d intCo#          s              3  0
     d indexTab        s              5  0
