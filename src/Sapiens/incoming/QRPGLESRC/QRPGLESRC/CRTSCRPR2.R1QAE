     H option(*nodebugio:*srcstmt)
     H dftactgrp(*no) actgrp(*CALLER) bnddir('STBNDDIR')
     H*                                                                   *
     H*********************************************************************
     H*  Revisions:                                                       *
     H*                                                                   *
     H*  03/29/23 C:230 Support: 108796                                   *
     H*                 Correct file names for fields in STSFP to use     *
     H*                 the correct field names for files.                *
     H*                                                                   *
     H*********************************************************************

     fstsfp     uf a e           k disk    rename(psf01:psf0p)
     fstscp     if   e             disk    rename(psc01:psc0p)

     d #ofRcd          c                   100
     d sf              s             20    dim(#ofRcd) ctdata perrcd(1)

     d fldsSF        e ds                  extname(STSFP)
     d isClearRcd      s              1n   inz('0')
     d isWriteRcd      s              1n   inz('0')
     d sysDate7        s              7  0
     d sysTime6        s              6  0

     d psds          esds                  extname(szq1p)
     d index                          3  0
     d xxClt#          s              3

      *entry
     dCrtScrpR2        pr                  ExtPgm('CRTSCRPR2')
     d inClearRcd                     1n   options(*nopass)
     dCrtScrpR2        pi
     d inClearRcd                     1n   options(*nopass)

     dRtvCltId         pr                  ExtPgm('RTVCLTID')
     d cltId                          3

     d/copy sPrDate
     d/copy sPrTable

      /Free
       // Do nothing if Phase I not loaded
       Read psc0p;
       If %eof;
          Return;
       Endif;

       If %parms >= 1;
          isClearRcd = inClearRcd;
       Endif;

       RtvCltId(xxClt#);
       sysDate7 = DateTo7(SystemDate);
       sysTime6 = TimeTo6(SystemTime);

       For index = 1 to #ofRcd;
          If sf(index) <> *blanks;
             Clear psf0p;
             fldsSF = sf(index);
             Chain SFfile STSFP;
             Select;
             When %found and isClearRcd;
                Delete psf0p;
                isWriteRcd = *on;
             When %found;
                isWriteRcd = *off;
             Other;
                isWriteRcd = *on;
             Endsl;
             If isWriteRcd;
                fldsSF = sf(index);
                SFstat = 'A';
                SFpgm  = q1Pgm;
                SFuser = q1User;
                SFdt   = sysDate7;
                SFtime = sysTime6;
                SFiPgm = SFpgm;
                SFiUsr = SFuser;
                SFiDt  = SFdt;
                SFiTim = SFtime;
                Write psf0p;
             Endif;
          Endif;
       Endfor;
       *inlr = *on;
      /End-free
      *  1         2         3         4         5         6         7         8         9
