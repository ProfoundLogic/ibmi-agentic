      *
     C     XX7CDE        IFNE      *BLANK
     C     RR7THP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C* ADD THE AMOUNT OF THE NY STATE ASSESSMENT INTO PREMIUM BASIS.
     C*
     C     XXST          IFEQ      'NY'
     C     RR7THC        ANDEQ     9749
     C                   ADD       XX932A        EL7APR
     C                   ADD       XX932F        EL7FPR
     C                   ENDIF                                                  XXST IFEQ
     C     RR7THF        MULT      EL7FPR        XX7AMT           15 4
     C     RR7THP        MULT      EL7APR        XXPREM
     C                   ADD       XXPREM        XX7AMT
     C     XX7AMT        DIV(H)    100           XX7THB           11 0
     C                   Z-ADD     RR7THP        XXART7            5 3
     C*
     C                   ENDIF                                                  XX7CDE IFNE
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C     XX1STB        MULT(H)   PRO(X)        ASM1(X)
     C     XX2NDB        MULT(H)   PRO(X)        ASM2(X)
     C     XX3RDB        MULT(H)   PRO(X)        ASM3(X)
     C     XX4THB        MULT(H)   PRO(X)        ASM4(X)
     C     XX5THB        MULT(H)   PRO(X)        ASM5(X)
     C     XX6THB        MULT(H)   PRO(X)        ASM6(X)
     C     XX7THB        MULT(H)   PRO(X)        ASM7(X)
     C                   Z-ADD     XXART1        ART1(X)
     C                   Z-ADD     XXART2        ART2(X)
     C                   Z-ADD     XXART3        ART3(X)
     C                   Z-ADD     XXART4        ART4(X)
     C                   Z-ADD     XXART5        ART5(X)
     C                   Z-ADD     XXART6        ART6(X)
     C                   Z-ADD     XXART7        ART7(X)
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   XFOOT     ASM1          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX1STB
     C     XX1STB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM1(1)
     C                   ENDIF
     C*
     C                   XFOOT     ASM2          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX2NDB
     C     XX2NDB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM2(1)
     C                   ENDIF
     C*
     C                   XFOOT     ASM3          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX3RDB
     C     XX3RDB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM3(1)
     C                   ENDIF
     C*
     C                   XFOOT     ASM4          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX4THB
     C     XX4THB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM4(1)
     C                   ENDIF
     C*
     C                   XFOOT     ASM5          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX5THB
     C     XX5THB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM5(1)
     C                   ENDIF
     C                   XFOOT     ASM6          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX6THB
     C     XX6THB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM6(1)
     C                   ENDIF
     C*
     C                   XFOOT     ASM7          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XX7THB
     C     XX7THB        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ASM7(1)
     C                   ENDIF
      *++++++
      * ELSE MAY COME HERE TO CALCULATE ASSESSMENTS FOR STATES
      * OF PA
     C                   ELSE
     C*
     C                   Z-ADD     0             XX1STB
     C                   Z-ADD     0             XX2NDB
     C                   Z-ADD     0             XX3RDB
     C                   Z-ADD     0             XX4THB
     C                   Z-ADD     0             XX5THB
     C                   Z-ADD     0             XX6THB
     C                   Z-ADD     0             XX7THB
     C                   Z-ADD     0             XXART1
     C                   Z-ADD     0             XXART2
     C                   Z-ADD     0             XXART3
     C                   Z-ADD     0             XXART4
     C                   Z-ADD     0             XXART5
     C                   Z-ADD     0             XXART6
     C                   Z-ADD     0             XXART7
     C                   Z-ADD     1             X
     C*
     C     RDAT(X)       DOWNE     *ZERO
     C*
     C* If not NJ, then prorated amount of terrorism charges will need to be
     C* added or subtracted from premium arrays for assessments.
     C*
     C*** begin del ***  01/28/25  ****************************************
     C******             If        xxst <> 'NJ'
     C*** end del *****  01/28/25  ****************************************
     C     ELPROR        MULT(H)   ETR(X)        XXWK10
     C                   Z-add     xxwk10        ETR(X)
     C     ELPROR        MULT(H)   NTR(X)        XXWK10
     C                   Z-add     xxwk10        NTR(X)
     C     ELPROR        MULT(H)   DTR(X)        XXWK10
     C                   Z-add     xxwk10        DTR(X)
     C*** begin del ***  01/28/25  ****************************************
     C******             Endif
     C*** end del *****  01/28/25  ****************************************
     C                   Z-ADD     RDAT(X)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR1ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX1CDE        IFNE      *BLANK
     C     RR1STP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 1ST ASSESSMENT BILLED.
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXST          ANDEQ     'NJ'
     C     RR1STL        ANDEQ     'X'
     C     ELEMNP        OREQ      'Y'
     C     XXST          ANDNE     'NJ'
     C                   Z-ADD     STN1          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ELSE
     C*
     C                   SELECT
     C     RR1STL        WHENEQ    'J'
     C                   Z-ADD     A1J           ASA
     C     RR1STL        WHENEQ    'E'
     C                   Z-ADD     A1E           ASA
     C     RR1STL        WHENEQ    'S'
     C                   Z-ADD     A1S           ASA
     C     RR1STL        WHENEQ    'D'
     C                   Z-ADD     A1D           ASA
     C     RR1STL        WHENEQ    'X'
     C                   Z-ADD     STN1          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ENDSL                                                  RR1STL SELC
     C*
     C* FOR PA, ADD DEDUCTIBE DISCOUNT BACK INTO PREMIUM IF NECESSARY.
     C*
     C     XXST          IFEQ      'PA'
     C     RR1IDD        ANDNE     'Y'
     C*
     C     RRRDPR        IFEQ      'M'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     RRRDPR        OREQ      'S'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     LDPLV1        OREQ      'M'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'J'
     C     RR1STL        ANDNE     'J'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'E'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'S'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     RR1STL        ANDNE     'S'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'D'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     RR1STL        ANDNE     'S'
     C     RR1STL        ANDNE     'D'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C     RR1STL        Ifne      'X'
     C                   ADD       EDCT(XX)      ASA(XX)
     C                   ADD       EDD2(XX)      ASA(XX)
     C                   Else
     C     ELPROR        MULT(H)   EDCT(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C     ELPROR        MULT(H)   EDD2(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C                   Endif
     C                   ADD       1             XX
     C                   ENDDO
     C*
     C                   ENDIF                                                  RRRDPR IFEQ
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C     RR1STL        IFNE      'X'
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C     XXST          IFEQ      'NJ'
     C     XXLM1         ANDNE     *ZERO
     C                   SUB       LM(XX)        ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM2         ANDNE     *ZERO
     C                   SUB       LM2(XX)       ASA(XX)
     C                   ENDIF
     C*** begin chg ***  01/28/25  *******************************************
     C******             If        xxst <> 'NJ'
     C******             MULT(H)   ELPROR        ASA(XX)
     C******             Endif
     C                   MULT(H)   ELPROR        ASA(XX)
     C*** end chg *****  01/28/25  *******************************************
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'F')
      * Add terrorism charge, not payroll to the assesment premium base
     C                   ADD       ETR(XX)       ASA(XX)
     C                   ADD       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'D')
     C                   ADD       DTR(XX)       ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM1         ANDNE     *ZERO
     C                   ADD       LM(XX)        ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM2         ANDNE     *ZERO
     C                   ADD       LM2(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ENDIF                                                  ELEMNP IFNE
     C*
     C                   ENDIF                                                  ELEMNP IFEQ
     C                   IF        RR1ILF <> ' '
     C*
     C*** begin add ***  11/12/24  ******************************************
     C                   Z-add     xxlprm1       xxlprm
     C*** end add *****  11/12/24  ******************************************
     C                   EVAL(H)   xxamt154 = prIncLmtBasis(XXTEIN:XXNET:XXLPRM:
     C                                      RR1ILF:RR1STL:X1SUBJ:X1EXPP:X1STAN:
     C                                      X1DISP:X1NET:ELEMNP:RR1ATR:asmFact)
     C*
     C                   Eval(h)   xxwk10 = asa(x) * asmFact
     C                   Eval      asa(x) = xxwk10
     C                   ENDIF                                                  RR1ILF <> ' '
     C*
     C     RR1STF        IFNE      *ZERO
     C     ELEMNP        ANDNE     'Y'
     c     RR1xfc        OrEq      'Y'
     c     ELeMnP        AndNE     'Y'
     C*
     C     XXFPCT        MULT(H)   ASA(X)        XXWK10
     C     RR1STF        MULT      XXWK10        XX1AMT           15 4
      /Free
       If xxst = 'NY' AND RR1stc = 932;
         F932(x) = %IntH(xx1amt/100);
       EndIf;
      /End-Free
     C     ASA(X)        SUB       XXWK10        XXPREM
     C     RR1STP        MULT      XXPREM        XXPREM
      /Free
       If xxst = 'NY' AND RR1stc = 932;
         A932(x) = %IntH(XXprem/100);
       EndIf;
      /End-Free
     C                   ADD       XXPREM        XX1AMT
     C     XX1AMT        DIV(H)    100           XXWK10
     C                   ADD       XXWK10        XX1STB
     C                   ADD       XXWK10        ASM1(X)
     C*
     C                   ELSE
     C*
     C     RR1STP        MULT      ASA(X)        XX1AMT
     C     XX1AMT        DIV(H)    100           XXWK10
      /Free
       If xxst = 'NY' AND RR1stc = 932;
         A932(x) = xxwk10;
       EndIf;
      /End-Free
     C                   ADD       XXWK10        XX1STB
     C                   ADD       XXWK10        ASM1(X)
     C*
     C                   ENDIF                                                  RR1STF IFNE
     C                   Z-ADD     RR1STP        ART1(X)
     C*
     C                   ENDIF                                                  XX1CDE IFNE
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR2ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX2CDE        IFNE      *BLANK
     C     RR2NDP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 2ND ASSESSMENT BILLED.
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXST          ANDEQ     'NJ'
     C     RR2NDL        ANDEQ     'X'
     C     ELEMNP        OREQ      'Y'
     C     XXST          ANDNE     'NJ'
     C                   Z-ADD     STN2          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR2ATR <> 'B') AND (RR2ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR2ATR <> 'B') AND (RR2ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ELSE
     C*
     C                   SELECT
     C     RR2NDL        WHENEQ    'J'
     C                   Z-ADD     A2J           ASA
     C     RR2NDL        WHENEQ    'E'
     C                   Z-ADD     A2E           ASA
     C     RR2NDL        WHENEQ    'S'
     C                   Z-ADD     A2S           ASA
     C     RR2NDL        WHENEQ    'D'
     C                   Z-ADD     A2D           ASA
     C     RR2NDL        WHENEQ    'X'
     C                   Z-ADD     STN2          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR2ATR <> 'B') AND (RR2ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR2ATR <> 'B') AND (RR2ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ENDSL                                                  RR2NDL SELC
     C*
     C* FOR PA, ADD DEDUCTIBE DISCOUNT BACK INTO PREMIUM IF NECESSARY.
     C*
     C     XXST          IFEQ      'PA'
     C     RR2IDD        ANDNE     'Y'
     C*
     C     RRRDPR        IFEQ      'M'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     RRRDPR        OREQ      'S'
     C     RR2NDL        ANDNE     'J'
     C     RR2NDL        ANDNE     'E'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     LDPLV1        OREQ      'M'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'J'
     C     RR2NDL        ANDNE     'J'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'E'
     C     RR2NDL        ANDNE     'J'
     C     RR2NDL        ANDNE     'E'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'S'
     C     RR2NDL        ANDNE     'J'
     C     RR2NDL        ANDNE     'E'
     C     RR2NDL        ANDNE     'S'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'D'
     C     RR2NDL        ANDNE     'J'
     C     RR2NDL        ANDNE     'E'
     C     RR2NDL        ANDNE     'S'
     C     RR2NDL        ANDNE     'D'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C     RR2ndL        Ifne      'X'
     C                   ADD       EDCT(XX)      ASA(XX)
     C                   ADD       EDD2(XX)      ASA(XX)
     C                   Else
     C     ELPROR        MULT(H)   EDCT(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C     ELPROR        MULT(H)   EDD2(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C                   Endif
     C                   ADD       1             XX
     C                   ENDDO
     C*
     C                   ENDIF                                                  RRRDPR IFEQ
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C     RR2NDL        IFNE      'X'
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C     XXST          IFEQ      'NJ'
     C     XXLM1         ANDNE     *ZERO
     C                   SUB       LM(XX)        ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM2         ANDNE     *ZERO
     C                   SUB       LM2(XX)       ASA(XX)
     C                   ENDIF
     C*** begin chg ***  01/28/25  *******************************************
     C******             If        xxst <> 'NJ'
     C******             MULT(H)   ELPROR        ASA(XX)
     C******             Endif
     C                   MULT(H)   ELPROR        ASA(XX)
     C*** end chg *****  01/28/25  *******************************************
     C                   IF        (RR2ATR = 'B') OR (RR2ATR = 'F')
      * Add terrorism charge, not payroll to the assesment premium base
     C                   ADD       ETR(XX)       ASA(XX)
     C                   ADD       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR2ATR = 'B') OR (RR2ATR = 'D')
     C                   ADD       DTR(XX)       ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM1         ANDNE     *ZERO
     C                   ADD       LM(XX)        ASA(XX)
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C     XXLM2         ANDNE     *ZERO
     C                   ADD       LM2(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ENDIF                                                  ELEMNP IFNE
     C*
     C                   ENDIF                                                  ELEMNP IFEQ
     C                   IF        RR2ILF <> ' '
     C*
     C*** begin add ***  11/12/24  ******************************************
     C                   Z-add     xxlprm2       xxlprm
     C*** end add *****  11/12/24  ******************************************
     C                   EVAL(H)   xxamt154 = prIncLmtBasis(XXTEIN:XXNET:XXLPRM:
     C                                      RR2ILF:RR2NDL:X2SUBJ:X2EXPP:X2STAN:
     C                                      X2DISP:X2NET:ELEMNP:RR2ATR:asmFact)
     C*
     C                   Eval(h)   xxwk10 = asa(x) * asmFact
     C                   Eval      asa(x) = xxwk10
     C                   ENDIF                                                  RR2ILF <> ' '
     C*
     C     RR2NDF        IFNE      *ZERO
     C     ELEMNP        ANDNE     'Y'
     c     RR2xfc        OrEq      'Y'
     c     ELeMnP        AndNE     'Y'
     C*
     C     XXFPCT        MULT(H)   ASA(X)        XXWK10

      /Free
       // For 9749 assessment code & NY state, 932 assmt. code F class amount should be added.
       If xxst = 'NY' And RR2ndc = 9749;
          intWk11 = xxwk10 + F932(x);
          xx2Amt = intWk11 * RR2ndf ;
       Else;
          xx2Amt = xxwk10 * RR2ndf ;
       EndIf;

       //Calculate F932 for next assessment.
       If xxst = 'NY' AND RR2ndc = 932;
         F932(x) = %IntH(xx2amt/100);
       EndIf;

       // Regular assmt =  premium (-) F class assmt amount.
       xxprem = asa(x) - xxwk10 ;

       // For 9749 assessment code & NY state, 932 assmt. code regular amount should be added.
       If xxst = 'NY' And RR2ndc = 9749;
          xxprem = xxprem + A932(x);
       EndIf;

      /End-Free
     C     RR2NDP        MULT      XXPREM        XXPREM
       //Calculate A932 for next assessment.
      /Free
       If xxst = 'NY' AND RR2ndc = 932;
         A932(x) = %IntH(XXprem/100);
       EndIf;
      /End-Free
     C                   ADD       XXPREM        XX2AMT
     C     XX2AMT        DIV(H)    100           XXWK10
     C                   ADD       XXWK10        XX2NDB
     C                   ADD       XXWK10        ASM2(X)
     C*
     C                   ELSE
     C*
      /Free
       If xxst = 'NY' And RR2ndc = 9749;
          intWk11 = Asa(x) + A932(x);
          xx2amt = RR2ndp * intWk11;
       Else;
          xx2amt = RR2ndp * Asa(x);
       EndIf;
      /End-Free
     C     XX2AMT        DIV(H)    100           XXWK10
      /Free
       If xxst = 'NY' And RR2ndc = 932;
          A932(x) = xxwk10;
       EndIf;
      /End-Free
     C                   ADD       XXWK10        XX2NDB
     C                   ADD       XXWK10        ASM2(X)
     C*
     C                   ENDIF                                                  RR2NDF IFNE
     C                   Z-ADD     RR2NDP        ART2(X)
     C*
     C                   ENDIF                                                  XX2CDE IFNE
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR3ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX3CDE        IFNE      *BLANK
     C     RR3RDP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 3RD ASSESSMENT BILLED.
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXST          ANDEQ     'NJ'
     C     RR3RDL        ANDEQ     'X'
     C     ELEMNP        OREQ      'Y'
     C     XXST          ANDNE     'NJ'
     C                   Z-ADD     STN3          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR3ATR <> 'B') AND (RR3ATR <> 'F')
