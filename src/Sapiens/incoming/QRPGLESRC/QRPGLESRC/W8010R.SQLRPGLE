     C                                      RR5ILF:RR5THL:X5SUBJ:X5EXPP:X5STAN:
     C                                      X5DISP:X5NET:ELEMNP:RR5ATR:asmFact)
     C*
     C                   Eval(h)   xxwk10 = asa(x) * asmFact
     C                   Eval      asa(x) = xxwk10
     C                   ENDIF                                                  RR5ILF <> ' '
     C*
     C     RR5THF        IFNE      *ZERO
     C     ELEMNP        ANDNE     'Y'
     c     RR5xfc        OrEq      'Y'
     c     ELeMnP        AndNE     'Y'
     C*
     C     XXFPCT        MULT(H)   ASA(X)        XXWK10

      /Free
       // For 9749 assessment code & NY state, 932 assmt. code F class amount should be added.
       If xxst = 'NY' And RR5thc = 9749;
          intWk11 = xxwk10 + F932(x);
          xx5Amt = intWk11 * RR5thf ;
       Else;
          xx5Amt = xxwk10 * RR5thf ;
       EndIf;

       //Calculate F932 for next assessment.
       If xxst = 'NY' AND RR5thc = 932;
         F932(x) = %IntH(xx5amt/100);
       EndIf;

       // Regular assmt =  premium (-) F class assmt amount.
       xxprem = asa(x) - xxwk10 ;

       // For 9749 assessment code & NY state, 932 assmt. code regular amount should be added.
       If xxst = 'NY' And RR5thc = 9749;
          xxprem = xxprem + A932(x);
       EndIf;

      /End-Free
     C     RR5THP        MULT      XXPREM        XXPREM
       //Calculate A932 for next assessment.
      /Free
       If xxst = 'NY' AND RR5thc = 932;
         A932(x) = %IntH(XXprem/100);
       EndIf;
      /End-Free
     C                   ADD       XXPREM        XX5AMT
     C     XX5AMT        DIV(H)    100           XXWK10
     C                   ADD       XXWK10        XX5THB
     C                   ADD       XXWK10        ASM5(X)
     C*
     C                   ELSE
     C*
      /Free
       If xxst = 'NY' And RR5thc = 9749;
          intWk11 = Asa(x) + A932(x);
          xx5amt = RR5thp * intWk11;
       Else;
          xx5amt = RR5thp * Asa(x);
       EndIf;
      /End-Free
     C     XX5AMT        DIV(H)    100           XXWK10
      /Free
       If xxst = 'NY' And RR5thc = 932;
          A932(x) = xxwk10;
       EndIf;
      /End-Free
     C                   ADD       XXWK10        XX5THB
     C                   ADD       XXWK10        ASM5(X)
     C*
     C                   ENDIF                                                  RR5THF IFNE
     C                   Z-ADD     RR5THP        ART5(X)
     C*
     C                   ENDIF                                                  XX5CDE IFNE
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR6ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX6CDE        IFNE      *BLANK
     C     RR6THP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 6TH ASSESSMENT BILLED.
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXST          ANDEQ     'NJ'
     C     RR6THL        ANDEQ     'X'
     C     ELEMNP        OREQ      'Y'
     C     XXST          ANDNE     'NJ'
     C                   Z-ADD     STN6          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR6ATR <> 'B') AND (RR6ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR6ATR <> 'B') AND (RR6ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ELSE
     C*
     C                   SELECT
     C     RR6THL        WHENEQ    'J'
     C                   Z-ADD     A6J           ASA
     C     RR6THL        WHENEQ    'E'
     C                   Z-ADD     A6E           ASA
     C     RR6THL        WHENEQ    'S'
     C                   Z-ADD     A6S           ASA
     C     RR6THL        WHENEQ    'D'
     C                   Z-ADD     A6D           ASA
     C     RR6THL        WHENEQ    'X'
     C                   Z-ADD     STN6          ASA
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C                   IF        (RR6ATR <> 'B') AND (RR6ATR <> 'F')
     C                   SUB       ETR(XX)       ASA(XX)
     C                   SUB       NTR(XX)       ASA(XX)
     C                   ENDIF
     C                   IF        (RR6ATR <> 'B') AND (RR6ATR <> 'D')
     C                   SUB       DTR(XX)       ASA(XX)
     C                   ENDIF
     C                   ADD       1             XX
     C                   ENDDO
     C                   ENDSL                                                  RR6THL SELC
     C*
     C* FOR PA, ADD DEDUCTIBE DISCOUNT BACK INTO PREMIUM IF NECESSARY.
     C*
     C     XXST          IFEQ      'PA'
     C     RR6IDD        ANDNE     'Y'
     C*
     C     RRRDPR        IFEQ      'M'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     RRRDPR        OREQ      'S'
     C     RR6THL        ANDNE     'J'
     C     RR6THL        ANDNE     'E'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     LDPLV1        OREQ      'M'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'J'
     C     RR6THL        ANDNE     'J'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'E'
     C     RR6THL        ANDNE     'J'
     C     RR6THL        ANDNE     'E'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'S'
     C     RR6THL        ANDNE     'J'
     C     RR6THL        ANDNE     'E'
     C     RR6THL        ANDNE     'S'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'D'
     C     RR6THL        ANDNE     'J'
     C     RR6THL        ANDNE     'E'
     C     RR6THL        ANDNE     'S'
     C     RR6THL        ANDNE     'D'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C                   Z-ADD     1             XX                2 0
     C     RDAT(XX)      DOWNE     *ZERO
     C     RR6thL        Ifne      'X'
     C                   ADD       EDCT(XX)      ASA(XX)
     C                   ADD       EDD2(XX)      ASA(XX)
     C                   Else
     C     ELPROR        MULT(H)   EDCT(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C     ELPROR        MULT(H)   EDD2(XX)      XXWK10
     C                   ADD       xxwk10        ASA(XX)
     C                   Endif
     C                   ADD       1             XX
     C                   ENDDO
     C*
     C                   ENDIF                                                  RRRDPR IFEQ
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
