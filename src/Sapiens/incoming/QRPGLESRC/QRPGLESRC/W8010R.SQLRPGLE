       xxPrem = xxPrem + %Xfoot(LMB2);
      //*** End Add ***** 08/14/24 *******************************************
     C*
     C     XXPREM        IFNE      ELEIN2
     C     ELEIN2        SUB       XXPREM        XXPREM
