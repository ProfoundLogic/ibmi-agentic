     C*
     C                   ENDIF                                                  IFIFBL IFNE
     C                   Endif                                                  EXExcARBl check
     C*
     C*** GET THE BILLING SCHEDULE TABLE
     C*
     C***** FORMER A/R WRITING CODE REMOVED AND MOVED TO SUBR WTRAR.
     C*
     C                   MOVE      ' '           XXSUM             1
     C     ELARSM        IFEQ      'Y'
     C                   MOVE      'Y'           XXWAR             1
     C                   MOVE      ' '           XXAR              1
     C                   ELSE
     C                   MOVE      'Y'           XXAR
     C                   ENDIF
     C*
     C                   EXSR      WRTAR
     C*
     C*  GET THE EMPLOYER ENDORSEMENT FORMS
     C*
     C     EMSTRP        IFEQ      'Y'
     C                   Z-ADD     EMDIV         SRDIV
     C                   MOVE      'Y'           XXGTFM
     C                   ENDIF                                                  EMSTRP IFEQ
     C*
     C*  UPDATE BILLING TRANSACTION FILE  (DELETE RECORD IF CALLED FROM
     C*  UPDATE A/R OPTION & ALL FLAGS ARE BLANK).
     C*
     C     BLKEY2        CHAIN     PBL01                              60
     C     *IN60         IFEQ      '0'
     C*
     C     QQPRT         IFEQ      '3'
     C     BLFLG1        ANDEQ     *BLANK
     C     BLFLG2        ANDEQ     *BLANK
     C                   DELETE    PBL01
     C                   ELSE
     C     QQQTE         IFNE      'Q'
     C                   MOVE      *BLANK        BLFLG3
     C                   ENDIF
     C                   MOVE      *BLANK        BLSTEP
     C                   MOVEL     Q1USER        BLUSER
     C                   MOVEL     Q1PGM         BLPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         BLDT
     C                   Z-ADD     DSTIME        BLTIME
     C                   UPDATE    PBL01
     C                   ENDIF                                                  QQPRT IFEQ
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  QQESCD IFNE
     C*
     C                   ENDIF                                                  F1UPAR IFEQ
     C*
     C                   ENDIF                                                  QQOVR IFEQ
     C*
     C                   ENDIF                                                  *IN93 IFEQ
     C*
     C*  GET THE EMPLOYER ENDORSEMENT FORMS
     C*
     C     *IN95         IFEQ      *ON
     C     *IN96         OREQ      *ON
     C     *IN97         OREQ      *ON
     C     *IN98         OREQ      *ON
     C     *IN71         OREQ      *ON
     C                   MOVE      *ON           *IN92
     C                   ELSE
     C     EMKY          READE     PEM01                                  92
     C                   ENDIF
     C*
     C                   ENDDO                                                  *IN92 IFEQ
     C*
     C     XXWAR         IFEQ      'Y'
     C                   MOVE      'Y'           XXSUM
     C                   MOVE      'Y'           XXAR
     C                   MOVE      XSDIV         XXDIV
     C                   EXSR      WRTAR
     C                   ENDIF
     C*
     C                   ENDIF                                                  *IN91 IFEQ
     C*
     C                   ENDIF                                                  XXCAP# = 'Y'
     C                   ENDIF                                                  BLFLG IFNE
     C*
     C                   ENDIF                                                  XXPRAR='N'
     C                   ENDIF                                                  XXEMP# IFNE
     C*
     C     XXGTFM        IFEQ      'Y'
     C     QQQTE         ANDNE     'Q'
     C                   Z-ADD     SRDIV         EMDIV
     C                   EXSR      GTFRMS
     C                   MOVE      *BLANK        XXGTFM
     C                   ENDIF
     C     XXVAL         IFEQ      'Y'
     C     XXCLT#        ANDEQ     '025'
     C*
     C                   MOVEL(P)  'PTYP'        KKTBID
     C                   MOVEL(P)  ELQTYP        KKKEY
     C     GTKY          CHAIN     PGT01                              60
     C     *IN60         IFEQ      *OFF
     C     GTFG01        ANDEQ     'A'
     C     *IN60         OREQ      *OFF
     C     GTFG01        ANDEQ     'M'
     C                   EXSR      SRCALI
     C                   ENDIF                                                  GTFG01 = 'A' OR 'M'
     C*
     C                   ENDIF                                                  XXVAL IFEQ
     C     SVEMP#        IFEQ      *ZERO
     C*
     C     QQRNB         IFEQ      'B'
     C     BLKEY         READE     PBL02                                  90
     C                   ELSE
     C     BLKEY1        READE     PBL03                                  90
     C                   ENDIF                                                  QQRNB EQ B
     C*
     C                   ELSE
     C                   MOVE      *ON           *IN90
     C                   ENDIF                                                  SVEMP# IFEQ
     C*
     C                   ENDDO                                                  *IN90 DOWEQ
     C*
     C     END           TAG

       // Write to invoice file and then call invoice process
       If hldInv# <> 0 And ICGroupOpt(EACo#:hldFnd);

          // Is this a state reported division or non-summarized
          If GetStRptDv(EAco#:hldFnd:hldEmp#) = hldDiv Or hldArSm <> 'Y';
             If QQQte <> 'Q';
                // Write entry into invoice file
                Exec Sql Insert into WIINV
                   values(:EAco#, :hldFnd, :hldEmp#, :hldDiv, :EAfyr);
             Else;

             // Create Image
                If firstInvoice <> 0;
                   ProcessImages(EAco#:hldFnd:hldEmp#:hldDiv:hldFyr:firstInvoice
                    :firstPodt);
                   firstInvoice = 0;
                   firstPodt = 0;
                Endif;
             EndIf;
          Endif;

          // Call invoice program
          If QQQte <> 'Q';
             //*** Begin Chg *** 01/05/24 **********************************
             //*** InvoiceProcess();
             chrMass = ' ';
             If svEmp# = 0;
                chrMass = 'Y';
             EndIf;
             InvoiceProcess(chrMass);
             //*** End   Chg *** 01/05/24 **********************************
          EndIf;

          // Send deleted unused invoice#
          ReportUnusedInvoices(EAco#:hldFnd:hldEmp#:*on);

       EndIf;
     C     *IN71         IFEQ      *ON
     C                   MOVE      '#'           QQRNB
     C                   ENDIF
     C                   SETON                                        LR
      *================================================
      *                   SUBROUTINE SRCALI
      *================================================
      /Free
       Begsr SrCali;
        Chain elKey pld01;
        If %Found;
          // Get total payrolls.
           Setll epKy3 pep02;
           Dou %Eof(WMEPL);
              Reade epKy3 pep02;
              If %Eof;
                 Leave;
              Endif;
              If EPstat = 'I';
                 Iter;
              Endif;
              xxPayr += EPeapr;
           Enddo;
          // Calculate aggregate.
           Eval(h) LDamg1 = xxPayr * LDlirt;
           Update pld01;
        Else;
          // Prevent carryover.
           LDamg1 = 0;
        Endif;
       Endsr;
      /End-Free
     C*====================================================================
     C* Get the invoice # for billing records being created
     C*====================================================================
     C     GETINV        BEGSR
     C*
     C     *LIKE         DEFINE    EACO#         #ICO#
     C     *LIKE         DEFINE    EAFND         #IFND
     C     *LIKE         DEFINE    EAEMP#        #IEMP#
     C     *LIKE         DEFINE    EADIV         #IDIV
     C     *LIKE         DEFINE    EAFYR         #IFYR
     C     *LIKE         DEFINE    EAPODT        #IDT
     C     *LIKE         DEFINE    EANINV        #IINV#
     C*
     C     XXCLT#        IFEQ      '025'
     C*
     C     EAARTY        IFEQ      'A'
     C     EAARTY        OREQ      'B'
     C     EAARTY        OREQ      'D'
     C     EAARTY        OREQ      'F'
     C     EAARTY        OREQ      'H'
     C*
     C                   CALL      'SRINV#'
     C                   PARM      EACO#         #ICO#
     C                   PARM      EAFND         #IFND
     C                   PARM      EAEMP#        #IEMP#
     C                   PARM      EADIV         #IDIV
     C                   PARM      EAFYR         #IFYR
     C                   PARM      EAPODT        #IDT
     C     EANINV        PARM                    #IINV#
     C*
     C                   ENDIF
     C*
       Else;
          // Assign Invoice #
          If (hldFnd <> EAfnd Or hldEmp# <> EAemp# Or hldDiv <> EAdiv Or
             hldPoDt <> EApoDt) And finalUpdate = *on;
             // Write to invoice file for future processing
             If hldInv# <> 0 And ICGroupOpt(EACo#:hldFnd);
                // Is this a state reported division or non-summarized
                If GetStRptDv(EAco#:hldFnd:hldEmp#) = hldDiv Or
                   hldArSm <> 'Y';
                   If QQQte <> 'Q';
                      If hldFnd <> EAfnd Or hldEmp# <> EAemp# Or hldDiv
                          <> EAdiv;
                         Exec Sql Insert into WIINV
                            values(:EAco#, :hldFnd, :hldEmp#, :hldDiv,
                                   :EAfyr);
                      EndIf;
                   Else;
                   // Create Image
                      If hldFnd <> EAfnd Or hldEmp# <> EAemp# Or hldDiv
                          <> EAdiv;
                         If firstInvoice <> 0;
                            ProcessImages(EAco#:hldFnd:hldEmp#:hldDiv:hldFyr:
                             firstInvoice:firstPoDt);
                            firstInvoice = 0;
                            firstPodt = 0;
                         Endif;
                      Endif;

                   Endif;
                Endif;
             EndIf;

             // Get invoice#
             // See if there are resused invoice numbers
             EAnInv = 0;
             Exec Sql Select EAninv Into :EAninv From WMEAP
                      Where EAco#=:EAco# And EAfnd=:EAfnd And
                      EAemp#=:EAemp# And EAdiv=:EAdiv And EAfyr=:EAfyr
                      And EACTyp<> 'C' And EACTyp <> 'R' And
                      EApoDt=:EApoDt And EAarTy in ('A','B','D','F','H');

             //* If renewal policy, use new business payment invoice # for
             //* first installment if it exists.
             If renewInv# <> 0;
                EANinv = renewInv#;
                Clear renewInv#;
             Endif;

             If EAninv = 0;
                invoiceFound = *Off;
                For i=1 to 9999;
             //*** begin chg ***  09/26/22  *********************************************
             //****If arrInvoice(i) = 9999999999999;
                   If arrInvoice(i) = 999999999999999;
             //*** end chg *****  09/26/22  *********************************************
                      Leave;
                   Else;
             //*** begin chg ***  09/26/22  *********************************************
             //*****  decDivision =
             //*****     %Dec(%Subst(%EditC(arrInvoice(i):'X'):1:3):3:0);
             //*****  If decDivision = EAdiv;
             //*****     invoice#      =
             //*****        %Dec(%Subst(%EditC(arrInvoice(i):'X'):4:10):10: 0);
             //*****     arrInvoice(i) = 9999999999999;
                      decDivision =
                         %Dec(%Subst(%EditC(arrInvoice(i):'X'):1:5):5:0);
                      If decDivision = EAdiv;
                         invoice#      =
                            %Dec(%Subst(%EditC(arrInvoice(i):'X'):6:10):10: 0);
                         arrInvoice(i) = 999999999999999;
             //*** end chg *****  09/26/22  *********************************************
                         //*** Begin Add *** 09/12/23 *************
                         // Look to see if the invoice # is being used
                         EAnInv = 0;
                         Exec Sql Select EAninv Into :EAninv From WMEAP
                           Where EAco#=:EAco# And EAfnd=:EAfnd And
                           EAemp#=:EAemp# And EAdiv=:EAdiv And EAfyr=:EAfyr
                           And EACTyp<> 'C' And EACTyp <> 'R' And
                           EAninv = :invoice# And
                           EAarTy in ('A','B','D','F','H');
                         If EAninv <> 0;
                            Iter;
                         EndIf;
                         //*** End   Add *** 09/12/23 *************
                         SortA arrInvoice;
                         invoiceFound = *On;
                         Leave;
                      EndIf;
                   EndIf;
                EndFor;

                If Not invoiceFound;
                   inKey = %EditC(EAco#:'X') + %EditC(EAfnd:'X') +
                           %EditC(EAemp#:'X') + %EditC(EAdiv:'X');
                   invoice# = GetNext3rdPartySeq#(inKey);
                EndIf;
             Else;
                invoice# = EAninv;
                //*** Begin Add *** 09/12/23 *******************************
                decInvoiceDiv = (EAdiv * 10000000000) + EAninv;
                index = %LookUp(decInvoiceDiv:arrInvoice);
                If index <> 0;
                    arrInvoice(index) = 999999999999999;
                    SortA arrInvoice;
                EndIf;
                //*** End   Add *** 09/12/23 *******************************
             EndIf;

             // Populate holding fields
             hldFnd  = EAfnd;
             hldEmp# = EAemp#;
             hldDiv  = EAdiv;
             hldPoDt = EApoDt;
             hldInv# = invoice#;
             hldArSm = ELarSm;

             If firstPodt = 0;
                firstPodt = EAPodt;
                firstInvoice = invoice#;
                hldFyr  = EAFyr;
             Endif;
          EndIf;

          EAnInv = invoice#;
     C                   ENDIF
     C*
     C                   ENDSR
     C*
     C*====================================================================
     C* Write A/R information to holding file for billing records deleted
     C*====================================================================
     C     HOLDAR        BEGSR

       // Save off invoice #'s for reuse
       If EAninv <> 0;
          decInvoiceDiv = (EAdiv * 10000000000) + EAninv;
          index = %LookUp(decInvoiceDiv:arrInvoice);
          If index = 0;
          //*** begin chg ***  09/26/22  *********************************************
          //*****   index = %LookUp(9999999999999:arrInvoice);
             index = %LookUp(999999999999999:arrInvoice);
          //*** end chg *****  09/26/22  *********************************************
             arrInvoice(index) = decInvoiceDiv;
             SortA arrInvoice;
          EndIf;
       EndIf;
     C*
     C     EATRDT        IFLT      SYSDT
     C*
     C                   ADD       1             SYSTM
     C*
     C                   MOVEL     Q1PGM         EAPGM
     C                   MOVEL     Q1USER        EAUSER
     C                   Z-ADD     SYSDT         EADT
     C                   Z-ADD     SYSTM         EATIME
     C*
     C                   WRITE     PEA0#
     C*
     C                   ENDIF
     C*
     C                   ENDSR
     C*
      /free
       //==================================================================
       // srEFTOnly - Check for EFT only flag
       //==================================================================
       Begsr srEFTOnly;

          outEftKey = %Editc(ELemp#:'X') + %Editc(ELdiv:'X') + '  ';
      /end-free
     C                   Z-Add     dsDate        srDti
     C                   Call      'SRCVTDAT'    dtCymd
     C                   MoveL     srDto         outDate
      /free
          outCo#  = %editc(BLco#:'X');
          outFnd# = %editc(BLfnd:'X');
          //If not GetEftStatus(outCo#:OutEftType:outFnd#:outEftKey:outDate:
          // outPreNote);
          outFyr =  %editc(BLfyr:'X');
          outEnv = qqQte;
          If not GetEftStatus(outCo#:OutEftType:outFnd#:outEftKey:outDate:
           outPreNote:outRrn:outEobT:outCkTp:outFyr:outEnv);

             ##key# = %char(ELbscd);
             Chain (ELco#:##key#) pbs01;
             If %found and BSeftf = 'Y';
                *in93 = *on;
                leaveSr;
             Endif;
          Endif;

       Endsr;

      /end-free
      *==============================================================
      * SRACH# - SKIP if ACH/Payroll Vendor# required but not entered
      *==============================================================
     C     SRACH#        BEGSR
      *
      * If billing schedule code is Twice Monthly or Weekly, check for
      * either no ACH record or Payroll vendor # being entered
      *
     C     QQEMP#        IFEQ      *ZEROS
     C     QQQTE         ANDNE     'Q'
      *
     C     ELARSM        IFEQ      'Y'
     C     EMSTRP        ANDEQ     'Y'
     C     ELARSM        OREQ      *BLANK
     C                   MOVEL     ELBSCD        XXKEY
     C     TBKEY         CHAIN     PBS01                              60
     C                   MOVE      *OFF          DBFLAG            1
     C                   MOVE      *OFF          VHFLAG            1
      *
     C  N60BSFREQ        IFEQ      'T'
     C     BSFREQ        OREQ      'W'
      *
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXRNDT            7 0
     C     XXRNDT        IFLT      ELPFDT
     C                   Z-ADD     ELPFDT        KKRNDT            7 0
     C                   ELSE
     C                   Z-ADD     XXRNDT        KKRNDT
     C                   ENDIF
      *
     C     VNDRFL        IFEQ      *ON
      *
     C                   MOVE      *OFF          VHFLAG            1
     C     VHKY1         SETGT     PVH01
     C     ELKEY         READPE    PVH01                                  60
     C     *IN60         IFEQ      *OFF
     C     VHEXDT        ANDEQ     *ZERO
     C     *IN60         OREQ      *OFF
     C     XXRNDT        ANDLT     VHEXDT
     C                   MOVE      *ON           VHFLAG
     C                   ENDIF                                                  *IN60 IFEQ
      *
     C                   ENDIF                                                  VNDRFL IFEQ
      *
     C     ACHFLG        IFEQ      *ON
     C*
     C* check if new ACH module is installed ('WC1806')
     C*
     C                   if        xxnach = *off
     C     EMKEY         chain     pef01                              62
     C     *in62         doweq     *off
     C     XXRNDT        iflt      efexdt
     C     XXRNDT        andge     efefdt
     C     efexdt        oreq      *zero
     C     XXRNDT        andge     efefdt
     C*
     C                   MOVE      *ON           DBFLAG            1
     C                   leave
     C                   endif
     C     EMKEY         reade     pef01                                       62
     C                   enddo
     C                   else
      *
     C     DBKY1         SETGT     PDB01
     C     EMKEY         READPE    PDB01                                  60
     C     *IN60         IFEQ      *OFF
     C     DBEXDT        ANDEQ     *ZERO
     C     *IN60         OREQ      *OFF
     C     XXRNDT        ANDLT     DBEXDT
     C                   MOVE      *ON           DBFLAG            1
     C                   ENDIF                                                  *IN60 = *OFF(PDB01)
     C                   ENDIF
     C                   ENDIF                                                  ACHFLG IFEQ
      *
      *
      *
     C     DBFLAG        IFEQ      *OFF
     C     VHFLAG        ANDEQ     *OFF
     C                   SETON                                            93
     C                   ENDIF                                                  VNDRFL = 'Y'
      *
     C                   ENDIF                                                  BSFREQ = T/W
      *
     C                   ENDIF                                                  ELARSM = Y
      *
     C                   ENDIF                                                  QQEMP# <> 0
      *
     C                   ENDSR                                                  SRACH#
     C*
      *
      *==============================================================
      * SRCAP# - SKIP if Carrier Policy Num required but not entered
      *==============================================================
      *
     C     SRCAP#        BEGSR
      *
      *  Do not allow billing if carrier policy number has not been
      *  entered and carrier policy number is required.
      *
     C                   MOVE      'Y'           XXCAP#            1
      *
     C     QQQTE         IFNE      'Q'
     C     GCKY          CHAIN     PGC01                              60
      *
     C     *IN60         IFEQ      *OFF
     C     GCCRFL        ANDEQ     'Y'
      *
     C                   CLEAR                   RPCAP#
      * Check all the Divsions for missing Carrier ID
     C     RPKY          SETLL     PEL02
     C     RPKY          READE     PEL02                                  61
      *
     C**N61**    RPKY2     CHAINPRP01                60
     C     *IN61         DOWEQ     *OFF
     C     RPKY2         CHAIN     PRP01                              60
     C     RPCAP#        IFEQ      *BLANKS
     C     *IN60         OREQ      *ON
     C                   MOVE      'N'           XXCAP#
     C                   SETON                                            61
     C                   LEAVE
     C                   ENDIF                                                  RPCAP# = BLANKS
      *
     C  N61RPKY          READE     PEL02                                  61
     C                   ENDDO
      *
     C                   ENDIF                                                  XCFL01 = Y
      *
     C                   ENDIF                                                  QQQTE <> Q
      *
     C                   ENDSR                                                  SRCAP#
      *
      *==============================================================
      * SRDBCR - SKIP if DEBIT/CREDT factor exceeds maximum entered
      *==============================================================
     C     SRDBCR        BEGSR
      *
     C                   MOVE      'Y'           XXDBCR            1
      *
     C     QQQTE         IFNE      'Q'
     C     XXCAP#        ANDEQ     'Y'
     C     ELFAF         ANDNE     'R'
      *
     C     RPKY          SETLL     PEL02
     C     RPKY          READE     PEL02                                  61
      *
     C     *IN61         DOWEQ     *OFF
      *
     C     RSKY1         CHAIN     PRS01                              61
      *
     C     *IN61         IFEQ      *OFF
     C     RRKY3         SETGT     PRR01
     C     RRKY4         READPE    PRR01                                  61
      *
     C     *IN61         IFEQ      *OFF
     C     ELDBCR        ANDNE     *ZERO
      *
     C     ELDBCR        IFGT      1.0
      *
     C     ELDBCR        IFGT      RRDMAX
     C     RRDMAX        ANDNE     *ZERO
     C                   MOVE      'N'           XXDBCR
     C                   LEAVE
     C                   ENDIF                                                  RRDMAX
      *
     C                   ENDIF                                                  ELDBCR > 1
      *
     C     ELDBCR        IFLT      1.0
      *
     C     ELDBCR        IFLT      RRCMAX
     C     RRCMAX        ANDNE     *ZERO
     C                   MOVE      'N'           XXDBCR
     C                   LEAVE
     C                   ENDIF                                                  RRCMAX
      *
     C                   ENDIF                                                  ELDBCR < 1
      *
     C                   ENDIF                                                  RRKY
      *
     C                   ENDIF                                                  RSKY
      *
     C     RPKY          READE     PEL02                                  61
     C                   ENDDO
      *
     C                   ENDIF                                                  QQQTE <> Q
      *
     C                   ENDSR                                                  SRDBCR
      *
     C***************************************************************
     C*                   SUBROUTINE SRPYRL
     C*   SUBROUTINE TO SPLIT ANNIV RATING PAYROLLS - IF NOT ALREADY
     C*   SPLIT.
     C*   ONCE THE ANNIV PAYROLL EXISTS, IT WILL NEVER BE UPDATED BY
     C*   THE BILLING PROGRAM - UNLESS THE STATUS IS INACTIVE.  THIS
     C*   GIVES THE USER THE FLEXIBILTIY TO CHANGE PAYROLL AMOUNTS IF
     C*   NECESSARY.
     C*   IF THE PAYROLL INCREASES THOUGHOUT THE YEAR, THE USER MUST
     C*   MANUALLY PRORATE THE INCREASE & APPLY IT TO EACH PERIOD.
     C*
     C***************************************************************
     C     SRPYRL        BEGSR
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C     EPSTAT        IFNE      'I'
     C*
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C                   Z-ADD     EPCLAS        SVCLAS            5 0
     C                   MOVE      EPSPEC        SVSPEC            1
     C                   MOVEL     EPEXT         SVEXT             5
     C                   Z-ADD     EPEAPR        SVEAPR           11 2
     C                   Z-ADD     EPADLD        SVADLD           15 4
     C                   Z-ADD     XXANDT        X1EFDT
     C     SVEFDT        IFLT      XXANDT
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     XXANDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             S2CLAS            5 0
     C                   Z-ADD     0             S3CLAS            5 0
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C*
     C     *IN60         IFEQ      *OFF
     C     PREXDT        ANDLT     XXANDT
     C     PRXFER        ANDNE     *ZEROS
     C                   Z-ADD     SVCLAS        S2CLAS
     C                   Z-ADD     PRXFER        S3CLAS
     C                   Z-ADD     PRXFER        SVCLAS
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C*
     C*  IF STATUS ON PAYROLL IS INACTIVE, THEN UPDATE THE PAYROLL
     C*  AMOUNT.
     C*
     C  N60EPSTAT        COMP      'I'                                    60
     C*
     C     *IN60         IFEQ      *OFF
     C     S2CLAS        ANDNE     *ZERO
     C                   Z-ADD     S2CLAS        SVCLAS
     C                   ENDIF
     C     *IN60         IFEQ      '1'
     C*
     C*  ANNUAL PAYROLL AMOUNTS ARE ALWAYS BEING ENTERED WITH EFFECTIVE
     C*  DATE EQUAL TO THE POLICY FROM DT EVEN IF THE CLASS WAS
     C*  ENTERED MID YEAR.  THEREFORE PRORATING PAYROLLS WILL NOT APPLY
     C*
     C*  THE FACTOR FOR SPLITTING PAYROLLS FOR ANNIV RATING IS
     C*  CALCULATED BASED ON THE TOTAL FUND YEAR DAYS SINCE ANY
     C*  PRORATING IS APPLIED ONLY AFTER ALL CALCS ARE APPLIED.
     C*
     C*
     C     ELPROR        IFNE      1
     C     EPEFDT        ANDEQ     ELPFDT
     C                   Z-ADD     FDAYS         PPDAYS
     C                   ELSE
     C                   Z-ADD     SVEFDT        XPEFDT            7 0
     C*
     C*  GET NUMBER OF PAYROLL DAYS
     C*
     C                   Z-ADD     XPEFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PPDAYS            5 0
     C*
     C                   ENDIF                                                  ELPROR
     C*
     C     PPDAYS        IFNE      0
     C*
     C                   Z-ADD     0             FACT1
     C     PPDAYS        IFNE      0
     C     PDAYS2        DIV(H)    PPDAYS        FACT1             5 4
     C                   END
     C*
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C     SVEAPR        MULT(H)   FACT1         X2EAPR           11 0
     C     SVEAPR        SUB       X2EAPR        X1EAPR           11 0
     C     SVADLD        MULT(H)   FACT1         X2ADLD           11 0
     C     SVADLD        SUB       X2ADLD        X1ADLD           11 0
     C*
     C                   WHEN      PRPCF = 'C'
     C     sveapr        mult(h)   fact1         x4eapr
     C     sveapr        sub       x4eapr        x3eapr
     C     svadld        mult(h)   fact1         x4adld           11 2
     C     svadld        sub       x4adld        x3adld           11 2
      * Don't split payroll amounts on population rated payrolls. Each
      * period gets the total payroll amount. The premium gets split into
      * each period, but not the payroll amount.
     c                   when      PRPCF = 'O'
     c                   eval      x1eapr = sveapr
     c                   eval      x2eapr = sveapr
     c                   eval      x1adld = svadld
     c                   eval      x2adld = svadld
     C                   ENDSL
     C*
     C                   Z-ADD     SVEFDT        X1EFDT
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     EPCLAS        IFEQ      RRDCCD
     C     PRPCF         OREQ      'O'
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C                   Z-ADD     SVEAPR        X1EAPR
     C                   Z-ADD     SVEAPR        X2EAPR
     C                   Z-ADD     SVADLD        X2ADLD
     C                   Z-ADD     SVADLD        X1ADLD
     C                   WHEN      PRPCF = 'C'
     C                   Z-ADD     SVEAPR        X3EAPR
     C                   Z-ADD     SVEAPR        X4EAPR
     C                   Z-ADD     SVADLD        X3ADLD
     C                   Z-ADD     SVADLD        X4ADLD
     C                   ENDSL
     C                   ENDIF                                                  EPCLAS IFEQ
     C*
     C     S2CLAS        IFNE      *ZERO
     C                   Z-ADD     S2CLAS        SVCLAS
     C                   ENDIF
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EPDT
     C                   MOVEL     Q1USER        EPUSER
     C                   MOVEL     Q1PGM         EPPGM
     C*
     C*  UPDATE BEGINNING PAYROLL
     C*
     c                   select
     c                   when      prpcf = 'C'
     c                   z-add     x3eapr        epeapr
     c                   z-add     x3adld        epadld
     c                   other
     C                   Z-ADD     X1EAPR        EPEAPR
     C                   Z-ADD     X1ADLD        EPADLD
     C                   endsl
     C                   UPDATE    PEP01
     C*
     C*  WRITE OR UPDATE PAYROLL STARTING ON ANNIV DATE
     C*  UPDATE OCCURS WHEN THE STATUS IS INACTIVE
     C*
     C                   Z-ADD     XXANDT        X1EFDT
     C     S3CLAS        IFNE      *ZERO
     C                   Z-ADD     S3CLAS        SVCLAS
     C                   Z-ADD     S3CLAS        EPCLAS
     C                   ENDIF
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSTIME        EPTIME
     C                   Z-ADD     0             EPSAPR
     C                   MOVE      'E'           EPSAFL
     C                   Z-ADD     0             EPAAPR
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   Z-ADD     XXANDT        EPEFDT
     C
     C                   select
     C                   when      prpcf = 'C'
     C                   z-add     x4eapr        epeapr
     C                   z-add     x4adld        epadld
     C                   other
     C                   z-add     x2eapr        epeapr
     C                   z-add     x2adld        epadld
     C                   endsl
     C*
     C     *IN60         IFEQ      '0'
     C                   MOVE      'A'           EPSTAT
     C                   UPDATE    PEP01
     C                   ELSE
     C                   WRITE     PEP01
     C                   END
     C*
     C                   END                                                    PDAYS NE 0
     C*
     C                   END                                                    *IN60 = '1'
     C*
     C                   END                                                    SVEFDT < ANDT
     C                   Z-ADD     9999999       X1EFDT
     C     EPKEY2        SETGT     PEP01
     C*
     C                   END                                                    EPSTAT NE 'I'
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   END
     C*
     C                   ENDSR
     C*
      *================================================================
      * SR#DAY - GET NUMBER OF DAYS IN EACH RATING PERIOD FOR A RATE SPLIT
      *================================================================
     C     SR#DAY        BEGSR
     C*
     C                   Z-ADD     0             RDAYS1            5 0
     C                   Z-ADD     0             RDAYS2            5 0
     C                   Z-ADD     ELPFDT        XXFDT             7 0
     C                   Z-ADD     ELPTDT        XXTDT             7 0
     C                   Z-ADD     PDAYS         RDAYS             5 0
     C*
     C     *IN78         IFEQ      *OFF
     C*
     C     SPLTDT        IFGT      XXANDT
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     XXANDT        XXFDT
     C                   Z-ADD     ELPTDT        XXTDT
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     ELPFDT        XXFDT
     C                   Z-ADD     XXANDT        XXTDT
     C                   ENDIF
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXTDT
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C* FIND # DAYS IN FIRST PERIOD.
     C*
     C                   Z-ADD     XXFDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     SPLTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     1090701
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS1
     C     RDAYS         SUB       RDAYS1        RDAYS2
     C*
     C                   ENDSR
     C*================================================================
     C*                   SUBROUTINE SRXSPL
     C*   SUBROUTINE TO SPLIT PAYROLLS IF NOT ALREADY SPLIT FOR STATE
     C*   MANDATED SPLIT RATE DATES
     C*   ONCE THE SPLIT PAYROLL EXISTS, IT WILL NEVER BE UPDATED BY
     C*   THE BILLING PROGRAM - UNLESS THE STATUS IS INACTIVE.  THIS
     C*   GIVES THE USER THE FLEXIBILTIY TO CHANGE PAYROLL AMOUNTS IF
     C*   NECESSARY.
     C*   IF THE PAYROLL INCREASES THOUGHOUT THE YEAR, THE USER MUST
     C*   MANUALLY PRORATE THE INCREASE & APPLY IT TO EACH PERIOD.
     C*================================================================
     C     SRXSPL        BEGSR
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C     EPSTAT        IFNE      'I'
     C     EPEFDT        ANDGE     XXFDT
     C*
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C                   Z-ADD     EPCLAS        SVCLAS            5 0
     C                   MOVE      EPSPEC        SVSPEC            1
     C                   MOVEL     EPEXT         SVEXT             5
     C                   Z-ADD     EPEAPR        SVEAPR           11 2
     C                   Z-ADD     EPADLD        SVADLD           15 4
     C                   Z-ADD     SPLTDT        X1EFDT
     C     SVEFDT        IFLT      SPLTDT
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C*
     C*  IF STATUS ON PAYROLL IS INACTIVE, THEN UPDATE THE PAYROLL
     C*  AMOUNT.
     C*
     C  N60EPSTAT        COMP      'I'                                    60
     C*
     C     *IN60         IFEQ      '1'
     C*
     C*  ANNUAL PAYROLL AMOUNTS ARE ALWAYS BEING ENTERED WITH EFFECTIVE
     C*  DATE EQUAL TO THE POLICY FROM DT EVEN IF THE CLASS WAS
     C*  ENTERED MID YEAR.  THEREFORE PRORATING PAYROLLS WILL NOT APPLY
     C*
     C*  THE FACTOR FOR SPLITTING PAYROLLS FOR ANNIV RATING IS
     C*  CALCULATED BASED ON THE TOTAL FUND YEAR DAYS SINCE ANY
     C*  PRORATING IS APPLIED ONLY AFTER ALL CALCS ARE APPLIED.
     C*
     C*
     C     ELPROR        IFNE      1
     C     EPEFDT        ANDEQ     ELPFDT
     C                   Z-ADD     RDAYS         PPDAYS
     C                   ELSE
     C*
     C                   Z-ADD     SVEFDT        XPEFDT            7 0
     C*
     C*  GET NUMBER OF PAYROLL DAYS
     C*
     C                   Z-ADD     XPEFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXTDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PPDAYS            5 0
     C*
     C                   ENDIF                                                  ELPROR
     C*
     C     PPDAYS        IFNE      0
     C*
     C                   Z-ADD     0             FACT1
     C     PPDAYS        IFNE      0
     C     RDAYS2        DIV(H)    PPDAYS        FACT1             5 4
     C                   END
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C     SVEAPR        MULT(H)   FACT1         X2EAPR           11 0
     C     SVEAPR        SUB       X2EAPR        X1EAPR           11 0
     C     SVADLD        MULT(H)   FACT1         X2ADLD           11 0
     C     SVADLD        SUB       X2ADLD        X1ADLD           11 0
     C                   WHEN      PRPCF = 'C'
     C     sveapr        mult(h)   fact1         x4eapr
     C     sveapr        sub       x4eapr        x3eapr
     C     svadld        mult(h)   fact1         x4adld           11 2
     C     svadld        sub       x4adld        x3adld           11 2
     C                   ENDSL
     C                   Z-ADD     SVEFDT        X1EFDT
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     EPCLAS        IFEQ      RRDCCD
     C     PRPCF         OREQ      'O'
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C                   Z-ADD     SVEAPR        X1EAPR
     C                   Z-ADD     SVEAPR        X2EAPR
     C                   Z-ADD     SVADLD        X2ADLD
     C                   Z-ADD     SVADLD        X1ADLD
     C                   WHEN      PRPCF = 'C'
     C                   Z-ADD     SVEAPR        X3EAPR
     C                   Z-ADD     SVEAPR        X4EAPR
     C                   Z-ADD     SVADLD        X3ADLD
     C                   Z-ADD     SVADLD        X4ADLD
     C                   ENDSL
     C                   ENDIF                                                  EPCLAS IFEQ
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EPDT
     C                   MOVEL     Q1USER        EPUSER
     C                   MOVEL     Q1PGM         EPPGM
     C*
     C*  UPDATE BEGINNING PAYROLL
     C*
     c                   select
     c                   when      prpcf = 'C'
     c                   z-add     x3eapr        epeapr
     c                   z-add     x3adld        epadld
     c                   other
     C                   Z-ADD     X1EAPR        EPEAPR
     C                   Z-ADD     X1ADLD        EPADLD
     C                   endsl
     C                   UPDATE    PEP01
     C*
     C*  WRITE OR UPDATE PAYROLL STARTING ON RATE CHANGE DATE
     C*  UPDATE OCCURS WHEN THE STATUS IS INACTIVE
     C*
     C                   Z-ADD     SPLTDT        X1EFDT
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSTIME        EPTIME
     C                   Z-ADD     0             EPSAPR
     C                   MOVE      'E'           EPSAFL
     C                   Z-ADD     0             EPAAPR
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   Z-ADD     SPLTDT        EPEFDT
     C*
     C                   select
     C                   when      prpcf = 'C'
     C                   z-add     x4eapr        epeapr
     C                   z-add     x4adld        epadld
     C                   other
     C                   z-add     x2eapr        epeapr
     C                   z-add     x2adld        epadld
     C                   endsl
     C
     C     *IN60         IFEQ      '0'
     C                   MOVE      'A'           EPSTAT
     C                   UPDATE    PEP01
     C                   ELSE
     C                   WRITE     PEP01
     C                   END
     C*
     C                   END                                                    PDAYS NE 0
     C*
     C                   END                                                    *IN60 = '1'
     C*
     C                   END                                                    SVEFDT < ANDT
     C                   Z-ADD     9999999       X1EFDT
     C     EPKEY2        SETGT     PEP01
     C*
     C                   END                                                    EPSTAT NE 'I'
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   END
     C*
     C                   ENDSR                                                  SRFLRT
     C*                   SUBROUTINE SRFLRT
     C*   SUBROUTINE TO SPLIT PAYROLLS IF NOT ALREADY SPLIT FOR FL RATE
     C*   CHANGE OF 4/1/3.
     C*   ONCE THE SPLIT PAYROLL EXISTS, IT WILL NEVER BE UPDATED BY
     C*   THE BILLING PROGRAM - UNLESS THE STATUS IS INACTIVE.  THIS
     C*   GIVES THE USER THE FLEXIBILTIY TO CHANGE PAYROLL AMOUNTS IF
     C*   NECESSARY.
     C*   IF THE PAYROLL INCREASES THOUGHOUT THE YEAR, THE USER MUST
     C*   MANUALLY PRORATE THE INCREASE & APPLY IT TO EACH PERIOD.
     C*
     C***************************************************************
     C     SRFLRT        BEGSR
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C     EPSTAT        IFNE      'I'
     C     EPEFDT        ANDGE     XXFDT
     C*
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C                   Z-ADD     EPCLAS        SVCLAS            5 0
     C                   MOVE      EPSPEC        SVSPEC            1
     C                   MOVEL     EPEXT         SVEXT             5
     C                   Z-ADD     EPEAPR        SVEAPR           11 2
     C                   Z-ADD     EPADLD        SVADLD           15 4
     C                   Z-ADD     1030401       X1EFDT
     C     SVEFDT        IFLT      1030401
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C*
     C*  IF STATUS ON PAYROLL IS INACTIVE, THEN UPDATE THE PAYROLL
     C*  AMOUNT.
     C*
     C  N60EPSTAT        COMP      'I'                                    60
     C*
     C     *IN60         IFEQ      '1'
     C*
     C*  ANNUAL PAYROLL AMOUNTS ARE ALWAYS BEING ENTERED WITH EFFECTIVE
     C*  DATE EQUAL TO THE POLICY FROM DT EVEN IF THE CLASS WAS
     C*  ENTERED MID YEAR.  THEREFORE PRORATING PAYROLLS WILL NOT APPLY
     C*
     C*  THE FACTOR FOR SPLITTING PAYROLLS FOR ANNIV RATING IS
     C*  CALCULATED BASED ON THE TOTAL FUND YEAR DAYS SINCE ANY
     C*  PRORATING IS APPLIED ONLY AFTER ALL CALCS ARE APPLIED.
     C*
     C*
     C     ELPROR        IFNE      1
     C     EPEFDT        ANDEQ     ELPFDT
     C                   Z-ADD     RDAYS         PPDAYS
     C                   ELSE
     C*
     C                   Z-ADD     SVEFDT        XPEFDT            7 0
     C*
     C*  GET NUMBER OF PAYROLL DAYS
     C*
     C                   Z-ADD     XPEFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXTDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PPDAYS            5 0
     C*
     C                   ENDIF                                                  ELPROR
     C*
     C     PPDAYS        IFNE      0
     C*
     C                   Z-ADD     0             FACT1
     C     PPDAYS        IFNE      0
     C     RDAYS2        DIV(H)    PPDAYS        FACT1             5 4
     C                   END
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C     SVEAPR        MULT(H)   FACT1         X2EAPR           11 0
     C     SVEAPR        SUB       X2EAPR        X1EAPR           11 0
     C     SVADLD        MULT(H)   FACT1         X2ADLD           11 0
     C     SVADLD        SUB       X2ADLD        X1ADLD           11 0
     C                   WHEN      PRPCF = 'C'
     C     sveapr        mult(h)   fact1         x4eapr
     C     sveapr        sub       x4eapr        x3eapr
     C     svadld        mult(h)   fact1         x4adld           11 2
     C     svadld        sub       x4adld        x3adld           11 2
     C                   ENDSL
     C                   Z-ADD     SVEFDT        X1EFDT
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     EPCLAS        IFEQ      RRDCCD
     C     PRPCF         OREQ      'O'
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C                   Z-ADD     SVEAPR        X1EAPR
     C                   Z-ADD     SVEAPR        X2EAPR
     C                   Z-ADD     SVADLD        X2ADLD
     C                   Z-ADD     SVADLD        X1ADLD
     C                   WHEN      PRPCF = 'C'
     C                   Z-ADD     SVEAPR        X3EAPR
     C                   Z-ADD     SVEAPR        X4EAPR
     C                   Z-ADD     SVADLD        X3ADLD
     C                   Z-ADD     SVADLD        X4ADLD
     C                   ENDSL
     C                   ENDIF                                                  EPCLAS IFEQ
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EPDT
     C                   MOVEL     Q1USER        EPUSER
     C                   MOVEL     Q1PGM         EPPGM
     C*
     C*  UPDATE BEGINNING PAYROLL
     C*
     c                   select
     c                   when      prpcf = 'C'
     c                   z-add     x3eapr        epeapr
     c                   z-add     x3adld        epadld
     c                   other
     C                   Z-ADD     X1EAPR        EPEAPR
     C                   Z-ADD     X1ADLD        EPADLD
     c                   endsl
     C                   UPDATE    PEP01
     C*
     C*  WRITE OR UPDATE PAYROLL STARTING ON RATE CHANGE DATE
     C*  UPDATE OCCURS WHEN THE STATUS IS INACTIVE
     C*
     C                   Z-ADD     1030401       X1EFDT
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSTIME        EPTIME
     C                   Z-ADD     0             EPSAPR
     C                   MOVE      'E'           EPSAFL
     C                   Z-ADD     0             EPAAPR
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   Z-ADD     1030401       EPEFDT
     C*
     C                   select
     C                   when      prpcf = 'C'
     C                   z-add     x4eapr        epeapr
     C                   z-add     x4adld        epadld
     C                   other
     C                   z-add     x2eapr        epeapr
     C                   z-add     x2adld        epadld
     C                   endsl
     C
     C*
     C     *IN60         IFEQ      '0'
     C                   MOVE      'A'           EPSTAT
     C                   UPDATE    PEP01
     C                   ELSE
     C                   WRITE     PEP01
     C                   END
     C*
     C                   END                                                    PDAYS NE 0
     C*
     C                   END                                                    *IN60 = '1'
     C*
     C                   END                                                    SVEFDT < ANDT
     C                   Z-ADD     9999999       X1EFDT
     C     EPKEY2        SETGT     PEP01
     C*
     C                   END                                                    EPSTAT NE 'I'
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   END
     C*
     C                   ENDSR                                                  SRFLRT
      *===============================================================
      * DE RATE SPLIT FOR 10/01/08
      *   SUBROUTINE TO SPLIT PAYROLLS IF NOT ALREADY SPLIT FOR DE RATE
      *   CHANGE OF 10/01/08.
      *   ONCE THE SPLIT PAYROLL EXISTS, IT WILL NEVER BE UPDATED BY
      *   THE BILLING PROGRAM - UNLESS THE STATUS IS INACTIVE.  THIS
      *   GIVES THE USER THE FLEXIBILTIY TO CHANGE PAYROLL AMOUNTS IF
      *   NECESSARY.
      *   IF THE PAYROLL INCREASES THOUGHOUT THE YEAR, THE USER MUST
      *   MANUALLY PRORATE THE INCREASE & APPLY IT TO EACH PERIOD.
      *===============================================================
     C     SRDERT        BEGSR
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C     EPSTAT        IFNE      'I'
     C     EPEFDT        ANDGE     XXFDT
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C                   Z-ADD     EPCLAS        SVCLAS            5 0
     C                   MOVE      EPSPEC        SVSPEC            1
     C                   MOVEL     EPEXT         SVEXT             5
     C                   Z-ADD     EPEAPR        SVEAPR           11 2
     C                   Z-ADD     EPADLD        SVADLD           15 4
     C                   Z-ADD     1081001       X1EFDT
     C*
     C     SVEFDT        IFLT      1081001
     C     EPKEY2        CHAIN     PEP01                              60
     C*
     C*  IF STATUS ON PAYROLL IS INACTIVE, THEN UPDATE THE PAYROLL
     C*  AMOUNT.
     C*
     C  N60EPSTAT        COMP      'I'                                    60
     C     *IN60         IFEQ      '1'
     C*
     C*  ANNUAL PAYROLL AMOUNTS ARE ALWAYS BEING ENTERED WITH EFFECTIVE
     C*  DATE EQUAL TO THE POLICY FROM DT EVEN IF THE CLASS WAS
     C*  ENTERED MID YEAR.  THEREFORE PRORATING PAYROLLS WILL NOT APPLY
     C*  THE FACTOR FOR SPLITTING PAYROLLS FOR ANNIV RATING IS
     C*  CALCULATED BASED ON THE TOTAL FUND YEAR DAYS SINCE ANY
     C*  PRORATING IS APPLIED ONLY AFTER ALL CALCS ARE APPLIED.
     C*
     C     ELPROR        IFNE      1
     C     EPEFDT        ANDEQ     ELPFDT
     C                   Z-ADD     RDAYS         PPDAYS
     C                   ELSE
     C*
     C*  GET NUMBER OF PAYROLL DAYS
     C*
     C                   Z-ADD     SVEFDT        XPEFDT            7 0
     C                   Z-ADD     XPEFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXTDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C                   EXSR      SRLEAP
     C                   Z-ADD     QQDAYS        PPDAYS            5 0
     C                   ENDIF                                                  ELPROR
     C*
     C     PPDAYS        IFNE      0
     C                   Z-ADD     0             FACT1
     C     PPDAYS        IFNE      0
     C     RDAYS2        DIV(H)    PPDAYS        FACT1             5 4
     C                   END
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C     SVEAPR        MULT(H)   FACT1         X2EAPR           11 0
     C     SVEAPR        SUB       X2EAPR        X1EAPR           11 0
     C     SVADLD        MULT(H)   FACT1         X2ADLD           11 0
     C     SVADLD        SUB       X2ADLD        X1ADLD           11 0
     C*
     C                   WHEN      PRPCF = 'C'
     C     sveapr        mult(h)   fact1         x4eapr
     C     sveapr        sub       x4eapr        x3eapr
     C     svadld        mult(h)   fact1         x4adld           11 2
     C     svadld        sub       x4adld        x3adld           11 2
     C                   ENDSL
     C                   Z-ADD     SVEFDT        X1EFDT
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     EPCLAS        IFEQ      RRDCCD
     C     PRPCF         OREQ      'O'
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C                   Z-ADD     SVEAPR        X1EAPR
     C                   Z-ADD     SVEAPR        X2EAPR
     C                   Z-ADD     SVADLD        X2ADLD
     C                   Z-ADD     SVADLD        X1ADLD
     C                   WHEN      PRPCF = 'C'
     C                   Z-ADD     SVEAPR        X3EAPR
     C                   Z-ADD     SVEAPR        X4EAPR
     C                   Z-ADD     SVADLD        X3ADLD
     C                   Z-ADD     SVADLD        X4ADLD
     C                   ENDSL
     C                   ENDIF                                                  EPCLAS IFEQ
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EPDT
     C                   MOVEL     Q1USER        EPUSER
     C                   MOVEL     Q1PGM         EPPGM
     C*
     C*  UPDATE BEGINNING PAYROLL
     C*
     c                   select
     c                   when      prpcf = 'C'
     c                   z-add     x3eapr        epeapr
     c                   z-add     x3adld        epadld
     c                   other
     C                   Z-ADD     X1EAPR        EPEAPR
     C                   Z-ADD     X1ADLD        EPADLD
     C                   endsl
     C                   UPDATE    PEP01
     C*
     C*  WRITE OR UPDATE PAYROLL STARTING ON RATE CHANGE DATE
     C*  UPDATE OCCURS WHEN THE STATUS IS INACTIVE
     C*
     C                   Z-ADD     1081001       X1EFDT
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSTIME        EPTIME
     C                   Z-ADD     0             EPSAPR
     C                   MOVE      'E'           EPSAFL
     C                   Z-ADD     0             EPAAPR
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   Z-ADD     1081001       EPEFDT
     C*
     C                   select
     C                   when      prpcf = 'C'
     C                   z-add     x4eapr        epeapr
     C                   z-add     x4adld        epadld
     C                   other
     C                   z-add     x2eapr        epeapr
     C                   z-add     x2adld        epadld
     C                   endsl
     C*
     C     *IN60         IFEQ      '0'
     C                   MOVE      'A'           EPSTAT
     C                   UPDATE    PEP01
     C                   ELSE
     C                   WRITE     PEP01
     C                   END
     C*
     C                   END                                                    PDAYS NE 0
     C                   END                                                    *IN60 = '1'
     C                   END                                                    SVEFDT < ANDT
     C*
     C                   Z-ADD     9999999       X1EFDT
     C     EPKEY2        SETGT     PEP01
     C                   END                                                    EPSTAT NE 'I'
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   END
     C*
     C                   ENDSR                                                  SRDERT
      *==============================================================
     C*                   SUBROUTINE SRFLR2
     C*   SUBROUTINE TO SPLIT PAYROLLS IF NOT ALREADY SPLIT FOR FL RATE
     C*   CHANGE OF 10/1/3.
     C*   ONCE THE SPLIT PAYROLL EXISTS, IT WILL NEVER BE UPDATED BY
     C*   THE BILLING PROGRAM - UNLESS THE STATUS IS INACTIVE.  THIS
     C*   GIVES THE USER THE FLEXIBILTIY TO CHANGE PAYROLL AMOUNTS IF
     C*   NECESSARY.
     C*   IF THE PAYROLL INCREASES THOUGHOUT THE YEAR, THE USER MUST
     C*   MANUALLY PRORATE THE INCREASE & APPLY IT TO EACH PERIOD.
     C*
     C***************************************************************
     C     SRFLR2        BEGSR
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C     EPSTAT        IFNE      'I'
     C     EPEFDT        ANDGE     XXFDT
     C*
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C                   Z-ADD     EPCLAS        SVCLAS            5 0
     C                   MOVE      EPSPEC        SVSPEC            1
     C                   MOVEL     EPEXT         SVEXT             5
     C                   Z-ADD     EPEAPR        SVEAPR           11 2
     C                   Z-ADD     EPADLD        SVADLD           15 4
     C                   Z-ADD     1031001       X1EFDT
     C     SVEFDT        IFLT      1031001
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C*
     C*  IF STATUS ON PAYROLL IS INACTIVE, THEN UPDATE THE PAYROLL
     C*  AMOUNT.
     C*
     C  N60EPSTAT        COMP      'I'                                    60
     C*
     C     *IN60         IFEQ      '1'
     C*
     C*  ANNUAL PAYROLL AMOUNTS ARE ALWAYS BEING ENTERED WITH EFFECTIVE
     C*  DATE EQUAL TO THE POLICY FROM DT EVEN IF THE CLASS WAS
     C*  ENTERED MID YEAR.  THEREFORE PRORATING PAYROLLS WILL NOT APPLY
     C*
     C*  THE FACTOR FOR SPLITTING PAYROLLS FOR ANNIV RATING IS
     C*  CALCULATED BASED ON THE TOTAL FUND YEAR DAYS SINCE ANY
     C*  PRORATING IS APPLIED ONLY AFTER ALL CALCS ARE APPLIED.
     C*
     C*
     C     ELPROR        IFNE      1
     C     EPEFDT        ANDEQ     ELPFDT
     C                   Z-ADD     RDAYS         PPDAYS
     C                   ELSE
     C*
     C                   Z-ADD     SVEFDT        XPEFDT            7 0
     C*
     C*  GET NUMBER OF PAYROLL DAYS
     C*
     C                   Z-ADD     XPEFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXTDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PPDAYS            5 0
     C*
     C                   ENDIF                                                  ELPROR
     C*
     C     PPDAYS        IFNE      0
     C*
     C                   Z-ADD     0             FACT1
     C     PPDAYS        IFNE      0
     C     RDAYS2        DIV(H)    PPDAYS        FACT1             5 4
     C                   END
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C     SVEAPR        MULT(H)   FACT1         X2EAPR           11 0
     C     SVEAPR        SUB       X2EAPR        X1EAPR           11 0
     C     SVADLD        MULT(H)   FACT1         X2ADLD           11 0
     C     SVADLD        SUB       X2ADLD        X1ADLD           11 0
     C                   WHEN      PRPCF = 'C'
     C     sveapr        mult(h)   fact1         x4eapr
     C     sveapr        sub       x4eapr        x3eapr
     C     svadld        mult(h)   fact1         x4adld           11 2
     C     svadld        sub       x4adld        x3adld           11 2
     C                   ENDSL
     C                   Z-ADD     SVEFDT        X1EFDT
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   Z-ADD     EPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     EPCLAS        IFEQ      RRDCCD
     C     PRPCF         OREQ      'O'
     C                   SELECT
     C                   WHEN      PRPCF = 'P'
     C                   Z-ADD     SVEAPR        X1EAPR
     C                   Z-ADD     SVEAPR        X2EAPR
     C                   Z-ADD     SVADLD        X2ADLD
     C                   Z-ADD     SVADLD        X1ADLD
     C                   WHEN      PRPCF = 'C'
     C                   Z-ADD     SVEAPR        X3EAPR
     C                   Z-ADD     SVEAPR        X4EAPR
     C                   Z-ADD     SVADLD        X3ADLD
     C                   Z-ADD     SVADLD        X4ADLD
     C                   ENDSL
     C                   ENDIF                                                  EPCLAS IFEQ
     C*
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EPDT
     C                   MOVEL     Q1USER        EPUSER
     C                   MOVEL     Q1PGM         EPPGM
     C*
     C*  UPDATE BEGINNING PAYROLL
     C*
     c                   select
     c                   when      prpcf = 'C'
     c                   z-add     x3eapr        epeapr
     c                   z-add     x3adld        epadld
     c                   other
     C                   Z-ADD     X1EAPR        EPEAPR
     C                   Z-ADD     X1ADLD        EPADLD
     C                   endsl
     C                   UPDATE    PEP01
     C*
     C*  WRITE OR UPDATE PAYROLL STARTING ON RATE CHANGE DATE
     C*  UPDATE OCCURS WHEN THE STATUS IS INACTIVE
     C*
     C                   Z-ADD     1031001       X1EFDT
     C     EPKEY2        CHAIN     PEP01                              60
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSTIME        EPTIME
     C                   Z-ADD     0             EPSAPR
     C                   MOVE      'E'           EPSAFL
     C                   Z-ADD     0             EPAAPR
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   Z-ADD     1031001       EPEFDT
     C*
     C                   select
     C                   when      prpcf = 'C'
     C                   z-add     x4eapr        epeapr
     C                   z-add     x4adld        epadld
     C                   other
     C                   z-add     x2eapr        epeapr
     C                   z-add     x2adld        epadld
     C                   endsl
     C*
     C     *IN60         IFEQ      '0'
     C                   MOVE      'A'           EPSTAT
     C                   UPDATE    PEP01
     C                   ELSE
     C                   WRITE     PEP01
     C                   END
     C*
     C                   END                                                    PDAYS NE 0
     C*
     C                   END                                                    *IN60 = '1'
     C*
     C                   END                                                    SVEFDT < ANDT
     C                   Z-ADD     9999999       X1EFDT
     C     EPKEY2        SETGT     PEP01
     C*
     C                   END                                                    EPSTAT NE 'I'
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   END
     C*
     C                   ENDSR                                                  SRFLR2
     C***************************************************************
     C*
     C***************************************************************
     C*                   SUBROUTINE SRDSCT
     C*   SUBROUTINE TO SPREAD DISCOUNTS IF NECESSARY AND TO CALC
     C*   ACCORDING TO THE DISCOUNT TABLE.
     C***************************************************************
     C     SRDSCT        BEGSR
     C*
     C                   Z-ADD     0             XXDISA
     C                   Z-ADD     0             XXTOTS
     C                   Z-ADD     0             XXTDIS
     C     RRDSIN        IFEQ      'Y'
     C                   MOVE      RRST          XXDMST
     C                   ELSE
     C                   MOVE      *BLANKS       XXDMST            2
     C                   ENDIF                                                  RRDSIN IFEQ
      /free
       xxPror = stRptProRt;
      /end-free
     C*
     C*  DETERMINE IF SPREAD IS IN EFFECT
     C*
     C                   MOVE      XXCO#         Q1CO#             3
     C                   MOVE      XXFND         Q1FND             3
     C                   MOVE      XXFYR         Q1FYR             3
     C                   MOVE      XXEMP#        Q1EMP#            9
     C                   MOVE      ' '           Q1SPRD            1
     C                   CALL      'SRDISC'
     C                   PARM                    Q1CO#
     C                   PARM                    Q1FND
     C                   PARM                    Q1FYR
     C                   PARM                    Q1EMP#
     C                   PARM                    Q1SPRD
     C                   MOVE      '0'           *IN62
     C     FNPEOF        IFEQ      'M'
     C     FNPEOA        ANDEQ     'Y'
     C     FNPEOF        OREQ      'G'
     C     FNPEOA        ANDEQ     'Y'
     C     FNPEOF        OREQ      'Y'
     C     FNPEOF        OREQ      'C'
     C     FNPEOA        ANDEQ     'Y'
     C                   MOVE      'Y'           Q1SPRD
     C                   MOVE      '1'           *IN62
     C                   ENDIF
     C*
     C*  IF DISCOUNT IS TO BE SPREAD OVER ALL DIVISIONS, READ
     C*  DISCOUNT DETAIL FILE & ACCUM STD PREM FOR ALL DIV
     C*
     C     Q1SPRD        IFEQ      'Y'
     C*
     C*  USE NEW CALCULATED STD FOR THIS EMPLOYER
     C*
     C                   Z-ADD     0             XXPCT
     C*
     C*** begin add ***  04/27/23  *******************************
      /Free

        Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'P':xxDmst) pev00;
        If %found;
           xxTots = EVxxTots;
        Else;

      /End-Free
     C*** end add *****  04/27/23  *******************************
     C                   Z-ADD     XXPREM        XXTOTS           15 4
     C  N62DSKY          CHAIN     PDS02                              60
     C   62DSKY2         CHAIN     PDS02                              60
     C     *IN60         DOWEQ     '0'
     C     DSDIV         IFNE      XXDIV
     C     FNPEOF        ANDNE     'M'
     C     FNPEOF        ANDNE     'G'
     C     FNPEOF        ANDNE     'Y'
     C     FNPEOF        ANDNE     'C'
     C     DSEMP#        ORNE      XXEMP#
     C     FNPEOF        ANDEQ     'M'
     C     DSDIV         ORNE      XXDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'M'
     C     DSEMP#        ORNE      XXEMP#
     C     FNPEOF        ANDEQ     'G'
     C     DSDIV         ORNE      XXDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'G'
     C     DSEMP#        ORNE      XXEMP#
     C     FNPEOF        ANDEQ     'Y'
     C     DSDIV         ORNE      XXDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'Y'
     C     DSEMP#        ORNE      XXEMP#
     C     FNPEOF        ANDEQ     'C'
     C     DSDIV         ORNE      XXDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'C'
     C     ELKY3         CHAIN     PEL02                              60
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXST
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C                   Exsr      GetCXDT
     C                   If        yycxdt > elpfdt or yycxdt = 0
     C*
     C     *IN60         IFEQ      *OFF
     C     XXDMST        ANDEQ     *BLANKS
     C     *IN60         OREQ      *OFF
     C     XXDMST        ANDNE     *BLANKS
     C     XXST          ANDEQ     XXDMST
     C                   ADD       DSSTPR        XXTOTS
     C                   ENDIF                                                  *IN60 IFEQ
     C                   Endif                                                  yycxdt ...
     C                   END
     C  N62DSKY          READE     PDS02                                  60
     C   62DSKY2         READE     PDS02                                  60
     C                   END
     C*** begin add ***  04/27/23  *******************************
      /Free

           Clear pev00;
           EVCo# = xxCo#;
           EVFnd = xxFnd;
           EVFyr = xxFyr;
           EVEmp# = xxEmp#;
           EVType = 'P';
           EVSt = xxDmst;
           EVxxTots = xxTots;
           Write pev00;
        Endif;
      /End-Free
     C*** end add *****  04/27/23  *******************************
     C                   Z-ADD     XXTOTS        XXLMT            15 4
     C     ELKEY         CHAIN     PEL01                              60
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXST
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C*
     C     XXLMT         IFEQ      0
     C                   Z-ADD     0             XXPCT
     C                   ELSE
     C     XXPREM        DIV(H)    XXLMT         XXPCT
     C*** begin add ***  07/25/23  ***********************************************
     C                   If        xxpct > 1
     C                   Z-add     1             xxpct
     C                   Endif
     C*** end add *****  07/25/23  ***********************************************
     C                   ENDIF                                                  XXLMT IFEQ
     C*
     C                   ELSE
     C*
     C*  IF DISCOUNT NOT SPREAD, JUST LOAD STD PREM OF THIS EMPLR/DIV
     C*  AND MAKE SURE THERE ARE NO RECORDS IN WDDSP FOR THIS EMPLR
     C*
     C                   Z-ADD     XXPREM        XXLMT            15 4
     C                   Z-ADD     1             XXPCT
     C*
     C     TAX           IFEQ      2
     C*
     C*
     C                   ENDIF                                                  TAX IFEQ 2
     C*
     C                   END                                                    Q1SPRD = Y
     C*
     C*  GET THE DISCOUNT BASED ON THE TABLE VALUES
     C*
     C**************************************************
     C                   MOVE      ELDISC        XXCODE
     C                   Z-ADD     RDAT(1)       XXEFDT
     C                   Z-ADD     0             AEFDT
     C                   Z-ADD     0             BEFDT
     C                   Z-ADD     XXDIV         SVDIV
     C                   MOVE      'A'           XXTP
     C     DSKEY         SETGT     PDS01
     C     DSKEY2        READPE    PDS01                                  60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     DSEFDT        AEFDT             7 0
     C                   ENDIF
     C*
     C                   MOVE      'B'           XXTP
     C     DSKEY         SETGT     PDS01
     C     DSKEY2        READPE    PDS01                                  60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     DSEFDT        BEFDT             7 0
     C                   ENDIF
     C*
     C     AEFDT         IFGE      BEFDT
     C                   MOVE      'A'           XXTP
     C                   ELSE
     C                   MOVE      'B'           XXTP
     C                   ENDIF                                                  AEFDT IFGE
     C*
     C     Q1SPRD        IFEQ      'Y'
     C*
     C*** begin add ***  04/27/23  *******************************
      /Free

        Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'D':xxDmst) pev00;
        If %found;
           xxTdis = EVxxTdis;
           If xxTots = *zeros;
              xxPct = *zeros;
           Else;
        //*** begin chg ***  07/25/23  ***********************************************
        //****xxPct = xxPrem/xxTots;
              Monitor;
                 xxPct = xxPrem/xxTots;
              On-error;
                 xxPct = 1;
              Endmon;
        //*** end chg *****  07/25/23  ***********************************************
           Endif;
           xxLmt = xxTots;

           Exsr Sprdd;
           If xxTp ='B';
              xnDisp = DSpct;
           Endif;
           svDisa = xxDisa;
        Else;

      /End-Free
     C*** end add *****  04/27/23  *******************************
     C  N62DSKY          CHAIN     PDS02                              60
     C   62DSKY2         CHAIN     PDS02                              60
     C     *IN60         DOWEQ     '0'
     C*
     C                   Z-ADD     DSDIV         XXDIV
     C     ELKY3         CHAIN     PEL02                              60
     C                   Exsr      GetCXDT
     C                   If        yycxdt > elpfdt or yycxdt = 0
     C                   MOVE      ELRTCD        XXRTCD
     C                   MOVE      ELPFDT        XXEFDT
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C*
     C     XXTOTS        IFEQ      0
     C                   Z-ADD     0             XXPCT
     C                   ELSE
     C     SVDIV         IFEQ      DSDIV
     C     FNPEOF        ANDNE     'M'
     C     FNPEOF        ANDNE     'G'
     C     FNPEOF        ANDNE     'Y'
     C     FNPEOF        ANDNE     'C'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'M'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'G'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'Y'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'C'
     C     XXPREM        DIV(H)    XXTOTS        XXPCT
     C                   ELSE
     C     DSSTPR        DIV(H)    XXTOTS        XXPCT
     C                   ENDIF                                                  SVDIV IFEQ
     C                   ENDIF                                                  XXTOTS IFEQ
     C*** begin add ***  07/25/23  ***********************************************
     C                   If        xxpct > 1
     C                   Z-add     1             xxpct
     C                   Endif
     C*** end add *****  07/25/23  ***********************************************
     C                   Z-ADD     XXTOTS        XXLMT
     C                   Z-ADD     0             XXDISA
     C     SVDIV         IFEQ      DSDIV
     C     FNPEOF        ANDNE     'M'
     C     FNPEOF        ANDNE     'G'
     C     FNPEOF        ANDNE     'Y'
     C     FNPEOF        ANDNE     'C'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'M'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'G'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'Y'
     C     SVDIV         OREQ      DSDIV
     C     DSEMP#        ANDEQ     XXEMP#
     C     FNPEOF        ANDEQ     'C'
     C                   MOVE      'Y'           XXFLG             1
     C                   ENDIF                                                  XXDIV IFEQ
     C*
     C                   EXSR      SPRDD
     C*
     C                   If        xxdmst = '  ' or
     C                             (xxdmst <> '  ' and xxdmst = xxst)
     C                   ADD       XXDISA        XXTDIS           15 4
     C                   Endif
     C     XXFLG         IFEQ      'Y'
     C     XXTP          IFEQ      'B'
     C                   Z-ADD     DSPCT         XNDISP
     C                   ENDIF
     C                   Z-ADD     XXDISA        SVDISA           15 4
     C                   MOVE      *BLANK        XXFLG
     C                   ENDIF                                                  XXFLG IFEQ
     C                   Endif                                                  yycxdt ...
     C*
     C  N62DSKY          READE     PDS02                                  60
     C   62DSKY2         READE     PDS02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*** begin add ***  04/27/23  *******************************
      /Free

           Clear pev00;
           EVCo# = xxCo#;
           EVFnd = xxFnd;
           EVFyr = xxFyr;
           EVEmp# = xxEmp#;
           EVType = 'D';
           EVSt = xxDmst;
           EVxxTdis = xxTdis;
           Write pev00;
        Endif;
      /End-Free
     C*** end add *****  04/27/23  *******************************
     C                   Z-ADD     SVDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C                   Z-ADD     ELPFDT        XXEFDT
     C*
     C                   ELSE
     C*
     C                   EXSR      SPRDD
     C     XXTP          IFEQ      'B'
     C                   Z-ADD     DSPCT         XNDISP
     C                   ENDIF
     C                   Z-ADD     XXDISA        SVDISA           15 4
     C*
     C                   ENDIF                                                  Q1SPRD IFEQ
     C**************************************************
     C*
     C*  LOAD WDDSP IF SPREADING DISCOUNT
     C*
     C     Q1SPRD        IFEQ      'Y'
     C*
     C     *IN97         IFEQ      *OFF
     C     DSKY1         CHAIN     PDS02                              60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     XXCO#         DSCO#
     C                   Z-ADD     XXFND         DSFND
     C                   Z-ADD     XXFYR         DSFYR
     C                   Z-ADD     XXEMP#        DSEMP#
     C                   Z-ADD     XXDIV         DSDIV
     C                   END
     C                   Z-ADD     XXPREM        DSSTPR
     C                   Z-ADD(H)  SVDISA        DSEDIS
     C                   Z-ADD     XXTOTS        DSTEPR
     C                   Z-ADD     XXTDIS        DSTEDS
     C                   Z-ADD     0             XXWK54
     C     XXTOTS        IFNE      0
     C     XXTDIS        DIV(H)    XXTOTS        XXWK54            5 4
     C                   ENDIF
     C     XXWK54        MULT      100           DSEPCT
     C                   Z-ADD     0             DSANSP
     C                   Z-ADD     0             DSACSP
     C                   Z-ADD     0             DSADIS
     C                   Z-ADD     0             DSTANP
     C                   Z-ADD     0             DSTACP
     C                   Z-ADD     0             DSAPCT
     C                   MOVE      *BLANKS       DSSTAT
     C                   MOVE      Q1USER        DSUSER
     C                   MOVE      Q1PGM         DSPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DSDT
     C                   Z-ADD     DSTIME        DSTIME
     C*
     C     TAX           IFEQ      2
     C*
     C  N60              UPDATE    PDS02
     C   60              WRITE     PDS02
     C*
     C                   ENDIF                                                  TAX IFEQ 2
     C                   ENDIF                                                  *IN97 IFEQ
     C*
     C                   Z-ADD     SVDISA        XXDISA
     C*
     C                   ENDIF                                                  Q1SPRD = Y
     C                   Z-ADD     XXDISA        XXDIS3
     C*
     C                   ENDSR
     C*
     C*****************************************************************
     C*
     C*  SUBROUTINE FOR APPLYING A DISCOUNT ON AN ARRAY-SPLIT PREMIUM.
     C*
     C     DISCA         BEGSR
     C*****************************************************************
     C*
     C                   Z-ADD     0             XXDISA           15 4
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     0
     C*
     C     PRM(X)        MULT(H)   XXPCT         XXWK90           15 4
     C                   DIV(H)    100           XXWK90
     C     X             ADD       1             Z                 3 0
     C     XXEFD         IFGT      PDAT(X)
     C     XXEFD         ANDLT     PDAT(Z)
     C     XXEXD         ORGT      PDAT(X)
     C     XXEXD         ANDLT     PDAT(Z)
     C*
     C*  GET NUMBER OF DAYS AFFECTED BY THE DISCOUNT IN THE
     C*  RATING PERIOD
     C*
     C     XXEFD         IFGT      PDAT(X)
     C                   Z-ADD     XXEFD         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   ELSE
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   ENDIF                                                  XXEFD IFGT
     C*
     C     XXEXD         IFLT      PDAT(Z)
     C                   Z-ADD     XXEXD         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   ELSE
     C                   Z-ADD     PDAT(Z)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   ENDIF                                                  XXEXD IFLT
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        VDAYS             5 0
     C*
     C                   Z-ADD     *ZEROS        XXDPRO            5 4
     C*
     C     DYS(X)        IFNE      *ZEROS
     C     VDAYS         DIV(H)    DYS(X)        XXDPRO
     C                   ENDIF                                                  DYS,X IFNE
     C*
     C                   ELSE
     C*
     C     XXEFD         IFLE      PDAT(X)
     C     XXEXD         ANDGE     PDAT(Z)
     C                   Z-ADD     1             XXDPRO
     C*
     C                   ELSE
     C*
     C     XXEFD         IFGE      PDAT(Z)
     C     XXEXD         ORLE      PDAT(X)
     C                   Z-ADD     *ZEROS        XXDPRO
     C                   ENDIF                                                  XXEFD  >= PDAT,Z
     C*
     C                   ENDIF                                                  XXEFD  <= PDAT,X
     C*
     C                   ENDIF                                                  XXEFD  > PDAT,X
     C*                                                    & XXEFD  < PDAT,Z
     C*
     C*  PRORATE THE DISCOUNT AMOUNT.
     C*
     C                   MULT(H)   XXDPRO        XXWK90
     C                   Z-ADD(H)  XXWK90        XXWK10
     C                   ADD       XXWK10        XXDISA
     C*
     C                   Z-ADD     XXWK10        DIS(X)
     C*
     C                   SUB       XXWK10        PRM(X)
     C                   ADD       1             X
     C                   ENDDO                                                  RDAT DOWNE
     C*
     C                   ENDSR
     C*
     C*****************************************************************
     C     SPRDD         BEGSR
     C*
     C* CALCULATE 'A' TYPE DISCOUNT.
     C*
     C     XXTP          IFEQ      'A'
     C*
     C     F1APFD        IFEQ      'N'
     C     ELFFL9        ANDNE     'Y'
     C                   MULT(H)   XXPROR        XXLMT
     C                   ENDIF                                                  F1APFD IFEQ
     C     F1APFD        IFEQ      'Y'
     C     ELFFL9        ANDEQ     'Y'
     C     XXPROR        ANDNE     *ZERO
     C                   DIV(H)    XXPROR        XXLMT
     C                   ENDIF                                                  F1APFD IFEQ
     C     DSKEY         SETGT     PDS03
     C     DSKEY2        READPE    PDS03                                  60
     C                   Z-ADD     DSEFDT        XXEFDT
     C     DSKEY         CHAIN     PDS03                              60
     C*
     C     *IN60         DOWEQ     *OFF
     C     XXLMT         ANDGT     *ZERO
     C*
     C     XXLMT         SUB       DSLMT         XXDIF            15 4
     C     XXDIF         IFLT      *ZERO
     C                   Z-ADD     XXLMT         XXAMT            11 2
     C                   ELSE
     C                   Z-ADD     DSLMT         XXAMT
     C                   ENDIF                                                  XXDIF IFLT
     C     XXLMT         SUB       XXAMT         XXLMT
     C*
     C     XXPCT         MULT(H)   XXAMT         XXAMT
     C     DSPCT         MULT(H)   XXAMT         XXAMT
     C     XXAMT         DIV(H)    100           XXAMT
     C     F1APFD        IFEQ      'N'
     C     ELFFL9        ANDNE     'Y'
     C     XXPROR        ANDNE     *ZERO
     C     XXAMT         DIV       XXPROR        XXAMT
     C                   ENDIF                                                  F1APFD IFEQ
     C     F1APFD        IFEQ      'Y'
     C     ELFFL9        ANDEQ     'Y'
     C     XXPROR        ANDNE     *ZERO
     C     XXAMT         MULT      XXPROR        XXAMT
     C                   ENDIF                                                  F1APFD IFEQ
     C                   ADD       XXAMT         XXDISA
     C*
     C     DSKEY         READE     PDS03                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ENDIF                                                  XXTP IFEQ
     C*
     C* CALCULATE 'B' TYPE DISCOUNT.
     C*
     C     XXTP          IFEQ      'B'
     C*
     C                   Z-ADD     BEFDT         XXEFDT
     C                   Z-ADD(H)  XXLMT         XXAMTP
     C     F1APFD        IFEQ      'N'
     C     ELFFL9        ANDNE     'Y'
     C                   MULT(H)   XXPROR        XXAMTP
     C                   ENDIF                                                  F1APFD IFEQ
     C     F1APFD        IFEQ      'Y'
     C     ELFFL9        ANDEQ     'Y'
     C     XXPROR        ANDNE     *ZERO
     C                   DIV(H)    XXPROR        XXAMTP
     C                   ENDIF                                                  F1APFD IFEQ
     C     DSKEY3        SETLL     PDS01
     C     DSKEY         READE     PDS01                                  60
     C     *IN60         IFEQ      *OFF
     C     XXPCT         MULT      XXLMT         XXLMT
     C     DSPCT         MULT      XXLMT         XXLMT
     C     XXLMT         DIV(H)    100           XXDISA
     C                   ENDIF                                                  *IN60 IFEQ
     C                   Z-ADD     ELPFDT        XXEFDT
     C*
     C                   ENDIF                                                  XXTP IFEQ
     C*
     C                   ENDSR
     C*****************************************************************
     C     DiscTable     Begsr
     C*
     C*  GET THE DISCOUNT BASED ON THE TABLE VALUES
     C*
     C                   MOVE      ELDISC        XXCODE
     C                   Z-ADD     RDAT(1)       XXEFDT
     C                   Z-ADD     0             AEFDT
     C                   Z-ADD     0             BEFDT
     C                   MOVE      'A'           XXTP
     C     DSKEY         SETGT     PDS01
     C     DSKEY2        READPE    PDS01                                  60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     DSEFDT        AEFDT             7 0
     C                   ENDIF
     C*
     C                   MOVE      'B'           XXTP
     C     DSKEY         SETGT     PDS01
     C     DSKEY2        READPE    PDS01                                  60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     DSEFDT        BEFDT             7 0
     C                   ENDIF
     C*
     C     AEFDT         IFGE      BEFDT
     C                   MOVE      'A'           XXTP
     C                   Z-add     AEfdt         xxEfdt
     C                   ELSE
     C                   MOVE      'B'           XXTP
     C                   Z-add     BEfdt         xxEfdt
     C                   ENDIF                                                  AEFDT IFGE
     C*
     C                   Endsr
     C*******
     C     ARW           BEGSR
     C*
     C                   MOVE      *BLANK        EAARTY
     C                   MOVE      *BLANKS       EADESC
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      TTTYPE        EAARTY
     C                   MOVE      TTDESC        EADESC
     C                   MOVE      TTCTYP        EACTYP
     C                   ENDIF                                                  *IN60 IFEQ
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   Z-ADD     0             EANINV
     C                   MOVE      *BLANK        EALATE
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDSR
     C*
     C*****************************************************************
     C*
     C* SUBROUTINE TO DETERMINE IF A DATE RANGE CONTAINS FEBRUARY 29TH.
     C*
     C     SRLEAP        BEGSR
     C*
     C*  IF FEB 29 IS A VALID DATE AND IS IN THE RANGE, SUBTRACT ONE DAY
     C*
     C                   Z-ADD     0             XXLPDT
     C*
     C                   Z-ADD     XQFROM        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1FROM
     C*
     C                   Z-ADD     XQTO          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1TO
     C*
     C                   Z-ADD     X1FROM        XXLPDT
     C                   MOVE      '0229'        XXLPDT
     C*
     C     XXLPDT        IFLT      X1FROM
     C                   Z-ADD     X1TO          XXLPDT
     C                   MOVE      '0229'        XXLPDT
     C                   END
     C*
     C     XXLPDT        IFLT      X1FROM
     C     XXLPDT        ORGT      X1TO
     C                   Z-ADD     *ZERO         XXLPDT
     C                   END
     C*
     C     XXLPDT        IFNE      *ZERO
     C*
     C                   Z-ADD     XXLPDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C*
     C                   Z-ADD     XQFROM        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C                   MOVEL     SRDTO         XQFROM
     C*
     C     SRERR         IFNE      '1'
     C     XXLPDT        ANDNE     X1FROM
     C                   SUB       1             QQDAYS
     C                   ELSE
     C                   Z-ADD     0             XXLPDT
     C                   ENDIF
     C*
     C                   ENDIF
     C*
     C                   ENDSR                                                  SRLEAP
     C**************************************************************************
     C*  GET THE EMPLOYER ENDORSEMENT FORMS
     C**************************************************************************
     C     GTFRMS        BEGSR
     C*
     C*
     C*
     C*
     C*
     C*  DELETE ANY PREVIOUSLY AUTO-ATTACHED ORIG BILL RECORDS
     C*
     C*
     C*
     C*
     C*  PROCESS THRU THE ENDORSMENT FORM TABLE FILE
     C*
     C*
     C*
     C*
      *
     C                   MOVE      XXCO#         ##CO#             3
     C                   MOVE      XXFND         ##FND             3
     C                   MOVE      XXEMP#        ##EMP#            9
     C                   MOVE      XXFYR         ##FYR             3
      *
     C                   CALL      'W1053R3'
     C                   PARM                    ##CO#             3
     C                   PARM                    ##FND             3
     C                   PARM                    ##EMP#            9
     C                   PARM                    ##FYR             3
     C                   PARM      *BLANK        ##RTN             1
      *
     C*
     C                   ENDSR                                                  GTFRMS
     C*  CHECK FOR A/R IN A PRIOR MONTH
     C     SRCKAR        BEGSR
     C*
     C*  FIND FIRST (IF ANY, BY TRANS DATE) A/R FOR THE EMPLOYER
     C*  IF TRANSACTION IS IN A PRIOR MONTH AND IS NOT A PAYMENT
     C*  TYPE, DO NOT PROCESS EMPLOYER IN MASS BILLING AND DELETE
     C*  THE BILLING REQUEST RECORD SINCE IT IS INVALID
     C*
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXCURM
     C                   MOVE      '01'          XXCURM
     C     EAKY3         CHAIN     PEA03                              60
     C     *IN60         DOWEQ     '0'
     C     XXPRAR        ANDEQ     'N'
     C*
     C     EAARTY        IFEQ      'B'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     EAARTY        OREQ      'A'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     EAARTY        OREQ      'H'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     xxColt        ANDNE     'Y'
     C     EAARTY        OREQ      'F'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C                   MOVE      'Y'           XXPRAR
     C                   ENDIF
     C*
     C     EAKY3         READE     PEA03                                  60
     C                   ENDDO                                                  DOWEQ'0'
     C*
     C     ELKY4         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
     C     XXPRAR        ANDEQ     'N'
     C*
     C     ELDIV         IFNE      BLDIV
     C*
     C     EAKY4         CHAIN     PEA03                              60
     C     *IN60         DOWEQ     '0'
     C     XXPRAR        ANDEQ     'N'
     C*
     C     EAARTY        IFEQ      'B'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     EAARTY        OREQ      'A'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     EAARTY        OREQ      'H'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C     xxColt        ANDNE     'Y'
     C     EAARTY        OREQ      'F'
     C     EATRDT        ANDLT     XXCURM
     C     EAPODT        ANDLT     XXCURM
     C                   MOVE      'Y'           XXPRAR
     C                   ENDIF
     C*
     C     EAKY4         READE     PEA03                                  60
     C                   ENDDO                                                  DOWEQ'0'
     C*
     C                   ENDIF                                                  ELDIV IFNE
     C*
     C     ELKY4         READE     PEL02                                  60
     C                   ENDDO                                                  DOWEQ'0'
     C*
     C*
     C*
     C*
     C*  IF PRIOR A/R EXISTS, WE NEED TO DELETE THIS BILLING REQUEST
     C*  RECORD AND PROCESS THE NEXT EMPLOYER SINCE IT IS INVALID
     C*
     C     XXPRAR        IFEQ      'Y'
     C     ELKY4         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
     C     BLKEY4        CHAIN     PBL01                              60
     C  N60              DELETE    PBL01
     C     ELKY4         READE     PEL02                                  60
     C                   ENDDO                                                  DOWEQ'0'
     C                   ENDIF
     C*
     C                   ENDSR                                                  SRCKAR
     C*
     C* WRITE A/R FOR THE DIVISION OR POLICY
     C*
     C     WRTAR         BEGSR

      /Free
       If EXexcArBl = 'Y' And BSSEFL = 'S';
          LeaveSr;
       Endif;
      /End-Free
       //* Use invoice # from state reporting division for renewal payment.
       If xxSum = 'Y';
          renewInv# = sumRenewInv#;
       Endif;

     C     ELKY6         CHAIN     PEL02                              60
     C*
     C                   TIME                    DSDTTM
     C* PROCESS RETRO CREDIT FOR CLIENT 71.
     C*
     C                   Z-ADD     ELBSDT        XXPFDT
     C                   MOVEL(P)  ELBSCD        XXKEY
     c
     c                   if        F1ORCR = 'Y' and XXCLT# = '071'
     c
     c                   if        BLARQ# <> 0  and
     c                             svemp# =  0   or
     c                             ELAMIN <> 0  and
     c                             svemp# <> 0
     c
     c
     c                   if        BLARQ# <> 0
     c                   eval      ##BAT# = BLARQ#
     c                   else
     c                   eval      ##BAT# = ELAMIN
     c                   endif
     c
     c                   endif
     c
     c                   if        QQOVR = 'Y'
     c                   eval      #1MODE = 'R'
     c                   else
     c                   eval      #1MODE = 'E'
     c                   endif
     c
     c                   call      'WA080R'
     c                   parm                    #1MODE            1
     c                   parm      ELCO#         #1CO#             3 0
     c                   parm      ELFND         #1FND             3 0
     c                   parm      ELEMP#        #1EMP#            9 0
     c                   parm      ELDIV         #1DIV             5 0
     c                   parm      ELFYR         #1FYR             3 0
     c                   parm                    ##BAT#            9 0
     c
     c                   ENDIF
     c
     c
     C     TBKEY         CHAIN     PBS01                              60
     C*
     C     *IN60         IFEQ      *ZERO
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         SYSDAT
      *
     C     XXCLT#        IFEQ      '129'
     C     BSON15        ANDEQ     'Y'
      *
     C     XXPOYY        SUB       XXSYYY        XXDIFF            3 0
     C     XXDIFF        IFNE      0
     C                   MOVE      15            XXDATE
     C                   ELSE
     C     XXPOMM        SUB       XXSYMM        XXDIFF
     C     XXDIFF        IFNE      0
     C                   MOVE      15            XXDATE
     C                   ENDIF
     C                   ENDIF
      *
     C     XXDATE        IFLT      XXPFDT
     C                   Z-ADD     XXPFDT        XXDATE
     C                   ENDIF
      *
     C                   ENDIF                                                  XXCLT# = 129
     C*
     C                   Z-ADD     *ZERO         AM
      /free
       flgProcEstDep = *off;
       txOnDeposit = 0;
       Select;
       When BSsefl = 'S';
          If BSab01 <> 0;
             xxAb01 = BSab01;
          Else;
             xxAb01 = BSab02;
          Endif;
       When BSsefl = 'E' and (BSesdp <> 0 or BSesd2 <> 0);
       // Temporarily change the Estimating flag to Self-Reporting
       //  to process deposit for estimating accounts
          flgProcEstDep = *on;
          BSsefl = 'S';
          If BSesdp <> 0;
             xxAb01 = BSesdp/100;
          Else;
             xxAb01 = BSesd2/100;
          Endif;
       Endsl;
       If BSsefl = 'S';
      /end-free
     C*
     C                   Z-ADD     0             DEPPRE           11 0
     C     F1DPS         IFEQ      'S'
     C     CLTID         IFEQ      '102'
     C     XXAB01        MULT(H)   ELEMPM        DEPPRE
     C                   ELSE
     C     XXAB01        MULT(H)   ELSTPR        DEPPRE
     C                   ENDIF
     C                   Z-ADD     DEPPRE        XXNET
     C                   ELSE
     C     F1DPS         IFEQ      'M'
     C     XXAB01        MULT(H)   ELMAPR        DEPPRE
     C                   Z-ADD     DEPPRE        XXNET
     C                   ELSE
     C     F1DPS         IFEQ      'N'
     C     XXAB01        MULT(H)   ELENMP        DEPPRE
     C                   Z-ADD     DEPPRE        XXNET
     C                   ELSE
     C     ELANPR        SUB       ELPRTD        XXAM12           11 2
     C     XXAB01        MULT(H)   XXAM12        DEPPRE
     C                   Z-ADD     DEPPRE        XXNET
     C                   ENDIF                                                  F1DPS IFEQ
     C                   END
     C                   END
      /Free
       Select;
       When xxNet > EMdepcap And EMDepCap <> 0;
            xxNet = EMdepcap;
       When xxNet > BSmaxDep And BSMaxDep <> 0;
          xxNet = BSmaxDep;
       Endsl;
      /End-free

     C*   CALCULATE PRIOR DEPOSIT BILLED
     C                   MOVE      'H'           XXARTY
     C                   Z-ADD     0             XXPRDP           11 0
     C     QQQTE         IFNE      'Q'
      *
      *  TURN ON THE DEPOSIT MODE BY YEAR FLAG (XXDPYM) IF THE POLICY YEAR
      *  IS DEFINED AS SUCH IN WDF1P
      *
     C     F1DPYM        IFEQ      'Y'
     C                   MOVE      'Y'           XXDPYM            1
     C                   ELSE
     C                   MOVE      'N'           XXDPYM            1
     C                   ENDIF
      *
     C     EAKY1         CHAIN     PEA02                              60
     C     *IN60         DOWEQ     '0'
     C                   SELECT
     C     XXCLT#        WHENEQ    '109'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLT      XXFYR
      *
      * DO NOT INCLUDE PRIOR YEAR DEPOSIT TRANSACTIONS IF THAT YEAR IS FLAGGED
      * AS A PER YEAR DEPOSIT MODE
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C     EAKY1         READE     PEA02                                  60
     C                   END
     C*
     C*
     C*   ACCUMULATE AMOUNTS FOR DEPOSIT ROLLOVER FROM LIVE
     C*
     C                   ELSE
     C*
     C* - BILLINGS:
     C                   MOVE      'H'           XXTYPE
     C     EAKY1         CHAIN     PEA03L                             40
     C     *IN40         DOWEQ     *OFF
     C*
     C                   SELECT
     C     XXCLT#        WHENEQ    '109'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLT      XXFYR
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C*
     C     EAKY1         READE     PEA03L                                 40
     C                   ENDDO                                                  *IN40 DOWEQ
     C*
     C                   ENDIF                                                  QQQTE IFEQ
     C*
     C* RESET GROUP DETAIL
     C*
     C     F1KEY         SETLL     PF101
     C     F1KEY         READE     PF101                                  60
     C*
     C     XXNET         SUB       XXPRDP        AM(1)
     C*
     C* CHECK DEPOSIT ADJUSMENT THRESHOLD INFORMATION BEFORE POSTING.
     C*
     C     XXPRDP        IFNE      0
     C*
     C     F1BRFL        IFNE      'Y'
     C                   Z-ADD     0             AM(1)
     C                   ELSE
     C*
     C     AM(1)         IFGE      0
     C*
     C* DO NOT POST ADJ IF LESS THAN DEBIT THRESHOLD
     C*
     C     AM(1)         IFLT      F1DADJ
     C                   Z-ADD     0             AM(1)
     C                   ENDIF                                                  AM,1 IFLT
     C*
     C                   ELSE
     C*
     C* DO NOT POST ADJ IF LESS THAN CREDIT THRESHOLD
     C*
     C     AM(1)         MULT      -1            XXTMP            11 2
     C*
     C     XXTMP         IFLT      F1CADJ
     C                   Z-ADD     0             AM(1)
     C                   ENDIF                                                  AM,1 IFLT
     C*
     C                   ENDIF                                                  AM,1 IFGE
     C*
     C                   ENDIF                                                  F1BRFL IFNE
     C*
     C                   ENDIF                                                  XXPRDP IFNE
     C*
     C* Ensure no writing/adjusting of deposit occurs for client 150.
     C*
     C                   If        xxColt = 'Y'
     C                   Z-add     0             am(1)
     C                   Endif
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       AM(1)         XTDEP
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTDEP         AM(1)
     C                   ENDIF
     C*
     C     RRTDFL        IFNE      'Y'
     C                   Z-ADD     0             txOnDeposit
     C                   ELSE
     C     AM(1)         MULT(H)   RRTXPC        txOnDeposit       9 0
     C                   MULT(H)   .01           txOnDeposit
     C                   ENDIF                                                  RRTDFL
     C*
     C*
     C     BSAB01        IFEQ      *ZERO
     C     BSAB02        ANDNE     *ZERO
     C     flgProcEstDep ANDEQ     *OFF
     C     BSesdp        OREQ      *ZERO
     C     BSesd2        ANDNE     *ZERO
     C     flgProcEstDep ANDEQ     *ON
     C                   Z-ADD     AM(1)         AM(2)
     C                   Z-ADD     0             AM(1)
     C                   ENDIF                                                  BSAB01 IFNE
     C*
     C     XXPRDP        IFEQ      *ZEROS
     C*
     C                   MOVE      QQSRCD        ZZCODE
     C                   MOVE      XXTYPE        ZZTYPE
     C                   MOVE      XXDESC        ZZDESC
     C                   MOVE      XXCTYP        ZZCTYP
     C                   ELSE
     C                   MOVE      QQAJCD        ZZCODE
     C                   MOVE      XATYPE        ZZTYPE
     C                   MOVE      XADESC        ZZDESC
     C                   MOVE      XACTYP        ZZCTYP
     C                   ENDIF
     C*
      /free
          Exsr srInst;
       // If estimated deposit was processed, then change it back to
       //  estimating for installments
          If flgProcEstDep = *on;
             BSsefl = 'E';
          Endif;
       Endif;
      /end-free
     C*
     c                   If        BSSEFL = 'E'
     C*
     C*** CALCULATE THE BILLING RECORDS FOR ESTIMATING TYPES
     C*** USE PRORATED NORMAL PREM INSTEAD OF ANNUAL BECAUSE WE BILL
     C*** SEPERATELY FOR EXPENSE CONSTANT
     C*
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       XXNET1        XTNET1
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTNET1        XXNET1
     C                   ENDIF

      /free
       // Subtract dividend from premium and write out dividend A/R
       If xxar = 'Y';
          xxNet1 = xxNet1 - UpdateDividend(ELCo#:ELFnd:ELEmp#:ELDiv:ELFyr);
       Endif;
      /end-free

     C                   Z-ADD     XXNET1        ZZPREM
     C                   MOVE      QQESCD        ZZCODE
     C                   MOVE      XETYPE        ZZTYPE
     C                   MOVE      XEDESC        ZZDESC
     C                   MOVE      XECTYP        ZZCTYP
     C*
     C                   EXSR      SRINST
     C*
     C* BILL TO A/R FROM INSTALLMENT BUCKETS.
      * PROCESS AND BILL TO A/R TWICE A MONTH BILLLING INSTALLMENTS.
     C* CHECK FOR FIRST INSTALLMENT ON/AFTER BILLING START DATE.
     C* BUILD DATE ARRAY WITH EACH BI-MONTHLY INSTALLMENT DATE.
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C* BILL AMOUNTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C* CHECK FOR FIRST BILLING DATE AFTER POSTING DATE.
      * ******
      * PROCESS AND BILL TO A/R WEEKLY BILLING INSTALLMENTS.
     C* TOTAL DAYS IN POLICY
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER BILLING START DATE.
     C* BUILD DATE ARRAY WITH EACH WEEKLY INSTALLMENT DATE.
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C* BILL WEEKLY INSTALLMENTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER POSTING DATE.
     C                   ENDIF                                                  BSSEFL IFEQ
      * If Self Reporting and Deposit is Zero, Write record anyway
      *
     C*
     C*   WRITE EXPENSE CONSTANT SEPARATELY
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       XXEXCN        XTEXCN
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTEXCN        XXEXCN
     C                   ENDIF
     C*
     C     ELEMNP        IFNE      'Y'
     C     XXEXCN        ANDNE     *ZEROS
     C     XXCDEB        ANDNE     *BLANKS
     C     EXBEXP        OREQ      'Y'
     C     XXEXCN        ANDNE     *ZEROS
     C     XXCDEB        ANDNE     *BLANKS
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     XXCDEB        EAARCD
     C                   MOVEL     XTTYPE        EAARTY
     C                   MOVE      XTCTYP        EACTYP
     C                   MOVEL     XTDESC        EADESC
     C                   Z-ADD     XXEXCN        EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
     C*
     C*
     C                   END
     C*
     C*  WRITE THE STATE TAX BILLING RECORD
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       XXTXDU        XTTXDU
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTTXDU        XXTXDU
     C                   ENDIF
     C*
     C     XXTXDU        IFNE      *ZERO
     C     XXTXBL        ANDNE     *BLANKS
     C     BSSEFL        ANDEQ     'E'
     C*
     C*  THE STATE TAX WILL BE BILLED IN INSTALLMENTS USING THE SAME
     C*  BILLING PLAN AS THE PREMIUM.
     C*
     C                   Z-ADD     XXTXDU        ZZPREM
     C                   MOVE      XXTXBL        ZZCODE
     C                   MOVE      XSTYPE        ZZTYPE
     C                   MOVE      XSDESC        ZZDESC
     C                   MOVE      XSCTYP        ZZCTYP
     C*
     C                   EXSR      SRINST
      *
     C                   ENDIF                                                  XXTXDU NE 0
     C*
     C*  WRITE THE STATE TAX BILLING RECORD
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       txOnDeposit   totTxOnDep
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     totTxOnDep    txOnDeposit
     C                   ENDIF
     C*
     C     txOnDeposit   IFNE      *ZERO
     C     X1TXBL        ANDNE     *BLANKS
     C     BSSEFL        ANDEQ     'S'
     C     txOnDeposit   OrNe      *Zeros
     C     X1TXBL        ANDNE     *BLANKS
     C     BSSEFL        ANDEQ     'E'
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     X1TXBL        EAARCD
     C                   MOVEL     X1TYPE        EAARTY
     C                   MOVEL     X1CTYP        EACTYP
     C                   MOVEL     X1DESC        EADESC
     C                   Z-ADD     txOnDeposit   EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXTXDU IFNE
     C*
       //*** Beg Add ***** 06/24/24 **********************************
       // WRITE THE COLLATERAL BILLING RECORD
       xxColb = *Zeros;
       If EXcolb <> ' ' and (ELcolwp <> 0 or ELcolwa <> 0);
          If ELcolwp <> 0;
             xxColb = %DecH((ELcolwp * ELmapr)/100:11:0);
          Else;
             xxColb = ELcolwa;
          Endif;

          If xxAR = ' ';
             xtColb += xxColb;
          Endif;

          If xxSum = 'Y';
             xxColb = xtColb;
          Endif;

          If xxColb <> 0;
             EApodt = xxDate;
             Exec Sql Select TTkey, TTdesc, TTtype, TTctyp into
                :EAarcd, :EAdesc, :EAarty, :EActyp from WTTTP
                Where TTkey = :EXcolb and TTco# = :xxCo#;

             EAamt = xxColb;
             EAco# = xxCo#;
             EAfnd = xxFnd;
             EAfyr = xxFyr;
             EAemp# = ELemp#;
             EAdiv = ELdiv;

             If *In71 = *On;
                EArdiv = %dec(QQdiv:5:0);
             Else;
                EArdiv = ELdiv;
             Endif;

             EAstat = 'A';
             EAuser = Q1user;
             EApgm = Q1pgm;
             EAedit = ' ';
             EAbul1 = 0;
             EAChk# = 0;
             EAlate = ' ';
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   MOVEL     SRDTO         EATRDT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME

             If xxAR = 'Y';
                Exsr GetInv;
                Write PEA01;
             Endif;

          Endif;

       Endif;
       //*** End Add ***** 06/24/24 **********************************
     C*   WRITE A MEMBERSHIP FEE BILLED A/R RECORD SEPARATELY
     C*
     C                   Z-ADD     *ZERO         XXMFEE
     C*
     C     XXMFBL        IFNE      *BLANK
     C     XXMFFL        ANDEQ     'Y'
     C*
     C*   CALCULATE MEMBERSHIP FEE BILLED. PRORATE IT IF INDICATED.
     C*
     C                   Z-ADD     ELMFAM        XXMFEE
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       XXMFEE        XTMFEE
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTMFEE        XXMFEE
     C                   ENDIF
     C*
     C     XXMFEE        IFNE      *ZERO
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     XXMFBL        EAARCD
     C                   MOVEL     XXMFTP        EAARTY
     C                   MOVEL     XXMFDS        EADESC
     C                   MOVE      XXMFCT        EACTYP
     C                   Z-ADD     XXMFEE        EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
     C*
     C                   END
     C                   ENDIF
     C                   END
     C*
     C*   WRITE A SAFETY FEE BILLED A/R RECORD SEPARATELY
     C*
     C                   Z-ADD     0             XXSFEE
     C*
     C     XXSFCD        IFNE      *BLANK
     C     ELSFPC        ANDNE     *ZEROS
     C     XXSFCD        ORNE      *BLANK
     C     ELSFMN        ANDNE     *ZEROS
     C*
     C*   CALCULATE SAFETY FEE BILLED.
     C*
     C                   Z-ADD     ELSFAM        XXSFEE
     C*
     C                   ENDIF                                                  XXSFCD IFNE
     C*
     C     XXAR          IFEQ      ' '
     C                   ADD       XXSFEE        XTSFEE
     C                   ENDIF
     C*
     C     XXSUM         IFEQ      'Y'
     C                   Z-ADD     XTSFEE        XXSFEE
     C                   ENDIF
     C*
     C     XXSFEE        IFNE      *ZERO
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     XXSFCD        EAARCD
     C                   MOVEL     XXSFTP        EAARTY
     C                   MOVEL     XXSFDS        EADESC
     C                   MOVE      XXSFCT        EACTYP
     C                   Z-ADD     XXSFEE        EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXSFEE IFNE
     C*
     C*   WRITE A 1ST ASSESSMENT BILLED A/R RECORD SEPARATELY
     C*
     C                   Z-ADD     0             XX1STB
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR1ATD        ANDEQ     'Y'
