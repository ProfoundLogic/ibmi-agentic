     C                   XFOOT     ANL           XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELANPR
     C     ELANPR        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        ANL(1)
     C                   ENDIF
     C*
     C                   XFOOT     EHCN          XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELEHCN
     C     ELEHCN        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EHCN(1)
     C                   ENDIF
     C*
     C                   XFOOT     EDC1          XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELEDC1
     C     ELEDC1        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EDC1(1)
     C                   ENDIF
     C*
     C                   XFOOT     EDC2          XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELEDC2
     C     ELEDC2        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EDC2(1)
     C                   ENDIF
     C*
     C                   XFOOT     D1E2          XXPREM
     C     XXPREM        IFNE      ELD1E2
     C     ELD1E2        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        D1E2(1)
     C                   ENDIF
     C                   XFOOT     EDV2          XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELEDV2
     C     ELEDV2        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EDV2(1)
     C                   ENDIF
     C*
     C                   XFOOT     D2E2          XXPREM
     C     XXPREM        IFNE      ELD2E2
     C     ELD2E2        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        D2E2(1)
     C                   ENDIF
     C                   XFOOT     EDC3          XXPREM           15 4
     C*
     C     XXPREM        IFNE      ELEDC3
     C     ELEDC3        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EDC3(1)
     C                   ENDIF
     C*
     C                   XFOOT     LM            XXPREM           15 4
      //*** Beg Add ***** 08/14/24 *******************************************
       xxPrem = xxPrem + %Xfoot(LMB);
      //*** End Add ***** 08/14/24 *******************************************
     C*
     C     XXPREM        IFNE      ELEIN1
     C     ELEIN1        SUB       XXPREM        XXPREM
