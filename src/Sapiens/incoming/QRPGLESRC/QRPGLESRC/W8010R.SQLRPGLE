     C*
     C*   ENTRY PARAMETERS
     C*
     C     *ENTRY        PLIST
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    QQFYR             3
     C                   PARM                    QQEMP#            9
     C                   PARM                    QQDIV             5
     C                   PARM                    QQDATE            8
     C                   PARM                    QQESCD            2
     C                   PARM                    QQOVR             1
     C                   PARM                    QQSRCD            2
     C                   PARM                    QQPRT             1
     C                   PARM                    QQAJCD            2
     C                   PARM                    QQQTE             1
     C                   PARM                    QQRNB             1
     C*
     C     DATCHK        PLIST
     C                   PARM                    SRDTI             8 0
     C                   PARM      *BLANKS       SRFFMT            8
     C                   PARM      *BLANKS       SRTFMT            8
     C                   PARM                    SRDTO            10
     C                   PARM                    SRERR             1
     C*
     C     DTCYMD        PLIST
     C                   PARM                    SRDTI
     C                   PARM      *BLANKS       SRFFMT
     C                   PARM      '*CYMD'       SRTFMT
     C                   PARM                    SRDTO
     C                   PARM                    SRERR
     C*
     C     DTMDYY        PLIST
     C                   PARM                    SRDTI
     C                   PARM      '*CYMD'       SRFFMT
     C                   PARM      *BLANKS       SRTFMT
     C                   PARM                    SRDTO
     C                   PARM                    SRERR
     C*
     C*
     C     DTMDY2        PLIST
     C                   PARM                    SRDTI
     C                   PARM      '*CYMD'       SRFFMT
     C                   PARM      '*MDY'        SRTFMT
     C                   PARM                    SRDTO
     C                   PARM                    SRERR


      * Use expanded Minimum Premium if available

     c     *dtaara       define    minprm        usrdat
     c                   in        usrdat

     c                   if        usrid <> *blank
     c                   move      *on           xxMinPrm          1
     c                   else
     c                   move      *off          xxMinPrm
     c                   endif

     C                   CALL      'RTVCLTID'
     C                   PARM                    XXCLT#            3
     C                   movel     'WA073R'      xxpgm            10
     C*
     C                   MOVEL     '*PGM'        XXTYP             7
     C                   CALL      'SRCHKOBJ'
     C                   PARM                    XXPGM
     C                   PARM                    XXTYP
     C                   PARM                    XXNACH            1

     C                   MOVE      XXCLT#        CLTID             3
     C     XXCLT#        IFEQ      '139'
     C                   MOVE      '999'         XXCLT#
     C                   ENDIF
     C*
     C                   MOVE      'E'           BILL              1
     C     BILL          IFEQ      'A'
     C                   MOVE      *BLANK        XXSRFL            1
     C                   MOVE      *ZERO         FACT             11 8
     C                   MOVE      *ZERO         STPERC            5 2
     C                   ENDIF
     C*** begin add ***  06/14/23  ******************************************
     C                   Clear                   calcManP          1
     C                   If        QQOvr = 'Z'
     C                   Eval      calcManP = 'Y'
     C                   Eval      QQOvr = 'Y'
     C                   Endif
     C*** end add *****  06/14/23  ******************************************
     C                   MOVE      'N'           SVCNCL            1
     C                   Z-ADD     0             SVCNDT            7 0
     C     QQRNB         IFEQ      '#'
     C                   MOVE      *BLANK        QQRNB
     C                   MOVE      *ON           *IN71
     C                   ELSE
     C                   MOVE      *OFF          *IN71
     C                   ENDIF
     C*
     C     QQRNB         IFEQ      'I'
     C                   MOVE      *ON           *IN96
     C                   MOVE      *BLANK        QQRNB
     C                   ELSE
     C                   MOVE      *OFF          *IN96
     C                   ENDIF
     C     QQRNB         IFEQ      'Z'
     C                   MOVE      *ON           *IN97
     C                   MOVE      *BLANK        QQRNB
     C                   ELSE
     C                   MOVE      *OFF          *IN97
     C                   ENDIF
     C     QQRNB         IFEQ      'L'
     C                   MOVE      *ON           *IN97
     C                   MOVE      *ON           *IN94
     C                   MOVE      *BLANK        QQRNB
     C                   ELSE
     C                   MOVE      *OFF          *IN94
     C                   ENDIF
     C     QQRNB         IFEQ      'S'
     C                   MOVE      *ON           *IN95
     C                   MOVE      *BLANK        QQRNB
     C                   ELSE
     C                   MOVE      *OFF          *IN95
     C                   ENDIF
     C*
     C     QQRNB         IFEQ      'H'
     C                   MOVE      *ON           *IN98
     C                   MOVE      *BLANK        QQRNB
     C                   ELSE
     C                   MOVE      *OFF          *IN98
     C                   ENDIF

      /free
       finalUpdate = *off;

       If *in94 = *off and *in95 = *off and *in96 = *off and
          *in97 = *off and *in98 = *off;
        //***  Begin Chg  ***  04/28/22  *****************************
        //// Only do the following if invocie cloud installed and quote
        //If IsModEnabled('Invoice Cloud') And qqQte = 'Q';
        //   // If invoice cloud and run in quote make create A/R
          // Only do the following if quote
          If qqQte = 'Q';
        //***  End   Chg  ***  04/28/22  *****************************
             // Estimated Code
             Exec Sql Select EXesCd Into :qqEsCd From wmexp
                   Where EXco#=:qqCo# And EXfnd=:qqFnd;
             If qqEsCd = ' ';
                Exec Sql Select TTkey Into :qqEsCd From WTTTP
                         Where TTco#=:qqCo# And TTtype='B' And TTcTyp='P';
             Endif;

             // S/R Code
             Exec Sql Select EXsrCd Into :qqsrCd From wmexp
                      Where EXco#=:qqCo# And EXfnd=:qqFnd;
             If qqEsCd = ' ';
                Exec Sql Select TTkey Into :qqSrCd From WTTTP
                         Where TTco#=:qqCo# And TTtype='H' And TTcTyp='D';
             Endif;
          //*** begin add ***  02/14/25  ****************************************
             // S/R Adj Code
             Exec Sql Select EXdaCd Into :qqajCd From wmexp
                      Where EXco#=:qqCo# And EXfnd=:qqFnd;
             If qqajCd = ' ';
                qqajcd = qqsrcd;
             Endif;
          //*** end add *****  02/14/25  ****************************************
          EndIf;
          finalUpdate = *on;
          inObj = 'WXELP';
          inType = '*FILE';
          Callp ChkObjInLibl (inObj:inType:rtnResult);
          If rtnResult = *off;
             unBilPrmInst = *on;
          Endif;
       Endif;
      /end-free

     C                   MOVE      QQRNB         XXRFLG
     C                   MOVE      QQCO#         XXCO#
     C                   MOVE      QQFND         XXFND
     C                   MOVE      QQFYR         XXFYR
     C                   MOVE      QQEMP#        XXEMP#
     C                   MOVE      QQDIV         XXDIV
     C                   MOVE      QQDATE        X@DATE            8 0
     C                   MOVE      QQEMP#        SVEMP#
     C                   Z-ADD     0             SVFYR             3 0
     C                   TIME                    DSDTTM
     C     *LIKE         DEFINE    EADT          SYSDT
     C     *LIKE         DEFINE    EATIME        SYSTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         SYSDT
     C                   Z-ADD     DSTIME        SYSTM
     C                   Z-ADD     0             XXACDT            8 0
     C*
     C     FNKEY         CHAIN     PEX02                              60
     C*
     C     *IN60         IFEQ      *OFF
     C*
     C                   Z-ADD     EXAOID        XXDAYS            5 0
     C*
     C* POSTING DATE (REVISED INTERIM DAYS PLUS THE PRESENT DATE)
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      DSDATE        QQDT              8 0
     C                   PARM      XXDAYS        QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   MOVE      QQDT          XXACDT            8 0
     C                   ENDIF
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C*  GET THE USER PARMS
     C*
     C                   MOVEL     'WC'          XXSYK
     C     SYKY          CHAIN     SWC01                              60
     C*
     C     XXCLT#        IFEQ      '129'
      * If Group allows Payroll Vendor or ACH set flags on.
     C                   MOVE      *OFF          VNDRFL            1
     C                   MOVE      *OFF          ACHFLG            1
     C     *IN60         IFEQ      *OFF
     C     WCFL23        IFEQ      'Y'
     C                   MOVE      *ON           VNDRFL
     C                   ENDIF
     C     WCFL24        IFEQ      'Y'
     C                   MOVE      *ON           ACHFLG
     C                   ENDIF
     C                   ENDIF                                                  END *IN60 = OFF
     C                   ENDIF                                                  XXCLT# = '129'
     C*
     C*  GET THE FUND MASTER
     C*
     C     FNKEY         CHAIN     PFN01                              60
     C*
     C*  LOAD FLAG THAT DETERMINES WHETHER OR NOT THIS FUND WAS SET-UP
     C*  FOR NON-COMMON EXPIRATION DATE POLICIES
     C*
     C     F2KY          CHAIN     PF201                              60
     C*
     C*  READ THE BILLING WORK FILE  - IF THE BILLING &
     C*  UPDATE A/R HAVE BEEN PROCESSED, GET NEXT EMP#
     C*
     C                   MOVE      *OFF          *IN90
     C     SVEMP#        IFEQ      *ZERO
     C*
     C     QQRNB         IFEQ      'B'
     C     BLKEY         CHAIN     PBL02                              90
     C                   ELSE
     C     BLKEY1        CHAIN     PBL03                              90
     C                   ENDIF                                                  QQRNB EQ B
     C*
     C                   ENDIF                                                  SVEMP# IFEQ
     C*
     C     *IN90         DOWEQ     *OFF
     C                   MOVE      *BLANK        XXGTFM            1
     C                   Z-ADD     0             SRDIV
     C     XXEMP#        IFNE      BLEMP#
     C     SVFYR         ORNE      BLFYR
     C     SVEMP#        ORNE      *ZERO
     C*
     C     SVEMP#        IFEQ      *ZEROS
     C                   Z-ADD     BLEMP#        XXEMP#
     C                   Z-ADD     BLFYR         SVFYR
     C                   ENDIF
      *
     C                   EXSR      SRCAP#
     C                   EXSR      SRDBCR
      *
     C     XXCAP#        IFEQ      'Y'
     C     XXDBCR        ANDEQ     'Y'
     C     SVEMP#        ORNE      *ZERO
      *
     C                   MOVE      'N'           XXVAL             1
     C     BLFLG1        IFNE      ' '
     C     BLFLG3        ORNE      ' '
     C     SVEMP#        ORNE      *ZERO
     C                   MOVE      'N'           XXPRAR            1
     C     SVEMP#        IFEQ      *ZEROS
     C                   EXSR      SRCKAR
     C                   END
      /Free
       // Don't process the policy if it is "Mass Calc, Update, and Print"
       // and update A/R flag is blank.
       If xxprar = 'N' and  qqprt = '4' and svemp# = *zeros and blflg3 <> 'Y';
          xxprar = 'Y';
       Endif;
      /End-free
     C*
     C     XXPRAR        IFEQ      'N'
     C*
     C     SVEMP#        IFEQ      *ZERO
     C     BLFYR         IFNE      XXFYR
     C                   Z-ADD     BLFYR         XXFYR
     C                   MOVE      *ON           *IN99
     C                   ELSE
     C                   MOVE      *OFF          *IN99
     C                   ENDIF                                                  BLFYR IFNE
     C                   Z-ADD     BLEMP#        XXEMP#
     C                   Z-ADD     BLDIV         XXDIV
     C                   ENDIF                                                  SVEMP# IFEQ
     C*
     C     SVEMP#        IFNE      0
     C     *IN99         OREQ      *ON
     C*
     C*  GET THE FUND DETAIL
     C*
     C     F1KEY         CHAIN     PF101                              91
     C*
     C*  GET THE A/R TRANSACTION CODE FOR MEMBERSHIP FEE
     C*
     C                   MOVE      *BLANK        XXMFTP
     C                   MOVE      *BLANKS       XXMFDS
     C                   MOVE      *BLANKS       XXMFBL            2
     C                   MOVE      *BLANK        XXMFCT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      'M'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XXMFBL
     C                   MOVE      TTTYPE        XXMFTP            1
     C                   MOVE      TTDESC        XXMFDS           30
     C                   MOVE      TTCTYP        XXMFCT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR SAFETY FEE
     C*
     C                   MOVE      *BLANK        XXSFTP
     C                   MOVE      *BLANKS       XXSFDS
     C                   MOVE      *BLANKS       XXSFCD            2
     C                   MOVE      *BLANK        XXSFCT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      'S'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XXSFCD
     C                   MOVE      TTTYPE        XXSFTP            1
     C                   MOVE      TTDESC        XXSFDS           30
     C                   MOVE      TTCTYP        XXSFCT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 1ST ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX1TYP            1
     C                   MOVE      *BLANKS       XX1DES           30
     C                   MOVE      *BLANKS       XX1CDE            2
     C                   MOVE      *BLANK        XX1CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '1'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX1CDE
     C                   MOVE      TTTYPE        XX1TYP
     C                   MOVE      TTDESC        XX1DES
     C                   MOVE      TTCTYP        XX1CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 2ND ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX2TYP            1
     C                   MOVE      *BLANKS       XX2DES           30
     C                   MOVE      *BLANKS       XX2CDE            2
     C                   MOVE      *BLANK        XX2CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '2'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX2CDE
     C                   MOVE      TTTYPE        XX2TYP
     C                   MOVE      TTDESC        XX2DES
     C                   MOVE      TTCTYP        XX2CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 3RD ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX3TYP            1
     C                   MOVE      *BLANKS       XX3DES           30
     C                   MOVE      *BLANKS       XX3CDE            2
     C                   MOVE      *BLANK        XX3CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '3'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX3CDE
     C                   MOVE      TTTYPE        XX3TYP
     C                   MOVE      TTDESC        XX3DES
     C                   MOVE      TTCTYP        XX3CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 4TH ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX4TYP            1
     C                   MOVE      *BLANKS       XX4DES           30
     C                   MOVE      *BLANKS       XX4CDE            2
     C                   MOVE      *BLANK        XX4CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '4'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX4CDE
     C                   MOVE      TTTYPE        XX4TYP
     C                   MOVE      TTDESC        XX4DES
     C                   MOVE      TTCTYP        XX4CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 5TH ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX5TYP            1
     C                   MOVE      *BLANKS       XX5DES           30
     C                   MOVE      *BLANKS       XX5CDE            2
     C                   MOVE      *BLANK        XX5CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '5'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX5CDE
     C                   MOVE      TTTYPE        XX5TYP
     C                   MOVE      TTDESC        XX5DES
     C                   MOVE      TTCTYP        XX5CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 6TH ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX6TYP            1
     C                   MOVE      *BLANKS       XX6DES           30
     C                   MOVE      *BLANKS       XX6CDE            2
     C                   MOVE      *BLANK        XX6CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '6'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX6CDE
     C                   MOVE      TTTYPE        XX6TYP
     C                   MOVE      TTDESC        XX6DES
     C                   MOVE      TTCTYP        XX6CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION CODE FOR 7TH ASSESSMENT
     C*
     C                   MOVE      *BLANK        XX7TYP            1
     C                   MOVE      *BLANKS       XX7DES           30
     C                   MOVE      *BLANKS       XX7CDE            2
     C                   MOVE      *BLANK        XX7CAT
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      '7'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XX7CDE
     C                   MOVE      TTTYPE        XX7TYP
     C                   MOVE      TTDESC        XX7DES
     C                   MOVE      TTCTYP        XX7CAT            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION FILE FOR EXPENSE CONSTANT
     C*
     C                   MOVE      *BLANK        XTTYPE
     C                   MOVE      *BLANKS       XTDESC
     C                   MOVE      *BLANKS       XXCDEB            2
     C                   MOVE      *BLANK        XTCTYP            1
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C     TTCTYP        IFEQ      'E'
     C     TTTYPE        ANDEQ     'B'
     C                   MOVEL     TTKEY         XXCDEB
     C                   MOVE      TTTYPE        XTTYPE            1
     C                   MOVE      TTDESC        XTDESC           30
     C                   MOVE      TTCTYP        XTCTYP            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C* GET THE A/R TRANSACTION FILE FOR STATE TAX
     C*
     C                   MOVE      *BLANK        XSTYPE
     C                   MOVE      *BLANKS       XSDESC
     C                   MOVE      *BLANKS       XXTXBL            2
     C                   MOVE      *BLANK        XSCTYP            1
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C*
     C     TTCTYP        IFEQ      'T'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         XXTXBL
     C                   MOVE      TTTYPE        XSTYPE            1
     C                   MOVE      TTDESC        XSDESC           30
     C                   MOVE      TTCTYP        XSCTYP            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C* GET THE A/R TRANSACTION FILE FOR STATE TAX ON DEPOSIT
     C*
     C                   MOVE      *BLANK        X1TYPE
     C                   MOVE      *BLANKS       X1DESC
     C                   MOVE      *BLANKS       X1TXBL            2
     C                   MOVE      *BLANK        X1CTYP            1
     C*
     C     *LOVAL        SETLL     PTT01
     C                   READ      PTT01                                  60
     C     *IN60         DOWEQ     '0'
     C*
     C     TTCTYP        IFEQ      'D'
     C     TTTYPE        ANDEQ     'F'
     C                   MOVEL     TTKEY         X1TXBL
     C                   MOVE      TTTYPE        X1TYPE            1
     C                   MOVE      TTDESC        X1DESC           30
     C                   MOVE      TTCTYP        X1CTYP            1
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C  N60              READ      PTT01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C*  GET THE A/R TRANSACTION FILE
     C*
     C                   MOVEL(P)  QQSRCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      TTTYPE        XXTYPE            1
     C                   MOVE      TTDESC        XXDESC           30
     C                   MOVE      TTCTYP        XXCTYP            1
     C                   ELSE
     C                   MOVE      *BLANK        XXTYPE
     C                   MOVE      *BLANKS       XXDESC
     C                   MOVE      *BLANK        XXCTYP            1
     C                   END
     C*
     C                   MOVEL(P)  QQAJCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      TTTYPE        XATYPE            1
     C                   MOVE      TTDESC        XADESC           30
     C                   MOVE      TTCTYP        XACTYP            1
     C                   ELSE
     C                   MOVE      *BLANK        XATYPE
     C                   MOVE      *BLANKS       XADESC
     C                   MOVE      *BLANK        XACTYP            1
     C                   END
     C*
     C                   MOVEL(P)  QQESCD        XXKEY
      *
     C     TBKEY         CHAIN     PTT01                              60
      *
     C     *IN60         IFEQ      '0'
      *
     C                   MOVE      TTTYPE        XETYPE            1
     C                   MOVE      TTDESC        XEDESC           30
     C                   MOVE      TTCTYP        XECTYP            1
      *
     C                   ELSE
      *
     C                   MOVE      *BLANK        XETYPE
     C                   MOVE      *BLANKS       XEDESC
     C                   MOVE      *BLANK        XECTYP            1
      *
     C                   ENDIF                                                  *IN60 IFEQ '0'
     C*
     C*  GET NUMBER OF FUND POLICY DAYS
     C*
     C*  IF LEAP YEAR, LEAP DATE = 2-29-YR WE NEED TO CALCULATE THE
     C*  CORRECT PRORATA FOR SPLITTING PAYROLLS FOR ANNIV RATING
     C*
     C                   Z-ADD     0             XXLPDT            7 0
     C                   Z-ADD     F1STPO        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     F1ENPO        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        FDAYS             5 0
     C*
      *** Begin Add *** 02/06/24 *******************************************
      /Free
       If FNcgfl = 'Y';
          FDAYS = 365;
       Endif;
      /End-Free
      *** End   Add *** 02/06/24 *******************************************
     C                   ENDIF                                                  SVEMP# IFNE
     C*
     C     *IN91         IFEQ      *OFF
     C*
     C                   Z-ADD     X@DATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXDATE            7 0
     C                   MOVEL     XXDATE        CYM               5 0
     C                   MOVE      CYM           TRYM              5 0
     C                   Z-ADD     XXCO#         @@CO#
     C                   Z-ADD     XXFND         @@FND
     C                   Z-ADD     XXEMP#        @@EMP#
     C                   Z-ADD     XXDIV         @@DIV
     C                   Z-ADD     XXFYR         @@FYR
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         @@DATE
     C                   MOVEL     '*'           @@PLAN
      *
     C                   CALL      'WA002R'
     C                   PARM                    @@CO#             3 0
     C                   PARM                    @@FND             3 0
     C                   PARM                    @@EMP#            9 0
     C                   PARM                    @@DIV             5 0
     C                   PARM                    @@FYR             3 0
     C                   PARM                    @@AGT#            5 0
     C                   PARM                    @@ANAM           60
     C                   PARM                    @@PROD            5 0
     C                   PARM                    @@PNAM           60
     C                   PARM                    @@AREA            3 0
     C                   PARM                    @@PHON            7 0
     C                   PARM                    @@PLAN            1
     C                   PARM                    @@DATE            8 0
     C*
     C     @@PLAN        IFEQ      'A'
     C     XXACDT        ANDNE     *ZERO
     C*
     C                   MOVEL     XXDATE        XXYM1             5 0
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXYM2             5 0
     C*
     C* DEFAULT TO ACCOUNT CURRENT DATE IF POSTING DATE IS IN PRIOR MONTH.
     C*
     C     XXYM1         IFLT      XXYM2
     C                   Z-ADD     XXACDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXDATE            7 0
     C                   MOVEL     XXDATE        CYM               5 0
     C                   MOVE      CYM           TRYM              5 0
     C                   ENDIF                                                  XXYM1 IFLT
     C*
     C                   ENDIF                                                  @@PLAN IFEQ
     C*
     C*
     C*  READ THE EMPLOYER'S RECORD.
     C*
     C*
     C* RESET FIELDS FOR EMPLOYER A/R TOTALS
     C*
     C                   MOVE      ' '           XXWAR
     C                   Reset                   arrInvoice
     C                   Eval      sumRenewInv# = 0
     C                   Z-ADD     0             XTDEP            11 2
     C                   Z-ADD     0             XTTXDU           11 2
      *** Beg Add ***** 06/24/24 ****************************************
     C                   Z-ADD     0             XTCOLB           11 2
      *** End Add ***** 06/24/24 ****************************************
     C                   Z-ADD     0             totTxOnDep       11 2
     C                   Z-ADD     0             XTNET1           11 2
     C                   Z-ADD     0             XTEXCN           11 2
     C                   Z-ADD     0             XTMFEE           11 2
     C                   Z-ADD     0             XTSFEE           11 2
     C                   Z-ADD     0             XT1STB           11 2
     C                   Z-ADD     0             XT2NDB           11 2
     C                   Z-ADD     0             XT3RDB           11 2
     C                   Z-ADD     0             XT4THB           11 2
     C                   Z-ADD     0             XT5THB           11 2
     C                   Z-ADD     0             XTINSB           11 2
     C                   MOVE      *BLANKS       XXIFBL            2
     C                   MOVE      *BLANK        XXMINE            1
     C                   Z-ADD     0             XN1STB           11 2
     C                   Z-ADD     0             XN2NDB           11 2
     C                   Z-ADD     0             XN3RDB           11 2
     C                   Z-ADD     0             XN4THB           11 2
     C                   Z-ADD     0             XN5THB           11 2
     C                   Z-ADD     0             XT6THB           11 2
     C                   Z-ADD     0             XT7THB           11 2
     C                   Z-ADD     0             XN6THB           11 2
     C                   Z-ADD     0             XN7THB           11 2
     C*
     C     *IN95         IFEQ      *ON
     C     *IN96         OREQ      *ON
     C     *IN97         OREQ      *ON
     C     *IN98         OREQ      *ON
     C     *IN71         OREQ      *ON
     C     EMKEY         CHAIN     PEM01                              92
     C                   ELSE
     C     EMKY          CHAIN     PEM01                              92
     C                   ENDIF
     C*
     C     *IN92         DOWEQ     *OFF
     C                   Z-ADD     EMDIV         XXDIV
     C*
     C     EMSTRP        IFEQ      'Y'
     C                   Z-ADD     EMDIV         XSDIV
     C                   ENDIF

      /free
       If Ememp# <> S2emp#;
          s2Emp#  = EMemp#;
          stRptPDays = GetStRptPDays(xxCo#:xxFnd:xxEmp#:xxFyr:xxdiv);
          If fDays <> 0;
             stRptProRt = stRptPDays/Fdays;
          Else;
             stRptProRt = 0;
          Endif;
       Endif;
      /end-free

     C                   MOVE      'N'           XXDEDF
     C     ELKEY         CHAIN     PEL01                              93
      /free
       If svEmp# = 0;
          Exsr srEFTOnly;
       Endif;
       //*** Begin Add *** 06/12/24 ****************************************
       // Check to see if SR and if SR Assessments is off
       isSRAs = *Off;
       xxKey = %EditC(ELbsCd:'X');
       Chain (xxCo#:xxKey) pbs01;
       If %Found(wtabl) And BSseFl = 'S';
          If ELsrAs = ' ';
          //*** begin chg ***  01/29/25  ****************************
          //*****   Chain (xxCo#:xxFnd) pf101;
          //*****   If %Found(wdf1l) And F1SRAs = 'Y';
             If F1SRAs = 'Y';
          //*** begin chg ***  01/29/25  ****************************
                isSRAs = *On;
             EndIf;
          Else;
             isSRAs = *On;
          EndIf;
       EndIf;
       //*** End   Add *** 06/12/24 ****************************************
      /end-free
     C     *IN93         IFEQ      *OFF
     C     ELDCDE        IFNE      *BLANKS
     C                   MOVE      'Y'           XXDEDF            1
     C                   ENDIF
      *
     C                   Z-ADD     ELPFDT        X2PFDT
     C                   Z-ADD     ELPTDT        X2PTDT
     C                   Z-ADD     ELPROR        X2PROR
     C                   MOVEL     ELFFL9        X2FFL9
     C*
     C*  CHECK IF EMPLOYER IS CANCELLED
     C*
     C                   Z-ADD     1             Y                 3 0
     C     *ZERO         LOOKUP    ED(Y)                                  60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     5             Y
     C                   ELSE
     C                   SUB       1             Y
     C                   END
     C     Y             DOWNE     0
     C     ELPTDT        COMP      ED(Y)                              60  60
     C  N60              SUB       1             Y
     C  N60              END
     C*
     C     Y             IFNE      *ZERO
     C     CD(Y)         ANDNE     *ZERO
     C     QQOVR         ANDNE     'Y'
     C     Y             ORNE      *ZERO
     C     CD(Y)         ANDNE     *ZERO
     C     CD(Y)         ANDLT     XXDATE
     C     QQOVR         ANDEQ     'Y'
     C     Y             ORNE      *ZERO
     C     CD(Y)         ANDNE     *ZERO
     C     CD(Y)         ANDLT     ELPFDT
     C     QQOVR         ANDEQ     'Y'
     C                   MOVE      *ON           *IN93
     C                   END
     C*
      /Free
      *** Beg Add ***  10/15/24  ***  WC2984  ************************

       If CD(Y) <> 0  and *In93 = *Off and
          QQOVR = 'Y' and ELARSM = 'Y';
          *In93 = *On;
       EndIf;
      *** End Add ***  10/15/24  ***  WC2984  ************************
       If y <> 0;
          intCxDate = cd(y);
       Endif;
       // Check for override if cx'd. Allow to process if
       //  override is valid.
       If *In93 = *On
        And OvrRenewalCx(xxMode:xxCo#:xxFnd:xxEmp#:
         xxDiv:xxFyr:intCxDate) = *On;
          *In93 = *Off;
       Endif;
      *** Beg Add ***  10/15/24  ***  WC2984  ************************
       // Turning *In93 = *Off will allow a single division bill to run
       // on a deleted employer as long as it was submitted from the
       // prompt screen as a single division and was unbilled.

       If *In93 = *On and *In71 = *On;
          *In93 = *Off;
       EndIf;
      *** End Add ***  10/15/24  ***  WC2984  ************************
      /End-Free
     C                   ENDIF                                                  *IN93 IFEQ
     C     XXCLT#        IFEQ      '129'
      * Check for ACH or Payroll Vendor for possible skip record
     C     *IN93         IFEQ      *OFF
     C     ACHFLG        IFEQ      *ON
     C     VNDRFL        OREQ      *ON
     C                   EXSR      SRACH#
     C                   ENDIF                                                  ACHFLG/VNDRFL
     C                   ENDIF                                                  *IN93 IFEQ
     C                   ENDIF                                                  XXCLT# = '129'
     C*
     C     *IN93         IFEQ      *OFF
     C     *IN71         IFEQ      *ON
     C     ELARSM        ANDEQ     'Y'
     C*
     C     EMKY          CHAIN     PEM01                              60
     C     *IN60         DOWEQ     *OFF
     C     EMSTRP        ANDNE     'Y'
     C     EMKY          READE     PEM01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   Z-ADD     EMDIV         XSDIV
     C*
     C* RESET EMPLOYER INFORMATION
     C*
     C     EMKEY         CHAIN     PEM01                              60
     C*
     C                   ENDIF                                                  *IN71 IFEQ
     C                   MOVE      'Y'           XXVAL             1
     C*
     C* CHAIN OUT TO THE STATISTICAL REPORTING/RATING FILE.
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C*
     C                   Z-ADD     ELPFDT        XXEFDT
      *
     C     RRKY          SETGT     PIF01
     C     RRKY1         READPE    PIF01                                  60
      *
     C     *IN60         IFEQ      *ON
     C                   MOVE      *BLANKS       IFIFBL
     C                   Z-ADD     0             IFIFEE
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C*
     C     XXCLT#        IFEQ      '132'
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY2
     C                   MOVEL     SRDTO         @DATE1            6 0
     C                   MOVEL     '*'           @PLAN1            1
     C                   CALL      'SRFUTR8'
     C                   PARM      @DATE1        QQDT1             8 0
     C                   PARM      XXDAYS        QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C     QQERR         IFNE      '1'
     C                   MOVE      QQDT1         SCDT1             8 0
     C                   ENDIF
     C*
     C     ELBSDT        IFGT      XXDATE
     C                   MOVE      ELBSDT        XXDATE
     C                   MOVEL     XXDATE        CYM
     C                   MOVE      CYM           TRYM
     C                   END
     C                   ENDIF
     C     XXCLT#        IFNE      '132'
     C     ELBSDT        IFGT      XXDATE
     C                   MOVE      ELBSDT        XXDATE
     C                   MOVEL     XXDATE        CYM
     C                   MOVE      CYM           TRYM
     C                   END
     C*
     C                   ENDIF
     C*
     C*  GET NUMBER OF EMPLOYER POLICY DAYS
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PDAYS             5 0
     C*
     C*  CALCULATE PREMIUM TWICE, FIRST RUN IS FOR TAXABLE PREMIUM.
     C*
     C*
     C                   Z-ADD     *ZERO         XXHIGH
     C*
     C*  CLEAR EXPERIENCE MODIFIER BUCKETS
     C*
     C                   Z-ADD     *ZERO         XXEXM1            5 2
     C                   Z-ADD     *ZERO         XXEXM2            5 2
     C                   Z-ADD     *ZERO         XXEXM3            5 2
     C                   Z-ADD     *ZERO         XXEXP1           11 0
     C                   Z-ADD     *ZERO         XXEXP2           11 0
     C                   Z-ADD     *ZERO         XXEXP3           11 0
     C                   MOVE      *BLANKS       SVEFDT
     C                   MOVE      *BLANKS       XHEFDT            7 0
     C                   Z-ADD     ELMFEE        F1MFEE
     C*
     C* IF ANY DIVISION HAS A MEMBERSHIP FEE, PROCESS IT EVEN IF GROUP DETAIL
     C* ISN'T SET UP FOR IT
     C*
     C                   Z-ADD     ELMFEE        SVMFEE
     C     XXMFFL        IFEQ      ' '
     C     ELMFEE        ANDNE     *ZERO
     C                   MOVE      'Y'           XXMFFL            1
     C                   ENDIF
     C*
     C*  CLEAR PAYROLL ARRAYS
     C*
     C                   Z-ADD     9999999       PDAT
     C                   Z-ADD     9999999       RDAT
     C                   Z-ADD     9999999       FDAT
     C                   Z-ADD     0             PRO
     C                   Z-ADD     0             MAN
     C                   Z-ADD     0             LM
     C                   Z-ADD     0             LM2
     C                   Z-ADD     0             STN
     C                   Z-ADD     0             MANT
     C                   Z-ADD     0             LMT
     C                   Z-ADD     0             LM2T
     C                   Z-ADD     0             MAN1
     C                   Z-ADD     0             LM1
     C                   Z-ADD     0             LM21
     C                   Z-ADD     0             MAN2
     C                   Z-ADD     0             LM2A
     C                   Z-ADD     0             LM22
     C                   Z-ADD     0             MAN3
     C                   Z-ADD     0             LM3
     C                   Z-ADD     0             LM23
     C                   Z-ADD     0             MAN4
     C                   Z-ADD     0             LM4
     C                   Z-ADD     0             LM24
     C                   Z-ADD     0             MAN5
     C                   Z-ADD     0             LM5
     C                   Z-ADD     0             LM25
     C                   Z-ADD     0             MAN6
     C                   Z-ADD     0             LM6
     C                   Z-ADD     0             LM26
     C                   Z-ADD     0             MAN7
     C                   Z-ADD     0             LM7
     C                   Z-ADD     0             LM27
     C                   Z-ADD     0             FCL
     C                   Z-ADD     0             LPR
     C                   Z-ADD     0             MAND                           NON-DEVIATED
     C                   Z-ADD     0             ADLD                           NON-DEVIATED
     C                   Z-ADD     0             EXP
     C                   Z-ADD     0             ADL
     C                   Z-ADD     0             ADL2
     C                   Z-ADD     0             ADL3
     C                   Z-ADD     0             SVN
     C                   Z-ADD     0             STNT
     C                   Z-ADD     0             SVNT
     C                   Z-ADD     0             EXPT
