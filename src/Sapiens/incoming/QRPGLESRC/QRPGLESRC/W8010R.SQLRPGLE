     C                   Z-ADD     0             EXP6
     C                   Z-ADD     0             STN7
     C                   Z-ADD     0             SVN7
     C                   Z-ADD     0             EXP7
     C                   Z-ADD     0             A6J
     C                   Z-ADD     0             A6E
     C                   Z-ADD     0             A6S
     C                   Z-ADD     0             A6D
     C                   Z-ADD     0             A7J
     C                   Z-ADD     0             A7E
     C                   Z-ADD     0             A7S
     C                   Z-ADD     0             A7D
     C                   Z-ADD     0             WAV6
     C                   Z-ADD     0             WAV7
     C                   Z-ADD     0             A1J
     C                   Z-ADD     0             A1E
     C                   Z-ADD     0             A1S
     C                   Z-ADD     0             A1D
     C                   Z-ADD     0             A2J
     C                   Z-ADD     0             A2E
     C                   Z-ADD     0             A2S
     C                   Z-ADD     0             A2D
     C                   Z-ADD     0             A3J
     C                   Z-ADD     0             A3E
     C                   Z-ADD     0             A3S
     C                   Z-ADD     0             A3D
     C                   Z-ADD     0             A4J
     C                   Z-ADD     0             A4E
     C                   Z-ADD     0             A4S
     C                   Z-ADD     0             A4D
     C                   Z-ADD     0             A5J
     C                   Z-ADD     0             A5E
     C                   Z-ADD     0             A5S
     C                   Z-ADD     0             A5D
     C                   Z-ADD     0             WAV
     C                   Z-ADD     0             WAV1
     C                   Z-ADD     0             WAV2
     C                   Z-ADD     0             WAV3
     C                   Z-ADD     0             WAV4
     C                   Z-ADD     0             WAV5
     C                   Z-ADD     0             WAVT
     C                   Z-ADD     0             WAVL
     C                   Z-ADD     0             DIS
     C                   Z-ADD     0             PRM
     C                   Z-ADD     0             XXLPRM           15 4
     C*** begin add ***  11/12/24  ******************************************
     C                   Z-ADD     0             XXLPRM1          15 4
     C                   Z-ADD     0             XXLPRM2          15 4
     C                   Z-ADD     0             XXLPRM3          15 4
     C                   Z-ADD     0             XXLPRM4          15 4
     C                   Z-ADD     0             XXLPRM5          15 4
     C                   Z-ADD     0             XXLPRM6          15 4
     C                   Z-ADD     0             XXLPRM7          15 4
     C*** end add *****  11/12/24  ******************************************
     C                   Z-ADD     0             STOC
     C                   Z-ADD     0             EXPS
     C                   Z-ADD     0             XXDSPR
     C                   Z-ADD     0             XNDISP
     C                   Z-ADD     0             SUB
     C                   Z-ADD     0             MOD
     C                   Z-ADD     0             STD
     C                   Z-ADD     0             NOM
     C                   Z-ADD     0             ANL
     C                   Z-ADD     0             EHCN
     C                   Z-ADD     0             EDC1
     C                   Z-ADD     0             EDC2
     C                   Z-ADD     0             D1E2
     C                   Z-ADD     0             D2E2
     C                   Z-ADD     0             EDC3
     C                   Z-ADD     0             EDV2
     C                   Z-ADD     0             EDCT
     C                   Z-ADD     0             EDD2
     C                   Z-ADD     0             EDCM
     C                   Z-ADD     0             EDCS
     C                   Z-ADD     0             EDC
     C                   Z-ADD     0             EPRM
     C                   Z-ADD     0             EXA1
     C                   Z-ADD     0             EXA2
     C                   Z-ADD     0             EXA3
     C                   Z-ADD     0             ETCA
     C                   Z-ADD     0             ASM1
     C                   Z-ADD     0             ASM2
     C                   Z-ADD     0             ASM3
     C                   Z-ADD     0             ASM4
     C                   Z-ADD     0             ASM5
     C                   Z-ADD     0             ARP1
     C                   Z-ADD     0             ARP2
     C                   Z-ADD     0             ARP3
     C                   Z-ADD     0             DTR
     C                   Z-ADD     0             ETR
     c                   Z-ADD     0             NTR
     c                   Z-ADD     0             LCM
     C                   Z-ADD     0             ERT
     C                   Z-ADD     0             DRT
     C                   Z-ADD     0             ART1
     C                   Z-ADD     0             ART2
     C                   Z-ADD     0             ART3
     C                   Z-ADD     0             ART4
     C                   Z-ADD     0             ART5
     C                   Z-ADD     0             ART6
     C                   Z-ADD     0             ART7
      //*** Beg Add ***** 08/14/24 ********************************************
       Clear LMB;
       Clear LMB2;
      //*** End Add ***** 08/14/24 ********************************************
     C                   If        ELMANP <> 0 and *in96 = *on
     C     ELKEY         CHAIN     PLD01                              60
     C                   If        *in60 = *off
     C                   Z-add     0             LDPct1
     C                   Update    pld01
     C                   Endif
     C                   Endif
       //* Save off the invoice # of the renewal quote new business
       //* payment to assign for the 1st installment on renewal policy
       //* if this is the first bill being run for the division.

        renewInv# = 0;
        Setll elkey pea03;
        Reade(n) elkey pea03;

        Dow not %eof;
           If EAARCD = F2NPCD;
              Leave;
           Endif;
           Reade elkey pea03;
        Enddo;
        //*** Begin Add *** 09/04/25 ***************************************
        Clear EAref#;
        Clear EAinvTypId;
        //*** End   Add *** 09/04/25 ***************************************

        If not %eof;
           Setll elkey peh01;
           Reade(n) elkey peh01;

           If %eof and ELNWRW = 'R';
              renewInv# = EANINV;
              If EMStrp = 'Y' and ELARSM = 'Y';
                 sumRenewInv# = renewInv#;
              Endif;
           Endif;

        Endif;
     C*
     C*
     C* FIND THE GOVERNING CLASS ON THE POLICY.
     C*
     C                   Z-ADD     0             XXGOVC            5 0
     C                   MOVE      *BLANK        XXGOVF            1
     C                   Z-ADD     0             XXGOVP           15 0
     C*
     C* ONLY PROCESS CODE IF EMPLOYER DETAIL IS GOING TO BE UPDATED.
     C*
     C     *IN97         IFEQ      *OFF
      /Free

        //*** begin chg *** 10/19/23  **********************************
        //*****Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'G') pev00;
        Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'G':xxst) pev00;
        //*** end chg ***** 10/19/23  **********************************
        If %found;
           xxGovC = EVxxGovC;
        Else;

      /End-Free
     C*
     C* SET THE GOVERNING CLASS FIELD ON STATE RPT DIVISION ONLY.
     C*
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C                   CLEAR                   XPARA
     C                   ENDDO
     C*
     C* CHECK ALL PAYROLL RECORDS FOR POLICY YEAR.
     C*
     C                   Z-ADD     XXDIV         SVDIV
     C*
     C     EPKEY3        CHAIN     PEP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPSTAT        IFNE      'I'
     C*
     C                   Z-ADD     EPDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C*
     C* BUILD GOVERNING CLASS OFF ALL CLASSES WITHIN THIS DIVISION'S STATE.
     C*
     C     *IN60         IFEQ      *OFF
     C     RSJRST        ANDEQ     XXST
     C*
     C*  SET MULTI OCCR DS TO MATCHING CLASS ELEMENT OR NEXT AVAILABLE.
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C* NEXT AVAILABLE
     C     XPCLAS        IFEQ      *ZERO
     C                   MOVE      EPCLAS        XPCLAS
     C                   LEAVE
     C                   ENDIF                                                  XPCLAS IFEQ
     C* MATCHING CLASS
     C     XPCLAS        IFEQ      EPCLAS
     C                   LEAVE
     C                   ENDIF                                                  XPCLAS IFEQ
     C*
     C                   ENDDO                                                  DO Z:1-255
     C*
     C* TOTAL PAYROLL FIELD.
     C*
     C                   ADD       EPEAPR        XPPAY
     C*
     C* CHECK GOVERNING CLASS EXCLUSION FLAG.
     C*
     C                   Z-ADD     XPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C*
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     *IN60         IFEQ      '0'
     C                   MOVE      PRGVEX        XPFLAG
     C                   ENDIF
     C*
     C     XPFLAG        IFEQ      *BLANK
     C                   MOVE      'Y'           XXGOVF
     C                   ENDIF
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  EPSTAT IFEQ
     C*
     C     EPKEY3        READE     PEP01                                  60
     C                   ENDDO
     C*
     C* CHECK FOR CLASS WITH HIGHEST PAYROLL TOTAL.  IGNORE EXCLUDED
     C* CLASSES IF ANY CLASS ON THE POLICY IS NOT EXCLUDED.
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C*
     C     XXGOVF        IFEQ      *BLANK
     C     XPFLAG        OREQ      *BLANK
     C*
     C     XPPAY         IFGE      XXGOVP
     C     XPCLAS        ANDNE     *ZERO
     C                   Z-ADD     XPCLAS        XXGOVC
     C                   Z-ADD     XPPAY         XXGOVP
     C                   ENDIF                                                  XPPAY IFGT
     C*
     C                   ENDIF                                                  XXGOVF IFEQ
     C*
     C                   ENDDO                                                  Z: 1-255
     C*
     C* RESET EMPLOYER INFORMATION.
     C*
     C                   Z-ADD     SVDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C*
     C     RSKY          CHAIN     PRS01                              60
     C*
      /Free

           Clear pev00;
           EVCo# = xxCo#;
           EVFnd = xxFnd;
           EVFyr = xxFyr;
           EVEmp# = xxEmp#;
           EVType = 'G';
           EVxxGovC = xxGovC;
        //*** begin add *** 10/19/23  **********************************
           EVSt  = xxSt;
        //*** end add ***** 10/19/23  **********************************
           Write pev00;
        Endif;

      /End-Free
     C                   ENDIF                                                  *IN97 IFEQ
     C*
     C* FIND THE MINIMUM PREMIUM CLASS CODE ON THE POLICY.
     C*
     C                   Z-ADD     0             SVMINC            5 0
     C                   Z-ADD     0             XXMINP           15 0
     C                   Z-ADD     0             XXSVRT            7 2
     C                   Z-ADD     0             XXNJMN           11 0
     C*
      /Free
        //* Minimum cannot be determined on manual premium run.
        If *in96 = *off;

           Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'N') pev00;
           If %found;
              xxNJMN = EVxxNJMN;
           Else;

      /End-Free
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C                   CLEAR                   XPARA
     C                   ENDDO
     C*
     C* CHECK ALL PAYROLL RECORDS FOR POLICY YEAR.
     C*
     C                   Z-ADD     XXDIV         SVDIV
     C*
     C     EPKEY3        CHAIN     PEP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPSTAT        IFNE      'I'
     C*
     C                   Z-ADD     EPDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C*
     C     RSJRST        IFEQ      'NJ'
     C*
     C*  SET MULTI OCCR DS TO MATCHING CLASS ELEMENT OR NEXT AVAILABLE.
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C* NEXT AVAILABLE
     C     XPCLAS        IFEQ      *ZERO
     C                   MOVE      EPCLAS        XPCLAS
     C                   LEAVE
     C                   ENDIF                                                  XPCLAS IFEQ
     C* MATCHING CLASS
     C     XPCLAS        IFEQ      EPCLAS
     C                   LEAVE
     C                   ENDIF                                                  XPCLAS IFEQ
     C*
     C                   ENDDO                                                  DO Z:1-255
     C*
     C* TOTAL PAYROLL FIELD.
     C*
     C                   ADD       EPEMPR        XPPAY
     C*
     C* STORE THE MINIMUM PREMIUM AMOUNT.
     C*
     C                   Z-ADD     XPCLAS        XXCLAS
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C*
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     PRMNPR        XPMIN
     C                   Z-ADD     PRRT          XPRT
     C                   ENDIF
     C*
     C                   ENDIF                                                  RSJRST IFEQ
     C*
     C                   ENDIF                                                  EPSTAT IFEQ
     C*
     C     EPKEY3        READE     PEP01                                  60
     C                   ENDDO
     C*
     C* CHECK FOR CLASS WITH HIGHEST PREMIUM TOTAL FOR NJ.
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C*
     C     XPPAY         IFGT      XXMINP
     C                   Z-ADD     XPCLAS        SVMINC
     C                   Z-ADD     XPPAY         XXMINP
     C                   Z-ADD     XPMIN         XXNJMN
     C                   ENDIF                                                  XPPAY IFGT
     C*
     C                   ENDDO                                                  Z: 1-255
     C*
     C     XXMINP        IFEQ      *ZERO
     C*
     C* CHECK FOR CLASS WITH HIGHEST RATE FOR NJ IF ALL CLASSES ARE
     C* ON IF ANY BASIS.
     C*
     C     1             DO        255           Z
     C     Z             OCCUR     XPARA
     C*
     C     XPRT          IFGT      XXSVRT
     C                   Z-ADD     XPCLAS        SVMINC
     C                   Z-ADD     XPRT          XXSVRT
     C                   Z-ADD     XPMIN         XXNJMN
     C                   ENDIF                                                  XPPAY IFGT
     C*
     C                   ENDDO                                                  Z: 1-255
     C*
     C                   ENDIF                                                  XXMINP IFEQ
     C*
     C* RESET EMPLOYER INFORMATION.
     C*
     C                   Z-ADD     SVDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
      /Free

              Clear pev00;
              EVCo# = xxCo#;
              EVFnd = xxFnd;
              EVFyr = xxFyr;
              EVEmp# = xxEmp#;
              EVType = 'N';
              EVxxNJMN = xxNJMN;
              Write pev00;
           Endif;

        Endif;

      /End-Free
     C                   Z-ADD     XXDIV         X1DIV             5 0
     C                   Z-ADD     0             X1PFDT            7 0
     C                   Z-ADD     ELPFDT        XSPFDT            7 0
     C                   Z-ADD     0             X1ANDT            7 0
     C                   MOVE      *OFF          *IN61
     C                   If        xxdiv <> xsdiv
     C                   Z-ADD     XSDIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   If        *in60 = *off
     C                   Z-add     ELPFDT        XSPFDT
     C                   MOVE      *ON           *IN61
     C                   Z-ADD     ELPFDT        X1PFDT
     C                   Z-ADD     ELANDT        X1ANDT
     C                   Endif
     C                   Z-ADD     X1DIV         XXDIV
     C                   Endif
     C*
     C* RESET EMPLOYER INFORMATION
     C*
     C                   Z-ADD     X1DIV         XXDIV
     C     EMKEY         CHAIN     PEM01                              60
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C*
     C* DETERMINE IF STATE REPORTING DIV INFO MUST BE USED FOR RATES
     C*
     C                   Z-ADD     0             XXSTDT            7 0
     C*
     C     *IN61         IFEQ      *ON
     C     ELANDT        ANDEQ     *ZERO
     C*
     C     X1ANDT        IFNE      *ZERO
     C                   ADD       10000         X1ANDT
     C     X1ANDT        IFLE      ELPFDT
     C                   Z-ADD     X1ANDT        XXSTDT
     C                   ELSE
     C     X1ANDT        SUB       10000         XXSTDT
     C                   ENDIF
     C                   ENDIF
     C*
     C     XXSTDT        IFEQ      *ZERO
     C     X1PFDT        IFLT      ELPFDT
     C                   Z-ADD     X1PFDT        XXSTDT
     C                   ENDIF
     C                   ENDIF
     C*
     C                   ENDIF                                                  *IN61 IFEQ
     C*
     C*   INITIALIZE ADDITIONAL LOAD FIELD
     C*
     C                   Z-ADD     *ZERO         XXADLD           15 4
     C*
     C*   LOAD DEDUCTIBLE DISCOUNT RATE FROM TABLE FILE
     C*
     C                   MOVE      *ZERO         ELDDCT
     C                   MOVE      *ZERO         XXDDCT
     C                   MOVE      *ZERO         ELDD2P
     C                   MOVE      *ZERO         XXDD2P
     C                   MOVE      *BLANKS       EL2DDP
     C                   MOVE      *BLANKS       EL2APO
     C                   MOVE      *BLANKS       EL2AAG
     C                   MOVE      *BLANKS       XX2DDP
     C                   MOVE      *BLANKS       XX2APO
     C                   MOVE      *BLANKS       XX2AAG
     C*
     C                   MOVE      *BLANK        XXLRGD            1
     C*
     C*   VERIFY IF POLICY IS LARGE DEDUCTIBLE BASED ON BILLING SCHEDULE CODE
     C*
     C                   MOVEL(P)  ELBSCD        XXKEY
     C     TBKEY         CHAIN     PBS01                              60
     C*
     C     *IN60         IFEQ      *ZERO
     C     BSLPGM        ANDEQ     'L'
     C*
     C     ELKEY         CHAIN(N)  PLD01                              60
     C     *IN60         IFEQ      *OFF
     C                   MOVE      'Y'           XXLRGD
      **** Beg add ***** 06/11/24 **************************
     C                   MOVE      'Y'           XXDEDF
      **** End add ***** 06/11/24 **************************
     C*** begin add ***  09/24/24  *****************************************
     C                   Z-add     LDPCT1        xxddct
     C*** end add *****  09/24/24  *****************************************
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ELSE
     C     *LIKE         DEFINE    DDCODE        XXDDCD
     C     *LIKE         DEFINE    EPEAPR        XXEAPR
     C*
     C                   MOVEL(P)  ELDCDE        XXDDCD
     C                   MOVE      ELDCEF        Q1DATE7
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q1DATE7           7
     C*
     C                   MOVE      Q1DATE7       XXDDT
     C*
     C     DDKY          SETGT     PDD01
     C     DDKY2         READPE    PDD01                                  60
     C     *IN60         IFEQ      *ON
     C                   MOVE      *ZERO         ELDDCT
     C                   MOVE      *ZERO         XXDDCT
     C                   ELSE
     C     DDSTAT        IFEQ      'A'
     C                   MOVE      DDPCT         ELDDCT
     C                   MOVE      DDPCT         XXDDCT
     C                   ENDIF
     C                   ENDIF
     C*
     C                   MOVEL(P)  ELDCD2        XXDDCD
     C                   MOVE      EL2DEF        Q1DATE7
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q1DATE7           7
     C*
     C                   MOVE      Q1DATE7       XXDDT
     C*
     C     DDKY          SETGT     PDD01
     C     DDKY2         READPE    PDD01                                  60
     C*
     C     *IN60         IFEQ      *ON
     C                   MOVE      *ZERO         ELDD2P
     C                   MOVE      *ZERO         XXDD2P
     C                   MOVE      *BLANKS       EL2DDP
     C                   MOVE      *BLANKS       EL2APO
     C                   MOVE      *BLANKS       EL2AAG
     C                   MOVE      *BLANKS       XX2DDP
     C                   MOVE      *BLANKS       XX2APO
     C                   MOVE      *BLANKS       XX2AAG
     C                   ELSE
     C     DDSTAT        IFEQ      'A'
     C                   MOVE      DDPCT         ELDD2P
     C                   MOVE      DDPCT         XXDD2P
     C* Populate deductible info for 2nd deductible                    **
     C* When it is assigned automatically for ARD purposes             **
     C                   MOVE      DDTYPE        EL2DDP
     C                   MOVE      DDAMPO        EL2APO
     C                   MOVE      DDAMAG        EL2AAG
     C                   MOVE      DDTYPE        XX2DDP
     C                   MOVE      DDAMPO        XX2APO
     C                   MOVE      DDAMAG        XX2AAG
     C                   ENDIF
     C                   ENDIF
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C* LOAD THE ANNIVERSARY RATING DATE AND APPROPRIATE ARRAYS.
     C*
     C                   MOVE      '0'           *IN77
     C                   MOVEA     '11'          *IN(78)
     C                   Z-ADD     ELPFDT        PDAT(1)
     C                   Z-ADD     ELPFDT        RDAT(1)
     C     XXSTDT        IFNE      *ZERO
     C                   Z-ADD     XXSTDT        RDAT(1)
     C                   ENDIF
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   Z-ADD     0             XXANDT
     C                   Z-ADD     2             X
     C                   Z-ADD     ELPFDT        XXEFDT
     C*
     C     ELANDT        IFNE      0
     C     ELANDT        ANDNE     ELPFDT
     C*
     C                   MOVE      ELANDT        XXANDT
     C                   ADD       1             XXANYR
     C*
     C     XXANDT        IFGT      ELPFDT
     C                   MOVE      ELANDT        RDAT(1)
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   MOVE      *ON           *IN77
     C                   ENDIF
     C*
     C     XXANDT        IFGE      ELPTDT
     C     XXANDT        ORLE      ELPFDT
     C                   MOVE      *ON           *IN78
     C                   ELSE
     C                   MOVE      *OFF          *IN78
     C                   ENDIF
     C*
     C     *IN78         IFEQ      '0'
     C     ELEMD1        ANDEQ     ELANDT
     C     ELEMD2        ANDEQ     XXANDT
     C     ELEXM1        ANDNE     ELEXM2
     C                   MOVE      '0'           *IN79
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C     *IN78         IFEQ      '0'
     C                   Z-ADD     XXANDT        PDAT(X)
     C                   Z-ADD     XXANDT        RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                    *IN78='0'
     C*
     C                   ENDIF
     C*
     C                   Z-ADD     ELPTDT        PDAT(X)
     C*
     C                   MOVE      *OFF          *IN75
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 10/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFLT      1031001
     C     PDAT(W)       ANDLT     1031001
     C     PDAT(Z)       ANDGT     1031001
     C*
     C                   ADD       1             X
     C                   Z-ADD     1031001       PDAT(X)
     C                   Z-ADD     1031001       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   MOVE      *ON           *IN75
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 W
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C                   MOVE      *OFF          *IN76
     C                   ADD       1             X
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 4/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1030101
     C     RDAT(W)       ANDLE     1030331
     C     PDAT(W)       ANDLT     1030401
     C     PDAT(Z)       ANDGT     1030401
     C*
     C                   Z-ADD     1030401       PDAT(X)
     C                   Z-ADD     1030401       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   MOVE      *ON           *IN76
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 4 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C*
     C* FL RATE SPLIT FOR 07/01/09
     C*
     C                   MOVE      *OFF          XX0709            1
     C     XXST          IFEQ      'FL'
     C     CLTID         ANDEQ     '139'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1090401
     C     RDAT(W)       ANDLT     1090701
     C     PDAT(W)       ANDLT     1090701
     C     PDAT(Z)       ANDGT     1090701
     C                   Z-ADD     1090701       PDAT(X)
     C                   Z-ADD     1090701       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   MOVE      *ON           XX0709            1
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C                   MOVE      *OFF          XXDEFL            1            DE SPLIT FLAG
     C     XXST          IFEQ      'DE'
     C*DE rate split flag
     C     EXDE08        ANDNE     'Y'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFLT      1081001
     C     PDAT(W)       ANDLT     1081001
     C     PDAT(Z)       ANDGT     1081001
     C                   Z-ADD     1081001       PDAT(X)
     C                   Z-ADD     1081001       RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   MOVE      *ON           XXDEFL            1            DE SPLIT FLAG
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* AZ RATE SPLIT FOR 01/01/2010
     C*
     C                   MOVE      *OFF          XXAZ10            1
     C     XXST          IFEQ      'AZ'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     c                   if        rdat(w) >= 1091001 and
     c                             rdat(w) <= 1091231 and
     c                             pdat(w) <  1100101 and
     c                             pdat(z) >  1100101
     C                   Z-ADD     1100101       PDAT(X)
     C                   Z-ADD     1100101       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   MOVE      *ON           XXAZ10            1
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C*
     C* OK RATE SPLIT FOR 09/01/2010
     C*
     C                   move      *off          xxOK10            1
     C                   if        xxst = 'OK'
     C* Check opt out flag for OK 1100901 rate change
     C                   z-add     1100901       xxSpltDt          7 0
     C                   if        ApplyRateSplit(xxst:xxSpltDt)
     C                   do        6             W                 2 0
     C                   eval      z = w + 1
     C*
     C                   if        rdat(w) <> *hival  and
     C                             rdat(w) < xxSpltDt and
     C                             pdat(w) < xxSpltDt and
     C                             pdat(z) > xxSpltDt
     C*
     C                   eval      pdat(x) = xxSpltDt
     C                   eval      rdat(x) = xxSpltDt
     C                   eval      fdat(x) = rdat(w)
     C                   eval      xxOK10 = *on
     C*
     C                   endif                                                  RDAT,W IFGE
     C*
     C                   enddo                                                  DO 6 X
     C                   endif                                                  ApplyRateSplit
     C*
     C                   endif                                                  xxst
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C*
     C*
     C                   DO        6             X
     C*
     C     PDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         PDAT(X)
     C                   ENDIF
     C     RDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         RDAT(X)
     C                   ENDIF
     C     FDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         FDAT(X)
     C                   ENDIF
     C*
     C                   ENDDO
     C*
     C*
     C* LOAD DEVIATION ARRAY FOR MA DIA BREAKOUT
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     0
     C                   Z-ADD     RDAT(X)       XXEFDT
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C     RRRDEV        MULT(H)   .01           XXRDEV            5 4
     C     1             SUB       XXRDEV        XXRDEV
     C                   Z-ADD     XXRDEV        RDEV(X)
     C                   ADD       1             X
     C                   ENDDO
     C*
      * Load up terrorism rates into arrays by FDAT
      /free
       x = 1;
       Dow fDat(x) <> 0;
          xxEfDt = fDat(x);
          If xxSt = 'NJ';
            xxEfDt = xspfdt;
          Endif;
          Setgt rrKy prr01;
          Readpe rrky1 prr01;
          If not(%eof);
            pyTRt(x) = RRterr;      //Payroll based foreign terrorism rate
            dmTrt(x) = RRdtrr;      //Domestic terrorism rate
            npTRt(x) = RRter2;      //Non-payroll based foreign terrorism rate
          Endif;
          x += 1;
       Enddo;
      /end-free
     C                   Z-ADD     ELPFDT        XXEFDT
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C*
     C*  IF POLICY IS ANNIVERSARY RATED AND HAS A DEDUCTIBLE DISCOUNT,
     C*  COPY THAT DISCOUNT TO 2ND DEDUCTIBLE FOR RATING PURPOSES IF
     C*  THERE IS NO 2ND DEDUCTIBLE ALREADY.
     C*
     C     *IN78         IFEQ      '0'
     C     ELDCDE        ANDNE     *BLANKS
     C     ELDCD2        ANDEQ     *BLANKS
     C*
     C* FIRST DEDUCTIBLE IS EFFECTIVE BEFORE THE SPLIT.
     C*
     C     ELDCEF        IFLT      XXANDT
     C     ELDCEF        OREQ      *ZERO
     C*
     C* FIRST DEDUCTIBLE DOES NOT EXPIRE BEFORE SPLIT.
     C*
     C     ELDCEX        IFGT      XXANDT
     C     ELDCEX        OREQ      *ZERO
     C*
     C                   MOVE      ELDCDE        ELDCD2
     C                   MOVE      XXANDT        EL2DEF
     C*
     C* UPDATE 2ND DEDUCTIBLE WITH EXPIRATION DATE OF 1ST DEDUCTIBLE.
     C*
     C     ELDCEX        IFGT      XXANDT
     C                   MOVE      ELDCEX        EL2DEX
     C                   ENDIF
     C                   MOVE      XXANDT        ELDCEX
     C*
     C                   MOVEL     Q1USER        ELUSER
     C                   MOVEL     Q1PGM         ELPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         ELDT
     C                   Z-ADD     DSTIME        ELTIME
     C*
     C* UPDATE EMPLOYER DETAIL AND RESET FILE.
     C*
     C                   UPDATE    PEL01
     C*
     C     ELKEY         CHAIN     PEL01                              60
     C*
     C                   ENDIF                                                  ELDCEX IFGT
     C*
     C                   ENDIF                                                  ELDCEF IFLT
     C*
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C*
     C*  GET NUMBER OF DAYS IN EACH ANNIV RATING PERIOD
     C*  START FROM ELPFDT BECAUSE ANNUAL PAYROLL AMOUNTS ARE USED
     C*
     C                   Z-ADD     0             PDAYS1            5 0
     C                   Z-ADD     0             PDAYS2            5 0
     C*
     C     *IN78         IFEQ      '0'
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C*  SUBTRACT 1 FROM 1ST ANNIV PERIOD IF IT IS LEAP YEAR AND
     C*  FEBRUARY 29 FALLS WITHIN THE FIRST PERIOD.
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXANDT
     C                   SUB       1             QQDAYS
     C                   END
     C*
     C                   Z-ADD     QQDAYS        PDAYS1
     C     PDAYS         SUB       PDAYS1        PDAYS2
     C*
     C                   END
     C*
     C*  IF ANNIVERSARY RATING IN EFFECT, MAKE SURE PAYROLLS ARE SPLIT
     C*
     C                   Z-ADD     0             ELPROR
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         ELPROR
     C                   ENDIF                                                  FDAYS IFNE 0
     C*
     C  N78              EXSR      SRPYRL
     C     *IN76         IFEQ      *ON
     C*
     C*  GET NUMBER OF DAYS IN EACH RATING PERIOD FOR A 4/1/3 RATE CHG.
     C*
     C                   Z-ADD     0             RDAYS1            5 0
     C                   Z-ADD     0             RDAYS2            5 0
     C                   Z-ADD     ELPFDT        XXFDT             7 0
     C                   Z-ADD     ELPTDT        XXTDT             7 0
     C                   Z-ADD     PDAYS         RDAYS             5 0
     C*
     C     *IN78         IFEQ      *OFF
     C*
     C     1030401       IFGT      XXANDT
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     XXANDT        XXFDT
     C                   Z-ADD     ELPTDT        XXTDT
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     ELPFDT        XXFDT
     C                   Z-ADD     XXANDT        XXTDT
     C                   ENDIF                                                  1030401 IFGT
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXTDT
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C* FIND # DAYS IN FIRST PERIOD.
     C*
     C                   Z-ADD     XXFDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     1030401       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     1030401
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS1
     C     RDAYS         SUB       RDAYS1        RDAYS2
     C*
     C*  IF FL 4/1/3 RATE CHG IN EFFECT, MAKE SURE PAYROLLS ARE SPLIT
     C*
     C                   EXSR      SRFLRT
     C                   ENDIF                                                  *IN76 IFEQ
     C     *IN75         IFEQ      *ON
     C*
     C*  GET NUMBER OF DAYS IN EACH RATING PERIOD FOR A 10/1/3 RATE CHG.
     C*
     C                   Z-ADD     0             RDAYS1            5 0
     C                   Z-ADD     0             RDAYS2            5 0
     C                   Z-ADD     ELPFDT        XXFDT             7 0
     C                   Z-ADD     ELPTDT        XXTDT             7 0
     C                   Z-ADD     PDAYS         RDAYS             5 0
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C     *IN78         IFEQ      *OFF
     C*
     C     1031001       IFGT      XXANDT
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     XXANDT        XXFDT
     C                   Z-ADD     ELPTDT        XXTDT
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     ELPFDT        XXFDT
     C                   Z-ADD     XXANDT        XXTDT
     C                   ENDIF                                                  1030401 IFGT
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXTDT
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C     *IN76         IFEQ      *ON
     C*
     C     1030401       IFGT      XXFDT
     C                   Z-ADD     1030401       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     1030401       XXFDT
     C                   ENDIF                                                  1030401 IFGT
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXTDT
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS
     C                   ENDIF                                                  *IN76 IFEQ
     C*
     C* FIND # DAYS IN FIRST PERIOD.
     C*
     C                   Z-ADD     XXFDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     1031001       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     1031001
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS1
     C     RDAYS         SUB       RDAYS1        RDAYS2
     C*
     C*  IF FL 10/1/3 RATE CHG IN EFFECT, MAKE SURE PAYROLLS ARE SPLIT
     C*
     C                   EXSR      SRFLR2
     C                   ENDIF                                                  *IN75 IFEQ
     C*
     C*   FL RATE SPLIT FOR 07/01/09
     C*
     C     XX0709        IFEQ      *ON
     C                   Z-ADD     1090701       SPLTDT            7 0          SPLIT DATE
     C                   EXSR      SR#DAY
     C                   EXSR      SRXSPL
     C                   ENDIF                                                  XX0709 = *ON
     C*
     C*   AZ RATE SPLIT FOR 01/01/2010
     C*
     C     XXAZ10        IFEQ      *ON
     C                   Z-ADD     1100101       SPLTDT            7 0          SPLIT DATE
     C                   EXSR      SR#DAY
     C                   EXSR      SRXSPL
     C                   ENDIF                                                  XXAZ10 = *ON
     C*
     C*   OK RATE SPLIT FOR 09/01/2010
     C*
     C                   if        xxOK10 = *on
     C                   Z-ADD     1100901       SPLTDT                         SPLIT DATE
     C                   EXSR      SR#DAY
     C                   EXSR      SRXSPL
     C                   endif                                                  XXOK10 = *ON
     C*
     C*   DE RATE SPLIT
     C*
     C     XXDEFL        IFEQ      *ON
     C*
     C*  GET NUMBER OF DAYS IN EACH RATING PERIOD FOR A 4/1/3 RATE CHG.
     C*
     C                   Z-ADD     0             RDAYS1            5 0
     C                   Z-ADD     0             RDAYS2            5 0
     C                   Z-ADD     ELPFDT        XXFDT             7 0
     C                   Z-ADD     ELPTDT        XXTDT             7 0
     C                   Z-ADD     PDAYS         RDAYS             5 0
     C*
     C     *IN78         IFEQ      *OFF
     C*
     C     1081001       IFGT      XXANDT
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     XXANDT        XXFDT
     C                   Z-ADD     ELPTDT        XXTDT
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     ELPFDT        XXFDT
     C                   Z-ADD     XXANDT        XXTDT
     C                   ENDIF                                                  1081001 IFGT
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXTDT
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C* FIND # DAYS IN FIRST PERIOD.
     C*
     C                   Z-ADD     XXFDT         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     1081001       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     1081001
     C     XXLPDT        ANDGE     XXFDT
     C                   SUB       1             QQDAYS
     C                   ENDIF                                                  XXLPDT IFNE
     C*
     C                   Z-ADD     QQDAYS        RDAYS1
     C     RDAYS         SUB       RDAYS1        RDAYS2
     C*
     C*  IF DE 10/01/08 RATE CHG IN EFFECT, MAKE SURE PAYROLLS ARE SPLIT
     C*
     C                   EXSR      SRDERT
     C                   ENDIF                                                  *IN76 IFEQ
     C*
     C*  GET ACTUAL NUMBER OF DAYS IN EACH RATING PERIOD
     C*
     C                   Z-ADD     *ZERO         DYS
     C*
     C                   Z-ADD     1             X
     C*
     C     RDAT(X)       DOWNE     0
     C     X             ADD       1             Z                 3 0
     C*
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     PDAT(Z)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        DYS(X)
     C*
     C*  LOAD PRORATA ARRAY
     C*
     C     PDAYS         IFNE      0
     C     DYS(X)        DIV(H)    PDAYS         PRO(X)
     C                   ENDIF
     C*
     C                   ADD       1             X
     C                   END
     C*
     C                   XFOOT     PRO           XXWK54            5 4
     C     1             SUB       XXWK54        XXWK54
     C                   ADD       XXWK54        PRO(1)
     C*
     C                   Z-ADD     0             PDAYS3            5 0
     C*
     C*  CALCULATE NUMBER OF DAYS 1993 RATES WERE USED.  THE NUMBER
     C*  OF DAYS WILL BE USED IF THE 15.7% 93 RATE CREDIT IS TO BE
     C*  APPLIED
     C*
     C                   MOVE      'N'           XX157             1
     C                   MOVE      *ZEROS        XQFROM
     C                   MOVE      *ZEROS        XQTO
     C     FNMST         IFEQ      'FL'
     C     ELPTDT        IFGT      940101
     C                   DO        6             X
     C     RDAT(X)       IFGE      930101
     C     RDAT(X)       ANDLE     931231
     C     PDAT(X)       IFLT      940101
     C                   MOVE      01011994      XQFROM
     C                   ELSE
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   END
     C     X             IFLE      5
     C                   ADD       1             X
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   END
     C                   MOVE      'Y'           XX157
     C                   END
     C                   END
     C                   END
     C                   ENDIF                                                  FNMST = FL
     C*
     C     XX157         IFEQ      'Y'
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     QQERR         IFEQ      '0'
     C*
     C*  SUBTRACT 1 FROM 1ST ANNIV PERIOD IF IT IS LEAP YEAR AND
     C*  FEBRUARY 29 FALLS WITHIN THE FIRST PERIOD.
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXANDT
     C                   SUB       1             QQDAYS
     C                   END
     C*
     C                   Z-ADD     QQDAYS        PDAYS3
     C                   END                                                    QQERR = ' '
     C                   END                                                    XX157 = 'Y'
     C*
     C*  READ EMPLOYER PAYROLL RECORDS
     C*
     C                   Z-ADD     0             XXFCLS           15 4
     C                   Z-ADD     0             XXPREM
     C                   Z-ADD     0             PAY
     C                   Z-ADD     0             PAY2
     C                   MOVE      *OFF          XXFCFL            1            F-CLASS FLAG
      *
      *  CALCULATE FL RT CHG AMOUNT FOR 07/01/09
      *
     C                   CLEAR                   XXFLRC                         FL RT CHG FLG
     C     XXST          IFEQ      'FL'
     C     CLTID         ANDNE     '139'
     C                   SELECT
     C     ELPFDT        WHENLT    1090701                                      LOOK AT SPLIT DATE
     C     XXANDT        ANDGE     1090401
     C     XXANDT        ANDLT     1090701
     C     ELPTDT        ANDGT     1090701
     C                   MOVE      'Y'           XXFLRC            1            APPLY TO ALL POLICY
     C     ELANDT        WHENGE    1090401                                      LOOK AT ANDT
     C     ELANDT        ANDLT     1090701
     C     ELPFDT        ANDLT     1090701
     C     ELPTDT        ANDGT     1090701
     C                   MOVE      'Y'           XXFLRC                         APPLY TO 1ST PERIOD
     C     ELPFDT        WHENGE    1090401                                      LOOK AT PFDT
     C     ELPFDT        ANDLT     1090701
     C     ELPTDT        ANDGT     1090701
     C     ELANDT        ANDEQ     *ZERO
     C                   MOVE      'Y'           XXFLRC                         APPLY TO ALL POLICY
     C                   ENDSL
     C     XXFLRC        IFEQ      'Y'
     C                   Z-ADD     7012009       QQFROM
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C                   EXSR      SRLEAP
     C                   Z-ADD     QQDAYS        UDAYS             5 0          #OF DAYS TO PRORATE
     C     UDAYS         DIV(H)    365           X2FACT            7 6          PRORATE FACTOR
     C     X2FACT        MULT(H)   .06           X3FACT            5 4
     C     1             SUB       X3FACT        X3FACT                         NON F-CLASS ADJ
     C     X2FACT        MULT(H)   .02           X4FACT            5 4
     C     1             SUB       X4FACT        X4FACT                         F-CLASS ADJ
     C                   ENDIF                                                  XXFLRC
     C                   ENDIF                                                  XXST = 'FL
     c                   move      *blank        xxnetf            1
     C*
     c                   if        cltid = '025'
     C*
     C*  CALCULATE THE NET RATE AND NET PREMIUM FOR EACH PAYROLL
     C*  CLASS, AND THEN OVERRIDE NORMAL PREMIUM WITH THE TOTAL.
     C*
     C     F1NETR        IFEQ      'Y'
     C     ELPFDT        ANDGE     F1NETD
     C     *IN94         ANDEQ     *OFF
     C     *IN95         ANDEQ     *OFF
     C     *IN96         ANDEQ     *OFF
     C     *IN97         ANDEQ     *OFF
     C     *IN98         ANDEQ     *OFF
     C*
     c                   move      'Y'           xxnetf
     C                   Z-ADD     0             XXTMAN           11 2
     C                   Z-ADD     0             XXENMP           11 2
     C                   Z-ADD     0             XXTNET           11 2
     C*
     C* TOTAL THE MANUAL AND NORMAL PREMIUM FOR THE STATE.
     C*
     C*** begin add ***  09/05/25  ****************************************
        Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'R':xxst) pev00;
        If %found;
           xxTMan = EVxxTMan;
           xxENmp = EVxxENmp;
        Else;
     C*** end add *****  09/05/25  ****************************************
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     MPST          IFEQ      XXST
     C                   ADD       MPMAPR        XXTMAN
     C                   ADD       MPENMP        XXENMP
     C                   ENDIF
     C*
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*** begin add ***  09/05/25  ****************************************

           Clear pev00;
           EVCo# = xxCo#;
           EVFnd = xxFnd;
           EVFyr = xxFyr;
           EVEmp# = xxEmp#;
           EVType = 'R';
           EVxxTMan = xxTMan;
           EVxxENmp = xxENmp;
           EVSt  = xxSt;
           Write pev00;
        Endif;
     C*** end add *****  09/05/25  ****************************************
     C*
     C* CALCULATE THE NET RATE FACTOR.
     C*
     C     XXTMAN        IFNE      *ZERO
     C     XXENMP        DIV(H)    XXTMAN        XXNETR            9 6
     C                   ELSE
     C                   Z-ADD     1             XXNETR
     C                   ENDIF                                                  XXTMAN IFNE
     c
     c                   endif                                                  if f1netr = 'Y'
     c
     c                   endif                                                  if cltid = '025'
      /free
       // Get the Territorial Differential Factor
       GetTDF(ELco#:ELfnd:ELemp#:ELdiv:ELfYr:outTDF);
      /end-free
     C                   SETOFF                                       50
     C     EPKEY         SETGT     PEP01
     C     *IN50         DOUEQ     '1'
     C                   READP     PEP01                                  50
     C  N50EPCO#         COMP      XXCO#                              5050
     C  N50EPFND         COMP      XXFND                              5050
     C  N50EPFYR         COMP      XXFYR                              5050
     C  N50EPEMP#        COMP      XXEMP#                             5050
     C  N50EPDIV         COMP      XXDIV                              5050
     C*
     C*  END DATE IS EITHER END OF POLICY OR EFF.DATE FROM LAST RCD
     C*
     C     *IN50         IFEQ      '0'
     C     EPSTAT        ANDNE     'I'
     C*
     C                   Z-ADD     EPCLAS        XXCLAS
     C     EPEFDT        IFGT      SVEFDT
     C                   Z-ADD     EPEFDT        XHEFDT
     C                   END
     C*
     C*  GET CORRECT DATE FROM RDAT ARRAY TO PULL RATE FROM RATE FILE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   Z-ADD     RDAT(X)       XXEFDT
     C                   ELSE
     C                   Z-ADD     1             X
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   END
     C*
     C*  USE LATEST RATE FOR INFORCE CALC
     C*
     C     *IN98         IFEQ      *ON
     C                   Z-ADD     6             T
     C     RDAT(T)       DOULT     ELPTDT
     C     RDAT(T)       ANDNE     *ZERO
     C                   SUB       1             T
     C                   ENDDO
     C                   Z-ADD     RDAT(T)       XXEFDT
     C                   ENDIF
     C*
     C*  USE THE PAYROLL RATE SET CODE IN EMPLOYER DETAIL TO RETRIEVE
     C*  THE CORRECT PAYROLL CLASS CODE
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C*
     C*  GET PAYROLL CLASS FILE
     C*
     C     PRKEY         SETGT     PPR01
     C                   READP     PPR01                                  60
     C     *IN60         IFEQ      '0'
     C     PRCO#         COMP      XXCO#                              6060
     C  N60PRCLAS        COMP      XXCLAS                             6060
     C  N60PRRTCD        COMP      XXRTCD                             6060
     C                   END
     C                   Z-ADD     0             EPENTR
     C                   Z-ADD     0             EPENTP
     C     *IN60         IFEQ      *ON
     C                   Z-ADD     0             EPARAT
     C                   Z-ADD     0             EPEMPR
     C                   UPDATE    PEP01
     C                   ENDIF
     C     *IN60         CABEQ     '1'           NEXT1
     C*
     C*  IF POLICY IS SHORT-TERM AND PRORATA FACTOR IS 1.00, PRORATE
     C*  THE PAYROLL
     C*
     C                   Z-ADD     X2PFDT        XATODT
     C                   ADD       1             XXTOYR
     C*
     C     X2PTDT        IFNE      XATODT
     C     EPEMPR        ANDEQ     0
     C     X2FFL9        ANDEQ     'Y'
     C     PRPCF         ANDNE     'O'
     C*
     C     PDAYS         IFNE      *ZERO
     C     PDAYS         DIV       365           XXFCTR            9 6
     C                   ELSE
     C                   Z-ADD     1             XXFCTR
     C                   ENDIF
     C*
     C     EPEAPR        MULT(H)   XXFCTR        XAWK90            9 0
     C                   Z-ADD     XAWK90        EPEAPR
     C*
     C                   ENDIF
     C*
     C*  AIRCRAFT SURCHARGE - SHOULD BE ADDED TO ADDITIONAL LOAD TO
     C*  THEN BE APPLIED TO STANDARD RATHER THAN MANUAL.
     C*
     C     EPCLAS        IFEQ      RRDCCD
     C     PROCCD        ANDEQ     *BLANK

     C     EPEAPR        MULT      PRRT          CHARGE           15 4
     C                   Z-ADD     CHARGE        CHARGD           15 4
     C     PRRT          MULT(H)   RDEV(X)       EPARAT
     C     CHARGE        MULT(H)   RDEV(X)       CHARGE
     c*** begin add ***  06/25/25  *****************************************
     C                   If        RS3Date = 0 or RDAT(1) < RS3Date
     C     PRRT          MULT(H)   RDEV(X)       x2arat
     C                   Z-add     x2arat        EParat
     C     EPEAPR        MULT      PRRT          CHARGE           15 4
     C                   Z-ADD     CHARGE        CHARGD           15 4
     C     CHARGE        MULT(H)   RDEV(X)       CHARGE
     C                   Endif
     c*** end add *****  06/25/25  *****************************************
     C     CHARGE        IFGT      RRAMAX
     C                   Z-ADD     RRAMAX        EPADLD
     C                   ELSE
     C                   Z-ADD     CHARGE        EPADLD
     C                   ENDIF                                                  CHARGE GT
     C     CHARGD        IFGT      RRAMAX
     C                   Z-ADD     RRAMAX        CHARGD
     C                   ENDIF
     C*
     C* PRORATE THE CHARGE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   ENDIF
     C*
     C     PDAYS         IFNE      *ZEROS
     C     DYS(X)        DIV(H)    PDAYS         XXDPRO
     C                   ELSE
     C                   Z-ADD     0             XXDPRO
     C                   ENDIF                                                  DYS,X IFNE
     C*
     C     XXDPRO        MULT(H)   EPADLD        XXWK10           11 0
     C                   Z-ADD     XXWK10        EPADLD
     C*
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   UPDATE    PEP01
     C                   ADD       EPADLD        XXADLD
     C                   ADD       EPADLD        ADL(X)
     C                   ADD       EPADLD        PAY2(X)
     C     XXDPRO        MULT(H)   CHARGD        XXWK10           11 0
     C                   Z-ADD     XXWK10        CHARGD
     C                   ADD       CHARGD        ADLD(X)
     C                   GOTO      NEXT1
     C                   ENDIF                                                  EPCLAS EQ
     C*
     C* IF THIS IS A POPULATION RATED CLASS, PULL PREMIUM AMOUNT FROM
     C* TABLE, UPDATE, AND THEN SKIP TO NEXT.
     C*
     C     PRPCF         IFEQ      'O'
     C*
     C     POKY          SETGT     PPO01
     C     POKY1         READPE    PPO01                                  60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     POAMT         EPEMPR
     C                   ELSE
     C                   Z-ADD     0             EPEMPR
     C                   ENDIF
     C*
     C* PRORATE THE CHARGE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   ENDIF
     C*
     C     PDAYS         IFNE      *ZEROS
     C     DYS(X)        DIV(H)    PDAYS         XXDPRO
     C                   ELSE
     C                   Z-ADD     0             XXDPRO
     C                   ENDIF                                                  DYS,X IFNE
     C*
     C     XXDPRO        MULT(H)   EPEMPR        XXWK10           11 0
     C                   Z-ADD     XXWK10        EPEMPR
     C     X2PTDT        IFNE      XATODT
     C     X2FFL9        ANDEQ     'Y'
     C*
     C     PDAYS         IFNE      *ZERO
     C     PDAYS         DIV       365           XXFCTR            9 6
     C                   ELSE
     C                   Z-ADD     1             XXFCTR
     C                   ENDIF
     C*
     C     EPEMPR        MULT(H)   XXFCTR        XAWK90            9 0
     C                   Z-ADD     XAWK90        EPEMPR
     C*
     C                   ENDIF
     C*
      *
      *  STORE BASE PREM IN MAND FOR MA DIA BREAKOUT LATER. APPLY DEVIATION
      *  TO MAN PREM FOR POPULATION RATED CLASS.
      *
     C                   ADD       EPEMPR        MAND(X)
     C     EPEMPR        MULT      RDEV(X)       XXWK10
     C                   Z-ADD     XXWK10        EPEMPR
     c                   if        xxnetf = 'Y'
     c
     C     XXNETR        MULT(H)   EPEMPR        XXWK10
     C                   Z-ADD     XXWK10        EPENTP
     c
     c                   endif                                                  if xxnetf = 'Y'
     C*
     C                   UPDATE    PEP01
     C                   ADD       EPEMPR        MAN(X)
     C                   ADD       EPEMPR        PAY2(X)
     C                   MOVE(P)   ELCO#         QQCO#
     C                   MOVE(P)   ELFND         QQFND
     C                   MOVE(P)   PRRTCD        QQRTCD
     C                   MOVE(P)   PRCLAS        QQCLAS
     C                   MOVE(P)   XXEFDT        QQEFDT
     C                   CALL      'SRLCM'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    QQRTCD            3
     C                   PARM                    QQCLAS            5
     C                   PARM                    QQEFDT            7
     C                   PARM      *BLANKS       QQLCM             5
      *
     C     QQLCM         IFNE      *BLANKS
     C                   MOVE      QQLCM         XXLCM             5 4
     C                   ENDIF
      *
      /free
       // Calculate non-payroll terrorism charge
       If RRterl <> 'Y';
          Eval(h) xxTert = npTRt(x) * xxLcm;
       Else;
          xxTert = npTRt(x);
       Endif;
       Eval(h) xxDtra = EPempr * xxTert;
       //Apply Excess premium reduction % (Deviation #1) against Terrorism charges
       If FNExIns = 'Y' and ELASP2 > 0;
          Eval(h) xxDtra = xxDtra - (xxDtra * ELASP2/100);
       Endif;
       nTr(x) = nTr(x) + xxDtra;
      /end-free
     C*
     C                   GOTO      NEXT1
     C                   ENDIF                                                  PRPCF IFEQ
     C*
     C*  OCCUPATION DISEASE - SHOULD BE ADDED BEFORE STANDARD PREMIUM
     C*  IN A SECONDARY ADDITIONAL LOAD ARRAY.
     C*
     C     PROCCD        IFEQ      'Y'
     C     EPEAPR        MULT      PRRT          CHARGE           15 4
     C                   DIV       100           CHARGE
     C                   Z-ADD     CHARGE        EPADLD
     C*
     C* PRORATE THE CHARGE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   ENDIF
     C*
     C     PDAYS         IFNE      *ZEROS
     C     DYS(X)        DIV(H)    PDAYS         XXDPRO
     C                   ELSE
     C                   Z-ADD     0             XXDPRO
     C                   ENDIF                                                  DYS,X IFNE
     C*
     C     XXDPRO        MULT(H)   EPADLD        XXWK10           11 0
     C                   Z-ADD     XXWK10        EPADLD
     C*
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   UPDATE    PEP01
     C                   ADD       EPADLD        XXADLD
     C                   ADD       EPADLD        ADL2(X)
     C                   GOTO      NEXT1
     C                   ENDIF                                                  EPCLAS EQ
      **** Beg Add * 10/20/15
     C*
     C*  Non-Ratable class code - SHOULD BE ADDED BEFORE STANDARD PREMIUM
     C*  IN A SECONDARY ADDITIONAL LOAD ARRAY.
     C*
     C     PRnrat        IFEQ      'Y'
     C     EPEAPR        MULT      PRRT          CHARGE
     C                   DIV       100           CHARGE
     C                   Z-ADD     CHARGE        EPADLD
     C*
     C* PRORATE THE CHARGE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   ENDIF
     C*
     C     PDAYS         IFNE      *ZEROS
     C     DYS(X)        DIV(H)    PDAYS         XXDPRO
     C                   ELSE
     C                   Z-ADD     0             XXDPRO
     C                   ENDIF
     C*
     C     XXDPRO        MULT(H)   EPADLD        XXWK10
     C                   Z-ADD     XXWK10        EPADLD
     C*
     C                   Z-ADD     0             EPEMPR
     C                   Z-ADD     0             EPAMPR
     C                   UPDATE    PEP01
     C                   ADD       EPADLD        XXADLD
     C                   ADD       EPADLD        ADL3(X)
     C                   GOTO      NEXT1
     C                   ENDIF
      **** End Add * 10/20/15
     C*
     C*  IF THIS IS AN "A" RATING EMPLOYER, USE EPARAT OTHERWISE
     C*  RETRIEVE RATE FROM WMPRP AND ADJUST IF NECESSARY
     C*
     C     ELSTAT        IFEQ      'Y'
     C     PRARFL        ANDEQ     'Y'
     C                   Z-ADD     EPARAT        XXARAT
     C                   ELSE
     C*
     C*  ADJUST RATE IF NECESSARY
     C*
     C                   MOVE(P)   ELCO#         QQCO#
     C                   MOVE(P)   ELFND         QQFND
     C                   MOVE(P)   PRRTCD        QQRTCD
     C                   MOVE(P)   PRCLAS        QQCLAS
     C                   MOVE(P)   XXEFDT        QQEFDT
     C                   CALL      'SRLCM'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    QQRTCD            3
     C                   PARM                    QQCLAS            5
     C                   PARM                    QQEFDT            7
     C                   PARM      *BLANKS       QQLCM             5
      *
     C     QQLCM         IFNE      *BLANKS
     C                   MOVE      QQLCM         XXLCM             5 4
     C                   ENDIF
      *
     c*** begin add ***  08/14/25  *****************************************
     C* Round/calculate payroll rate to 2 digits if not approved yet for 3.
     C                   If        RS3Date = 0 or RDAT(1) < RS3Date
     C                   If        outTDF = 0
     C                   Eval(h)   x2arat = xxlcm * prrt
     C                   Else
     C                   Eval(h)   x2arat = outTDF * xxlcm * prrt
     C                   Endif
     C                   Z-add     x2arat        PRRT
     C                   Else
     c*** end add *****  08/14/25  *****************************************
     C                   If        outTDF = 0
     C                   Eval(h)   prrt = xxlcm * prrt
     C                   Else
     C                   Eval(h)   prrt = outTDF * xxlcm * prrt
     C                   Endif
     c*** begin add ***  06/25/25  *****************************************
     c*** begin del ***  08/14/25  *****************************************
     C******             If        RS3Date = 0 or RDAT(1) < RS3Date
     C******             Z-add(h)  PRRT          x2arat
     C******             Z-add     x2arat        PRRT
     c*** end del *****  08/14/25  *****************************************
     C                   Endif
     c*** end add *****  06/25/25  *****************************************
     C                   Z-ADD     PRRT          XXARAT
      *
      *  STORE ORIGINAL RATE IN X1ARAT FOR MA DIA ASSESSMENT CALC
      *
      **** Beg chg ***** 06/17/24 ******************************************
     C****************** Z-ADD     XXARAT        X1ARAT            5 2
     C                   Z-ADD     XXARAT        X1ARAT            8 3
      **** End chg ***** 06/17/24 ******************************************
     c*** begin add ***  08/14/25  *****************************************
     C* Round/calculate payroll rate to 2 digits if not approved yet for 3.
     C                   If        RS3Date = 0 or RDAT(1) < RS3Date
     C     XXARAT        MULT(H)   RDEV(X)       x2arat
     C                   Z-add     x2arat        xxarat
     C                   Else
     c*** end add *****  08/14/25  *****************************************
     C     XXARAT        MULT(H)   RDEV(X)       XXARAT
     c*** begin add ***  06/25/25  *****************************************
     c*** begin del ***  08/14/25  *****************************************
     C******             If        RS3Date = 0 or RDAT(1) < RS3Date
     C******             Z-add(h)  xxarat        x2arat
     C******             Z-add     x2arat        xxarat
     c*** end del *****  08/14/25  *****************************************
     C                   Endif
     c*** end add *****  06/25/25  *****************************************
     C*
     C     EPSPEC        IFEQ      'F'
     C     PRLHCD        IFEQ      'N'
     C                   MOVE      ELRTCD        XXRTCD
     C                   Z-ADD     ELPFDT        XXEFDT
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C     HEKY          SETGT     PHE01
     C     HEKY2         READPE    PHE01                                  60
     C     *IN60         IFEQ      *OFF
     c*** begin add ***  08/14/25  *****************************************
     C* Round/calculate payroll rate to 2 digits if not approved yet for 3.
     C                   If        RS3Date = 0 or RDAT(1) < RS3Date
     C     XXARAT        MULT      HELHNF        x2arat
     C                   Z-add     x2arat        xxarat
     C     X1ARAT        MULT      HELHNF        x2arat
     C                   Z-add     x2arat        x1arat
     C                   Else
     c*** end add *****  08/14/25  *****************************************
     C     XXARAT        MULT      HELHNF        XXARAT
     C     X1ARAT        MULT      HELHNF        X1ARAT
     c*** begin add ***  06/25/25  *****************************************
     c*** begin del ***  08/14/25  *****************************************
     C******             If        RS3Date = 0 or RDAT(1) < RS3Date
     C******             Z-add(h)  xxarat        x2arat
     C******             Z-add     x2arat        xxarat
     C******             Z-add(h)  x1arat        x2arat
     C******             Z-add     x2arat        x1arat
     c*** end del *****  08/14/25  *****************************************
     C                   Endif
     c*** end add *****  06/25/25  *****************************************
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  PRLHCD IFEQ
     C                   ENDIF                                                  EPSPEC IFEQ
     C                   ENDIF                                                  ELSTAT IFEQ
      *
      * APPLY FL RATE DECREASE
      *
     C     XXFLRC        IFEQ      'Y'
     c*** begin add ***  08/14/25  *****************************************
     C* Round/calculate payroll rate to 2 digits if not approved yet for 3.
     C                   If        RS3Date = 0 or RDAT(1) < RS3Date
     C     EPSPEC        IFEQ      'F'
     C     XXARAT        MULT(H)   X4FACT        x2arat
     C                   ELSE
     C     XXARAT        MULT(H)   X3FACT        x2arat
     C                   ENDIF
     C                   Z-add     x2arat        xxarat
     C                   Else
     c*** end add *****  08/14/25  *****************************************
     C     EPSPEC        IFEQ      'F'
     C     XXARAT        MULT(H)   X4FACT        XXARAT
     C                   ELSE
     C     XXARAT        MULT(H)   X3FACT        XXARAT
     C                   ENDIF
     c*** begin add ***  06/25/25  *****************************************
     c*** begin del ***  08/14/25  *****************************************
     C******             If        RS3Date = 0 or RDAT(1) < RS3Date
     C******             Z-add(h)  xxarat        x2arat
     C******             Z-add     x2arat        xxarat
     c*** end del *****  08/14/25  *****************************************
     C                   Endif
     c*** end add *****  06/25/25  *****************************************
     C                   ENDIF
     c                   if        xxnetf = 'Y'
     C     XXNETR        MULT(H)   XXARAT        EPENTR
     c                   endif
     C*
     C*  CALCULATE MANUAL PREMIUM
     C*
     C     PRPCF         IFEQ      'P'
     C     EPEAPR        DIV(H)    100           XXWK92           15 4
     C                   ELSE
     C                   Z-ADD     EPEAPR        XXWK92           15 4
     C                   END
      *
      *
      * Ambulance payclass in NY - full charge for first person, 1/2 charge for
      * additional people
      *
     C     XXST          IFEQ      'NY'
     C     EPCLAS        ANDEQ     7370
     C                   Z-ADD     EPEAPR        XXWK92
     C                   SUB       1             XXWK92
     C     XXWK92        MULT      XXARAT        XXAMBC           15 4
     C                   DIV(H)    2             XXAMBC
     C     XXAMBC        ADD       XXARAT        XXMAN
     c                   if        xxnetf = 'Y'
     C                   Z-ADD     EPEAPR        XXWK92
     C                   SUB       1             XXWK92
     C     XXWK92        MULT      EPENTR        XXAMBC           15 4
     C                   DIV(H)    2             XXAMBC
     C     XXAMBC        ADD       EPENTR        XXTEMP           15 4
     c                   z-add(h)  XXTEMP        XXWK10
     C                   Z-ADD     XXWK10        EPENTP
     c                   endif
     C                   ELSE
     C     XXWK92        MULT(H)   XXARAT        XXMAN            15 4
     C     XXWK92        MULT(H)   X1ARAT        XXMAND           15 4
     c                   if        xxnetf = 'Y'
     C     XXWK92        MULT(H)   EPENTR        XXWK10
     C                   Z-ADD     XXWK10        EPENTP
     c                   endif
     C                   ENDIF
     C                   MOVE      *BLANKS       XPST
     C     PXKY          CHAIN     PPX01                              60
     C     *IN60         IFEQ      *ON
     C                   MOVE      XXST          XPST
     C     PXKY          CHAIN     PPX01                              60
     C     *IN60         IFEQ      *ON
     C                   Z-ADD     0             PXCODE
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
     C     PXCODE        IFEQ      *ZERO
     C                   ADD       EPADLD        XXADLD
     C                   ENDIF                                                  PXCODE IFEQ
     C*
     C*  ROUND TO NEAREST DOLLAR, UPDATE EMPLOYER PAYROLL FILE
     C*
     C*
     C*  SAVE HIGHEST FOR MINIMUM PREMIUM CHECK
     C*
     C     PRMNPR        IFGT      XXHIGH
     C                   Z-ADD     PRMNPR        XXHIGH           15 4
     C                   MOVE      PRCLAS        SVCLAS            5 0
     C                   END
     C*
     C*  APPLY 15.7% CREDIT TO PORTION OF MANUAL USING 1993 RATES;
     C*  GET CORRECT DATE FROM RDAT ARRAY TO DETERMINE RATING DATE USED
     C*  TO PULL RATE FROM FILE
     C*
     C                   Z-ADD     *ZEROS        XXDISC
     C*
     C*  15.7% DISCOUNT IS APPLIED TO PORTION OF 94 POLICY USING
     C*  93 RATES
     C*
     C     XX157         IFEQ      'Y'
     C                   Z-ADD     1             Z                 3 0
     C     EPEFDT        LOOKUP    PDAT(Z)                            60
     C     *IN60         IFEQ      '1'
     C     Z             ANDGT     1
     C                   SUB       1             Z
     C                   Z-ADD     RDAT(Z)       X2EFDT
     C                   ELSE
     C                   Z-ADD     1             Z
     C                   Z-ADD     ELPFDT        X2EFDT
     C                   END
     C     X2EFDT        IFGE      930101
     C     X2EFDT        ANDLE     931231
     C*
     C*  APPLY 15.7 % CREDIT TO UNEXPIRED PORTION OF POLICY
     C*
     C     PDAYS         IFNE      *ZEROS
     C     PDAYS3        DIV(H)    PDAYS         X2WK54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        X2WK54
     C                   END
     C*
     C*  HARBOR EXPOSURE CLASSES WILL ONLY RECEIVE UP TO 3.2 %
     C*  CREDIT ON UNEXPIRED PORTION OF POLICY
     C*
     C     EPSPEC        IFEQ      'F'
     C*
     C*  FIND THE AVERAGE # OF MONTHS 93 RATES WERE APPLIED TO
     C*  DETERMINE WHAT PERCENTAGE WILL BE APPLIED
     C*
     C     PDAYS3        DIV(H)    30            XXMTHS            3 1
     C                   Z-ADD     1             T                 3 0
     C     XXMTHS        LOOKUP    MTH(T)                             60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     HP(T)         XXWO54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXWO54
     C                   END                                                    *IN60
     C                   ELSE
     C     X2WK54        MULT(H)   0.157         XXWO54
     C                   END                                                    HARBOR EXP
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXMAN         XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXMAN
     C*
     C*  IF THIS IS ANNIVERSARY RATED MANUAL PREMIUM, THEN WE
     C*  NEED TO APPLY FULL 15.7% CREDIT ON NON-HARBOR EXPOSURE,
     C*  FULL 3.2% CREDIT ON HARBOR EXPOSURE CLASS CODES
     C*
     C     *IN78         IFEQ      '0'
     C     EPSPEC        IFEQ      'F'
     C     XXMAN         MULT(H)   0.032         XXDISC
     C                   ELSE
     C     XXMAN         MULT(H)   0.157         XXDISC
     C                   END
     C*
     C*  CHECK TO SEE IF ANY OF THE ANNIVERSARY RATED MANUAL PREMIUM
     C*  WAS BEFORE 1/1/94.  IF SO, WE ONLY APPLY THE PORTION OF THE
     C*  15.7% CREDIT THAT CORRESPONDS TO THE AMOUNT OF ANNIVERSARY
     C*  RATED MANUAL PREMIUM AFTER 1/1/94
     C*
     C*
     C     EPEFDT        IFLT      940101
     C*
     C*  FIND THE NUMBER OF DAYS FROM 1/1/94 TO THE END OF THE
     C*  CURRENT PAYROLL CLASS CODE EFFECTIVE PERIOD
     C*
     C                   MOVE      01011994      QQFROM            8 0
     C     EPEFDT        IFEQ      XXANDT
     C*
     C*  93 RATES ARE BEING APPLIED TO THE SECOND SET OF EFFECTIVE
     C*  PAYROLLS
     C*
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTODT            8 0
     C                   ELSE
     C*
     C*  93 RATES ARE BEING APPLIED TO THE FIRST SET OF EFFECTIVE
     C*  PAYROLLS
     C*
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTODT
     C                   END
     C*
     C                   MOVE      XXTODT        QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     QQERR         IFEQ      '0'
     C                   MOVE      QQDAYS        XXDYS1            5 0
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXDYS1
     C                   END
     C*
     C*  RETRIEVE THE NUMBER OF DAYS IN THE CURRENT PAYROLL CLASS
     C*  CODE EFFECTIVE PERIOD
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   END
     C*
     C     X             IFGE      1
     C                   Z-ADD     DYS(X)        XXDYS2            5 0
     C                   END
     C*
     C*  ONLY APPLY PORTION OF 15.7% THAT CORRESPONDS TO AMOUNT
     C*  OF ANNIVERSARY RATED PAYROLL IN THE 1994 YEAR
     C*
     C     XXDYS2        IFNE      *ZEROS
     C     XXDYS1        DIV(H)    XXDYS2        XXWR54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXWR54
     C                   END
     C     EPSPEC        IFEQ      'F'
     C     XXWR54        MULT(H)   0.032         XXWO54
     C                   ELSE
     C     XXWR54        MULT(H)   0.157         XXWO54
     C                   END
     C     XXMAN         MULT(H)   XXWO54        XXDISC           15 4
     C*
     C                   END                                                    EPEFDT<1/1/94
     C*
     C                   ELSE
     C     XXMAN         MULT(H)   XXWO54        XXDISC           15 4
     C                   END                                                    *IN78 = 0
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXDISC        XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXDISC
     C                   END                                                    X2EFDT>=01/01/93
     C*                                                    X2EFDT<=12/31/93
     C                   END                                                    XX157 = 'Y'
     C*
     C*  ROUND TO NEAREST DOLLAR, UPDATE EMPLOYER PAYROLL FILE
     C*
     C                   Z-ADD(H)  XXMAN         XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXMAN
     C*
     C                   SUB       XXDISC        XXMAN
     C                   Z-ADD(H)  XXMAN         XXWK10
     C                   Z-ADD     XXWK10        XXMAN
     C                   Z-ADD(H)  XXMAND        XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXMAND
     C                   SUB       XXDISC        XXMAND
     C                   Z-ADD(H)  XXMAND        XXWK10
     C                   Z-ADD     XXWK10        XXMAND
     C                   Z-ADD     1             XXLCM
     C                   MOVE(P)   ELCO#         QQCO#
     C                   MOVE(P)   ELFND         QQFND
     C                   MOVE(P)   PRRTCD        QQRTCD
     C                   MOVE(P)   PRCLAS        QQCLAS
     C                   MOVE(P)   XXEFDT        QQEFDT
     C                   CALL      'SRLCM'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    QQRTCD            3
     C                   PARM                    QQCLAS            5
     C                   PARM                    QQEFDT            7
     C                   PARM      *BLANKS       QQLCM             5
      *
     C     QQLCM         IFNE      *BLANKS
     C                   MOVE      QQLCM         XXLCM             5 4
     C                   ENDIF
      /free
       // Calc Foreign Terrorism
       xxEapr = EPeapr;
       // Adjust for FMIC's logging conversion
       If cltID = '102' and PRlogf = 'Y';
          qqFound = *off;
          qqMPayr = *zeros;
          qqMRate = *zeros;
          qqRptCls = *zeros;
          Callp GetLogFact(PRclas:qqFound:qqMPayr:QQMRate:qqRptCls);
          If qqFound = *on;
             xxEapr = xxEapr * qqMPayr;
          Endif;
       Endif;
       Select;
       When RRterl = 'Y';
       When %lookup(xxLCM:LCM) = 0;
          xy = %lookup(0:LCM);
          If xy <> 0;
            LCM(xy) = xxLCM;
          Endif;
       Endsl;
       Select;
       When PRExTer = 'Y';
       // Do nothing for payroll class.
       When Prpcf = 'P' or
        (cltID = '102' and PRlogf = 'Y' and PRpcf = 'C');
       // Calc Foreign Terrorism
          pay(x) = pay(x) + xxEapr;
          If RRterl <> 'Y';
             Eval(h) xxTert = pyTRt(x) * xxLcm;
          Else;
             xxTert = pyTRt(x);
          Endif;
          Eval(h) xxwk10 = xxEapr/100;
          Eval(h) xxDtra = xxwk10 * xxTert;
          //Apply Excess premium reduction % (Deviation #1) against Terrirism chrages
          If FNExIns = 'Y' and ELASP2 > 0;
             Eval(h) xxDtra = xxDtra - (xxDtra * ELASP2/100);
          Endif;
          eTr(x) = eTr(x) + xxDtra;
       // Calc Domestic Terrorism
          If RRterl <> 'Y';
             Eval(h) xxTert = dmTRt(x) * xxLcm;
          Else;
             xxTert = dmTRt(x);
          Endif;
          Eval(h) xxwk10 = xxEapr/100;
          Eval(h) xxDtra = xxwk10 * xxTert;
          //Apply Excess premium reduction % (Deviation #1) against Terrorism charges
          If FNExIns = 'Y' and ELASP2 > 0;
             Eval(h) xxDtra = xxDtra - (xxDtra * ELASP2/100);
          Endif;
          dTr(x) = dTr(x) + xxDtra;
       // Calc Non Payroll Terrorism
       When PRpcf <> 'P' and PRoccd = *blank;
          pay2(x) = pay2(x) + xxMan;
          If RRterl <> 'Y';
             Eval(h) xxTert = npTRt(x) * xxLcm;
          Else;
             xxTert = npTRt(x);
          Endif;
          Eval(h) xxDtra = xxMan * xxTert;
          //Apply Excess premium reduction % (Deviation #1) against Terrorism charges
          If FNExIns = 'Y' and ELASP2 > 0;
             Eval(h) xxDtra = xxDtra - (xxDtra * ELASP2/100);
          Endif;
          nTr(x) = nTr(x) + xxDtra;
       Endsl;
      /end-free
     C*
     C*  ACCUMULATE MANUAL PREMIUM IN CORRECT ARRAY ENTRY
     C*
     C                   ADD       XXMAN         MAN(X)
     C                   ADD       XXMAND        MAND(X)
     C*
     C*  ACCUMULATE ADDITIONAL LOAD IN THE CORRECT ARRAY ENTRY
     C*
     C     PXCODE        IFEQ      *ZERO
     C                   ADD       EPADLD        ADL(X)
     C                   ELSE
     C                   ADD       EPADLD        MAN(X)
     C                   ADD       CHARGD        MAND(X)
     C                   ENDIF                                                  PXCODE IFEQ
     C*
     C     EPSPEC        IFEQ      'F'
     C     PRLHCD        OREQ      'Y'
     C                   ADD       XXMAN         XXFCLS           15 4
     C                   MOVE      *ON           XXFCFL
     C                   ADD       XXMAN         FCL(X)
     C                   ENDIF                                                  EPSPEC IFEQ
     C                   ADD       XXMAN         XXPREM
     C*
     C*  ONLY UPDATE EPARAT IF THIS IS NOT AN "A" RATING EMPLOYER
     C*
     C     ELSTAT        IFEQ      'N'
     C     PRARFL        OREQ      *BLANK
     C                   Z-ADD     XXARAT        EPARAT
     C                   END
     C                   Z-ADD     XXMAN         EPEMPR
     C*
     C                   UPDATE    PEP01
     C*
     C     NEXT1         TAG
     C                   Z-ADD     EPEFDT        SVEFDT            7 0
     C*
     C                   END
     C                   END
     C*
      /free
       If %lookup(0:LCM) = 0;
          hasDiffLCMs = *on;
       Else;
          hasDiffLCMs = *off;
       Endif;
      /end-free
     C*
     C* CALCULATE THE PERCENTAGE OF PAYROLL THAT IS F-CLASS
     C*
     C     XXPREM        IFNE      *ZERO
     C     XXFCLS        DIV       XXPREM        XXFPCT            9 6
     C                   ELSE
     C                   Z-ADD     0             XXFPCT
     C                   ENDIF                                                  XXPREM IFNE
     C*
     C* FIND THE HIGHEST MINIMUM PREMIUM OVER ALL THE DIVISIONS.
     C*
     C                   Z-ADD     XXDIV         X2DIV
     C                   Z-ADD     0             XXHIGH
     C                   Z-ADD     0             XXMINC            5 0
     C                   MOVE      *BLANKS       XXSTE             2
     C                   Z-ADD     0             XADIV             5 0
     C                   Z-ADD     0             XLMIN1           11 2
     C                   Z-ADD     0             XLMIN2           11 2
     C                   Z-ADD     0             XLDIV1            5 0
     C                   Z-ADD     0             XLDIV2            5 0
     C                   Z-ADD     0             XXLOSS           11 2
     C                   Z-ADD     0             XXDIV1            5 0
     C                   MOVE      XXST          XSST              2
     C                   Z-ADD     0             XXMIN1
     C                   Z-ADD     0             XXMIN2
     C                   Z-ADD     0             XXWVMN           11 2
     C                   Z-ADD     0             XTFCLS           11 2
     C                   Z-ADD     0             XFMINA           11 2
     C                   Z-ADD     0             XFDIV             5 0
      /Free
        //* Minimum cannot be determined on manual premium run.
        If *in96 = *off;
           Chain ELky6 pel02;
           Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'M') pev00;
           If %found;
              xlmin1 = EVxlmin1;
              xldiv1 = EVxldiv1;
              xlmin2 = EVxlmin2;
              xldiv2 = EVxldiv2;
              xxhigh = EVxxhigh;
              xadiv  = EVxadiv;
              xxloss = EVxxloss;
              xxdiv1 = EVxxdiv1;
              xfmina = EVxfmina;
              xfdiv  = EVxfdiv;
              xtfcls = EVxtfcls;
           Else;

      /End-Free
     C*
     C     ELKY2         CHAIN     PEL02                              60
     C*
     C     *IN60         DOWEQ     *OFF
     C                   Z-ADD     ELDIV         XXDIV
     C     ELPFDT        IFNE      ELPTDT
     C                   ENDIF
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXST
     C*
     C* FIND HIGHEST INCR LIMIT MINIMUM WHILE WE ARE CHECKING.
     C*
     C     ELILCD        IFNE      *BLANKS
     C     ELPFDT        ANDNE     ELPTDT
     C     ELINL2        ORNE      *BLANKS
     C     ELPFDT        ANDNE     ELPTDT
     C*
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXST
     C*
     C     ELILCD        IFNE      *BLANKS
     C                   MOVEL(P)  ELILCD        XXKEY
     C*
     C     LMKEY1        SETGT     PLM01
     C                   READP     PLM01                                  60
     C     *IN60         DOWEQ     '0'
     C     LMSTAT        ANDEQ     'I'
     C                   READP     PLM01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     *IN60         IFEQ      '0'
     C     XXCO#         ANDEQ     LMCO#
     C     XXFND         ANDEQ     LMFND
     C     XXST          ANDEQ     LMST
     C     XXKEY         ANDEQ     LMKEY
     C     XXEFDT        ANDGE     LMEFDT
     C*
     c                   if        xxMinPrm = *off

     C     LMMIN         IFGT      XLMIN1
     C                   Z-ADD     LMMIN         XLMIN1
     C                   Z-ADD     XXDIV         XLDIV1
     C                   ENDIF                                                  LMMIN IFGT

     c                   else

     C     LMMINe        IFGT      XLMIN1
     C                   Z-ADD     LMMINe        XLMIN1
     C                   Z-ADD     XXDIV         XLDIV1
     C                   ENDIF                                                  LMMINe IFGT

     c                   endif

     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  ELILCD IFNE
     C*
     C     ELINL2        IFNE      *BLANKS
     C                   MOVEL(P)  ELINL2        XXKEY
     C*
     C     LMKEY1        SETGT     PLM01
     C                   READP     PLM01                                  60
     C     *IN60         DOWEQ     '0'
     C     LMSTAT        ANDEQ     'I'
     C                   READP     PLM01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     *IN60         IFEQ      '0'
     C     XXCO#         ANDEQ     LMCO#
     C     XXFND         ANDEQ     LMFND
     C     XXST          ANDEQ     LMST
     C     XXKEY         ANDEQ     LMKEY
     C     XXEFDT        ANDGE     LMEFDT
     C*
     c                   if        xxMinPrm = *off

     C     LMMIN         IFGT      XLMIN2
     C                   Z-ADD     LMMIN         XLMIN2
     C                   Z-ADD     XXDIV         XLDIV2
     C                   ENDIF                                                  LMMIN IFGT

     c                   else

     C     LMMINe        IFGT      XLMIN2
     C                   Z-ADD     LMMINe        XLMIN2
     C                   Z-ADD     XXDIV         XLDIV2
     C                   ENDIF                                                  LMMINe IFGT

     c                   endif

     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  ELINL2 IFNE
     C*
     C**** Beg Add ***05/10/24 *******************************
     C                   Endif
     C**** End Add ***05/10/24 *******************************
     C                   ENDIF                                                  ELILCD IFNE
     C                   MOVE      '0'           *IN77
     C                   MOVEA     '11'          *IN(78)
     C                   Z-ADD     9999999       PDAT
     C                   Z-ADD     9999999       RDAT
     C                   Z-ADD     9999999       FDAT
     C                   Z-ADD     ELPFDT        PDAT(1)
     C                   Z-ADD     ELPFDT        RDAT(1)
     C     XXSTDT        IFNE      *ZERO
     C                   Z-ADD     XXSTDT        RDAT(1)
     C                   ENDIF
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   Z-ADD     0             XXANDT
     C                   Z-ADD     2             X
     C                   Z-ADD     ELPFDT        XXEFDT
     C*
     C     ELANDT        IFNE      0
     C     ELANDT        ANDNE     ELPFDT
     C*
     C                   MOVE      ELANDT        XXANDT
     C                   ADD       1             XXANYR
     C*
     C     XXANDT        IFGT      ELPFDT
     C                   MOVE      ELANDT        RDAT(1)
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   MOVE      *ON           *IN77
     C                   ENDIF
     C*
     C     XXANDT        IFGE      ELPTDT
     C     XXANDT        ORLE      ELPFDT
     C                   MOVE      *ON           *IN78
     C                   ELSE
     C                   MOVE      *OFF          *IN78
     C                   ENDIF
     C*
     C     *IN78         IFEQ      '0'
     C     ELEMD1        ANDEQ     ELANDT
     C     ELEMD2        ANDEQ     XXANDT
     C     ELEXM1        ANDNE     ELEXM2
     C                   MOVE      '0'           *IN79
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C     *IN78         IFEQ      '0'
     C                   Z-ADD     XXANDT        PDAT(X)
     C                   Z-ADD     XXANDT        RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                    *IN78='0'
     C*
     C                   ENDIF
     C*
     C                   Z-ADD     ELPTDT        PDAT(X)
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 10/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFLT      1031001
     C     PDAT(W)       ANDLT     1031001
     C     PDAT(Z)       ANDGT     1031001
     C*
     C                   ADD       1             X
     C                   Z-ADD     1031001       PDAT(X)
     C                   Z-ADD     1031001       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 W
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C                   ADD       1             X
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 4/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1030101
     C     RDAT(W)       ANDLE     1030331
     C     PDAT(W)       ANDLT     1030401
     C     PDAT(Z)       ANDGT     1030401
     C*
     C                   Z-ADD     1030401       PDAT(X)
     C                   Z-ADD     1030401       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 4 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* FL RATE SPLIT FOR 07/01/09
     C*
     C     XXST          IFEQ      'FL'
     C     CLTID         ANDEQ     '139'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1090401
     C     RDAT(W)       ANDLT     1090701
     C     PDAT(W)       ANDLT     1090701
     C     PDAT(Z)       ANDGT     1090701
     C                   Z-ADD     1090701       PDAT(X)
     C                   Z-ADD     1090701       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C     XXST          IFEQ      'DE'
     C*DE rate split flag
     C     EXDE08        ANDNE     'Y'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C     RDAT(W)       IFNE      *HIVAL
     C     RDAT(W)       IFLT      1081001
     C     PDAT(W)       ANDLT     1081001
     C     PDAT(Z)       ANDGT     1081001
     C                   Z-ADD     1081001       PDAT(X)
     C                   Z-ADD     1081001       RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   ENDIF                                                  RDAT,W IFGE
     C                   ENDIF                                                  RDAT,W IFNE
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C                   if        xxst = 'AZ'
     C                   do        6             w                 2 0
     C     w             add       1             z
     c                   if        rdat(w) <> *hival
     c                   if        rdat(w) >= 1091001 and
     c                             rdat(w) <= 1091231 and
     c                             pdat(w) <  1100101 and
     c                             pdat(z) >  1100101
     c                   z-add     1100101       pdat(x)
     c                   z-add     1100101       rdat(x)
     c                   z-add     rdat(w)       fdat(x)
     c                   endif                                                  RDAT,W IFGE
     c                   endif                                                  RDAT,W IFNE
     c                   enddo                                                  DO 6 X
     c                   endif                                                  XXST IFEQ
     C* OK RATE SPLIT FOR 09/01/2010
     C*
     C                   if        xxst = 'OK'
     C* Check opt out flag for OK 1100901 rate change
     C                   z-add     1100901       xxSpltDt
     C                   if        ApplyRateSplit(xxst:xxSpltDt)
     C                   do        6             W                 2 0
     C                   eval      z = w + 1
     C*
     C                   if        rdat(w) <> *hival  and
     C                             rdat(w) < xxSpltDt and
     C                             pdat(w) < xxSpltDt and
     C                             pdat(z) > xxSpltDt
     C*
     C                   eval      pdat(x) = xxSpltDt
     C                   eval      rdat(x) = xxSpltDt
     C                   eval      fdat(x) = rdat(w)
     C*
     C                   endif                                                  RDAT,W IFGE
     C*
     C                   enddo                                                  DO 6 X
     C                   endif                                                  ApplyRateSplit
     C*
     C                   endif                                                  xxst
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C*
     C                   DO        6             X
     C*
     C     PDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         PDAT(X)
     C                   ENDIF
     C     RDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         RDAT(X)
     C                   ENDIF
     C     FDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         FDAT(X)
     C                   ENDIF
     C*
     C                   ENDDO
     C*
     C*
     C*  READ EMPLOYER PAYROLL RECORDS
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPSTAT        IFNE      'I'
     C*
     C                   Z-ADD     EPCLAS        XXCLAS
     C*
     C*  GET CORRECT DATE FROM RDAT ARRAY TO PULL RATE FROM RATE FILE
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C     X             ANDGT     1
     C                   SUB       1             X
     C                   Z-ADD     RDAT(X)       XXEFDT
     C                   ELSE
     C                   Z-ADD     1             X
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   END
     C*
     C*  USE THE PAYROLL RATE SET CODE IN EMPLOYER DETAIL TO RETRIEVE
     C*  THE CORRECT PAYROLL CLASS CODE
     C*
     C                   MOVE      ELRTCD        XXRTCD
     C*
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
     C*  GET PAYROLL CLASS FILE
     C*
     C     PRKEY         SETGT     PPR01
     C     PRKY2         READPE    PPR01                                  60
     C     *IN60         IFEQ      '0'
     C*
     C     RSKY          CHAIN     PRS01                              60
     C*
     C     RSJRST        IFNE      'NJ'
     C     PRMNPR        IFGT      XXHIGH
     C                   Z-ADD     PRMNPR        XXHIGH
     C                   Z-ADD     PRCLAS        XXMINC
     C                   Z-ADD     XXDIV         XADIV
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXSTE
     C                   ENDIF                                                  PRMNPR IFGT
     C                   ENDIF                                                  RSJRST IFNE
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C*
     C     PRLOSS        IFGT      XXLOSS
     C     RSJRST        ANDEQ     XSST
     C     EPEAPR        ANDNE     *ZERO
     C                   Z-ADD     PRLOSS        XXLOSS
     C                   Z-ADD     XXDIV         XXDIV1
     C                   ENDIF
     C*
     C* Accumulate highest harbor exposure minimum and total F-class premium.
     C*
     C                   If        ELpfdt <> ELptdt and
     C                             (EPspec = 'F' or PRlhcd = 'Y')
     C
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
     C     HEKY          SETGT     PHE01
     C     HEKY2         READPE    PHE01                                  60
     C                   If        *in60 = *off and HEHXMN > xfmina
     C                   Z-add     HEHXMN        xfmina
     C                   Z-add     ELDiv         xfDiv
     C                   Endif                                                  *IN60 IFEQ
     C
     C                   Add       EPEmpr        xtFcls
     C
     C**** Beg Add ***05/10/24 **************************************
     C                   Endif
     C**** End Add ***05/10/24 **************************************
     C                   Endif                                                  If EPSEPC = 'F' or
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  EPSTAT IFNE
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     ELKY2         READE     PEL02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
      /Free

              Clear pev00;
              EVCo# = xxCo#;
              EVFnd = xxFnd;
              EVFyr = xxFyr;
              EVEmp# = xxEmp#;
              EVType = 'M';
              EVxlmin1 = xlmin1;
              EVxldiv1 = xldiv1;
              EVxlmin2 = xlmin2;
              EVxldiv2 = xldiv2;
              EVxxhigh = xxhigh;
              EVxadiv  = xadiv;
              EVxxloss = xxloss;
              EVxxdiv1 = xxdiv1;
              EVxfmina = xfmina;
              EVxfdiv  = xfdiv;
              EVxtfcls = xtfcls;
              Write pev00;
           Endif;

        Endif;

      /End-Free
     C*
     C                   Z-ADD     X2DIV         XXDIV
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      '0'           *IN77
     C                   MOVEA     '11'          *IN(78)
     C                   Z-ADD     9999999       PDAT
     C                   Z-ADD     9999999       RDAT
     C                   Z-ADD     9999999       FDAT
     C                   Z-ADD     ELPFDT        PDAT(1)
     C                   Z-ADD     ELPFDT        RDAT(1)
     C     XXSTDT        IFNE      *ZERO
     C                   Z-ADD     XXSTDT        RDAT(1)
     C                   ENDIF
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   Z-ADD     0             XXANDT
     C                   Z-ADD     2             X
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVEL(P)  ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVEL(P)  RSJRST        XXST
     C*
     C     ELANDT        IFNE      0
     C     ELANDT        ANDNE     ELPFDT
     C*
     C                   MOVE      ELANDT        XXANDT
     C                   ADD       1             XXANYR
     C*
     C     XXANDT        IFGT      ELPFDT
     C                   MOVE      ELANDT        RDAT(1)
     C                   Z-ADD     RDAT(1)       FDAT(1)
     C                   MOVE      *ON           *IN77
     C                   ENDIF
     C*
     C     XXANDT        IFGE      ELPTDT
     C     XXANDT        ORLE      ELPFDT
     C                   MOVE      *ON           *IN78
     C                   ELSE
     C                   MOVE      *OFF          *IN78
     C                   ENDIF
     C*
     C     *IN78         IFEQ      '0'
     C     ELEMD1        ANDEQ     ELANDT
     C     ELEMD2        ANDEQ     XXANDT
     C     ELEXM1        ANDNE     ELEXM2
     C                   MOVE      '0'           *IN79
     C                   ENDIF                                                  *IN78 IFEQ
     C*
     C     *IN78         IFEQ      '0'
     C                   Z-ADD     XXANDT        PDAT(X)
     C                   Z-ADD     XXANDT        RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                    *IN78='0'
     C*
     C                   ENDIF
     C*
     C                   Z-ADD     ELPTDT        PDAT(X)
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 10/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFLT      1031001
     C     PDAT(W)       ANDLT     1031001
     C     PDAT(Z)       ANDGT     1031001
     C*
     C                   ADD       1             X
     C                   Z-ADD     1031001       PDAT(X)
     C                   Z-ADD     1031001       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 W
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C                   ADD       1             X
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 4/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1030101
     C     RDAT(W)       ANDLE     1030331
     C     PDAT(W)       ANDLT     1030401
     C     PDAT(Z)       ANDGT     1030401
     C*
     C                   Z-ADD     1030401       PDAT(X)
     C                   Z-ADD     1030401       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 4 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* FL RATE SPLIT FOR 07/01/09
     C*
     C     XXST          IFEQ      'FL'
     C     CLTID         ANDEQ     '139'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *HIVAL
     C*
     C     RDAT(W)       IFGE      1090401
     C     RDAT(W)       ANDLT     1090701
     C     PDAT(W)       ANDLT     1090701
     C     PDAT(Z)       ANDGT     1090701
     C                   Z-ADD     1090701       PDAT(X)
     C                   Z-ADD     1090701       RDAT(X)
     C                   Z-ADD     RDAT(W)       FDAT(X)
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C     XXST          IFEQ      'DE'
     C*DE rate split flag
     C     EXDE08        ANDNE     'Y'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C     RDAT(W)       IFNE      *HIVAL
     C     RDAT(W)       IFLT      1081001
     C     PDAT(W)       ANDLT     1081001
     C     PDAT(Z)       ANDGT     1081001
     C                   Z-ADD     1081001       PDAT(X)
     C                   Z-ADD     1081001       RDAT(X)
     C                   Z-ADD     RDAT(X)       FDAT(X)
     C                   ENDIF                                                  RDAT,W IFGE
     C                   ENDIF                                                  RDAT,W IFNE
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     c                   if        xxst = 'AZ'
     C                   do        6             w                 2 0
     C     w             add       1             z
     c                   if        rdat(w) <> *hival
     c                   if        rdat(w) >= 1091001 and
     c                             rdat(w) <= 1091231 and
     c                             pdat(w) <  1100101 and
     c                             pdat(z) >  1100101
     c                   z-add     1100101       pdat(x)
     c                   z-add     1100101       rdat(x)
     c                   z-add     rdat(w)       fdat(x)
     c                   endif                                                  RDAT,W IFGE
     c                   endif                                                  RDAT,W IFNE
     c                   enddo                                                  DO 6 X
     c                   endif                                                  XXST IFEQ
     C* OK RATE SPLIT FOR 09/01/2010
     C*
     C                   if        xxst = 'OK'
     C* Check opt out flag for OK 1100901 rate change
     C                   z-add     1100901       xxSpltDt
     C                   if        ApplyRateSplit(xxst:xxSpltDt)
     C                   do        6             W                 2 0
     C                   eval      z = w + 1
     C*
     C                   if        rdat(w) <> *hival  and
     C                             rdat(w) < xxSpltDt and
     C                             pdat(w) < xxSpltDt and
     C                             pdat(z) > xxSpltDt
     C*
     C                   eval      pdat(x) = xxSpltDt
     C                   eval      rdat(x) = xxSpltDt
     C                   eval      fdat(x) = rdat(w)
     C*
     C                   endif                                                  RDAT,W IFGE
     C*
     C                   enddo                                                  DO 6 X
     C                   endif                                                  ApplyRateSplit
     C*
     C                   endif                                                  xxst
     C* SORT DATE ARRAYS INTO SEQUENCE.
     C*
     C                   SORTA     PDAT
     C                   SORTA     RDAT
     C                   SORTA     FDAT
     C*
     C                   DO        6             X
     C*
     C     PDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         PDAT(X)
     C                   ENDIF
     C     RDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         RDAT(X)
     C                   ENDIF
     C     FDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         FDAT(X)
     C                   ENDIF
     C*
     C                   ENDDO
     C*
      * CLIENT SPECIFIC FOR LUBA - SAFETY FEE MINIMUM BASED ON F-CLASS
      * PREM AND # OF WAIVER OF SUBROGATION RECORDS (MAX = 1500)
      *
     C     XXCLT#        IFEQ      '133'
     C     QQQTE         ANDNE     'Q'
     C     XXEFDT        ANDLT     1060101
      *
     C     XXFCFL        IFEQ      *ON
     C     XXFCLS        ANDLT     1000
     C                   MOVE      'Y'           XXFFL0            1
     C                   ELSE
     C                   MOVE      *BLANK        XXFFL0
     C                   ENDIF
      *
     C     *IN97         IFEQ      *OFF
     C     ELKEY         CHAIN     PEL01                              60
     C                   SELECT
     C     ELFFL0        WHENEQ    *BLANK
     C     XXFFL0        ANDEQ     'Y'
     C                   ADD       1000          ELSFMN
     C     ELFFL0        WHENEQ    'Y'
     C     XXFFL0        ANDEQ     *BLANK
     C     ELSFMN        IFGE      1000
     C                   SUB       1000          ELSFMN
     C                   ENDIF
     C                   ENDSL
     C                   MOVE      XXFFL0        ELFFL0
     C                   MOVEL     Q1USER        ELUSER
     C                   MOVEL     Q1PGM         ELPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         ELDT
     C                   Z-ADD     DSTIME        ELTIME
     C                   UPDATE    PEL01
     C                   ENDIF                                                  *IN97 = *OFF
      *
     C                   ENDIF                                                  XXCLT# = '133'
      *
      *  IF F-CLASS PREMIUM LESS THAN USL&H MINIMUM, SUBTRACT
      *  THE F-CLASS MAN PREM OUT OF THE MAN PREM, AND ADD THE USL&H MIN
      *  TO PREMIUM AFTER THE CHECK FOR MINIMUM PREMIUM.
      *
     C                   CLEAR                   XXHXMN
     C     XXCLT#        IFEQ      '133'
     C     XXEFDT        ANDGE     1060101
     C     XXCLT#        ORNE      '133'
     C                   If        xtfcls < xfmina and xfmina > 0
     C
     C                   If        ELDiv = xfDiv
     C                   Z-ADD     xfmina        xxHXMN
     C                   Endif
     C                   CLEAR                   XXFCLS
     C                   Z-ADD     1             X
     C     MAN(X)        DOWNE     *ZERO
     C                   SUB       FCL(X)        MAN(X)
     C                   ADD       1             X
     C                   ENDDO
     C                   ENDIF
     C                   ENDIF
      *
      *  IF THE USL&H FEE WAS CHARGED THROUGH THE SAFETY FEE MINIMUM FOR 106
      *  YEAR POLICIES, REVERSE THE 1000 CHARGE OUT OF THE SAFETY FEE.
      *
     C     XXCLT#        IFEQ      '133'
     C     XXEFDT        ANDGE     1060101
     C     ELFFL0        ANDEQ     'Y'
     C     ELSFMN        ANDGE     1000
     C     ELKEY         CHAIN     PEL01                              60
     C                   SUB       1000          ELSFMN
     C                   MOVEL     Q1USER        ELUSER
     C                   MOVEL     Q1PGM         ELPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         ELDT
     C                   Z-ADD     DSTIME        ELTIME
     C                   UPDATE    PEL01
     C                   ENDIF
     C*
     C* CA FLAT RATE INCREASE FOR 2002 POLICIES (ANNIVERSARY OR EFF DT)
     C*
     C     XXST          IFEQ      'CA'
     C*
     C                   MOVEL     ELPFDT        XXYR              3 0
     C                   MOVEL     ELANDT        XXAYR             3 0
     C*
     C* APPLY 0.2% INCREASE FOR ANY 2002 POLICIES.
     C*
     C     XXYR          IFEQ      102
     C     XXAYR         OREQ      102
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C     MAN(X)        MULT(H)   1.002         XXWK10
     C                   Z-ADD     XXWK10        MAN(X)
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   ENDIF                                                  XXYR IFEQ
     C*
     C* APPLY 4.9% INCR FOR UNEXPIRED PORTION OF POLICY AS OF 1/1/2003
     C*
     C     XXYR          IFEQ      102
     C     ELPTDT        ANDGT     1030101
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C     X             ADD       1             Y
     C*
     C     RDAT(X)       IFNE      *ZERO
     C*
     C     RDAT(Y)       IFNE      *ZERO
     C                   Z-ADD     RDAT(Y)       XXDT              7 0
     C                   ELSE
     C                   Z-ADD     ELPTDT        XXDT
     C                   ENDIF
     C*
     C* APPLY INCR IF 1/1/2003 FALLS WITHIN RATING PERIOD.
     C*
     C     RDAT(X)       IFLT      1030101
     C     XXDT          ANDGT     1030101
     C*
     C* TOTAL DAYS FOR PERIOD.
     C*
     C     RDAT(X)       IFLT      ELPFDT
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ELSE
     C                   Z-ADD     RDAT(X)       SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        TDAYS             5 0
     C*
     C* UNEXPIRED DAYS IN PERIOD.
     C*
     C                   Z-ADD     1030101       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        UDAYS             5 0
     C*
     C     TDAYS         IFNE      *ZERO
     C     UDAYS         DIV(H)    TDAYS         X2FACT            7 6
     C                   ELSE
     C                   Z-ADD     0             X2FACT
     C                   ENDIF
     C*
     C                   MULT(H)   .049          X2FACT
     C                   ADD       1             X2FACT
     C     MAN(X)        MULT(H)   X2FACT        XXWK10
     C                   Z-ADD     XXWK10        MAN(X)
     C*
     C                   ENDIF                                                  RDAT,X IFLT
     C*
     C                   ENDIF                                                  RDAT,X IFNE
     C*
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   ENDIF                                                  XXYR IFEQ
     C*
     C                   ENDIF                                                  XXST IFEQ
     c                   z-add     1110901       xxSpltDt
     c* Generate flat rate adjustment if IL coverage as of 09/01/2011
     c*
     c                   if        xxst = 'IL' and
     c                             elpfdt < xxSpltDt and
     c                             elptdt > xxSpltDt and
     c                             ApplyRateSplit(xxst:xxSpltDt)
      *
      * Calculate Unexpired policy portion in months
     c                   movel     xxSpltDt      srdate1
     c                   movel     elptdt        srdate2
     c                   z-add     0             xx#Mth            2 0
     c                   eval      xx#mth = ((sryy2 - sryy1) * 12
     c                                      + (srmm2 - srmm1))
     c                   eval(h)   xxadjp = (-8.8) * (xx#Mth/12)
     c                   eval(h)   xxrtadj = xxadjp/100
      *
     c                   z-add     1             x
     c                   dow       rdat(x) > 0
     c                   eval(h)   xxwk10 = man(x) * xxrtadj
     c                   eval      man(x) = man(x) + xxwk10
     c                   eval      x = x + 1
     c                   enddo                                                  rdat(x) > 0
      *
     c                   endif                                                  xxst = 'IL'
     C*
     C     XXNJMN        IFGT      XXHIGH
     C                   Z-ADD     XXNJMN        XXHIGH
     C                   MOVE      'NJ'          XXSTE
     C                   Z-ADD     SVMINC        XXMINC
     C                   ENDIF
     C                   Z-ADD     XXHIGH        SVHIGH           11 2
     C* INVOKE MANUAL PREMIUM ROUTINE IF ELFFL2 = BLANK
     C     ELFFL2        IFEQ      *BLANK
     C     XXCLT#        ANDEQ     '102'
     C* APPLY A MINIMUM MANUAL PREMIUM FOR ALL POLICIES IF NECESSARY.
     C                   XFOOT     MAN           XXPREM
     C*
     C     XXPREM        IFLT      2500
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C     2500          MULT(H)   PRO(X)        XXWK10
     C                   Z-ADD     XXWK10        MAN(X)
     C                   ADD       1             X
     C                   ENDDO                                                  RDAT,X DOWNE
     C*
     C                   XFOOT     MAN           XXPREM
     C     XXPREM        IFNE      2500
     C     2500          SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        MAN(1)
     C                   ENDIF                                                  XXPREM IFNE
     C*
     C                   ENDIF                                                  XXPREM IFLT
     C                   ENDIF                                                  ELFFL2 = *BLANKS
     C                   Z-ADD     MAN           STN
     C                   Z-ADD     MAN           STNT
     C                   Z-ADD     MAN           STN1
     C                   Z-ADD     MAN           STN2
     C                   Z-ADD     MAN           STN3
     C                   Z-ADD     MAN           STN4
     C                   Z-ADD     MAN           STN5
     C                   Z-ADD     MAN           STN6
     C                   Z-ADD     MAN           STN7
     C                   Z-ADD     MAN           STOC
     C*
     C                   Z-ADD     ELPFDT        XXEFDT
     C     ELCOFL        IFEQ      'Y'
     C*
     C     ELSRPR        IFEQ      'P'
     C     ELPFDT        ANDGE     1000101
     C     XXST          ANDNE     'MI'
     C     XXST          ANDNE     'NJ'
     C*
     C                   Z-ADD     0             XXPROR            5 3
      *
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         XXPROR
     C                   ENDIF                                                  FDAYS IFNE 0
     C*
     C*
     C                   ENDIF                                                  ELSRPR IFEQ
     C*
     C                   ENDIF                                                  ELCOFL IFEQ
     C     ELCOFL        IFEQ      'Y'
     C*
     C                   Z-ADD     0             XXPROR            5 3
      *
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         XXPROR
     C                   ENDIF                                                  FDAYS IFNE 0
     C*
     C                   ENDIF                                                  SVCNCL IFNE
     C*
     C*
     C* LOAD C SPECS FOR BILLING DISCOUNT SECTION
     C*
     C                   EXSR      BILLC
     C*
     C* EXPENSE CONSTANT
     C*
     C*
     C*  CHECK THE TOTAL STANDARD PREMIUM ON THE POLICY AND COMPARE
     C*  TO THE STANDARD PREMIUM LEVEL FOR REDUCED EXPENSE CONSTANT
     C*  IF SPECIFIED.  IF THE PREMIUM IS LESS, USE THE REDUCED CNST.
     C*
     C                   Z-ADD     0             XTSTPR           11 2
     C*
     C*** begin add ***  09/05/25  ****************************************
           Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'S') pev00;
           If %found;
              xtStpr = EVxtStpr;
           Else;
     C*** end add *****  09/05/25  ****************************************
     C     DSKY          CHAIN     PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C                   ADD       MPSTPR        XTSTPR
     C     DSKY          READE     PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*** begin add ***  09/05/25  ****************************************

              Clear pev00;
              EVCo# = xxCo#;
              EVFnd = xxFnd;
              EVFyr = xxFyr;
              EVEmp# = xxEmp#;
              EVType = 'S';
              EVxtStpr = xtStpr;
              Write pev00;
           Endif;
     C*** end add *****  09/05/25  ****************************************
     C*
     C                   MOVE      *BLANK        XXECST            2
     C                   Z-ADD     0             XPEXCO            5 2
     C     XXST          IFEQ      'PA'
     C                   MOVE      'PA'          XXECST
     C                   ENDIF
     C     FNKEY         CHAIN     PEX02                              60
     C*
     C     EXBEST        IFEQ      'Y'
     C     EMSTRP        OREQ      'Y'
     C     F1EXDV        OREQ      'Y'
     C*
     C                   Z-ADD     0             XEPREM           11 2
     C                   MOVE      *BLANKS       XEST              2
     C                   Z-ADD     0             XEDIV             5 0
     C*
     C                   Z-ADD     0             XXWKEX
     C                   Z-ADD     0             XXEXCO
     C                   Z-ADD     0             XXMPEC
     C                   MOVE      *BLANK        XXEHF             1
     C                   MOVE      *BLANK        XXEREV            1
     C                   Z-ADD     9999999       XXEHDT            7 0
     C                   MOVE      *BLANK        XXSFUL            1
     C                   MOVE      ELPFDT        XXEFDT
     C     FNPEOF        IFEQ      'M'
     C     FNPEOE        ANDEQ     'Y'
     C     FNPEOF        OREQ      'G'
     C     FNPEOE        ANDEQ     'Y'
     C     FNPEOF        OREQ      'C'
     C     FNPEOE        ANDEQ     'Y'
     C*
     C     XXEMP#        IFEQ      1
     C*
     C     ECKY          SETGT     PEC01
     C     ECKY1         READPE    PEC01                                  60
      *
      * REDUCE THE EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     XTSTPR        ANDLT     ECSTP3
     C     ECSTP3        ANDNE     *ZERO
     C                   Z-ADD     ECEXC3        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
     C     *IN60         IFEQ      *OFF
     C     XTSTPR        ANDLT     ECSTPR
     C     ECSTPR        ANDNE     *ZERO
     C                   Z-ADD     ECEXC2        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * FIND HIGHEST EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDGT     XXEXCO
     C                   Z-ADD(H)  ECEXCO        XXWKEX           11 0
     C                   Z-ADD     ECEXCO        XXEXCO
     C                   Z-ADD     ECMPEC        XXMPEC
     C                   MOVE      ECSFUL        XXSFUL
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     XXST          ANDEQ     'PA'
     C                   Z-ADD     ECEXCO        XPEXCO
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXEMP# IFEQ
     C*
     C                   ELSE
     C*** begin add ***  09/05/25  ****************************************
     C* Chain to temp value file and then use if record found and either
     C* EXBest is Y or F1Exdv is Y.  otherwise process and later write rcd.

           Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'E') pev00;
           If %found and (EXBest = 'Y' or F1Exdv = 'Y');
              xxWkex = EVxxWkex;
              xpExco = EVxpExco;
              xxExco = EVxxExco;
              xxMpec = EVxxMpec;
              xxSful = EVxxSful;
              xeDiv = EVxeDiv;
           Else;
     C*** end add *****  09/05/25  ****************************************
     C     QQOVR         IFEQ      'Y'
     C*
     C* SAVE DIVISION NUMBER.
     C*
     C                   Z-ADD     XXDIV         X1DIV             5 0
     C*
     C* READ THROUGH ORIGINAL BILL EMPLR HISTORY FOR EXPENSE CONSTANT.
     C*
     C     ELKY2         CHAIN     PEH02                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EHTRDT        IFLT      XXEHDT
     C     EHTRDT        ANDNE     *ZERO
     C                   Z-ADD     EHTRDT        XXEHDT
     C                   ENDIF
     C*
     C     EHFAF         IFNE      'A'
     C                   MOVE      'Y'           XXEREV
     C                   ENDIF
     C     EHFAF2        IFEQ      'E'
     C                   MOVE      EHDIV         XXDIV
     C                   MOVE      'Y'           XXEHF
     C     ELKY6         CHAIN     PEL02                              60
     C     *IN60         IFEQ      *OFF
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
      *
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C     ECKY          SETGT     PEC01
     C     ECKY1         READPE    PEC01                                  60
      *
      * REDUCE THE EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTP3
     C     ECSTP3        ANDNE     *ZERO
     C                   Z-ADD     ECEXC3        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTPR
     C     ECSTPR        ANDNE     *ZERO
     C                   Z-ADD     ECEXC2        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XXST          ANDEQ     'PA'
     C                   Z-ADD     ECEXCO        XPEXCO
     C                   ENDIF
      *
      * FIND HIGHEST EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDGT     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C                   Z-ADD(H)  ECEXCO        XXWKEX           11 0
     C                   Z-ADD     ECEXCO        XXEXCO
     C                   Z-ADD     ECMPEC        XXMPEC
     C                   MOVE      ECSFUL        XXSFUL
     C*
     C* STORE STATE WITH HIGHEST EXPENSE CONSTANT.
     C*
     C     XEST          IFNE      XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   MOVE      XXST          XEST
     C                   Z-ADD     XXDIV         XEDIV
     C                   Z-ADD     0             XEPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XEPREM
     C                   SUB       MPPRTD        XEPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ENDIF                                                  XEST IFNE
     C*
     C                   ELSE
     C*
     C* IF THIS STATE HAS SAME EXP CONSTANT AS HIGHEST, COMPARE PREMIUM
     C*
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDEQ     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C     XEST          ANDNE     XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   Z-ADD     0             XXPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XXPREM
     C                   SUB       MPPRTD        XXPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXPREM        IFGT      XEPREM
     C                   MOVE      XXST          XEST
     C                   Z-ADD     XXDIV         XEDIV
     C                   Z-ADD     XXPREM        XEPREM
     C                   ENDIF                                                  XXPREM IFGT
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
     C**** Beg Add ***05/10/24 **************************************
     C                   Endif
     C**** End Add ***05/10/24 **************************************
      *
      * STORE PA EXPENSE CONSTANT.
      *
      *
     C                   ENDIF                                                  *IN60 IFEQ
      *
     C                   ENDIF                                                  EHFAF2 IFEQ
      *
      * READ NEXT EMPLR HISTORY RECORD.
      *
     C     ELKY2         READE     PEH02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXEHF         IFEQ      *BLANK
     C     XXEREV        ANDEQ     'Y'
     C*
     C     X1PFDT        IFEQ      *ZERO
     C                   MOVEL     ELPFDT        XXYM              5 0
     C                   ELSE
     C                   MOVEL     X1PFDT        XXYM
     C                   ENDIF
     C                   MOVEL     XXEHDT        XXYM2             5 0
     C*
     C     XXYM          IFLT      XXYM2
     C                   MOVEL     XXYM2         XXYM
     C                   ENDIF
     C                   MOVEL     XXYM          XXEHDT
     C                   MOVE      31            XXEHDT
     C*
     C* READ THROUGH EMPLR HISTORY FOR EXPENSE CONSTANT.
     C*
     C     ELKY2         CHAIN     PEH02                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EHFAF         IFEQ      'R'
     C     EHTRDT        ANDLE     XXEHDT
     C*
     C                   MOVE      EHDIV         XXDIV
     C     ELKY6         CHAIN     PEL02                              60
     C     *IN60         IFEQ      *OFF
      *
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C     ECKY          SETGT     PEC01
     C     ECKY1         READPE    PEC01                                  60
      *
      * REDUCE THE EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTP3
     C     ECSTP3        ANDNE     *ZERO
     C                   Z-ADD     ECEXC3        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTPR
     C     ECSTPR        ANDNE     *ZERO
     C                   Z-ADD     ECEXC2        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XXST          ANDEQ     'PA'
     C                   Z-ADD     ECEXCO        XPEXCO
     C                   ENDIF
      *
      * FIND HIGHEST EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDGT     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C                   Z-ADD(H)  ECEXCO        XXWKEX           11 0
     C                   Z-ADD     ECEXCO        XXEXCO
     C                   Z-ADD     ECMPEC        XXMPEC
     C                   MOVE      ECSFUL        XXSFUL
     C*
     C* STORE STATE WITH HIGHEST EXPENSE CONSTANT.
     C*
     C     XEST          IFNE      XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   MOVE      XXST          XEST
     C                   Z-ADD     XXDIV         XEDIV
     C                   Z-ADD     0             XEPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XEPREM
     C                   SUB       MPPRTD        XEPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ENDIF                                                  XEST IFNE
     C*
     C                   ELSE
     C*
     C* IF THIS STATE HAS SAME EXP CONSTANT AS HIGHEST, COMPARE PREMIUM
     C*
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDEQ     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C     XEST          ANDNE     XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   Z-ADD     0             XXPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XXPREM
     C                   SUB       MPPRTD        XXPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXPREM        IFGT      XEPREM
     C                   MOVE      XXST          XEST
     C                   Z-ADD     XXDIV         XEDIV
     C                   Z-ADD     XXPREM        XEPREM
     C                   ENDIF                                                  XXPREM IFGT
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
     C**** Beg Add ***05/10/24 **************************************
     C                   Endif                                                  *IN60 IFEQ
     C**** End Add ***05/10/24 **************************************
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C                   ENDIF                                                  *IN60 IFEQ
      *
     C                   ENDIF                                                  EHFAF  IFEQ
      *
      * READ NEXT EMPLR HISTORY RECORD.
      *
     C     ELKY2         READE     PEH02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
      *
     C                   ENDIF                                                  XXEHF IFEQ
      *
     C     XXEHF         IFEQ      *BLANK
     C     XXEREV        ANDEQ     *BLANK
     C*
     C* READ THROUGH EMPLR DETAIL FOR EXPENSE CONSTANT.
     C*
     C     ELKY2         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
      *
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C     ECKY          SETGT     PEC01
     C     ECKY1         READPE    PEC01                                  60
      *
      * REDUCE THE EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTP3
     C     ECSTP3        ANDNE     *ZERO
     C                   Z-ADD     ECEXC3        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTPR
     C     ECSTPR        ANDNE     *ZERO
     C                   Z-ADD     ECEXC2        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XXST          ANDEQ     'PA'
     C                   Z-ADD     ECEXCO        XPEXCO
     C                   ENDIF
      *
      * FIND HIGHEST EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDGT     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C                   Z-ADD(H)  ECEXCO        XXWKEX           11 0
     C                   Z-ADD     ECEXCO        XXEXCO
     C                   Z-ADD     ECMPEC        XXMPEC
     C                   MOVE      ECSFUL        XXSFUL
     C*
     C* STORE STATE WITH HIGHEST EXPENSE CONSTANT.
     C*
     C     XEST          IFNE      XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   MOVE      XXST          XEST
     C                   Z-ADD     ELDIV         XEDIV
     C                   Z-ADD     0             XEPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XEPREM
     C                   SUB       MPPRTD        XEPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ENDIF                                                  XEST IFNE
     C*
     C                   ELSE
     C*
     C* IF THIS STATE HAS SAME EXP CONSTANT AS HIGHEST, COMPARE PREMIUM
     C*
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDEQ     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C     XEST          ANDNE     XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   Z-ADD     0             XXPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XXPREM
     C                   SUB       MPPRTD        XXPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXPREM        IFGT      XEPREM
     C                   MOVE      XXST          XEST
     C                   Z-ADD     ELDIV         XEDIV
     C                   Z-ADD     XXPREM        XEPREM
     C                   ENDIF                                                  XXPREM IFGT
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
      *
      * READ NEXT EMPLR DETAIL RECORD.
      *
     C**** Beg Add ***05/10/24 **************************************
     C                   Endif
     C**** End Add ***05/10/24 **************************************
     C     ELKY2         READE     PEL02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
      *
     C                   ENDIF                                                  XXEHF IFEQ
      *
     C*
     C* RESET DIVISION NUMBER.
     C*
     C                   Z-ADD     X1DIV         XXDIV
     C                   ELSE
     C     ELKY2         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
      *
     C**** Beg Add ***05/10/24 **************************************
     C                   Exsr      GetCXDT
     C                   If        yycxdt > ELpfdt or yycxdt = *zeros
     C**** End Add ***05/10/24 **************************************
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C     ECKY          SETGT     PEC01
     C     ECKY1         READPE    PEC01                                  60
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTP3
     C     ECSTP3        ANDNE     *ZERO
     C                   Z-ADD     ECEXC3        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XTSTPR        ANDLT     ECSTPR
     C     ECSTPR        ANDNE     *ZERO
     C                   Z-ADD     ECEXC2        ECEXCO
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C     *IN60         IFEQ      *OFF
     C     ELPFDT        ANDNE     ELPTDT
     C     XXST          ANDEQ     'PA'
     C                   Z-ADD     ECEXCO        XPEXCO
     C                   ENDIF
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDGT     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C                   Z-ADD(H)  ECEXCO        XXWKEX           11 0
     C                   Z-ADD     ECEXCO        XXEXCO
     C                   Z-ADD     ECMPEC        XXMPEC
     C                   MOVE      ECSFUL        XXSFUL
     C*
     C* STORE STATE WITH HIGHEST EXPENSE CONSTANT.
     C*
     C     XEST          IFNE      XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   MOVE      XXST          XEST
     C                   Z-ADD     ELDIV         XEDIV
     C                   Z-ADD     0             XEPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XEPREM
     C                   SUB       MPPRTD        XEPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ENDIF                                                  XEST IFNE
     C*
     C                   ELSE
     C*
     C* IF THIS STATE HAS SAME EXP CONSTANT AS HIGHEST, COMPARE PREMIUM
     C*
     C     *IN60         IFEQ      *OFF
     C     ECEXCO        ANDEQ     XXEXCO
     C     ELPFDT        ANDNE     ELPTDT
     C     XEST          ANDNE     XXST
     C     EXBEST        ANDEQ     'Y'
     C*
     C                   Z-ADD     0             XXPREM
     C*
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C     MPST          IFEQ      XXST
     C                   ADD       MPANPR        XXPREM
     C                   SUB       MPPRTD        XXPREM
     C                   ENDIF
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXPREM        IFGT      XEPREM
     C                   MOVE      XXST          XEST
     C                   Z-ADD     ELDIV         XEDIV
     C                   Z-ADD     XXPREM        XEPREM
     C                   ENDIF                                                  XXPREM IFGT
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
      *
      * STORE PA EXPENSE CONSTANT.
      *
     C**** Beg Add ***05/10/24 **************************************
     C                   Endif
     C**** End Add ***05/10/24 **************************************
     C     ELKY2         READE     PEL02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C                   ENDIF                                                  QQOVR IFEQ
     C*** begin add ***  09/05/25  ****************************************

              Clear pev00;
              EVCo# = xxCo#;
              EVFnd = xxFnd;
              EVFyr = xxFyr;
              EVEmp# = xxEmp#;
              EVxxWkex = xxWkex;
              EVxpExco = xpExco;
              EVxxExco = xxExco;
              EVxxMpec = xxMpec;
              EVxxSful = xxSful;
              EVxeDiv = xeDiv;
              EVType = 'E';
              Write pev00;
           Endif;
     C*** end add *****  09/05/25  ****************************************
     C                   ENDIF                                                  FNPEOF IFEQ
     C*
     C     ELKEY         CHAIN     PEL01                              60
     C                   MOVE      ELRTCD        XXRTCD
     C     RSKY          CHAIN     PRS01                              60
     C                   MOVE      RSJRST        XXST
     C                   MOVE      *BLANKS       ELEMNP
     C*
     C                   ELSE
     C                   Z-ADD     0             XXWKEX
     C                   ENDIF                                                  EMSTRP IFEQ
     C     XXECST        IFEQ      'PA'
     C     XXEXCO        ANDNE     *ZERO
     C     XXEXCO        ANDGT     XPEXCO
     C                   MOVE      'XX'          XXECST
     C                   ENDIF
      *
     C                   If        QQQte = 'Q'
     C     FNPEOF        Ifeq      'S'
     C     XXEMP#        Andne     1
     C     FNPEOF        Oreq      'C'
     C     XXEMP#        Andne     1
     C     RRPEOF        ANDEQ     'S'
     C                   Z-ADD     0             XXEXCO
     C                   Z-ADD     0             XXWKEX
     C                   Z-ADD     0             XXMPEC
     C                   ENDIF
     C                   ENDIF
      *
      *  GET PRORATE FACTOR IF NECESSARY
      *
     C                   Z-ADD     0             ELPROR
      *
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         ELPROR
     C                   ENDIF                                                  FDAYS IFNE 0
      *
     C                   Z-ADD     ELPROR        XEPROR
     C     ELFFL9        IFNE      ' '
     C                   Z-ADD     1             ELPROR
     C                   ENDIF
     C     XXST          IFEQ      'LA'
     C     1             MULT(H)   XXNORM        XXWK10
     C                   ELSE
     C     ELPROR        MULT(H)   XXNORM        XXWK10
     C                   ENDIF
      *
     C     XXWK10        ADD       XXWKEX        XXWKCM           15 4
     C*
     C* Add prorated expense constant to minimum premium work field
     C* if the policy is short term for concurrency.
     C*
     C     ELCOFL        IFEQ      'Y'
     C*
     C     ELPROR        MULT(H)   XXEXCO        XXWKEX
     C     XXWKEX        IFLT      XXMPEC
     C                   Z-ADD     XXMPEC        XXWKEX
     C                   ENDIF
     C*
     C     XXWK10        ADD       XXWKEX        XXWKCM
     C*
     C                   ENDIF                                                  ELCOFL IFEQ
      *
     C     DSKY1         CHAIN     PMP01                              60
     C                   Z-ADD     XXCO#         MPCO#
     C                   Z-ADD     XXFND         MPFND
     C                   Z-ADD     XXEMP#        MPEMP#
     C                   Z-ADD     XXDIV         MPDIV
     C                   Z-ADD     XXFYR         MPFYR
     C*
     C* POPULATE PREMIUM FIELDS BEFORE MINIMUM PREMIUM IS CHECKED.
     C*
     C                   Z-ADD     XXDIS1        MPEDC1
     C                   Z-ADD     XXDIS2        MPEDC2
     C                   Z-ADD     XXD1D2        MPD1E2
     C                   Z-ADD     XXDIS3        MPEDC3
     C     XXEXPP        SUB       XXPRXP        MPEXPA
     C                   Z-add     xxexpp        MPEMPM
     C                   Z-add     xxprxp        MPEPBM
     C                   Z-add     xxexp1        MPEXP1
     C                   Z-add     xxexp2        MPEXP2
     C                   Z-add     xxexp3        MPEXP3
     C                   Z-ADD(H)  XXSUBJ        XXWK10
     C                   Z-ADD     XXWK10        MPESBJ
     C                   Z-ADD     XXDIST        MPEDCT
     C                   Z-ADD     XXD2ST        MPEDD2
     C                   Z-ADD     *ZEROS        MPADD2
     C                   Z-ADD     XXHCNA        MPEHCN
     C                   Z-ADD     XXDISM        MPEDCM
     C                   Z-ADD     XXDISS        MPEDCS
     C     XXDISD        MULT      -1            MPEDC
     C                   Z-ADD     XXDEV2        MPEDV2
     C                   Z-ADD     XXD2D2        MPD2E2
     C                   XFOOT(H)  WAV           XXWK10
     C                   Z-ADD     XXWK10        MPEWAV
     C                   Z-ADD     0             MPETCA
     C*
     C     XXDIV         IFEQ      XEDIV
     C     EXBEST        ANDEQ     'Y'
     C     EMSTRP        OREQ      'Y'
     C     EXBEST        ANDNE     'Y'
     C     F1EXDV        OREQ      'Y'
     C*
     C     XXSFUL        IFNE      'Y'
     C     ELCOFL        OREQ      'Y'
     C     ELPROR        MULT(H)   XXEXCO        XXEXCN           15 4
     C                   ELSE
     C                   Z-ADD(H)  XXEXCO        XXEXCN           15 4
     C                   ENDIF                                                  XXSFUL IFEQ
     C*
     C     XXEXCN        IFLT      XXMPEC
     C                   Z-ADD     XXMPEC        XXEXCN
     C                   END
     C*
     C                   ELSE
     C                   Z-ADD     0             XXEXCN
     C                   END
      *** Begin Add *** 11/02/23 *******************************************
     C*
     C*  Load SVPRTF with XXEXCO then into ELPRTF
     C*
     C                   Z-ADD(H)  XXEXCO        XXSAVE
     C                   Z-ADD     XXSAVE        XXEXCO
     C                   Z-ADD     XXEXCO        SVPRTF           11 2
      *** End   Add *** 11/02/23 *******************************************
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXEXCN        XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXEXCN
     C                   Z-ADD     XXEXCN        MPPRTD
     C                   Z-ADD     MPPRTD        SVPRTD           11 2
     C                   Z-ADD     MPPRTD        S1PRTD           11 2
     C     SVPRTD        IFEQ      *ZERO
     C     EXBEXP        ANDEQ     'Y'
     C*
     C     XXSFUL        IFNE      'Y'
     C     ELCOFL        OREQ      'Y'
     C     ELPROR        MULT(H)   XXEXCO        XXWK90
     C                   ELSE
     C                   Z-ADD(H)  XXEXCO        XXWK90
     C                   ENDIF                                                  XXSFUL IFEQ
     C*
     C                   Z-ADD     XXWK90        SVPRTD
     C*
     C     SVPRTD        IFLT      XXMPEC
     C                   Z-ADD     XXMPEC        SVPRTD
     C                   END
     C*
     C                   ENDIF
     C                   Z-ADD(H)  XXSTAN        XXWK10
     C                   Z-ADD     XXWK10        MPSTPR
     C                   Z-ADD     XSMAN         MPMAPR
     C                   Z-ADD(H)  XXNORM        XXWK10
     C                   Z-ADD     XXWK10        MPENMP
     C     XXST          IFEQ      'LA'
     C     1             MULT(H)   XXNORM        XXWK10
     C                   ELSE
     C     ELPROR        MULT(H)   XXNORM        XXWK10
     C                   ENDIF
      *
     C     XXWK10        ADD       MPPRTD        MPANPR
     C                   Z-ADD     XXVLCA        MPEVLC
     C     ELPROR        MULT(H)   XLNET         XXWK10
     C                   Z-ADD     XXWK10        MPANPL
     C                   MOVE      XXST          MPST
     C                   MOVEL     Q1USER        MPUSER
     C                   MOVEL     Q1PGM         MPPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         MPDT
     C                   Z-ADD     DSTIME        MPTIME
     C*** Beg Add *****  02/27/24  **************************************
     C                   Eval      MPSRAM = ELSRAM
     C*** End Add *****  02/27/24  **************************************
      //*** Beg Add ***** 08/14/24 **************************************
       MPein1 = %XFoot(LM);
       MPein2 = %XFoot(LM2);
       MPebil = %XFoot(LMB);
       MPebil2 = %XFoot(LMB2);
      //*** End Add ***** 08/14/24 **************************************
     C     *IN60         IFEQ      '0'
     C                   UPDATE    PMP01
     C                   ELSE
     C                   WRITE     PMP01
     C                   ENDIF
     C*
     C*  CHECK MINIMUM PREMIUM IF NOT OVERRIDDEN
     C*
     C                   MOVE      *BLANKS       ELEMNP
     C                   Z-ADD     XXHIGH        XSHIGH           11 2
     C     ELEIN1        ADD       ELEIN2        XSILAM           11 2
     C     ELCOFL        IFEQ      'Y'
     C     XSHIGH        MULT(H)   ELPROR        XXWK10
     C                   Z-ADD     XXWK10        XSHIGH
     C     XSILAM        MULT(H)   ELPROR        XXWK10
     C                   Z-ADD     XXWK10        XSILAM
     C                   ENDIF                                                  ELCOFL IFEQ
     C*
     C*  STORE TOTAL WAIVER SURCHARGE AMOUNT.
     C*
     C                   XFOOT(H)  WAV           XXWK10
     C                   Z-ADD     XXWK10        XXWVMN
     C*
     C     EMSTRP        IFEQ      'Y'
     C*
     C     DSKY          CHAIN     PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     MPDIV         IFNE      ELDIV
     C                   ADD       MPANPR        XXWKCM
     C                   SUB       MPPRTD        XXWKCM
     C                   ADD       MPEWAV        XXWVMN
     C                   ENDIF                                                  MPDIV IFNE
     C*
     C     DSKY          READE     PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C                   ADD       XXWVMN        XSHIGH
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDNE     'LA'
     C     XXST          OREQ      'NJ'
     C     XXST          IFEQ      'NJ'
     C                   SUB       XXMIN1        XXHIGH
     C                   SUB       XXMIN2        XXHIGH
     C                   ENDIF
     C     XXHIGH        MULT(H)   XEPROR        XXWK10
     C                   Z-ADD     XXWK10        XXHIGH
     C     XXST          IFEQ      'NJ'
     C                   ADD       XXMIN1        XXHIGH
     C                   ADD       XXMIN2        XXHIGH
     C                   ENDIF
     C                   ENDIF                                                  ELCOFL IFEQ
     C                   ADD       XXWVMN        XXHIGH
     C     XXCLT#        IFEQ      '102'
     C                   ADD       SVPRTD        XXHIGH
     C                   ENDIF                                                  XXCLT#='102'
     C     XXHIGH        IFGT      XXWKCM
     C*** begin del ***  02/19/24  *****************************************
     C*****XXCLT#        ANDNE     '102'
     C*****XXHIGH        ORGT      XXWKCM
     C*****XXCLT#        ANDEQ     '102'
     C*****ELFFL2        ANDEQ     *BLANK
     C*** end del *****  02/19/24  *****************************************
     C                   MOVE      'Y'           ELEMNP
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDEQ     'LA'
     C                   SUB       XXWVMN        XXHIGH
     C     XXHIGH        MULT(H)   XEPROR        XXWK10
     C                   Z-ADD     XXWK10        XXHIGH
     C                   ADD       XXWVMN        XXHIGH
     C                   ENDIF                                                  ELCOFL IFEQ
     C                   Z-ADD     XXHIGH        XXNET
     C                   Z-ADD     XXHIGH        XXNORM
     C                   Z-ADD     0             XXEXCN
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXNET         XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXNET
     C*
     C                   Z-ADD(H)  XXNORM        XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXNORM
     C*
     C                   END
     C                   ENDIF                                                  EMSTRP IFEQ
     C*
     C*  CALCULATE THE NET RATE AND NET PREMIUM FOR EACH PAYROLL
     C*  CLASS, AND THEN OVERRIDE NORMAL PREMIUM WITH THE TOTAL.
     C*
     C     *IN94         IFEQ      *OFF
     C     *IN95         ANDEQ     *OFF
     C     *IN96         ANDEQ     *OFF
     C     *IN97         ANDEQ     *OFF
     C     *IN98         ANDEQ     *OFF
     C     CLTID         OREQ      '093'
     C     *IN94         ANDEQ     *OFF
     C     *IN95         ANDEQ     *OFF
     C     *IN96         ANDEQ     *OFF
     C     *IN97         ANDEQ     *OFF
     C*
     C                   Z-ADD     0             XXTMAN           11 2
     C                   Z-ADD     0             XXENMP           11 2
     C                   Z-ADD     0             XXTNET           11 2
     C*** begin add ***  11/08/24  ****************************************
     C                   Z-ADD     0             xxActp           11 2
     C*** end add *****  11/08/24  ****************************************
     C*
     C* TOTAL THE MANUAL AND NORMAL PREMIUM FOR THE STATE.
     C*
     C*** begin add ***  09/05/25  ****************************************
        Chain(n) (xxCo#:xxFnd:xxFyr:xxEmp#:'A':xxst) pev00;
        If %found;
           xxTMan = EVxxTMan;
           xxEnmp = EVxxEnmp;
           xxActp = EVxxActp;
        Else;
     C*** end add *****  09/05/25  ****************************************
     C     DSKY          CHAIN(N)  PMP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     MPST          IFEQ      XXST
     C                   ADD       MPMAPR        XXTMAN
     C                   ADD       MPENMP        XXENMP
     C                   ENDIF
     C*** begin add ***  11/08/24  ****************************************
     C                   ADD       MPANPR        xxActp
     C*** end add *****  11/08/24  ****************************************
     C*
     C     DSKY          READE(N)  PMP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*** begin add ***  09/05/25  ****************************************

           Clear pev00;
           EVCo# = xxCo#;
           EVFnd = xxFnd;
           EVFyr = xxFyr;
           EVEmp# = xxEmp#;
           EVType = 'A';
           EVxxTMan = xxTMan;
           EVxxEnmp = xxEnmp;
           EVxxActp = xxActp;
           EVSt  = xxSt;
           Write pev00;
        Endif;
     C*** end add *****  09/05/25  ****************************************
     C*
     C* CALCULATE THE NET RATE FACTOR.
     C*
     C     XXTMAN        IFNE      *ZERO
     C     XXENMP        DIV(H)    XXTMAN        XXNETR            9 6
     C                   ELSE
     C                   Z-ADD     1             XXNETR
     C                   ENDIF                                                  XXTMAN IFNE
     C*
     C* APPLY THE NET RATE FACTOR AGAINST ALL ACTIVE PAYROLLS.
     C*
     C     EPKEY         CHAIN     PEP01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPSTAT        IFNE      'I'
     C*
     c                   if        xxnetf = 'Y'
     C                   ADD       epentp        XXTNET
     c                   else
     C     XXNETR        MULT(H)   EPARAT        EPENTR
     C     XXNETR        MULT(H)   EPEMPR        XXWK10
     C                   Z-ADD     XXWK10        EPENTP
     C                   ADD       XXWK10        XXTNET
     C*
     C                   UPDATE    PEP01
     c                   endif                                                  cltid if <> '025'
     C*
     C                   ENDIF                                                  EPSTAT IFNE
     C*
     C     EPKEY         READE     PEP01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C* OVERRIDE THE NORMAL PREMIUM FIGURE WITH TOTAL OF NET
     C* PREMIUMS IF MINIMUM PREMIUM HAS NOT BEEN INVOKED.
     C*
     C     ELEMNP        IFNE      'Y'
     c     XXCLT#        ANDNE     '093'
     C     F1NETR        ANDEQ     'Y'
     C     ELPFDT        ANDGE     F1NETD
     C     XXCLT#        IFEQ      '102'
     C     ELFFL2        ANDEQ     *BLANKS
      * MINIMUM PREMIUM INVOKED, DO NOT OVERRIDE
     C                   ELSE
     C                   Z-ADD     XXTNET        XXNORM
     C                   Z-ADD     XXTNET        XXNET
     C                   ENDIF
     C                   ENDIF
     C*
     C                   ENDIF                                                  F1NETR IFEQ
     C*
      * Get Policy Fee
      /Free
       xxEPF = GetPolFee();
       If xxEPF <> 0;
          xxNet += xxEPF;
          xtNet += xxEPF;
          x1Net += xxEPF;
          x2Net += xxEPF;
          x3Net += xxEPF;
          x4Net += xxEPF;
          x5Net += xxEPF;
          x6Net += xxEPF;
          x7Net += xxEPF;
       Endif;
      /End-Free
     C*
     C*  UPDATE THE AGENT QUOTE FILE WITH THE ESTIMATED ANNUAL
     C*  NORMAL PREMIUM PLUS A FULL YEARS EXPENSE CONSTANT
     C*
     C*  COMPUTE EXPENSE CONSTANT
     C*
     C     ELEMNP        IFNE      'Y'
     C*
     C     XXDIV         IFEQ      XEDIV
     C     EXBEST        ANDEQ     'Y'
     C     EMSTRP        OREQ      'Y'
     C     EXBEST        ANDNE     'Y'
     C     F1EXDV        OREQ      'Y'
     C     XXSFUL        IFNE      'Y'
     C     ELCOFL        OREQ      'Y'
     C     XEPROR        MULT(H)   XXEXCO        XXEXCN           15 4
     C                   ELSE
     C                   Z-ADD(H)  XXEXCO        XXEXCN           15 4
     C                   ENDIF                                                  XXSFUL IFEQ
     C     XXEXCN        IFLT      XXMPEC
     C                   Z-ADD     XXMPEC        XXEXCN
     C                   END
     C                   ELSE
     C                   Z-ADD     0             XXEXCN
     C                   Z-ADD     0             XXEXCO
     C                   END
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXEXCN        XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXEXCN
     C*
     C                   END
      *
      * Calculates the aircraft surchage
      *
     C                   Z-ADD     *ZEROS        XXEARC           11 2
      *
     C     ELARCP        IFNE      *ZEROS
     C     ELARCP        MULT      XXNET         XXEARC
     C     XXEARC        DIV(H)    100           XXWK10
     C                   Z-ADD     XXWK10        XXEARC
     C                   ENDIF
      *
     C     ELARCA        IFGT      XXEARC
     C                   Z-ADD     ELARCA        XXEARC
     C                   ENDIF
     C*
     C* FIND # DAYS IN THE AIRCRAFT RE-INSURANCE PERIOD
     C*
     C     ELAREF        IFNE      ELPFDT
     C     ELAREF        ANDNE     *ZERO
     C     ELAREX        ORNE      ELPTDT
     C     ELAREX        ANDNE     *ZERO
     C*
     C     ELAREF        IFNE      *ZERO
     C                   Z-ADD     ELAREF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C*
     C     ELAREX        IFNE      *ZERO
     C                   Z-ADD     ELAREX        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPTDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C* PRORATES THE NUMBER OF DAYS
     C                   Z-ADD     QQDAYS        XXARDY            5 0
     C     PDAYS         IFNE      *ZERO
     C     XXARDY        DIV(H)    PDAYS         XXDPRO
     C     XXEARC        MULT(H)   XXDPRO        XXWK10
     C                   Z-ADD     XXWK10        XXEARC
     C                   ENDIF
      *
     C                   ENDIF                                                  ELAREF IFNE
      *
     C                   ADD       XXEARC        XXNET
     C                   ADD       XXEARC        XXHIGH
     C                   ADD       XXEARC        XSHIGH
     C                   ADD       XXEARC        XTNET
     C                   ADD       XXEARC        X1NET
     C                   ADD       XXEARC        X2NET
     C                   ADD       XXEARC        X3NET
     C                   ADD       XXEARC        X4NET
     C                   ADD       XXEARC        X5NET
     C                   ADD       XXEARC        X6NET
     C                   ADD       XXEARC        X7NET
     C*** begin add ***  06/15/23  **************************************
     C     DSKY1         CHAIN     PMP01                              60
     C                   If        *in60 = *off
     C                   Z-add     XXEARC        MPEARC
