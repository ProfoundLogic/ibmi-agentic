     C                   SELECT
     C     XXCLT#        WHENEQ    '129'
     C     BSON15        ANDEQ     'Y'
     C     L             ANDEQ     1
     C                   Z-ADD     EAPODT        L1PODT
     C                   Z-ADD     EATRDT        L1TRDT
     C                   MOVEL(P)  EAARCD        L1ARCD
