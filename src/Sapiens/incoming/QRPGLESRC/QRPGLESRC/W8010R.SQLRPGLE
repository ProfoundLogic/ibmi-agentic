      *
     C     XXCLT#        WHENEQ    '129'
     C     BSON15        ANDEQ     'Y'
     C     L             ANDNE     1
     C     L1PODT        ANDNE     0
     C     L1PODT        ANDEQ     EAPODT
     C     L1ARCD        ANDEQ     EAARCD
     C     L1PODT        ANDEQ     EAPODT
      *
     C                   Z-ADD     EAAMT         SVAMT
     C     EAKY5         CHAIN     PEA01                              60
     C     *IN60         DOWEQ     *OFF
     C     L1TRDT        IFEQ      EATRDT
     C     L1TIME        ANDEQ     EATIME
     C     L1ARCD        ANDEQ     EAARCD
     C                   ADD       SVAMT         EAAMT
     C                   UPDATE    PEA01
     C                   LEAVE
     C                   ENDIF
     C     EAKY5         READE     PEA01                                  60
     C                   ENDDO
      *
     C                   OTHER
      *
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
      *
     C                   ENDSL
      *
     C                   ENDIF                                                  AM,L IFNE 0
      *
      *  GET THE NEXT POSTING DATE.
      *
     C     ELBLFL        IFNE      'Y'
     C                   Z-ADD     1             DD
     C                   ENDIF                                                  ELBLFL IFNE
      *
      *
      * Check for schedule billing on the 15th?
      *
     C     BSON15        IFEQ      'Y'
     C     XXCLT#        ANDEQ     '129'
     C                   Z-ADD     15            DD
     C                   ENDIF
      *
     C                   ADD       1             MM
      *
     C     MM            IFGT      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF                                                  MM IFGT 12
      *
     C     L             IFEQ      1
     C                   Z-ADD     DD            SVDD              2 0
     C                   ELSE
     C                   Z-ADD     SVDD          DD
     C                   ENDIF
      *
     C     MM            IFEQ      2
     C     DD            ANDGE     29
     C                   MOVE      29            XXPFDT
     C                   Z-ADD     XXPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
      *
     C     SRERR         IFEQ      *ON
     C                   MOVE      28            XXPFDT
     C                   ENDIF                                                  SRERR IFEQ *ON
      *
     C                   ELSE
      *
     C     DD            IFGT      30
      *
     C     MM            IFEQ      4
     C     MM            OREQ      6
     C     MM            OREQ      9
     C     MM            OREQ      11
     C                   MOVE      30            XXPFDT
     C                   ENDIF                                                  MM IFEQ 4
      *
     C                   ENDIF                                                  DD IFGT 30
      *
     C                   ENDIF                                                  MM IFEQ 2
     C                   ENDDO                                                  1 DO 12 L
     C                   ELSE
      *
      * PROCESS AND BILL TO A/R WEEKLY INSTALLMENT FEES.
      *
     C                   Z-ADD     0             AM
      *
     C     XXAR          IFEQ      'Y'
     C*
     C* BILL WEEKLY INSTALLMENTS FEES INTO A/R, SKIPPING THE
     C* CURRENT/FIRST INSTALLMENT.
     C*
     C                   Z-ADD     0             L
     C*
     C     1             DO        53            U
     C*
     C     WKD(U)        IFGE      XXDATE
     C                   ADD       1             L
     C*
     C     L             IFNE      1
     C     U             ANDNE     1
     C*
     C                   Z-ADD     XXINSB        EAAMT
     C                   MOVE      WKD(U)        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     XXIFBL        EAARCD
     C                   MOVEL(P)  EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      TTTYPE        EAARTY
     C                   MOVE      TTDESC        EADESC
     C                   MOVE      TTCTYP        EACTYP
     C                   ENDIF                                                  *IN60 IFEQ
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF                                                  L IFNE 1
     C*
     C                   ENDIF                                                  WKD,U IFGE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C                   ENDIF                                                  XXAR IFEQ
     C*
     C                   ENDIF                                                  BSDOWK IFEQ
     C*
     C                   ENDIF                                                  XXINSB IFNE
     C*
     C* APPLY NEW BUSINESS PAYMENTS.
     C*
     C     XXAR          IFEQ      'Y'
     C* INITIALIZE BALANCE FIELDS
     C                   Z-ADD     0             XXNBBL           15 4
     C                   Z-ADD     0             XXECBL           15 4
     C                   Z-ADD     0             XXMDBL           15 4
     C                   Z-ADD     0             XXSFBL           15 4
     C                   Z-ADD     0             XXDDBL           15 4
     C                   Z-ADD     0             XXPBBL           15 4
     C                   Z-ADD     0             XX1BAL           15 4
     C                   Z-ADD     0             XX2BAL           15 4
     C                   Z-ADD     0             XX3BAL           15 4
     C                   Z-ADD     0             XX4BAL           15 4
     C                   Z-ADD     0             XX5BAL           15 4
     C                   Z-ADD     0             XX6BAL           15 4
     C                   Z-ADD     0             XX7BAL           15 4
     C                   Z-ADD     0             XXTBAL           15 4
     C                   Z-ADD     0             XXTDBL           15 4
     C                   MOVE      *BLANK        XXFRST            1
     C*
     C* ACCUMULATE A/R BALANCES
     C     EAKY2         CHAIN     PEA01                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C* NEW BUSINESS PAYMENT BALANCE
     C     EAARCD        IFEQ      F1NBPT
     C     EAARCD        OREQ      F1NBTR
     C                   ADD       EAAMT         XXNBBL
       //*** Begin Add *** 04/16/25 ***************************************
       In svLDA;
       chrHold=xxInv#;
       xxInv# = %EditC(EAninv:'X');
       Out svLDA;
       //*** End   Add *** 04/16/25 ***************************************
     C                   ENDIF                                                  EAARCD IFEQ
     C*
     C                   MOVEL(P)  EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C*
     C* EXPENSE CONSTANT BALANCE
     C     TTCTYP        IFEQ      'E'
     C     EAARTY        IFEQ      'B'
     C                   ADD       EAAMT         XXECBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'P'
     C                   SUB       EAAMT         XXECBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* STATE TAX DUE BALANCE
     C     TTCTYP        IFEQ      'T'
     C     EAARTY        IFEQ      'F'
     C     XXFRST        ANDEQ     *BLANK
     C                   MOVE      'N'           XXFRST
     C                   ADD       EAAMT         XXTBAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XXTBAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* TAX ON DEPOSIT DUE BALANCE
     C     TTCTYP        IFEQ      'D'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XXTDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XXTDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* MEMBERSHIP DUES BALANCE
     C     TTCTYP        IFEQ      'M'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XXMDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XXMDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* SAFETY FEES BALANCE
     C     TTCTYP        IFEQ      'S'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XXSFBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XXSFBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 1ST ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '1'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX1BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX1BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 2ND ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '2'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX2BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX2BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 3RD ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '3'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX3BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX3BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 4TH ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '4'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX4BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX4BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 5TH ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '5'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX5BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX5BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 6TH ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '6'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX6BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX6BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* 7TH ASSESSMENT BALANCE
     C     TTCTYP        IFEQ      '7'
     C     EAARTY        IFEQ      'F'
     C                   ADD       EAAMT         XX7BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'Q'
     C                   SUB       EAAMT         XX7BAL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* DEPOSIT DUE BALANCE
     C     TTCTYP        IFEQ      'D'
     C     EAARTY        IFEQ      'H'
     C                   ADD       EAAMT         XXDDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'I'
     C                   SUB       EAAMT         XXDDBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C* PREMIUM DUE BALANCE
     C     TTCTYP        IFEQ      'P'
     C     EAARTY        IFEQ      'B'
     C                   ADD       EAAMT         XXPBBL
     C                   ENDIF                                                  EAARTY IFEQ
     C     EAARTY        IFEQ      'P'
     C                   SUB       EAAMT         XXPBBL
     C                   ENDIF                                                  EAARTY IFEQ
     C                   ENDIF                                                  TTCTYP IFEQ
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C     EAKY2         READE     PEA01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C* WRITE OFFSETTING RECORD FOR NEW BUSINESS PAYMENT BALANCE
     C*
     C     XXNBBL        IFGT      *ZERO
     C*
     C                   Z-ADD     DBRRN         ELRRN
     C                   CALL      'WA055R'
     C                   PARM      'N'           ##CALL            1
     C                   PARM                    ELRRN             9 0
       //*** Begin Add *** 04/16/25 ***************************************
       In svLDA;
       xxInv# = chrHold;
       Out svLDA;
       //*** End   Add *** 04/16/25 ***************************************
     C                   ELSE
     C     QQQTE         IFNE      'Q'
     C                   Z-ADD     DBRRN         ELRRN
     C                   CALL      'WA059R'
     C                   PARM                    ELRRN             9 0
     C                   ENDIF                                                  QQQTE IFNE 'Q'
     C                   ENDIF                                                  XXNBBL IFGT
     C*
     C                   ENDIF                                                  XXAR IFEQ
     C*
     C                   ENDSR                                                  WRTAR
      *==============================================================
      * SRADR - SUBROUTINE TO CALCULATE THE AUDIT DISC REDUCTION FACTOR
      *==============================================================
     C     SRADR         BEGSR
     C                   Z-ADD     0             XXADR             5 4
     C                   ENDSR
      *==============================================================
      * SRINST- SUBROUTINE TO CALCULATE AND BILL AMOUNTS BY INSTALLMENT
      *==============================================================
     C     SRINST        BEGSR
     C*
     C     BSSEFL        IFEQ      'E'
     C*
     C                   Z-ADD     *ZERO         AM
     C     BSDOWK        IFEQ      *BLANKS
     C     BSFREQ        ANDNE     'T'
     C*
     C* BILL TO A/R FROM INSTALLMENT BUCKETS.
     C*
     C                   MOVE      ELBSDT        XXPFDT
     C                   MOVEL     XXDATE        YYMM2             5 0
     C                   Z-ADD     1             L                 2 0
     C                   Z-ADD     *ZEROS        XXAMT2
     C     1             DO        12            X                 3 0
     C     AB(X)         MULT(H)   ZZPREM        XXAMT
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT         XXWK10
     C                   Z-ADD     XXWK10        XXAMT
     C                   ENDIF                                                  EXRNDI IFEQ
     C                   ADD       XXAMT         XXAMT2           15 4
     C     YYMM          IFGE      YYMM2
     C                   Z-ADD     XXAMT2        AM(L)
     C                   ADD       1             L
     C                   Z-ADD     *ZEROS        XXAMT2
     C                   END
     C                   ADD       1             MM
     C     MM            IFGT      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   END                                                    MM > 12
     C                   END                                                    DO X 12
     C*
     C                   XFOOT     AM            XXCOMP           15 4
     C     XXCOMP        IFNE      ZZPREM
     C     ZZPREM        SUB       XXCOMP        XXDIF            15 4
     C                   Z-ADD     1             X
     C                   MOVE      '0'           *IN60
     C     X             DOWLE     12
     C     *IN60         ANDEQ     '0'
     C*
     C     AM(X)         IFNE      0
     C                   ADD       XXDIF         AM(X)
     C                   MOVE      '1'           *IN60
     C                   END
     C*
     C                   ADD       1             X
     C                   END
     C  N60              ADD       XXDIF         AM(1)
     C                   END
     C*
     C                   ELSE                                                   BSDOWK IFEQ
     C     BSFREQ        IFEQ      'T'
      *
      * PROCESS AND BILL TO A/R TWICE A MONTH BILLLING INSTALLMENTS.
      *
     C                   Z-ADD     0             AM
      *
     C     XXAR          IFEQ      'Y'
      *
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C*
     C                   MOVE      ELBSDT        XXPFDT
     C*
     C* CHECK FOR FIRST INSTALLMENT ON/AFTER BILLING START DATE.
     C*
     C     DD            IFEQ      1
     C     DD            OREQ      15
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C     DD            IFLT      15
     C                   Z-ADD     15            DD
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ELSE
     C*
      *
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ENDIF                                                  DD IFLT
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C                   Z-ADD     1             T                 3 0
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C* BUILD DATE ARRAY WITH EACH BI-MONTHLY INSTALLMENT DATE.
     C*
     C     XXPFDT        DOWLT     ELPTDT
     C*
     C     DD            IFEQ      1
     C                   Z-ADD     15            DD
     C                   ELSE
     C*
      *
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C     XXPFDT        IFLT      ELPTDT
     C                   ADD       1             T
     C                   Z-ADD     XXPFDT        WKD(T)
     C                   ENDIF                                                  XXPFDT IFLT
     C*
     C                   ENDDO                                                  XXPFDT DOWLT
     C*
     C                   ENDIF                                                  WKD,1 IFGE
     C*
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C*
     C     ZZPREM        DIV(H)    T             XXAMT
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT         XXWK10
     C                   Z-ADD     XXWK10        XXAMT
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT         WKA(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKA           XXCOMP           15 4
     C     XXCOMP        IFNE      ZZPREM
     C     ZZPREM        SUB       XXCOMP        XXDIF            15 4
     C                   ADD       XXDIF         WKA(1)
     C                   ENDIF
     C*
     C* BILL AMOUNTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXDATE
     C                   ADD       WKA(U)        XXAMT2
     C                   ELSE
     C*
     C     WKA(U)        ADD       XXAMT2        EAAMT
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     WKD(U)        XXDATE
     C                   ENDIF
     C*
     C                   MOVE      WKD(U)        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL     ZZDESC        EADESC
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C     XXDATE        IFLT      WKD(1)
     C                   Z-ADD     WKD(1)        XXDATE
     C                   ENDIF                                                  XXDATE IFLT
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     XXAMT2        EAAMT
     C                   Z-ADD     0             XXAMT2
     C*
     C* CHECK FOR FIRST BILLING DATE AFTER POSTING DATE.
     C*
     C                   MOVE      XXDATE        XXPFDT
     C     DD            IFEQ      1
     C     DD            OREQ      15
     C                   Z-ADD     XXPFDT        XXDATE
     C                   ELSE
     C*
     C     DD            IFLT      15
     C                   Z-ADD     15            DD
     C                   Z-ADD     XXPFDT        XXDATE
     C                   ELSE
     C*
      *
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   Z-ADD     XXPFDT        XXDATE
     C                   ENDIF                                                  DD IFLT
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL     ZZDESC        EADESC
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF                                                  XXAMT2 IFNE
     C*
     C                   ENDIF                                                  XXAR IFEQ
     C*
     C                   ELSE                                                   BSFREQ IFEQ
      *
      * PROCESS AND BILL TO A/R WEEKLY BILLING INSTALLMENTS.
      *
     C                   Z-ADD     0             AM
      *
     C     XXAR          IFEQ      'Y'
      *
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C* TOTAL DAYS IN POLICY
     C*
     C                   Z-ADD     QQDAYS        TDAYS             5 0
     C*
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         SRDTE
     C                   MOVE      *BLANK        SRSDAY
     C                   MOVE      *BLANK        SRLDAY
     C                   MOVE      *BLANK        SRERR
     C                   CALL      'SRDAY8'
     C                   PARM                    SRDTE             8 0          M/D/YY
     C                   PARM                    SRSDAY            4            Abbreviation
     C                   PARM                    SRLDAY            9            Full Day Name
     C                   PARM                    SRERR                          Error Flag
     C*
     C                   MOVEL     SRSDAY        XXDAY             2
     C                   Z-ADD     0             XXCNT             3 0
     C*
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER BILLING START DATE.
     C*
     C     XXDAY         IFEQ      BSDOWK
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C                   Z-ADD     0             X1                3 0
     C                   Z-ADD     0             X2                3 0
     C                   Z-ADD     1             T                 3 0
     C*
     C     XXDAY         LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X1
     C                   ENDIF                                                  *IN60
     C*
     C     BSDOWK        LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X2
     C                   ENDIF                                                  *IN60
     C*
     C     X2            SUB       X1            XXCNT
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      XXCNT         QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(1)
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXDAY IFEQ
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ENDIF
     C*
     C                   Z-ADD     1             T                 3 0
     C                   ADD       7             XXCNT
     C*
     C* BUILD DATE ARRAY WITH EACH WEEKLY INSTALLMENT DATE.
     C*
     C     XXCNT         DOWLT     TDAYS
     C*
     C                   ADD       1             T
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      7             QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(T)
     C                   ENDIF
     C*
     C                   ADD       7             XXCNT
     C                   ENDDO                                                  XXCNT IFLT
     C*
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C*
     C     ZZPREM        DIV(H)    T             XXAMT
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT         XXWK10
     C                   Z-ADD     XXWK10        XXAMT
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT         WKA(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKA           XXCOMP           15 4
     C     XXCOMP        IFNE      ZZPREM
     C     ZZPREM        SUB       XXCOMP        XXDIF            15 4
     C                   ADD       XXDIF         WKA(1)
     C                   ENDIF
     C*
     C* BILL WEEKLY INSTALLMENTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXDATE
     C                   ADD       WKA(U)        XXAMT2
     C                   ELSE
     C*
     C     WKA(U)        ADD       XXAMT2        EAAMT
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     WKD(U)        XXDATE
     C                   ENDIF
     C*
     C                   MOVE      WKD(U)        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL     ZZDESC        EADESC
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
     C*
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C     XXDATE        IFLT      WKD(1)
     C                   Z-ADD     WKD(1)        XXDATE
     C                   ENDIF                                                  XXDATE IFLT
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     XXAMT2        EAAMT
     C                   Z-ADD     0             XXAMT2
     C*
     C                   Z-ADD     XXDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         SRDTE
     C                   MOVE      *BLANK        SRSDAY
     C                   MOVE      *BLANK        SRLDAY
     C                   MOVE      *BLANK        SRERR
     C                   CALL      'SRDAY8'
     C                   PARM                    SRDTE             8 0          M/D/YY
     C                   PARM                    SRSDAY            4            Abbreviation
     C                   PARM                    SRLDAY            9            Full Day Name
     C                   PARM                    SRERR                          Error Flag
     C*
     C                   MOVEL     SRSDAY        XXDAY             2
     C*
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER POSTING DATE.
     C*
     C     XXDAY         IFNE      BSDOWK
     C*
     C                   Z-ADD     0             X1                3 0
     C                   Z-ADD     0             X2                3 0
     C                   Z-ADD     1             T                 3 0
     C*
     C     XXDAY         LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X1
     C                   ENDIF                                                  *IN60
     C*
     C     BSDOWK        LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X2
     C                   ENDIF                                                  *IN60
     C*
     C     X2            SUB       X1            XXCNT
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      XXCNT         QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXDATE
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXDAY IFEQ
     C*
     C                   MOVE      XXDATE        EAPODT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL     ZZDESC        EADESC
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   MOVE      *BLANK        EALATE
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C                   EXSR      GETINV
     C                   WRITE     PEA01
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF                                                  XXAMT2 IFNE
     C*
     C                   ENDIF                                                  XXAR IFEQ
     C*
     C                   ENDIF                                                  BSFREQ IFEQ
     C                   ENDIF                                                  BSDOWK IFEQ
     C                   ENDIF                                                  BSSEFL IFEQ
     C*
     C*
     C                   MOVE      TRYM          YYMM              5 0
      *
     C     1             DO        12            L
      *
     C     AM(L)         IFNE      *ZERO
      * If Self Reporting and Deposit is Zero, Write record anyway
     C     XXCLT#        OREQ      '129'
     C     AM(1)         ANDEQ     *ZERO
     C     AM(2)         ANDEQ     *ZERO
     C     BSSEFL        ANDEQ     'S'
     C     L             ANDEQ     1
      *
     C     L             IFEQ      1
     C                   MOVE      XXDATE        EAPODT
     C                   ELSE
     C                   MOVE      XXPFDT        EAPODT
     C                   ENDIF
     C                   Z-ADD     DSDATE        SRDTI
      *
     C                   CALL      'SRCVTDAT'    DTCYMD
      *
     C                   MOVEL     SRDTO         EATRDT
      *
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVEL     ZZDESC        EACTYP
     C                   MOVE      ZZCTYP        EADESC
      *
     C     BSSEFL        IFEQ      'E'
      *
     C                   MOVEL     ZZCODE        EAARCD
     C                   MOVEL     ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL     ZZDESC        EADESC
      *
     C                   ELSE
      *
     C     XXPRDP        IFEQ      0
      *
     C                   MOVEL     QQSRCD        EAARCD
     C                   MOVEL     XXTYPE        EAARTY
     C                   MOVEL     XXDESC        EADESC
     C                   MOVE      XXCTYP        EACTYP
      *
     C                   ELSE
      *
     C                   MOVEL     QQAJCD        EAARCD
     C                   MOVEL     XATYPE        EAARTY
     C                   MOVEL     XADESC        EADESC
     C                   MOVE      XACTYP        EACTYP
      *
     C                   ENDIF                                                  XXPRDP IFEQ 0
      *
     C                   ENDIF                                                  BSSEFL IFEQ E
      *
     C                   Z-ADD     AM(L)         EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
      *
     C                   CALL      'SRCVTDAT'    DTCYMD
      *
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   Z-ADD     0             EANINV
     C                   MOVE      *BLANK        EALATE
      *
     C                   SELECT
     C     XXCLT#        WHENEQ    '129'
     C     BSON15        ANDEQ     'Y'
     C     L             ANDEQ     1
     C                   Z-ADD     EAPODT        L1PODT
     C                   Z-ADD     EATRDT        L1TRDT
     C                   MOVEL(P)  ZZCODE        L1ARCD
     C                   Z-ADD     EATIME        L1TIME
     C                   MOVEL(P)  ZZTYPE        L1ARTY
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
      *
     C     XXCLT#        WHENEQ    '129'
     C     BSON15        ANDEQ     'Y'
     C     L             ANDNE     1
     C     L1PODT        ANDNE     0
     C     L1PODT        ANDEQ     EAPODT
     C     L1ARCD        ANDEQ     ZZCODE
     C     L1PODT        ANDEQ     EAPODT
      *
     C                   Z-ADD     EAAMT         SVAMT
     C     EAKY5         CHAIN     PEA01                              60
     C     *IN60         DOWEQ     *OFF
     C     L1TRDT        IFEQ      EATRDT
     C     L1TIME        ANDEQ     EATIME
     C     L1ARCD        ANDEQ     ZZCODE
     C                   ADD       SVAMT         EAAMT
     C                   UPDATE    PEA01
     C                   LEAVE
     C                   ENDIF
     C     EAKY5         READE     PEA01                                  60
     C                   ENDDO
      *
     C                   OTHER
      *
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
      *
     C                   ENDSL
      *
     C                   ENDIF                                                  AM,L IFNE 0
      *
     C     ELBLFL        IFNE      'Y'
     C                   Z-ADD     1             DD
     C                   ENDIF
      *
      *
      * Check for schedule billing on the 15th?
      *
     C     BSON15        IFEQ      'Y'
     C     XXCLT#        ANDEQ     '129'
     C                   Z-ADD     15            DD
     C                   ENDIF
      *
     C                   ADD       1             MM
      *
     C     MM            IFGT      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF                                                  MM IFGT 12
     C     L             IFEQ      1
     C                   Z-ADD     DD            SVDD              2 0
     C                   ELSE
     C                   Z-ADD     SVDD          DD
     C                   ENDIF
      *
     C     MM            IFEQ      2
     C     DD            ANDGE     29
     C                   MOVE      29            XXPFDT
     C                   Z-ADD     XXPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
      *
     C     SRERR         IFEQ      *ON
     C                   MOVE      28            XXPFDT
     C                   ENDIF                                                  SRERR IFEQ *ON
      *
     C                   ELSE
      *
     C     DD            IFGT      30
      *
     C     MM            IFEQ      4
     C     MM            OREQ      6
     C     MM            OREQ      9
     C     MM            OREQ      11
     C                   MOVE      30            XXPFDT
     C                   ENDIF                                                  MM IFEQ 4
      *
     C                   ENDIF                                                  DD IFGT 30
      *
     C                   ENDIF                                                  MM IFEQ 2
      *
     C                   ENDDO                                                  1 DO 12 L
     C                   ENDSR
      *
      *=============================================================
      * SRINSS - Calc assessments in installments for S/R policies
      *=============================================================
     C     SRINSS        BEGSR
      *
      *  Count number of months that will report on policy
      *
     C                   MOVE      ELPFDT        XXPFDT
     C                   MOVEL     ELPTDT        XXYMX             5 0
     C                   Z-ADD     0             MTHCNT            2 0
      *
     C     YYMM          DOWLT     XXYMX
     C                   ADD       1             MTHCNT            2 0
     C                   ADD       1             MM
      *
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
      *
     C                   ENDDO
      *
     C                   MOVE      '01'          DD
      *
     C     XXPFDT        IFLT      ELPTDT
     C                   ADD       1             MTHCNT
     C                   ENDIF
      *
     C     MTHCNT        IFEQ      0
     C                   Z-ADD     1             MTHCNT
     C                   ENDIF
      *****
      *
     C                   Z-ADD     0             XAAMT            11 2
     C                   Z-ADD     0             XAAMT2           11 2
     C                   Z-ADD     0             WKA
     C                   Z-ADD     1             L
     C     ZZPREM        DIV(H)    MTHCNT        XAAMT
     C                   Z-ADD     XXDATE        XXPFDT
     C                   Z-ADD     XXDATE        XXDAT2            7 0
     C                   MOVE      MD(MM)        XXDAT2
      *
     C     XXDAT2        IFGT      ELPTDT
     C                   Z-ADD     ELPTDT        XXDAT2
     C                   ENDIF
      *
     C                   MOVEL     XXDATE        YYMM2
     C                   Z-ADD     ELPFDT        XXPFDT
      *
     C     1             DO        MTHCNT        I1                2 0
      *
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XAAMT         XXWK10
     C                   Z-ADD     XXWK10        XAAMT
     C                   ENDIF                                                  EXRNDI IFEQ
     C                   ADD       XAAMT         XAAMT2
      *
     C     YYMM          IFGE      YYMM2
     C                   Z-ADD     XAAMT2        WKA(L)
     C                   ADD       1             L
     C                   Z-ADD     0             XAAMT2
     C                   ENDIF
      *
     C                   ADD       1             MM
      *
     C     MM            IFGT      12
     C                   ADD       1             YY
     C                   Z-ADD     1             MM
     C                   ENDIF
      *
     C                   ENDDO     1
      *
     C                   XFOOT     WKA           XXCOMP
      *
     C     XXCOMP        IFNE      ZZPREM
     C     ZZPREM        SUB       XXCOMP        XXDIF
     C                   ADD       XXDIF         WKA(1)
     C                   ENDIF
      *
     C                   MOVE      TRYM          YYMM
      *
     C     1             DO        MTHCNT        L
      *
     C     WKA(L)        IFNE      0
      *
     C     L             IFEQ      1
     C                   Z-ADD     XXDAT2        EAPODT
      *
     C                   ELSE
      *
     C                   Z-ADD     XXPFDT        EAPODT
     C                   MOVE      MD(MM)        EAPODT
      *
     C     MD(MM)        IFEQ      29
     C                   Z-ADD     EAPODT        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C     SRERR         IFEQ      '1'
     C                   MOVE      '28'          EAPODT
     C                   ENDIF
     C                   ENDIF
      *
     C     EAPODT        IFGT      ELPTDT
     C                   Z-ADD     ELPTDT        EAPODT
     C                   ENDIF                                                  EAPODT>EAPTDT
      *
     C                   ENDIF                                                  L=1
      *
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EATRDT
     C                   MOVEL(P)  ZZCODE        EAARCD
     C                   MOVEL(P)  ZZTYPE        EAARTY
     C                   MOVE      ZZCTYP        EACTYP
     C                   MOVEL(P)  ZZDESC        EADESC
     C                   Z-ADD     WKA(L)        EAAMT
     C                   MOVE      XXCO#         EACO#
     C                   MOVE      XXFND         EAFND
     C                   Z-ADD     XXFYR         EAFYR
     C                   MOVE      ELEMP#        EAEMP#
     C                   MOVE      ELDIV         EADIV
      *
     C     *IN71         IFEQ      *ON
     C                   MOVE      QQDIV         EARDIV
     C                   ELSE
     C                   Z-ADD     ELDIV         EARDIV
     C                   ENDIF                                                  *IN71 = *ON
      *
     C                   MOVE      'A'           EASTAT
     C                   MOVEL     Q1USER        EAUSER
     C                   MOVEL     Q1PGM         EAPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         EADT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        EATIME
     C                   MOVE      ' '           EAEDIT
     C                   Z-ADD     0             EABUL1
     C                   Z-ADD     0             EACHK#
     C                   Z-ADD     0             EANINV
     C                   MOVE      *BLANK        EALATE
     C*
       //*** Begin Add *** 06/12/24 **********************************
       isSkipAR = *Off;
       If isSRAs And (EActyp = '1' Or EActyp = '2' Or
                      EActyp = '3' Or EActyp = '4' Or
                      EActyp = '5' Or EActyp = '6' Or
                      EActyp = '7');
          isSkipAR = *On;
       EndIf;

       // Don't Write Assessments if SR Policy and Assessments
       If Not isSkipAR;
       //*** End   Add *** 06/12/24 **********************************
     C     XXAR          IFEQ      'Y'
     C                   EXSR      GETINV
     C                   WRITE     PEA01
     C                   ENDIF                                                  XXAR = Y
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
      *
     C                   ADD       1             MM
      *
     C     MM            IFGT      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF                                                  MM > 12
      *
     C                   ENDIF                                                  WKA,L <> 0
      *
     C                   ENDDO     1
      *
      * AAA
     C                   ENDSR                                                  SRINSS
      /free
       // *=========================================================================
       // *  GetCXDT - Get Employer Effective/Cancellation date
       // *=========================================================================
       Begsr GetCXDT;

          Chain(n) (ELCo#:ELEmp#:ELDiv:ELFnd) pem03;
          y1 = 5;

          Dow  ed3(y1) = 0 and (y1 > 1);
             y1 = y1 - 1;
          Enddo;

          yyefdt = ed3(y1);
          yycxdt = cd3(y1);

       Endsr;
      /end-free
      *
     C* Hard deleted WAIV subroutine, now in WBILLCSPEC
     C/COPY WBILLCSPEC
     C/COPY WADTTRKCSR
     C*
     C**************************************************************************
     OPEL01     E            PEL01E
     OPEP01     E            PEP01E
      *=============================================================
      * ApplyRateSplit - Check option flag to apply rate split
      *=============================================================
     p ApplyRateSplit  b
     d ApplyRateSplit  pi              n
     d   inState                      2a
     d   inDate                       7  0
      *
     d xxState         s              2a
     d xxSpltDt        s              7  0
     d xxPrcRate       s               n
      *
     C     rtky          klist
     C                   kfld                    xxco#
     C                   kfld                    xxfnd
     C                   kfld                    xxstate
     C                   kfld                    xxSpltDt          7 0
     C*
     C                   eval      xxPrcRate = *on
     C                   eval      xxState = inState
     C                   eval      xxSpltDt = inDate
     C     rtky          chain     prt0x
     C                   if        %found and rxopt = 'Y'
     C                   eval      xxPrcRate = *off
     C                   endif
     C*
     C                   return    xxPrcRate
     C*
     p ApplyRateSplit  e
      *=============================================================
      * GetCaPolFee - Returns policy fee to division with highest premium
      *  for state
      *=============================================================
     p GetPolFee       b
     d GetPolFee       pi                  like(ELepf)
     d index           s              5  0
     d xxHighPrem      s                   like(MPanpr)
     d xxHighDiv       s                   like(MPdiv)
      /Free
       If RRpfam = 0
        Or *in94 = *On Or *in95 = *On Or *in96 = *On Or *in97 = *On
        //*** Beg Chg ***05/10/24 **************************************
        //*** Or ELpfdt = intCxDate Or ELpfdt = ELptdt;
        Or ELpfdt <= intCxDate Or ELpfdt = ELptdt;
        //*** End Chg ***05/10/24 **************************************
           Return 0;
       Endif;
       Setll (ELco#:ELfnd:ELfyr:ELemp#) pmp01;
       Dou %Eof;
          Reade (ELco#:ELfnd:ELfyr:ELemp#) pmp01;
          If %Eof;
             Leave;
          EndIf;
          If MPst = xxSt and MPanpr > xxHighPrem;
             xxHighPrem = MPanpr;
             xxHighDiv = MPdiv;
          Endif;
       Enddo;
       If xxHighDiv = ELdiv;
          Return RRpfam;
       Else;
          Return 0;
       Endif;
      /End-Free
     p GetPolFee       e
      *=============================================================
      * prIncLmtBasis - Increased limit basis for assessment calculations
      *=============================================================
     p prIncLmtBasis   b
     d prIncLmtBasis   pi            15  4
     d   inTotLimits                 15  4
     d   inMinimumPrm                15  4
     d   inPrmIncLmts                15  4
     d   inILF                        1
     d   inAssessLvl                  1
     d   inJPrm                      15  4
     d   inEPrm                      11  0
     d   inSPrm                      15  4
     d   inDPrm                      15  4
     d   inXPrm                      15  4
     d   inAMNP                       1
     d   inATR                        1
     d   outFactor                    9  6 options(*nopass)
     d*
     d xxlmtFact       s              9  6 inz
     d outAssessPrm    s             15  4 inz
     c*
     C* Calculate factor field, If minimum premium invoked then use XXNET
     C*
     C                   eval      xxlmtFact=0
     C                   if        inAMNP = 'Y'
     C                   if        inMinimumPrm<>0
     C                   eval(h)   xxlmtFact = inTotLimits/inMinimumPrm
     C                   endif
     C                   else
     C                   if        inPrmIncLmts<>0
     C                   eval(h)   xxlmtFact = inTotLimits/inPrmIncLmts
     C                   endif
     C                   endif
     C*
     C                   if        inILF = 'W'
     C                   eval      xxlmtFact = 1 - xxlmtFact
     C                   endif                                                  inILF = 'W'
     C*
     C                   select
     C                   when      inAssessLvl = 'J'
     C                   eval(h)   outAssessPrm = inJPrm * xxlmtFact
     C                   when      inAssessLvl = 'E'
     C                   eval(h)   outAssessPrm = inEPrm * xxlmtFact
     C                   when      inAssessLvl = 'S'
     C                   eval(h)   outAssessPrm = inSPrm * xxlmtFact
     C                   when      inAssessLvl = 'D'
     C                   eval(h)   outAssessPrm = inDPrm * xxlmtFact
     C                   when      inAssessLvl = 'X'
      * Subtract terrorism and expense constant and apply the IL Factor
     c                   Eval(h)   outAssessPrm =
     c                              (inXPrm - x1PayR - x1EDTr - xxExCn)
     c                              * xxLmtFact
      * Add expense constant back into the assessment basis
     c                   Eval      outAssessPrm += xxExCn
      * Add terrorism into premium basis if flagged to do so
     c                   Select
     c                   When      inAtr = 'F'
     c                   Eval      outAssessPrm += x1PayR
     c                   When      inAtr = 'D'
     c                   Eval      outAssessPrm += x1EDTr
     c                   When      inAtr = 'B'
     c                   Eval      outAssessPrm += (x1EDTr + x1PayR)
     c                   Endsl
     C                   endsl
     C                   If        %parms >= 13
     C                   Eval      outFactor = xxLmtFact
     C                   Endif
     C*
     C                   return    outAssessPrm
     C*
     p prIncLmtBasis   e
      *=============================================================
      * ProcessImages - Process Images
      *=============================================================
     p ProcessImages   b
     d ProcessImages   pi
     d   inCo#                        3  0
     d   inFnd                        3  0
     d   inEmp#                       9  0
     d   inDiv                        5  0
     d   inFyr#                       3  0
     d   inInv#                      10  0
     d   inPoDt                       7  0

     * Spoolfile Cleanup
     d CallQteBillC    pr                  ExtPgm('WIQTEBILLC')
     d inspoolfile                   10

      *** Begin Add *** 12/19/23 *******************************************
     DQCMDEXC          pr                  ExtPgm('QCMDEXC')
     D command                             const like(strCommand)
     D length                        15  5 const
      *** End   Add *** 12/19/23 *******************************************

     * Premium Notice
     d CallW7321R      pr                  ExtPgm('W7321R')
     d inCompany                      3a
     d inGroup                        3a
     d inDate                         8a
     d inDate2                        8a
     d inAddu                         3a
     d inExdf                         1a
     d inCom1                         2a
     d inCom2                         2a
     d inCom3                         2a
     d inFyr                          3a
     d inEmployer#                    9a
     d inDivision                     5a
     d inFrdt                         8a
     d inTodt                         8a
     d inSrt1                         2a
     d inSrt2                         2a
     d inFrea                         2a
     d inToea                         2a
     d inFraa                         2a
     d inToaa                         2a
     d inFren                         9a
     d inToen                         9a
     d inFran                         5a
     d inToan                         5a
     d inQue                         10a
     d inMode                         1a
     d inDrmk                         5a
     d inIdys                         3a
     d inGrma                         1a
     d inMinb                         7a
     d inDep                          1a
     d inExp                          1a
     d inDres                         1a
     d inPbf                          1a
     d inMass                         1a
     d inSupbalp                      1a
     d inAll                          1a
     d inInvoice#                    10a

     d inCompany       s              3a
     d inGroup         s              3a
     d inDate          s              8a
     d inDate2         s              8a
     d inAddu          s              3a   Inz(' ')
     d inExdf          s              1a   Inz(' ')
     d inCom1          s              2a   Inz(' ')
     d inCom2          s              2a   Inz(' ')
     d inCom3          s              2a   Inz(' ')
     d inFyr           s              3a
     d inEmployer#     s              9a
     d inDivision      s              5a
     d inFrdt          s              8a   Inz('0000000')
     d inTodt          s              8a   Inz('0000000')
     d inSrt1          s              2a   Inz(' ')
     d inSrt2          s              2a   Inz(' ')
     d inFrea          s              2a   Inz(' ')
     d inToea          s              2a   Inz(' ')
     d inFraa          s              2a   Inz(' ')
     d inToaa          s              2a   Inz(' ')
     d inFren          s              9a   Inz('000000000')
     d inToen          s              9a   Inz('000000000')
     d inFran          s              5a   Inz('00000')
     d inToan          s              5a   Inz('00000')
     d inQue           s             10a   Inz('QPRINT')
     d inMode          s              1a   Inz('D')
     d inDrmk          s              5a   Inz(' ')
     d inIdys          s              3a   Inz('000')
     d inGrma          s              1a   Inz('Y')
     d inMinb          s              7a   Inz('0000000')
     d inDep           s              1a   Inz('Y')
     d inExp           s              1a   Inz('Y')
     d inDres          s              1a   Inz(' ')
     d inPbf           s              1a   Inz('P')
     d inMass          s              1a   Inz(' ')
     d inSupbalp       s              1a   Inz('Y')
     d inAll           s              1a   Inz(' ')
     d inInvoice#      s             10a

     D isScript        s              1n   inz
     D isUseXML        s              1n   inz
     D isUseSpoolOut   s              1n   inz
     d xxProcType      s            100a
     d processType     c                   const('Premium Notice')
     d xxSubmit        s              1n
     d xxMass          s              1a
     d spoolFile       s             10a   Inz('W7321O')
     d decDate8        s              8s 0
     d chrDate8        s              8a
     d imCount         s              5s 0
     d imagePath       s            255a
     d dartsSeq#       s              5  0
     d
      *** Begin Add *** 12/19/23 *******************************************
     DstrCommand       s            255
      *** End   Add *** 12/19/23 *******************************************

      /Free

       //* Clear out LDA for document name/path.
       In svLDA;
       //*** Beg Add ***** 01/18/24 ***************************************
       strSvLDA = svLDA;
       //*** End Add ***** 01/18/24 ***************************************
       Clear svLDA;
       Out svLDA;

       //* Generate premium notice for output.
       inCompany   = %EditC(inCo#:'X');
       inGroup     = %EditC(inFnd:'X');
       inEmployer# = %EditC(inEmp#:'X');
       inDivision  = %EditC(inDiv:'X');
       inFyr       = %EditC(inFyr#:'X');
       inInvoice#  = %EditC(inInv#:'X');

       decDate8 = 19000000 + inPoDt;
       chrDate8 = %EditC(decDate8:'X');
       inDate   = %Subst(chrDate8:5:4) + %Subst(chrDate8:1:4);
       inDate2  = inDate;

       isUseSpoolOut = UseSpoolOut(processType);
       isUseXML = UseScriptura(processType) or Use3rdXml(processType);

       If isUseXML;
          isScript = *on;
       Else;
          isScript = *off;
       Endif;

       //* Setup up data area for scriptura call in notice program.
       If isScript = 'Y';
          xxMass = ' ';
          xxProcType = processType;
          In svLDA;
          Clear svLDA;

          xxDart = 'N';
          xxRMCD = ' ';

          Out svLDA;

          xxSubmit = OutputWindow(xxProcType:xxMass:'Y':'M');
       Endif;

       //* Cleanup potential spoolfile.
       If isUseSpoolOut;
          CallQteBillC(spoolFile);
       Endif;

       //*** Begin Add *** 12/19/23 *******************************************
       strCommand = 'OVRPRTF FILE(spoolFile) HOLD(*YES)';
       Callp QCMDEXC(strCommand:%len(strCommand));
       //*** End   Add *** 12/19/23 *******************************************

       CallW7321R(inCompany:inGroup:inDate:inDate2:inAddu:inExdf:inCom1:
          inCom2:inCom3:inFyr:inEmployer#:inDivision:inFrdt:inTodt:inSrt1:
          inSrt2:inFrea:inToea:inFraa:inToaa:inFren:inToen:inFran:inToan:
          inQue:inMode:inDrmk:inIdys:inGrma:inMinb:inDep:inExp:inDres:
          inPbf:inMass:inSupBalp:inAll:inInvoice#);

       //*** Begin Add *** 12/19/23 *******************************************
       strCommand = 'DLTOVR FILE(spoolFile)';
       Callp QCMDEXC(strCommand:%len(strCommand));
       //*** End   Add *** 12/19/23 *******************************************

       //* Pull in document from local data area.
       In svLDA;
       Out svLDA;

       //* Create Entry in Image X-Ref File
       // Make sure the WXIMP record does not already exist.
       Exec Sql Select count(*) Into :imCount From WXIMP
                Where IMco#=:inCo# And IMfnd=:inFnd And IMemp#=:inEmp# And
                IMdiv=:inDiv And IMinv#=:inInv#;

       // Get the Image path
       imagePath = xxPath;

       // Get the darts sequence#
       dartsSeq# = 0;
       Exec Sql Select CMseq# Into :dartsSeq# From SDCMP
                Where CMuncn=:imagePath;

       // Nothing was found so write
       If imCount = 0;
          Exec Sql Insert into WXIMP
                   Values(:inCo#, :inFnd, :inEmp#, :inDiv, :inInv#,
                          'Quote Premium Notice', :inPoDt, :imagePath,
                          :dartsSeq# ,'A', :Q1user, :Q1pgm, :sysTm, :sysDt,
                          :Q1user, :Q1pgm, :sysTm, :sysDt);
       Else; // Update the existing record with the new image path
          Exec Sql Update WXIMP
                   Set IMuncn=:imagePath, IMseq#=:dartsSeq#,
                   IMtype='Quote Premium Notice', IMpodt=:inPoDt,
                   IMuser=:Q1user, IMpgm=:Q1pgm, IMtime=:sysTm, IMdt=:sysDt
                   Where IMco#=:inCo# And IMfnd=:inFnd And
                   IMemp#=:inEmp# And IMdiv=:inDiv And IMinv#=:inInv#;
       EndIf;

       If isUseSpoolOut;
          //* Cleanup spoolfile.
          CallQteBillC(spoolFile);
       Endif;

       //*** Beg Add ***** 01/18/24 ***************************************
       In *Lock *dtaara;
       svLDA = strSvLDA;
       Out *dtaara;
       //*** End Add ***** 01/18/24 ***************************************

      /End-Free

     p ProcessImages   e
      *=============================================================
      * ProcessImages - Process Images
      *=============================================================
     p ReportUnusedInvoices...
     p                 b
     d ReportUnusedInvoices...
     d                 pi
     d inCo#                          3  0
     d inGroup                        3  0
     d inEmp#                         9  0
     d inFinal                         n   Const

     d index           s              5  0
     d inJson          s          32000a   Varying Inz
     d invoice#        s             10  0
     D*** Begin Chg *** 09/12/23 *******************************************
     d*division        s              3  0
     d division        s              5  0
     D*** End   Chg *** 09/12/23 *******************************************

      /Free

       For index=1 To 9999;
       //*** begin chg ***  09/26/22  *********************************************
       //*****   If arrInvoice(index) = 9999999999999;
          If arrInvoice(index) = 999999999999999;
       //*** end chg *****  09/26/22  *********************************************
             If index > 1 And inFinal;
                FinalizeThirdPartyInvoicing(inCo#:inGroup);
             EndIf;
             Leave;
          Else;
          //*** begin chg ***  09/26/22  *********************************************
          //*****   division = %Dec(%Subst(%EditC(arrInvoice(index):'X'):1:3):3:0);
          //*****   invoice# = %Dec(%Subst(%EditC(arrInvoice(index):'X'):4:10):10:0);
             division = %Dec(%Subst(%EditC(arrInvoice(index):'X'):1:5):5:0);
             invoice# = %Dec(%Subst(%EditC(arrInvoice(index):'X'):6:10):10:0);
          //*** end chg *****  09/26/22  *********************************************
             inJson   = '{"type":"billing",' +
                          '"invoice":"'  + %EditC(invoice#:'X')  + '",' +
                          '"company":"'  + %EditC(inCo#:'X')     + '",' +
                          '"group":"'    + %EditC(inGroup:'X')   + '",' +
                          '"employer":"' + %EditC(inEmp#:'X')    + '",' +
                          '"division":"' + %EditC(division:'X')  + '",' +
                          '"active":"false","delete":"true"}';
             ThirdPartyInvoicing(inJson);
          EndIf;
       EndFor;

       Reset arrInvoice;

      /End-Free

     p ReportUnusedInvoices...
     p                 e
