     C                   Z-ADD     0             XX5AAM           11 2
     C                   Z-ADD     0             XX6AAM           11 2
     C                   Z-ADD     0             XX7AAM           11 2
     C                   MOVE      'F'           XXARTY
     C     EAKEY         CHAIN(N)  PEA01                              60
     C     *IN60         DOWEQ     '0'
     C*
     C                   MOVEL(P)  EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      '1'                                          1ST ASSESSMT
     C                   ADD       EAAMT         XX1AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '2'                                          2ND ASSESSMT
     C                   ADD       EAAMT         XX2AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '3'                                          3RD ASSESSMT
     C                   ADD       EAAMT         XX3AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '4'                                          4TH ASSESSMT
     C                   ADD       EAAMT         XX4AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '5'                                          5TH ASSESSMT
     C                   ADD       EAAMT         XX5AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '6'                                          6TH ASSESSMT
     C                   ADD       EAAMT         XX6AAM
     C                   ENDIF
     C     TTCTYP        IFEQ      '7'                                          7TH ASSESSMT
     C                   ADD       EAAMT         XX7AAM
     C                   ENDIF
     C                   ENDIF
     C*
     C     EAKEY         READE(N)  PEA01                                  60
     C                   ENDDO
     C*
     C* DO NOT UPDATE ASSESSMENT IF CA AND REVISED BILL AND THEY HAVE
     C* ALREADY BEEN BILLED ONCE THIS YEAR.
     C*
      /free
       // If 109, 132, or 136, xBilCa = *off if policy page is run
       //  For others, xBilca = *off if WCPOLS is submitted
       xBilCa = BillCA(xxCo#:xxFnd:xxEmp#:xsDiv:xxFyr);
      /end-free
     C*
     C*
     C* THIS IS NO LONGER REQUIRED AS ABOVE CODE TAKES CARE OF THIS
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX4AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL4AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX4THB        EL4AAM
     C                   ENDIF                                                  QQOVR IFEQ
      *
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX5AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL5AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX5THB        EL5AAM
     C                   ENDIF                                                  QQOVR IFEQ
      *
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX3AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL3AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX3RDB        EL3AAM
     C                   ENDIF                                                  QQOVR IFEQ
     C*
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX1AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL1AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX1STB        EL1AAM
     C                   ENDIF                                                  QQOVR IFEQ
     C*
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX2AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL2AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX2NDB        EL2AAM
     C                   ENDIF                                                  QQOVR IFEQ
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX6AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL6AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX6THB        EL6AAM
     C                   ENDIF                                                  QQOVR IFEQ
     C*
     C     QQOVR         IFEQ      'Y'
     C     XXST          ANDNE     'CA'
     C     XXFAF         OREQ      *BLANK
     C     XXST          ANDNE     'CA'
     C     XXST          OREQ      'CA'
     C     XBILCA        ANDEQ     *ON
     C     QQOVR         ORNE      'Y'
     C     XXST          ANDNE     'CA'
     C     XX7AAM        OREQ      *ZERO
     C     ELARSM        ANDNE     'Y'
     C     XXST          ANDNE     'CA'
     C     EL7AAM        OREQ      *ZERO
     C     ELARSM        ANDEQ     'Y'
     C     XXST          ANDNE     'CA'
     C                   Z-ADD     XX7THB        EL7AAM
     C                   ENDIF                                                  QQOVR IFEQ
     C                   Z-ADD     XXMFEE        ELMFAM
     C                   Z-ADD     XXSFEE        ELSFAM
     C                   Z-ADD     XXGOVC        ELGOVC
     C                   Z-ADD     SVHIGH        ELEMNA

      /free
       // Calculate and update dividend premium on last pass before
       //  inforce premium calc
       If *in94 = *off and *in95 = *off and *in96 = *off and
        *in97 = *off and *in98 = *off;
          ELDvpr = CalcDividend(ELCo#: ELFnd : ELEmp# : ELDiv : ELFyr);
       Endif;
      /end-free
     C*
     C* Calculate premium discount and/or schedule db/cr factor based
     C* on Gradient score if flagged to do so in stat rpt/rating, and
     C* processing within quote environment.  Trigger during SRDIS2 call.
     C*
      /free
       decScrCnt = *Zeros;
       Exec Sql
       Select count(*) into :decScrCnt from wigsp
        where gsco#=:elco# and gsfnd=:elfnd and gsemp#=:elemp# and gsfyr=:elfyr;
       If QQQte = 'Q' and *in95 = *on and ELscore <> 0 and ELscoreBp <> 'Y' and
        decScrCnt >0 and (RRdcl='F' or RRdcl='S');
          Clear xxdmst;
          If RRDsin = 'Y';
             xxdmst = RRSt;
          Endif;

          //* Total Modified premium on policy.
          totMod = ELEmpm;
          totAnl = ELEmpm;
          Setll (ELCo#:ELFnd:ELFyr:ELEmp#) pil01;
          Reade(n) (ELCo#:ELFnd:ELFyr:ELEmp#) pil01;
          Dow not %eof;
             If ILDiv <> ELDiv;
                totMod = totMod + ILEmpm;
                //* Check table with total premium if not independent, or with
                //* premium from just state if discount calculated independently.
                If xxdmst = '  ' or xxdmst = ILSt;
                   totAnl = totAnl + ILEmpm;
                Endif;
             Endif;
             Reade(n) (ELCo#:ELFnd:ELFyr:ELEmp#) pil01;
          Enddo;

          Select;
          When RRDCL = 'F';               //* Flat Discount Processing
             ELDisc = ' ';
            //* Set Premium Discount
             If totMod < RRMinFD or ELScore >= 1;
                ELASP3 = 0;
             Else;
                Setgt (ELCo#:ELFnd:xxSt:'PRMDISC':ELPfdt) pdt01;
                Readpe(n) (ELCo#:ELFnd:xxSt:'PRMDISC') pdt01;
                If (not %eof and DTETyp = 'Percent') or RRDspc <> 0;
                   If not %eof and DTETyp = 'Percent';
                      xxPct = %dec(DTEntry:9:6);
                   Else;
                      xxPct = RRDspc;
                   Endif;
                //* Allow maximum discount based on score.
                   If xxPct < ((1 - ELScore) * 100);
                      ELASP3 = xxPct;
                   Else;
                      ELASP3 = (1 - ELScore) * 100;
                   Endif;
                Endif;
             Endif;

             Select;
            //* Set Schedule Debit
             When totMod >= RRMinSD and ELScore > 1;
                If ELScore > RRDMax and RRDMax <> 0;
                   ELDBCR = RRDMax;
                Else;
                   ELDBCR = ELScore;
                Endif;

            //* Set Schedule Credit
             When totMod >= RRMinSC and ELScore < (1 - %dech((xxPct/100):5:2));
                //* Build factor from question values.
                ELDBCR = 1 - getScheduleRatingFactor(ELCo#:0:ELFyr:ELFnd:
                 ELEmp#:ELDiv);
                //* If available score factor is higher, use.
                If (%dech((xxPct/100):5:2) + ELScore) > ELDBCR;
                   ELDBCR = %dech(((xxPct/100) + ELScore):5:2);
                Endif;
                //* Do not exceed maximum allowed by state.
                If ELDBCR < RRCMax;
                   ELDBCR = RRCMax;
                Endif;

             Other;
                ELDBCR = 0;
             Endsl;

          When RRDCL = 'S';               //* Spread Discount Processing
             ELASP3 = 0;
             If ELScore >= 1;
                //* Clear Discount Code
                ELDisc = ' ';
                //* Set Schedule Debit
                ELDBCR = 0;
                If totMod >= RRMinSD;
                   If ELScore > RRDMax and RRDMax <> 0;
                      ELDBCR = RRDMax;
                   Else;
                      ELDBCR = ELScore;
                   Endif;
                Endif;

             Else;
                //* Repopulate Discount Code
                ELDisc = RRDisc;

                Setgt (ELCo#:ELFnd:xxSt:'PRMDISC':ELPfdt) pdt01;
                Readpe(n) (ELCo#:ELFnd:xxSt:'PRMDISC') pdt01;
                If not %eof and DTETyp = 'Code' and DTEntry <> ' ';
                   ELDisc = %trim(DTEntry);
                Endif;

                //* Set Schedule Credit
                ELDBCR = 0;
                If totMod >= RRMinSC;
                   //* Check table setup for type and Eff Date.
                   Exsr DiscTable;
                   If xxTP = 'A';
                      totDisc = 0;
                      totPrem = 0;
                      totDiscPrem = 0;

                      //* Determine division's share of total.
                      xxPct = %dech((ELEmpm / totAnl):12:9);
                      //* Apply score to modified premium for target premium.
                      totAnl = %dech((totAnl * ELScore):11:0);

                      Setll dskey pds03;
                      Reade dskey pds03;
                      Dow not %eof;
                         xxAmt = %dech((DSLmt * DSPct / 100):11:0);
                         totDiscPrem = totPrem + DSLmt - totDisc - xxAmt;
                         If totAnl <= totDiscPrem;
                            Leave;
                         Endif;
                         totDisc = totDisc + xxAmt;
                         totPrem = totPrem + DSLmt;
                         Reade dskey pds03;
                      Enddo;

                      //* Back into standard based on discount table values.
                      totStd = %dech(((totAnl / (1 - DSPct/100)) + (totDisc -
                       ((totPrem * DSPct/100) / (1 - DSPct/100)))):11:0);
                      //* Reduce standard to share owned by division.
                      totStd = %dech((totStd * xxPct):11:0);
                      //* Increase standard by discounts applied before discount
                      //* if stock discount is applied to deviated standard.
                      If RRDSPR = 'D';
                         If xxLrgD = 'Y';
                            If LDPLV1 = 'S';
                               totStd = totStd + ELEDCT;
                            Endif;
                            If LDPLV2 = 'S';
                               totStd = totStd + ELEDD2;
                            Endif;
                         Endif;
                         If RRASFL = 'S';
                            xxprem = %xfoot(ADL);
                            totStd = totStd - xxprem;
                         Endif;
                         If ELWVFL = 'S';
                            totStd = totStd - ELEWAV;
                         Endif;
                         If RRDV1L = 'S';
                            totStd = totStd + ELEDC2 + ELD1E2;
                         Endif;
                         If RRDV2L = 'S';
                            totStd = totStd + ELEDV2 + ELD2E2;
                         Endif;
                      Endif;
                      //* Increase standard by discounts applied before standard.
                      xxprem = %xfoot(ADL2);
                      totStd = totStd - xxprem - ELLoss;
                      If RRASFL = 'E';
                         xxprem = %xfoot(ADL);
                         totStd = totStd - xxprem;
                      Endif;
                      If xxLrgD = 'Y';
                         If LDPLV1 = 'E';
                            totStd = totStd + ELEDCT;
                         Endif;
                         If LDPLV2 = 'E';
                            totStd = totStd + ELEDD2;
                         Endif;
                      Else;
                         If RRRDPR = 'S';
                            totStd = totStd + ELEDCT + ELEDD2;
                         Endif;
                      Endif;
                      If ELWVFL = 'E';
                         totStd = totStd - ELEWAV;
                      Endif;
                      If RRDV1L = 'E';
                         totStd = totStd + ELEDC2 + ELD1E2;
                      Endif;
                      If RRDV2L = 'E';
                         totStd = totStd + ELEDV2 + ELD2E2;
                      Endif;

                      //* Build factor from question values.
                      ELDBCR = 1 - getScheduleRatingFactor(ELCo#:0:ELFyr:ELFnd:
                       ELEmp#:ELDiv);
                      //* If available score factor is higher, use.
                      If %dech((totStd / (ELEmpm - ELEDC1)):5:2) > ELDBCR;
                         ELDBCR = %dech((totStd / (ELEmpm - ELEDC1)):5:2);
                      Endif;
                      //* Do not exceed maximum allowed by state.
                      If ELDBCR < RRCMax;
                         ELDBCR = RRCMax;
                      Endif;

                   Endif;

                Endif;

             Endif;

          Endsl;

          //* Set Schedule DB/CR effective and expiration dates.
          If ELDBCR = 0;
             ELSDEF = 0;
             ELSDEX = 0;
          Else;
             ELSDEF = ELPFDT;
             ELSDEX = 0;
          Endif;

       Endif;
       decScrCnt = *Zeros;
       Exec Sql
       Select count(*) into :decScrCnt from wivsp
        where vsco#=:elco# and vsfnd=:elfnd and vsemp#=:elemp# and vsfyr=:elfyr;
       If QQQte = 'Q' and *in95 = *on and ELscore <> 0 and ELscoreBp <> 'Y' and
        decScrCnt > 0;
          Select;
          When ELscore > RRdMax and RRdMax <> 0;
             ELdbCr = RRdMax;
          When ELscore < RRcMax;
             ELdbCr = RRcMax;
          Other;
             ELDBCR = %dech((ELScore):5:2);
          Endsl;

          //* Set Schedule DB/CR effective and expiration dates.
          If ELDBCR = 0;
             ELSDEF = 0;
             ELSDEX = 0;
          Else;
             ELSDEF = ELPFDT;
             ELSDEX = 0;
          Endif;

       Endif;
      /end-free
     C*
     C* Calculate the large deductible percentage in order to reach
     C* the indicated percent of manual premium.
     C*
     C*** begin chg ***  06/14/23  *************************************
     C******             If        (ELManP <> 0 and ELEMNP <> 'Y'
     C******                       and Q2Call <> 'Y') and
     C******                       (*in97 = *on or QQOvr = 'Y')
     C                   If        ELManP <> 0 and
     C                             (*in97 = *on or calcManP = 'Y')
     C*** end chg *****  06/14/23  *************************************
     C*
     C* Establish target premium (manual premium x % / 100)
     C*
     C*** begin chg ***  06/14/23  *************************************
     C*****ELManP        Mult(h)   ELMapr        xxTargPrem       11 0
     C     ELManP        Mult(h)   MPMapr        xxTargPrem       11 0
     C*** end chg *****  06/14/23  *************************************
     C                   Div(h)    100           xxTargPrem
     C*
     C* Subtract out any line items which apply after large deduc discount
     C*
     C                   Sub       ELETer        xxTargPrem
     C                   Sub       ELEDTr        xxTargPrem
     C                   Sub       ELPRTF        xxTargPrem
     C                   Sub       ELHXMN        xxTargPrem
     C*** begin chg ***  06/14/23  *************************************
     C******             Sub       ELEARC        xxTargPrem
     C******             Sub       ELRPE1        xxTargPrem
     C******             Sub       ELRPE2        xxTargPrem
     C******             Sub       ELRPE3        xxTargPrem
     C                   Sub       MPEARC        xxTargPrem
     C                   Sub       MPRPE1        xxTargPrem
     C                   Sub       MPRPE2        xxTargPrem
     C                   Sub       MPRPE3        xxTargPrem
     C*** end chg *****  06/14/23  *************************************
     C*** begin add ***  06/14/23  ****************************************
     C*
     C* Remove more potential amounts for MI as its target base is modified
     C* premium instead of discounted premium.
     C*
     C                   If        xxst = 'MI'
     C*
     C                   Add       MPEDC3        xxTargPrem
     C                   Sub       MPELOS        xxTargPrem
     C*
     C                   If        RRASFL = 'D' or RRASFL = 'S'
     C                   Xfoot     ADL           xxwk10
     C                   Sub       xxwk10        xxTargPrem
     C                   Endif
     C*
     C                   If        ELWVFL = 'D' or ELWVFL = 'S'
     C                   Sub       MPEWAV        xxTargPrem
     C                   Endif
     C*
     C                   If        RRDV2L = 'D' or RRDV2L = 'S'
     C                   Add       MPEDV2        xxTargPrem
     C                   Add       MPD2E2        xxTargPrem
     C                   Endif
     C*
     C                   If        RRDV1L = 'D' or RRDV1L = 'S'
     C                   Add       MPEDC2        xxTargPrem
     C                   Add       MPD1E2        xxTargPrem
     C                   Endif
     C*
     C                   Endif                                                  If xxst = 'MI'
     C*** end add *****  06/14/23  ****************************************
     C*
     C* Subtract out any taxes/assessments which are indicated as included.
     C*
     C                   If        RRTaxM = 'Y'
     C                   Sub       ELTXDU        xxTargPrem
     C                   Endif
     C                   If        RR1stM = 'Y'
     C                   Sub       EL1aam        xxTargPrem
     C                   Endif
     C                   If        RR2ndM = 'Y'
     C                   Sub       EL2aam        xxTargPrem
     C                   Endif
     C                   If        RR3rdM = 'Y'
     C                   Sub       EL3aam        xxTargPrem
     C                   Endif
     C                   If        RR4thM = 'Y'
     C                   Sub       EL4aam        xxTargPrem
     C                   Endif
     C                   If        RR5thM = 'Y'
     C                   Sub       EL5aam        xxTargPrem
     C                   Endif
     C                   If        RR6thM = 'Y'
     C                   Sub       EL6aam        xxTargPrem
     C                   Endif
     C                   If        RR7thM = 'Y'
     C                   Sub       EL7aam        xxTargPrem
     C                   Endif
     C*
     C* Subtract target premium from premium before large deductible discount
     C* to arrive at estimated discount amount.
     C*
     C     xxTargBase    Sub       xxTargPrem    xxLrgDisc        11 0
     C*
     C* Calcualte large deductible percentage.
     C*
     C                   If        xxTargBase <> 0
     C     xxLrgDisc     Div(h)    xxTargBase    xxLrgDiscP       1411
     C                   Else
     C     LDPct1        Div       100           xxLrgDiscP
     C                   Endif
     C*** begin add ***  06/14/23  ****************************************
     C*
     C* Do not allow calculated percentage to be 100% or more, reduce to 99.9%
     C* for cases where the added amounts removed caused discount to go too high.
     C*
     C*** begin del ***  07/18/23  ***************************************
     C*****              If        xxLrgDiscP >= 1
     C*****              Z-add     .999          xxLrgDiscP
     C*****              Endif
     C*** end del *****  07/18/23  ***************************************
     C*** end add *****  06/14/23  ****************************************
     C*
     C* Update (or write if necessary) the large deductible file.
     C*
     C     ELKEY         Chain     PLD01                              60
     C                   If        *in60 = *off
     C     100           Mult(h)   xxLrgDiscP    LDPct1
     C                   Move      'D'           LDPlv1
     C*** begin add ***  06/14/23  ****************************************
     C                   If        xxst = 'MI'
     C                   Move      'E'           LDPlv1
     C                   Endif
     C*** end add *****  06/14/23  ****************************************
     C                   MOVEL     Q1USER        LDUSER
     C                   MOVEL     Q1PGM         LDPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         LDDT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        LDTIME
     C                   Update    pld01
     C                   Else
     C                   Clear                   pld01
     C                   Z-add     XXCo#         LDCo#
     C                   Z-add     XXFnd         LDFnd
     C                   Z-add     XXFyr         LDFyr
     C                   Z-add     XXEmp#        LDEmp#
     C                   Z-add     XXDiv         LDDiv
     C     100           Mult(h)   xxLrgDiscP    LDPct1
     C                   Move      'D'           LDPlv1
     C*** begin add ***  06/14/23  ****************************************
     C                   If        xxst = 'MI'
     C                   Move      'E'           LDPlv1
     C                   Endif
     C*** end add *****  06/14/23  ****************************************
     C                   Move      'G'           LDTyp1
     C                   Move      'C'           LDVrb1
     C                   Move      'C'           LDOcv1
     C                   Move      'ME'          LDR101
     C                   Z-add     ELPfdt        LDEfd1
     C                   Eval      LDDes1 = 'Large Deductible #1'
     C                   MOVEL     Q1USER        LDUSER
     C                   MOVEL     Q1USER        LDIUSR
     C                   MOVEL     Q1PGM         LDPGM
     C                   MOVEL     Q1PGM         LDIPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         LDDT
     C                   MOVEL     SRDTO         LDIDT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        LDTIME
     C                   Z-ADD     DSTIME        LDITIM
     C                   Write     pld01
     C                   Endif
     C*
     C                   Endif                                                  % of Manual Premium

     C     *IN97         IFEQ      *OFF
      *
     C                   MOVEL     Q1USER        ELUSER
     C                   MOVEL     Q1PGM         ELPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         ELDT
     C                   ADD       1             DSTIME
     C                   Z-ADD     DSTIME        ELTIME
     C                   Z-ADD     XXEARC        ELEARC
     C     QQPRT         IFEQ      '3'
     C     QQPRT         OREQ      '4'
     C     ELARSM        IFEQ      '@'
     C                   MOVE      *BLANK        ELARSM
     C                   ENDIF
     C                   ENDIF
      *
     C                   UPDATE    PEL01
     C                   ENDIF

       // Process for Unbilled Premium File
      /free
       If finalUpdate = *on and unBilPrmInst = *on;
          Open WXELL;
          Select;
          When qqPrt = '2';
             Delete (ELCo#: ELFnd : ELEmp# : ELDiv : ELFyr) pxel00;
             Write  pxel00;
          When qqPrt > '2';
             Delete (ELCo#: ELFnd : ELEmp# : ELDiv : ELFyr) pxel00;
          Endsl;
          Close WXELL;
       Endif;
      /end-free
