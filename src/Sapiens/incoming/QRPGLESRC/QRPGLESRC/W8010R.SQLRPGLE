     C*
     C*   DELETE RECORD OR UPDATE BILLING FLAG BILLING TRANS FILE
     C*
     C     QQOVR         IFNE      'Y'
     C     BLKEY2        CHAIN     PBL01                              60
     C     *IN60         IFEQ      '0'
     C     QQQTE         IFNE      'Q'
     C                   MOVE      *BLANK        BLFLG1
     C                   ENDIF
     C                   MOVE      *BLANK        BLSTEP
     C                   MOVEL     Q1USER        BLUSER
     C                   MOVEL     Q1PGM         BLPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         BLDT
     C                   Z-ADD     DSTIME        BLTIME
     C                   UPDATE    PBL01
     C                   END
     C                   END
     C                   Clear                   xxColt            1
      /free
       Open wmcol;
       Chain(n) (XXCO#:XXFND:XXEMP#) PCO00;
       If %found;
          xxColt = 'Y';
       Endif;
       Close wmcol;
      /end-free
