     C     ELEXP3        SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        EXA3(1)
     C                   ENDIF
     C*
      /free
       xxPrem = %xfoot(etr) + %xfoot(ntr);
       xxPrem = x1Payr - xxPrem;
       etr(1) = etr(1) + xxPrem;
       xxPrem = %xfoot(dtr);
       xxPrem = x1Edtr - xxPrem;
       dtr(1) = dtr(1) + xxPrem;
      /end-free
     C*
     C* POPULATE THE PREMIUM PERIODS FILE
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C*
     C     X             ADD       1             Z                 3 0
     C*
     C                   Z-ADD     PDAT(X)       XXFRDT
     C*
     C                   CLEAR                   PPP01
     C*
     C     PPKY          CHAIN     PPP01                              60
     C*
     C                   Z-ADD     XXCO#         PPCO#
     C                   Z-ADD     XXFND         PPFND
     C                   Z-ADD     XXEMP#        PPEMP#
     C                   Z-ADD     XXDIV         PPDIV
     C                   Z-ADD     XXFYR         PPFYR
     C                   Z-ADD     PDAT(X)       PPFRDT
     C                   Z-ADD     PDAT(Z)       PPTODT
     C                   MOVE      XXST          PPST
     C                   Z-ADD     PRO(X)        PPPROR
     C                   Z-ADD     MAN(X)        PPMAPR
     C                   Z-ADD     SUB(X)        PPESBJ
     C                   Z-ADD     MOD(X)        PPEMPM
     C                   Z-ADD     STD(X)        PPSTPR
     C                   Z-ADD     NOM(X)        PPENMP
     C                   Z-ADD     ANL(X)        PPANPR
     C                   Z-ADD     EHCN(X)       PPEHCN
     C                   Z-ADD     EDC1(X)       PPEDC1
     C                   Z-ADD     EDC2(X)       PPEDC2
     C                   Z-ADD     EDV2(X)       PPEDV2
     C                   Z-ADD     D1E2(X)       PPD1E2
     C                   Z-ADD     D2E2(X)       PPD2E2
     C                   Z-ADD     EDC3(X)       PPEDC3
     C                   Z-ADD     LM(X)         PPEIN1
     C                   Z-ADD     LM2(X)        PPEIN2
     C                   Z-ADD     EDCT(X)       PPEDCT
     C                   Z-ADD     EDD2(X)       PPEDD2
     C                   Z-ADD     EDCM(X)       PPEDCM
     C                   Z-ADD     EDCS(X)       PPEDCS
     C                   Z-ADD     EDC(X)        PPEDC
     C                   Z-ADD     WAV(X)        PPEWAV
     C                   Z-ADD     EPRM(X)       PPEXPA
     C                   Z-ADD     EXA1(X)       PPEXP1
     C                   Z-ADD     EXA2(X)       PPEXP2
     C                   Z-ADD     EXA3(X)       PPEXP3
     C                   Z-ADD     ETR(X)        PPETER
     C                   ADD       NTR(X)        PPETER
     C                   Z-ADD     DTR(X)        PPEDTR
      /free
       // Get Terrorism Rates
       Select;
       When hasDiffLCMs;
          If pay(x) <> 0;
             eval(h) PPterr = etr(x)/(pay(x) * .01);
             eval(h) PPdtrr = dtr(x)/(pay(x) * .01);
          Endif;
       Other;
          PPterr = pyTrt(x);
          PPdtrr = dmTrt(x);
       Endsl;
      /end-free
     C*
     C                   MOVEL     Q1USER        PPUSER
     C                   MOVEL     Q1PGM         PPPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         PPDT
     C                   Z-ADD     DSTIME        PPTIME
     C*
     C     *IN60         IFEQ      '0'
     C                   UPDATE    PPP01
     C                   ELSE
     C                   MOVEL     Q1USER        PPIUSR
     C                   MOVEL     Q1PGM         PPIPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         PPIDT
     C                   Z-ADD     DSTIME        PPITIM
     C                   WRITE     PPP01
     C                   ENDIF
     C*
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   ENDIF                                                  *IN94 IFEQ
     C*
     C                   MOVE      *BLANKS       Q2CALL
     C*
     C     EMSTRP        IFNE      'Y'
     C*
     C     QQESCD        IFNE      *BLANKS
     C     QQSRCD        ORNE      *BLANKS
     C     *IN97         OREQ      *OFF
     C*
     C                   MOVE      XXCO#         Q2CO#
     C                   MOVE      XXFND         Q2FND
     C                   MOVE      XXEMP#        Q2EMP#
     C                   MOVE      XXFYR         Q2FYR
     C                   MOVE      XXDIV         Q2DIV
     C                   MOVE      QQRNB         Q2RNB
     C*
     C*  ACCUMULATE PREMIUM ACROSS ALL DIVISIONS
     C*
     C                   CALL      'SRMDIV'
     C                   PARM                    Q2CO#             3
     C                   PARM                    Q2FND             3
     C                   PARM                    Q2FYR             3
     C                   PARM                    Q2EMP#            9
     C                   PARM                    Q2DIV             5
     C                   PARM                    Q2PREM           11 2
     C                   PARM      'E'           Q2TYPE            1
     C                   PARM      '1'           Q2CALL            1
     C                   PARM                    Q2RNB             1
     C*
     C     Q2CALL        IFEQ      'Y'
     C*
     C                   Z-ADD     0             XXMAN
     C                   Z-ADD     0             XXSTAN
     C                   Z-ADD     0             XXNORM
     C                   Z-ADD     0             XXNET
     C                   Z-ADD     0             XXNET1
     C                   Z-ADD     0             ELTXDU
     C                   Z-ADD     0             XXTXDU
     C                   Z-ADD     0             ELTXPR
     C                   Z-ADD     0             ELMAPR
     C                   Z-ADD     0             ELANPR
     C                   Z-ADD     0             ELLOSS
     C                   Z-ADD     0             ELSTPR
     C                   Z-ADD     0             ELENMP
     C                   Z-ADD     0             ELESBJ
     C                   Z-ADD     0             ELEMPM
     C                   Z-ADD     0             ELEIN1
     C                   Z-ADD     0             ELEIN2
     C                   Z-ADD     0             ELEFRS
     C                   Z-ADD     0             ELEDCR
     C                   Z-ADD     0             ELEDC
     C                   Z-ADD     0             ELRPE1
     C                   Z-ADD     0             ELRPE2
     C                   Z-ADD     0             ELRPE3
     C                   Z-ADD     0             ELEHCN
     C                   Z-ADD     0             ELEDC1
     C                   Z-Add     0             ELdev2BP
     C                   Z-Add     0             ELdev2AP
     C                   Z-Add     0             ELtdf
     C                   Z-ADD     0             ELEDC2
     C                   Z-ADD     0             ELEDV2
     C                   Z-ADD     0             ELEDC3
     C     EXBEXP        IFNE      'Y'
     C                   Z-ADD     0             ELPRTD
     C                   Z-ADD     0             ELPRTF
     C                   ELSE
     C     EXBEST        IFEQ      'Y'
     C     ELDIV         ANDEQ     XEDIV
     C                   Z-ADD     SVPRTD        ELPRTD
      *** Begin Chg *** 11/02/23 *******************************************
     C*****              Z-ADD     SVPRTD        ELPRTF
     C                   Z-ADD     SVPRTF        ELPRTF
      *** End   Chg *** 11/02/23 *******************************************
     C                   Z-ADD     SVPRTD        ELANPR
     C                   Z-ADD     SVPRTD        XXEXCN
     C                   ENDIF
     C                   ENDIF                                                  EXBEXP IFNE
      * Policy fee shows on top of minimum
     c                   Eval      xxNet  += xxEPF
     c                   Eval      xxNet1 += xxEPF
     c                   Eval      ELanpr += xxEPF
     C                   If        ELDiv = xldiv1
     C                   Z-ADD     XXMIN1        ELEIN1
     C                   Z-add     xxmin1        xxwk10
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDNE     'LA'
     C     XXST          ANDNE     'NJ'
     C     xxmin1        Mult(h)   elpror        xxwk10
     C                   Endif
     c                   Eval      xxNet  += xxwk10
     c                   Eval      xxNet1 += xxwk10
     c                   Eval      ELanpr += xxwk10
     c                   Eval      xxnorm += xxmin1
     c                   Eval      xxstan += xxmin1
     c                   Eval      ELenmp += xxmin1
     c                   Eval      ELstpr += xxmin1
     c                   Eval      ELempm += xxmin1
     c                   Eval      ELesbj += xxmin1
     C                   Endif
     C                   If        ELDiv = xldiv2
     C                   Z-ADD     XXMIN2        ELEIN2
     C                   Z-add     xxmin2        xxwk10
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDNE     'LA'
     C     XXST          ANDNE     'NJ'
     C     xxmin2        Mult(h)   elpror        xxwk10
     C                   Endif
     c                   Eval      xxNet  += xxwk10
     c                   Eval      xxNet1 += xxwk10
     c                   Eval      ELanpr += xxwk10
     c                   Eval      xxnorm += xxmin2
     c                   Eval      xxstan += xxmin2
     c                   Eval      ELenmp += xxmin2
     c                   Eval      ELstpr += xxmin2
     c                   Eval      ELempm += xxmin2
     c                   Eval      ELesbj += xxmin2
     C                   Endif
     C                   Z-ADD     *ZERO         ELEWAV
     C                   Z-ADD     *ZERO         ELEDCT
     C                   Z-ADD     *ZERO         ELEDD2
     C                   Z-ADD     *ZERO         ELADD2
     C                   Z-ADD     *ZERO         ELEDCM
     C                   Z-ADD     *ZERO         ELEDCS
     C                   Z-ADD     *ZERO         ELEXP1
     C                   Z-ADD     *ZERO         ELEXP2
     C                   Z-ADD     *ZERO         ELEXP3
     C                   Z-ADD     0             XXSUBJ
     C                   Z-ADD     0             XXEXPP
     C                   Z-ADD     0             XXDISP
     C     XXST          IFNE      'NJ'
     C     XXST          ANDNE     'NY'
     C                   Z-ADD     0             EL1APR
     C                   Z-ADD     0             EL1FPR
     C                   Z-ADD     0             EL2APR
     C                   Z-ADD     0             EL2FPR
     C                   Z-ADD     0             EL3APR
     C                   Z-ADD     0             EL3FPR
     C                   Z-ADD     0             EL4APR
     C                   Z-ADD     0             EL4FPR
     C                   Z-ADD     0             EL5APR
     C                   Z-ADD     0             EL5FPR
     C                   Z-ADD     0             EL6APR
     C                   Z-ADD     0             EL6FPR
     C                   Z-ADD     0             EL7APR
     C                   Z-ADD     0             EL7FPR
     C                   If        ELDiv = xldiv1
     c                   Eval      EL1apr += xxmin1
     c                   Eval      EL2apr += xxmin1
     c                   Eval      EL3apr += xxmin1
     c                   Eval      EL4apr += xxmin1
     c                   Eval      EL5apr += xxmin1
     c                   Eval      EL6apr += xxmin1
     c                   Eval      EL7apr += xxmin1
     C                   Endif
     C                   If        ELDiv = xldiv2
     c                   Eval      EL1apr += xxmin2
     c                   Eval      EL2apr += xxmin2
     c                   Eval      EL3apr += xxmin2
     c                   Eval      EL4apr += xxmin2
     c                   Eval      EL5apr += xxmin2
     c                   Eval      EL6apr += xxmin2
     c                   Eval      EL7apr += xxmin2
     C                   Endif
     C                   ENDIF                                                  XXST NE 'NJ'
     C                   ADD       X1PAYR        ELANPR
     C                   ADD       X1PAYR        XXNET1
     C                   ADD       X1EDTR        ELANPR
     C                   ADD       X1EDTR        XXNET1
     C*
     C                   ENDIF                                                  QQCALL IFEQ
     C*
     C                   ENDIF                                                  QQESCD IFNE
     C*
     C                   ENDIF                                                  EMSTRP IFNE
     C*
     C*  IF MINIMUM PREMIUM WE MUST GO BACK AND OVERRIDE
     C*
     C     ELEMNP        IFEQ      'Y'
     C                   If        ELDiv <> xldiv1
     C                   Z-add     xxmin1        xxwk10
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDNE     'LA'
     C     XXST          ANDNE     'NJ'
     C     xxmin1        Mult(h)   elpror        xxwk10
     C                   Endif
     C                   Sub       xxwk10        xxnorm
     C                   Sub       xxwk10        xxnet
     C                   Sub       xxwk10        xxnet1
     C                   Endif
     C                   If        ELDiv <> xldiv2
     C                   Z-add     xxmin2        xxwk10
     C     ELCOFL        IFEQ      'Y'
     C     XXST          ANDNE     'LA'
     C     XXST          ANDNE     'NJ'
     C     xxmin2        Mult(h)   elpror        xxwk10
     C                   Endif
     C                   Sub       xxwk10        xxnorm
     C                   Sub       xxwk10        xxnet
     C                   Sub       xxwk10        xxnet1
     C                   Endif
     C                   Z-ADD     XXNORM        ELMAPR
     C                   Z-ADD     XXNET         ELANPR
     C                   Z-ADD     XXNORM        ELSTPR
     C                   Z-ADD     XXNORM        ELENMP
     C                   Z-ADD     XXNORM        XXSTAN
     C                   Z-ADD     XXNORM        ELESBJ
     C                   Z-ADD     XXNORM        ELEMPM
     C                   If        ELDiv = xldiv1
     C                   Z-ADD     XXMIN1        ELEIN1
     C                   Endif
     C                   If        ELDiv = xldiv2
     C                   Z-ADD     XXMIN2        ELEIN2
     C                   Endif
     C                   Z-ADD     0             ELEFRS
     C                   Z-ADD     0             ELEDCR
     C                   Z-ADD     0             ELEDC
     C                   Z-ADD     0             ELLOSS
     C                   Z-ADD     0             ELEHCN
     C                   Z-ADD     0             ELEDC1
     C                   Z-ADD     0             ELEDC2
     C                   Z-ADD     0             ELEDV2
     C                   Z-ADD     0             ELEDC3
     C                   Z-ADD     0             ELRPE1
     C                   Z-ADD     0             ELRPE2
     C                   Z-ADD     0             ELRPE3
     C                   Z-ADD     0             ELPRTD
     C                   Z-ADD     0             ELPRTF
     C                   Z-ADD     *ZERO         ELEDCT
     C                   Z-ADD     *ZERO         ELEDD2
     C                   Z-ADD     *ZERO         ELADD2
     C                   Z-ADD     *ZERO         ELEDCM
     C                   Z-ADD     *ZERO         ELEDCS
     C                   Z-ADD     *ZERO         ELEXP1
     C                   Z-ADD     *ZERO         ELEXP2
     C                   Z-ADD     *ZERO         ELEXP3
     C                   Z-ADD     XXWVMN        ELEWAV
     C     XXMINE        IFEQ      'Y'
     C                   Z-ADD     SVPRTD        ELPRTD
      *** Begin Chg *** 11/02/23 *******************************************
     C*****              Z-ADD     SVPRTD        ELPRTF
     C                   Z-ADD     SVPRTF        ELPRTF
      *** End   Chg *** 11/02/23 *******************************************
     C                   Z-ADD     SVPRTD        XXEXCN
     C                   SUB       SVPRTD        ELMAPR                         MANUAL
     C                   SUB       SVPRTD        ELESBJ                         SUBJECT
     C                   SUB       SVPRTD        ELEMPM                         MODIFIED
     C                   SUB       SVPRTD        ELSTPR                         STANDARD
     C                   SUB       SVPRTD        ELENMP                         NORMAL
     C     EXBEST        IFEQ      'Y'
     C     ELDIV         ANDNE     XEDIV
     C                   Z-ADD     0             ELPRTD
     C                   Z-ADD     0             ELPRTF
     C                   Z-ADD     0             XXEXCN
     C                   SUB       SVPRTD        ELANPR                         ANNUAL
     C                   ENDIF
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C*  IF SPREAD DISCOUNT EXISTS, WE MUST USE THE MIN PREM AS THE
     C*  STANDARD
     C*
     C     *IN97         IFEQ      *OFF
     C     DSKY1         CHAIN     PDS02                              60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     XXNORM        DSSTPR
     C                   Z-ADD     0             DSEDIS
     C                   UPDATE    PDS02
     C                   END
     C                   ENDIF
     C                   END
     c*** begin add ***  11/16/22  ***************************************
     C     DSKY1         Chain(n)  PDS02
     C                   If        not %found
     C                   Clear                   DSEpct
     C                   Endif
     c*** end add *****  11/16/22  ***************************************
     C*
     C* CALCULATE STOCK DISCOUNT PERCENTAGE FOR IREP.
     C*
     C                   Z-ADD     0             ELDISP
     C     ELASP3        IFNE      *ZERO
     C                   Z-ADD     ELASP3        ELDISP
     C                   ELSE
     C     XNDISP        IFNE      *ZERO
     C                   Z-ADD     XNDISP        ELDISP
     C                   ELSE
     C*
     C     XXDSPR        IFNE      *ZERO
     C     ELEDC3        DIV(H)    XXDSPR        XZDISP            7 4
     C     XZDISP        MULT      100           ELDISP
     C                   If        ELDISP <> 0 and DSEPCT <> 0
     C                   Z-add     DSEPCT        ELDISP
     C                   Endif
     C                   ENDIF                                                  XXDSPR IFNE
     C                   ENDIF
     C                   ENDIF
     C*
     C* CALCULATE FEE AMOUNTS TO STORE IN EMPLOYER DETAIL
     C*
     C                   Z-ADD     *ZERO         XXMFEE
     C*
     C     XXMFBL        IFNE      *BLANK
     C     SVMFEE        ANDNE     *ZEROS
     C*
     C*   CALCULATE MEMBERSHIP FEE BILLED. PRORATE IT IF INDICATED.
     C*
     C     F1PMFL        IFEQ      'Y'                                          PRORATE MEMBER FEE
     C     PDAYS         ANDNE     FDAYS
     C                   Z-ADD     *ZEROS        XXDPRO
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         XXDPRO
     C                   ENDIF
     C     F1MFEE        MULT(H)   XXDPRO        XXMFEE
     C                   ELSE
     C                   Z-ADD     SVMFEE        XXMFEE                         BILL FULL MEMBER FEE
     C                   ENDIF                                                  IF F1PMFL = Y
     C*
     C                   ENDIF                                                  XXMFBL IFNE
     C*
     C                   Z-ADD     0             XXSFEE
     C*
     C     XXSFCD        IFNE      *BLANK
     C     ELSFPC        ANDNE     *ZEROS
     C     XXSFCD        ORNE      *BLANK
     C     ELSFMN        ANDNE     *ZEROS
     C*
     C*   CALCULATE SAFETY FEE BILLED.
     C*
     C                   Z-ADD     0             XXPREM           15 4
     C                   SELECT
     C     RRSFAP        WHENEQ    'J'
     C                   Z-ADD     XXSUBJ        XXPREM
     C     RRSFAP        WHENEQ    'E'
     C                   Z-ADD     XXEXPP        XXPREM
     C     RRSFAP        WHENEQ    'S'
     C                   Z-ADD     XXSTAN        XXPREM
     C     RRSFAP        WHENEQ    'D'
     C                   Z-ADD     XXDISP        XXPREM
     C     RRSFAP        WHENEQ    'X'
     C     RRSPFL        IFEQ      'Y'
     C     ELEMNP        IFNE      'Y'
     C                   Z-ADD     XXNET         XXPREM
     C                   ELSE
     C                   Z-ADD     XXNORM        XXPREM
     C                   ADD       XXPAYR        XXPREM
     C                   ADD       XXEDTR        XXPREM
     C                   ENDIF
     C                   ELSE
     C                   Z-ADD     XXNORM        XXPREM
     C                   ADD       XXPAYR        XXPREM
     C                   ADD       XXEDTR        XXPREM
     C     ELEMNP        IFNE      'Y'
     C                   ADD       XXEXCO        XXPREM
     C                   ENDIF
     C                   ENDIF
     C     RRSFAP        WHENEQ    'Y'
     C                   Z-ADD     XXNORM        XXPREM
     C                   ADD       XXPAYR        XXPREM
     C                   ADD       XXEDTR        XXPREM
     C     ELEMNP        IFEQ      'Y'
     C                   SUB       S1PRTD        XXPREM
     C                   ENDIF
     C                   ENDSL                                                  RRSFAP SELC
     C*
     C     ELSFPC        MULT      XXPREM        XXSFAM           15 4
     C     XXSFAM        DIV(H)    100           XXSFEE           11 0
     C*
     C     RRSPFL        IFEQ      'Y'
     C     RRSFAP        ANDNE     'X'
     C     RRSPFL        OREQ      'Y'
     C     ELEMNP        ANDEQ     'Y'
     C     XXSFEE        MULT(H)   ELPROR        XXSFEE
     C                   ENDIF                                                  RRSPFL IFEQ
     C*
     C     XXSFEE        IFLT      ELSFMN
     C                   Z-ADD     ELSFMN        XXSFEE
     C                   ENDIF                                                  XXSFEE IFLT
     C*
     C                   ENDIF                                                  XXSFCD IFNE
     C*
     C*
     C* BILL ASSESSMENTS TO DIVISION WITH HIGHEST MINIMUM PREMIUM IF
     C* FLAG IS SET ON, MINIMUM HAS BEEN INVOKED, AND NOT NJ.  NJ USES
     C* PRE-MINIMUM PREMIUM FIGURES ON MINIMUM PREMIUM ACCOUNTS.
     C*
     C     EXBASM        IFEQ      'Y'
     C     XXST          ANDNE     'NJ'
     C     XXST          ANDNE     'NY'
     C*
     C* MINIMUM PREMIUM HAS BEEN INVOKED.
     C*
     C     ELEMNP        IFEQ      'Y'
     C     Q2CALL        OREQ      'Y'
     C*
     C                   Z-ADD     0             EL1APR
     C                   Z-ADD     0             EL2APR
     C                   Z-ADD     0             EL3APR
     C                   Z-ADD     0             EL1FPR
     C                   Z-ADD     0             EL2FPR
     C                   Z-ADD     0             EL3FPR
     C                   Z-ADD     0             EL4APR
     C                   Z-ADD     0             EL5APR
     C                   Z-ADD     0             EL4FPR
     C                   Z-ADD     0             EL5FPR
     C                   Z-ADD     0             EL6APR
     C                   Z-ADD     0             EL6APR
     C                   Z-ADD     0             EL7FPR
     C                   Z-ADD     0             EL7FPR
     C*
     C* DIVISION WITH HIGHEST MINIMUM.
     C*
     C     XXDIV         IFEQ      XADIV
     C*
     C     RR1STP        IFNE      *ZERO
      *
     C     RR1ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(1)      EL1APR
     C                   ENDIF                                                  RR1ATD
      *
     C                   SELECT
     C                   WHEN      RR1ILF = 'I'
     C                   EVAL      EL1APR = XSILAM
     C                   WHEN      RR1ILF = 'W'
     C                   EVAL      EL1APR = XSHGH(1) - XSILAM
     C                   ENDSL
     C                   ENDIF
     C*
     C     RR2NDP        IFNE      *ZERO
      *
     C     RR2ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(2)      EL2APR
     C                   ENDIF                                                  RR2ATD
      *
     C                   SELECT
     C                   WHEN      RR2ILF = 'I'
     C                   EVAL      EL2APR = XSILAM
     C                   WHEN      RR2ILF = 'W'
     C                   EVAL      EL2APR = XSHGH(2) - XSILAM
     C                   ENDSL
     C                   ENDIF
     C*
     C     RR3RDP        IFNE      *ZERO
      *
     C     RR3ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(3)      EL3APR
     C                   ENDIF                                                  RR3ATD
      *
     C                   SELECT
     C                   WHEN      RR3ILF = 'I'
     C                   EVAL      EL3APR = XSILAM
     C                   WHEN      RR3ILF = 'W'
     C                   EVAL      EL3APR = XSHGH(3) - XSILAM
     C                   ENDSL
     C                   ENDIF
     C*
     C     RR4THP        IFNE      *ZERO
      *
     C     RR4ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(4)      EL4APR
     C                   ENDIF                                                  RR4ATD
      *
     C                   SELECT
     C                   WHEN      RR4ILF = 'I'
     C                   EVAL      EL4APR = XSILAM
     C                   WHEN      RR4ILF = 'W'
     C                   EVAL      EL4APR = XSHGH(4) - XSILAM
     C                   ENDSL
     C                   ENDIF
     C*
     C     RR5THP        IFNE      *ZERO
      *
     C     RR5ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(5)      EL5APR
     C                   ENDIF                                                  RR5ATD
      *
     C                   SELECT
     C                   WHEN      RR5ILF = 'I'
     C                   EVAL      EL5APR = XSILAM
     C                   WHEN      RR5ILF = 'W'
     C                   EVAL      EL5APR = XSHGH(5) - XSILAM
     C                   ENDSL
     C                   ENDIF
     C*
     C     RR6THP        IFNE      *ZERO
      *
     C     RR6ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(6)      EL6APR
     C                   ENDIF                                                  RR6ATD
     C                   SELECT
     C                   WHEN      RR6ILF = 'I'
     C                   EVAL      EL6APR = XSILAM
     C                   WHEN      RR6ILF = 'W'
     C                   EVAL      EL6APR = XSHGH(6) - XSILAM
     C                   ENDSL
      *
     C                   ENDIF                                                  RR6THP IFNE
     C*
     C     RR7THP        IFNE      *ZERO
      *
     C     RR7ATD        IFNE      'Y'
     C     XXDEDF        ORNE      'Y'
     C                   Z-ADD     XSHGH(7)      EL7APR
     C                   ENDIF                                                  RR7ATD
     C                   SELECT
     C                   WHEN      RR7ILF = 'I'
     C                   EVAL      EL7APR = XSILAM
     C                   WHEN      RR7ILF = 'W'
     C                   EVAL      EL7APR = XSHGH(7) - XSILAM
     C                   ENDSL
      *
     C                   ENDIF                                                  RR7THP IFNE
     C*
     C                   ENDIF                                                  XXDIV IFEQ
     C*
     C                   ENDIF                                                  ELEMNP IFEQ
     C*
     C                   ENDIF                                                  EXBASM IFEQ
     C                   Z-ADD     0             XX1STB
     C*
     C* SPECIAL CODE ADDED FOR FCC TO USE THE PFDT FOR RATING THE ASSESSMENTS
     C* SO THAT 106 YEAR POLICIES WILL GET THE MA DIA, BUT STILL ALLOW THE
     C* ANNIV DATE TO BE USED TO SPLIT THE PAYROLLS.
     C*
     C     XXST          IFEQ      'MA'
     C     PDAT(1)       ANDGE     1060101
     C     RDAT(1)       ANDLT     1060101
     C     XXCLT#        ANDEQ     '129'
     C                   Z-ADD     PDAT(1)       XXEFDT
     C                   ELSE
     C                   Z-ADD     FDAT(1)       XXEFDT
     C                   ENDIF
      /Free
       If xxst <> 'PA' and xxst <> 'NJ'
        and xxst <> 'NY';
      /End-Free
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR1ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX1CDE        IFNE      *BLANK
     C     RR1STP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 1ST ASSESSMENT BILLED.
     C*
     C*
     C     RR1STF        MULT      EL1FPR        XX1AMT           15 4
     C     RR1STP        MULT      EL1APR        XXPREM
     C                   ADD       XXPREM        XX1AMT
     C     XX1AMT        DIV(H)    100           XX1STB           11 0
     C                   Z-ADD     RR1STP        XXART1            5 3
     C*
     C* STORE THE AMOUNT OF THE NY STATE ASSESSMENT CHARGE.
     C*
     C     XXST          IFEQ      'NY'
     C     RR1STC        ANDEQ     932
     C     XXPREM        DIV(H)    100           XXWK10
     C                   Z-ADD     XXWK10        XX932A           11 2
     C     XX1STB        SUB       XXWK10        XX932F           11 2
     C                   ENDIF                                                  XXST IFEQ
     C*
     C                   ENDIF                                                  XX1CDE IFNE
     C*
     C                   Z-ADD     0             XX2NDB
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR2ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
     C     XX2CDE        IFNE      *BLANK
     C     RR2NDP        ANDNE     *ZEROS
     C     XXCHRG        ANDEQ     'Y'
     C*
     C*   CALCULATE 2ND ASSESSMENT BILLED.
     C*
     C*
     C*
     C* ADD THE AMOUNT OF THE NY STATE ASSESSMENT INTO PREMIUM BASIS.
     C*
     C     XXST          IFEQ      'NY'
     C     RR2NDC        ANDEQ     9749
     C                   ADD       XX932A        EL2APR
     C                   ADD       XX932F        EL2FPR
     C                   ENDIF                                                  XXST IFEQ
     C     RR2NDF        MULT      EL2FPR        XX2AMT           15 4
     C     RR2NDP        MULT      EL2APR        XXPREM
     C                   ADD       XXPREM        XX2AMT
     C     XX2AMT        DIV(H)    100           XX2NDB           11 0
     C                   Z-ADD     RR2NDP        XXART2            5 3
     C*
     C* STORE THE AMOUNT OF THE NY STATE ASSESSMENT CHARGE.
     C*
     C     XXST          IFEQ      'NY'
     C     RR2NDC        ANDEQ     932
     C     XXPREM        DIV(H)    100           XXWK10
     C                   Z-ADD     XXWK10        XX932A           11 2
     C     XX2NDB        SUB       XXWK10        XX932F           11 2
     C                   ENDIF                                                  XXST IFEQ
     C*
     C                   ENDIF                                                  XX2CDE IFNE
     C                   Z-ADD     0             XX3RDB
      *
     C                   MOVE      'Y'           XXCHRG            1
     C     XXDEDF        IFNE      'Y'
     C     RR3ATD        ANDEQ     'Y'
     C                   MOVE      *BLANK        XXCHRG
     C                   ENDIF
     C*
      **** Beg add ***** 09/15/22 **************************
