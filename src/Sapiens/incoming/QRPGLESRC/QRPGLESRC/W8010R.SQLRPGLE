     C                   Z-ADD     XXNET         XXNET1
     C                   Z-ADD     XXNET         XXNET1
     C                   ELSE
     C                   Z-ADD     XXNET         XXNET1
     C                   END
     C*
     C     EXBEXP        IFEQ      'Y'
     C     ELEMNP        IFEQ      'Y'
     C                   SUB       SVPRTD        XXNET1
     C                   MOVE      'Y'           XXMINE
     C                   ENDIF
     C                   ELSE
     C                   Z-ADD     0             SVPRTD
     C                   ENDIF
     C                   ADD       XXEXCN        XXNET
      /free
       Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pdv00;
       If %found and cltId = '111';
          xxNet1 = xxNet1 - DVamt;
       Endif;
      /end-free
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD(H)  XXNET         XXSAVE            9 0
     C                   Z-ADD     XXSAVE        XXNET
     C     XXHXMN        IFNE      *ZERO
     C                   ADD       XXHXMN        XXNET
     C                   ADD       XXHXMN        XXNET1
     C                   ADD       XXHXMN        XXHIGH
     C                   ADD       XXHXMN        XSHIGH
     C                   ADD       XXHXMN        XTNET
     C                   ADD       XXHXMN        X1NET
     C                   ADD       XXHXMN        X2NET
     C                   ADD       XXHXMN        X3NET
     C                   ADD       XXHXMN        X4NET
     C                   ADD       XXHXMN        X5NET
     C                   ADD       XXHXMN        X6NET
     C                   ADD       XXHXMN        X7NET
     C                   ENDIF
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXNET         MULT(H)   PRO(X)        ANL(X)
     C                   ELSE
     C                   Z-ADD(H)  NOM(X)        ANL(X)
     C                   ENDIF
     C*
     C                   ADD       1             X
     C                   ENDDO
     C*
     C     ELEMNP        IFNE      'Y'
     C                   ADD       XXEXCN        ANL(1)
     C                   ENDIF
     C     ELEMNP        IFEQ      'Y'
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C     XXNET         MULT(H)   PRO(X)        STN1(X)
     C     XXNET         MULT(H)   PRO(X)        STN2(X)
     C     XXNET         MULT(H)   PRO(X)        STN3(X)
     C     XXNET         MULT(H)   PRO(X)        STN4(X)
     C     XXNET         MULT(H)   PRO(X)        STN5(X)
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   XFOOT     STN1          XXPREM           15 4
     C*
     C     XXPREM        IFNE      XXNET
     C     XXNET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN1(1)
     C                   ADD       XXPREM        STN2(1)
     C                   ADD       XXPREM        STN3(1)
     C                   ADD       XXPREM        STN4(1)
     C                   ADD       XXPREM        STN5(1)
     C                   ENDIF
     C*
     C                   ELSE
     C*
     C                   Z-ADD     1             X
     C     RDAT(X)       DOWNE     *ZERO
     C*** begin del ***  01/28/25  *******************************************
     C******             If        xxst <> 'NJ'
     C*** end del *****  01/28/25  *******************************************
     C                   MULT(H)   ELPROR        STN1(X)
     C                   MULT(H)   ELPROR        STN2(X)
     C                   MULT(H)   ELPROR        STN3(X)
     C                   MULT(H)   ELPROR        STN4(X)
     C                   MULT(H)   ELPROR        STN5(X)
     C                   MULT(H)   ELPROR        STN6(X)
     C                   MULT(H)   ELPROR        STN7(X)
     C*** begin del ***  01/28/25  *******************************************
     C******             Endif
     C*** end del *****  01/28/25  *******************************************
     C     XXECST        IFNE      'XX'
     C     PRO(X)        MULT      XXEXCN        XXPREM
     C                   ADD       XXPREM        STN1(X)
     C                   ADD       XXPREM        STN2(X)
     C                   ADD       XXPREM        STN3(X)
     C                   ADD       XXPREM        STN4(X)
     C                   ADD       XXPREM        STN5(X)
     C                   ADD       XXPREM        STN6(X)
     C                   ADD       XXPREM        STN7(X)
     C                   ENDIF
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   XFOOT     STN1          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X1NET
     C     X1NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN1(1)
     C                   ENDIF
     C*
     C                   XFOOT     STN2          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X2NET
     C     X2NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN2(1)
     C                   ENDIF
     C*
     C                   XFOOT     STN3          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X3NET
     C     X3NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN3(1)
     C                   ENDIF
     C*
     C                   XFOOT     STN4          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X4NET
     C     X4NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN4(1)
     C                   ENDIF
      *
     C                   XFOOT     STN5          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X5NET
     C     X5NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN5(1)
     C                   ENDIF
     C                   XFOOT     STN6          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X6NET
     C     X6NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN6(1)
     C                   ENDIF
      *
     C                   XFOOT     STN7          XXPREM           15 4
     C*
     C     XXPREM        IFNE      X7NET
     C     X7NET         SUB       XXPREM        XXPREM
     C                   ADD       XXPREM        STN7(1)
     C                   ENDIF
     C                   ENDIF                                                  ELEMNP IFEQ
     C*
     C*  CALCULATE AND ADD TERRORISM RISK ACT AMOUNT TO ANNUAL PREMIUM.
     C*
     C                   Z-ADD     0             XXPAYR           15 4
     C                   Z-ADD     0             XXEDTR           15 4
     C*
     C                   Z-ADD     1             X
     C     FDAT(X)       DOWNE     *ZERO
     C*
     C                   Z-ADD     FDAT(X)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C*
     C* GET LCM
     C*
     C     RRTERR        IFNE      *ZERO
     C     RRDTRR        ORNE      *ZERO
     C                   MOVE(P)   ELCO#         QQCO#
     C                   MOVE(P)   ELFND         QQFND
     C                   MOVE(P)   ELRTCD        QQRTCD
     C                   MOVE(P)   RRTERC        QQCLAS
     C                   MOVE(P)   XXEFDT        QQEFDT
     C                   CALL      'SRLCM'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    QQRTCD            3
     C                   PARM                    QQCLAS            5
     C                   PARM                    QQEFDT            7
     C                   PARM      *BLANKS       QQLCM             5
      *
     C     QQLCM         IFNE      *BLANKS
     C                   MOVE      QQLCM         XXLCM             5 4
     C                   ENDIF
     C*
     C                   ENDIF                                                  RRTERR <> *ZERO

      /free
       // Add foreign terrorism to premium basis for assessment calc
       If %xfoot(pyTrt) > 0;
          xxPayr = xxPayr + etr(x);
          ert(x) = pyTrt(x);

          //* Do not prorate the terrorism arrays themselves
          eval(h) xxwk10 = etr(x)  * ELpror;
       //*** begin del ***  01/28/25  ********************************
       //****   If xxst = 'NJ';
       //****      eval(h) xxwk10 = etr(x);
       //****   Endif;
       //*** end del *****  01/28/25  ********************************
          stn1(x) = stn1(x) + xxwk10;
          stn2(x) = stn2(x) + xxwk10;
          stn3(x) = stn3(x) + xxwk10;
          stn4(x) = stn4(x) + xxwk10;
          stn5(x) = stn5(x) + xxwk10;
          stn6(x) = stn6(x) + xxwk10;
          stn7(x) = stn7(x) + xxwk10;
       Else;
          pay(x) = 0;
       Endif;
       // Add domestic terrorism to premium basis for assessment calc
       If %xfoot(dmTrt) > 0;
          xxEdTr = xxEdTr + dtr(x);
          drt(x) = dmTrt(x);

          //* Do not prorate the terrorism arrays themselves
          eval(h) xxwk10 = dtr(x)  * ELpror;
       //*** begin del ***  01/28/25  ********************************
       //****   If xxst = 'NJ';
       //****      eval(h) xxwk10 = dtr(x);
       //****   Endif;
       //*** end del *****  01/28/25  ********************************
          stn1(x) = stn1(x) + xxwk10;
          stn2(x) = stn2(x) + xxwk10;
          stn3(x) = stn3(x) + xxwk10;
          stn4(x) = stn4(x) + xxwk10;
          stn5(x) = stn5(x) + xxwk10;
          stn6(x) = stn6(x) + xxwk10;
          stn7(x) = stn7(x) + xxwk10;
       Endif;
       // Add non-payroll terrorism to premium basis for assessment calc
       If %xfoot(npTrt) > 0;
          xxPayr = xxPayr + ntr(x);

          //* Do not prorate the terrorism arrays themselves
          eval(h) xxwk10 = ntr(x)  * ELpror;
       //*** begin del ***  01/28/25  ********************************
       //****   If xxst = 'NJ';
       //****      eval(h) xxwk10 = ntr(x);
       //****   Endif;
       //*** end del *****  01/28/25  ********************************
          stn1(x) = stn1(x) + xxwk10;
          stn2(x) = stn2(x) + xxwk10;
          stn3(x) = stn3(x) + xxwk10;
          stn4(x) = stn4(x) + xxwk10;
          stn5(x) = stn5(x) + xxwk10;
          stn6(x) = stn6(x) + xxwk10;
          stn7(x) = stn7(x) + xxwk10;
       Endif;
      /end-free
     C*
     C                   ADD       1             X
     C                   ENDDO
     C*
     C                   Z-ADD(H)  XXPAYR        XXWK10
     C                   Z-ADD     XXWK10        XXPAYR
     C*
     C     ELPROR        MULT(H)   XXPAYR        XXWK10
     C                   ADD       XXWK10        XXNET
     C                   ADD       XXWK10        XXNET1
     C                   ADD       XXWK10        XTNET
     C                   ADD       XXWK10        X1NET
     C                   ADD       XXWK10        X2NET
     C                   ADD       XXWK10        X3NET
     C                   ADD       XXWK10        X4NET
     C                   ADD       XXWK10        X5NET
     C                   ADD       XXWK10        X6NET
     C                   ADD       XXWK10        X7NET
     C                   Z-ADD     1             XT                2 0
     C                   DOW       XT <= 7
     C                   EVAL      XSHGH(XT) = XSHIGH
     C                   EVAL      XT = XT + 1
     C                   ENDDO
     C*** FOR FIRST ASSESSMENT
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'F')
     C                   EVAL      XSHGH(1) = XSHGH(1) + XXWK10
     C                   ENDIF
     C*** FOR SECOND ASSESSMENT
     C                   IF        (RR2ATR = 'B') OR (RR2ATR = 'F')
     C                   EVAL      XSHGH(2) = XSHGH(2) + XXWK10
     C                   ENDIF
     C*** FOR THIRD ASSESSMENT
     C                   IF        (RR3ATR = 'B') OR (RR3ATR = 'F')
     C                   EVAL      XSHGH(3) = XSHGH(3) + XXWK10
     C                   ENDIF
     C*** FOR FOURTH ASSESSMENT
     C                   IF        (RR4ATR = 'B') OR (RR4ATR = 'F')
     C                   EVAL      XSHGH(4) = XSHGH(4) + XXWK10
     C                   ENDIF
     C*** FOR FIFTH ASSESSMENT
     C                   IF        (RR5ATR = 'B') OR (RR5ATR = 'F')
     C                   EVAL      XSHGH(5) = XSHGH(5) + XXWK10
     C                   ENDIF
     C*** FOR SIXTH ASSESSMENT
     C                   IF        (RR6ATR = 'B') OR (RR6ATR = 'F')
     C                   EVAL      XSHGH(6) = XSHGH(6) + XXWK10
     C                   ENDIF
     C*** FOR SEVENTH ASSESSMENT
     C                   IF        (RR7ATR = 'B') OR (RR7ATR = 'F')
     C                   EVAL      XSHGH(7) = XSHGH(7) + XXWK10
     C                   ENDIF
     C                   Z-ADD     XXWK10        X1PAYR           11 2
     C*
     C                   Z-ADD(H)  XXEDTR        XXWK10
     C                   Z-ADD     XXWK10        XXEDTR
     C*
     C     ELPROR        MULT(H)   XXEDTR        XXWK10
     C                   ADD       XXWK10        XXNET
     C                   ADD       XXWK10        XXNET1
     C                   ADD       XXWK10        XTNET
     C                   ADD       XXWK10        X1NET
     C                   ADD       XXWK10        X2NET
     C                   ADD       XXWK10        X3NET
     C                   ADD       XXWK10        X4NET
     C                   ADD       XXWK10        X5NET
     C                   ADD       XXWK10        X6NET
     C                   ADD       XXWK10        X7NET
     C*
     C*** FOR FIRST ASSESSMENT
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'D')
     C                   EVAL      XSHGH(1) = XSHGH(1) + XXWK10
     C                   ENDIF
     C*** FOR SECOND ASSESSMENT
     C                   IF        (RR2ATR = 'B') OR (RR2ATR = 'D')
     C                   EVAL      XSHGH(2) = XSHGH(2) + XXWK10
     C                   ENDIF
     C*** FOR THIRD ASSESSMENT
     C                   IF        (RR3ATR = 'B') OR (RR3ATR = 'D')
     C                   EVAL      XSHGH(3) = XSHGH(3) + XXWK10
     C                   ENDIF
     C*** FOR FOURTH ASSESSMENT
     C                   IF        (RR4ATR = 'B') OR (RR4ATR = 'D')
     C                   EVAL      XSHGH(4) = XSHGH(4) + XXWK10
     C                   ENDIF
     C*** FOR FIFTH ASSESSMENT
     C                   IF        (RR5ATR = 'B') OR (RR5ATR = 'D')
     C                   EVAL      XSHGH(5) = XSHGH(5) + XXWK10
     C                   ENDIF
     C*** FOR SIXTH ASSESSMENT
     C                   IF        (RR6ATR = 'B') OR (RR6ATR = 'D')
     C                   EVAL      XSHGH(6) = XSHGH(6) + XXWK10
     C                   ENDIF
     C*** FOR SEVENTH ASSESSMENT
     C                   IF        (RR7ATR = 'B') OR (RR7ATR = 'D')
     C                   EVAL      XSHGH(7) = XSHGH(7) + XXWK10
     C                   ENDIF
     C*
     C                   Z-ADD     XXWK10        X1EDTR           11 2
     C*
     C                   Z-ADD     ELPFDT        XXEFDT
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C*
     C*
     C* CALCULATE STATE TAX DUE
     C*
     C*
     C*
     C     ELEMNP        IFEQ      'Y'
     C     XXNET         MULT      RRTXPC        XXTXDU            9 0
     C                   MULT(H)   .01           XXTXDU
     C                   Z-ADD     XXNET         XXTXPR            9 0
     C                   ELSE
     C     XTNET         MULT      RRTXPC        XXTXDU            9 0
     C                   MULT(H)   .01           XXTXDU
     C                   Z-ADD     XTNET         XXTXPR            9 0
     C                   ENDIF
     C*
     C*  UPDATE EMPLOYER DETAIL FILE
     C*
      *
      * SAVE OFF DIFFERENCE BETWEEN MINIMUM PREM AND (NORM PREM + EXP CONSTANT)
      * APPLY TO NY STATE ASSESSMENT
      *
     C                   CLEAR                   XXNYCH
     C     ELEMNP        IFEQ      'Y'
     C     XXHIGH        SUB(H)    XXWKCM        XXNYCH           11 0
     C                   ENDIF
     C*
     C                   MOVE      ELFAF         XXFAF             1
     C     QQOVR         IFEQ      'Y'
     C                   MOVE      'R'           ELFAF
     C                   ELSE
     C                   MOVE      'E'           ELFAF
     C                   END
     C*
     C                   Z-ADD     0             XX932A           11 2
     C                   Z-ADD     0             XX932F           11 2
      /Free
       A932 = *zeros;
       F932 = *zeros;
      /End-Free
     C*
     C                   Z-ADD     0             EL1FPR
     C                   Z-ADD     0             EL2FPR
     C                   XFOOT(H)  LM            XXLM1            11 0
     C                   XFOOT(H)  LM2           XXLM2            11 0
     C                   EVAL      XXTEIN = XXLM1 + XXLM2
     C     XXLM1         IFGT      XXMIN1
     C                   Z-ADD     0             XXLM1
     C                   ENDIF
     C     XXLM2         IFGT      XXMIN2
     C                   Z-ADD     0             XXLM2
     C                   ENDIF
     C*
     C* SPECIAL CODE ADDED FOR FCC TO USE THE PFDT FOR RATING THE ASSESSMENTS
     C* SO THAT 106 YEAR POLICIES WILL GET THE MA DIA, BUT STILL ALLOW THE
     C* ANNIV DATE TO BE USED TO SPLIT THE PAYROLLS.
     C*
     C     XXST          IFEQ      'MA'
     C     PDAT(1)       ANDGE     1060101
     C     RDAT(1)       ANDLT     1060101
     C     XXCLT#        ANDEQ     '129'
     C                   Z-ADD     PDAT(1)       XXEFDT
     C                   ELSE
     C                   Z-ADD     FDAT(1)       XXEFDT
     C                   ENDIF
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY1         READPE    PRR01                                  60
     C                   Z-ADD     0             EL1APR
     C     RR1STP        IFNE      *ZERO
     C     ELEMNP        IFEQ      'Y'
     C     XXST          ANDNE     'NJ'
     C     XXST          ANDNE     'NY'
     C     ELEMNP        OREQ      'Y'
     C     XXST          ANDEQ     'NJ'
     C     RR1STL        ANDEQ     'X'
     C                   Z-ADD     XXNET         EL1APR
     C*** FIRST ASSESSMENT
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'F')
     C                   SUB       X1PAYR        EL1APR
     C                   ENDIF
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'D')
     C                   SUB       X1EDTR        EL1APR
     C                   ENDIF
     C                   ELSE
     C                   SELECT
     C     RR1STL        WHENEQ    'J'
     C                   Z-ADD     X1SUBJ        EL1APR
     C     RR1STL        WHENEQ    'E'
     C                   Z-ADD     X1EXPP        EL1APR
     C     RR1STL        WHENEQ    'S'
     C                   Z-ADD     X1STAN        EL1APR
     C     XXST          IFEQ      'NY'
     C     ELDIV         ANDEQ     XSDIV
     C                   ADD       XXNYCH        EL1APR
     C                   ENDIF
     C     RR1STL        WHENEQ    'D'
     C                   Z-ADD     X1DISP        EL1APR
     C     XXST          IFEQ      'NY'
     C     ELDIV         ANDEQ     XSDIV
     C                   ADD       XXNYCH        EL1APR
     C                   ENDIF
     C     RR1STL        WHENEQ    'X'
     C                   Z-ADD     X1NET         EL1APR
     C     XXST          IFEQ      'NY'
     C     ELDIV         ANDEQ     XSDIV
     C                   ADD       XXNYCH        EL1APR
     C                   ENDIF
     C*** FIRST ASSESSMENT
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'F')
     C                   SUB       X1PAYR        EL1APR
     C                   ENDIF
     C                   IF        (RR1ATR <> 'B') AND (RR1ATR <> 'D')
     C                   SUB       X1EDTR        EL1APR
     C                   ENDIF
     C                   ENDSL                                                  RR1STL SELC
     C     XXST          IFEQ      'NJ'
     C                   SUB       XXLM1         EL1APR
     C                   SUB       XXLM2         EL1APR
     C                   ENDIF
     C*
     C* FOR PA, ADD DEDUCTIBE DISCOUNT BACK INTO PREMIUM IF NECESSARY.
     C*
     C     XXST          IFEQ      'PA'
     C     RR1IDD        ANDNE     'Y'
     C*
     C     RRRDPR        IFEQ      'M'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     RRRDPR        OREQ      'S'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     XXLRGD        ANDNE     'Y'
     C*
     C     LDPLV1        OREQ      'M'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'J'
     C     RR1STL        ANDNE     'J'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'E'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'S'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     RR1STL        ANDNE     'S'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     LDPLV1        OREQ      'D'
     C     RR1STL        ANDNE     'J'
     C     RR1STL        ANDNE     'E'
     C     RR1STL        ANDNE     'S'
     C     RR1STL        ANDNE     'D'
     C     XXLRGD        ANDEQ     'Y'
     C*
     C     RR1STL        Ifne      'X'
     C                   ADD       XXDIST        EL1APR
     C                   ADD       XXD2ST        EL1APR
     C                   Else
     C     ELPROR        MULT(H)   xxDist        XXWK10
     C                   ADD       xxwk10        EL1APR
     C     ELPROR        MULT(H)   xxD2st        XXWK10
     C                   ADD       xxwk10        EL1APR
     C                   Endif
     C*
     C                   ENDIF                                                  RRRDPR IFEQ
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C                   IF        RR1ILF <> ' '
     C*
     C*** begin add ***  11/12/24  ******************************************
     C                   Z-add     xxlprm1       xxlprm
     C*** end add *****  11/12/24  ******************************************
     C                   EVAL(H)   EL1APR = prIncLmtBasis(XXTEIN:XXNET:XXLPRM:
     C                                      RR1ILF:RR1STL:X1SUBJ:X1EXPP:X1STAN:
     C                                      X1DISP:X1NET:ELEMNP:RR1ATR)
     C*
     C                   ENDIF                                                  RR1ILF <> ' '
     C     RR1STL        IFNE      'X'
     C     ELPROR        MULT(H)   EL1APR        XXWK10
     C*** begin chg ***  01/28/25  *******************************************
     C******             If        xxst <> 'NJ'
     C******             Z-ADD     XXWK10        EL1APR
     C******             Endif
     C                   Z-ADD     XXWK10        EL1APR
     C*** end chg *****  01/28/25  *******************************************
     C*** FIRST ASSESSMENT
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'F')
     C                   ADD       X1PAYR        EL1APR
     C                   ENDIF
     C                   IF        (RR1ATR = 'B') OR (RR1ATR = 'D')
     C                   ADD       X1EDTR        EL1APR
     C                   ENDIF
     C                   ENDIF                                                  RR1STL IFNE
     C     XXST          IFEQ      'NJ'
     C     RR1ILF        ANDEQ     ' '
     C                   ADD       XXLM1         EL1APR
     C                   ADD       XXLM2         EL1APR
     C                   ENDIF
     C                   ENDIF                                                  ELEMNP IFEQ
     C     RR1STF        IFNE      *ZERO
     C     ELEMNP        ANDNE     'Y'
     c     RR1xfc        OrEq      'Y'
     c     ELeMnP        AndNE     'Y'
     C     XXFPCT        MULT(H)   EL1APR        XXWK10
     C                   Z-ADD     XXWK10        EL1FPR
     C                   SUB       EL1FPR        EL1APR
