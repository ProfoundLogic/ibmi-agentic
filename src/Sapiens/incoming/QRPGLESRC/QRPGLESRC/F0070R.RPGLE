     C**********           MOVEA'00000000'*IN,50
     C**********           MOVEA'00'      *IN,58
     C**********           MOVE '0'       *IN26
     C*
     C**********           DO   10        Y       50
     C********** TC,Y      IFNE *ZERO
     C*
     C********** SD,Y      IFGT *ZERO
     C*
     C********** Y         ADD  49        Y1      20
     C*
     C*
     C********** 10000.01  MULT SD,Y      XWKDT1  60
     C********** XWKDT1    IFLT XXACDT
     C**********           MOVE '1'       *IN26
     C**********           MOVE '1'       *IN,Y1
     C**********           END
     C*
     C**********           END
     C*
     C**********           END
     C**********           END
     C********** *IN26     CABEQ'1'       STRT
     C*** BEGIN ADD*** 01/05/95 ************************************************
     C*
     C* SERVICE DATE MUST BE FOR A VALID FEE SCHEDULE DATE
     C*
     C**********           MOVEA'00000000'*IN,50
     C**********           MOVEA'00'      *IN,58
     C**********           MOVE '0'       *IN37
     C*
     C**********           DO   10        Y       50
     C********** TC,Y      IFNE *ZERO
     C*
     C********** SD,Y      IFGT *ZERO
     C*
     C********** Y         ADD  49        Y1      20
     C*
     C* Determine what type of Provider we are working with (Specialty Code)
     C* SCR02
     C*
     C********** HXRECF    IFEQ 'SCR02'
     C**********           MOVE 'P'       XXATYP           Default Health Prov
     C********** SCSPCD    IFEQ 'ASC'
     C********** STOVR     ANDEQ'FL'
     C**********           MOVE 'A'       XXATYP           Ambulatory Surg Ctr
     C**********           END                             END EQ 'ASC'
     C********** SCSPCD    IFEQ 'ASC'
     C********** STOVR     ANDEQ'AL'
     C**********           MOVE 'A'       XXATYP           Ambulatory Surg Ctr
     C**********           END                             END EQ 'ASC'
     C********** SCSPCD    IFEQ 'DIA'
     C********** STOVR     ANDEQ'AL'
     C**********           MOVE 'I'       XXATYP           Diagnostic Center
     C**********           END                             END EQ 'DIA'
     C********** XXDFLG    IFEQ 'Y'
     C**********           MOVE 'D'       XXATYP           DENTAL PROCESSING
     C**********           END                             END EQ 'D'
     C*
     C**********           ELSE                             ELSE SCR02
     C* SCR04
     C********** HXRECF    IFEQ 'SCR04'
     C**********           MOVE 'H'       XXATYP           Default Hosp Prov
     C**********           ELSE
     C********** HXRECF    IFEQ 'SCRRX'
     C**********           MOVE 'X'       XXATYP
     C**********           END
     C**********           END                              END SCR04
     C**********           END                              END SCR02
     C********** SD,Y      MULT 10000.01  XWK6Z
     C*
     C********** RUKY1     SETGTPRU01
     C**********           READPPRU01                    60
