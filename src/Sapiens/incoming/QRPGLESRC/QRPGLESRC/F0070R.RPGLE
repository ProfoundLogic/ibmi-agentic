     C********** RUST      ORNE STOVR
     C********** RUATYP    ORNE XXATYP
     C**********           MOVE '1'       *IN37
     C**********           MOVE '1'       *IN,Y1
     C**********           END
     C*
     C**********           END
     C*
     C**********           END
     C**********           END
     C********** *IN37     CABEQ'1'       STRT
     C*
     C*** END ADD *** 1/05/95 **************************************************
     C*
     C* =================================================================== *
     C* * * I/O FLAG (PLACE OF SERVICE) MUST BE VALID
     C**********           MOVEA'00000000'*IN,50
     C**********           MOVEA'00'      *IN,58
     C**********           MOVE '0'       *IN32
     C*
     C**********           DO   10        Y       50
     C********** TC,Y      IFNE *ZERO
     C*
     C********** Y         ADD  49        Y1      20
     C*
     C*** BEGIN CHG *** 04/08/93 **************************************
     C********** IO,Y      IFNE '1'
