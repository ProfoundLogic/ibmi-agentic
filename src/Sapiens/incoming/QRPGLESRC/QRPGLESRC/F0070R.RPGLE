     C*
     C                   END
     C                   END
     C                   END                                                        END DO 10
     C     *IN34         CABEQ     '1'           STRT
     C*
     C* =================================================================== *
     C* GET DESCRIPTION OF NDC CODE, IF FOUND
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C*
     C                   DO        10            X
     C*
     C*** BEGIN ADD *** 04/28/92 **********************************
     C                   MOVE      *BLANKS       XXNDC
     C                   MOVEL     ND(X)         XXNDC
     C*
     C     RXKEY         CHAIN     PRX01                              60
     C     *IN60         IFEQ      '0'
     C     RXCO#         ANDEQ     SCCO#
     C     RXNDC         ANDEQ     XXNDC                                        CHG 04/28/92
     C     RXSTAT        IFNE      'I'
     C                   MOVEL     RXNAME        XXDESC
     C                   MOVEL     XXDESC        DS(X)
     C                   MOVE      RXMEAS        DS(X)
     C                   Z-ADD     1             T                 2 0
     C     RXPTYP        LOOKUP    PTYP(T)                                60
     C     *IN60         IFEQ      '1'
