     C**************************************************************************
     C* L O A D 0 4  - SUBROUTINE TO LOAD SCR04 SCREEN WITH DATA               *
     C**************************************************************************
     C     LOAD04        BEGSR
     C*
     C                   MOVE      '0'           *IN13
     C                   MOVE      '0'           *IN32
     C*
     C* Position Cursor flag - used to check if the 1st subfile RRN
     C* of the current page needs to be saved.
     C*
     C                   MOVE      'Y'           PCFL
     C*
     C* LOAD THE SUBFILE SCREEN WITH UPTO 12 LINES
     C*
     C                   DO        8             Z                 5 0
     C*
     C     RRN4          IFLT      50
     C*
     C* INZSRIALIZE SUBFILE
     C*
     C                   MOVE      *ZEROS        SCSVDT
     C                   MOVE      *BLANKS       SCPOS
     C                   MOVE      *BLANKS       SCTOS
     C                   MOVE      *BLANKS       SCCPT4
     C                   MOVE      *ZEROS        SCRVCD
     C                   MOVE      *ZEROS        SCUNTS
     C                   MOVE      *BLANKS       SCDES
     C                   MOVE      *ZEROS        SCDX
     C                   MOVE      *ZEROS        SCPX
     C                   MOVE      *ZEROS        SCTOTC
     C                   MOVE      *BLANKS       SCPART
     C                   ADD       1             RRN4
     C*
     C* Save 1st subfile RRN of the current page
     C*
     C     PCFL          IFEQ      'Y'
     C                   Z-ADD     RRN4          XXRRN4
     C                   MOVE      'N'           PCFL
     C                   END
     C*
     C                   WRITE     SCR04S
     C                   ELSE
     C                   MOVE      '1'           *IN13
     C                   END
     C                   END
     C*
     C* TO POSITION SCREEN AND CURSOR
     C*
     C                   Z-ADD     XXRRN4        #@$4
     C*
     C                   ENDSR
     C*** END ADD *** 05/18/95 *************************************************
      *====================================================================*
