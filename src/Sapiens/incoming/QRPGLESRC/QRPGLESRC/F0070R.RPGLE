     C**********           END                             ENDDO 30 D
     C     MGKY1         READE     PMG01                                  62
     C                   ENDDO                                                  *IN62 EQ OFF
     C                   MOVE      HL62          *IN62
     C*** END CHG *** 04/28/98 ****************************************
     C*
     C                   MOVE      XHDSEQ        XXDSEQ
     C*
     C                   ENDSR
     C*****************************************************************
     C***** END ADD ******** POSSIBLE DUPLICATE CLAIMS *** 07/23/90 ***
     C*** BEGIN ADD *** 04/28/92 ************************************
     C*****************************************************************
     C* POSSIBLE DUP CLAIM (ADD TO WORK FILE) FOR SERVICE CODES       *
     C*****************************************************************
     C     DUPCL4        BEGSR
     C*
     C                   MOVE      XXDSEQ        XHDSEQ            5 0
     C                   MOVE      SCCO#         DUCO#
     C                   MOVE      SCSUB#        DUSUB#
     C                   MOVE      SCFND         DUFND
     C                   MOVE      SCYR          DUFYR
     C                   MOVE      SCCASE        DUCASE
     C                   MOVE      SCSS#         DUSS#
     C                   Z-ADD     SCACDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUACDT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUTRDT
     C                   MOVE      Q1USER        DUUSER
     C                   MOVE      Q1PGM         DUPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUDT
     C                   Z-ADD     DSTIME        DUTIME
     C                   MOVE      'N'           DUFLG1
     C*** BEGIN ADD *** 12/06/93 **************************************
     C                   MOVE      *BLANKS       DUFLG2
     C                   MOVE      *BLANKS       DUFLG3
     C                   MOVE      *BLANKS       DUNDC
     C*** END ADD *** 12/06/93 ****************************************
     C*
     C*** BEGIN DEL *** 04/28/98 **************************************
     C**********           Z-ADD1         D       50
     C**********           DO   30        D
     C**********
     C********** ER,D      IFEQ '03'
     C********** ER,D      OREQ '3 '
     C********** ER,D      OREQ ' 3'
     C**********           MOVE QS,D      XXDSEQ
     C*** END DEL *** 04/28/98 ****************************************
     C*** BEGIN ADD *** 04/28/98 **************************************
     C*
     C** HOLD ENTERING VALUE OF INDICATOR 62
     C*
     C     *IN62         IFEQ      *OFF
     C                   MOVE      '0'           HL62              1
     C                   ELSE
     C                   MOVE      '1'           HL62
     C                   ENDIF
     C*
     C                   Z-ADD     CADCS#        HDDCS#
     C*
     C     MGKY          SETLL     PMG01
     C     MGKY1         READE     PMG01                                  62
     C     *IN62         DOWEQ     *OFF
     C                   MOVE      MGMSG#        HLMSG#            5
     C     HLMSG#        IFEQ      '00003'
     C                   MOVE      MGDSEQ        XXDSEQ
     C*** END ADD *** 04/28/98 ****************************************
     C*
     C     CAKYF         CHAIN     PCA0F                              60
     C  N60              EXCEPT    RLSCAF
     C*
     C                   MOVE      *BLANKS       DUSVCD
     C                   MOVE      *BLANKS       DUCODE
     C                   MOVE      *BLANKS       DUUNTS
     C                   MOVEL     CASVCD        DUSVCD
     C                   MOVEL     CACPT4        DUCODE
     C                   MOVEL     CAUNTS        DUUNTS
     C*
     C                   MOVE      CAFEIN        DUFEIN
     C                   MOVE      CAMOD         DUMOD
     C                   MOVEL     CAPMOD        DUPMOD
     C                   Z-ADD     XXDSEQ        DUDSEQ
     C                   Z-ADD     CAFDAT        DUFDAT
     C                   Z-ADD     CATDAT        DUTDAT
     C                   Z-ADD     CATOTC        DUAMT
     C                   Z-ADD     *ZEROS        DUEOB#
     C*
     C     DUKY2A        CHAIN     PDU02                              60
     C     *IN60         IFEQ      '1'
     C                   WRITE     PDU02
     C                   ELSE
     C                   EXCEPT    RDU02
     C                   END                                                    ENDIF *IN60
     C*
     C*  READ DETAIL CHARGE FILE, ADD TO POSSIBLE DUPLICATE (PD) FILE
     C*  ANY MATCHING HISTORY DUPLICATES NOT ALREADY IN PD FILE
     C*
     C     CAKY4         CHAIN     PCA04                              60        SERVICE CODE
     C  N60              EXCEPT    RLSCA4
     C*
     C     *IN60         DOWEQ     '0'
     C     CADSEQ        IFNE      XXDSEQ
     C                   Z-ADD     CADSEQ        DUDSEQ
     C*
     C*  REPORT PGM WILL HAVE TO GET CARDAT BECAUSE PCA04/PCA06 DONT B RING
     C*  CARDAT INTO PROGRAM
     C*
     C                   Z-ADD     0             DUTRDT
     C                   MOVE      Q1USER        DUUSER
     C                   MOVE      'N'           DUFLG1
     C*
     C     CAEOB#        IFNE      *ZEROS
     C                   Z-ADD     CAEOB#        DUEOB#
     C                   ELSE
     C                   Z-ADD     *ZEROS        DUEOB#
     C                   END                                                    ENDNE *ZEROS
     C*
     C                   MOVE      CAFEIN        DUFEIN
     C                   MOVE      CAMOD         DUMOD
     C                   Z-ADD     CATOTC        DUAMT
     C*
     C     DUKY2         CHAIN     PDU02                              61
     C     *IN61         IFEQ      '1'
     C                   WRITE     PDU02
     C                   ELSE
     C                   EXCEPT    RDU02
     C                   END                                                    ENDIF *IN61
     C                   END                                                    ENDNE DUDSEQ
     C*
     C     CAKY4         READE     PCA04                                  60
     C  N60              EXCEPT    RLSCA4
     C*
     C                   END                                                    ENDDOWEQ 60
     C                   END                                                    ENDIF '3'
     C*
     C*** BEGIN CHG *** 04/28/98 **************************************
     C**********           END                             ENDDO 30 D
     C*** END CHG *** 04/28/98 ****************************************
     C     MGKY1         READE     PMG01                                  62
     C                   ENDDO                                                  *IN62 EQ OFF
     C                   MOVE      HL62          *IN62
     C*** END CHG *** 04/28/98 ****************************************
     C*
     C                   MOVE      XHDSEQ        XXDSEQ
     C*
     C                   ENDSR
     C*****************************************************************
     C*** END ADD ***** 04/28/92 ************************************
     C*** BEGIN ADD *** 04/08/93 ************************************
     C*****************************************************************
     C* POSSIBLE DUP CLAIM (ADD TO WORK FILE) FOR PHARMACY CODES      *
     C*****************************************************************
     C     DUPCLX        BEGSR
     C*
     C                   MOVE      XXDSEQ        XHDSEQ            5 0
     C                   MOVE      SCCO#         DUCO#
     C                   MOVE      SCSUB#        DUSUB#
     C                   MOVE      SCFND         DUFND
     C                   MOVE      SCYR          DUFYR
     C                   MOVE      SCCASE        DUCASE
     C                   MOVE      SCSS#         DUSS#
     C                   Z-ADD     SCACDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUACDT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUTRDT
     C                   MOVE      Q1USER        DUUSER
     C                   MOVE      Q1PGM         DUPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         DUDT
     C                   Z-ADD     DSTIME        DUTIME
     C                   MOVE      'N'           DUFLG1
     C*** BEGIN ADD *** 12/06/93 **************************************
     C                   MOVE      *BLANKS       DUFLG2
     C                   MOVE      *BLANKS       DUFLG3
     C*** END ADD *** 12/06/93 ****************************************
     C*
     C*** BEGIN DEL *** 04/28/98 **************************************
     C**********           Z-ADD1         D       50
     C**********           DO   30        D
     C**********
     C********** ER,D      IFEQ '03'
     C********** ER,D      OREQ '3 '
     C********** ER,D      OREQ ' 3'
     C**********           MOVE QS,D      XXDSEQ
     C*** END DEL *** 04/28/98 ****************************************
     C*** BEGIN ADD *** 04/28/98 **************************************
     C*
     C** HOLD ENTERING VALUE OF INDICATOR 62
     C*
     C     *IN62         IFEQ      *OFF
     C                   MOVE      '0'           HL62              1
     C                   ELSE
     C                   MOVE      '1'           HL62
     C                   ENDIF
     C*
     C                   Z-ADD     CADCS#        HDDCS#
     C*
     C     MGKY          SETLL     PMG01
     C     MGKY1         READE     PMG01                                  62
     C     *IN62         DOWEQ     *OFF
     C                   MOVE      MGMSG#        HLMSG#            5
     C     HLMSG#        IFEQ      '00003'
     C                   MOVE      MGDSEQ        XXDSEQ
     C*** END ADD *** 04/28/98 ****************************************
     C*
     C     CAKYF         CHAIN     PCA0F                              60
     C  N60              EXCEPT    RLSCAF
     C*
     C                   MOVE      *BLANKS       DUSVCD
     C                   MOVE      *BLANKS       DUCODE
     C                   MOVE      *BLANKS       DUUNTS
     C                   MOVE      *BLANKS       DUNDC
     C     HCKY          CHAIN     PHC01                              50
     C     *IN50         IFEQ      '0'
     C                   EXCEPT    RLSHC1
     C                   MOVEL     HCNDC         DUNDC
     C                   ELSE
     C                   MOVE      *BLANKS       DUNDC
     C                   END
     C*
     C                   MOVE      CAFEIN        DUFEIN
     C                   MOVE      CAMOD         DUMOD
     C                   MOVEL     CAPMOD        DUPMOD
     C                   Z-ADD     XXDSEQ        DUDSEQ
     C                   Z-ADD     CAFDAT        DUFDAT
     C                   Z-ADD     CATDAT        DUTDAT
     C                   Z-ADD     CATOTC        DUAMT
     C                   Z-ADD     *ZEROS        DUEOB#
     C*
     C     DUKY3         CHAIN     PDU03                              60
     C     *IN60         IFEQ      '1'
     C                   WRITE     PDU03
     C                   ELSE
     C                   EXCEPT    RDU03
     C                   END                                                    ENDIF *IN60
     C*
     C*  READ DETAIL CHARGE FILE, ADD TO POSSIBLE DUPLICATE (PD) FILE
     C*  ANY MATCHING HISTORY DUPLICATES NOT ALREADY IN PD FILE
     C*
     C     HCKY1         CHAIN     PHC02                              60        PHARMACY COD
     C*
     C     *IN60         DOWEQ     '0'
     C     HCDSEQ        IFNE      XXDSEQ
     C*
     C     CAKYF1        CHAIN     PCA0F                              60
     C  N60              EXCEPT    RLSCAF
     C     CAFDAT        IFEQ      DUFDAT
     C     CAFEIN        ANDEQ     DUFEIN
     C     CAMOD         ANDEQ     DUMOD
     C*
     C                   Z-ADD     HCDSEQ        DUDSEQ
     C                   Z-ADD     CARDAT        DUTRDT
     C                   MOVE      Q1USER        DUUSER
     C                   MOVE      'N'           DUFLG1
     C*
     C     CAEOB#        IFNE      *ZEROS
     C                   Z-ADD     CAEOB#        DUEOB#
     C                   ELSE
     C                   Z-ADD     *ZEROS        DUEOB#
     C                   END                                                    ENDNE *ZEROS
     C*
     C                   MOVE      CAFEIN        DUFEIN
     C                   MOVE      CAMOD         DUMOD
     C                   Z-ADD     CATOTC        DUAMT
     C*
     C     DUKY3         CHAIN     PDU03                              61
     C     *IN61         IFEQ      '1'
     C                   WRITE     PDU03
     C                   ELSE
     C                   EXCEPT    RDU03
     C                   END                                                    ENDIF *IN61
     C                   END                                                    EBDNE FDAT
     C                   END                                                    ENDNE DUDSEQ
     C*
     C     HCKY1         READE     PHC02                                  60
     C*
     C                   END                                                    ENDDOWEQ 60
     C                   END                                                    ENDIF '3'
     C*
     C*** BEGIN CHG *** 04/28/98 **************************************
     C**********           END                             ENDDO 30 D
     C*** END CHG *** 04/28/98 ****************************************
     C     MGKY1         READE     PMG01                                  62
     C                   ENDDO                                                  *IN62 EQ OFF
     C                   MOVE      HL62          *IN62
     C*** END CHG *** 04/28/98 ****************************************
     C*
     C                   MOVE      XHDSEQ        XXDSEQ
     C*
     C                   ENDSR
     C*****************************************************************
     C*** END ADD ***** 04/28/92 ************************************
     C*** BEGIN ADD *** 09/23/92 ************************************
     C*****************************************************************
     C* LINKC                                                         *
     C* This subroutine connects FSMS to WCMS Claim Files             *
     C* Program will read WCMS claim files and update or write the    *
     C* information to FSMS claim file and claim demographics file.   *
     C* If no hit in FSMS Claim Master File, then user is taken to    *
     C* F0075R to enter remaining FSMS Claim Information              *
     C* This will be done everytime to keep information up-to-date.   *
     C*****************************************************************
     C*** BEGIN DEL *** 02/14/97
     C*********
     C*********  LINKC     BEGSR
     C*********            ENDSR
     C****BEG*ADD *** 08/11/95 ****************************************
     C*****************************************************************
     C**LINKE**                                                       *
     C**This*subroutine connects FSMS to WCMS Employer Master file.   *
     C**Program will call SRLINKE, which will update or write the     *
     C**employer information to the FSMS Employer file.               *
     C**This*will be done everytime to keep information up-to-date.   *
     C*****************************************************************
     C*********  LINKE     BEGSR
     C*********            ENDSR
     C*********
     C****END*ADD *** 08/11/95 ****************************************
     C*****************************************************************
     C**LINKP**                                                       *
     C**This*subroutine connects FSMS to WCMS Provider File           *
     C**Program will read WCMS Provider File and write demographic    *
     C**information to FSMS Provider File and Provider Aux File.      *
     C**information to FSMS Provider File.                            *
     C**If*no*hit in FSMS Provider File,                              *
     C*****then go to F0031R for user to enter Adjudication State     *
     C*****(and PAR/Non-PAR flag & fields if FSNTWK installed)        *
     C**This*will be done everytime to keep information up-to-date.   *
     C**and*this will be done for all modifiers of this Provider FEIN *
     C*****************************************************************
     C*********  LINKP     BEGSR
     C*********            ENDSR
     C*** END   DEL *** 02/14/97
     C*****************************************************************
     C*** END ADD *** 09/23/92 ****************************************
     C*** BEGIN ADD *** PEND LETTER ***********************************
     C*****************************************************************
     C* CHECK FOR ACTIVE PEND LETTERS FOR CASE/PROVIDER               *
     C*****************************************************************
     C     PNDSR         BEGSR
     C                   MOVE      '0'           *IN25
     C     LTKEY3        CHAIN     PLT01                              60
     C     *IN60         DOWEQ     '0'
     C                   EXCEPT    RLSLTL
     C     LTSTAT        IFEQ      ' '
     C     LTSTAT        OREQ      'B'
     C                   MOVE      '1'           *IN25
     C                   END                                                    END EQ ' '/'B'
     C     LTKEY3        READE     PLT01                                  60
     C                   END                                                    END DOWEQ *IN60
     C                   MOVE      *BLANKS       SCMSG3
     C     *IN25         IFEQ      '1'
     C                   MOVEL     MSG(5)        SCMSG3
     C                   END                                                    END 1 *IN25
     C                   ENDSR
     C*** END ADD ***** PEND LETTER ***********************************
     C*** BEGIN ADD *** 04/12/91 **************************************
     C*****************************************************************
     C* OVRST                                                         *
     C* THIS SUBROUTINE PERFORMS OVERRIDES TO PROCEDURE CODE FILE     *
     C*      AND THE TABLE FILES AND THE SERVICE CODE FILE            *
     C* AND BASES SAID OVERRIDES ON THE STATE FOUND IN THE PROV FILE. *
     C*****************************************************************
     C     OVRST         BEGSR
     C*
     C                   MOVEL     Q2RECF        HLRECF
     C*** GET ADJUDICATION ST AND LICENSE # FOR NEW PROVIDER
     C                   Z-ADD     SCFEIN        XXFEIN
     C                   Z-ADD     SCMOD         XXMOD
     C     P1KEY         CHAIN     PP101                              60
     C     *IN60         IFEQ      '0'
     C*** BEGIN ADD *** 01/15/93 **************************************
     C*
     C* ONLY PROCESS PROVIDER STATE ID SCAST IS EQUAL TO BLANKS
     C*
     C     SCAST         IFEQ      *BLANKS
     C*** END ADD *** 01/15/93 ****************************************
     C*
     C*** BEGIN ADD *** 04/12/91 *************************************
     C** CHECK THAT STATE IS A VALID ADJUDICATION STATE IN FS BASE CONTROL FILE
     C*** BEGIN ADD *** 12/02/96 **************************************
     C* INCREASING NUMBER OF STATES,  CALL CHKSTR IF EXISTS
     C*
     C                   MOVEL     P1ST          QQSTT
     C                   CALL      'CHKSTR'                             60
     C                   PARM                    QQSTT             2
     C                   PARM                    QQSTRT            1
     C                   PARM                    QQFLRT            3
     C     *IN60         IFEQ      '0'
     C     QQSTRT        IFEQ      '0'
     C                   MOVEL     *BLANKS       Q2RECF
     C                   MOVEL     HLRECF        Q2RECF
     C*** BEG DEL *** 03/04/97 ***
     C********** Q2RECF    IFEQ 'SCR01'
     C**********           WRITESCR01
     C**********           END
     C*** END DEL *** 03/04/97 ***
     C     Q2RECF        IFEQ      'SCR02'
     C                   WRITE     SCR02
     C                   END
     C                   MOVE      '1'           *IN37
     C                   GOTO      STRT
     C                   ELSE
     C                   MOVEL     QQFLRT        XXSTAT
     C     XXTAPE        IFEQ      'Y'
     C                   MOVE      '1'           *IN81
     C                   ELSE
     C                   MOVE      '0'           *IN81
     C                   ENDIF                                                  END XXTAPE  KUP ST
     C                   ENDIF                                                  END QQSTRT  KUP ST
     C                   ELSE
     C*** END ADD ***** 12/02/96 **************************************
     C                   Z-ADD     1             X
     C     P1ST          LOOKUP    ST(X)                                  60
     C     *IN60         IFEQ      '1'
     C** CHECK FOR TAPE SUBMISSION IN FS BASE CONTROL FILE
     C                   Z-ADD     1             X
     C     P1ST          LOOKUP    TAPE(X)                                60
     C     *IN60         IFEQ      '1'
     C                   MOVE      '1'           *IN81
     C                   ELSE                                                   ELSE *IN60 LOKUP TP
     C                   MOVE      '0'           *IN81
     C                   END                                                    END *IN60 LOKUP TP
     C                   ELSE                                                   ELSE *IN60 LKUP ST
     C                   MOVEL     *BLANKS       Q2RECF
     C                   MOVEL     HLRECF        Q2RECF
     C*** BEG DEL *** 03/04/97 ***
     C*********  Q2RECF    IFEQ 'SCR01'
     C*************        WRITESCR01
     C*************        END
     C*** END DEL *** 03/04/97 ***
     C     Q2RECF        IFEQ      'SCR02'
     C                   WRITE     SCR02
     C                   END
     C                   MOVE      '1'           *IN37
     C                   GOTO      STRT
     C                   END                                                    END *IN60 LOKUP ST
     C*** END ADD ***** 04/12/91 *************************************
     C                   ENDIF                                                  ADD 12/02/96
     C*** BEGIN ADD *** 01/15/93 **************************************
     C                   ELSE                                                   ELSE SCAST <> BLANKS
     C                   MOVEL     SCAST         P1ST
     C                   END                                                    END SCAST
     C*** END ADD *** 01/15/93 ****************************************
     C*** BEGIN ADD *** 08/03/93 **************************************
     C                   MOVE      *BLANKS       XXSTKY
     C                   MOVEL     P1ST          XXSTKY
     C     STKY          CHAIN     PST01                              60
     C     *IN60         IFEQ      '1'
     C                   MOVE      *BLANKS       ST1A1
     C                   END
     C*** END ADD *** 08/03/93 ****************************************
     C*
     C*** CLOSE FILE IF OPENED
     C     OPNFL1        IFEQ      '1'
     C                   CLOSE     FMPRL
     C                   MOVE      ' '           OPNFL1
     C                   END
     C     OPNFL2        IFEQ      '1'
     C                   CLOSE     FTABL
     C                   MOVE      ' '           OPNFL2
     C                   END
     C     OPNFL3        IFEQ      '1'
     C                   CLOSE     FMSVL1
     C                   MOVE      ' '           OPNFL3
     C                   END
     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C     OPNFL4        IFEQ      '1'
     C                   CLOSE     FTPSL
     C                   MOVE      ' '           OPNFL4
     C                   END
     C*** END ADD *** 05/18/95 *************************************************
     C*
     C*** DELETE OVERRIDE
     C*** Delete Override to FMPRL
      *
     C*** BEGIN ADD *** 03/24/97
      *
      *  EXITS FROM A CALL WILL DELETE OVERRIDES AT THAT LEVEL.
      *  THEREFORE THE RETURN TO F0090R DELETES THE OVERRIDE
      *  AND WE DO NOT HAVE TO EXPLICITLY DELETE IT.
      *
     C     QQENTR        IFGT      1
     C                   MOVE      *BLANK        OVRFL1
     C                   MOVE      *BLANK        OVRFL2
     C                   MOVE      *BLANK        OVRFL3
     C                   MOVE      *BLANK        OVRFL4
     C                   ENDIF
     C*** END ADD *** 03/24/97
     C     OVRFL1        IFEQ      '1'
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'                              60
     C                   PARM                    QCA(3)
     C                   PARM                    LENGTH           15 5
     C                   MOVE      ' '           OVRFL1
     C                   END
     C*** BEGIN ADD *** 04/14/92 **************************************
     C*** Delete Override to FTABL
     C     OVRFL2        IFEQ      '1'
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'                              60
     C                   PARM                    QCA(5)
     C                   PARM                    LENGTH
     C                   MOVE      ' '           OVRFL2
     C                   END
     C*** END ADD *** 04/14/92 ****************************************
     C*** BEGIN ADD *** 04/14/92 **************************************
     C*** Delete Override to FMSVL1
     C     OVRFL3        IFEQ      '1'
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'                              60
     C                   PARM                    QCA(7)
     C                   PARM                    LENGTH           15 5
     C                   MOVE      ' '           OVRFL3
     C                   END
     C*** END ADD *** 04/14/92 ****************************************
     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C*** Delete Override to FMSVL1
     C     OVRFL4        IFEQ      '1'
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'                              60
     C                   PARM                    QCA(11)
     C                   PARM                    LENGTH           15 5
     C                   MOVE      ' '           OVRFL4
     C                   END
     C*** END ADD *** 05/18/95 *************************************************
     C*
     C*** Override to FMPRL
     C     OVRFL1        IFEQ      ' '
     C                   Z-ADD     56            LENGTH
     C                   MOVEL     QCA(4)        @@CMD
     C                   MOVEL     P1ST          @@ST                           02/21/91 ADD
     C                   CALL      'QCMDEXC'
     C                   PARM                    @@CMD
     C                   PARM                    LENGTH           15 5
     C                   MOVE      '1'           OVRFL1
     C                   END
     C*** BEGIN ADD *** 04/14/92 **************************************
     C*** Override to FTABL
     C     OVRFL2        IFEQ      ' '
     C                   Z-ADD     56            LENGTH
     C                   MOVEL     QCA(6)        @@CMD
     C                   MOVEL     P1ST          @@ST
     C                   CALL      'QCMDEXC'
     C                   PARM                    @@CMD
     C                   PARM                    LENGTH           15 5
     C                   MOVE      '1'           OVRFL2
     C                   END
     C*** END ADD *** 04/14/92 ****************************************
     C*** BEGIN ADD *** 04/28/92 **************************************
     C*** Override to FMSVL1
     C     OVRFL3        IFEQ      ' '
     C                   Z-ADD     56            LENGTH
     C                   MOVEL     QCA(8)        @XCMD
     C                   MOVEL     P1ST          @XST
     C                   CALL      'QCMDEXC'
     C                   PARM                    @XCMD
     C                   PARM                    LENGTH           15 5
     C                   MOVE      '1'           OVRFL3
     C                   END
     C*** END ADD *** 04/28/92 ****************************************
     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C*** Override to FTPSL
     C     OVRFL4        IFEQ      ' '
     C                   Z-ADD     56            LENGTH
     C                   MOVEL     QCA(12)       @@CMD
     C                   MOVEL     P1ST          @@ST
     C                   CALL      'QCMDEXC'
     C                   PARM                    @@CMD
     C                   PARM                    LENGTH           15 5
     C                   MOVE      '1'           OVRFL4
     C                   END
     C*** END ADD *** 04/28/92 ****************************************
     C*
     C*
     C                   MOVEL     P1ST          STOVR             2              SAVE NEW STATE
     C                   MOVEL     P1ST          SCAST
     C*
     C*
     C*** OPEN FILE FOR PROCESSING
     C     OPNFL1        IFNE      '1'                                            NOT CURRENTLY OPEN
     C                   OPEN      FMPRL
     C                   MOVE      '1'           OPNFL1
     C                   END
     C     OPNFL2        IFNE      '1'                                            NOT CURRENTLY OPEN
     C                   OPEN      FTABL
     C                   MOVE      '1'           OPNFL2
     C                   END
     C     OPNFL3        IFNE      '1'                                            NOT CURRENTLY OPEN
     C                   OPEN      FMSVL1
     C                   MOVE      '1'           OPNFL3
     C                   END
     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C     OPNFL4        IFNE      '1'                                            NOT CURRENTLY OPEN
     C                   OPEN      FTPSL
     C                   MOVE      '1'           OPNFL4
