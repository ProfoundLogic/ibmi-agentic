     C     NXTPR2        TAG
     C                   READP     PPR01                                  60
     C     *IN60         IFEQ      '0'
     C     PRCO#         ANDEQ     SCCO#
     C     PRCPT4        ANDEQ     XXCPCD
     C     PRSTAT        IFNE      'I'
     C                   MOVEL     PRDSC1        DS(X)
     C                   ELSE
     C                   GOTO      NXTPR2
     C                   END
     C                   ELSE
     C*** BEGIN ADD *** 04/12/91 *************************************
     C*** CHECK REASONABLE/CUSTOMARY FOR DESCRIPTION
     C*
     C     RCKEY         SETGT     PRC01
     C     NXTRC5        TAG
     C                   READP     PRC01                                  60
     C     *IN60         IFEQ      '0'
     C     RCCO#         ANDEQ     SCCO#
     C     RCZIPA        ANDEQ     XXZIPA                                       ADD 05/08/92
     C     RCCPT4        ANDEQ     XXCPCD
     C     RCSTAT        IFNE      'I'
     C                   MOVEL     RCDSC1        DS(X)
     C                   ELSE
     C                   GOTO      NXTRC5
     C                   END
     C                   ELSE
     C*** END ADD ***** 04/12/91 *************************************
     C*
     C                   MOVEL     *BLANK        DS(X)
     C                   END
     C                   END                                                       ADDED FOR R/C
     C*
     C                   ADD       1             Z1
     C*
     C                   END
     C*
     C     KY2(2)        IFGE      50
     C                   MOVE      '1'           XXUP
     C                   MOVE      *BLANKS       XXDOWN
     C                   ELSE
     C                   MOVE      *BLANKS       XXUP
