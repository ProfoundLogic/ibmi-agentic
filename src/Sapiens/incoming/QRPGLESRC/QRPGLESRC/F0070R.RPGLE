     C*
     C*** BEGIN CHG *** 04/15/94 ***********************************************
     C********** CAPRTY    IFEQ '1'
     C********** CARCFL    IFNE 'X'                        ADD 04/08/93
     C     CARCFL        IFEQ      'C'
     C     CARCFL        OREQ      'Y'
     C     PRKEY         SETGT     PPR01
     C     NXTPR5        TAG
     C                   READP     PPR01                                  60
     C     *IN60         IFEQ      '0'
     C     PRCO#         ANDEQ     SCCO#
     C     PRCPT4        ANDEQ     XXCPCD
     C     PRSTAT        IFNE      'I'
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     *BLANK        SCDES1                         ADD 05/06/93
     C                   MOVEL     PRDSC1        SCDESC
     C                   MOVEL     PRDSC2        SCDES1
     C                   ELSE
     C                   GOTO      NXTPR5
     C                   END
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     *BLANK        SCDES1                         ADD 05/06/93
     C                   MOVEL     PRDSC1        SCDESC
     C                   MOVEL     PRDSC2        SCDES1
     C                   ELSE
     C*
     C*** CHECK REASONABLE/CUSTOMARY FOR DESCRIPTION
     C*
     C     RCKEY         SETGT     PRC01
     C     NXTRC7        TAG
     C                   READP     PRC01                                  60
     C     *IN60         IFEQ      '0'
     C     RCCO#         ANDEQ     SCCO#
     C     RCZIPA        ANDEQ     XXZIPA
     C     RCCPT4        ANDEQ     XXCPCD
     C     RCSTAT        IFNE      'I'
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     *BLANK        SCDES1                         ADD 05/06/93
     C                   MOVEL     RCDSC1        SCDESC
     C                   MOVEL     RCDSC2        SCDES1
     C                   ELSE
     C                   GOTO      NXTRC7
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANK        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   END                                                      ADDED R/C
     C                   END
     C*** BEGIN ADD *** 04/08/93 **************************************
     C                   ELSE
     C     CARCFL        IFEQ      'X'
     C     HCKY          CHAIN     PHC01                              60
     C     *IN60         IFEQ      '0'
     C                   EXCEPT    RLSHC1
     C                   MOVEL     HCNDC         XXNDC
     C                   MOVE      '1'           *IN46
     C     RXKEY         CHAIN     PRX01                              60
     C     *IN60         IFEQ      '0'
     C                   MOVEL     HCRX#         SCRX#
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     RXNAME        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   ELSE
     C                   MOVEL     *BLANK        SCRX#
     C                   MOVEL     *BLANK        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   END
     C                   END                                                    END 0 *IN60
     C**********           END                             END CARCFL
     C*** END ADD *** 04/08/93 ****************************************
     C                   ELSE
     C     CARCFL        IFEQ      'S'
     C     CARCFL        OREQ      'N'
     C                   MOVE      *BLANKS       XXCMSV
     C                   Z-ADD     CASVCD        XXRVCD
     C*** BEGIN CHG *** 08/25/97 **************************************
     C***ONLY CHECK REVENUE CODE, DO NOT ADD CPT4 CODE, CAN CONTAIN
     C** GARBAGE DATA FROM USER.
     C*
     C                   MOVE      *BLANKS       XXHCPC
     C*********            MOVE CACPT4    XXHCPC
     C*** END CHG ***** 08/25/97 **************************************
     C                   Z-ADD     *ZEROS        XXUNIT
     C     SVKY          SETGT     PSV01
     C     NXTSV5        TAG
     C                   READP     PSV01                                  60
     C     *IN60         IFEQ      '0'
     C     SVCO#         ANDEQ     SCCO#
     C     SVCMSV        ANDEQ     XXCMSV
     C     SVSTAT        IFNE      'I'
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     SVDESC        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   ELSE
     C                   GOTO      NXTSV5
     C                   END
     C                   ELSE                                                   ELS 0 *IN60
     C     HCKY          CHAIN     PHC01                              60
     C     *IN60         IFEQ      '0'
     C                   EXCEPT    RLSHC1
     C                   MOVEL     *BLANK        SCDESC                         ADD 05/06/93
     C                   MOVEL     HCDESC        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   ELSE                                                    ELS 0 *IN60
     C                   MOVEL     *BLANK        SCDESC
     C                   MOVEL     *BLANK        SCDES1
     C                   END                                                    END 0 *IN60
     C                   END                                                    END 0 *IN60
     C                   END                                                    END CARCFL EQ 'N,S'
     C                   END                                                    END CARCFL EQ 'X'
     C                   END                                                    END CARCFL EQ 'C,Y'
     C                   ENDSR
     C*** END   ADD *** 10/09/92 **************************************
     C*
     C*********************** STRT ADD 10/22/92 *************** MDG *******
     C*****************************************************************
     C* CAPS SUBROUTINE                                               *
     C* IF PROVIDER HAS MANUAL FEE SCHEDULE, SET APPROPRIATE INDIC.   *
     C*****************************************************************
     C     CAPSR         BEGSR                                                  ##K 10/13/89
     C*                                                    ##
     C*********************MOVE '0'       *IN16            ##
     C                   MOVE      '0'           *IN08                          ##
     C                   MOVE      *BLANKS       XXFSFL            1            ##
     C                   MOVE      *BLANKS       SCDMS3                         ##
     C*                                                    ##
     C     FNKEY         CHAIN     PFN01                              60        ##
     C     *IN60         IFEQ      '0'                                          ##
     C*
     C***********          MOVE FNEFDT    SCEFDT           DEL 03/11/98
     C***********          Z-ADDSCEFDT    SRDTI            DEL 03/11/98
     C                   Z-ADD     FNEFDT        SRDTI                          ADD 03/11/98
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         SCEFDT
     C                   Z-ADD     1             X                 5 0          ##
     C     'N'           LOOKUP    FSY(X)                                 60    ##
     C*                                                    ##
     C     *IN60         IFEQ      '1'                                          ##
     C                   MOVE      'Y'           SCNTFL                         ##
     C                   ELSE                                                   ##
     C                   MOVE      'N'           SCNTFL                         ##
     C                   END                                                    ##
     C                   END                                                    ##
     C*                                                    ##
     C*** BEGIN DEL *** 03/18/94 **************************************
     C*** BEG ADD *** 10/19/98 ****************************************
     C     PDKEY         CHAIN     PPD01                              60
     C*                                                    ##
     C     *IN60         IFEQ      *OFF
     C*                                                    ##
     C*** END ADD *** 10/19/98 ****************************************
     C*** BEGIN ADD *** 11/09/92 **************************************
     C     PDPARN        IFEQ      'P'
     C*** END ADD *** 11/09/92 ****************************************
     C     PDTYPE        IFEQ      '4'                                          ##
     C*** BEGIN CHG *** 02/13/98 *************************************
     C*******    HSKEY     CHAINPHS01                60    ##
     C*******    *IN60     IFEQ '0'                        ##
     C*******              MOVE HSFSFL    XXFSFL           ##
     C*******              Z-ADDHSCEDT    SRDTI
     C     HSKEY         CHAIN     PS402                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      S4FSFL        XXFSFL
     C                   Z-ADD     S4BGDT        SRDTI
     C*** END   CHG *** 02/13/98 *************************************
     C                   CALL      'SRCVTDAT'    DTMDY
     C                   MOVEL     SRDTO         XXFRDT            6 0
     C                   END                                                    ##
     C                   ELSE                                                   ##
     C     PDTYPE        IFEQ      '1'                                          ##
     C*** BEGIN CHG *** 02/13/98 *************************************
     C*******    PHKEY     CHAINPPH01                60
     C*******    *IN60     IFEQ '0'                        ##
     C*******              MOVE PHFSFL    XXFSFL           ##
     C*******              Z-ADDPHNEDT    SRDTI
     C     PHKEY         CHAIN     PS401                              60
     C     *IN60         IFEQ      '0'
     C                   MOVE      S4FSFL        XXFSFL
     C                   Z-ADD     S4BGDT        SRDTI
     C*** END   CHG *** 02/13/98 *************************************
     C                   CALL      'SRCVTDAT'    DTMDY
     C                   MOVEL     SRDTO         XXFRDT
     C                   END                                                    ##
     C                   END                                                    ##
     C                   END                                                    ##
     C*** BEGIN ADD *** 03/19/93 **************************************
     C*
     C*  GET THE CURRENT DATE TO USE FOR KEY TO DISCOUNT MASTER
     C*
     C********** UDATE     MULT 10000.01  X1DATE  60
     C*
     C*  GET THE DISCOUNT MASTER RECORD
     C*
     C********** BDKEY     SETGTPBD01
     C********** NXTBD     TAG
     C**********           READPPBD01                    66
     C*
     C*** VERIFY DISCOUNT CODE AND STATUS
     C*
     C********** *IN66     IFEQ '0'
     C********** BDCODE    IFNE XXDTCD
     C********** BDSTAT    OREQ 'I'
     C*
     C**********           GOTO NXTBD
     C**********           ELSE
     C**********           MOVE BDTYPE    XXTYPE  2
     C**********           END                             BDCODE/BDSTAT
     C**********           END                             *IN66 OFF
     C*** END ADD *** 03/19/93 ****************************************
     C*** BEGIN ADD *** 11/09/92 **************************************
     C                   ELSE
     C**********           Z-ADD*ZEROS    SCFRDT
     C**********           Z-ADD*ZEROS    SCTODT
     C                   Z-ADD     *ZEROS        XXFRDT
     C                   END
     C*** END DEL *** 03/18/94 ****************************************
     C*** END ADD *** 11/09/92 ****************************************
     C*** BEG ADD *** 10/19/98 ****************************************
     C                   ENDIF                                                  END *IN60
     C*** END ADD *** 10/19/98 ****************************************
     C*                                                    ##
     C     XXFSFL        IFEQ      'Y'                                          ##
     C*** BEGIN CHG *** 11/06/92 **************************************
     C                   MOVEL     '300'         SCCSCD                         ##
     C*********************MOVEL'600'     SCCSCD           ##
     C                   MOVE      '1'           *IN08
     C*** END CHG *** 11/06/92 ****************************************
     C*********************MOVE '1'       *IN16            ##
     C                   MOVEL     MSG(6)        SCDMS3                         ##
     C                   END                                                    ##
     C*                                                    ##
     C                   ENDSR                                                  ##
     C*                                                    ##K 10/13/89
     C*****************************************************************
     C* ECMD SUBROUTINE                                               *
     C* THIS SUBROUTINE WILL BE USED FOR THOSE CHARGES ENTERED WITH A *
     C* PROVIDER THAT HAS A MEDICAL DEVICES/ELEVATED CARE CAP         *
     C* FLAG SET TO "Y" OR A PROV. THAT HAS  THE MANUAL FEE SCHEDULE  *
     C* FLAG SET TO "Y". IN BOTH CASES THE NETWORK DISCOUNT AMOUNT    *
     C* (NETWORK REDUCTION) WOULD BE THE TOTAL AMOUNT CHARGED MINUS   *
     C* THE TOTAL PAID. MRA AND TOHER REDUCTIONS ARE SET TO ZERO.     *
     C*****************************************************************
     C     ECMD          BEGSR                                                  ##K 10/13/89
     C*                                                    ##
     C                   Z-ADD     0             XXKEY             5 0          ##
     C*                                                    ##
     C     CAKY          SETLL     PCA0E                                        ##
     C     CAKY2         READE     PCA0E                                  60    ##
     C                   MOVE      CADSEQ        XXKEY                          ##
     C  N60              EXCEPT    RLSCAE                                       ##
     C     *IN60         DOWEQ     '0'                                          ##
     C*                                                    ##
     C                   MOVE      *BLANKS       TABKEY                         ##
     C                   MOVEL     CACSCD        TABKEY                         ##
     C     TCSKY         CHAIN     PCS01                              60        ##
     C     *IN60         IFEQ      '0'                                          ##
     C*** BEG DEL *** 02/14/97 ***
     C*******************  EXCPTRCS01
     C*** END DEL *** 02/14/97 ***
     C     CSDISC        IFEQ      'C'                                          ##
     C     CAKY          CHAIN     PCA0E                              60        ##
     C     CATOTC        SUB       CATOTP        CANDIS                         ##
     C                   Z-ADD     0             CAOTHR                         ##
     C                   Z-ADD     0             CATOTD                         ##
     C*** BEGIN CHG *** 04/04/95 ***********************************************
     C**********           Z-ADDCATOTC    CATOTP           03/05/90 LJD
     C**********           Z-ADDCATOTC    CATOTA           05/18/90 ADD
     C     CATOTC        SUB       CANDIS        CATOTP
     C     CATOTC        SUB       CANDIS        CATOTA
     C*** END CHG *** 04/04/95 *************************************************
     C  N60              UPDATE    PCA0E                                        ##
     C                   END                                                    ## *IN60
     C                   END                                                    ## EQ 'C'
     C*                                                    ##
     C     CAKY2         READE     PCA0E                                  60    ##
     C                   MOVE      CADSEQ        XXKEY                          ##
     C  N60              EXCEPT    RLSCAE                                       ##
     C*                                                    ##
     C                   END                                                    ## *IN60
     C*                                                    ##
     C                   ENDSR                                                  ##K 10/13/89
     C*
     C/EJECT
     C************************ END ADD 10/22/92 *************** MDG *******
     C*** BEGIN ADD *** 04/01/93 **************************************
     C*****************************************************************
     C* CRTDIF                                                        *
     C* This subroutine reads all FDCAP records (for this bill) to    *
     C* determine the FS MRA vs. PAYMENT                              *
     C*****************************************************************
     C     CRTDIF        BEGSR
     C*
     C*** BEGIN ADD *** 01/20/93 **************************************
     C*
     C* Only create FSMRA record if:
     C*     1.  Provider Bill
     C*     2.  Dental Bill
     C*     3.  AL Hospital Bill
     C*     4.  TX Hospital Bill
     C*     5.  GA Hospital Bill
     C*
     C*
     C     SCPRTY        IFEQ      'N'
     C     SCPRTY        OREQ      'D'                                          ADD 08/11/93
     C*** END ADD *** 01/20/93 ****************************************
     C*
     C                   Z-ADD     *ZEROS        HLFDAT
     C                   Z-ADD     *ZEROS        HLTDAT
     C                   Z-ADD     *ZEROS        HLTOTC
     C                   Z-ADD     *ZEROS        HLTOTP
     C                   Z-ADD     *ZEROS        HLBLNC
     C                   Z-ADD     *ZEROS        HLDIFF
     C                   Z-ADD     *ZEROS        HLNEWP
     C                   Z-ADD     *ZEROS        HLDCS#
     C* Hold the Sequence # for positioning
     C                   Z-ADD     XXDSEQ        HLSEQN
     C*
     C                   MOVE      SCFEIN        XXFEIN
     C                   MOVE      SCMOD         XXMOD
     C     CAKYC1        CHAIN     PCA0C                              60
     C     *IN60         DOWEQ     '0'
     *** BEG ADD *** 04/14/98 *****************************************
     C                   EXCEPT    RLSCAC
     *** END ADD *** 04/14/98 *****************************************
     C*
     C* Must be working with "Current" Charges for this Case/Provider only
     C     CAEOB#        IFEQ      *ZEROS
     C                   Z-ADD     CADCS#        HLDCS#                         MOVE 01/08/93
     C                   ADD       CATOTC        HLTOTC
     C                   ADD       CANDIS        HLTOTP
     C                   ADD       CAOTHR        HLTOTP
     C                   ADD       CATOTP        HLTOTP
     C                   ADD       CADIFF        HLDIFF
     C*
     C* Determine From/To Dates
     C     CAFDAT        IFLT      HLFDAT
     C     HLFDAT        OREQ      *ZEROS
     C                   Z-ADD     CAFDAT        HLFDAT
     C                   END
     C     CATDAT        IFGT      HLTDAT
     C     HLTDAT        OREQ      *ZEROS
     C                   Z-ADD     CATDAT        HLTDAT
     C                   END
     C                   END                                                     END CAEOB# EQ *ZERO
     C*
     C     CAKYC1        READE     PCA0C                                  60
     C                   END
     C*
     C     HLTOTC        SUB       HLTOTP        HLBLNC
     C*
     C     HLDIFF        IFGE      HLBLNC
     C                   Z-ADD     HLBLNC        HLNEWP
     C                   ELSE                                                   ELSE GE HLBLNC
     C                   Z-ADD     HLDIFF        HLNEWP
     C                   END                                                    END GE HLBLNC
     C*
     C* Write "FSMRA" record, if payment is greater than zero
     C     HLNEWP        IFGT      *ZEROS
     C*
     C* Get next available sequence #
     C                   Z-ADD     99999         XXDSEQ
     C     CAKYF         SETGT     PCA0F
     C                   READP     PCA0F                                  60
     C  N60              EXCEPT    RLSCAF
     C     *IN60         IFEQ      '0'
     C     CACO#         ANDEQ     SCCO#
     C     CAFND         ANDEQ     SCFND
     C     CAFYR         ANDEQ     XXFYR
     C     CACASE        ANDEQ     SCCASE
     C     CADSEQ        ADD       1             CADSEQ
     C                   ELSE
     C                   Z-ADD     1             CADSEQ
     C                   END
     C*
     C* Determine detail charge fields
     C                   Z-ADD     SCCO#         CACO#
     C                   Z-ADD     SCFND         CAFND
     C                   Z-ADD     XXFYR         CAFYR
     C                   Z-ADD     SCCASE        CACASE
     C                   MOVEL     '2  '         CACSCD
     C                   Z-ADD     HLFDAT        CAFDAT
     C                   Z-ADD     HLTDAT        CATDAT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CARDAT
     C                   MOVE      *BLANKS       CAIPOP
     C                   Z-ADD     SCFEIN        CAFEIN
     C                   Z-ADD     SCMOD         CAMOD
     C     SCPRTY        IFEQ      'H'
     C                   MOVE      '4'           CAPRTY
     C                   ELSE
     C                   MOVE      '1'           CAPRTY
     C                   END
     C                   MOVE      *BLANKS       CATRCD
     C                   MOVE      *ZEROS        CASVCD
     C                   MOVE      *BLANKS       CAPMOD
     C                   MOVE      'FSMRA'       CACPT4
     C                   MOVE      *BLANKS       CAICD9
     C                   Z-ADD     *ZEROS        CAANMN
     C                   Z-ADD     *ZEROS        CAUNTS
     C                   Z-ADD     HLNEWP        CATOTC
     C                   Z-ADD     HLNEWP        CATOTA
     C                   MOVE      *ZEROS        CATOTD
     C                   MOVE      *ZEROS        CAOTHR
     C                   MOVE      *ZEROS        CANDIS
     C                   MOVE      *BLANKS       CAEOMB
     C                   Z-ADD     HLNEWP        CATOTP
     C*
     C                   MOVE      *BLANKS       CADELF
     C                   MOVE      *BLANK        CAFLAG
     C                   Z-ADD     *ZEROS        CACHK#
     C                   Z-ADD     *ZEROS        CAEOB#
     C                   MOVE      *BLANKS       CAPART
     C                   MOVE      *BLANKS       CAP1
     C                   MOVE      SCSS#         CASS#
     C                   MOVE      XXACDT        CAACDT
     C                   MOVE      *BLANKS       CASTAT
     C                   MOVE      Q1USER        CAUSER
     C                   MOVE      Q1PGM         CAPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CADT
     C                   Z-ADD     DSTIME        CATIME
     C                   MOVEL     Q1USER        CAIUSR
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CAIDT
     C*
     C                   MOVE      *ZEROS        CADXR
     C                   Z-ADD     HLDCS#        CADCS#
     C*
     C                   Z-ADD     *ZEROS        CALTR#
     C                   MOVE      'C'           CARCFL                         CHG 08/17/94
     C                   Z-ADD     *ZEROS        CADIFF
     C*
     C                   WRITE     PCA01
     C*
     C* Reset Seq# so that SCR03 is positioned correctly
     C*      (This is used when going from SCR02/SCR04 to SCR03).
     C                   Z-ADD     HLSEQN        XXDSEQ
     C*
     C                   END                                                    END HLNEWP GT *ZEROS
     C*
     C*** BEGIN ADD *** 12/02/93 **************************************
     C                   ELSE                                                   ELSE SCPRTY = 'N'
     C*
     C     SCAST         IFEQ      'AL'
     C     SCPRTY        ANDEQ     'H'
     C     SCAST         OREQ      'GA'                                         ADD 08/17/94
     C     SCPRTY        ANDEQ     'H'                                          ADD 08/17/94
     C     SCAST         OREQ      'TX'                                         ADD 08/16/95
     C     SCPRTY        ANDEQ     'H'                                          ADD 08/16/95
     C*
     C                   Z-ADD     *ZEROS        HLFDAT
     C                   Z-ADD     *ZEROS        HLTDAT
     C                   Z-ADD     *ZEROS        HLTOTC
     C                   Z-ADD     *ZEROS        HLTOTP
     C                   Z-ADD     *ZEROS        HLBLNC
     C                   Z-ADD     *ZEROS        HLDIFF
     C                   Z-ADD     *ZEROS        HLNEWP
     C                   Z-ADD     *ZEROS        HLDCS#
     C* Hold the Sequence # for positioning
     C                   Z-ADD     XXDSEQ        HLSEQN
     C*
     C                   MOVE      SCFEIN        XXFEIN
     C                   MOVE      SCMOD         XXMOD
     C     CAKYC1        CHAIN     PCA0C                              60
     C     *IN60         DOWEQ     '0'
     *** BEG ADD *** 04/14/98 *****************************************
     C                   EXCEPT    RLSCAC
     *** END ADD *** 04/14/98 *****************************************
     C*
     C* Must be working with "Current" Charges for this Case/Provider only
     C     CAEOB#        IFEQ      *ZEROS
     C                   Z-ADD     CADCS#        HLDCS#                         MOVE 01/08/93
     C                   ADD       CATOTC        HLTOTC
     C                   ADD       CANDIS        HLTOTP
     C                   ADD       CAOTHR        HLTOTP
     C                   ADD       CATOTP        HLTOTP
     C                   ADD       CADIFF        HLDIFF
     C*
     C* Determine From/To Dates
     C     CAFDAT        IFLT      HLFDAT
     C     HLFDAT        OREQ      *ZEROS
     C                   Z-ADD     CAFDAT        HLFDAT
     C                   END
     C     CATDAT        IFGT      HLTDAT
     C     HLTDAT        OREQ      *ZEROS
     C                   Z-ADD     CATDAT        HLTDAT
     C                   END
     C                   END                                                     END CAEOB# EQ *ZERO
     C*
     C     CAKYC1        READE     PCA0C                                  60
     C                   END
     C*
     C                   Z-ADD     HLDIFF        HLNEWP
     C*
     C* Write "FSMRA" record, if payment is greater than zero
     C     HLNEWP        IFGT      *ZEROS
     C*
     C* Get next available sequence #
     C                   Z-ADD     99999         XXDSEQ
     C     CAKYF         SETGT     PCA0F
     C                   READP     PCA0F                                  60
     C  N60              EXCEPT    RLSCAF
     C     *IN60         IFEQ      '0'
     C     CACO#         ANDEQ     SCCO#
     C     CAFND         ANDEQ     SCFND
     C     CAFYR         ANDEQ     XXFYR
     C     CACASE        ANDEQ     SCCASE
     C     CADSEQ        ADD       1             CADSEQ
     C                   ELSE
     C                   Z-ADD     1             CADSEQ
     C                   END
     C*
     C* Determine detail charge fields
     C                   Z-ADD     SCCO#         CACO#
     C                   Z-ADD     SCFND         CAFND
     C                   Z-ADD     XXFYR         CAFYR
     C                   Z-ADD     SCCASE        CACASE
     C                   MOVEL     '2  '         CACSCD
     C                   Z-ADD     HLFDAT        CAFDAT
     C                   Z-ADD     HLTDAT        CATDAT
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CARDAT
     C                   MOVE      *BLANKS       CAIPOP
     C                   Z-ADD     SCFEIN        CAFEIN
     C                   Z-ADD     SCMOD         CAMOD
     C     SCPRTY        IFEQ      'H'
     C                   MOVE      '4'           CAPRTY
     C                   ELSE
     C                   MOVE      '1'           CAPRTY
     C                   END
     C                   MOVE      *BLANKS       CATRCD
     C                   MOVE      *ZEROS        CASVCD
     C                   MOVE      *BLANKS       CAPMOD
     C                   MOVE      'FSMRA'       CACPT4
     C                   MOVE      *BLANKS       CAICD9
     C                   Z-ADD     *ZEROS        CAANMN
     C                   Z-ADD     *ZEROS        CAUNTS
     C                   Z-ADD     HLNEWP        CATOTC
     C                   Z-ADD     HLNEWP        CATOTA
     C                   MOVE      *ZEROS        CATOTD
     C                   MOVE      *ZEROS        CAOTHR
     C                   MOVE      *ZEROS        CANDIS
     C                   MOVE      *BLANKS       CAEOMB
     C                   Z-ADD     HLNEWP        CATOTP
     C*
     C                   MOVE      *BLANKS       CADELF
     C                   MOVE      *BLANK        CAFLAG
     C                   Z-ADD     *ZEROS        CACHK#
     C                   Z-ADD     *ZEROS        CAEOB#
     C                   MOVE      *BLANKS       CAPART
     C                   MOVE      *BLANKS       CAP1
     C                   MOVE      SCSS#         CASS#
     C                   MOVE      XXACDT        CAACDT
     C                   MOVE      *BLANKS       CASTAT
     C                   MOVE      Q1USER        CAUSER
     C                   MOVE      Q1PGM         CAPGM
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CADT
     C                   Z-ADD     DSTIME        CATIME
     C                   MOVEL     Q1USER        CAIUSR
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         CAIDT
     C*
     C                   MOVE      *ZEROS        CADXR
     C                   Z-ADD     HLDCS#        CADCS#
     C*
     C                   Z-ADD     *ZEROS        CALTR#
     C                   MOVE      'N'           CARCFL
     C                   Z-ADD     *ZEROS        CADIFF
     C*
     C                   WRITE     PCA01
     C*
     C* Reset Seq# so that SCR03 is positioned correctly
     C*      (This is used when going from SCR02/SCR04 to SCR03).
     C                   Z-ADD     HLSEQN        XXDSEQ
     C*
     C                   END                                                    END HLNEWP GT *ZEROS
     C                   END                                                    END SCAST EQ AL/GA
     C*** END ADD *** 12/02/93 ****************************************
     C*
     C*** BEGIN ADD *** 01/20/93 **************************************
     C                   END                                                    END SCPRTY = N
     C*** END ADD *** 01/20/93 ****************************************
     C*
     C                   ENDSR
     C*** END ADD ***** 04/01/93 **************************************
     C*
     C*** BEGIN ADD *** 10/14/97 **************************************
     C*
     C*****************************************************************
     C*   UPDFLD - UPDATE FILEDS FROM F0091F AND F0092F WHEN DETAIL
     C*            CHARGES EXIST
     C*****************************************************************
     C*
     C     UPDFLD        BEGSR
     C*
     C*** FILEDS FORM F0091R
     C*
     C                   MOVE(P)   SCMLI#        DCLIC#
