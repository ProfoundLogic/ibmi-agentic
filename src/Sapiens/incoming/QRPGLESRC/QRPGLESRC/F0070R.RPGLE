     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C***********************************
     C*  SCR04  - PEND LETTER           *
     C***********************************
     C     Q2RECF        IFEQ      'SCR04'
     C     Q2RECF        OREQ      'SCR04S'
     C     Q2RECF        OREQ      'SCR04C'
     C*
     C* BEFORE PENDING THE BILL, WE MUST DO DUP KEY PROCESSING
     C*
     C                   READC     SCR04S                                 50
     C     *IN50         DOWEQ     '0'
     C*
     C     *IN72         IFEQ      '1'
     C     *IN73         OREQ      '1'
     C     *IN74         OREQ      '1'
     C     *IN75         OREQ      '1'
     C     *IN76         OREQ      '1'
     C     *IN77         OREQ      '1'
     C     *IN78         OREQ      '1'
     C*
     C                   MOVE      *BLANKS       XX72FL
     C                   MOVE      *BLANKS       XX73FL
     C                   MOVE      *BLANKS       XX74FL
     C                   MOVE      *BLANKS       XX75FL
     C                   MOVE      *BLANKS       XX76FL
     C                   MOVE      *BLANKS       XX77FL
     C                   MOVE      *BLANKS       XX78FL
     C*
     C     *IN72         IFEQ      '1'
     C                   MOVE      'Y'           XX72FL
     C                   END
     C     *IN73         IFEQ      '1'
     C                   MOVE      'Y'           XX73FL
     C                   END
     C     *IN74         IFEQ      '1'
     C                   MOVE      'Y'           XX74FL
     C                   END
     C     *IN75         IFEQ      '1'
     C                   MOVE      'Y'           XX75FL
     C                   END
     C     *IN76         IFEQ      '1'
     C                   MOVE      'Y'           XX76FL
     C                   END
     C     *IN77         IFEQ      '1'
     C                   MOVE      'Y'           XX77FL
     C                   END
     C     *IN78         IFEQ      '1'
     C                   MOVE      'Y'           XX78FL
     C                   END
     C*
     C     RRN4          IFGT      1
     C                   Z-ADD     RRN4          S
     C     RRN4          SUB       1             K
     C     K             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     SCSVDT        HLSVDT
     C                   MOVE      *BLANKS       HLPOS
     C                   MOVEL     SCPOS         HLPOS
     C                   MOVE      *BLANKS       HLTOS
     C                   MOVEL     SCTOS         HLTOS
     C                   MOVE      *BLANKS       HLCPT4
     C                   MOVEL     SCCPT4        HLCPT4
     C                   Z-ADD     *ZEROS        HLRVCD
     C                   Z-ADD     SCRVCD        HLRVCD
     C                   MOVE      SCDX          HLDX
     C                   MOVE      SCPX          HLPX
     C                   UPDATE    SCR04S
     C                   END                                                    END *IN60
     C*
     C     S             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C     XX72FL        IFEQ      'Y'
     C                   Z-ADD     HLSVDT        SCSVDT
     C                   END
     C     XX73FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCPOS
     C                   MOVEL     HLPOS         SCPOS
     C                   END
     C     XX74FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCTOS
     C                   MOVEL     HLTOS         SCTOS
     C                   END
     C     XX75FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCCPT4
     C                   MOVEL     HLCPT4        SCCPT4
     C                   END
     C     XX76FL        IFEQ      'Y'
     C                   Z-ADD     HLRVCD        SCRVCD
     C                   END
     C     XX77FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCDX
     C                   MOVEL     HLDX          SCDX
     C                   END
     C     XX78FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCPX
     C                   MOVEL     HLPX          SCPX
     C                   END
     C                   UPDATE    SCR04S
     C                   END                                                    END *IN60
     C                   END                                                    END RRN4>1
     C                   END                                                    END *IN72
     C*
     C                   READC     SCR04S                                 50
     C                   END                                                    END DOW 50
     C*
     C* PEND THE BILL
     C*
     C*
     C                   MOVE      *BLANKS       HXRECF
     C                   MOVEL     Q2RECF        HXRECF
     C                   MOVE      *BLANKS       TABKEY
     C                   MOVEL     SCCSCD        TABKEY
     C     TCSKY         CHAIN     PCS01                              60
     C     *IN60         IFEQ      '0'
     C*** BEG DEL *** 02/14/97 ****
     C******************** EXCPTRCS01
     C*** END DEL *** 02/14/97 ****
     C                   END
     C     CSDISC        IFEQ      'P'
     C*
     C                   EXSR      EDIT4
     C*
     C* DO NOT ALLOW NEW CHARGES TO BE PENDED IF CURRENT CHARGES
     C* STILL EXIST - MUST COMPLETE PROCESSING OF CURRENT CHARGES 1ST
     C*
     C                   EXSR      DCSR                                           VERIFY DC
     C     *IN94         IFEQ      '1'
     C                   MOVE      '1'           *IN97                          CANT PEND
     C                   MOVEL     MSG(3)        SCMSG2
     C                   GOTO      STRT
     C                   ELSE                                                   ELSE 1 *IN94
     C*
     C                   Z-ADD     *ZEROS        K
     C                   Z-ADD     9999999       XHFRDT
     C                   Z-ADD     *ZERO         XHTODT
     C     NXT04H        TAG
     C                   ADD       1             K
     C     K             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C*
     C                   MOVEL     'SCR04'       HXRECF
     C*
     C* DETERMINE FROM/TO SERVICE DATES
     C*
     C     SCTOTC        IFNE      *ZERO
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XHDATE
     C     XHDATE        IFLT      XHFRDT
     C                   Z-ADD     XHDATE        XHFRDT
     C                   END
     C     XHDATE        IFGT      XHTODT
     C                   Z-ADD     XHDATE        XHTODT
     C                   END
     C*
     C                   END                                                    ENDNE *ZERO
     C*
     C                   GOTO      NXT04H
     C                   END                                                    END *IN75'
     C                   END                                                    END 1 *IN94
     C*
     C                   ELSE                                                   ELSE EQ 'P'
     C                   MOVE      '1'           *IN05                          CANT PEND
     C                   MOVE      *BLANKS       Q2RECF
     C                   MOVEL     HXRECF        Q2RECF                         ADD 04/28/92
     C*** BEG DEL *** 3/04/97 ****
     C********
     C********   LOKEY     CHAINPLO01                60
     C********   *IN60     IFEQ '0'
     C********   LCKOUT    ANDEQ'1'
     C********             DELETPLO01
     C********             MOVE '0'       LCKOUT
     C********             END
     C*** END DEL *** 3/04/97 ****
     C                   GOTO      STRT
     C                   END                                                    END EQ 'P'
     C*
     C                   Z-ADD     XHFRDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         LLFRDT
     C                   Z-ADD     XHTODT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         LLTODT
     C*
     C* CALL PGM TO REQUEST LETTER
     C*
     C                   MOVE      *BLANKS       LLFND
     C                   MOVE      *BLANKS       LLFYR
     C                   MOVE      *BLANKS       LLCASE
     C                   MOVE      *BLANKS       LLFEIN
     C                   MOVE      *BLANKS       LLMOD
     C                   MOVE      *BLANKS       LLTTLC
     C*** BEGIN ADD *** 10/05/92 **************************************
     C                   MOVE      *BLANKS       QQPRTY
     C*** END ADD *** 10/05/92 ****************************************
     C*
     C*** BEGIN ADD *** 10/16/92 **************************************
     C                   MOVE      SCSUB#        LLSUB#            5
     C*** END ADD *** 10/16/92 ****************************************
     C                   MOVE      SCFND         LLFND             3
     C                   MOVE      SCYR          LLFYR             3
     C                   MOVE      SCCASE        LLCASE            7
     C                   MOVE      SCFEIN        LLFEIN            9
     C                   MOVE      SCMOD         LLMOD             3
     C                   MOVE      SCTTLC        LLTTLC            9
     C                   MOVE      *ZEROS        LLLTR#            9
     C*** BEGIN ADD *** 10/05/92 **************************************
     C     SCPRTY        IFEQ      'H'
     C                   MOVE      '4'           QQPRTY            1
     C                   ELSE
     C     SCPRTY        IFEQ      'N'
     C     SCPRTY        OREQ      'D'                                          ADD 08/11/93
     C                   MOVE      '1'           QQPRTY
     C                   ELSE
     C     SCPRTY        IFEQ      'X'
     C                   MOVE      '1'           QQPRTY
     C                   END                                                    END EQ 'X'
     C                   END                                                    END EQ 'N'
     C                   END                                                    END EQ 'H'
     C*** END ADD *** 10/05/92 ****************************************
     C*** BEGIN ADD *** 12/02/92 **************************************
     C     SCCSCD        IFEQ      '320'
     C                   MOVE      'N'           QQPRNT            1
     C                   ELSE
     C                   MOVE      *BLANKS       QQPRNT
     C                   END                                                    END SCCSCD
     C*** END ADD *** 12/02/92 ****************************************
     C*
     C                   CALL      'F0750R'
     C                   PARM                    QQPRDS
     C                   PARM      '2'           QQCALL
     C*** BEGIN ADD *** 10/16/92 **************************************
     C                   PARM                    LLSUB#
     C*** END ADD *** 10/16/92 ****************************************
     C                   PARM                    LLFND
     C                   PARM                    LLFYR
     C                   PARM                    LLCASE
     C                   PARM                    LLFEIN
     C                   PARM                    LLMOD
     C                   PARM                    LLFRDT
     C                   PARM                    LLTODT
     C                   PARM                    LLTTLC
     C                   PARM                    LLLTR#
     C*** BEGIN ADD *** 10/05/92 **************************************
     C                   PARM                    QQPRTY
     C*** END ADD *** 10/05/92 ****************************************
     C*** BEGIN ADD *** 12/02/92 **************************************
     C                   PARM                    QQPRNT
     C*** END ADD *** 12/02/92 ****************************************
     C                   PARM                    QQRTCD
     C*
     C     QQRTCD        IFEQ      'A'                                          CMD 1 EOJ
     C     QQRTCD        OREQ      'N'                                          CMD 2 PREV SCRN
     C**********           WRITESCR99                      DEL 03/15/95
     C                   MOVE      *BLANK        Q2RECF
     C******************   MOVEL'SCR02'   Q2RECF           DEL 04/28/92
     C                   MOVEL     HXRECF        Q2RECF                         ADD 04/28/92
     C                   GOTO      STRT
     C                   ELSE                                                   ELSE EQ A/N
     C                   MOVE      LLLTR#        XXLTR#
     C*
     C                   EXSR      WRIT4
     C*
     C*** BEG DEL *** 3/04/97 ****
     C*********            EXSR INIT
     C**********           WRITESCR99
     C*********            MOVE *BLANK    Q2RECF
     C*********            MOVEL'SCR01'   Q2RECF
     C********
     C********   LOKEY     CHAINPLO01                60
     C********   *IN60     IFEQ '0'
     C********   LCKOUT    ANDEQ'1'
     C********             DELETPLO01
     C********             MOVE '0'       LCKOUT
     C********             END
     C*******              GOTO TOP
     C*** END DEL *** 3/04/97 ****
     C*** BEG CHG *** 3/24/97 ****
     C                   MOVE      ' '           QQRT90
     C                   GOTO      TERM
     C*** END CHG *** 3/24/97 ****
     C                   END                                                    END EQ A/N
     C*
     C                   END                                                    END SCR04
     C*** END ADD *** 05/18/95 *************************************************
     C*** END ADD *** 04/01/93 ****************************************
     C*** BEGIN ADD *** 04/01/93 **************************************
     C********************************************
     C*  SCR03 - PROV CURRENT CHARGES SEARCH     *
     C********************************************
     C     Q2RECF        IFEQ      'SCR03'
     C     Q2RECF        OREQ      'SCR03C'
     C     Q2RECF        OREQ      'SCR03S'
     C*
     C                   MOVE      *BLANKS       Q2CO#             3
     C                   MOVE      *BLANKS       Q2SUB#            5
     C                   MOVE      *BLANKS       Q2FND             3
     C                   MOVE      *BLANKS       Q2FYR             3
     C                   MOVE      *BLANKS       Q2CASE            7
     C                   MOVE      *BLANKS       Q2FEIN            9
     C                   MOVE      *BLANKS       Q2MOD             3
     C*
     C                   MOVE      SCCO#         Q2CO#
     C                   MOVE      SCSUB#        Q2SUB#
     C                   MOVE      SCFND         Q2FND
     C                   MOVE      SCFYR         Q2FYR
     C                   MOVE      SCCASE        Q2CASE
     C                   MOVE      SCFEIN        Q2FEIN
     C                   MOVE      SCMOD         Q2MOD
     C                   CALL      'F0582R'
     C                   PARM                    QQPRDS
     C                   PARM                    Q2CO#
     C                   PARM                    Q2SUB#
     C                   PARM                    Q2FND
     C                   PARM                    Q2FYR
     C                   PARM                    Q2CASE
     C                   PARM                    Q2FEIN
     C                   PARM                    Q2MOD
     C                   PARM      '1'           Q2RTCD            1
     C*
     C     Q2RTCD        CABEQ     'A'           TERM
     C*
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCR03'       Q2RECF
     C*
     C     Q2RTCD        IFEQ      'B'
     C                   GOTO      STRT
     C                   END
     C*
     C     Q2RTCD        IFEQ      '*'
     C                   GOTO      STRT
     C                   END
     C*
     C                   END                                                    END SCR03
     C*** END ADD *** 04/01/93 ****************************************
     C*
     C                   END                                                    ENDIF *INKS
