     C*******************************************************************
     C* SCR01E - SUBROUTINE TO PERFORM SCR01 EDITS                      *
     C*******************************************************************
     C*** BEG DEL *** 03/04/97 ***
     C*******
     C*******    SCR01E    BEGSR
     C*******
     C**VALIDATE SYSTEM ID
     C*******
     C*******    SCSYS     CABEQ*BLANK    STRT           26  MDG 102292
     C****LOOK TO FILE TO MAKE SURE THE ENTERED SYSTEM IS VALID
     C*******
     C*******              MOVE *BLANKS   QQKEY
     C*******              MOVE SCSYS     QQKEY
     C*******
     C*******              CALL 'F0541R'
     C*******              PARM           QQPRDS
     C*******              PARM           QQCALL
     C*******              PARM           QQKEY  10
     C*******              PARM 'V'       QQRTCD
     C*******
     C*******    QQRTCD    IFEQ 'B'
     C*******    QQKEY     OREQ *BLANK
     C*******              MOVE '1'       *IN26
     C*******              GOTO STRT
     C*******              END
     C****BEGIN ADD *** 01/31/96 ***********************************************
     C*******    SCSYS     IFNE 'P'
     C*******    SCSYS     ANDNE'H'
     C*******    SCSYS     ANDNE'N'
     C*******              MOVE '1'       *IN26
     C*******              GOTO STRT
     C*******              END
     C****END ADD *** 01/31/96 *************************************************
     C*******
     C*******    SCSS#     CABEQ*BLANK    STRT           25
     C*******    SCACDT    CABEQ*ZERO     STRT           21
     C*******
     C*******              MOVE SCACDT    SRDTE   6
     C*******
     C*******              CALL 'SRDCK'
     C*******              PARM           SRDTE   6
     C*******              PARM ' '       SRERR   1
     C*******              PARM ' '       SRTERM  1
     C*******
     C*******    SRERR     CABEQ'1'       STRT           24
     C*******
     C**CHANGED TO CHECK IF VALID SYSTEM ID FOR ALL SYSTEMS NOT ONLY
     C**NETWORK
     C*******
     C*******                                              ##
     C*******    FNKEY     CHAINPFN01                60    ##
     C*******    *IN60     IFEQ '0'                        ##
     C*******              Z-ADD1         X       50       ##
     C*******    SCSYS     LOKUPFSY,X                    60##
     C*******    *IN60     IFEQ '0'                        ##
     C*******    SCSYS     IFEQ 'N'
     C*******              MOVE '1'       *IN28            ##
     C*******              ELSE
     C*******              MOVE '1'       *IN38
     C*******              END
     C*******              GOTO STRT                       ##
     C*******              END                             ##
     C*******              END                             ##
     C*******                                              ##
     C*******    SCSYS     IFEQ 'N'
     C*******    PDKEY     CHAINPPD01                60    ##
     C*******    *IN60     IFEQ '0'                        ##
     C*******    PDPARN    IFNE 'P'                        ##
     C*******              MOVE '1'       *IN28            ##
     C*******              GOTO STRT                       ##
     C*******              END                             ##
     C*******              END                             ##
     C*******              END
     C*******
     C*******    SCACDT    MULT 10000.01  XXACDT
     C*******
     C****BEG DEL *** 02/14/97  *******************
     C***71***********     EXSR LINKC                       ADD 09/23/92
     C****END DEL *** 02/14/97  *******************
     C*******
     C****Check for multiple cases under the same SS#/ACDT
     C*******              Z-ADD*ZEROS    CNTCAS  30
     C*******    CMKEY     CHAINPCM01                20     SS#/ACDT KEY
     C*******    *IN20     DOWEQ'0'
     C*******              ADD  1         CNTCAS
     C*******    CMKEY     READEPCM01                    20
     C*******              END
     C*******
     C****If*no hit, this is an invalid SS#/ACDT - Send Error Message (*IN20)
     C****Else, setof *IN20 so message is not displayed
     C*******    CNTCAS    IFEQ *ZEROS
     C*******              GOTO STRT
     C*******              ELSE
     C*******              MOVE '0'       *IN20
     C*******              END
     C*******
     C****If*there is more than 1 case, then display "Multi Case" Search F0579F
     C*******    CNTCAS    IFGT 1
     C*******              MOVE SCSS#     QTSS#
     C*******              MOVE SCACDT    QTACDT
     C*******              MOVE *BLANKS   QTFND
     C*******              MOVE *BLANKS   QTFYR
     C*******              MOVE *BLANKS   QTCASE
     C*******              CALL 'F0579R'
     C*******              PARM           QTPRDS 40
     C*******              PARM           QTCALL  1
     C*******              PARM           QTSS#   9
     C*******              PARM           QTACDT  6
     C*******              PARM           QTFND   3
     C*******              PARM           QTFYR   3
     C*******              PARM           QTCASE  7
     C*******              PARM           QTRTCD  1
     C*******
     C*******              WRITESCR99
     C*******              MOVE *BLANK    Q2RECF
     C*******              MOVEL'SCR01'   Q2RECF
     C*******
     C*******              WRITESCR01
     C*******
     C*******    QTRTCD    IFEQ 'A'
     C*******    QTRTCD    OREQ 'B'
     C*******    QTFND     OREQ *BLANKS
     C*******              MOVE '1'       *IN20
     C*******              GOTO STRT
     C*******              END                             END EQ A/B/*BLANKS
     C*******
     C*******    QTRTCD    IFEQ '*'
     C*******              MOVE QTFND     XXFND
     C*******              MOVE QTFYR     XXFYR
     C*******              MOVE QTCASE    SCCASE
     C*******    *IN71     IFEQ '1'
     C*******    FNKEY3    CHAINPFN02                60
     C*******    *IN60     IFEQ '0'
     C*******              Z-ADDFNFND     XXFND
     C*******              ELSE
     C*******              Z-ADD*ZEROS    XXFND
     C*******              END
     C*******              END
     C*******    CMKEY2    CHAINPCM02                20
     C*******    *IN20     CABEQ'1'       STRT
     C*******              END                             END EQ *
     C*******
     C*******              END                             END GT 1
     C*******
     C*******    CMCO#     CABNEUPCO#     STRT       2222
     C*******    CMSUB#    CABNEUPSUB#    STRT       2222
     C*******    CMFND     CABNEUPFND     STRT       2222
     C*******
     C*******              MOVE CMCASE    SCCASE
     C*******              MOVE CMFYR     SCYR
     C*******    CMMMI     MULT 100.0001  SCMMI            ADD 01/16/95
     C*******
     C*****CHECK FOR PURGE INFO HERE ****
     C*******
     C*******
     C******PROVIDER TYPE MUST BE 'H' FOR HOSPITAL OR 'N' FOR OTHER
     C*******
     C*******    SCPRTY    IFNE 'N'
     C*******    SCPRTY    ANDNE'X'                        ADD 04/08/93
     C*******    SCPRTY    ANDNE'D'                        ADD 08/11/93
     C*******    SCPRTY    CABNE'H'       STRT       3232
     C*******              END
     C*******
     C*******    SCTYPE    IFNE *BLANKS
     C*******
     C*******    SCPRTY    IFNE 'H'
     C*******              MOVE '1'       *IN45
     C*******              GOTO STRT
     C*******              END                             END SCPRTY NE 'H'
     C*******
     C*******    SCTYPE    IFNE 'IN '
     C*******    SCTYPE    ANDNE'ER1'
     C*******    SCTYPE    ANDNE'ER+'
     C*******    SCTYPE    ANDNE'OUT'
     C*******    SCTYPE    ANDNE'ASC'
     C*****BEGIN ADD *** 08/15/95 **********************************************
     C*******    SCTYPE    ANDNE'CAT'
     C*******    SCTYPE    ANDNE'MRI'
     C****END ADD *** 08/15/95 *************************************************
     C*******              MOVE '1'       *IN46
     C*******              GOTO STRT
     C*******              END                             END SCTYPE NE 'IN'..
     C*******
     C*******              END                             END SCTYPE NE *BLANKS
     C*******
     C**PROVIDER TYPE MUST MATCH SYSTEM TYPE
     C*******
     C*******    SCSYS     IFEQ 'P'
     C*******    SCPRTY    IFNE 'N'
     C*******    SCPRTY    ANDNE'X'
     C*******    SCPRTY    ANDNE'D'                        ADD 08/11/93
     C*******              MOVE '1'       *IN10
     C*******              GOTO STRT
     C*******              END
     C*******              ELSE
     C*******    SCSYS     IFEQ 'H'
     C*******    SCPRTY    CABNE'H'       STRT       1010
     C*******              END
     C*******              END
     C*******    SCAST     IFEQ *BLANKS
     C*******              MOVE *BLANKS   XXSTKY
     C*******              MOVELCMAST     XXSTKY
     C*******    STKY      CHAINPST01                60
     C*******    *IN60     IFEQ '1'
     C*******              MOVE '1'       *IN39
     C*******              GOTO STRT
     C*******              ELSE
     C*******    STINST    IFEQ 'Y'
     C*******              MOVELCMAST     SCAST
     C*******              END
     C*******              END
     C*******              END
     C*******
     C**IF*AUDIT/RECON ENTERED, IT MUST BE VALID
     C*******
     C****BEG DEL *** 03/04/97 ***
     C*******
     C*******    SCAR      IFNE 'A'
     C*******    SCAR      ANDNE'R'
     C*******    SCAR      ANDNE*BLANKS
     C*******
     C*******              MOVE '1'       *IN52
     C*******              GOTO STRT
     C*******
     C*******              END                             END SCAR NE 'A'
     C****END DEL *** 03/04/97 ***
     C*******
     C*******    *INKX     IFNE '1'
     C*******
     C**IF*AUDIT ENTERED, AND ENTER IS PRESSED EOMB MUST BE ZEROS
     C**********
     C****BEG DEL *** 03/04/97 ***
     C********** SCAR      IFEQ 'A'
     C********** SCEOB#    ANDNE*ZEROS
     C**********
     C**********           MOVE '1'       *IN53
     C**********           GOTO STRT
     C**********
     C**********           END                             END SCAR NE 'A'
     C****END DEL *** 03/04/97 ***
     C*******
     C**IF*RECON ENTERED, AND ENTER IS PRESSED GIVE ERROR
     C*******
     C****BEG DEL *** 03/04/97 ***
     C*******    SCAR      IFEQ 'R'
     C*******
     C*******              MOVE '1'       *IN55
     C*******              GOTO STRT
     C*******
     C*******              END                             END SCAR NE 'A'
     C****END DEL *** 03/04/97 ***
     C*******
     C*******              END                             END *INKX EQ '1'
     C*******
     C**IF*USER ENTERED EOMB NUMBER AND DID NOT ENTER AN AUDIT RECON FLAG
     C**ZERO*OUT SCEOB# AND IGNORE.  THIS WAY WE CAN USE SCEOB# TO DETERMINE
     C**WHAT*KIND OF CHARGES WE ARE PROCESSING(I.E. EOB# > ZERO AUDIT/RECON
     C**EOB#*= ZEROS CUREENT).
     C*******
     C****BEG DEL *** 03/04/97 ***
     C*******    SCAR      IFEQ *BLANKS
     C*******              Z-ADD*ZEROS    SCEOB#
     C*******              END
     C****END DEL *** 03/04/97 ***
     C*******
     C**IF*ADJUDICATION STATE IS NOT EQUAL TO BLANKS VERIFIY THAT IT
     C**IS*A*VALID STATE CODE
     C*******
     C*******    SCAST     IFNE *BLANKS
     C*******              MOVE *BLANKS   XXSTKY
     C*******              MOVELSCAST     XXSTKY
     C*******    STKY      CHAINPST01                60
     C*******    *IN60     IFEQ '1'
     C*******              MOVE '1'       *IN39
     C*******              GOTO STRT
     C*******              END
     C*******
     C**IF*THIS IS A VALID STATE CODE IT MUST ALSO BE A VLAID INSTALLEDCH
     C**ADJUDICATION STATE
     C*******
     C****BEGIN ADD *** 12/02/96 **************************************
     C**INCREASING NUMBER OF STATES,  CALL CHKSTR IF EXISTS
     C*******
     C*******              MOVELSCAST     QQSTT
     C*******              CALL 'CHKSTR'               60
     C*******              PARM           QQSTT   2
     C*******              PARM           QQSTRT  1
     C*******              PARM           QQFLRT  3
     C*******    *IN60     IFEQ '0'
     C*******    QQSTRT    IFEQ '0'
     C*******              MOVE '1'       *IN40
     C*******              GOTO STRT
     C*******              ENDIF                           END LOKUP ST
     C*******              MOVELQQFLRT    XXSTAT
     C*******    XXTAPE    IFEQ 'Y'
     C*******              MOVE '1'       *IN81
     C*******              ELSE
     C*******              MOVE '0'       *IN81
     C*******              ENDIF                           END LOKUP ST
     C*******              ELSE
     C****END ADD ***** 12/02/96 **************************************
     C*******
     C*******              Z-ADD1         X
     C*******    SCAST     LOKUPST,X                     60
     C*******    *IN60     IFEQ '0'
     C*******              MOVE '1'       *IN40
     C*******              GOTO STRT
     C*******              ELSE
     C***CHECK FOR TAPE SUBMISSION IN FS BASE CONTROL FILE
     C*******              Z-ADD1         X
     C*******    SCAST     LOKUPTAPE,X                   60
     C*******    *IN60     IFEQ '1'
     C*******              MOVE '1'       *IN81
     C*******              ELSE                            ELSE *IN60 LOKUP TP
     C*******              MOVE '0'       *IN81
     C*******              END                             END *IN60 LOKUP TP
     C*******              ENDIF                           *IN60 ADD 12/02/96
     C*******              END                             END *IN60 LOKUP ST
     C*******
     C*******              END                             END SCAST
