     C*** END ADD *** 08/01/97 ****************************************
     C*** BEGIN ADD *** 06/16/94 *********************************************
     C* =================================================================== *
     C* * * TOS (TYPE OF SERVICE) MUST BE VALID
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN61
     C*
     C                   DO        10            Y                 5 0
     C     TS(Y)         IFNE      *ZERO
     C*
