     C*****
     C*****  F23 = AUDIT/RECON PROCESSING    *
     C****************************************
     C*****      *INKX     IFEQ '1'
     C***********************************
     C***SCR01                          *
     C***********************************
     C*****      Q2RECF    IFEQ 'SCR01'
     C*****
     C**IF*F23 IS PRESSED, AUDIT/RECON FLAG MUST BE VALID
     C*****
     C*****      SCAR      IFNE 'A'
     C*****      SCAR      ANDNE'R'
     C*****
     C*****                MOVE '1'       *IN49
     C*****                GOTO STRT
     C*****
     C*****                END                             END SCAR NE 'A'
     C*****
     C**PERFORM SCR01 EDITS
     C*****
     C*****                EXSR SCR01E
     C*****
     C*****      SCTYPE    IFNE *BLANKS
     C*****                Z-ADD1         T       20
     C*****      SCTYPE    LOKUPBS,T                     70
     C*****      *IN70     IFEQ '1'
     C*****                MOVELSCR,T     Q2RECF
     C*****                MOVE *BLANKS   H1RECF
     C*****                MOVELQ2RECF    H1RECF
     C*****                ELSE                            ELSE *IN70 EQ '1'
     C*****                MOVEL'SCR04'   Q2RECF
     C*****                MOVEL'SCR04'   H1RECF
     C*****                END                             END *IN70 EQ '1'
     C*****                ELSE                            ELSE SCTYPE EQ *BLANK
     C*****      SCPRTY    IFEQ 'H'
     C*****                MOVEL'SCR04'   H1RECF
     C*****                ELSE                            ELSE SCPRTY EQ 'H'
     C*****      SCPRTY    IFEQ 'N'
     C*****      SCPRTY    OREQ 'D'
     C*****                MOVEL'SCR02'   H1RECF
     C*****                ELSE                            ELSE SCPRTY EQ 'N'
     C*****      SCPRTY    IFEQ 'X'
     C*****                MOVEL'SCRRX'   H1RECF
     C*****                END                             END SCPRTY EQ 'X'
     C*****                END                             END SCPRTY EQ 'N'
     C*****                END                             END SCPRTY EQ 'H'
     C*****                END                             END SCTYPE NE *BLANKS
     C*****
     C**IF*EOMB NUMBER HAS NOT BEEN ENTERED BY THE USER
     C*****
     C*****      SCEOB#    IFEQ *ZEROS
     C*****
     C*****                WRITESCR01
     C*****                MOVE UPCO#     Q3CO#
     C*****                MOVE SCSUB#    Q3SUB#
     C*****                MOVE SCFND     Q3FND
     C*****                MOVE SCYR      Q3FYR
     C*****                MOVE SCCASE    Q3CASE
     C*****                MOVE SCEOB#    Q3EOB#
     C*****                MOVE SCSS#     Q3SS#
     C*****                MOVE SCACDT    Q3ACDT
     C*****                MOVE SCFEIN    Q3FEIN
     C*****                MOVE SCMOD     Q3MOD
     C*****                MOVE SCAR      Q3AR
     C*****
     C*****                CALL 'F0072R'
     C*****                PARM           QQPRDS
     C*****                PARM           QQCALL
     C*****                PARM           Q3CO#   3
     C*****                PARM           Q3SUB#  5
     C*****                PARM           Q3FND   3
     C*****                PARM           Q3FYR   3
     C*****                PARM           Q3CASE  7
     C*****                PARM           Q3EOB#  9
     C*****                PARM           Q3SS#   9
     C*****                PARM           Q3ACDT  6
     C*****                PARM           Q3FEIN  9
     C*****                PARM           Q3MOD   3
     C*****                PARM           Q3AR    1
     C*****                PARM           Q3RTCD  1
     C*****                MOVE Q3EOB#    SCEOB#
     C*****
     C*****      SCEOB#    IFEQ *ZEROS
     C*****
     C*****      LOKEY     CHAINPLO01                60
     C*****      *IN60     IFEQ *OFF
     C*****      LCKOUT    ANDEQ'1'
     C*****                DELETPLO01
     C*****                MOVE '0'       LCKOUT
     C*****                END
     C*****
     C*****                WRITESCR01
     C*****                MOVE '1'       *IN56
     C*****                MOVE *BLANKS   Q2RECF
     C*****                MOVEL'SCR01'   Q2RECF
     C*****                GOTO STRT
     C*****
