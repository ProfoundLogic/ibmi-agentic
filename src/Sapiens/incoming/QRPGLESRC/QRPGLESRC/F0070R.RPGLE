     C*******************************************************************
     C* WRIT4 SUBROUTINE - WRITE THE DATA FOR SCR04 TO DISK             *
     C*******************************************************************
     C     WRIT4         BEGSR
     C*
     C**********           Z-ADD99999     XXDSEQ  50
     C*
     C********** CAKYF     SETGTPCA0F
     C**********           READPPCA0F                    60
     C**N60                EXCPTRLSCAF                     07/31/90 ADD
     C********** *IN60     IFEQ '0'
     C********** CACO#     ANDEQUPCO#
     C********** CASUB#    ANDEQUPSUB#
     C********** CAFND     ANDEQUPFND
     C********** CAFYR     ANDEQXXFYR
     C********** CACASE    ANDEQSCCASE
     C**********           Z-ADDCADSEQ    HHDSEQ  50
     C**********           ELSE
     C**********           Z-ADD0         HHDSEQ
     C**********           END
     C**********           Z-ADD0         XXDSEQ
     C*
     C**********           Z-ADDUPCO#     CACO#
     C**********           Z-ADDUPSUB#    CASUB#
     C**********           Z-ADDUPFND     CAFND
     C**********           Z-ADDXXFYR     CAFYR
     C**********           Z-ADDSCCASE    CACASE
     C**********           MOVE SCSS#     CASS#            ##
     C**********           MOVE XXACDT    CAACDT           ##
     C**********           MOVE *BLANKS   CADELF
     C*
     C*********            MOVE *BLANKS   CAFLAG
     C**********           MOVE *BLANKS   TABKEY
     C**********           MOVELSCCSCD    TABKEY
     C********** TCSKY     CHAINPCS01                60
     C********** *IN60     IFEQ '0'
     C**********           EXCPTRCS01
     C**********           END
     C********** CSDISC    IFEQ 'P'
     C**********           MOVE 'P'       CAFLAG
     C**********           Z-ADDXXLTR#    CALTR#
     C**********           ELSE
     C**********           MOVE *BLANK    CAFLAG
     C**********           Z-ADD*ZEROS    CALTR#
     C**********           END                                ENDIF 'P'
     C*
     C**********           MOVE *ZEROS    CACHK#
     C**********           Z-ADD0         CAEOB#
     C**********           MOVE *BLANKS   CASTAT
     C**********           MOVE *ZEROS    CATOTD
     C*
     C**********           MOVE *ZEROS    HLDFE
     C**********           MOVE *ZEROS    HLDMO
     C*
     C**********           DO   50        X
     C* * * IF AN ITEM WAS ENTERED THEN WRITE TO DISK
     C********** HTC,X     IFNE *ZERO
     C*
     C***  UPDATE/WRITE DIAGNOSIS CODE FILE
     C*
     C********** HFE,X     IFNE HLDFE                      IF FEIN CHG
     C********** HMO,X     ORNE HLDMO                      OR MOD CHGS
     C********** HFE,X     IFNE *ZERO                      IF FEIN <>0
     C*
     C*** DETERMINE FROM/TO SERVICE DATES FOR DIAGNOSIS CODE FILE
     C*
     C**********           MOVELHFE,X     XXFEIN
     C**********           MOVELHMO,X     XXMOD
     C********** DCKEY     CHAINPDC01                61
     C********** *IN61     IFEQ '0'
     C********** DCSTAT    ANDEQ' '
     C**********           MOVE DCFRDT    XDFRDT
     C**********           MOVE DCTODT    XDTODT
     C**********           ELSE
     C**********           Z-ADD999999    XDFRDT  60
     C**********           Z-ADD*ZERO     XDTODT  60
     C**********           END                             END 0 *IN61
     C*
     C**********           DO   50        L       50
     C********** HTC,L     IFNE *ZERO
     C*
     C********** HFR,L     MULT 10000.01  XDDATE  60
     C********** XDDATE    IFLT XDFRDT
     C**********           Z-ADDXDDATE    XDFRDT
     C**********           END
     C********** XDDATE    IFGT XDTODT
     C**********           Z-ADDXDDATE    XDTODT
     C**********           END
     C*
     C**********           END                             ENDNE *ZERO
     C**********           END                             END DO 50 L
     C*
     C********** *IN61     IFEQ '0'
     C*
     C*** IF DIAG CODE RECORD IS FOUND, VERIFY THAT IT IS NOT PENDED -
     C*** MULTIPLE PENDED DIAG CODE RECORDS MAY EXIST, BUT ONLY ONE DC
     C*** RECORD MAY EXIST FOR CURRENT CHARGES.
     C*
     C********** DCSTAT    IFEQ ' '
     C**********           GOTO UPD4DC
     C**********           ELSE                            CONTINUE READING
     C**********           SETOF                     60
     C*
     C********** *IN60     DOWEQ'0'
     C*
     C********** DCKEY     READEPDC01                    60
     C********** DCSTAT    IFEQ ' '
     C**********           GOTO UPD4DC
     C**********           END                             DCSTAT = ' '
     C*
     C**********           END                             DOW *IN60
     C*
     C**********           END                             DCSTAT = ' '
     C*
     C********** *IN60     IFEQ '1'
     C********** DCSTAT    ANDNE' '
     C**********           GOTO WRT4DC
     C**********           END                             DCSTAT = ' '
     C*
     C********** UPD4DC    TAG                             UPDATE DC RECORD
     C*
     C**********           MOVE XDFRDT    DCFRDT
     C**********           MOVE XDTODT    DCTODT
     C**********           MOVE HD1,X     DCDIA1
     C**********           MOVE HD2,X     DCDIA2
     C**********           MOVE HD3,X     DCDIA3
     C**********           MOVE HD4,X     DCDIA4
     C*** BEGIN ADD *** 11/09/92 **************************************
     C**********           MOVE SCSYS     DCSYS
     C*** END ADD *** 11/09/92 ****************************************
     C*** BEGIN ADD *** 11/09/92 **************************************
     C**********           MOVE 'H'       DCBLTY
     C*** END ADD *** 11/09/92 ****************************************
     C*** BEGIN CHG *** 05/25/94 ***********************************************
     C*** BEGIN ADD *** 03/22/94 **************************************
     C**********           MOVELSCNWCD    DC10A1
     C**********           MOVELSCNWCD    XCNWCD
     C**********           MOVELSCTYPE    XCTYPE
     C**********           MOVE XC10A1    DC10A1
     C*** END ADD *** 03/22/94 ****************************************
     C*** END CHG *** 05/25/94 *************************************************
     C**********           MOVE Q1USER    DCUSER
     C**********           MOVE Q1PGM     DCPGM
     C**********           TIME           DSDTTM
     C**********           Z-ADDDSTIME    DCTIME
     C********** DSDATE    MULT 10000.01  DCDT
     C*
     C**********           UPDATPDC01
     C*
     C*** IF DIAG CODE RECORD EITHER DOES NOT EXIST - OR - THERE ARE
     C*** ONLY PENDED CHARGES, NOT CURRENT CHARGES, WRITE A NEW RECORD.
     C*
     C**********           ELSE                            *IN61 = 1
     C*
     C********** WRT4DC    TAG                             WRITE DC RECORD
     C*
     C** DETERMINE NEXT SEQ#.
     C*
     C**********           MOVE HFE,X     XXFEIN
     C**********           MOVE HMO,X     XXMOD
     C**********           Z-ADD99999     XXDCS#
     C********** DCKEY2    SETGTPDC01
     C**********           READPPDC01                    60
     C*
     C*** SINCE PDC01 RECORDS ARE READ IN AS UPDATE, MUST NOW RELEASE THE
     C*** RECORD WE JUST READ TO RETRIEVE THE SEQ # FROM.(PREVENT REC LOCKS)
     C*
     C**N60                EXCPTRLSDCL
     C*
     C********** *IN60     IFEQ '0'
     C********** UPCO#     ANDEQDCCO#
     C********** UPSUB#    ANDEQDCSUB#
     C********** UPFND     ANDEQDCFND
     C********** XXFYR     ANDEQDCFYR
     C********** SCCASE    ANDEQDCCASE
     C********** HFE,X     ANDEQDCFEIN
     C********** HMO,X     ANDEQDCMOD
     C**********           ADD  1         DCDCS#
     C**********           ELSE                            ELSE 0 *IN60
     C**********           Z-ADD1         DCDCS#
     C**********           END                             END 0 *IN60
     C**********           MOVE XDFRDT    DCFRDT
     C**********           MOVE XDTODT    DCTODT
     C**********           MOVE HD1,X     DCDIA1
     C**********           MOVE HD2,X     DCDIA2
     C**********           MOVE HD3,X     DCDIA3
     C**********           MOVE HD4,X     DCDIA4
     C*** BEGIN ADD *** 11/09/92 **************************************
     C**********           MOVE SCSYS     DCSYS
     C*** END ADD *** 11/09/92 ****************************************
     C*** BEGIN ADD *** 04/08/93 **************************************
     C**********           MOVE 'H'       DCBLTY
     C*** END ADD *** 04/08/93 ****************************************
     C*** BEGIN CHG *** 05/25/94 ***********************************************
     C*** BEGIN ADD *** 03/22/94 **************************************
     C**********           MOVELSCNWCD    DC10A1
     C**********           MOVELSCNWCD    XCNWCD
     C**********           MOVELSCTYPE    XCTYPE
     C**********           MOVE XC10A1    DC10A1
     C*** END ADD *** 03/22/94 ****************************************
     C*** END CHG *** 05/25/94 *************************************************
     C**********           MOVE Q1USER    DCUSER
     C**********           MOVE Q1PGM     DCPGM
     C**********           TIME           DSDTTM
     C**********           Z-ADDDSTIME    DCTIME
     C********** DSDATE    MULT 10000.01  DCDT
     C**********           Z-ADDDCDT      DCIDT
     C**********           MOVE Q1USER    DCIUSR
     C**********           Z-ADDUPCO#     DCCO#
     C**********           Z-ADDUPSUB#    DCSUB#
     C**********           Z-ADDUPFND     DCFND
     C**********           Z-ADDXXFYR     DCFYR
     C**********           Z-ADDSCCASE    DCCASE
     C*** BEGIN ADD *** 10/05/92 **************************************
     C**********           MOVE SCPRTY    DCPRTY
     C**********           MOVE XXCERT    DCCERT           ADD 12/02/92
     C**********           Z-ADDXXEXT     DCEXT            ADD 12/02/92
     C*** END ADD *** 10/05/92 ****************************************
     C**********           Z-ADDHFE,X     DCFEIN
     C**********           Z-ADDHMO,X     DCMOD
     C*** BEGIN ADD *** 09/17/92 *************************************
     C**********           MOVE SCZIPA    DCZIPA
     C**********           MOVE SCAST     DCAST
     C*** END ADD ***** 09/17/92 *************************************
     C*
     C*** GET ADJUDICATION STATE *************************************
     C********** SCAST     IFEQ *BLANKS                    ADD 01/15/93
     C**********           Z-ADDHFE,X     XXFEIN
     C**********           Z-ADDHMO,X     XXMOD
     C********** P1KEY     CHAINPP101                60
     C********** *IN60     IFEQ '0'
     C**********           MOVE P1ST      DCAST
     C**********           ELSE
     C**********           MOVE 'FL'      DCAST
     C**********           END
     C**********           END
     C*
     C********** CSDISC    IFEQ 'P'
     C**********           MOVE 'P'       DCSTAT
     C**********           Z-ADDXXLTR#    DCLTR#           06/19/92 KRR
     C**********           ELSE
     C**********           MOVE ' '       DCSTAT
     C**********           Z-ADD*ZEROS    DCLTR#           06/19/92 KRR
     C**********           END
     C**********           WRITEPDC01
     C**********           END                             END 0 *IN61
     C**********           END                             FEIN <> 0
     C*
     C**********           MOVE HFE,X     HLDFE
     C**********           MOVE HMO,X     HLDMO
     C*
     C**********           END                             ENDNE HLD
     C*
     C**********           MOVE HCS,X     CACSCD
     C*
     C********** 10000.01  MULT HFR,X     CAFDAT
     C********** 10000.01  MULT HTO,X     CATDAT
     C********** 10000.01  MULT HRD,X     CARDAT
     C**********           MOVE HFE,X     CAFEIN
     C**********           MOVE HMO,X     CAMOD
     C**********           MOVE '4'       CAPRTY
     C**********           MOVE HTR,X     CATRCD
     C**********           MOVE HBR,X     CAP1
     C**********           MOVE HPA,X     CAPART
     C**********           MOVE HIO,X     CAIPOP
     C**********           MOVE HPM,X     CAPMOD
     C**********           MOVE HIC,X     CAICD9
     C*
     C**********           MOVE HCP,X     CACPT4
     C**********           Z-ADDHSV,X     CASVCD
     C**********           Z-ADDHUT,X     CAUNTS
     C*
     C**********           MOVE HDX,X     CADXR
     C*
     C**********           MOVE HAL,X     CATOTA
     C**********           MOVE HAL,X     CATOTP
     C*
     C**********           MOVE HEC,X     CAEOMB
     C*** BEGIN ADD *** 04/15/94 ***********************************************
     C*
     C* FIRST WE MUST CHECK SERVICE CODE FILE TO SEE IF SERVICE CODE
     C*
     C**********           MOVE HRC,X     CARCFL
     C**********           MOVE *BLANKS   XXCMSV
     C**********           Z-ADDHSV,X     XXRVCD
     C**********           MOVE HCP,X     XXHCPC
     C**********           Z-ADD*ZEROS    XXUNIT
     C********** 10000.01  MULT HFR,X     XXFDAT
     C********** SVKY      SETGTPSV01
     C**********           READPPSV01                    60
     C********** *IN60     IFEQ '0'
     C********** SVCO#     ANDEQUPCO#
     C********** SVCMSV    ANDEQXXCMSV
     C**********           MOVE 'S'       CARCFL
     C**********           ELSE                            ELSE *IN60
     C*
     C* IF WE DO NOT GET HIT IN SERVICE CODE FILE CHECK PROC CODE FILE
     C*
     C**********           MOVELHCP,X     XXCPCD
     C********** PRKEY     SETGTPPR01
     C**********           READPPPR01                    60
     C********** *IN60     IFEQ '0'
     C********** PRCO#     ANDEQUPCO#
     C********** PRCPT4    ANDEQXXCPCD
     C**********           MOVE 'C'       CARCFL
     C**********           ELSE                            ELSE *IN60
     C*
     C* IF WE DO NOT GET HIT IN PROC CODE FILE CHECK R&C CODE FILE
     C*
     C**********           MOVE SCZIPA    XXZIPA
     C**********           MOVELHCP,X     XXCPCD
     C********** RCKEY     SETGTPRC01
     C**********           READPPRC01                    60
     C********** *IN60     IFEQ '0'
     C********** RCCO#     ANDEQUPCO#
     C********** RCZIPA    ANDEQXXZIPA                     ADD 05/08/92
     C********** RCCPT4    ANDEQXXCPCD
     C**********           MOVE 'Y'       CARCFL
     C**********           ELSE                            ELSE *IN60
     C*
     C**********           MOVE 'N'       CARCFL
     C**********           END                             END *IN60 EQ '0' RCK
     C**********           END                             END *IN60 EQ '0' PRK
     C**********           END                             END *IN60 EQ '0' SVK
     C*** END ADD *** 04/15/94 *************************************************
     C*
     C********** DSDATE    MULT 10000.01  CARDAT
     C**********           MOVE Q1USER    CAUSER
     C**********           MOVE Q1PGM     CAPGM
     C**********           TIME           DSDTTM
