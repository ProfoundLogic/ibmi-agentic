     C*****************    Z-ADDUT,X      XXUNIT           DEL 05/31/92
     C**********           Z-ADD*ZEROS    XXUNIT           ADD 05/31/92
     C*** END ADD ***** 04/28/92 **********************************
     C*
     C*** INZ DATE FIELD FOR CHAINS
     C*
     C********** 10000.01  MULT SD,X      XXFDAT
     C********** SVKY      SETGTPSV01
     C********** NXTSV4    TAG
     C**********           READPPSV01                    60
     C********** *IN60     IFEQ '0'
     C********** SVCO#     ANDEQUPCO#
     C********** SVCMSV    ANDEQXXCMSV                     CHG 04/28/92
     C********** SVSTAT    IFNE 'I'
     C**********           MOVELSVDESC    DS,X
     C**********           ELSE
     C**********           GOTO NXTSV4
     C**********           END
     C*******************  ELSE                            DEL 04/28/92
     C*******************  MOVEL*BLANK    DS,X             DEL 04/28/92
     C**********           ELSE                            ELSE *IN60 SVK
     C*
     C* GET DESCRIPTION OF PROCEDURE/R&C CODE
     C*
     C**********           MOVE SCZIPA    XXZIPA
     C**********           MOVE CP,X      XXCPCD
     C*
     C*** INZ DATE FIELD FOR CHAINS
     C*
     C********** 10000.01  MULT SD,X      XXFDAT
     C*
     C**********           MOVE *BLANKS   DS,X
     C********** PRKEY     SETGTPPR01
     C********** NXTPR9    TAG
     C**********           READPPPR01                    60
     C********** *IN60     IFEQ '1'
     C********** PRCO#     ORNE UPCO#
     C********** PRCPT4    ORNE XXCPCD
     C*
     C***** CHECK HERE FOR REASONABLE AND CUSTOMARY HIT.
     C**********           MOVE XXFDAT    XXWDAT
     C********** RCKEY     SETGTPRC01
     C********** NXTRC4    TAG
     C**********           READPPRC01                    60
     C********** *IN60     IFEQ '0'
     C********** RCCO#     ANDEQUPCO#
     C********** RCZIPA    ANDEQXXZIPA
     C********** RCCPT4    ANDEQXXCPCD
     C********** RCSTAT    IFNE 'I'
     C**********           MOVELRCDSC1    DS,X
     C**********           ELSE                            ELSE NE 'I' - RCSTAT
     C**********           GOTO NXTRC4
     C**********           END                             END NE 'I' - RCSTAT
     C**********           END                             END 0 *IN60 - PRC01
     C**********           ELSE                            ELSE 1 *IN60 - PPR01
     C********** PRSTAT    IFNE 'I'
     C**********           MOVELPRDSC1    DS,X
     C**********           ELSE                            ELSE NE 'I' - RCSTAT
     C**********           GOTO NXTPR9
     C**********           END                             END NE 'I' - PRSTAT
     C**********           END                             END 1 *IN60 - PPR01
     C*
     C**********           END                             END *IN60 SVK
     C*
     C**********           END                             END DO 10
     C*** END ADD *** 04/15/94 *************************************************
