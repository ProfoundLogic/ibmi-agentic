     C     SVKY          SETGT     PSV01
     C     NXTSV4        TAG
     C                   READP     PSV01                                  60
     C     *IN60         IFEQ      '0'
     C     SVCO#         ANDEQ     SCCO#
     C     SVCMSV        ANDEQ     XXCMSV
     C*
     C     SVSTAT        IFNE      'I'
     C*
     C                   MOVE      *BLANKS       SCDES                          ADD 03/12/96
