     C*******************************************************************
     C* SC4LD SUBROUTINE - LOAD SCREEN DATA FOR SCR04 ON ROLL REQUEST   *
     C*******************************************************************
     C********** SC4LD     BEGSR
     C*
     C**********           MOVE KY2,1     Z1
     C*
     C**********           MOVEA'0000'    *IN,01
     C**********           MOVE '0'       *IN94
     C*
     C********** HCS,Z1    IFNE *BLANK
     C**********           MOVE HCS,Z1    SCCSCD
     C**********           MOVE HFE,Z1    SCFEIN
     C**********           MOVE HMO,Z1    SCMOD
     C**********           MOVE HPR,Z1    SCPRTY
     C*
     C* CHAIN TO SPECIALTY CODE TABLE FILE TO GET DESCRIPTION        *
     C**********           MOVE *BLANKS   SCSPEC
     C**********           MOVE *BLANKS   TABKEY
     C**********           MOVELHSP,Z1    TABKEY
     C**********           MOVELHSP,Z1    SCSPCD
     C********** SPKY      CHAINPSP01                60
     C********** *IN60     IFEQ '0'
     C**********           EXCPTRSP01
     C**********           MOVELSPDESC    SCSPEC
     C**********           END
     C*
     C**********           EXSR DCSR                       DIAG CODE SUBR
     C**********           MOVELHD1,Z1    SCDIA1
     C**********           MOVELHD2,Z1    SCDIA2
     C**********           MOVELHD3,Z1    SCDIA3
     C**********           MOVELHD4,Z1    SCDIA4
     C**********           EXSR PNDSR
     C**********           END
     C*
     C**********           DO   10        X
     C**********           MOVE HFR,Z1    SD,X
     C**********           MOVE HIO,Z1    IO,X
     C**********           MOVE HSC,Z1    SC,X
     C**********           MOVE HPM,Z1    PM,X
     C*
     C**********           MOVE *BLANKS   CP,X
     C**********           MOVE *BLANKS   SV,X
     C**********           MOVE *BLANKS   UT,X
     C**********           MOVE HCP,Z1    CP,X
     C**********           MOVE HSV,Z1    SV,X
     C**********           MOVE HUT,Z1    UT,X
     C**********           MOVE HDS,Z1    DS,X             ADD 06/19/92
     C*
     C**********           MOVE HIC,Z1    IC,X
     C**********           MOVE HAN,Z1    AN,X
     C**********           MOVE HTC,Z1    TC,X
     C**********           MOVE HTR,Z1    TR,X
     C**********           MOVE HBR,Z1    BR,X
     C**********           MOVE HPA,Z1    PA,X
     C**********           MOVE HAL,Z1    AL,X
     C**********           MOVE HEC,Z1    EC,X
     C**********           MOVE HRC,Z1    RC,X
     C*** BEGIN ADD *** 03/15/95 ***********************************************
     C**********           MOVE HPI,Z1    PI,X
     C*** END ADD *** 03/15/95 *************************************************
     C**********           MOVE HDX,Z1    DX,X
     C**********           MOVE HTS,Z1    TS,X              ADD 06/16/94
     C*
     C*** INZ DATE FIELD FOR CHAINS
     C*
     C********** 10000.01  MULT SD,X      XXFDAT
     C*
     C*** BEGIN ADD *** 04/28/92 *************************************
     C**********           MOVE *BLANKS   XXCMSV
     C**********           Z-ADDHSV,Z1    XXRVCD
     C**********           MOVE HCP,Z1    XXHCPC
     C******************   Z-ADDHUT,Z1    XXUNIT           DEL 05/31/92
     C**********           Z-ADD*ZEROS    XXUNIT           ADD 05/31/92
     C*** END ADD ***** 04/28/92 *************************************
     C*
     C********** SVKY      SETGTPSV01
     C********** NXTSV2    TAG
     C**********           READPPSV01                    60
     C********** *IN60     IFEQ '0'
     C********** SVCO#     ANDEQUPCO#
     C********** SVCMSV    ANDEQXXCMSV                     CHG 04/28/92
     C********** SVSTAT    IFNE 'I'
     C**********           MOVELSVDESC    DS,X
     C**********           ELSE
     C**********           GOTO NXTSV2
     C**********           END
     C**********           ELSE
     C**********           MOVEL*BLANK    DS,X
     C**********           END
     C**********
     C**********           ADD  1         Z1
     C*
     C**********           END
     C*
     C********** KY2,2     IFGE 50
     C**********           MOVE '1'       XXUP
     C**********           MOVE *BLANKS   XXDOWN
     C**********           ELSE
     C**********           MOVE *BLANKS   XXUP
     C**********           END
     C*
     C********** KY2,1     IFLE 1
     C**********           MOVE '1'       XXDOWN  1
     C**********           MOVE *BLANKS   XXUP    1
     C**********           ELSE
     C**********           MOVE *BLANKS   XXDOWN
     C**********           END
     C*
     C**********           ENDSR
     C*** END DEL *** 05/18/95 *************************************************
     C*** BEGIN ADD *** 04/28/92 ****************************************
     C*** BEGIN ADD *** 04/08/93 ****************************************
     C*******************************************************************
     C* SCXLD SUBROUTINE - LOAD SCREEN DATA FOR SCRRX ON ROLL REQUEST   *
     C*******************************************************************
     C     SCXLD         BEGSR
     C*
     C                   MOVE      KY2(1)        Z1
     C*
     C                   MOVEA     '0000'        *IN(01)
     C                   MOVE      '0'           *IN94
     C*
     C     HCS(Z1)       IFNE      *BLANK
     C                   MOVE      HCS(Z1)       SCCSCD
     C                   MOVE      HFE(Z1)       SCFEIN
     C                   MOVE      HMO(Z1)       SCMOD
     C                   MOVE      HPR(Z1)       SCPRTY
     C*
     C* CHAIN TO SPECIALTY CODE TABLE FILE TO GET DESCRIPTION        *
     C                   MOVE      *BLANKS       SCSPEC
     C                   MOVE      *BLANKS       TABKEY
     C                   MOVEL     HSP(Z1)       TABKEY
     C                   MOVEL     HSP(Z1)       SCSPCD
     C     SPKY          CHAIN     PSP01                              60
     C     *IN60         IFEQ      '0'
     C*** BEG DEL *** 02/14/97 ***
     C******************   EXCPTRSP01
     C*** END DEL *** 02/14/97 ***
     C                   MOVEL     SPDESC        SCSPEC
     C                   END
     C*
     C                   EXSR      DCSR                                         DIAG CODE SUBR
     C                   MOVEL     HD1(Z1)       SCDIA1
     C                   MOVEL     HD2(Z1)       SCDIA2
     C                   MOVEL     HD3(Z1)       SCDIA3
     C                   MOVEL     HD4(Z1)       SCDIA4
     C                   EXSR      PNDSR
     C                   END
     C*
     C                   DO        10            X
     C                   MOVE      HFR(Z1)       SD(X)
     C                   MOVE      HRX(Z1)       RX(X)
     C                   MOVE      HND(Z1)       ND(X)
     C                   MOVE      HT2(Z1)       T2(X)
     C                   MOVE      HU2(Z1)       U2(X)
     C                   MOVE      HND(Z1)       XXNDC
     C     RXKEY         CHAIN     PRX01                              60
     C     *IN60         IFEQ      '0'
     C     RXCO#         ANDEQ     SCCO#
     C     RXNDC         ANDEQ     XXNDC                                        CHG 04/28/92
     C     RXSTAT        IFNE      'I'
     C                   MOVEL     RXNAME        XXDESC           21
     C                   MOVEL     XXDESC        DS(X)
     C                   MOVE      RXMEAS        DS(X)
     C                   Z-ADD     1             T                 2 0
     C     RXPTYP        LOOKUP    PTYP(T)                                60
     C     *IN60         IFEQ      '1'
     C                   MOVEL     PTYD(T)       BG(X)
     C                   ELSE
     C                   MOVE      *BLANKS       BG(X)
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANK        DS(X)
     C                   MOVE      *BLANKS       BG(X)
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANKS       DS(X)
     C                   MOVE      *BLANKS       BG(X)
     C                   END
     C                   ADD       1             Z1
     C*
     C                   END
     C*
     C     KY2(2)        IFGE      50
     C                   MOVE      '1'           XXUP
     C                   MOVE      *BLANKS       XXDOWN
     C                   ELSE
     C                   MOVE      *BLANKS       XXUP
     C                   END
     C*
     C     KY2(1)        IFLE      1
     C                   MOVE      '1'           XXDOWN            1
     C                   MOVE      *BLANKS       XXUP              1
     C                   ELSE
     C                   MOVE      *BLANKS       XXDOWN
     C                   END
     C*
     C                   ENDSR
     C*** END ADD *** 04/08/93 ******************************************
     C*******************************************************************
     C* EDIT2 SUBROUTINE - EDIT SCREEN DATA FOR SCR02                   *
     C*******************************************************************
     C     EDIT2         BEGSR
     C*
     C*** BEGIN ADD *** 05/13/98 **************************************
     C**********           MOVE *BLANKS   LETTER           DEL 05/22/98
     C*** END ADD *** 05/13/98 ****************************************
     C* * *  CLAIM STATUS CODE MUST EXIST   AND BE ACTIVE
     C*
     C                   MOVEL     *BLANK        TABKEY
     C                   MOVEL     SCCSCD        TABKEY
     C     TCSKY         CHAIN     PCS01                              22
     C     *IN22         IFEQ      '0'
     C*** BEG DEL *** 02/14/97 ***
     C******************** EXCPTRCS01
     C*** END DEL *** 02/14/97 ***
     C                   END
     C     *IN22         CABEQ     '1'           STRT
     C     CSSTAT        CABNE     'A'           STRT                 2222
     C*
     C*
     C* * * PAYEE(PROVIDER) MUST BE ON FILE  AND ACTIVE
     C*
     C*** BEGIN DEL *** 10/13/92 ******************************************
     C*********  PDKEY     CHAINPPD01                27
     C*********            EXCPTRPD01
     C*********  *IN27     CABEQ'1'       STRT
     C*********  PDSTAT    CABEQ'I'       STRT           27
     C*** END DEL ***** 10/13/92 ******************************************
     C*** BEGIN CHG *** 08/11/93 **************************************
     C*** BEGIN DEL *** 04/15/94 ***********************************************
     C*
     C* * * PROVIDER TYPE MUST BE 'N' FOR MEDICAL OR 'D' FOR DENTAL
     C*
     C********** SCPRTY    CABNE'N'       STRT       2828
     C********** SCPRTY    IFNE 'N'
     C********** SCPRTY    ANDNE'D'
     C**********           MOVE '1'       *IN28
     C**********           GOTO STRT
     C**********           END
     C*** END CHG *** 08/11/93 ****************************************
     C*** END DEL *** 04/15/94 *************************************************
     C*
     C*** BEGIN DEL *** 03/22/93 **************************************
     C*** BEGIN ADD *** 10/22/92 *************************************
     C**  FOR PARTICIPATING PROVIDER ONLY:
     C**  IF SCPRTY = N, THEN VERIFY AGAINST FILE PDTYPE TO MAKE
     C**  SURE PROVIDER CAN BE USED WITH THIS PROVIDER TYPE
     C*
     C********** *IN30     IFEQ '1'                        NETWORK ONLY
     C********** PDPARN    IFEQ 'P'
     C********** SCPRTY    IFEQ 'N'
     C********** PDTYPE    IFEQ '4'                        05/11/90 ADD
>>>>>C**********           MOVE '1'       *IN38            05/11/90 ADD
     C********** *IN38     CABEQ'1'       STRT
     C**********           END                             05/11/90 ADD
     C*** END DEL *** 03/22/93 ****************************************
     C*** BEGIN DEL *** 02/17/93 **************************************
     C**********           ELSE                            ELSEQ '1'
     C***********
     C**  ELSE
     C**  IF SCPRTY = H, THEN VERIFY AGAINST FILE PDTYPE TO MAKE
     C**  SURE PROVIDER CAN BE USED WITH THIS PROVIDER TYPE
     C*
     C********** PDTYPE    IFEQ '4'
>>>>>C**********           MOVE '1'       *IN38
     C********** *IN38     CABEQ'1'       STRT
     C**********           END
     C**********           END                             ENDEQ '1'
     C**********           ELSE                            ELSE PDPARN
     C********** PDTYPE    IFEQ '4'
>>>>>C**********           MOVE '1'       *IN38
     C********** *IN38     CABEQ'1'       STRT
     C*** END DEL *** 02/11/93 ****************************************
     C*** BEGIN DEL *** 03/22/93 **************************************
     C**********           END                             05/11/90 ADD
     C**********           END                             ENDEQ 'P'
     C**********           END                             IF NETWORK
     C*** END DEL *** 03/22/93 ****************************************
     C*** END ADD ***** 10/22/92 *************************************
     C*
     C*
     C*** BEGIN ADD *** TAPE SUBMISSION ***************************
     C*   IF AT LEAST ONE DETAIL CHARGE HAS BEEN ENTERED....
     C     TC(1)         IFNE      *ZERO
     C*   VERFIY THAT PROVIDER/DIAG CODES ON SCREEN ARE SAME AS FILE
     C*   IF NOT,  WRITE FILE CODES TO SCREEN WITH ERROR MESSAGE
     C                   EXSR      DCSR2
     C*
     C*** BEG DEL ***** 03/10/98 ****************************************
     C*** THIS IS HANDLED IN F0091R
     C*** AT LEAST ONE DIAGNOSIS CODE MUST BE ENTERED
     C*********  XXDC      CABEQ*BLANK    STRT           93
     C*********
     C****IF*DIAGNOSIS CODE ENTERED MUST BE VALID
     C*********            MOVE '0'       *IN91
     C*********            DO   4         Y       50
     C*********  Y         ADD  0         Y1      20
     C*********  DC,Y      IFNE *BLANK
     C*********            MOVEL*BLANK    DIKEY   5
     C*********            MOVELDC,Y      DIKEY
     C*********            MOVEL'D'       XXLOST           ADD 05/18/95
     C*********  DIKY      CHAINPDI01                60
     C*********  *IN60     IFEQ '1'
     C*********            MOVE '1'       *IN91            INVALID DIAG CODE
     C*********            MOVE '1'       *IN,Y1
     C*********            ELSE
     C*********  DISTAT    IFNE 'A'
     C*********            MOVE '1'       *IN91            INVALID DIAG CODE
     C*********            MOVE '1'       *IN,Y1
     C*********            END
     C*********            END
     C*********            END
     C*********
     C*********            END
     C*********
     C*********  *IN91     CABEQ'1'       STRT
     C*** END DEL ***** 03/10/98 ****************************************
     C*** BEGIN CHG *** 03/01/94 ****************************************
     C*
     C     SCAST         IFEQ      'FL'
     C** CHECK FOR TAPE SUBMISSION IN FS BASE CONTROL FILE
     C                   Z-ADD     1             X
     C     SCAST         LOOKUP    TAPE(X)                                60
     C     *IN60         IFEQ      '1'
     C*
     C*** IF DIAGNOSIS CODE ENTERED MUST BE NUMERIC OR A/N STARTING WITH 'V'
     C*********
     C*** BEG DEL *** 03/04/97 ***
     C*********            MOVE '0'       *IN96
     C*********  SCD1      IFNE *BLANK
     C*********            Z-ADD1         Y
     C*********  SCD1      LOKUPLT,Y                     60
     C*********  *IN60     IFEQ '0'
     C*********            MOVE '1'       *IN96            WRONG DIAG CODE
     C*********            MOVE '1'       *IN01
     C*********            END
     C*********            END
     C*********
     C*********  SCD2      IFNE *BLANK
     C*********            Z-ADD1         Y
     C*********  SCD2      LOKUPLT,Y                     60
     C*********  *IN60     IFEQ '0'
     C*********            MOVE '1'       *IN96            WRONG DIAG CODE
     C*********            MOVE '1'       *IN02
     C*********            END
     C*********            END
     C*********
     C*********  SCD3      IFNE *BLANK
     C*********            Z-ADD1         Y
     C*********  SCD3      LOKUPLT,Y                     60
     C*********  *IN60     IFEQ '0'
     C*********            MOVE '1'       *IN96            WRONG DIAG CODE
     C*********            MOVE '1'       *IN03
     C*********            END
     C*********            END
     C*********
     C*********  SCD4      IFNE *BLANK
     C*********            Z-ADD1         Y
     C*********  SCD4      LOKUPLT,Y                     60
     C*********  *IN60     IFEQ '0'
     C*********            MOVE '1'       *IN96            WRONG DIAG CODE
     C*********            MOVE '1'       *IN04
     C*********            END
     C*********            END
     C*********
     C*********  *IN96     CABEQ'1'       STRT
     C*** END DEL *** 03/04/97 ***
     C*
     C                   END                                                    END *IN60 LOKUP TP
     C                   END                                                    END SCAST = 'FL'
     C*** END CHG *** 03/01/94 *********************************************
     C                   END                                                    END TC,1 NE 0
     C*** END ADD ***** TAPE SUBMISSION ***************************
     C*
     C*** DO ERROR CHECKING FOR SCREEN ARRAYS
     C*
     C* =================================================================== *
     C*
     C*** BEGIN ADD *** 07/22/97 **************************************
     C*
     C*  SERVICE DATE CANNOT BE GREATER THAN DATE BILL WENT TO CARRIER
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN71
     C*
     C     SCDT09        IFNE      *ZEROS                                       MJF
     C***********          MOVE QQDT09    XXDT09            "
     C                   Z-ADD     SCDT09        SRDTI                           "
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXDT09
     C                   DO        10            Y
     C     SD(Y)         IFNE      *ZERO
     C     Y             ADD       49            Y1
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C*** BEG CHG *** 12/13/99 ****************************************
     C******************** MOVELSRDTO     XXSD    60
     C                   MOVEL     SRDTO         XXSD              7 0
     C*** END CHG *** 12/13/99 ****************************************
     C     XXSD          IFGT      XXDT09
     C                   MOVE      '1'           *IN(Y1)
     C                   MOVE      '1'           *IN71
     C                   ENDIF                                                  XXSD IFGT
     C                   ENDIF                                                  SD,Y IFNE
     C*
     C                   ENDDO
     C     *IN71         CABEQ     '1'           STRT
     C                   ENDIF                                                  SCDT09 IFNE
     C*
     C*** END ADD *** 07/22/97 ****************************************
     C*
     C*** IF TOT CHG NOT ENTERED BUT OTHER FIELDS ARE, ERROR CONDITION
     C***   IF TOTAL CHARGES ARE BLANK, ALL OTHER FIELDS SHOULD BE ALSO ...
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN39
     C*
     C                   DO        10            Y                 5 0
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C     TC(Y)         IFEQ      *ZERO                                        TOTAL CHARGES
     C**
     C     IO(Y)         IFNE      *BLANK                                       FLAG
     C     SD(Y)         ORNE      *ZERO                                        SERVICE DATE
     C     PM(Y)         ORNE      *BLANK                                       PROC MODF
     C     CP(Y)         ORNE      *BLANK                                       CODE
     C     AL(Y)         ORNE      *ZERO                                        TOTAL ALLOW
     C*** DEL NEXT LINE *** TAPE SUBMISSION ***************************
     C*********  EC,Y      ORNE *BLANK                     EOB CODES
     C     UN(Y)         ORNE      *ZERO                                        UNITS
     C     PA(Y)         ORNE      *BLANK                                       PART CODE
     C     TS(Y)         ORNE      *BLANK                                       TOS CODE
     C                   MOVE      '1'           *IN39
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C*
     C                   END
     C*
     C     *IN39         CABEQ     '1'           STRT
     C*
     C* =================================================================== *
     C*
     C* * * SERVICE DATES MUST BE VALID & ON OR AFTER ACCIDENT DATE.
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN23
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C*
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C***************      MOVELSRDTO     SD,Y              MJF
     C*
     C     SRERR         IFEQ      '1'
     C                   MOVE      '1'           *IN23
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C                   END
     C*
     C     *IN23         CABEQ     '1'           STRT
     C*
     C* =================================================================== *
     C*
     C* * * SERVICE DATES MUST BE GE ACCIDENT DATE.
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN26
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     SD(Y)         IFGT      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C*
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWKDT1
     C     XWKDT1        IFLT      XXACDT
     C                   MOVE      '1'           *IN26
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C*
     C                   END
     C                   END
     C     *IN26         CABEQ     '1'           STRT
     C*
     C*** BEG DEL *** 07/01/98 ****************************************
     C*** BEGIN ADD *** 05/07/98 **************************************
     C* =================================================================== *
     C**********
     C* * * SERVICE DATES MUST BE LE SYSTEM DATE.
     C**********           MOVEA'00000000'*IN,50
     C**********           MOVEA'00'      *IN,58
     C**********           MOVE '0'       *IN28
     C**********
     C**********           TIME           DSDTTM
     C**********           Z-ADDDSDATE    SRDTI
     C**********           CALL 'SRCVTDAT'DTCYMD
     C**********           MOVELSRDTO     HDSYDT  70
     C**********
     C**********           DO   10        Y       50
     C********** TC,Y      IFNE *ZERO
     C**********
     C********** SD,Y      IFGT *ZERO
     C**********
     C********** Y         ADD  49        Y1      20
     C**********
     C**********
     C**********           Z-ADDSD,Y      SRDTI
     C**********           CALL 'SRCVTDAT'DTCYMD
     C**********           MOVELSRDTO     XWKDT1
     C********** XWKDT1    IFGT HDSYDT
     C**********           MOVE '1'       *IN28
     C**********           MOVE '1'       *IN,Y1
     C**********           END
     C**********
     C**********           END
     C**********
     C**********           END
     C**********           END
     C********** *IN28     CABEQ'1'       STRT
     C*** END ADD *** 05/07/98 ****************************************
     C*** END DEL *** 07/01/98 ****************************************
