     C********** IO,Y      ANDNE'3'
     C********** IO,Y      ANDNE'4'
     C********** IO,Y      ANDNE'5'
     C********** IO,Y      ANDNE'6'
     C********** IO,Y      ANDNE'7'
     C********** IO,Y      ANDNE'8'
     C********** IO,Y      ANDNE'9'
     C********** IO,Y      ANDNE'0'
