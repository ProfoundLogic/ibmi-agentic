     C**********           Z-ADD*ZEROS    Z3TOTC           REMAINDER TOT CHRG
     C*** END ADD ***** 12/28/92 ****************************************
     C*** BEGIN ADD *** 12/07/92 **************************************
     C********** SCAST     IFEQ 'FL'                       DEL 04/29/93
     C********** ST1A1     IFEQ 'Y'                        ADD 04/29/93
     C********** HUT,X     IFGT 1
     C********** HTC,X     DIV  HUT,X     HTC,X
     C**********           ELSE
     C**********           Z-ADD1         HUT,X
     C**********           END
     C**********           Z-ADD*ZEROS    CAUNTS
     C*
     C**********           Z-ADD*ZEROS    CAANMN
     C**********           MOVE HTC,X     CATOTC
     C*
     C********** HUT,X     DOWGE1
     C*
     C*** BEGIN ADD *** 12/28/92 ***********************************************
     C**********           ADD  CATOTC    Z2TOTC
     C********** HUT,X     IFEQ 1
     C********** Z1TOTC    ANDNEZ2TOTC
     C********** Z1TOTC    SUB  Z2TOTC    Z3TOTC
     C********** CATOTC    ADD  Z3TOTC    CATOTC           PUT REMAINDER IN LAST
     C**********           END                             END HUT,X EQ 1
     C*** END ADD ***** 12/28/92 ***********************************************
     C*
     C**********           ADD  1         HHDSEQ
     C**********           MOVE HHDSEQ    CADSEQ
     C*
     C********** XXDSEQ    IFEQ *ZERO
     C**********           Z-ADDHHDSEQ    XXDSEQ
     C**********           END
     C*** BEGIN OF ADD ***10/22/92*** MDG
