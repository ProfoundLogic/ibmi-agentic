     C*******************************************
     C***********   SCR03 = CHANGE RECORD         *
     C*******************************************
     C*********  Q2RECF    IFEQ 'SCR03'
     C*********
     C*********  CHECK CURSOR POSTION
     C*********
     C*********  Q2CPOS    DIV  256       LIN     20
     C*********  LIN       SUB  7         I1      30
     C*********
     C*********  VALID CURSOR POSITION - RETURN WITH NO SELECTION
     C*********
     C*********  I1        IFGE 1
     C*********  I1        ANDLE14
     C*********  I1        ANDNE05
     C*********  I1        ANDNE10
     C*********
     C*********  I1        IFLE 4
     C*********            Z-ADD1         I1
     C*********            END
     C*********
     C*********  I1        IFGE 6
     C*********  I1        ANDLE9
     C*********            Z-ADD2         I1
     C*********            END
     C*********
     C*********  I1        IFGE 11
     C*********            Z-ADD3         I1
     C*********            END
     C*********
     C*********  I1        IFEQ 1
     C*********  *IN04     ANDEQ'0'
     C*********            MOVE SQ,1      SCSEQN
     C*********            MOVE SQ,1      XXKEY
     C*********            MOVE '1'       *IN08
     C*********            MOVELUA,2      SCMODE
     C*** BEGIN ADD *** 06/19/92 **************************************
     C*********** ALLOW CHANGE OF DESCRIPTION IF PRTY = H
     C*********  PR,1      IFEQ 'H'
     C*********            MOVE '1'       *IN10
     C*********            ELSE
     C*********            MOVE '0'       *IN10
     C*********            END
     C*** END ADD *** 06/19/92 ****************************************
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  I1        IFEQ 2
     C*********  *IN05     ANDEQ'0'
     C*********            MOVE SQ,2      SCSEQN
     C*********            MOVE SQ,2      XXKEY
     C*********            MOVE '1'       *IN08
     C*********            MOVELUA,2      SCMODE
     C*** BEGIN ADD *** 06/19/92 **************************************
     C* ALLOW CHANGE OF DESCRIPTION IF PRTY = H
     C*********  PR,2      IFEQ 'H'
     C*********            MOVE '1'       *IN10
     C*********            ELSE
     C*********            MOVE '0'       *IN10
     C*********            END
     C*** END ADD *** 06/19/92 ****************************************
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  I1        IFEQ 3
     C*********  *IN06     ANDEQ'0'
     C*********            MOVE SQ,3      SCSEQN
     C*********            MOVE SQ,3      XXKEY
     C*********            MOVE '1'       *IN08
     C*********            MOVELUA,2      SCMODE
     C*** BEGIN ADD *** 06/19/92 **************************************
     C********** ALLOW CHANGE OF DESCRIPTION IF PRTY = H
     C*********  PR,3      IFEQ 'H'
     C*********            MOVE '1'       *IN10
     C*********            ELSE
     C*********            MOVE '0'       *IN10
     C*********            END
     C*** END ADD *** 06/19/92 ****************************************
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  INVALID CURSOR POSITION - RETURN WITH NO SELECTION
     C*********
     C*********            END
     C*********
     C*********            GOTO STRT
     C*********            END
     C*** END   DEL *** 10/09/92 **************************************
     C*** BEGIN ADD *** 04/08/93 **************************************
     C***********************************
     C*   SCRRX - MEASURE CONVERSION    *
     C***********************************
     C     Q2RECF        IFEQ      'SCRRX'
     C*
     C                   MOVE      *BLANKS       Q2RECF
     C                   MOVEL     'WDWCMV'      Q2RECF
     C                   EXFMT     WDWCNV
     C     *INKL         CABEQ     '1'           PREV
     C                   MOVE      *BLANKS       Q2RECF
