     C                   MOVE      '0'           *IN57
     C                   MOVE      '0'           *IN58
     C                   MOVE      '0'           *IN59
     C                   MOVE      '0'           *IN64
     C                   MOVE      '0'           *IN80
     C                   MOVE      '0'           *IN89
     C*** END ADD *** 07/26/95 *************************************************
