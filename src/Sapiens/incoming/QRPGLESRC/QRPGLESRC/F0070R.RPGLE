     C*** END ADD ***** 04/12/91 **************************************
     C*** BEGIN ADD *** 10/09/92 **************************************
     C*
      *====================================================================*
      * * *   INIT3 Subroutine                                I N I T 3  ***
      *====================================================================*
     C     INIT3         BEGSR
     C*
     C                   Z-ADD     0             RRN3              5 0
     C                   Z-ADD     0             XRRN3             5 0
     C                   Z-ADD     0             XXRRN3            5 0
     C*
     C*   Initialize Command Line Display
     C*
     C                   Z-ADD     1             C3
     C  N30              MOVEL     CK3(C3)       SCCML3
     C   30              MOVEL     CK3A(C3)      SCCML3
     C*
     C*   Set initial display date to blanks.
     C*      Initialize date work variables.
     C*
     C                   Z-ADD     *ZEROS        SCSDAT
     C                   Z-ADD     *ZEROS        XXSDAT
     C                   Z-ADD     *ZEROS        XHSDAT
     C*
     C*   Clear Subfile
     C*
     C                   MOVE      '1'           *IN04
     C                   WRITE     SCR03C
     C                   MOVE      '0'           *IN04
     C*
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCR03'       Q2RECF
     C*
     C     CAKYN1        SETLL     PCA0N                              60
     C*
     C                   EXSR      LOAD3                                        LOAD RCDS FROM FILE
     C*
     C                   ENDSR
     C*** BEGIN ADD *** 05/18/95 ***********************************************
     C**************************************************************************
     C* I N I T 0 4  - SUBROUTINE TO INITALIZE SCR04 SCREEN DATA               *
     C**************************************************************************
     C     INIT04        BEGSR
     C*
     C                   Z-ADD     0             RRN4
     C                   Z-ADD     0             XXRRN4
     C*
     C* CLEAR SUBFILE
     C*
     C                   MOVE      '1'           *IN14
     C                   WRITE     SCR04C
     C                   MOVE      '0'           *IN14
     C*
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCR04'       Q2RECF
     C*
     C                   EXSR      LOAD04
     C*
     C                   ENDSR
     C*** END ADD *** 05/18/95 *************************************************
      *====================================================================*
      * * *   LOAD3 SUBROUTINE                                    L O AD ***
      *====================================================================*
     C     LOAD3         BEGSR
     C*
     C                   MOVE      '0'           *IN05
     C                   MOVE      '0'           *IN32
     C                   MOVE      '0'           *IN45
     C                   MOVE      *BLANK        SCSEL
     C*
     C*   Position Cursor flag - used to check if the 1st subfile RRN
     C*     of the current page needs to be saved.
     C*
     C                   MOVE      'Y'           PCFL              1
     C*
     C*   Load date in case it has been changed by the user
     C*
     C                   Z-ADD     SCSDAT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXSDAT
     C*
     C*   Convert the provider type
     C*
     C*** BEGIN CHG *** 04/15/94 ***********************************************
     C********** SCPRTY    IFEQ 'N'
     C********** SCPRTY    OREQ 'X'                        ADD 04/08/93
     C********** SCPRTY    OREQ 'D'                        ADD 08/11/93
     C     H1RECF        IFEQ      'SCR02'
     C                   MOVE      '1'           XXPRTY
     C                   MOVE      '0'           *IN42
     C                   ELSE
     C                   MOVE      '4'           XXPRTY
     C                   MOVE      '1'           *IN42
     C                   END
     C*** END CHG *** 04/15/94 *************************************************
     C*
     C*   Load the subfile screen with up to 12 lines
     C*
     C                   Z-ADD     1             X                 5 0
     C     X             DOWLE     12
     C     *IN60         ANDEQ     '0'
     C*
     C     CAKYN         READE     PCA0N                                  60
     C  N60              EXCEPT    RCA0N                                        ADD 02/11/93
     C*
     C     *IN60         IFEQ      '1'
     C                   MOVE      '1'           *IN32
     C                   END
     C*
     C     *IN60         IFEQ      '0'
     C*
     C********** CAEOB#    IFEQ *ZEROS                     DEL 07/26/95
     C     CAEOB#        IFEQ      SCEOB#                                       ADD 07/26/95
     C********** CAPRTY    ANDEQXXPRTY                   ** DEL 11/5/92
     C*** BEGIN ADD *** 09/12/97 **************************************
     C* ADDITIONAL EDITS AFTER ADJUDICATION
     C*=========================================================================
     C* IF THE TOTAL CHARGED FOR LINE ITEM IS NOT THE TOTAL PAID AND EOMB CODE
     C* MUST BE PRESENT
     C*
     C     CATOTC        SUB       CATOTD        XXPAID            9 2
     C                   SUB       CAOTHR        XXPAID
     C                   SUB       CANDIS        XXPAID
     C     XXPAID        IFNE      CATOTP
     C*
     C     CAEOMB        IFEQ      *BLANKS
     C*
     C                   Z-ADD     1             J
     C     '00000'       LOOKUP    QS(J)                                  70
     C  N70              Z-ADD     30            J
     C                   MOVEL     CADSEQ        QS(J)
     C                   MOVE      'GK'          ER(J)
     C* Err Msg GK: "Paid amt not = (charged - MRA denied - other reduct
     C* Err                            - network reduct)"
     C*
     C                   END                                                    END CAEOMB EQ BLANKS
     C*
     C                   END                                                    END CATOTP NE XXPAID
     C*=========================================================================
     C* THE PAYMENT AMOUNT CANNOT EXCEED THE CHARGED AMOUNT
     C*
     C     CATOTP        IFGT      CATOTC
     C*
     C                   Z-ADD     1             J
     C     '00000'       LOOKUP    QS(J)                                  70
     C  N70              Z-ADD     30            J
     C                   MOVEL     CADSEQ        QS(J)
     C                   MOVE      'BV'          ER(J)
     C* Err Msg BV: "The payment amount cannot exceed the charged amount."
     C*
     C                   END                                                    END CATOTP GT CATOTC
     C*=========================================================================
     C* PAYMENT AMOUNT CANNOT BE ZERO WITHOUT AN EOMB CODE
     C*
     C     CATOTP        IFEQ      0
     C*
     C     CAEOMB        IFEQ      *BLANKS
     C*
     C                   Z-ADD     1             J
     C     '00000'       LOOKUP    QS(J)                                  70
     C  N70              Z-ADD     30            J
     C                   MOVEL     CADSEQ        QS(J)
     C                   MOVE      'BY'          ER(J)
     C* Err Msg BY: "Payment amount cannot be zero without an EOMB Code."
     C*
     C                   END                                                    END CAEOMB EQ BLANKS
     C*
     C                   END                                                    END CATOTP EQ 0
     C*=========================================================================
     C* THE PAYMENT AMOUNT FOR A SINGLE LINEITEM CANNOT EXCCED $50,000.00
     C*
     C     CATOTP        IFGT      50000
     C*
     C                   Z-ADD     1             J
     C     '00000'       LOOKUP    QS(J)                                  70
     C  N70              Z-ADD     30            J
     C                   MOVEL     CADSEQ        QS(J)
     C                   MOVE      'CB'          ER(J)
     C* Err Msg CB: "The payment amount for this line items exceeds $50,000.00"
     C*
     C                   END                                                    END CATOTP GT 50000
     C*** END   ADD *** 09/12/97 **************************************
     C*
     C                   ADD       1             RRN3
     C*
     C*   Save 1st subfile RRN of the current page
     C*
     C     PCFL          IFEQ      'Y'
     C                   Z-ADD     RRN3          XXRRN3
     C                   MOVE      'N'           PCFL
     C                   END
     C*
     C                   Z-ADD     CADSEQ        SCSEQ#
     C*** BEGIN ADD *** 10/16/92 **************************************
     C                   MOVE      CADSEQ        XXSEQ#            5
     C                   MOVE      '0'           *IN44                          ADD 12/02/92
     C*** BEGIN DEL *** 12/15/97 **************************************
     C********** XXSEQ#    LOKUPQS                       50
     C********** *IN50     IFEQ '1'
     C**********           MOVE '1'       *IN44
     C**********           MOVE '1'       *IN45
     C*********************ELSE                            DEL 12/02/92
     C*********************MOVE '0'       *IN44            DEL 12/02/92
     C**********           END
     C*** BEGIN ADD *** 12/02/92 **************************************
     C********** XXSEQ#    LOKUPQSPC                     50
     C********** *IN50     IFEQ '1'
     C**********           MOVE '1'       *IN44
     C**********           MOVE '1'       *IN45
     C**********           END
     C********** XXSEQ#    LOKUPQSMD                     50
     C********** *IN50     IFEQ '1'
     C**********           MOVE '1'       *IN44
     C**********           MOVE '1'       *IN45
     C**********           END
     C********** XXSEQ#    LOKUPQSCR                     50
     C********** *IN50     IFEQ '1'
     C**********           MOVE '1'       *IN44
     C**********           MOVE '1'       *IN45
     C**********           END
     C*** END ADD *** 12/02/92 ****************************************
     C*** END DEL *** 12/15/97 ****************************************
     C*** END ADD *** 10/16/92 ****************************************
     C*** BEGIN ADD *** 12/15/97 *************************************
     C*
     C** DETERMINE IF THERE ARE ANY ERRORS IN FDMGP FOR LINE ITEM
     C*
     C                   MOVE      *BLANKS       Q3RTCD
     C                   MOVE(P)   SCCO#         Q3CO#
     C                   MOVE(P)   SCSUB#        Q3SUB#
     C                   MOVE(P)   SCFND         Q3FND
     C                   MOVE(P)   SCFND         Q3FND
