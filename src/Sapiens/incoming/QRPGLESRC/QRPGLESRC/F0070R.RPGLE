     C*** BEGIN CHG *** 04/15/94 ***********************************************
     C*   IF TYPE = 'N'
     C*
     C********** CAPRTY    IFEQ '1'
     C*** BEGIN ADD *** 04/08/93 **************************************
     C********** CARCFL    IFNE 'X'                        ADD 04/08/93
     C     CARCFL        IFEQ      'C'
     C     CARCFL        OREQ      'Y'
     C     CARCFL        OREQ      'D'                                          ADD 03/29/95
     C                   MOVEL     CACPT4        XXCPT4
     C                   MOVEL     XXPROC        SCPDCD
     C                   MOVE      CAPMOD        SCPMOD
     C                   MOVE      CARCFL        SCRCFL                         ADD 03/09/93
     C*** BEGIN CHG *** 02/17/93 **************************************
     C*********************MOVE *BLANKS   XXUNTS           DEL 02/17/93
     C     CAANMN        IFNE      *ZEROS
     C                   Z-ADD     CAANMN        SCUNT
     C                   ELSE                                                   ELSE CAANMN=0
     C     CAUNTS        IFNE      *ZEROS
     C                   Z-ADD     CAUNTS        SCUNT
     C                   END                                                    END CAUNTS NE0
     C                   END                                                    END CAANMN NE0
     C*** END CHG *** 02/17/93 ****************************************
     C                   ELSE
     C     CARCFL        IFEQ      'X'
     C                   MOVEL     HCNDC         SCPDCD
     C                   Z-ADD     HCRXMQ        SCUNT
     C                   MOVE      CAPMOD        SCPMOD
     C                   MOVE      CARCFL        SCRCFL                         ADD 03/09/93
     C                   ELSE
     C     CARCFL        IFEQ      'S'
     C     CARCFL        OREQ      'N'
     C                   Z-ADD     CASVCD        XXRVCD
     C                   MOVE      CACPT4        XXHCPC
     C                   Z-ADD     *ZEROS        XXUNIT
     C                   Z-ADD     CAUNTS        SCUNT
     C                   MOVEL     XXCMSV        SCPDCD
     C                   MOVE      *BLANKS       SCPMOD
     C                   MOVE      CARCFL        SCRCFL                         ADD 03/09/93
     C                   END                                                    END CARCFL EQ 'S,N'
     C                   END                                                    END CARCFL EQ 'X'
     C                   END                                                    END CARCFL EQ 'C,Y'
     C**********           END
     C** END ADD *** 04/08/93 *****************************************
     C**********           ELSE
     C*
     C*   ELSE TYPE = 'H'
     C*
     C**********           Z-ADDCASVCD    XXRVCD
