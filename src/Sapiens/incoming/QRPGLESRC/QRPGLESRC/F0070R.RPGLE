     C*   SCRRX - NDC DRUG CODE ALPHA SEARCH  *
     C*****************************************
     C     Q2RECF        IFEQ      'SCRRX'
     C*
     C                   DO        10            A                 5 0
     C*
     C                   MOVEL     ND(A)         XX2               2
     C     XX2           IFEQ      '? '
     C*
     C                   MOVE      *BLANKS       QQNDC            11
     C                   CALL      'F0551R'
     C                   PARM                    QQPRDS
     C                   PARM                    QQNDC
     C                   PARM                    QQRTC             1
     C*
     C                   MOVE      *BLANKS       ND(A)
     C                   MOVEL     QQNDC         ND(A)
     C     QQRTCD        CABEQ     'A'           TERM
     C**
     C** GET DESCRIPTION
     C                   MOVEL     QQNDC         XXNDC
     C     RXKEY         CHAIN     PRX01                              60
     C**
     C     *IN60         IFEQ      '0'
     C     RXCO#         ANDEQ     SCCO#
     C     RXNDC         ANDEQ     XXNDC                                        CHG 04/28/92
     C     RXSTAT        IFNE      'I'
     C                   MOVEL     RXNAME        XXDESC           21
     C                   MOVEL     XXDESC        DS(A)
     C                   MOVE      RXMEAS        DS(A)
     C                   ELSE
     C                   MOVEL     *BLANK        DS(A)
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANKS       DS(A)
     C                   END
     C*
     C                   Z-ADD     1             T                 2 0
     C     RXPTYP        LOOKUP    PTYP(T)                                60
     C     *IN60         IFEQ      '1'
     C                   MOVEL     PTYD(T)       BG(A)
     C                   ELSE
     C                   MOVE      *BLANKS       BG(A)
     C                   END
     C**
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCRRX'       Q2RECF
     C                   GOTO      STRT
     C                   END
     C                   END
     C**
     C                   END                                                    ENDIF SCRRX
