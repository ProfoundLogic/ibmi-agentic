     C**********           Z-ADD*ZEROS    XXUNIT
     C**********           Z-ADDCAUNTS    SCUNT
     C**********           MOVELXXCMSV    SCPDCD
     C**********           MOVE *BLANKS   SCPMOD
     C**********           MOVE *BLANK    SCRCFL           ADD 03/09/93
     C**********           END
     C*** END CHG *** 04/15/94 *************************************************
     C*
     C                   MOVE      '0'           *IN43                          ADD 02/22/93
     C*** BEGIN CHG *** 04/01/93 **********************************
     C     CACPT4        IFEQ      'FSMRA'
     C                   Z-ADD     *ZEROS        SCTOTC
     C                   ELSE
     C                   Z-ADD     CATOTC        SCTOTC
     C                   END                                                     END EQ FSMRA
     C*** END CHG ***** 04/01/93 **********************************
     C                   Z-ADD     CATOTP        SCTOTP
     C                   MOVE      CAPART        SCPART
     C**********           MOVE CAIPOP    SCIPOP           DEL 05/18/95
     C*** BEGIN ADD *** 03/16/93 **************************************
     C                   Z-ADD     CAOTHR        SCOTHR
     C                   Z-ADD     CANDIS        SCNDIS
     C                   Z-ADD     CATOTD        SCMRAR
     C     *IN39         IFEQ      '1'
     C*** BEGIN CHG *** 07/12/99 **************************************
     C**********           Z-ADDSCMRAR    SCAMT1
     C**********           Z-ADDSCOTHR    SCAMT2
     C**********           Z-ADDSCNDIS    SCAMT3
     C*
     C                   MOVEL(P)  SCMRAR        ##NUM
     C                   CALL      CHGNUM        CNUMPL
     C                   MOVEL     ##NUM         XXMRAR
     C*
     C                   MOVEL(P)  SCOTHR        ##NUM
     C                   CALL      CHGNUM        CNUMPL
     C                   MOVEL     ##NUM         XXOTHR
     C*
     C                   MOVEL(P)  SCNDIS        ##NUM
     C                   CALL      CHGNUM        CNUMPL
     C                   MOVEL     ##NUM         XXNDIS
     C*
     C                   MOVEA     *BLANKS       DAT
     C*
     C     SCMRAR        IFNE      *ZEROS
     C*
     C                   MOVEA     XXMRAR        DAT(1)
     C*
     C                   ENDIF
     C*
     C     SCOTHR        IFNE      *ZEROS
     C*
     C                   MOVEA     XXOTHR        DAT(11)
     C*
     C                   ENDIF
     C*
     C     SCNDIS        IFNE      *ZEROS
     C*
     C                   MOVEA     XXNDIS        DAT(21)
     C*
     C                   ENDIF
     C*
     C                   MOVEA     DAT           SCDATA
     C*** END   CHG *** 07/12/99 **************************************
     C                   MOVE      SCTOS3        SCEOMB                         ADD 06/16/94
     C                   ELSE
     C*** BEGIN CHG *** 07/12/99 **************************************
     C**********           Z-ADDSCTOTC    SCAMT1
     C**********           Z-ADDSCTOTP    SCAMT2
     C                   MOVEL(P)  SCTOTC        ##NUM
     C                   CALL      CHGNUM        CNUMPL
     C                   MOVEL     ##NUM         X1TOTC           11
     C*
     C                   MOVEL(P)  SCTOTP        ##NUM
     C                   CALL      CHGNUM        CNUMPL
     C                   MOVEL     ##NUM         X1TOTP           11
     C*
     C                   MOVEA     *BLANKS       DAT
     C*
     C     SCTOTC        IFNE      *ZEROS
     C*
     C                   MOVEA     X1TOTC        DAT(2)
     C*
     C                   ENDIF
     C*
     C     SCTOTP        IFNE      *ZEROS
     C*
     C                   MOVEA     X1TOTP        DAT(14)
     C*
     C                   ENDIF
     C*
     C                   MOVEA     DAT           SCDATA
     C**********           Z-ADD*ZEROS    SCAMT3
     C*** END   CHG *** 07/12/99 **************************************
     C                   MOVE      SCEOB3        SCEOMB                         CHG 06/16/94
     C                   END
     C*** END ADD *** 03/16/93 ****************************************
     C*
     C                   MOVE      '0'           *IN06
