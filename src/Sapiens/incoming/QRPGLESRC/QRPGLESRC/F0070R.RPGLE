     C* =================================================================== *
     C* OF NDC CODE ENTERED MUST BE VALID
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN34
     C*
     C                   DO        10            Y
     C     T2(Y)         IFNE      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C     ND(Y)         IFNE      *BLANK
     C                   MOVE      *BLANKS       XXNDC
     C                   MOVEL     ND(Y)         XXNDC
     C*
     C     RXKEY         CHAIN     PRX01                              60
     C     *IN60         IFEQ      '1'
     C     RXCO#         ORNE      SCCO#
     C     RXNDC         ORNE      XXNDC                                        CHG 04/28/92
     C     RXSTAT        OREQ      'I'
     C                   MOVE      '1'           *IN34
     C                   MOVE      '1'           *IN(Y1)
