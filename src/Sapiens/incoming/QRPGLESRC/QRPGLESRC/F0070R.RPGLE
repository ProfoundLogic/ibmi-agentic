     C     XHDATE        IFLT      XHFRDT
     C                   Z-ADD     XHDATE        XHFRDT
     C                   END
     C     XHDATE        IFGT      XHTODT
     C                   Z-ADD     XHDATE        XHTODT
     C                   END
     C                   END                                                    ENDNE *ZERO
     C*
     C     SCAST         IFEQ      'AL'
     C     SCPRTY        ANDEQ     'H'
