     C*****                MOVE *BLANKS   Q2RECF
     C*****                MOVEL'SCR01'   Q2RECF
     C*****                GOTO STRT
     C*****
     C*****                END                             END QQRTCD EQ 1
     C*****
     C*****                MOVE *BLANKS   Q2RECF
     C*****                MOVEL'SCR03'   Q2RECF
     C*****                MOVE *ZEROS    XXAUDF
     C*****                MOVE Q3AUDF    XXAUDF
     C*****      XXAUDF    ADD  1         XXAUDF
     C*****                MOVELXXPOST    SCCSCD
     C*****                Z-ADDSCYR      SCFYR
     C*****                MOVE '1'       *IN40
     C*****                EXSR DCSRA
     C*****                EXSR INIT3
     C*****                GOTO STRT
     C*****
     C*****                END                             END Q2RECF EQ SCR01
     C*****
     C****BEGIN DEL *** 10/09/92 **************************************
     C**********************************************
     C************* SCR03 - DELETE RECORD          *
     C**********************************************
     C*********  Q2RECF    IFEQ 'SCR03'
     C*********
     C*********
     C*********  CHECK CURSOR POSTION
     C*********
     C*********  Q2CPOS    DIV  256       LIN     20
     C*********  LIN       SUB  7         I1      30
     C*********
     C***VALID CURSOR POSITION - RETURN WITH NO SELECTION
     C*********
     C*********  I1        IFGE 1
     C*********  I1        ANDLE14
     C*********  I1        ANDNE05
     C*********  I1        ANDNE10
     C*********
     C*********  I1        IFLE 4
     C*********            Z-ADD1         I1
     C*********            END
     C*********
     C*********  I1        IFGE 6
     C*********  I1        ANDLE9
     C*********            Z-ADD2         I1
     C*********            END
     C*********
     C*********  I1        IFGE 11
     C*********            Z-ADD3         I1
     C*********            END
     C*********
     C*********  I1        IFEQ 1
     C*********  *IN04     ANDEQ'0'
     C*********            MOVE SQ,1      SCSEQN
     C*********            MOVEA'11'      *IN,07
     C*********            MOVELUA,3      SCMODE
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  I1        IFEQ 2
     C*********  *IN05     ANDEQ'0'
     C*********            MOVE SQ,2      SCSEQN
     C*********            MOVEA'11'      *IN,07
     C*********            MOVELUA,3      SCMODE
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  I1        IFEQ 3
     C*********  *IN06     ANDEQ'0'
     C*********            MOVE SQ,3      SCSEQN
     C*********            MOVEA'11'      *IN,07
     C*********            MOVELUA,3      SCMODE
     C*********            GOTO REPOS
     C*********            END
     C*********
     C*********  INVALID CURSOR POSITION - RETURN WITH NO SELECTION
     C*********
     C*********            END
     C*********
     C*********            GOTO STRT
     C*********            END                             ENDIF SCR03
     C*********
     C**********           GOTO STRT
     C****END   DEL *** 10/09/92 **************************************
     C*****                END                             ENDIF *INKX
