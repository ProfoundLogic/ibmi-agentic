     C*****                PARM           Q3EOB#  9
     C*****                PARM           Q3AR    1
     C*****                PARM           Q3AUDF  2
     C*****                PARM           QQTOB   3
     C*****                PARM           QQDHR   2
     C*****                PARM           QQPMTH  1
     C*****                PARM           QQTOS   3
     C*****                PARM           QQPRC1  5
     C*****                PARM           QQPRC2  5
     C*****                PARM           QQPRC3  5
     C*****                PARM           QQPRC4  5
     C*****                PARM           QQADDT  6
     C*****                PARM           QQCFRM  6
     C*****                PARM           QQCTO   6
     C*****                PARM           Q3RTCD  1
     C*****
     C**IF*NO PRE-AUDIT EXISTS THEN POST AUDIT MAY NOT BE DONE
     C*****
     C*****      QQRTCD    IFEQ '1'
     C*****
     C*****      LOKEY     CHAINPLO01                60
     C*****      *IN60     IFEQ *OFF
     C*****      LCKOUT    ANDEQ'1'
     C*****                DELETPLO01
     C*****                MOVE '0'       LCKOUT
     C*****                END
