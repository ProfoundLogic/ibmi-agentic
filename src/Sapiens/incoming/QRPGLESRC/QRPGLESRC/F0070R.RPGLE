     C     SCAST         OREQ      'TX'
     C     SCPRTY        ANDEQ     'H'
     C*** END ADD *** 08/16/95 ****************************************
     C* Recreate new FS MRA vs. Payment Difference
     C                   EXSR      CRTDIF
     C                   END
     C*
     C     '00000'       LOOKUP    QS                                 15        AT LEAST 1 ERR
     C     *IN15         IFEQ      '0'
     C     '00000'       LOOKUP    QSPC                               15
     C                   END
     C                   Z-ADD     SCYR          SCFYR
     C                   EXSR      INIT3
     C                   GOTO      STRT
     C*
     C                   END                                                    END SCR04
     C*** END ADD *** 05/18/95 *************************************************
     C                   END                                                    ENDIF *INKR
     C*** BEGIN ADD *** PEND LETTER *******************************
     C******************************
     C*     F18                    *
     C******************************
     C     *INKS         IFEQ      '1'
     C*** BEGIN ADD *** 04/01/93 **************************************
     C********************************************
     C*  SCR01 - PROV CURRENT CHARGES SEARCH     *
     C********************************************
     C*** BEG DEL *** 3/04/97 ****
     C*******
     C*******    Q2RECF    IFEQ 'SCR01'
     C*******
     C*******    SCACDT    MULT 10000.01  XXACDT
     C*******
     C****Check for multiple cases under the same SS#/ACDT
     C*******              Z-ADD*ZEROS    CNTCAS  30
     C*******    CMKEY     CHAINPCM01                27     SS#/ACDT KEY
     C*******    *IN27     DOWEQ'0'
     C*******              ADD  1         CNTCAS
     C*******    CMKEY     READEPCM01                    27
     C*******              END
     C*******
     C****If*no hit, this is an invalid SS#/ACDT - Send Error Message (*IN27)
     C****Else, setof *IN27 so message is not displayed
     C*******    CNTCAS    IFEQ *ZEROS
     C*******              GOTO STRT
     C*******              ELSE
     C*******              MOVE '0'       *IN27
     C*******              END
     C*******
     C****If*there is more than 1 case, then display "Multi Case" Search F0579F
     C*******    CNTCAS    IFGT 1
     C*******              MOVE SCSS#     QTSS#
     C*******              MOVE SCACDT    QTACDT
     C*******              MOVE *BLANKS   QTFND
     C*******              MOVE *BLANKS   QTFYR
     C*******              MOVE *BLANKS   QTCASE
     C*******              CALL 'F0579R'
     C*******              PARM           QTPRDS 40
     C*******              PARM           QTCALL  1
     C*******              PARM           QTSS#   9
     C*******              PARM           QTACDT  6
     C*******              PARM           QTFND   3
     C*******              PARM           QTFYR   3
     C*******              PARM           QTCASE  7
     C*******              PARM           QTRTCD  1
     C*******
     C*******              WRITESCR99
     C*******              MOVE *BLANK    Q2RECF
     C*******              MOVEL'SCR01'   Q2RECF
     C*******
     C*******    QTRTCD    IFEQ 'A'
     C*******    QTRTCD    OREQ 'B'
     C*******    QTFND     OREQ *BLANKS
     C*******              MOVE '1'       *IN27
     C*******              GOTO STRT
     C*******              END                             END EQ A/B/*BLANKS
     C*******
     C*******    QTRTCD    IFEQ '*'
     C*******              MOVE QTFND     XXFND
     C*******              MOVE QTFYR     XXFYR
     C*******              MOVE QTCASE    SCCASE
     C*******    CMKEY2    CHAINPCM02                27
     C*******    *IN27     CABEQ'1'       STRT
     C*******              END                             END EQ *
     C*******
     C*******              END                             END GT 1
     C*******
     C*******              MOVE *BLANKS   Q2CO#
     C*******              MOVE *BLANKS   Q2SUB#
     C*******              MOVE *BLANKS   Q2FND
     C*******              MOVE *BLANKS   Q2FYR
     C*******              MOVE *BLANKS   Q2CASE
     C*******              MOVE *BLANKS   Q2FEIN
     C*******              MOVE *BLANKS   Q2MOD
     C*******
     C*******              MOVE UPCO#     Q2CO#
     C*******              MOVE SCSUB#    Q2SUB#
     C*******              MOVE SCFND     Q2FND
     C*******              MOVE CMFYR     Q2FYR
     C*******              MOVE CMCASE    Q2CASE
     C*******              MOVE SCFEIN    Q2FEIN
     C*******              MOVE SCMOD     Q2MOD
     C*******              CALL 'F0582R'
     C*******              PARM           QQPRDS
     C*******              PARM           Q2CO#
     C*******              PARM           Q2SUB#
     C*******              PARM           Q2FND
     C*******              PARM           Q2FYR
     C*******              PARM           Q2CASE
     C*******              PARM           Q2FEIN
     C*******              PARM           Q2MOD
     C*******              PARM ' '       Q2RTCD  1
     C*******
     C*******    QQRTCD    CABEQ'A'       TERM
     C*******
     C*******              WRITESCR99
     C*******              MOVE *BLANK    Q2RECF
     C*******              MOVEL'SCR01'   Q2RECF
     C*******
     C*******    QQRTCD    IFEQ 'B'
     C*******              GOTO STRT
     C*******              END
     C*******
     C*******    Q2RTCD    IFEQ '*'
     C****BEGIN ADD *** 10/14/93 **************************************
     C*******              MOVE Q2FEIN    SCFEIN
     C*******              MOVE Q2MOD     SCMOD
     C****END ADD *** 10/14/93 ****************************************
     C*******              GOTO STRT
     C*******              END
     C*******
     C*******              END                             END SCR01
     C*** END DEL *** 3/04/97 ****
     C*** END ADD *** 04/01/93 ****************************************
