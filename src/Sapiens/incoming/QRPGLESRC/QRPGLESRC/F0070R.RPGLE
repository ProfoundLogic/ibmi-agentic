     C*** BEGIN ADD*** 01/05/95 ************************************************
     C*
     C* SERVICE DATE MUST BE FOR A VALID FEE SCHEDULE DATE
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN37
     C*
     C                   DO        10            Y                 5 0
     C     T2(Y)         IFNE      *ZERO
     C*
     C     SD(Y)         IFGT      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C* Determine what type of Provider we are working with (Specialty Code)
     C* SCR02
     C*
     C     HXRECF        IFEQ      'SCR02'
     C                   MOVE      'P'           XXATYP                         Default Health Prov
     C     SCSPCD        IFEQ      'ASC'
     C     STOVR         ANDEQ     'FL'
     C                   MOVE      'A'           XXATYP                         Ambulatory Surg Ctr
     C                   END                                                    END EQ 'ASC'
     C     SCSPCD        IFEQ      'ASC'
     C     STOVR         ANDEQ     'AL'
     C                   MOVE      'A'           XXATYP                         Ambulatory Surg Ctr
     C                   END                                                    END EQ 'ASC'
     C     SCSPCD        IFEQ      'DIA'
     C     STOVR         ANDEQ     'AL'
     C                   MOVE      'I'           XXATYP                         Diagnostic Center
     C                   END                                                    END EQ 'DIA'
     C*** BEG CHG *** 09/17/98 ****************************************
