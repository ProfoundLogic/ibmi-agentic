     C                   GOTO      STRT
     C*
     C                   END                                                    ENDIF SCRRX
     C*** END ADD *** 03/16/93 ****************************************
     C                   GOTO      STRT
     C                   END                                                    ENDIF *INKH
     C***********************************
     C*   F9                            *
     C***********************************
     C     *INKI         IFEQ      '1'
     C************************************
     C*   SCR01 = ALPHA SEARCH           *
     C************************************
     C*** BEG DEL *** 3/04/97 ****
     C*********
     C*********  Q2RECF    IFEQ 'SCR01'
     C****BEGIN CHG *** 05/20/94 ***********************************************
     C**********           CALL 'F0578R'
     C**********           PARM           QQPRDS
     C**********           PARM           QQCALL
     C**********           PARM           SCSS#
     C**********           PARM           QQRTCD  1
     C********** QQRTCD    CABEQ'A'       TERM
     C*********
     C**********           WRITESCR99
     C**********           MOVE *BLANK    Q2RECF
     C**********           MOVEL'SCR01'   Q2RECF
     C*********
     C********** QQRTCD    IFEQ 'B'
     C********** SCSS#     OREQ *BLANK
     C**********           GOTO STRT
     C**********           END                             ENDEQ 'B'
     C*********
     C********** QQRTCD    CABEQ'*'       SRTAG
     C*********            CALL 'F0578R1'
     C*********            PARM           QQPRDS
     C*********            PARM           QQCALL
     C*********            PARM           SCSS#
     C*********            PARM           SCACDT
     C*********            PARM           SCSUB#
     C*********            PARM           SCFND
     C*********            PARM           QQFYR
     C*********            PARM           QQCASE
     C*********            PARM           QQRTCD  1
     C*********  QQRTCD    CABEQ'A'       TERM
     C*********
     C*********            WRITESCR99
     C*********            MOVE *BLANK    Q2RECF
     C*********            MOVEL'SCR01'   Q2RECF
     C*********
     C*********  QQRTCD    IFEQ 'B'
     C*********  SCSS#     OREQ *BLANK
     C*********            GOTO STRT
     C*********            END                             ENDEQ 'B'
     C*********
     C*********  QQRTCD    IFEQ '*'
     C*********            MOVE UPCO#     QQCO#   3
     C*********            MOVE SCSUB#    Q1SUB#  5        ADD 06/29/94
     C*********            MOVE SCFND     Q1FND   3
     C*********            CALL 'F0006R2'                  CHG 06/29/94
     C*********            PARM           QQCO#
     C*********            PARM           Q1SUB#           ADD 06/29/94
     C*********            PARM           Q1FND
     C*********            PARM           QQRTCD
     C*********            MOVE '1'       *IN47            POS CURSOR PROV
     C*********            GOTO TOP
     C*********            END
     C****END*CHG *** 05/20/94 *************************************************
     C*********
     C*********            END                             ENDEQ SCR01
     C*** END DEL *** 3/04/97 ****
     C***********************************
     C*   SCR02  = PROCEDURE CODE SRCH  *
     C***********************************
     C     Q2RECF        IFEQ      'SCR02'
     C*
     C*  IF A CHANGE IN PROVIDER/MODIFIER, THEN CALL SUBROUTINE SRPRMO
     C*********            MOVE KY2,1     Z1
     C*********  SCFEIN    IFNE HFE,Z1
     C*********  SCMOD     ORNE HMO,Z1
     C*********            MOVEL'SCR02'   HLDSCN
     C*********            EXSR SRPRMO
     C*********            EXSR OVRST
     C*********            END
     C*
     C                   DO        10            A                 5 0
     C*
     C                   MOVEL     CP(A)         XX2               2
     C     XX2           IFEQ      '? '
     C*
     C                   MOVE      *BLANKS       QQCPT4            5
     C                   MOVE      *ZEROS        QQFDAT
     C                   CALL      'F0520R'
     C                   PARM                    QQPRDS
     C                   PARM                    QQCALL
     C                   PARM                    QQCPT4
     C                   PARM                    QQFDAT
     C                   PARM                    SCAST                          ADD 04/08/93
     C                   PARM                    QQRTCD            1
     C                   MOVEL     QQCPT4        CP(A)
     C** GET DESCRIPTION
     C                   MOVE      QQCPT4        XXCPCD
     C                   Z-ADD     SD(A)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXFDAT
     C     PRKEY         SETGT     PPR01
     C     NXTPR1        TAG
     C                   READP     PPR01                                  60
     C     *IN60         IFEQ      '0'
     C     PRCO#         ANDEQ     SCCO#
     C     PRCPT4        ANDEQ     XXCPCD
     C     PRSTAT        IFNE      'I'
     C                   MOVEL     PRDSC1        DS(A)
     C                   ELSE
     C                   GOTO      NXTPR1
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANK        DS(A)
     C                   END
     C***
     C     QQRTCD        CABEQ     'A'           TERM
     C*
     C                   WRITE     SCR99
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCR02'       Q2RECF
     C                   GOTO      STRT
     C                   END
     C                   END
     C*
     C                   END                                                    ENDIF SCR02
     C***********************************
     C*   SCR03  = ADD RECORDS          *
     C***********************************
     C     Q2RECF        IFEQ      'SCR03'
     C*** BEGIN ADD *** 10/09/92 **************************************
     C     Q2RECF        OREQ      'SCR03S'
     C     Q2RECF        OREQ      'SCR03C'
     C*** END   ADD *** 10/09/92 **************************************
     *** BEG ADD *** 10/18/99 *****************************************
     C                   MOVE      'Y'           XXFRST
     *** END ADD *** 10/18/99 *****************************************
     C*
     C                   EXSR      INIT
     C                   MOVE      *BLANKS       Q2RECF
     C*** BEGIN CHG *** 04/15/94 ***********************************************
     C*
     C*** BASED UPON SCREEN PROVIDER TYPE (SCPRTY) RETURN TO:
     C********** SCPRTY    IFEQ 'N'
     C********** SCPRTY    OREQ 'D'                        ADD 08/11/93
     C**********           MOVEL'SCR02'   Q2RECF
     C**********           ELSE                            ELS EQ 'N'
     C********** SCPRTY    IFEQ 'H'
     C**********           MOVEL'SCR04'   Q2RECF
     C**********           ELSE
     C********** SCPRTY    IFEQ 'X'
     C**********           MOVEL'SCRRX'   Q2RECF
     C**********           END                             END EQ 'X'
     C**********           END                             END EQ 'H'
     C**********           END                             END EQ 'N'
     C                   MOVEL     H1RECF        Q2RECF
     C     Q2RECF        IFEQ      'SCR04'
     C     Q2RECF        OREQ      'SCR04C'
     C     Q2RECF        OREQ      'SCR04S'
     C                   EXSR      INIT04
     C                   END
     C*** END CHG *** 04/15/94 *************************************************
     C*** BEGIN CHG *** 08/09/95 ***********************************************
     C*
     C*  DISPLAY AND PROTECT DIAGNOSIS CODES EXISTING IN THE FADCP
     C*  RECORD IF THIS IS A NORMAL OR PRE-AUDIT. OTHERWISE, DISPLAY
     C*  AND PROTECT THE DIAGNOSIS CODES CREATED FROM THE EOB RECORD
     C*  IF THIS IS A POST AUDIT OR RECON.
     C*
     C*** BEG DEL *** 03/04/97 ***
     C********
B1   C********   SCAR      IFEQ 'R'
     C********   XXAUDF    ORGT 1
     C********             EXSR DCSRA
X1   C********             ELSE
     C********
     C********             EXSR DCSR
     C********             MOVEA'0000'    *IN,01
     C****BEGIN ADD *** 07/26/95 ***********************************************
     C********             MOVE '0'       *IN21
     C********             MOVE '0'       *IN57
     C********             MOVE '0'       *IN58
     C********             MOVE '0'       *IN59
     C********             MOVE '0'       *IN64
     C********             MOVE '0'       *IN80
     C********             MOVE '0'       *IN89
     C****END*ADD *** 07/26/95 *************************************************
     C********
E1   C********             END
     C*** END DEL *** 03/04/97 ***
     C*** END CHG *** 08/09/95 *************************************************
     C                   EXSR      PNDSR
     C*
     C                   MOVE      '1'           *IN24                          ADD 12/28/92
     C                   MOVE      '0'           *IN32                          ADD 05/18/95
     C                   MOVE      '0'           *IN05                          ADD 05/18/95
     C**
     C                   GOTO      STRT
     C*
     C                   END                                                    ENDIF SCR03
     C*** BEGIN ADD *** 05/18/93 **************************************
     C***********************************
     C*   SCR04 - SERV CODE ALPHA SEARCH*
     C***********************************
     C*** BEGIN DEL *** 05/18/95 ***********************************************
     C********** Q2RECF    IFEQ 'SCR04'
     C*
     C**********           DO   10        A       50
     C*
     C**********           MOVELCP,A      XX2     2
     C********** XX2       IFEQ '? '
     C*
     C**********           MOVE *BLANKS   QQCMSV           CHG 04/28/92
     C**********           MOVE *ZEROS    QQFDAT
     C**********           CALL 'F0630R'
     C**********           PARM           QQPRDS
     C**********           PARM           QQCALL
     C**********           PARM           QQCMSV           CHG 04/28/92
     C**********           PARM           SCAST            ADD 04/28/92
     C**********           PARM           QQFDAT
     C**********           PARM           QQRTCD  1
     C**********           MOVE *BLANKS   CP,A
     C**********           MOVE QQCMSV    XXCMSV
     C********** XXCMSV    IFNE *BLANKS
     C**********           Z-ADDXXRVCD    SV,A
     C**********           MOVE XXHCPC    CP,A
     C**********           Z-ADDXXUNIT    UT,A
     C**********           ELSE
     C**********           Z-ADD*ZERO     SV,A
     C**********           MOVE *BLANKS   CP,A
     C**********           Z-ADD*ZERO     UT,A
     C**********           END
     C** GET DESCRIPTION
     C********** 10000.01  MULT SD,A      XXFDAT
     C********** SVKY      SETGTPSV01
     C********** NXTSV6    TAG
     C**********           READPPSV01                    60
     C********** *IN60     IFEQ '0'
     C********** SVCO#     ANDEQUPCO#
     C********** SVCMSV    ANDEQXXCMSV                     CHG 04/28/92
     C********** SVSTAT    IFNE 'I'
     C**********           MOVELSVDESC    DS,A
     C**********           ELSE
     C**********           GOTO NXTSV6
     C**********           END
     C**********           ELSE
     C**********           END
     C***
     C********** QQRTCD    CABEQ'A'       TERM
     C*
     C**********           WRITESCR99
     C**********           MOVE *BLANK    Q2RECF
     C**********           MOVEL'SCR04'   Q2RECF
     C**********           GOTO STRT
     C**********           END
     C**********           END
     C*
     C**********           END                             ENDIF SCR04
     C     Q2RECF        IFEQ      'SCR04'
     C     Q2RECF        OREQ      'SCR04S'
     C     Q2RECF        OREQ      'SCR04C'
     C*
     C                   READC     SCR04S                                 50
     C     *IN50         DOWEQ     '0'
     C*
     C     *IN72         IFEQ      '1'
     C     *IN73         OREQ      '1'
     C     *IN74         OREQ      '1'
     C     *IN75         OREQ      '1'
     C     *IN76         OREQ      '1'
     C     *IN77         OREQ      '1'
     C     *IN78         OREQ      '1'
     C*
     C                   MOVE      *BLANKS       XX72FL
     C                   MOVE      *BLANKS       XX73FL
     C                   MOVE      *BLANKS       XX74FL
     C                   MOVE      *BLANKS       XX75FL
     C                   MOVE      *BLANKS       XX76FL
     C                   MOVE      *BLANKS       XX77FL
     C                   MOVE      *BLANKS       XX78FL
     C*
     C     *IN72         IFEQ      '1'
     C                   MOVE      'Y'           XX72FL
     C                   END
     C     *IN73         IFEQ      '1'
     C                   MOVE      'Y'           XX73FL
     C                   END
     C     *IN74         IFEQ      '1'
     C                   MOVE      'Y'           XX74FL
     C                   END
     C     *IN75         IFEQ      '1'
     C                   MOVE      'Y'           XX75FL
     C                   END
     C     *IN76         IFEQ      '1'
     C                   MOVE      'Y'           XX76FL
     C                   END
     C     *IN77         IFEQ      '1'
     C                   MOVE      'Y'           XX77FL
     C                   END
     C     *IN78         IFEQ      '1'
     C                   MOVE      'Y'           XX78FL
     C                   END
     C*
     C     RRN4          IFGT      1
     C                   Z-ADD     RRN4          S
     C     RRN4          SUB       1             K
     C     K             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     SCSVDT        HLSVDT
     C                   MOVE      *BLANKS       HLPOS
     C                   MOVEL     SCPOS         HLPOS
     C                   MOVE      *BLANKS       HLTOS
     C                   MOVEL     SCTOS         HLTOS
     C                   MOVE      *BLANKS       HLCPT4
     C                   MOVEL     SCCPT4        HLCPT4
     C                   Z-ADD     *ZEROS        HLRVCD
     C                   Z-ADD     SCRVCD        HLRVCD
     C                   MOVE      SCDX          HLDX
     C                   MOVE      SCPX          HLPX
     C                   UPDATE    SCR04S
     C                   END                                                    END *IN60
     C*
     C     S             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C     XX72FL        IFEQ      'Y'
     C                   Z-ADD     HLSVDT        SCSVDT
     C                   END
     C     XX73FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCPOS
     C                   MOVEL     HLPOS         SCPOS
     C                   END
     C     XX74FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCTOS
     C                   MOVEL     HLTOS         SCTOS
     C                   END
     C     XX75FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCCPT4
     C                   MOVEL     HLCPT4        SCCPT4
     C                   END
     C     XX76FL        IFEQ      'Y'
     C                   Z-ADD     HLRVCD        SCRVCD
     C                   END
     C     XX77FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCDX
     C                   MOVEL     HLDX          SCDX
     C                   END
     C     XX78FL        IFEQ      'Y'
     C                   MOVE      *BLANKS       SCPX
     C                   MOVEL     HLPX          SCPX
     C                   END
     C                   UPDATE    SCR04S
     C                   END                                                    END *IN60
     C                   END                                                    END RRN4>1
     C                   END                                                    END *IN72
     C*
     C                   READC     SCR04S                                 50
     C                   END                                                    END DOW 50
     C*
     C                   Z-ADD     *ZEROS        K
     C     NXT04D        TAG
     C                   ADD       1             K
     C     K             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     1             T
     C     1             SUBST     SCCPT4:T      XX1
     C     XX1           IFEQ      '?'
     C*
     C                   MOVE      *BLANKS       QQCMSV
     C                   MOVE      *ZEROS        QQFDAT
     C                   CALL      'F0630R'
     C                   PARM                    QQPRDS
     C                   PARM                    QQCALL
     C                   PARM                    QQCMSV
     C                   PARM                    SCAST
     C                   PARM                    QQFDAT
     C                   PARM                    QQRTCD
     C                   MOVE      *BLANKS       SCCPT4
     C                   MOVEL     QQCMSV        XXCMSV
     C     XXCMSV        IFNE      *BLANKS
     C                   Z-ADD     XXRVCD        SCRVCD
     C                   MOVE      XXHCPC        SCCPT4
     C                   Z-ADD     XXUNIT        SCUNTS
     C                   ELSE
     C                   Z-ADD     *ZERO         SCRVCD
     C                   MOVE      *BLANKS       SCCPT4
     C                   Z-ADD     *ZERO         SCUNTS
     C                   END
     C*
     C     QQRTCD        CABEQ     'A'           TERM
     C*
     C     QQRTCD        IFEQ      '*'
     C                   MOVE      '1'           *IN68
     C                   MOVE      '0'           *IN65
     C                   MOVE      '0'           *IN66
     C                   MOVE      '0'           *IN67
     C                   MOVE      '0'           *IN69
     C                   ELSE                                                   ELSE QQRTCD EQ '*'
     C     QQRTCD        IFEQ      'B'
     C     SCCPT4        OREQ      *BLANKS
     C                   MOVE      *BLANK        SCCPT4
     C                   Z-ADD     *ZEROS        SCRVCD
     C                   Z-ADD     *ZEROS        SCUNTS
     C                   MOVE      '1'           *IN67
     C                   MOVE      '0'           *IN65
     C                   MOVE      '0'           *IN66
     C                   MOVE      '0'           *IN68
     C                   MOVE      '0'           *IN69
     C                   END                                                    END QQRTCD EQ 'B'
     C                   END                                                    END QQRTCD EQ '*'
     C*
     C*
     C* GET DESCRIPTION
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXFDAT
     C     SVKY          SETGT     PSV01
     C     NXTSV6        TAG
     C                   READP     PSV01                                  60
     C     *IN60         IFEQ      '0'
     C     SVCO#         ANDEQ     SCCO#
     C     SVCMSV        ANDEQ     XXCMSV                                       CHG 04/28/92
     C     SVSTAT        IFNE      'I'
     C                   MOVEL     SVDESC        SCDES
     C                   ELSE
     C                   GOTO      NXTSV6
     C                   END
     C                   END
     C*
     C                   Z-ADD     K             #@$4
     C                   UPDATE    SCR04S
     C                   GOTO      NXT04D
     C                   ELSE
     C                   GOTO      NXT04D
     C                   END                                                    END EQ '?'
     C*
     C                   END                                                    END *IN75'
     C                   WRITE     SCR99
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCR04'       Q2RECF
     C                   GOTO      STRT
     C*
     C                   END                                                    END SCR04
     C*** END CHG *** 05/18/95 *************************************************
     C*** END ADD *** 05/18/93 ****************************************
     C*** BEGIN ADD *** 04/08/93 **************************************
     C***********************************
     C*   SCRRX - NDC DRUG CODE SEARCH  *
     C***********************************
     C     Q2RECF        IFEQ      'SCRRX'
     C*
     C                   DO        10            A                 5 0
     C*
     C                   MOVEL     ND(A)         XX2               2
     C     XX2           IFEQ      '? '
     C*
     C                   MOVE      *BLANKS       QQNDC            11
     C                   CALL      'F0550R'
     C                   PARM                    QQPRDS
     C                   PARM                    QQNDC
     C                   PARM                    QQRTC             1
     C*
     C                   MOVE      *BLANKS       ND(A)
     C                   MOVEL     QQNDC         ND(A)
     C     QQRTCD        CABEQ     'A'           TERM
     C**
     C** GET DESCRIPTION
     C                   MOVEL     QQNDC         XXNDC
     C     RXKEY         CHAIN     PRX01                              60
     C**
     C     *IN60         IFEQ      '0'
     C     RXCO#         ANDEQ     SCCO#
     C     RXNDC         ANDEQ     XXNDC                                        CHG 04/28/92
     C     RXSTAT        IFNE      'I'
     C                   MOVEL     RXNAME        XXDESC           21
     C                   MOVEL     XXDESC        DS(A)
     C                   MOVE      RXMEAS        DS(A)
     C                   ELSE
     C                   MOVEL     *BLANK        DS(A)
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANKS       DS(A)
     C                   END
     C*
     C                   Z-ADD     1             T                 2 0
     C     RXPTYP        LOOKUP    PTYP(T)                                60
     C     *IN60         IFEQ      '1'
     C                   MOVEL     PTYD(T)       BG(A)
     C                   ELSE
     C                   MOVE      *BLANKS       BG(A)
     C                   END
     C**
     C                   MOVE      *BLANK        Q2RECF
     C                   MOVEL     'SCRRX'       Q2RECF
     C                   GOTO      STRT
     C                   END
     C                   END
     C**
     C                   END                                                    ENDIF SCRRX
     C*** END ADD *** 04/08/93 ****************************************
     C                   GOTO      STRT
     C                   END                                                    ENDIF *INKI
     C***********************************
     C*  F10                            *
     C***********************************
     C     *INKJ         IFEQ      '1'
     C************************************
     C*   SCR01  = ADD NEW CASE          *
     C*   *** NOTE *** NOT USED WITH WC INTERFACE VERSION ***
     C************************************
     C*** BEG DEL *** 3/04/97 ****
     C********
     C********   Q2RECF    IFEQ 'SCR01'
     C********   *IN71     ANDEQ'0'
     C********
     C********   SCSS#     CABEQ*BLANK    STRT           25
     C********   SCACDT    CABEQ*ZERO     STRT           21
     C********
     C********             MOVE SCACDT    SRDTE   6
     C********
     C********             CALL 'SRDCK'
     C********             PARM           SRDTE   6
     C********             PARM ' '       SRERR   1
     C********             PARM ' '       SRTERM  1
     C********
     C********   SRERR     CABEQ'1'       STRT           24
     C********   SCACDT    MULT 10000.01  XXACDT
     C********   CMKEY     CHAINPCM01                60
     C****BEG*DEL *** 02/14/97 ******
     C**N60**************  EXCPTRCM01
     C****END*DEL *** 02/14/97 ******
     C********   *IN60     CABEQ'0'       STRT           23
     C********
     C******PGM WILL CHANGE HERE TO CALL F0075R CLM MAINT PASSING PARMS OF
     C******PRDS,CALL,SYS.       SYS = 'H'-HBA,'P'-PBR, OR 'N'-NETWORK.
     C******CALL WILL CONTAIN A '1' IF CALLING FROM OTHER PGM, OR ' ' FROM
     C******THE MENU.
     C********             MOVE SCACDT    QQACDT  6
     C********             MOVE *BLANKS   Q1PRDS
     C********             MOVELPTL,1     Q1PRDS
     C********             CALL 'F0075R'
     C********             PARM           Q1PRDS
     C********             PARM '2'       XXCALL  1
     C********             PARM           SCSS#
     C********             PARM           QQACDT
     C*********            PARM           SCSYS   1
     C********
     C********   XXCALL    CABEQ'A'       TERM
     C********
     C********
     C********             WRITESCR99
     C********             MOVE *BLANK    Q2RECF
     C********             MOVEL'SCR01'   Q2RECF
     C********
     C********             GOTO SCR01T
