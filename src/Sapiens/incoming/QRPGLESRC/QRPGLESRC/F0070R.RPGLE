     C************************************
     C*
     C*** BEGIN CHG *** 05/18/95 ***********************************************
     C********** Q2RECF    IFEQ 'SCR04'
     C*
     C**********           DO   10        A       50
     C*
     C**********           MOVELCP,A      XX2     2
     C********** XX2       IFEQ '? '
     C*
     C**********           MOVE SCZIPA    QQZIPA
     C**********           MOVE *BLANKS   QQCPT4
     C**********           MOVE *ZEROS    QQFDAT
     C**********           CALL 'F0527R'
     C**********           PARM           QQPRDS
     C**********           PARM           QQCALL
     C**********           PARM           QQZIPA
     C**********           PARM           QQCPT4
     C**********           PARM           QQFDAT
     C**********           PARM           QQRTC   1
     C*
     C**********           MOVE *BLANKS   CP,A
     C**********           MOVE QQCPT4    CP,A
     C**
     C** GET DESCRIPTION
     C**********           MOVE SCZIPA    XXZIPA
     C**********           MOVE QQCPT4    XXCPCD
     C********** 10000.01  MULT SD,A      XXFDAT
     C********** RCKEY     SETGTPRC01
     C********** NXTRC3    TAG
     C**********           READPPRC01                    60
     C********** *IN60     IFEQ '0'
     C********** RCCO#     ANDEQUPCO#
     C********** RCZIPA    ANDEQXXZIPA
     C********** RCCPT4    ANDEQXXCPCD
     C********** RCSTAT    IFNE 'I'
     C**********           MOVELRCDSC1    DS,A
     C**********           ELSE
     C**********           GOTO NXTRC3
     C**********           END
     C**********           ELSE
     C**********           MOVEL*BLANK    DS,A
     C**********           END
