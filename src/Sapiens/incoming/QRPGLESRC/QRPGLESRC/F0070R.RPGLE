     C*
     C* IF AN ITEM WAS ENTERED THEN WRITE TO DISK
     C*
     C     SCTOTC        IFNE      *ZERO
     C*
     C* UPDATE/WRITE DIAGNOSIS CODE FILE
     C*
     C     SCFEIN        IFNE      HLDFE                                        IF FEIN CHG
     C     SCMOD         ORNE      HLDMO                                        OR MOD CHGS
     C     SCFEIN        IFNE      *ZERO                                        IF FEIN <>0
     C*
     C* DETERMINE FROM/TO SERVICE DATES FOR DIAGNOSIS CODE FILE
     C*
     C                   MOVEL     SCFEIN        XXFEIN
     C                   MOVEL     SCMOD         XXMOD
     C     DCKEY         CHAIN     PDC01                              61
     C     *IN61         IFEQ      '0'
     C     DCSTAT        ANDEQ     ' '
     C                   MOVE      DCFRDT        XDFRDT
     C                   MOVE      DCTODT        XDTODT
     C                   ELSE
     C                   Z-ADD     9999999       XDFRDT
     C                   Z-ADD     *ZERO         XDTODT
     C                   END                                                    END 0 *IN61
     C*
     C     X1FRDT        IFLT      XDFRDT
     C                   Z-ADD     X1FRDT        XDFRDT
     C                   END
     C     X1TODT        IFGT      XDTODT
     C                   Z-ADD     X1TODT        XDTODT
     C                   END
     C*
     C     *IN61         IFEQ      '0'
     C*
     C* IF DIAG CODE RECORD IS FOUND, VERIFY THAT IT IS NOT PENDED -
     C* MULTIPLE PENDED DIAG CODE RECORDS MAY EXIST, BUT ONLY ONE DC
     C* RECORD MAY EXIST FOR CURRENT CHARGES.
     C*
     C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPD4DC
     C                   ELSE                                                   CONTINUE READING
     C                   SETOFF                                       60
     C*
     C     *IN60         DOWEQ     '0'
     C*
     C     DCKEY         READE     PDC01                                  60
     C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPD4DC
     C                   END                                                    DCSTAT = ' '
     C*
     C                   END                                                    DOW *IN60
     C*
     C                   END                                                    DCSTAT = ' '
     C*
     C     *IN60         IFEQ      '1'
     C     DCSTAT        ANDNE     ' '
     C                   GOTO      WRT4DC
     C                   END                                                    DCSTAT = ' '
