     C                   DELETE    PCA0C
     *** BEG ADD *** 04/14/98 *****************************************
     C                   ELSE
     C                   EXCEPT    RLSCAC
     *** END ADD *** 04/14/98 *****************************************
     C                   END                                                    END EQ *ZEROS
     C     CAKYC         READE     PCA0C                                  60
     C                   END                                                    END 0 *IN60
     C                   END
     C*
     C     ADJTG1        TAG
     C*
     C* CALL PGM TO ADJ THE DTL BEFORE DISPL SCR03
     C*
     C     SCTOTC        IFNE      *ZERO
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWK6Z
     C*
     C                   MOVE      'H'           XXATYP                         Default Hosp Prov
     C*
     C     RUKY1         SETGT     PRU01
     C                   READP     PRU01                                  60
     C     *IN60         IFEQ      '0'
     C     RUST          ANDEQ     STOVR
     C     RUATYP        ANDEQ     XXATYP                                       ADD 08/29/91
     C                   Z-ADD     1             J                 5 0
     C     RUAPGM        LOOKUP    APGM(J)                                60
     C     *IN60         IFEQ      '0'
     C     *BLANKS       LOOKUP    APGM(J)                                60
     C   60              MOVEL     RUAPGM        APGM(J)
     C                   END
     C                   ELSE
     C                   MOVE      '1'           *IN37
     C                   GOTO      STRT
     C                   END
     C*
     C                   Z-ADD     1             J                 5 0
     C                   MOVE      '0'           *IN60
     C                   MOVE      SCSVDT        XWK6A             6
     C     XWK6A         LOOKUP    FD(J)                                  60
     C     *IN60         IFEQ      '0'
     C     '000000'      LOOKUP    FD(J)                                  60
     C   60              MOVE      SCSVDT        FD(J)
     C                   END
     C                   END
     C*
     C                   GOTO      NXT04F
     C                   END                                                    END *IN75'
