     C                   ELSE
     C                   Z-ADD     0             HHDSEQ
     C                   END
     C                   Z-ADD     0             XXDSEQ
     C*
     C                   Z-ADD     SCCO#         CACO#
     C                   Z-ADD     SCSUB#        CASUB#
     C                   Z-ADD     SCFND         CAFND
     C                   Z-ADD     XXFYR         CAFYR
     C                   Z-ADD     SCCASE        CACASE
     C                   MOVE      SCSS#         CASS#                          ##
     C                   MOVE      XXACDT        CAACDT                         ##
     C                   MOVE      *BLANKS       CADELF
     C*
     C*********            MOVE *BLANKS   CAFLAG
     C                   MOVE      *BLANKS       TABKEY
     C                   MOVEL     SCCSCD        TABKEY
     C     TCSKY         CHAIN     PCS01                              60
     C     *IN60         IFEQ      '0'
     C*** BEG DEL *** 02/14/97 ***
     C*******************  EXCPTRCS01
     C*** END DEL *** 02/14/97 ***
     C                   END
     C     CSDISC        IFEQ      'P'
     C                   MOVE      'P'           CAFLAG
     C                   Z-ADD     XXLTR#        CALTR#
     C                   ELSE
     C                   MOVE      *BLANK        CAFLAG
     C                   Z-ADD     *ZEROS        CALTR#
     C                   END                                                       ENDIF 'P'
     C*
     C                   MOVE      *ZEROS        CACHK#
     C*** BEGIN CHG *** 07/26/95 ***********************************************
