     C*****************************************************************
     C* DCSR2                                                         *
     C* VERIFY THAT SCREEN PROVIDER/DIAG CODES MATCH FILE CODES       *
     C* THIS IS NEEDED BECAUSE IF THE USER ROLLS THEY HAVE THE        *
     C* ABILITY TO USE OR CHANGE THE PROVIDER AND ENTER NEW DIAG CODES*
     C*****************************************************************
     C     DCSR2         BEGSR
     C*
     C                   MOVEA     '0000'        *IN(01)
     C                   MOVE      '0'           *IN95
     C                   MOVE      *BLANKS       SCMSG1                         ADD 11/30/97
     C                   MOVE      *BLANKS       SCMSG2
     C*
     C                   MOVEL     SCFEIN        XXFEIN
     C                   MOVEL     SCMOD         XXMOD
     C     DCKEY         CHAIN     PDC01                              60
     C*
     C     *IN60         DOWEQ     '0'
     C*
     C*** SINCE PDC01 RECORDS ARE READ IN AS UPDATE, MUST NOW RELEASE THE
     C*** RECORD WE JUST READ TO PREVENT REC LOCKS...
     C                   EXCEPT    RLSDCL
     C*
     C     DCSTAT        IFEQ      ' '
     C*
     C     DCDIA1        IFNE      SCDIA1
     C     DCDIA1        ANDNE     *BLANKS
     C                   MOVE      '1'           *IN01
     C                   MOVE      '1'           *IN95
     C                   MOVEL     DCDIA1        SCDIA1
     C                   END
     C*
     C     DCDIA2        IFNE      SCDIA2
     C     DCDIA2        ANDNE     *BLANKS
     C                   MOVE      '1'           *IN02
     C                   MOVE      '1'           *IN95
     C                   MOVEL     DCDIA2        SCDIA2
     C                   END
     C*
     C     DCDIA3        IFNE      SCDIA3
     C     DCDIA3        ANDNE     *BLANKS
     C                   MOVE      '1'           *IN03
     C                   MOVE      '1'           *IN95
     C                   MOVEL     DCDIA3        SCDIA3
     C                   END
     C*
     C     DCDIA4        IFNE      SCDIA4
     C     DCDIA4        ANDNE     *BLANKS
     C                   MOVE      '1'           *IN04
     C                   MOVE      '1'           *IN95
     C                   MOVEL     DCDIA4        SCDIA4
     C                   END
     C*
     C     *IN95         IFEQ      '1'
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZEROS
     C     Y             ADD       49            Y1                2 0
     C                   MOVE      '1'           *IN(Y1)
     C                   END                                                    END IF TC,Y
     C                   END                                                    ENDDO Y 10
     C                   MOVE      '1'           *IN94
     C                   MOVEL     MSG(1)        SCMSG1
     C                   MOVEL     MSG(2)        SCMSG2
     C                   GOTO      STRT
     C                   END                                                    END 1 *IN95
     C                   END                                                    END DCSTAT ' '
     C     DCKEY         READE     PDC01                                  60
     C                   END                                                    ENDDOW *IN60
     C*
     C                   ENDSR
