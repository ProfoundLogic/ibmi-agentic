     C*** BEG ADD *** 07/02/98 ****************************************
     C*
     C* BASE THE EDIT OF PREVENTING FUTURE SERVICE DATES ON CONTROL
     C* FLAG SFBPF/FBAL04 POSTION 8
     C*
     C                   MOVE      ' '           XXFSDF            1
     C                   MOVEL     'FB'          XSKEY
     C     FBKY          CHAIN     SFB01                              60
     C     *IN60         IFEQ      '0'
     C     1             SUBST     FBAL04:8      XXFSDF
     C                   ENDIF
     C*
     C     XXFSDF        IFEQ      *BLANKS
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN28
     C*
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         HDSYDT            7 0
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     SD(Y)         IFGT      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C*
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWKDT1
     C     XWKDT1        IFGT      HDSYDT
     C                   MOVE      '1'           *IN28
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C*
     C                   END
     C                   END
     C     *IN28         CABEQ     '1'           STRT
     C                   ENDIF                                                  XXFSDF = *BLANKS
     C*** END ADD *** 07/02/98 ****************************************
     C*
     C*** BEGIN ADD*** 01/05/95 ************************************************
     C*
     C* SERVICE DATE MUST BE FOR A VALID FEE SCHEDULE DATE
     C*
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN37
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     SD(Y)         IFGT      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C* Determine what type of Provider we are working with (Specialty Code)
     C* SCR02
     C*
     C     HXRECF        IFEQ      'SCR02'
     C                   MOVE      'P'           XXATYP                         Default Health Prov
     C     SCSPCD        IFEQ      'ASC'
     C     STOVR         ANDEQ     'FL'
     C                   MOVE      'A'           XXATYP                         Ambulatory Surg Ctr
     C                   END                                                    END EQ 'ASC'
     C     SCSPCD        IFEQ      'ASC'
     C     STOVR         ANDEQ     'AL'
     C                   MOVE      'A'           XXATYP                         Ambulatory Surg Ctr
     C                   END                                                    END EQ 'ASC'
     C     SCSPCD        IFEQ      'DIA'
     C     STOVR         ANDEQ     'AL'
     C                   MOVE      'I'           XXATYP                         Diagnostic Center
     C                   END                                                    END EQ 'DIA'
     C*** BEG CHG *** 09/17/98 ****************************************
     C********** XXDFLG    IFEQ 'Y'
     C     SCPRTY        IFEQ      'D'
     C*** END CHG *** 09/17/98 ****************************************
     C                   MOVE      'D'           XXATYP                         DENTAL PROCESSING
     C                   END                                                    END EQ 'D'
     C*
     C                   ELSE                                                    ELSE SCR02
     C* SCR04
     C     HXRECF        IFEQ      'SCR04'
     C                   MOVE      'H'           XXATYP                         Default Hosp Prov
     C                   ELSE
     C     HXRECF        IFEQ      'SCRRX'
     C                   MOVE      'X'           XXATYP
     C                   END
     C                   END                                                     END SCR04
     C                   END                                                     END SCR02
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWK6Z
     C*
     C     RUKY1         SETGT     PRU01
     C                   READP     PRU01                                  60
     C     *IN60         IFEQ      '1'
     C     RUST          ORNE      STOVR
     C     RUATYP        ORNE      XXATYP
     C                   MOVE      '1'           *IN37
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C*
     C                   END
     C                   END
     C     *IN37         CABEQ     '1'           STRT
     C*
     C*** END ADD *** 1/05/95 **************************************************
     C*
     C* =================================================================== *
     C*
     C* * * I/O FLAG (PLACE OF SERVICE) MUST BE VALID
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN32
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C*** BEGIN CHG *** 04/08/93 **************************************
     C********** IO,Y      IFNE '1'
     C********** IO,Y      ANDNE'2'
     C********** IO,Y      ANDNE'3'
     C********** IO,Y      ANDNE'4'
     C********** IO,Y      ANDNE'5'
     C********** IO,Y      ANDNE'6'
     C********** IO,Y      ANDNE'7'
     C********** IO,Y      ANDNE'8'
     C********** IO,Y      ANDNE'9'
     C********** IO,Y      ANDNE'0'
     C********** IO,Y      ANDNE'A'
     C********** IO,Y      ANDNE'B'
     C********** IO,Y      ANDNE'C'
     C********** IO,Y      ANDNE'D'
     C********** IO,Y      ANDNE'E'
     C********** IO,Y      ANDNE'F'
     C*** BEGIN CHG *** 05/18/95 ***********************************************
     C**********           MOVE *BLANKS   QQPOS
     C**********           MOVELIO,Y      QQPOS
     C**********           MOVE 'V'       QQRTCD
     C**********           CALL 'F2155R'
     C**********           PARM           QQPRDS
     C**********           PARM           QQPOS
     C**********           PARM           QQRTCD
     C*
     C********** QQRTCD    IFEQ 'B'
     C********** QQPOS     OREQ *BLANK
     C**********           MOVE '1'       *IN32
     C**********           MOVE '1'       *IN,Y1
     C**********           END
     C*
     C                   MOVE      IO(Y)         XXPOS
     C     PSKY1         CHAIN     PPS02                              60
     C     *IN60         IFEQ      '1'
     C                   MOVE      '1'           *IN32
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*** END CHG *** 05/18/95 *************************************************
     C*** END ADD *** 04/08/93 ****************************************
     C*
     C                   END
     C                   END
     C     *IN32         CABEQ     '1'           STRT
     C*
     C*
     C* * * I/O FLAG (PLACE OF SERVICE) IS REQUIRED
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN32
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C     SCPRTY        IFEQ      'H'
     C     IO(Y)         ANDEQ     ' '
     C     SCPRTY        OREQ      'N'
     C     IO(Y)         ANDEQ     ' '
     C     SCPRTY        OREQ      'D'                                          ADD 08/11/93
     C     IO(Y)         ANDEQ     ' '                                          ADD 08/11/93
     C                   MOVE      '1'           *IN32
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C                   END
     C     *IN32         CABEQ     '1'           STRT
     C*
     C*** BEGIN ADD *** 08/01/97 **************************************
     C* * * I/O FLAG (PLACE OF SERVICE) CANNOT BE INVALID
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN15
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C                   MOVE      IO(Y)         XXPOS
     C     PSKY1         CHAIN     PPS02                              60
     C     *IN60         IFEQ      '0'
     C     PSSTAT        ANDEQ     'I'
     C                   MOVE      '1'           *IN15
     C                   MOVE      '1'           *IN(Y1)
