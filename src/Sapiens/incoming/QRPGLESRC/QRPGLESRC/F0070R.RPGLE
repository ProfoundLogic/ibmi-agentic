     C     RUST          ORNE      STOVR
     C     RUATYP        ORNE      XXATYP
     C                   MOVE      '1'           *IN37
     C                   MOVE      '1'           *IN(Y1)
     C                   END
     C*
     C                   END
     C*
     C                   END
     C                   END
     C     *IN37         CABEQ     '1'           STRT
