     C* LOAD SUBROUTINE - LOAD FORWARD SCREEN ARRAYS SCR03              *
     C*******************************************************************
     C*********  LOAD      BEGSR
     C*********            EXSR CLR
     C*********  OVER      TAG
     C*********
     C***END OF FILE
     C*********
     C***99                MOVE '1'       XXUP    1
     C***99                GOTO DONE
     C*********
     C***FILL SCREEN AND GET NEXT RECORD
     C*********
     C*********            ADD  1         I1
     C*********            EXSR FILL
     C*********  CAKY2     READEPCA0E                    99
     C**N99                EXCPTRLSCAE
     C***99                DO
     C*********            MOVE '1'       XXUP
     C*********            GOTO DONE
     C*********            END
     C*********  I1        COMP 3                      91
     C***91                GOTO OVER
     C*********  DONE      TAG
     C*********            MOVE SQ,1      KEY,1
     C*********            MOVE SQ,3      KEY,2
     C*********
     C*********  SQ,1      COMP *ZERO                    04
     C*********  SQ,2      COMP *ZERO                    05
     C*********  SQ,3      COMP *ZERO                    06
     C*********
     C*********            MOVEA'000'     *IN,50
     C*********            MOVE SQ,1      XSEQ1   5
     C*********            MOVE SQ,2      XSEQ2   5
     C*********            MOVE SQ,3      XSEQ3   5
     C**N04      XSEQ1     LOKUPQS,1                     50
     C**N05      XSEQ2     LOKUPQS,1                     51
     C**N06      XSEQ3     LOKUPQS,1                     52
     C*********
     C*********  *IN50     IFEQ '1'
     C*********  *IN51     OREQ '1'
     C*********  *IN52     OREQ '1'
     C*********            MOVE '1'       *IN29
     C*********            ELSE
     C*********            MOVE '0'       *IN29
     C*********            END
     C*********
     C*********            ENDSR
     C*******************************************************************
     C* LOADP SUBROUTINE - LOAD BACKWARD SCREEN ARRAYS SCR03            *
     C*******************************************************************
