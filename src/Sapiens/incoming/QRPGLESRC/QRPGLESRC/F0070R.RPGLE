     C*
     C                   ELSE                                                   ELSE SVSTAT NE 'I'
     C*
     C                   GOTO      NXTSV4
     C*
     C                   END                                                    END SVSTAT NE 'I'
     C*
     C                   ELSE                                                   ELSE *IN60 EQ '0'
     C*
     C                   MOVE      SCZIPA        XXZIPA
     C                   MOVEL     SCCPT4        XXCPCD
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXFDAT
     C**********           MOVE *BLANKS   SCDES            DEL 03/12/96
     C     PRKEY         SETGT     PPR01
     C     NXTPR9        TAG
     C                   READP     PPR01                                  60
     C     *IN60         IFEQ      '1'
     C     PRCO#         ORNE      SCCO#
     C     PRCPT4        ORNE      XXCPCD
     C*
     C                   MOVE      XXFDAT        XXWDAT
     C     RCKEY         SETGT     PRC01
     C     NXTRC4        TAG
     C                   READP     PRC01                                  60
     C     *IN60         IFEQ      '0'
     C     RCCO#         ANDEQ     SCCO#
     C     RCZIPA        ANDEQ     XXZIPA
     C     RCCPT4        ANDEQ     XXCPCD
     C*
     C     RCSTAT        IFNE      'I'
