     C*** BEGIN DEL *** 05/18/95 ***********************************************
     C**********           ELSE
     C* IF SCR04
     C* * * CHECK FOR DUP KEY ON THE HCPCS CODE,    AND REPLACE IF PRESSED
     C********** SCPRTY    IFEQ 'H'
     C********** H1RECF    IFEQ 'SCR04'
     C* * * CHECK FOR DUP KEY ON THE REVENUE CODE     REPLACE IF PRESSED
     C* * * (62-70)
     C**********           DO   9         Y       50
     C*
     C********** Y         ADD  61        Y1      20
     C********** Y         ADD  1         X       50
     C**********
     C********** *IN,Y1    IFEQ '1'
     C**********           MOVE SV,Y      SV,X
     C**********           END                             END 1 *IN,Y1
     C**********           END                             END DO
     C**********           END                             END EQ 'SCR04'
     C*** END DEL *** 05/18/95 *************************************************
     C                   END                                                    END EQ 'SCR02'
     C*** END CHG ***** 04/28/92 ***********************************
     C*
     C*** BEGIN ADD *** TAPE SUBMISSION **********************************8
     C* * * CHECK FOR DUP KEY ON THE DIAG CODE XREF FIELD
     C* * * (10-18)
     C                   DO        9             Y                 5 0
     C*
     C     Y             ADD       9             Y1                2 0
     C     Y             ADD       1             X                 5 0
     C*
     C     *IN(Y1)       IFEQ      '1'
     C                   MOVE      DX(Y)         DX(X)
     C                   END
     C                   END
     C*** END ADD ***** TAPE SUBMISSION **********************************8
     C                   END                                                    ADD 04/08/93
     C*** BEGIN ADD *** 04/08/93 **************************************
     C     Q2RECF        IFEQ      'SCRRX'
     C*
     C* * * CHECK FOR DUP KEY ON THE FILL DATE AND REPLACE IF PRESSED
     C* * * (72-80)
     C                   DO        9             Y                 5 0
     C*
     C     Y             ADD       71            Y1                2 0
     C     Y             ADD       1             X                 5 0
     C*
     C     *IN(Y1)       IFEQ      '1'
     C                   MOVE      SD(Y)         SD(X)
     C                   END
     C                   END
     C*
     C* * * CHECK FOR DUP KEY ON THE NDC CODE REPLACE IF PRESSED
     C* * * (82-90)
     C                   DO        9             Y                 5 0
     C*
     C     Y             ADD       81            Y1                2 0
     C     Y             ADD       1             X                 5 0
     C*
     C     *IN(Y1)       IFEQ      '1'
     C                   MOVE      ND(Y)         ND(X)
     C                   END
     C                   END
     C*
     C* * * CHECK FOR DUP KEY ON THE RX#.  REPLACE IF PRESSED
     C* * * (62-70)
     C                   DO        9             Y                 5 0
     C*
     C     Y             ADD       61            Y1                2 0
     C     Y             ADD       1             X                 5 0
     C*
     C     *IN(Y1)       IFEQ      '1'
     C                   MOVE      RX(Y)         RX(X)
     C                   END                                                    END 1 *IN,Y1
     C                   END                                                    END DO
     C                   END
     C*** END ADD *** 04/08/93 ****************************************
     C*
     C     DUPITE        ENDSR
     C*******************************************************************
     C* WRIT2 SUBROUTINE - WRITE THE DATA FOR SCR02 TO DISK             *
     C*******************************************************************
     C     WRIT2         BEGSR
     C*
     C                   Z-ADD     99999         XXDSEQ            5 0
     C*
     C     CAKYF         SETGT     PCA0F
     C                   READP     PCA0F                                  60
     C*** BEG CHG *** 06/11/99 ****************************************
     C                   MOVE      *BLANKS       CABPRC
     C*** END CHG *** 06/11/99 ****************************************
     C  N60              EXCEPT    RLSCAF                                       07/31/90 ADD
     C     *IN60         IFEQ      '0'
     C     CACO#         ANDEQ     SCCO#
     C     CASUB#        ANDEQ     SCSUB#
     C     CAFND         ANDEQ     SCFND
     C     CAFYR         ANDEQ     XXFYR
     C     CACASE        ANDEQ     SCCASE
     C                   Z-ADD     CADSEQ        HHDSEQ            5 0
     C                   ELSE
     C                   Z-ADD     0             HHDSEQ
     C                   END
     C                   Z-ADD     0             XXDSEQ
     C*
     C                   Z-ADD     SCCO#         CACO#
     C                   Z-ADD     SCSUB#        CASUB#
     C                   Z-ADD     SCFND         CAFND
     C                   Z-ADD     XXFYR         CAFYR
     C                   Z-ADD     SCCASE        CACASE
     C                   MOVE      SCSS#         CASS#                          ##
     C                   MOVE      XXACDT        CAACDT                         ##
     C                   MOVE      *BLANKS       CADELF
     C*
     C*** BEGIN ADD *** PEND LETTER *******************************
     C*********            MOVE *BLANKS   CAFLAG
     C                   MOVE      *BLANKS       TABKEY
     C                   MOVEL     SCCSCD        TABKEY
     C     TCSKY         CHAIN     PCS01                              60
     C     *IN60         IFEQ      '0'
     C*** BEG DEL *** 02/14/97 ****
     C*******************  EXCPTRCS01
     C*** END DEL *** 02/14/97 ****
     C                   END
     C     CSDISC        IFEQ      'P'
     C                   MOVE      'P'           CAFLAG
     C                   Z-ADD     XXLTR#        CALTR#
     C                   ELSE
     C                   MOVE      *BLANK        CAFLAG
     C                   Z-ADD     *ZEROS        CALTR#
     C                   END                                                       ENDIF 'P'
     C*** END ADD ***** PEND LETTER *******************************
     C*
     C                   MOVE      *ZEROS        CACHK#
     C*** BEGIN ADD *** 07/26/95 ***********************************************
     C**********           Z-ADD0         CAEOB#
     C*** BEG CHG *** 03/04/97 ***
     C** AUDIT / RECON IS STILL NOT DEFINED, SO CLEARING IT OUT
     C                   CLEAR                   SCEOB#
     C                   Z-ADD     SCEOB#        CAEOB#
     C*** END CHG *** 03/04/97 ***
     C*** END ADD *** 07/26/95 *************************************************
