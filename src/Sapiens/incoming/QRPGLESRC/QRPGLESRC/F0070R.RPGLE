     C*****                PARM           QQCALL
     C*****                PARM           Q3CO#   3
     C*****                PARM           Q3SUB#  5
     C*****                PARM           Q3FND   3
     C*****                PARM           Q3FYR   3
     C*****                PARM           Q3CASE  7
     C*****                PARM           Q3EOB#  9
     C*****                PARM           Q3SS#   9
     C*****                PARM           Q3ACDT  6
     C*****                PARM           Q3FEIN  9
     C*****                PARM           Q3MOD   3
     C*****                PARM           Q3AR    1
     C*****                PARM 'V'       Q3RTCD  1
     C*****
     C*****      Q3RTCD    IFEQ 'B'
     C*****
     C*****      LOKEY     CHAINPLO01                60
     C*****      *IN60     IFEQ *OFF
     C*****      LCKOUT    ANDEQ'1'
