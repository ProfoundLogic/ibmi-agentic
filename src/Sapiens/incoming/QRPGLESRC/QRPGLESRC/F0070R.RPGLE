     C                   ELSE
     C                   MOVE      *BLANKS       BG(X)
     C                   END
     C                   ELSE
     C                   MOVEL     *BLANK        DS(X)
     C                   MOVE      *BLANKS       BG(X)
     C                   END
     C*
     C                   END
     C                   END                                                        END DO 10
