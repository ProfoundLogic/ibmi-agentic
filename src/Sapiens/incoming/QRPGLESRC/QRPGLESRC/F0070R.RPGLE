     C                   ELSE
     C     HXRECF        IFEQ      'SCRRX'
     C                   MOVE      'X'           XXATYP
     C                   END
     C                   END                                                     END SCR04
     C                   END                                                     END SCR02
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWK6Z
