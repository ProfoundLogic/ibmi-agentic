     C                   MOVE      *ZEROS        CATOTD
     C*
     C*** BEGIN ADD *** TAPE SUBMISSION ***************************
     C                   MOVE      *ZEROS        HLDFE
     C                   MOVE      *ZEROS        HLDMO
     C*** END ADD ***** TAPE SUBMISSION ***************************
     C*
     C                   DO        50            X
     C* * * IF AN ITEM WAS ENTERED THEN WRITE TO DISK
     C     HTC(X)        IFNE      *ZERO
     C*
     C*** BEGIN ADD *** TAPE SUBMISSION ***************************
     C***  UPDATE/WRITE DIAGNOSIS CODE FILE
     C*
     C     HFE(X)        IFNE      HLDFE                                        IF FEIN CHG
     C     HMO(X)        ORNE      HLDMO                                        OR MOD CHGS
     C     HFE(X)        IFNE      *ZERO                                        IF FEIN <>0
     C*
     C*** DETERMINE FROM/TO SERVICE DATES FOR DIAGNOSIS CODE FILE
     C*
     C                   MOVEL     HFE(X)        XXFEIN
     C                   MOVEL     HMO(X)        XXMOD
     C     DCKEY         CHAIN     PDC01                              61
     C     *IN61         IFEQ      '0'
     C     DCSTAT        ANDEQ     ' '
     C                   MOVE      DCFRDT        XDFRDT
     C                   MOVE      DCTODT        XDTODT
     C                   ELSE
     C*** BEG CHG *** 12/10/99 ****************************************
     C**********           Z-ADD999999    XDFRDT  70
     C                   Z-ADD     9999999       XDFRDT            7 0
     C*** END CHG *** 12/10/99 ****************************************
     C                   Z-ADD     *ZERO         XDTODT            7 0
     C                   END                                                    END 0 *IN61
     C*
     C                   DO        50            L                 5 0
     C     HTC(L)        IFNE      *ZERO
     C*
     C                   Z-ADD     HFR(L)        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XDDATE            7 0
     C     XDDATE        IFLT      XDFRDT
     C                   Z-ADD     XDDATE        XDFRDT
     C                   END
     C     XDDATE        IFGT      XDTODT
     C                   Z-ADD     XDDATE        XDTODT
     C                   END
     C*
     C                   END                                                    ENDNE *ZERO
     C                   END                                                    END DO 50 L
     C*
     C     *IN61         IFEQ      '0'
     C*
     C*** IF DIAG CODE RECORD IS FOUND, VERIFY THAT IT IS NOT PENDED -
     C*** MULTIPLE PENDED DIAG CODE RECORDS MAY EXIST, BUT ONLY ONE DC
     C*** RECORD MAY EXIST FOR CURRENT CHARGES.
     C*
B1   C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPDTDC
X1   C                   ELSE                                                   CONTINUE READING
     C                   SETOFF                                       60
     C*
B2   C     *IN60         DOWEQ     '0'
     C*
     C     DCKEY         READE     PDC01                                  60
B3   C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPDTDC
E3   C                   END                                                    DCSTAT = ' '
     C*
E2   C                   END                                                    DOW *IN60
     C*
E1   C                   END                                                    DCSTAT = ' '
     C*
B1   C     *IN60         IFEQ      '1'
     C     DCSTAT        ANDNE     ' '
     C                   GOTO      WRITDC
E1   C                   END                                                    DCSTAT = ' '
     C*
     C     UPDTDC        TAG                                                    UPDATE DC RECORD
     C*
     C                   MOVE      XDFRDT        DCFRDT
     C                   MOVE      XDTODT        DCTODT
     C                   MOVE      HD1(X)        DCDIA1
     C                   MOVE      HD2(X)        DCDIA2
     C                   MOVE      HD3(X)        DCDIA3
