     C********** Q2RECF    IFEQ 'SCR04'
     C*
     C**********           DO   10        A       50
     C*
     C**********           MOVELCP,A      XX2     2
     C********** XX2       IFEQ '? '
     C*
     C**********           MOVE *BLANKS   QQCMSV           CHG 04/28/92
     C**********           MOVE *ZEROS    QQFDAT
     C**********           CALL 'F0529R'
     C**********           PARM           QQPRDS
     C**********           PARM           QQCALL
     C**********           PARM           QQCMSV           CHG 04/28/92
     C**********           PARM           SCAST            ADD 04/28/92
     C**********           PARM           QQFDAT
     C**********           PARM           QQRTCD  1
     C**********           MOVE *BLANKS   CP,A
     C**********           MOVE QQCMSV    XXCMSV
     C********** XXCMSV    IFNE *BLANKS
     C**********           Z-ADDXXRVCD    SV,A
     C**********           MOVE XXHCPC    CP,A
     C**********           Z-ADDXXUNIT    UT,A
     C**********           ELSE
     C**********           Z-ADD*ZERO     SV,A
     C**********           MOVE *BLANKS   CP,A
     C**********           Z-ADD*ZERO     UT,A
     C**********           END
     C** GET DESCRIPTION
     C********** 10000.01  MULT SD,A      XXFDAT
     C********** SVKY      SETGTPSV01
     C********** NXTSV     TAG
     C**********           READPPSV01                    60
     C********** *IN60     IFEQ '0'
     C********** SVCO#     ANDEQUPCO#
     C********** SVCMSV    ANDEQXXCMSV                     CHG 04/28/92
     C********** SVSTAT    IFNE 'I'
     C**********           MOVELSVDESC    DS,A
     C**********           ELSE
     C**********           GOTO NXTSV
     C**********           END
     C**********           ELSE
     C**********           MOVEL*BLANK    DS,A             DEL 06/19/92
     C**********           END
     C*** END ADD ***** PER FL STATE RULE CHANGE *** 07/12/90 ********
