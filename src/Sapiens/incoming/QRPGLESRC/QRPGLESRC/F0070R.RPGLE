     C*** END ADD *** 12/15/97 ***************************************
     C*** BEGIN ADD *** 02/07/95 ***********************************************
     C*
     C* CHECK TO SEE IF CODEREVIEW IS INSTALLED...IF INSTALLED DISPLAY THIS
     C* JOB STEP TO THE SCREEN
     C*
     C     XXCDRV        IFEQ      'I'
     C     HXRECF        ANDEQ     'SCR02'
     C*
     C                   MOVE      *BLANKS       SCSTP1
     C                   MOVE      *BLANKS       SCSTP2
     C                   MOVEL     JSTP(7)       SCSTP1
     C                   MOVEA     JSTP(8)       SCSTP2
     C                   WRITE     WDW06
     C*** BEGIN ADD *** 05/03/96 ***********************************************
     C                   CLEAR                   HPRH
     C                   CLEAR                   HPRD
     C                   CLEAR                   HPRO
     C                   CLEAR                   HPRS
     C*
     C* LOAD THE HEADER DATA STRUCTURE
     C*
     C                   MOVE      '99'          HKNOW
     C                   MOVE      '000'         HCPAS
     C                   MOVE      '00'          HPAG
     C                   MOVE      '00034'       HLIMIT
     C                   MOVE      '000'         HLLMT
     C                   MOVE      'B'           HCHIF
     C                   MOVE      'Y'           HCAFUF
     C                   MOVE      'C'           HPRCM
     C                   MOVEL     SCCO#         HICO#
     C                   MOVEL     SCCONM        HICONM
     C                   MOVEL     SCSUB#        HIDIV
     C                   MOVEL     SMNAME        HIDVNM
     C                   MOVEL     SCFND         HIGRP#
     C                   MOVEL     FNNAME        HIGPNM
     C                   MOVEL     SCCASE        HICLM
     C                   MOVEL     SCCASE        HICLM#
     C*
     C* LOAD THE POLICY NUMBER FIELD
     C*
     C                   MOVE      SCCO#         HCO#
     C                   MOVE      SCSUB#        HSUB#
     C                   MOVE      SCFND         HFND
     C                   MOVEL     SCYR          HFYR
     C                   MOVE      SCCASE        HCASE
     C                   MOVE      HPRPOL        HIPOL
     C*
     C                   MOVEL     SCSUB#        HISUB
     C                   MOVEL     SCSS#         HIPTID
     C*
     C* LOAD THE DATE OF BIRTH IN MM/DD/CCYY FORMAT
     C*
     C                   MOVE      '/'           HDELM1
     C                   MOVE      '/'           HDELM2
     C                   MOVE      '19'          HCC
     C                   MOVE      Q@DTOB        XADTOB
     C                   Z-ADD     1             X
     C     2             SUBST     XADTOB:X      HYY
     C                   Z-ADD     3             X
     C     2             SUBST     XADTOB:X      HMM
     C                   Z-ADD     5             X
     C     2             SUBST     XADTOB:X      HDD
     C                   MOVE      HPRDOB        HIPDOB
     C*
     C*** BEG CHG *** 03/04/97 ***
     C*******************  MOVE CDSEX     HISEX
     C                   MOVE      QQSEX         HISEX
     C*** END CHG *** 03/04/97 ***
     C*
     C* LOAD THE CLAIMANT'S AGE
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXTDTE
     C     XXTDTE        SUB       Q@DTOB        HAGE
     C                   MOVE      '000'         HIPA
     C                   MOVE      HAYY          HIPA
     C*
     C                   MOVEL     SCFEIN        HIPID
     C*
     C* LOAD THE PROVIDER'S ZIP CODE
     C*
     C                   MOVE      PDZIP         HZIP
     C     HZIP1         CAT       '-':0         HIPZC
     C     HIPZC         CAT       HZIP2:0       HIPZC
     C*
     C                   MOVEL     Q1USER        HICA
     C*
     C* LOAD EACH DETAIL LINE INTO HPRD, THEN LOAD TO APPROPRIATE FIELD IN HPRH
     C*
     C                   DO        34            K
     C                   MOVE      *BLANKS       HPRD
     C                   MOVE      '001'         HSUXI
     C                   MOVE      HCP(K)        HCI
     C                   MOVE      HPM(K)        HM1I
     C                   MOVE      *BLANKS       HM2I
     C*
     C* LOAD THE FROM SERVICE DATE IN MM/DD/CCYY FORMAT
     C*
     C     HFR(K)        IFGT      *ZEROS
     C                   MOVE      '/'           HFIL3
     C                   MOVE      '/'           HFIL4
     C                   MOVE      HFR(K)        XASRVD
     C                   Z-ADD     1             X
     C     2             SUBST     XASRVD:X      HFDIMM
     C                   Z-ADD     3             X
     C     2             SUBST     XASRVD:X      HFDIDD
     C                   MOVE      '19'          HFDICC
     C                   Z-ADD     5             X
     C     2             SUBST     XASRVD:X      HFDIYY
     C                   ELSE
     C                   MOVE      *BLANKS       HFDIMM
     C                   MOVE      *BLANKS       HFDIDD
     C                   MOVE      *BLANKS       HFDICC
     C                   MOVE      *BLANKS       HFDIYY
     C                   MOVE      *BLANKS       HFIL3
     C                   MOVE      *BLANKS       HFIL4
     C                   END                                                    END HFR,K GT *ZEROS
     C*
     C* LOAD THE TO SERVICE DATE IN MM/DD/CCYY FORMAT
     C*
     C     HTO(K)        IFGT      *ZEROS
     C                   MOVE      '/'           HFIL5
     C                   MOVE      '/'           HFIL6
     C                   MOVE      HTO(K)        XASRVD
     C                   Z-ADD     1             X
     C     2             SUBST     XASRVD:X      HTDIMM
     C                   Z-ADD     3             X
     C     2             SUBST     XASRVD:X      HTDIDD
     C                   MOVE      '19'          HTDICC
     C                   Z-ADD     5             X
     C     2             SUBST     XASRVD:X      HTDIYY
     C                   ELSE
     C                   MOVE      *BLANKS       HTDIMM
     C                   MOVE      *BLANKS       HTDIDD
     C                   MOVE      *BLANKS       HTDICC
     C                   MOVE      *BLANKS       HTDIYY
     C                   MOVE      *BLANKS       HFIL5
     C                   MOVE      *BLANKS       HFIL6
     C                   END                                                    END HTO,K GT *ZEROS
     C*
     C                   MOVE      HIO(K)        HPOSI
     C     '000000.0'    CAT       '0'           HCAI
     C                   MOVE      HTC(K)        XXTAMT
     C                   Z-ADD     2             X
     C     6             SUBST     XXTAMT:X      X1TAMT
     C                   Z-ADD     8             X
     C     2             SUBST     XXTAMT:X      X2TAMT
     C                   MOVEL     X1TAMT        HCAI
     C                   MOVE      X2TAMT        HCAI
     C                   MOVE      ' '           HOI
     C     '000000.0'    CAT       '0'           HAAI
     C                   MOVE      '000'         HOPI
     C                   MOVE      '000'         HEPI
     C                   MOVE      '00'          HHCPI
     C                   MOVE      HPRD          HDET(K)
     C                   CLEAR                   HPRD
     C                   CLEAR                   HPRO
     C                   MOVE      HPRO          HOUT(K)
     C                   ENDDO                                                  END DO 34
     C*
     C* LOAD THE INFORMATION TO THE SUMMARY DATA STRUCTURE
     C*
     C                   MOVEL     HPRH          HPRS
     C*
     C* CALL HPR SHELL PROGRAM
     C*
     C                   CALL      'HPRBSLA'
     C                   PARM                    HPRS
     C*
     C* CLEAR THE HPR HEADER DATA STRUCTURE
     C*
     C                   CLEAR                   HPRH
     C*
     C* MOVE THE UPDATED SUMMARY DATA STRUCTURE INTO THE HEADER DATA STRUCTURE
     C* FOR PROCESSING
     C*
     C                   MOVE      HPRS          HPRH
     C*
     C* UPON RETURN FROM THE SHELL PROGRAM FORMAT THE MESSAGE INTERFACE AREA AND
     C* CALL THE MESSAGE FORMATTING PROGRAM
     C*
     C* LOOP THRU ALL USER INTERFACE AREA RECORDS AND MOVE THEM BACK INTO HPRD
     C* DATA STRUCTURE, SO WE CAN GET FROM DATE, CODE, CODE STATUS, MOD AND
     C* MESSAGE KEY IN
     C*
     C                   DO        34            K
     C                   CLEAR                   HPRM
     C                   CLEAR                   HPRD
     C                   MOVE      HDET(K)       HPRD
     C     HFDIMM        IFNE      *BLANKS
     C                   MOVE      HKNOW         HMKB
     C                   MOVE      HFDIMM        HMEDMM
     C                   MOVE      '/'           HFIL12
     C                   MOVE      HFDIDD        HMEDDD
     C                   MOVE      '/'           HFIL13
     C                   MOVE      HFDICC        HMEDCC
     C                   MOVE      HFDIYY        HMEDYY
     C                   MOVE      HM1CI         HIMC1
     C                   MOVE      HM1MI         HIMM1
     C                   MOVE      HM1KI         HIMK1
     C                   MOVE      HCSI          HICS1
     C*
     C* CALL HPR MESSAGE FORMATTING PROGRAM
     C*
     C                   CALL      'HPRBMSA'
     C                   PARM                    HPRM
     C                   END                                                    END HFDIMM NE *BLANK
     C                   ENDDO                                                  END DO 34
     C*** END ADD *** 05/03/96 *************************************************
     C*
     C                   ELSE                                                   ELSE XXCDRV EQ 'I'
     C*
     C     XXCDRV        IFEQ      'B'
     C*
     C                   END                                                    END XXCDRV EQ 'B'
     C                   END                                                    END XXCDRV EQ 'I'
     C*** END ADD *** 02/07/95 *************************************************
     C*
     C                   MOVEA     QQSEQS        QS(1)
     C                   MOVEA     QQER#S        ER(1)
     C                   ADD       1             K
     C                   END                                                    END NE *BLANKS
     C                   END                                                    END DO 50 K
     C*
     C*** END ADD ***** 04/12/91 *** GENERIC CALL FOR EACH STATE *********
     C                   END                                                    END NE *ZEROS
     C*
     C***** BEGIN ADD ****** POSSIBLE DUPLICATE CLAIMS *** 07/23/90 ***
     C*
     C*  CHECK FOR POSSIBLE DUPLICATE CLAIM
     C*
     C     HXRECF        IFEQ      'SCR02'
     C                   EXSR      DUPCL2
     C                   ELSE                                                   ELS SCR02
     C*** BEGIN DEL *** 05/18/95 ***********************************************
     C********** HXRECF    IFEQ 'SCR04'
     C**********           EXSR DUPCL4
     C**********           ELSE
     C*** END DEL *** 05/18/95 *************************************************
     C     HXRECF        IFEQ      'SCRRX'
     C                   EXSR      DUPCLX
