     C* SCXSV SUBROUTINE - SAVE SCREEN DATA FOR SCRRX ON ROLL REQUEST   *
     C*******************************************************************
     C     SCXSV         BEGSR
     C*
     C                   MOVE      KY2(1)        Z1                5 0
     C*
     C                   DO        10            X                 5 0
     C                   MOVE      SD(X)         HFR(Z1)
     C                   MOVE      RX(X)         HRX(Z1)
     C                   MOVE      ND(X)         HND(Z1)
     C                   MOVE      DS(X)         HDS(Z1)
     C                   MOVE      T2(X)         HT2(Z1)
     C                   MOVE      U2(X)         HU2(Z1)
     C                   MOVE      BG(X)         HBG(Z1)
     C*
     C                   MOVE      *BLANKS       HEC(Z1)                        CHG TS
     C                   MOVE      SCCSCD        HCS(Z1)
     C                   MOVE      SCFEIN        HFE(Z1)
     C                   MOVE      SCMOD         HMO(Z1)
     C                   MOVEL     SCSPCD        HSP(Z1)                        12/05/90 ADD
     C                   MOVEL     SCZIPA        HGZ(Z1)                        ADD 05/08/92
     C                   Z-ADD     SCPZIP        HPZ(Z1)                        ADD 04/23/93
