     C*** BEGIN ADD *** 10/13/92 ******************************************
     C* =================================================================== *
     C*
     C*** FLORIDA RULES:
     C*** If this is an Anesthesia Code with mod -47, Body Part A1-A6 required
     C     SCAST         IFEQ      'FL'
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C                   MOVE      '0'           *IN27
     C*
     C                   DO        10            Y                 5 0
     C     TC(Y)         IFNE      *ZERO
     C*
     C     Y             ADD       49            Y1                2 0
     C*
     C     PM(Y)         IFEQ      '47'
     C     PA(Y)         ANDNE     'A1'
     C     PA(Y)         ANDNE     'A2'
     C     PA(Y)         ANDNE     'A3'
     C     PA(Y)         ANDNE     'A4'
     C     PA(Y)         ANDNE     'A5'
     C     PA(Y)         ANDNE     'A6'
     C                   MOVE      '1'           *IN27
     C                   MOVE      '1'           *IN(Y1)
     C                   END                                                    END EQ '47'...
     C*
     C                   END                                                    END TC NE *ZERO
     C                   END                                                    END DO 10 Y
     C     *IN27         CABEQ     '1'           STRT
     C                   END                                                    END EQ 'FL'
     C*** END ADD ***** 10/13/92 ******************************************
     C*
     C*
     C*** BEGIN ADD *** 11/04/92 ******************************************
     C* =================================================================== *
     C*
     C*** FLORIDA RULES:
     C*** If this is a Physical Therapy code, Body Part 2-6 required
     C     SCAST         IFEQ      'FL'
     C                   MOVEA     '00000000'    *IN(50)
     C                   MOVEA     '00'          *IN(58)
     C*********************MOVE '0'       *IN37            DEL 05/24/93
     C                   MOVE      '0'           *IN27                          ADD 05/24/93
     C*
     C                   DO        10            Y                 5 0
     C*** BEGIN CHG *** 12/15/97 **************************************
     C********** TC,Y      IFNE *ZERO
     C*** BEG CHG *** 12/13/99 ****************************************
     C********** SD,Y      MULT 10000.01  HDDATE  60
     C                   Z-ADD     SD(Y)         SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         HDDATE            7 0
     C*** END CHG *** 12/13/99 ****************************************
     C     TC(Y)         IFNE      *ZERO
     C     HDDATE        ANDLT     970901
     C*** END CHG *** 12/15/97 ***************************************
     C*
     C     Y             ADD       49            Y1                2 0
