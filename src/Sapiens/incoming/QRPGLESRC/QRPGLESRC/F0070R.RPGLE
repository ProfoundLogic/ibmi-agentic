     C******               READPPPR01                    60
     C******     *IN60     IFEQ '1'
     C******     XXCPCD    ORNE PRCPT4
     C******
     C******               MOVE '1'       *IN82
     C******               MOVE '1'       *IN,Y1
     C******
     C******               ELSE                            ELSE *IN60 EQ '1'
     C******
     C******     DISTAT    IFNE 'A'
     C******
     C******               MOVE '1'       *IN82
     C******               MOVE '1'       *IN,Y1
     C******
     C******               END                             END DISTAT NE 'A'
     C******
     C******               END                             END *IN60 EQ '1'
     C******
     C******               END                             END SCMETH EQ '4'
     C******               END                             END SCMETH EQ '9'
     C******
     C******               END                             END PC,Y NE *BLANKS
     C******
     C******               END                             END DO 4
     C*** END DEL *** 03/04/97 ***
     C*
     C     *IN82         IFEQ      '1'
     C*
     C                   UPDATE    SCR04S
     C                   Z-ADD     SRRN4         RRN4
     C                   Z-ADD     K             #@$4
     C                   GOTO      STRT
     C*
     C                   END                                                    END *IN82 EQ '1'
     C*
     C* ========================================================================
     C* IF TOTAL CHARGED IS ZEROS, ALL OTHER FIELDS SHOULD ALSO BE BLANKS/ZERO
     C*
     C     SCTOTC        IFEQ      *ZEROS
     C*
     C     SCSVDT        IFNE      *ZEROS
     C     SCPOS         ORNE      *BLANKS
     C     SCTOS         ORNE      *BLANKS
     C     SCCPT4        ORNE      *BLANKS
     C     SCRVCD        ORNE      *ZEROS
     C     SCUNTS        ORNE      *ZEROS
     C     SCDES         ORNE      *BLANKS
     C     SCDX          ORNE      *ZEROS
     C     SCPX          ORNE      *ZEROS
     C     SCPART        ORNE      *BLANKS
     C*
     C                   MOVE      '1'           *IN39
     C                   UPDATE    SCR04S
     C                   Z-ADD     SRRN4         RRN4
     C                   Z-ADD     K             #@$4
     C                   GOTO      STRT
     C*
     C                   ELSE                                                   ELSE SCSVDT NE *ZERO
     C*
     C                   MOVE      '0'           *IN39
     C*
     C                   END                                                    END SCSVDT NE *ZEROS
     C*
     C                   ELSE                                                   ELSE SCTOTC NE *ZERO
     C*
     C                   MOVE      '0'           *IN39
     C*
     C                   END                                                    END SCTOTC EQ *ZEROS
     C*
     C* ========================================================================
     C* THE SERVICE DATE MUST BE VALID
     C*
     C     SCTOTC        IFNE      *ZEROS
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C****                 MOVELSRDTO     SCSVDT
     C*
     C     SRERR         IFEQ      '1'
     C                   MOVE      '1'           *IN23
     C                   UPDATE    SCR04S
     C                   Z-ADD     SRRN4         RRN4
     C                   Z-ADD     K             #@$4
     C                   GOTO      STRT
     C*
     C                   ELSE                                                   ELSE SRERR EQ '1'
     C*
     C                   MOVE      '0'           *IN23
     C*
     C                   END                                                    END SRERR EQ '1'
     C*
     C                   ELSE                                                   ELSE SCTOTC EQ *ZERO
     C*
     C                   MOVE      '0'           *IN23
     C*
     C                   END                                                    END SCTOTC EQ *ZEROS
     C*
     C* ========================================================================
     C* THE SERVICE DATE MUST BE GREATER THAN THE ACCIDENT DATE
     C*
     C     SCTOTC        IFNE      *ZEROS
     C*
     C     SCSVDT        IFGT      *ZEROS
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWKDT1            7 0
     C     XWKDT1        IFLT      XXACDT
     C*
     C                   MOVE      '1'           *IN26
     C                   UPDATE    SCR04S
     C                   Z-ADD     SRRN4         RRN4
     C                   Z-ADD     K             #@$4
     C                   GOTO      STRT
     C*
     C                   ELSE                                                   ELSE XXWKDT1 LT XXAC
     C*
     C                   MOVE      '0'           *IN26
     C*
     C                   END                                                    END XXWKDT1 LT XXACD
     C*
     C                   ELSE                                                   ELSE SCSVDT GT *ZERO
     C*
     C                   MOVE      '0'           *IN26
     C*
     C                   END                                                    END SCSVDT GT *ZEROS
     C*
     C                   ELSE                                                   ELSE SCTOTC EQ *ZERO
     C*
     C                   MOVE      '0'           *IN26
     C*
     C                   END                                                    END SCTOTC EQ *ZEROS
     C*
     C* ========================================================================
     C* THE SERVICE DATE MUST BE FOR A VALID FEE SCHEDULE DATE
     C*
     C     SCTOTC        IFNE      *ZEROS
     C*
     C     SCSVDT        IFGT      *ZEROS
     C*
     C* DETERMINE THE TYPE OF PROVIDER WE ARE WORKING WITH (Specialty Code)
     C*
     C                   MOVE      'H'           XXATYP                         Default Hosp Prov
     C*
     C                   Z-ADD     SCSVDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XWK6Z
     C*
     C     RUKY1         SETGT     PRU01
     C                   READP     PRU01                                  60
     C     *IN60         IFEQ      '1'
     C     RUST          ORNE      STOVR
     C     RUATYP        ORNE      XXATYP
     C*
     C                   MOVE      '1'           *IN37
     C                   UPDATE    SCR04S
     C                   Z-ADD     SRRN4         RRN4
     C                   Z-ADD     K             #@$4
     C                   GOTO      STRT
     C*
     C                   ELSE                                                   ELSE *IN60 EQ '1'
     C*
     C                   MOVE      '0'           *IN37
     C*
     C                   END                                                    END *IN60 EQ '1'
     C*
     C                   ELSE                                                   ELSE SCSVDT GT *ZERO
     C*
     C                   MOVE      '0'           *IN37
     C*
     C                   END                                                    END SCSVDT GT *ZEROS
     C*
     C                   ELSE                                                   ELSE SCTOTC NE *ZERO
     C*
     C                   MOVE      '0'           *IN37
     C*
     C                   END                                                    END SCTOTC NE *ZEROS
     C*
