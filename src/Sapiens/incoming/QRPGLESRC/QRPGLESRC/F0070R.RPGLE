     C                   Z-ADD     SCEOB#        CAEOB#
     C*** END CHG *** 03/04/97 ***
     C*** END ADD *** 07/26/95 *************************************************
     C                   MOVE      *BLANKS       CASTAT
     C                   MOVE      *ZEROS        CATOTD
     C*
     C                   MOVE      *ZEROS        HLDFE
     C                   MOVE      *ZEROS        HLDMO
     C*
     C                   DO        50            X
     C* * * IF AN ITEM WAS ENTERED THEN WRITE TO DISK
     C     HT2(X)        IFNE      *ZERO
     C*
     C***  UPDATE/WRITE DIAGNOSIS CODE FILE
     C*
     C     HFE(X)        IFNE      HLDFE                                        IF FEIN CHG
     C     HMO(X)        ORNE      HLDMO                                        OR MOD CHGS
     C     HFE(X)        IFNE      *ZERO                                        IF FEIN <>0
     C*
     C*** DETERMINE FROM/TO SERVICE DATES FOR DIAGNOSIS CODE FILE
     C*
     C                   MOVEL     HFE(X)        XXFEIN
     C                   MOVEL     HMO(X)        XXMOD
     C     DCKEY         CHAIN     PDC01                              61
     C     *IN61         IFEQ      '0'
     C     DCSTAT        ANDEQ     ' '
     C                   MOVE      DCFRDT        XDFRDT
     C                   MOVE      DCTODT        XDTODT
     C                   ELSE
     C                   Z-ADD     9999999       XDFRDT
     C                   Z-ADD     *ZERO         XDTODT
     C                   END                                                    END 0 *IN61
     C*
     C                   DO        50            L                 5 0
     C     HT2(L)        IFNE      *ZERO
     C*
     C                   Z-ADD     HFR(L)        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XDDATE
     C     XDDATE        IFLT      XDFRDT
     C                   Z-ADD     XDDATE        XDFRDT
     C                   END
     C     XDDATE        IFGT      XDTODT
     C                   Z-ADD     XDDATE        XDTODT
     C                   END
     C*
     C                   END                                                    ENDNE *ZERO
     C                   END                                                    END DO 50 L
     C*
     C     *IN61         IFEQ      '0'
     C*
     C*** IF DIAG CODE RECORD IS FOUND, VERIFY THAT IT IS NOT PENDED -
     C*** MULTIPLE PENDED DIAG CODE RECORDS MAY EXIST, BUT ONLY ONE DC
     C*** RECORD MAY EXIST FOR CURRENT CHARGES.
     C*
     C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPDXDC
     C                   ELSE                                                   CONTINUE READING
     C                   SETOFF                                       60
     C*
     C     *IN60         DOWEQ     '0'
     C*
     C     DCKEY         READE     PDC01                                  60
     C     DCSTAT        IFEQ      ' '
     C                   GOTO      UPDXDC
     C                   END                                                    DCSTAT = ' '
     C*
     C                   END                                                    DOW *IN60
     C*
     C                   END                                                    DCSTAT = ' '
     C*
     C     *IN60         IFEQ      '1'
     C     DCSTAT        ANDNE     ' '
     C                   GOTO      WRTXDC
     C                   END                                                    DCSTAT = ' '
     C*
     C     UPDXDC        TAG                                                    UPDATE DC RECORD
     C*
     C                   MOVE      XDFRDT        DCFRDT
     C                   MOVE      XDTODT        DCTODT
     C                   MOVE      HD1(X)        DCDIA1
     C                   MOVE      HD2(X)        DCDIA2
     C                   MOVE      HD3(X)        DCDIA3
     C                   MOVE      HD4(X)        DCDIA4
