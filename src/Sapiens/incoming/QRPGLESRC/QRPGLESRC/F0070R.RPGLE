     C*
     C* BEFORE ADJUDICATING THE BILL, WE MUST DO DUP KEY PROCESSING
     C*
     C                   READC     SCR04S                                 50
     C     *IN50         DOWEQ     '0'
     C*
     C     *IN72         IFEQ      '1'
     C     *IN73         OREQ      '1'
     C     *IN74         OREQ      '1'
     C     *IN75         OREQ      '1'
     C     *IN76         OREQ      '1'
     C     *IN77         OREQ      '1'
     C     *IN78         OREQ      '1'
     C*
     C                   MOVE      *BLANKS       XX72FL
     C                   MOVE      *BLANKS       XX73FL
     C                   MOVE      *BLANKS       XX74FL
     C                   MOVE      *BLANKS       XX75FL
     C                   MOVE      *BLANKS       XX76FL
     C                   MOVE      *BLANKS       XX77FL
     C                   MOVE      *BLANKS       XX78FL
     C*
     C     *IN72         IFEQ      '1'
     C                   MOVE      'Y'           XX72FL
     C                   END
     C     *IN73         IFEQ      '1'
     C                   MOVE      'Y'           XX73FL
     C                   END
     C     *IN74         IFEQ      '1'
     C                   MOVE      'Y'           XX74FL
     C                   END
     C     *IN75         IFEQ      '1'
     C                   MOVE      'Y'           XX75FL
     C                   END
     C     *IN76         IFEQ      '1'
     C                   MOVE      'Y'           XX76FL
     C                   END
     C     *IN77         IFEQ      '1'
     C                   MOVE      'Y'           XX77FL
     C                   END
     C     *IN78         IFEQ      '1'
     C                   MOVE      'Y'           XX78FL
     C                   END
     C*
     C     RRN4          IFGT      1
     C                   Z-ADD     RRN4          S
     C     RRN4          SUB       1             K
     C     K             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C                   Z-ADD     SCSVDT        HLSVDT
     C                   MOVE      *BLANKS       HLPOS
     C                   MOVEL     SCPOS         HLPOS
     C                   MOVE      *BLANKS       HLTOS
     C                   MOVEL     SCTOS         HLTOS
     C                   MOVE      *BLANKS       HLCPT4
     C                   MOVEL     SCCPT4        HLCPT4
     C                   Z-ADD     *ZEROS        HLRVCD
     C                   Z-ADD     SCRVCD        HLRVCD
     C                   MOVE      SCDX          HLDX
     C                   MOVE      SCPX          HLPX
     C                   UPDATE    SCR04S
     C                   END                                                    END *IN60
     C*
     C     S             CHAIN     SCR04S                             60
     C     *IN60         IFEQ      '0'
     C     XX72FL        IFEQ      'Y'
