    C*
    C*  Balance to Minimum Premium
    C*
      /Free
       // Need to print on Summary Page
       If xxminf = 'Y' and minBal <> 0;
          xxHdg = 'Balance to Minimum Premium';
          xxtam = minBal;
          if *in26 = *on and *in37 = *on;
             exsr  PrtPremInfo;
          endif;
       Endif;
      /End-free
     *
     *  STANDARD PREMIUM
     *
      /Free
       If isContri = '1';
          xxHdg = con(57);
       Else;
          xxHdg = con(5);
       Endif;
      /End-free
     C                   eval      xxtam = tam(5)
      /Free
       If xxminf = 'Y';
          xxtam = tam2(5);
       Endif;
      /End-free
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                             and *in84 = *off
     C                   exsr      PrtPremInfo
     C                   endif
      *
      * Re-arrange bottom section of premium line items for new ordering plus
      * the balance to minimum changes.  Starting with normal premium all the
      * way thru bottom line total premium.
      *
      * Re-arrange coding in this ordering:
      *   Normal Premium
      *   Minimum Premium
      *   Expense Constant
      *   Harbor Exposure Fees
      *   Policy Fees
      *   Estimated Premium (Annual Premium)
      *   Prorata Factor
      *   Terrorism Charge
      *   Domestic Terrorism Charge
      *   Fees and Taxes
      *   Total Premium
      * ******
    C*
    C*  NORMAL PREMIUM
    C*
     C                   if        tam(8) <> *zero
     C                             and xxminf <> 'Y'
      * Do not print normal premium as its value will match the minimum premium line item
      * and no balance to minimum line item will print on the summary page
      /Free
       If isContri = '1';
          xxHdg = con(59);
       Else;
          xxHdg = con(8);
       Endif;
      /End-free
     C                   eval      xxtam = tam(8)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
    C*
    C*  MINIMUM PREMIUM
    C*
     C                   if        tam(11) <> *zero
      /Free
       If isContri = '1';
          xxHdg = con(61);
       Else;
          xxHdg = con(11);
       Endif;
      /End-free
     C                   eval      xxtam = tam(11)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
    C*
    C*  EXPENSE CONSTANT
    C*
     C                   movel(p)  con(9)        xxhdg
     C                   eval      xxtam = tam(9)
     C                   if        xxminf = 'Y'
     C                             and exbexp <> 'Y'
     C                   eval      xxtam = 0
     C                   endif
     C                   if        *in26 = *on
     C                             and *in37 = *on
     c                             and xxpa2 <> 'Y'
     C                   exsr      PrtPremInfo
     C                   endif
      *
      *  Harbor Exposure Minimum
      *
     C                   if        tam(39) <> *zero
     C                   movel(p)  con(39)       xxhdg
     C                   eval      xxtam = tam(39)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
    C*
      /Free
       // Policy Fee
       If tam(45) <> *Zero;
          xxHdg = con(74);
          xxTam = tam(45);
          If *in26 and *in37;
             Exsr PrtPremInfo;
          Endif;
       Endif;
      /End-Free
    C*
    C*  ESTIMATED PREMIUM
    C*
      /Free
       If isContri = '1';
          xxHdg = con(60);
       Else;
          xxHdg = con(10);
       Endif;
      /End-free
     C                   eval      xxtam = tam(10)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
    C*
    C*  PRORATA PREMIUM
    C*
     C                   if        *in43 = *on
      /Free
       If isContri = '1';
          xxHdg = con(62);
       Else;
          xxHdg = con(12);
       Endif;
      /End-free
     C                   eval      xxtam = tam(12)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
      * Combine Foreign and Domestic Terrorism Charges into 1 line
    C*
    C* TERRORISM RISK CHARGE
    C*
     C                   if        tam(25) <> *zero or tam(28) <> *zero
     C                   eval      xxhdg = 'Terrorism Charges'
     C                   eval      xxtam = tam(25) + tam(28)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
    C*
     C                   eval      xxprm = tam(8) + tam(25) + tam(45)
    C*
    C* DOMESTIC TERRORISM RISK CHARGE
    C*
     C                   eval      xxprm = xxprm + tam(28)
      *
      * Add Harbor Exposure Minimum to xxprm (total premium on information page)
      *
     C                   eval      xxprm = xxprm + tam(39)
    C*
    C*  Reinsurance charge.
    C*
     C                   eval      xxprm = xxprm + tam(42)

     c                   if        xxflst = 'Y'
     C                   eval      xxprm = xxprm + tam(9)
     c                   endif
    C*
    C*  FEES AND TAXES
    C*
     C                   if        tam(21) <> *zero
      *** Beg Add *****  02/28/25  *******************************************
      * Check Prorated Terrorism charges
     C                             or tam(25) <> *zero or tam(28) <> *zero
      *** End Add *****  02/28/25  *******************************************
     C                   movel(p)  con(22)       xxhdg
     C                   eval      xxtam = tam(21)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
    C*
    C*  TOTAL
    C*
     C                   movel(p)  con(23)       xxhdg
     C                   eval      xxtam = tam(22)
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   exsr      PrtPremInfo
     C                   endif
     C                   endif
     C                   If        amTrust and *in37 = *on and *in26 = *on
     C                   Eval      xxLastItem = *on
     C                   exsr      PrtPremInfo
     C                   Endif
      * End of Re-arrange
     c                   if        prt132
      /Free
       If isContri = '1';
          prmHead = con(69);
       Else;
          prmHead = con(48);
       Endif;
      /End-free
     c                   if        *in43
     C                   eval      toteprm = tam(12)
     c                   else
     C                   eval      toteprm = tam(10)
     c                   endif
     C                   if        *in26 = *on
     C                             and *in37 = *on
     C                   If        isuseSpoolOut
     C                   write     detc132e
     C                   Endif
     C                   endif
     c                   endif
     *
     C                   eval      xxpror = tam(12) - xxtxpc
     C                   If        xxminf = 'Y' and xxst <> 'NJ'
     C                   eval      xxmnpr = xxmnpr + xomin1
     C                   eval      xxmnpr = xxmnpr + xomin2
     C                   Endif
     C                   if        xxminf <> 'Y'
     C                             and xxst <> 'NJ'
     C                             and not (cltid = '114' and FNGrpAsc = 'AFN')
     C                             and not unitedWis
     C                   eval      xxmnpr = xxmnpr + xlmin1
     C                   eval      xxmnpr = xxmnpr + xlmin2
     C                   eval      xxmnpr = xxmnpr + xxwvmn
     C                   endif
    C*
     C                   if        xxst = 'NJ'
     C                   eval(h)   xxwk10 = elpror * elemna
     C                   eval(h)   xxwk10 = xepror * elemna

     C                   eval      xxmnpr = xxwk10
     C                   endif
     C*** begin add ***  08/19/24  **********************************************
     C* Set minimum premium to class code minimum for Vital Services.
     C                   If        cltid = '153'
     C                   Eval      xxmnpr = ELemna
     C                   Endif
     C*** end add *****  08/19/24  **********************************************
    C*
     C                   exsr      stpage
     c*
     C                   If        isUseXml
     C                   Close     wxp3p
     C                   Endif
     c*
     c* Combine the NJ data set (epelcd <> 0) and then report electronically.
     c*
     C     retry         tag
    C*
     C     epky3         chain(n)  xep01                              60
    C*
     C                   dow       *in60 = *off
    C*
     C                   Z-ADD     0             X1EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   EPCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X1EFDT
     C     prky3         setgt     ppr01
     C     prky4         readpe    ppr01                                  60
     C                   if        *in60 = *off
     C                   move      proccd        xxoccd
     C                   move      PRnrat        xxNrat
     C                   else
     C                   clear                   xxoccd
     C                   clear                   xxNrat
     C                   endif
     *
     C                   if        epspec <> 'F'
     C                             and epspec <> *blank
     C                             and epclas <> rrdccd
     C                             and epelcd <> *zero
     C                             and xxoccd <> 'Y'
     C                             and xxNrat <> 'Y'
    C*
     C                   move      epeapr        xxeapr
     C                   move      epempr        xxempr
     C                   move      epentp        xxentp
     C                   move      epecnt        xxecnt
     C                   move      epadld        xxadld
     C                   move      epdisc        xxdisc
     C                   move      epspec        xxspec
     C                   move      eppst         xxpst
     C                   move      epelcd        xxelcd
     C*** begin add ***  06/20/24  **************************************
     C                   Z-add     EPProExp      xxProExp
     C                   Z-add     EPProPrm      xxProPrm
     C                   Z-add     EPProAdl      xxProAdl
     C*** end add *****  06/20/24  **************************************
     C                   clear                   epspec
     C     epky1         chain     xep01                              60
    C*
     C                   if        *in60 = *off
     C                   eval      epeapr = epeapr + xxeapr
     C                   eval      epempr = epempr + xxempr
     C                   eval      epadld = epadld + xxadld
     C                   eval      epdisc = epdisc + xxdisc
     C                   eval      epentp = epentp + xxentp
     C                   eval      epecnt = epecnt + xxecnt
     C*** begin add ***  06/20/24  **************************************
     C                   Add       xxProExp      EPProExp
     C                   Add       xxProPrm      EPProPrm
     C                   Add       xxProAdl      EPProAdl
     C*** end add *****  06/20/24  **************************************
     C                   eval      EPtdf = outTdf
     C                   update    xep01
    C*
     C                   move      xxspec        epspec
     C     epky1         chain     xep01                              60
    C*
     C                   if        *in60 = *off
     C                   delete    xep01
     C                   endif
    C*
     C                   else
    C*
     C                   move      xxspec        epspec
     C     epky1         chain     xep01                              60
     C                   if        *in60 = *off
     C                   clear                   epspec
     C                   eval      EPtdf = outTdf
     C                   update    xep01
     C                   endif
    C*
     C                   endif
    C*
     C                   goto      retry
     C                   endif
    C*
     C     epky3         reade(n)  xep01                                  60
    C*
     C                   enddo
     C*
     C*  REMOVE RECORDS WITH 0 EXPOSURE IF ANOTHER CLASS WITHIN THE
     C*  STATE HAS EXPOSURE WHEN REPORTING BY STATE/EXPOSURE LINK.
     C*
     C                   MOVE      *BLANKS       SVSPEC
     C                   MOVE      *BLANKS       SVPST
     C                   Z-ADD     0             SVCLAS
     C                   Z-ADD     0             SVEFDT
     C                   Z-ADD     0             SVFRAV
     C                   Z-ADD     0             SVTOAV
     C                   Z-ADD     0             SVARAT
     C*
     C     EPKY3         CHAIN     XEP03                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPPST         IFNE      '**'
     C     EPELCD        ANDNE     *ZERO
     C*
     C     EPCLAS        IFNE      SVCLAS
     C     EPSPEC        ORNE      SVSPEC
     C     EPEFDT        ORNE      SVEFDT
     C     EPPST         ORNE      SVPST
     C     EPFRAV        ORNE      SVFRAV
     C     EPTOAV        ORNE      SVTOAV
     C     EPARAT        ORNE      SVARAT
     C*
     C                   MOVE      EPSPEC        SVSPEC
     C                   MOVE      EPPST         SVPST
     C                   Z-ADD     EPCLAS        SVCLAS
     C                   Z-ADD     EPEFDT        SVEFDT
     C                   Z-ADD     EPFRAV        SVFRAV
     C                   Z-ADD     EPTOAV        SVTOAV
     C                   Z-ADD     EPARAT        SVARAT
     C*
     C                   ELSE
     C*
     C     EPEAPR        IFEQ      *ZERO
     C                   DELETE    XEP03
     C                   ENDIF
     C*
     C                   ENDIF                                                  EPCLAS IFNE
     C*
     C                   ENDIF                                                  EPPST IFNE
     C*
     C     EPKY3         READE     XEP03                                  60
     C                   ENDDO
     C*
     C* REREAD FILE IN REVERSE ORDER TO REMOVE FIRST RECORD IF NO
     C* EXPOSURE AND ANOTHER CLASS HAS EXPOSURE.
     C*
     C                   MOVE      *BLANKS       SVSPEC
     C                   MOVE      *BLANKS       SVPST
     C                   Z-ADD     0             SVCLAS
     C                   Z-ADD     0             SVEFDT
     C                   Z-ADD     0             SVFRAV
     C                   Z-ADD     0             SVTOAV
     C                   Z-ADD     0             SVARAT
     C*
     C     EPKY3         SETGT     XEP03
     C     EPKY3         READPE    XEP03                                  60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EPPST         IFNE      '**'
     C     EPELCD        ANDNE     *ZERO
     C*
     C     EPCLAS        IFNE      SVCLAS
     C     EPSPEC        ORNE      SVSPEC
     C     EPEFDT        ORNE      SVEFDT
     C     EPPST         ORNE      SVPST
     C     EPFRAV        ORNE      SVFRAV
     C     EPTOAV        ORNE      SVTOAV
     C     EPARAT        ORNE      SVARAT
     C*
     C                   MOVE      EPSPEC        SVSPEC
     C                   MOVE      EPPST         SVPST
     C                   Z-ADD     EPCLAS        SVCLAS
     C                   Z-ADD     EPEFDT        SVEFDT
     C                   Z-ADD     EPFRAV        SVFRAV
     C                   Z-ADD     EPTOAV        SVTOAV
     C                   Z-ADD     EPARAT        SVARAT
     C*
     C                   ELSE
     C*
     C     EPEAPR        IFEQ      *ZERO
     C                   DELETE    XEP03
     C                   ENDIF
     C*
     C                   ENDIF                                                  EPCLAS IFNE
     C*
     C                   ENDIF                                                  EPPST IFNE
     C*
     C     EPKY3         READPE    XEP03                                  60
     C                   ENDDO
    C*
    C*  WRITE EXPOSURE TRANSACTION FOR ELECTRONIC REPORTING (For NJ data sets).
    C*
     C                   if        wcfl03 = 'Y'
     C                             and xxpbcg = *off
     C                             and turn = 1
     C                             and xxnjde = 'Y'
    C*
     C     epky3         chain(n)  xep01                              60
     C                   dow       *in60 = *off
    C*
     C                   Z-ADD     0             X1EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   EPCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X1EFDT
     C     prky3         setgt     ppr01
     C     prky4         readpe    ppr01                                  60
     C                   if        *in60 = *off
     C                   move      proccd        xxoccd
     C                   move      PRnrat        xxNrat
     C                   else
     C                   clear                   xxoccd
     C                   clear                   xxNrat
     C                   endif
     *
     C                   if        eppst <> '**'
     C                             and epelcd <> *zero
     C                   move      xxco#         nxco#
     C                   move      xxfnd         nxfnd
     C                   move      xxemp#        nxemp#
     C                   move      xxfyr         nxfyr
     C                   move      xxunid        nxunid
     C                   eval      nxelcd = epelcd
     C                   movel(p)  eppst         xxkey
     C                   eval      xxmst = 0
     C     stky          chain     pst01                              60
     C                   if        *in60 = *off
     C                   move      stnst         xxmst
     C                   endif
     C                   move      xxmst         nxst
     C                   movel(p)  epdesc        nxdesc
     C                   move      epclas        nxclas
      /free
       Setgt (xxCo#:xxFnd:EPpst:x1efdt) prr01;
       Readpe (xxCo#:xxFnd:EPpst) prr01;
       Clear NXcsuf;

       If EPpst = 'CA' and EPext <> *blanks;
          If %subst(EPext:2:1) = *blanks;
             NXcsuf = '00';
             If %subst(EPext:1:1) <> *blanks;
                %subst(NXcsuf:2:1) = %subst(EPext:1:1);
             Endif;
          Else;
             NXcsuf = %subst(EPext:1:2);
          Endif;
       Else;
          If EPPst = 'CA';
             NXcsuf = '00';
          Endif;
       Endif;
      /end-free
     C                   move      eparat        nxrt
     C                   Z-add     epefdt        nxpayefd
     C                   if        *in91 = *on
     C                   eval      nxefdt = epfrav
     C                   move      '3'           nxexpp
     C                   else
     C                   clear                   nxefdt
     C                   move      '1'           nxexpp
     C                   endif
     *
     C                   if        epclas = rrdccd
     C                             or xxoccd = 'Y'
     C                             or xxNrat = 'Y'
     C*** begin chg ***  06/20/24  ******************************************
     C*****              eval      nxeapr = epadld
     C                   eval      nxeapr = EPProAdl
     C*** end chg *****  06/20/24  ******************************************
     C                   else
     *
     C                   if        prpcf = 'C'
     C*** begin chg ***  06/20/24  ******************************************
     C*****              eval      nxeapr = epeapr * 100
     C                   eval      nxeapr = EPProExp * 100
     C*** end chg *****  06/20/24  ******************************************
     C                   else
     C*** begin chg ***  06/20/24  ******************************************
     C*****              move      epeapr        nxeapr
     C                   Z-add     EPProExp      nxeapr
     C*** end chg *****  06/20/24  ******************************************
     C                   endif
    C*
     C                   If        cltID = '102'
     C     PRLOGF        IFEQ      'Y'
     C                   CALL      'SRLOGCLAS'
     C                   PARM                    EPCLAS
     C                   PARM      *OFF          QQFOUND
     C                   PARM      *ZEROS        QQMPAYR
     C                   PARM      *ZEROS        QQMRATE
     C                   PARM      *ZEROS        QQRPTCLS
     C     QQFOUND       IFEQ      *ON
     C*** begin chg ***  06/20/24  ******************************************
     C*****EPEAPR        MULT      QQMPAYR       X1EAPR
     C     EPProExp      MULT      QQMPAYR       X1EAPR
     C*** end chg *****  06/20/24  ******************************************
     c                   EVAL(h)   NXEAPR = X1EAPR
     C     EPARAT        MULT      QQMRATE       NXRT
     c                   EVAL      NXCLAS = QQRPTCLS
     C                   endif
     C                   endif
     C                   endif                                                  cltID = 102
     *
     C                   endif
    C*
    C*  GET PAYROLL CLASS FILE
    C*
     C                   move      eprtcd        xxrtcd
     C                   eval      xxclas = epclas
    C*
    C*  GET CORRECT DATE FROM RDAT ARRAY TO PULL RATE FROM RATE FILE
    C*
     C                   eval      x = 1
     C     epefdt        lookup    pdat(x)                            60
     C                   if        *in60 = *on
     C                             and x > 1
     C                   eval      x = x - 1
     C                   eval      xxefdt = rdat(x)
     C                   else
     C                   eval      x = 1
     C                   eval      xxefdt = elpfdt
     C                   endif
     c*
     C                   Z-ADD     0             X3EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   XXCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X3EFDT
    C*
     C     prky          setgt     ppr01
     C     prky2         readpe    ppr01                                  60
    C*
     C                   If        PReact = '00'
     C                   Eval      nxexpa = 00
     C                   Else
     C                   if        elexmf = 'Y'
     C                   eval      nxexpa = 02
     C                   else
     C                   if        elpfdt < 0960101
     C                   if        prlhcd = 'Y'
     C                             and epspec <> 'F'
     C                   eval      nxexpa = 21
     C                   else
     C                   eval      nxexpa = 11
     C                   endif
    C*
     C                   else
     C                   if        prlhcd = 'Y'
     C                             or epspec = 'F'
     C                   eval      nxexpa = 02
     C                   else
     C                   eval      nxexpa = 01
     C                   endif
    C*
     C                   endif
     C                   endif
     C                   Endif
     C*** begin chg ***  06/20/24  ******************************************
     C******             move      epempr        nxempr
     C******             if        xxminf = 'Y'
     C******                       and elpror <> 1
     C******                       and elpror <> 0
     C******             eval(h)   xxwk10 = elpror * epempr
     C******             eval      nxempr = xxwk10
     C******             eval      xxminp = xxminp + nxempr
     C******             if        eppst = 'MA'
     C******             eval(h)   xxwk10 = elpror * nxeapr
     C******             eval      nxeapr = xxwk10
     C******             endif
     C******             endif
     C* Prorate exposure and premium if short term.
     C                   Eval      nxempr = EPProPrm
     C*** end chg *****  06/20/24  ******************************************
     C                   If        monoState and EPADLD <> 0
     C                   eval      nxeapr = 0
