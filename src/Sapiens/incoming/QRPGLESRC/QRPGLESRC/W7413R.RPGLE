     C                   readp     pah01                                  60
     C                   dow       *in60 = *off
     C                             and ahstat = 'I'
     C                   readp     pah01                                  60
     C                   enddo
    C*
     C                   if        *in60 = *off
     C                             and xxco# = ahco#
     C                             and xxfnd = ahfnd
     C                             and xxemp# = ahemp#
     C                             and xxdiv = ahdiv
     C                             and xxfyr = ahfyr
     C                   movel     ahagt#        shagt#
     C                   endif
