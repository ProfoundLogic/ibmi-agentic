     C                   Move      nasus#        xnsus#
     C                   clear                   xxchg
     C                   move      *off          *in60
     C                   eval      xxnlkc = nanlkc
     C                   eval      xxencd = naencd
    C*
     C                   dow       *in60 = *off
     C                             and xxchg <> 'Y'
    C*
     C                   If        nasus# > xnsus#
     C                   Move      nasus#        xnsus#
     C                   Endif
     C                   if        (xxue# <> naue# or
     C                              xxNcciStCode <> nast1)
     C                             and (xxue# <> naue#2 or
     C                              xxNcciStCode <> nast2)
     C                             and (xxue# <> naue#3 or
     C                              xxNcciStCode <> nast3)
    C*
     C                   select
    C*
     C                   when      nast1 = *blanks
     C                   movel     xxue#         naue#
     c                   move      xxNcciStCode  NAst1
     C                   move      'Y'           xxchg
    C*
     C                   when      nast2 = *blanks
     C                   movel     xxue#         naue#2
     c                   move      xxNcciStCode  NAst2
     C                   move      'Y'           xxchg
    C*
     C                   when      nast3 = *blanks
     C                   movel     xxue#         naue#3
     c                   move      xxNcciStCode  NAst3
     C                   move      'Y'           xxchg
    C*
     C                   other
     C     naky1         reade     pna01                                  60
     C                   dow       *in60 = *off
     C                             and naname = *blanks
     C     naky1         reade     pna01                                  60
     C                   enddo
    C*
     C                   endsl
    C*
     C                   if        xxchg = 'Y'
     C                   move      'Y'           xxprin
     C                   else
     C                   if        *in60 = *on
     C                   movel     xxue#         naue#
     c                   move      xxNcciStCode  NAst1
     C                   clear                   naue#2
     C                   clear                   nast2
     C                   clear                   naue#3
     C                   clear                   nast3
     C                   Move      xnsus#        nasus#
     C                   eval      nasus# = nasus# + 1
     C                   clear                   namadt
     C                   movel     xnsav         naname
     C                   move      xnsav         nanam3
     C                   MOVEL(p)  SVNAM4        NANAM4
     C                   clear                   nanam2
     C                   move      xnfein        nafein
     C                   move      xnlegn        nalegn
     C*** begin add ***  10/15/25  **********************************************
     C                   Move      xnnamp        nanamp
     C*** end add *****  10/15/25  **********************************************
     C                   write     pna01
     C                   write     pna02
     C                   move      'Y'           xxprin
     C                   endif
    C*
     C                   endif
    C*
     C                   else
     C                   move      *on           *in60
     C                   endif
    C*
     C                   enddo
    C*
     C                   move      *on           *in60
     C                   endif
    C*
     C                   endsr
    C*****************************************************************
    C*
    C*====================================================================
    C* PrtPremInfo - Print premium information
    C*====================================================================
     C     PrtPremInfo   begsr
    C*
     C                   eval      item4Type = 3
     C*
     C                   exsr      PrtItem4Pg
    C*
    C*
     C                   endsr
    C*
    C*====================================================================
    C* Privacy139 - Print the Privacy Notice for CLT139
    C*====================================================================
     C     Privacy139    begsr
    C*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c                   if        ullico <> 'Y'
     C                   select
     C                   when      printer1 = 'W7413O1FL'
     C                   write     prv_139FL
     C                   when      printer1 = 'W7413O1'
     C                   write     prv_139
     C                   endsl
    C*
     C                   eval      extPage# = extPage# + 1
     c                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* SetGrpPos - Set the Group poisitions for the dec page
    C*====================================================================
     C     SetGrpPos     begsr
     C*
     C                   select
     C                   when      cltID = '139' and not prtNJ
     C                   eval      grpName = CenterFld(grpName)
     C                   eval      grpAdr1 = CenterFld(grpAdr1)
     C                   eval      grpAdr2 = CenterFld(grpAdr2)
     C                   eval      grpAdr3 = CenterFld(grpAdr3)
     C                   eval      grpAdr4 = CenterFld(grpAdr4)
     C                   eval      grpAdr5 = CenterFld(grpAdr5)
     C                   eval      grpAdr6 = CenterFld(grpAdr6)
     C                   eval      grpAdr7 = CenterFld(grpAdr7)
     C                   eval      GRPNMVRT = 1.85
     C                   eval      GRPA1VRT = 2.05
     C                   eval      GRPA2VRT = 1.95
     C                   eval      GRPA3VRT = 1.68
     C                   eval      GRPA4VRT = 1.85
     C                   eval      GRPA5VRT = 1.90
     C                   eval      GRPA6VRT = 1.50
     C                   eval      GRPA7VRT = 1.50
     C                   if        prtFL
     C                   eval      GRPNMVRT = 2.27
     C                   endif
     C                   when      prtNJ
     C                   eval      GRPNMVRT = 0.65
     C                   eval      GRPA1VRT = 0.65
     C                   eval      GRPA2VRT = 0.65
     C                   eval      GRPA3VRT = 0.65
     C                   eval      GRPA4VRT = 0.65
     C                   eval      GRPA5VRT = 0.65
     C                   eval      GRPA6VRT = 0.65
     C                   eval      GRPA7VRT = 0.65
     C                   if        cltID = '139'
     C                   eval      GRPA1VRT = 1.00
     C                   endif
     C                   other
     C                   eval      GRPNMVRT = 1.50
     C                   eval      GRPA1VRT = 1.50
     C                   eval      GRPA2VRT = 1.50
     C                   eval      GRPA3VRT = 1.50
     C                   eval      GRPA4VRT = 1.50
     C                   eval      GRPA5VRT = 1.50
     C                   eval      GRPA6VRT = 1.50
     C                   eval      GRPA7VRT = 1.50
     C                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    c* writeBI - Write the dec page  for BancInsure (Client specific for 135)
    c*====================================================================
     c     writeBI       begsr
     c                   exsr      LoadFormData
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c                   write     constBI
     c                   write     formBI
     c                   endsr                                                  writeBI
    C*====================================================================
    c* write132 - Write the dec page for Compwest Groups 105, 106, 107
    c*====================================================================
     c     write132      begsr
     c
     c                   exsr      LoadFormData
     C                   MOVE      *OFF          *IN49
     C                   If        cltid = '114' and FNGrpAsc = 'AFN'
     C                   eval      annPrem   = tam(22)
     C                   eval      item3C1c = xxPP3C
     C                   eval      item3C2c = xxPPC3
     C                   If        xxPolst = 'NJ'
     C                   MOVE      *ON           *IN49
     c                   Endif
     C                   Endif
     C*
     C                   Z-add     1             xxpage
     C                   Move      xxue#         svue#
     C                   Move      xxsemp        svsemp
     C                   Move      xxrsk#        svrsk#
     c*
     c                   If        cltid = '114'
     C                   Eval      xxRsk# = %editc(F2CAR#:'X')
     c*
     C                   If        not (xxPolst = 'NJ' or xxPolst = 'PA'
     C                             or xxPolst = 'DE')
     C                   Movel(p)  svRsk#        xxSemp
     C                   Endif
     c*
     C                   Endif
     c*
     c* Produce NJ version of declaration page if state reporting division is NJ.
     c*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c                   If        xxPolst = 'NJ'
     c                   Clear                   xxue#
     c                   write     const132
     c                   write     const132b
     c                   write     boxes132
     c                   write     boxes132b
     c                   write     form132
     c                   write     form132b
     C                   Move      svue#         xxue#
     c                   Else
     c                   write     const132
     c                   write     const132a
     c                   write     boxes132
     c                   write     boxes132a
     c                   write     form132
     c                   write     form132a
     c                   Endif
     c*
     C                   Move      svsemp        xxsemp
     C                   Move      svrsk#        xxrsk#
     c*
     c* Produce 2nd declaration page if multi-state and have NJ coverage.
     c*
     c                   If        cltid = '114'
     C                   Eval      xxRsk# = %editc(F2CAR#:'X')
     c
     c                   If        @@multiSt and xxPolst = 'NJ'
     C                   Movel(p)  svRsk#        xxSemp
     c                   move      *off          *in49
     c                   add       1             xxpage
     c                   write     const132
     c                   write     const132a
     c                   write     boxes132
     c                   write     boxes132a
     c                   write     form132
     c                   write     form132a
     C                   Move      svSemp        xxSemp
     c                   Endif
     c
     c                   If        @@multiSt and xxPolst <> 'NJ'
     c                             and xxnjst = 'Y'
     c                   move      *on           *in49
     c                   add       1             xxpage
     c                   Clear                   xxue#
     c                   write     const132
     c                   write     const132b
     c                   write     boxes132
     c                   write     boxes132b
     c                   write     form132
     c                   write     form132b
     C                   Move      svue#         xxue#
     c                   Endif
     c
     C                   Move      svrsk#        xxrsk#
     c                   Endif                                                  If cltid = '114'
     c
     c                   endsr                                                  write132
    C*====================================================================
    C* Write139 - Write the form for client 139
    C*====================================================================
     C     Write139      begsr
     C*
     C                   exsr      LoadFormData
    C*
     C                   eval      grpName = CenterFld(grpName)
    C*
     c                   if        ullico = 'Y'
     c                   movel     xxtit1        title1u
     c                   movel     xxtit2        title2u
     c                   movel     xxtit3        title3u
     c*
     c                   clear                   grpName
     c                   clear                   grpAdr
     c*
     c                   eval      grpName = fnname
     C*
     C                   eval      adrLn = 0
     C*
     C                   eval      prtDate = AlphaUSA(CvtToDate(xxdate))
     C                   eval      servOff = xxofad100
     c*
     c                   eval      entity = xxbtyp
     c                   eval      boardfm = *blanks
     c                   eval      group# = 'PAT'
     c                   eval      refer# = *blanks
     c                   eval      intpaym = xxinst
     c                   eval      intself = 'Self Reports'
     c                   endif
     c*
     c* Produce normal GIC dec page if not Ullico.
     c*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   MOVE      *OFF          *IN49
     c                   if        ullico <> 'Y'
     C                   write     const139
     C                   write     form139
     C                   write     boxes139
     c                   else
     C                   if        cltid = '139' and xxst = 'NJ'
     C                   MOVE      *ON           *IN49
     c                   endif
     C                   write     const139u
     C                   write     form139u
     C                   write     boxes139u
     c                   endif
    C*
     C                   endsr
