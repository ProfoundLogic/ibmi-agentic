     C                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem4 - Write the extension page Item 4
    C*====================================================================
     C     WriteItem4    begsr
     C*
     C                   exsr      LoadExtItem4
    c*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c*
     c* Change logic above so that a select statement determines which type of schedules
     c* (Ullico, BancInsure, or the default) are going to be written.
     c*
     c                   select
     c                   when      ullico = 'Y'

     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   eval      page#4 = page#4 + 1
     C                   write     boxes4
     C                   write     foot4
     C                   write     const4
     C                   select
     C                   when      cltID = '139'
     C                   write     item4_139
     C                   eval      item4Line# = item4Line# + 3
     C                   endsl
     C                   endif

     C                   select
     C                   when      item4Type = 1
     C                   write     item4A
     C                   eval      item4Type = 2
     C                   exsr      LoadExtItem4
     C                   write     item4A
     C                   when      item4Type = 3
     C                   write     item4C
     C                   when      item4Type = 4
     C                   write     item4D
     C                   endsl
     C                   eval      item4Line# = item4Line# + 2
     C*
     C* Last record for page
     C*
     C                   if        item4Line# > maxItem4
     C                   eval      item4Line# = 0
     C                   endif

     c                   when      bancInsure

     c                   if        item4Line# = 0
     c                   exsr      NewExtPage
     c                   eval      page#4 = page#4 + 1
     c                   write     const4bi
      /Free
       If isContri = '1';
          biStmt = 'INTERIM ADJUSTMENTS OF CONTRIBUTION SH-
           ALL BE MADE ANNUALLY';
          biMinPrem = 'MINIMUM CONTRIBUTION' +
           %editc(xxMnpr : 'J' : '$');
       Else;
          biStmt = 'INTERIM ADJUSTMENTS OF PREMIUM SH-
           ALL BE MADE ANNUALLY';
          biMinPrem = 'MINIMUM PREMIUM' +
           %editc(xxMnpr : 'J' : '$');
       Endif;
      /End-free
     c                   eval      biEstTot = 'ESTIMATED POLICY TOTAL' +
     c                             %editc(tam(22) : 'J' : '$')
     c                   eval      biPage = 'INFORMATION PAGE ' + %char(page#4)
     c                   write     bot4bi
     c                   endif

     c                   select
     c                   when      item4Type = 1
     c                   write     item4ABI
     c                   eval      item4Type = 2
     c                   exsr      LoadExtItem4
     C                   eval      item4Line# = item4Line# + 2
     c                   write     item4ABI
     c                   when      item4Type = 3
     c                   select
      /Free
       When (premDesc = con(5) or premDesc = con(8)) and *in94
        and isContri <> '1';

       When (premDesc = con(57) or premDesc = con(59)) and *in94
        and isContri = '1';

       When (premDesc = con(1) and *in94 and isContri = '0') or
        (premDesc = con(56) and *in94 and isContri = '1');
          premDesc = 'Total';
          write item4BITot;
          item4Line# = item4Line# + 3;

       When premDesc = con(60) and *in94 and isContri = '1';
          premDesc = 'Estimated Annual Contribution';
          write item4BITot;
          item4Line# = item4Line# + 3;

       When premDesc = con(10) and *in94 and isContri = '0';
          premDesc = 'Estimated Annual Premium';
          write item4BITot;
          item4Line# = item4Line# + 3;

      /End-free
     c                   when      premDesc = con(4) or
     c                             premDesc = con(13) or
     c                             premDesc = con(24)
     c                   if        *in94                                        state page
     c                   eval      premiumu = tasexpa                           state exp mod
     c                   else
     c                   eval      premiumu = tam(43)                           policy exp mod
     c                   endif
     c                   write     item4CBI
     C                   eval      item4Line# = item4Line# + 1
     c                   when      premDesc = con(23) and *in94                 total due
     c                   eval      premDesc = 'Total Due for ' +
     c                                         getStateName(xxPst)
     c                   write     item4BITot
     C                   eval      item4Line# = item4Line# + 3
     c                   other
     C                   write     item4CBI
     C                   eval      item4Line# = item4Line# + 1
     c                   endsl
     C                   when      item4Type = 4
     C                   write     item4DBI
     C                   eval      item4Line# = item4Line# + 1
     C                   endsl
     c*
     C* Last record for page
     c*
     C                   if        item4Line# > maxItem4BI
     C                   eval      item4Line# = 0
     C                   endif

     c                   when      prt132

     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   write     schdh132
     C                   write     boxh132
     C                   write     schdv132
     C                   write     foot132
     C                   write     schc132
     C                   write     headc132
     C                   endif
    C*
     C                   select
     C                   when      item4Type = 1
     C                   write     detc132a
     C                   eval      item4Type = 2
     C                   exsr      LoadExtItem4
     C                   write     detc132a
     C                   when      item4Type = 3
     C                   write     detc132c
     C                   when      item4Type = 4
     C                   write     detc132d
     C                   endsl
     C                   eval      item4Line# = item4Line# + 2
     C*
     C* Last record for page
     C                   if        item4Line# > maxItem4c
     C                   eval      item4Line# = 0
     C                   endif

     C                   When      unitedWis

     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   write     sched4uw
     C                   write     foot4uw
     C                   write     const4uw
     C                   endif
    C*
     C                   select
     C                   when      item4Type = 1
     C                   write     item4Auw
     C                   eval      item4Type = 2
     C                   exsr      LoadExtItem4
     C                   write     item4Auw
     C                   when      item4Type = 3
     C                   write     item4Cuw
     C                   when      item4Type = 4
     C                   write     item4Duw
     C                   endsl
     C                   eval      item4Line# = item4Line# + 2
     C*
     C* Last record for page
     C                   if        item4Line# > maxItem4u
     C                   eval      item4Line# = 0
     C                   endif
     C                   When      amTrust

     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   write     constam
     C                   write     const4am
     C                   write     boxes4am
     C                   endif
    C*
     C                   If        item4Type = 4
    C*
     C                   If        item4Line# +6 > maxItem4am
     C                   exsr      NewExtPage
     C                   write     constam
     C                   write     const4am
     C                   write     boxes4am
     C                   Endif
    C*
     C                   write     exp4am
     C                   eval      item4Line# = 0
    C*
     C                   Else
    C*
     C                   If        not xxLastItem
    C*
    C* Print underline for manual premium and total lines.
    C*
     C                   If        premDescAM = 'Manual Premium' or
     C                             premDescAM = 'Total'
     C                   write     und4am
     C                   write     space4am
     C                   eval      item4Line# = item4Line# + 2
     C                   Endif
    C*
     C                   write     det4am
     C                   eval      item4Line# = item4Line# + 2
    C*
     C                   Else
    C*
    C* After the final total prints, reprint 3 values bolded.
    C*
     C                   If        item4Line# +8 > maxItem4am
     C                   exsr      NewExtPage
     C                   write     constam
     C                   write     const4am
     C                   write     boxes4am
     C                   Endif
    C*
     C                   write     line4am
    C*
     C                   Eval      PremDescAM = 'TOTAL ESTIMATED ANNUAL PREMIUM'
     C                   If        *in94 = *on
     C                   Eval      PremPremAM = tas10
     C                   Else
     C                   Eval      PremPremAM = tam(10)
     C                   Endif
     C                   write     bold4am
    C*
     C                   Eval      PremDescAM = 'STATE ASSESSMENT'
     C                   If        *in94 = *on
     C                   Eval      PremPremAM = tas21 + tas24 + tas25 + tas32
     C                   Eval      PremPremAM = PremPremAM + tas33 + tas34
     C                   Eval      PremPremAM = PremPremAM + tas35 + tas36
     C                   Else
     C                   Eval      PremPremAM = tam(21)
     C                   Endif
     C                   write     bold4am
    C*
     C                   Eval      PremDescAM = 'TOTAL COST'
     C                   If        *in94 = *on
     C                   Eval      PremPremAM = tas22
     C                   Else
     C                   Eval      PremPremAM = tam(22)
     C                   Endif
     C                   write     bold4am
    C*
     C                   eval      item4Line# = item4Line# + 8
    C*
     C                   Endif
    C*
     C                   Endif
     C*
     C* Last record for page
     C                   if        item4Line# > maxItem4am
     C                   eval      item4Line# = 0
     C                   endif

     c                   other

     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   write     schedhu
     C                   write     footu
     C                   write     const1pu
     C                   endif
    C*
     C                   select
     C                   when      item4Type = 1
     C                   write     item4Au
     C                   eval      item4Type = 2
     C                   exsr      LoadExtItem4
     C                   write     item4Au
     C                   when      item4Type = 3
     C                   write     item4Cu
     C                   when      item4Type = 4
     C                   write     item4Du
     C                   endsl
     C                   eval      item4Line# = item4Line# + 2
     C*
     C* Last record for page
     C                   if        item4Line# > maxItem4u
     C                   eval      item4Line# = 0
     C                   endif
     c                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem4FL - Write the FL extension page Item 4
    C*====================================================================
     C     WriteItem4FL  begsr
     C*
     C                   exsr      LoadExtItem4
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
    C*
     C                   if        item4Line# = 0
     C                   exsr      NewExtPage
     C                   eval      page#4 = page#4 + 1
     C                   write     boxes4FL
     C                   write     foot4FL
     C                   write     const4FL
     C                   select
     C                   when      cltID = '139' and page#4 = 1
     C                   write     item4FL139
     C                   eval      item4Line# = item4Line# + 3
     C                   endsl
     C                   endif
    C*
     C                   select
     C                   when      item4Type = 1
     C                   write     item4AFL
     C                   eval      item4Type = 2
     C                   exsr      LoadExtItem4
     C                   write     item4AFL
     C                   when      item4Type = 3
     C                   write     item4CFL
     C                   when      item4Type = 4
     C                   write     item4DFL
     C                   endsl
     C                   eval      item4Line# = item4Line# + 2
     C*
     C* Last record for page
     C                   if        item4Line# > maxItem4
     C                   eval      item4Line# = 0
     C                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* XLATEA - X-late address from WMAL*
    C*====================================================================
    C*
     C     xlatea        begsr
    C*
     C     lo:up         xlate(p)  almad1        xamad1
     C     lo:up         xlate(p)  almad2        xamad2
     C     lo:up         xlate(p)  almcty        xamcty
     C     lo:up         xlate(p)  almst         xamst
    C*
     C     lo:up         xlate(p)  alpad1        xapad1
     C     lo:up         xlate(p)  alpad2        xapad2
     C     lo:up         xlate(p)  alpcty        xapcty
     C     lo:up         xlate(p)  alpst         xapst
    C*
     C                   endsr
    C*
    C*====================================================================
    C* XLATEE - X-late address from WMEM*
    C*====================================================================
    C*
     C     xlatee        begsr
    C*
    C*
     C     lo:up         xlate(p)  emmad1        xemad1
     C     lo:up         xlate(p)  emmad2        xemad2
     C     lo:up         xlate(p)  emmcty        xemcty
     C     lo:up         xlate(p)  emmst         xemst
    C*
     C     lo:up         xlate(p)  empad1        xepad1
     C     lo:up         xlate(p)  empad2        xepad2
     C     lo:up         xlate(p)  empcty        xepcty
     C     lo:up         xlate(p)  empst         xepst
    C*
     C                   endsr
    C*
    C*====================================================================
    C* XLATEN - X-late address from WXNA*
    C*====================================================================
    C*
     C     xlaten        begsr
    C*
    C*
     C     lo:up         xlate(p)  namad1        xnmad1
     C     lo:up         xlate(p)  namad2        xnmad2
     C     lo:up         xlate(p)  namcty        xnmcty
     C     lo:up         xlate(p)  namst         xnmst
    C*
     C                   endsr
    C*
    C*====================================================================
    C*====================================================================
     C     attmu         begsr
    C*
     C                   move      xxco#         muco#
     C                   move      xxfnd         mufnd
     C                   move      xxemp#        muemp#
     C                   move      xxdiv         mudiv
     C                   move      xxfyr         mufyr
     C                   clear                   muend#
     C                   clear                   museq#
     C                   movel     xxform        muform
     C                   Eval      muNatFm = xxNatFm
     C*
     C                   select
     C                   when      xxEnSt = '**'
     C                   eval      MUENST = *blanks
     C                   when      xxEnSt <> *blanks
     C                   eval      MUENST = xxEnSt
     C                   other
     C                   movel     'CA'          muenst
     C                   endsl
     C*
     C                   movel     xxdesc        mudesc
     C                   Clear                   mudsc2
     C                   move      elpfdt        mueedt
     C                   movel     'I'           muexfl
     C                   movel     'A'           mumnau
     C                   movel     'N'           muprnt
     C                   movel     'A'           mustat
     C                   movel     q1user        muuser
     C                   movel     q1pgm         mupgm
    C*
     C                   eval      MUDT   = sysDt7
     C                   eval      MUTIME = TimeTo6(SystemTime)
    C*
     C                   movel     q1user        muiusr
     C                   movel     q1pgm         muipgm
     C                   move      mudt          muidt
    C*
    C*  WRITE A RECORD TO THE EMPLOYER ATTACHED ENDORSEMENT FORMS FILE
    C*
     C                   write     pmu01
    C*
     C                   endsr
     P*====================================================================
     P* Get the PEO's FEIN
     P*====================================================================

     C     peosr         begsr

     C                   eval      x1emp# = xxemp#
     C                   eval      x1div  = xxdiv

     C* Let's get the PEO's FEIN

     C                   eval      xxemp# = 1
     C                   eval      xxdiv  = 0

     C     emky1         chain     pem01
     C                   Exsr      DefAddress
     C                   if        %found
     C                   eval      x1fein = emfein
     C                   else
     c                   eval      x1fein = 0
     c                   endif
     C                   If        ##pgfl = '3' and xxst <> 'WI'
     C                   Eval      x1tpob = EMtpob
     C                   Endif
      /Free
       If addNameTpOB <> *blanks;
          x1tpob = addNameTpOB;
       Endif;
      /End-Free
     C                   If        addNameFein <> 0
     c                   Eval      x1fein = addNameFein
     C                   Endif
     C                   if        emmad1 <> *blanks
     C                   move      emmad1        svmad1
     C                   move      emmad2        svmad2
     C                   move      emmcty        svmcty
     C                   move      emmst         svmst
     C                   move      emmzip        svmzip
     C                   move      emnonm        svnona
     c                   else
     C                   move      empad1        svmad1
     C                   move      empad2        svmad2
     C                   move      empcty        svmcty
     C                   move      empst         svmst
     C                   move      empzip        svmzip
     C                   move      emnonp        svnona
     c                   endif
       svMail = EMmail;

     c* Now let's retrieve the original employers info

     C                   eval      xxemp# = x1emp#
     C                   eval      xxdiv  = x1div

     C     emky1         chain     pem01
     C                   Exsr      DefAddress

     C* Now return the value

     C                   endsr
       //==================================================================
       // Get the PEO's Email Address
       //====================================================================
       Begsr peoSr2;
          x1Emp# = xxemp#;
          x1Div  = xxdiv;
          xxemp# = 1;
          xxdiv  = 0;
          Chain emKy1 pem01;
          If %Found(WMEML);
             svMail = EMmail;
          Else;
             svMail = *blanks;
          Endif;

       //  Now let's retrieve the original employers info
       xxEmp# = x1Emp#;
       xxDiv  = x1Div;
       Chain emKy1 pem01;
       Exsr DefAddress;

       Endsr;
     P*====================================================================
     P* Set personal name flag for PEO name status (Employer Master)
     P*====================================================================
     c     srpeoe        begsr
     c
     c                   if        fnpeof <> *blank
     c
     c                   select
     c                   when      nanamp = 'Y' and
     c                             ((ememp# = 1 and emdiv = 0) or emrpeo = 'Y')
     c                   move      'Q'           nanamp
     c                   when      nanamp = 'Y'
     c                   move      'D'           nanamp
     c                   when      ((ememp# = 1 and emdiv = 0) or emrpeo = 'Y')
     c                   move      'P'           nanamp
     c                   other
     c                   move      'C'           nanamp
     c                   endsl
     c
     c                   endif                                                  fnpeof = *blank
     c
     c                   endsr                                                  srpeoe
     P*====================================================================
     P* Set personal name flag for PEO name status (non-Employer Master)
     P*====================================================================
     c     srpeoa        begsr
     c
     c                   if        fnpeof <> *blank
     c
     c                   select
     c                   when      nanamp = 'Y' and
     c                             ((alemp# = 1 and aldiv = 0) or emrpeo = 'Y')
     c                   move      'Q'           nanamp
     c                   when      nanamp = 'Y'
     c                   move      'D'           nanamp
     c                   when      ((alemp# = 1 and aldiv = 0) or emrpeo = 'Y')
     c                   move      'P'           nanamp
     c                   other
     c                   move      'C'           nanamp
     c                   endsl
     c
     c                   endif                                                  fnpeof = *blank
     c
     c                   endsr                                                  srpeoa
     P*====================================================================
     P*====================================================================
     P* Set personal name flag for PEO name status (Employer Master)
     P*====================================================================
     c     srpeoan       begsr
     c
     c                   if        fnpeof <> *blank
     c
     c                   select
     c                   when      nanamp = 'Y' and
     c                             ((anemp# = 1 and andiv = 0) or emrpeo = 'Y')
     c                   move      'Q'           nanamp
     c                   when      nanamp = 'Y'
     c                   move      'D'           nanamp
     c                   when      ((anemp# = 1 and andiv = 0) or emrpeo = 'Y')
     c                   move      'P'           nanamp
     c                   other
     c                   move      'C'           nanamp
     c                   endsl
     c
     c                   endif                                                  fnpeof = *blank
     c
     c                   endsr                                                  srpeoan
     C*
     C*====================================================================
     C* CRTLNA - Create long (100) name {XNA100} from NANAME & NANAM3
     C*====================================================================
     C     CRTLAN        BEGSR
     C*
     C                   MOVE      *BLANKS       XXN100
     C                   MOVE      *BLANKS       XXF100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     naname        xxn100
     C                   move      nanam3        xxn100
     C*
     C                   ENDSR
     C*
     C*====================================================================
     C* SRPEON - CONCATENATE PEO NAME WITH CLIENT DBA/FED NAME
     C*====================================================================
     C     SRPEON        BEGSR
     C*
     C                   MOVE      *BLANKS       XXNAM4
     C*
     C* PEO NAME.
     C*
     C     ##PEO1        IFNE      *BLANKS
     C                   MOVEL     ##PEO1        XXNAM4
     C                   MOVE      ##PEO1        X1TEST            1
     C     X1TEST        IFNE      *BLANK
     C                   CAT       ##PEO2:1      XXNAM4
     C                   ELSE
     C                   CAT       ##PEO2:0      XXNAM4
     C                   ENDIF                                                  X1TEST IFNE
     C                   ENDIF                                                  ##PEO1 IFNE
     C*
     C* FEDERAL NAME
     C*
     C     XXF100        IFNE      *BLANKS
     C     XXNAM4        IFNE      *BLANKS
     C                   CAT       XXF100:1      XXNAM4
     C                   ELSE
     C                   MOVEL     XXF100        XXNAM4
     C                   ENDIF                                                  XXNAM4 IFNE
     C                   ENDIF                                                  XXF100 IFNE
     C*
     C     EMCHAP        IFNE      99
     C     XXF100        ANDNE     *BLANKS
     C                   CAT       'DBA':1       XXNAM4
     C                   ENDIF                                                  EMCHAP IFNE
     C*
     C     XXNAM4        IFNE      *BLANKS
     C                   CAT       XXN100:1      XXNAM4
     C                   ELSE
     C                   MOVEL     XXN100        XXNAM4
     C                   ENDIF                                                  XXNAM4 IFNE
     C*
     C                   ENDSR                                                  SRPEON SUBR
     C********************************************************************
     P*====================================================================
     P* Call SRINST to find initial installment for estimating employers.
     P*====================================================================
     c     srdep         begsr
     c
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELBSCD        Q1BSCD
     C                   MOVE      ELBSDT        Q1BSDT
     C                   MOVE      ELPFDT        Q1PFDT
     C                   MOVE      ELPTDT        Q1PTDT
     C                   MOVE      ELBSDT        Q@DATE
     C     ELANPR        SUB       ELPRTD        XXAMT2           11 2
     C                   move      XXAMT2        Q1PREM
     C                   MOVE      *blanks       Q1TYPE
     C                   MOVE      *zeros        Q1DA1
     C                   MOVE      *zeros        Q1DA2
     C                   MOVE      *zeros        Q1DA3
     C                   MOVE      *zeros        Q1AM1
     C                   MOVE      *zeros        Q1AM2
     C                   MOVE      *zeros        Q1AM3
     C*
     C                   CALL      'SRINST'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1BSCD            3
     C                   PARM                    Q1BSDT            7
     C                   PARM                    Q1PFDT            7
     C                   PARM                    Q1PTDT            7
     C                   PARM                    Q@DATE            7
     C                   PARM                    Q1PREM           11
     C                   PARM                    Q1TYPE            1
     C                   PARM                    Q1DA1           126
     C                   PARM                    Q1DA2           126
     C                   PARM                    Q1DA3           126
     C                   PARM                    Q1AM1           198
     C                   PARM                    Q1AM2           198
     C                   PARM                    Q1AM3           198
     C*
     c                   IF        Q1TYPE <> ' '
     C                   MOVEL     Q1AM1         XXAMT
     c                   ENDIF
     c                   z-add     0             xx11am           11 2
     c
     c*
     c* Select 2nd amount slot for weekly/twice monthly, or first non-zero amount
     c* after the 1st installment for monthly pay plans.
     c*
     c                   select
     c                   when      q1type = 'W' or q1type = 'T'
     c                   movel     q1am1         xx22             22
     c                   move      xx22          xx11am
     c
     c                   when      q1type = 'M'
     c     2             do        18            x
     c                   if        wka(x) <> 0
     c                   z-add     wka(x)        xx11am
     c                   leave
     c                   endif
     c                   enddo
     c
     c                   endsl
     c
     c                   add       xx11am        xxinst
     c
     c                   endsr                                                  srdep
     P*====================================================================
    C*
    C*====================================================================
     C*====================================================================
     C* ADJNAMES - SUBROUTINE TO ADJUST THE NAMES
     C*====================================================================
     C     caldbr        begsr
    C*  SCHEDULE DEBIT/CREDIT
    C*
     C                   if        ((tas19 <> 0 and xxminf <> 'Y')
     C                             or (tms19 <> 0 and xxminf = 'Y'))
     C                   if        ((tas19 > 0 and xxminf <> 'Y')
     C                             or (tms19 > 0 and xxminf = 'Y'))
     C                   if        rrdbhd = *blanks
     C                   movel(p)  con(19)       xxhdg
     C                   else
     C                   movel(p)  rrdbhd        xxhdg
     C                   endif
     C                   else
     C                   if        rrcrhd = *blanks
     C                   movel(p)  con(20)       xxhdg
     C                   else
     C                   movel(p)  rrcrhd        xxhdg
     C                   endif
     C                   endif
     C                   select
     C                   when      ELDBCR >= 1.0
     C                   eval      premCd = %editc(RRDBCD:'X')
     C                   other
     C                   eval      premCd = %editc(RRCRCD:'X')
     C                   select
     C                   when      cltID = '139'
     C                   eval      xxNegF = *on
     C                   endsl
     C                   endsl
     C                   eval      xxtam = tas19
      /Free
       If xxminf = 'Y';
          xxtam = tms19;
       Endif;
      /End-free
     C                   if        cltid = '136'
     C                   movel(p)  con(38)       xxhdg
     C                   eval(h)   xxwk54 = eldbcr * elcmul
     C                   eval(h)   eldbcr = xxwk54
     C                   endif
     C                   Eval      xxHeading = xxHdg
     C                   Eval      xxFactor = ELdbcr
     C                   Eval      xxStatCode = %int(premCD)
     C                   Clear                   xxPercent
     C                   Clear                   xxPercentF
     C                   If        ELdbcr >= 1
     C                   Eval      xxSign = '+'
     C                   Else
     C                   Eval      xxSign = '-'
     C                   Endif
     C                   if        eldbcr <> *zero
     C                   clear                   xxasp
     C                   movel     eldbcr        x1p
     C                   move      x1p           x1asp
     C                   move      eldbcr        x2asp
     C                   move      '.'           xxdot
     C                   movel(p)  xxasp         xxaspx
     C                   move      xxaspx        xxhdg
     C                   endif
     c                   if        *in81 = *off OR XXST <> 'NJ'
     C                   if        *in26 = *on
     C                             and *in84 = *off
     C                   exsr      PrtPremInfo
     C                   endif
     c                   else
     c                   add       xxtam         xxothr
     c                   endif                                                  *in81 = *off
     C                   endif
    C*
     c                   endsr                                                  CALDBR
     C     getdta        begsr
    C*
    C*First check that this particular state policy is not cancelled
    C*only then print the NOTICE
    C*
     C     xmky          setll     pem0x
     C     xmky          reade     pem0x                                  60
     C                   dow       *in60 = *off
    C
    C                   If        a_emcad1 =  0 and a_emcad2 = 0
    C                             and  a_emcad3 = 0 and a_emcad4 = 0
    C                             and a_emcad5 = 0
    C*
     C     xlky          Chain     pel0x
     C                   If        %found(wdell5)
     C                   movel     *blanks       @#RTCD
     C                   movel     b_ELRTCD      @#RTCD            3
     C     rsky1         chain     prs01
     C                   move      rsjrst        @@st              2
    C                   endif
    C                   endif
    C
     C     nbky          reade     pem0x                                  60
     C                   enddo
    C* So after checking that state div is not cancelled get the data
    C*
     C     rrky3         setgt     pnx01m
     C     rrky4         readpe    pnx01m                                 60
    C*
     C                   movel     NXDEPT        @@DEPT           35
     C                   move      NXDPAR        @@DPAR            4
     C                   move      XXDPP1        @@DPP1            3
     C                   move      XXDPP2        @@DPP2            4
     C                   if        *in60 = *on
     C                   clear                   nxdept
     C                   clear                   nxdpar
     C                   clear                   nxdppn
     C                   endif
     c     getdtz        endsr                                                  CALDBR
     C*====================================================================
     C* LoadAddress - Subroutine To Load the Address
     C*====================================================================
     C     loadaddress   begsr
     C*
     C                   if        xxN1co#<>Elco# or xxN1fnd<>Elfnd or
     C                             xxN1emp# <>Elemp# or xxN1fyr<>Elfyr
     C                             or xn1div<>Eldiv or xn1elid <> xalelid
     C*
     C* Increment N1link for each CO#/FND#/EMP#/FYR
     C*
     C                   If        xxN1link<999
     C                   Eval      xxN1LINK = xxN1LINK + 1
     C                   Else
     C                   Eval      xxN1LNKC = xxN1LNKC + 1
     C                   Eval      xxN1LINK = 1
     C                   Endif                                                  xxN1link <999
     C*
     C                   Z-add     xxN1Link      N1Link
     C                   Z-add     xxN1Lnkc      N1Lnkc
     C*
     C                   Eval      N1co#  =  Elco#
     C                   Eval      N1fnd  =  Elfnd
     C                   Eval      N1emp# =  Elemp#
     C                   Eval      N1fyr  =  Elfyr
     C                   Eval      xn1div =  Eldiv
     C                   Eval      xn1elid =  xalelid
     C                   Eval      xxN1co#  =  Elco#
     C                   Eval      xxN1fnd  =  Elfnd
     C                   Eval      xxN1emp# =  Elemp#
     C                   Eval      xxN1fyr  =  Elfyr
     C*
     C                   Endif                                                  N1co#<>Elco#
     C
     C                   movel     name(1)       N1nam1
     C                   movel     name(2)       N1nam2
     C                   movel     name(3)       N1nam3
     C                   movel     name(4)       N1nam4
     C                   movel     name(5)       N1nam5
     C                   movel     name(6)       N1nam6
     C                   movel     name(7)       N1nam7
     C                   movel     name(8)       N1nam8
     C                   movel     name(9)       N1nam9
     C*
     C                   movel(p)  xxLocName     N1DBAName
     C                   movel(p)  xxLocFdnm     N1FedName
     C
     C                   move(P)   xofeid        N1fein
     C                   eval      N1lsid =  EMlsid
     C
     C* Move outside Loadaddress as it can be different for Location
     C                   move      xoue#         n1sue1
      * Load leasing ID
     C                   eval      xxtbid = 'NREL'
     C                   eval      xxkey  = EMlsid
     C
     C     gtky          chain     pgt01                              60
     C                   Movel     Gtdesc        N1lsds
      /free
       clear N1txid;
       clear N1rxid;
       Select;
       When xxost = 'NJ' and x1txid <> *blanks;
          N1txid = x1txid;
       When xxost = 'NJ' and x3txid <> *blanks;
          N1txid = x3txid;
       When xxost <> 'NJ' and x1txid <> *blanks;
          N1rxid = x1txid;
       When xxost <> 'NJ' and x3txid <> *blanks;
          N1rxid = x3txid;
       endsl;
       clear x1txid;
       clear x3txid;
      /end-free
     C
     C                   write     pn101
     C*
     C*    Write a record to WXA5P
     C*
     C                   clear                   pa501
     C                   Eval      A5co#  =  ELco#
     C                   Eval      A5fnd  =  ELfnd
     C                   Eval      A5emp# =  ELemp#
     C                   Eval      A5FYR  =  ELFYR
     C                   if        xalelid <> *blanks
     C                   eval      a5elid =  xalelid
     C                   else
     C                   move      xxhlid1       a5elid
     C                   endif
     C                   move      x5div         a5div
     C                   Move      xxELType      a5ELType
     C                   Move      xxBusType     a5BusType
     C                   Eval      A5Phn  = xxLocPhn
     C                   Eval      A5Area = xxLocPhnA
     C                   Eval      A5Fax  = xxLocFax
     C                   Eval      A5FAra = xxLocFaxA
    C*
     C                   Eval      A5naencd = locencd
     C                   Eval      A5nanlkc = locnlkc
     C                   Eval      A5naempy = naempy
     C                   eval      A5emlink = locemlink
     C                   Eval      A5naencdF = locencdFed
     C                   Eval      A5nanlkcF = locnlkcFed
     *
    C
     C     xxoad1        cat       xxoad2        xxADDR           80
     C     xxADDR        cat       xxocsz        A5ADDR
     C                   movel     xxoad1        A5adr1
     C                   movel     xxoad2        A5adr2
     C                   movel     xxocty        A5city
     C                   movel     xxost         A5st
     C                   movel     xxozip        A5zip
    C*
     C*
     C                   move(P)   xosicd        A5sic
     C                   move(P)   xonaid        A5naic
     C                   movel     xxocty        A5scty
     C                   movel     xxost         A5sst
     C                   Eval      A5nlnk = N1link
     C                   Eval      A5nlkc = N1lnkc
     C                   Eval      A5EFDT = xaefdt
     C                   Eval      A5DLDT = xadldt
     C*
      /free
         A5ADTP = xxadtp;
      /end-free
     C                   write     pa501
     C*
     C*    Write a Another record to WXA5P
     C*
     C
     C                   If        x2oad1 <> *blank
     C*
     C                   clear                   pa501
     c                   eval      A5EFDT = xaefdt
     c                   eval      A5DLDT = xadldt
     C                   Eval      A5co#  =  ELco#
     C                   Eval      A5fnd  =  ELfnd
     C                   Eval      A5emp# =  ELemp#
     C                   Eval      A5FYR  =  ELFYR
     *
     C                   if        xalelid <> *blanks
     C                   eval      a5elid =  xalelid
     C                   else
     C                   move      xxhlid1       a5elid
     C                   endif
     C                   move      x5div         a5div
     C                   Move      xxELType      a5ELType
     C                   Move      xxBusType     a5BusType
     C                   Eval      A5Phn  = xxLocPhn
     C                   Eval      A5Area = xxLocPhnA
     C                   Eval      A5Fax  = xxLocFax
     C                   Eval      A5FAra = xxLocFaxA
     *
    C
     C     x2oad1        cat       x2oad2        x1ADDR           80
     C     x1addr        cat       x2ocsz        A5ADDR
     C                   movel     x2oad1        A5adr1
     C                   movel     x2oad2        A5adr2
     C                   movel     x2octy        A5city
     C                   movel     x2ost         A5st
     C                   movel     x2ozip        A5zip
    C*
     C                   move(P)   xosicd        A5sic
     C                   move(P)   xonaid        A5naic
     C                   movel     xxocty        A5scty
     C                   movel     xxost         A5sst
     C                   Eval      A5nlnk = N1link
     C                   Eval      A5nlkc = N1lnkc
     C*
     C                   Eval      xxxlnk = A5NLNK
     C                   Eval      xxxlkc = A5NLkc
     C*
      /free
         A5ADTP = x2adtp;
      /end-free
     C                   write     pa501
     C                   Endif                                                  x2onam <> *blank
     C*
     C                   CLEAR                   XOFEIH
     C                   CLEAR                   XOFEID
     C                   CLEAR                   XOSICH
     C                   CLEAR                   XOSICD
     C                   CLEAR                   XONAIH
     C                   CLEAR                   XONAID
     C*
     C                   endsr                                                   loadaddress
     C
     C*====================================================================
     C* PrintAddress- Subroutine To Print the Address
     C*====================================================================
     C     printAddress  begsr
     C
     C
     C                   z-add     *zeros        xxxlnk
     C                   z-add     *zeros        xxxlkc
     C                   clear                   xxoad1
    C*
     C                   if        fndepo='D'
     C     a5ky          setll     pa503                              70
     C                   else
     C     a5ky          setll     pa502                              70
     C                   endif
    C*
     C                   dow       *in70 = *off
     C                   eval      a5nlnk = 0
     C                   eval      a5nlkc = 0
     C                   if        fndepo='D'
     C     a5ky          reade     pa503                                  70
     C                   else
     C     a5ky          reade     pa502                                  70
     C                   endif
     C     A5NLNK        ifeq      xxxlnk
     C     A5NLKC        andeq     xxxlkc
    C*
     C                   movel     A5adr1        x2oad1
     C                   movel     A5adr2        x2oad2
     C                   clear                   x2ocsz
     C                   move      A5zip         x2ozip
     C                   move      x2ozip        xxzip
     C                   movel     A5CITY        x2octy
     C                   movel     x2octy        x2ocsz
     C                   movel     A5ST          x2ost
     C                   Eval      xxMailCity = A5City
     C                   Eval      xxMailState = A5St
     C                   Eval      xxMailZip = A5Zip
     C     x2ocsz        cat       ',':0         x2ocsz
     C     x2ocsz        cat       x2ost:1       x2ocsz
     C     x2ocsz        cat       x2ozip5:2     x2ocsz
    C*
     C                   if        x2ozip4 <> '0000'
    C*
     C     x2ocsz        cat       '-':0         x2ocsz
     C     x2ocsz        cat       x2ozip4:0     x2ocsz
    C*
     C                   Endif                                                  x2ozip4<> '0000'
    C*
     C                   Eval      xosicd  = A5sic
     C                   Eval      xonaid  = A5naic
     C*
     C                   ELSE                                                   A5NLNK = xxxlnk
     C*
     C
     C                   If        xxoad1<> *blank
     C*
     C                   if        xxoad2 <> *blank
     C                   move      *on           *in22
     C                   else
     C                   move      *off          *in22
     C                   endif
     C                   eval      otherLoc = 1
     C*
     C                   select
     C*
     C                   when      printer1 = 'SKIP'
     C                   When      printer1 = 'W7413O1FL'
     C                   Exsr      WriteItem1FL
     C                   When      printer1 = 'W7413O1'
     C                   Exsr      WriteItem1
     C                   other
     C
     C                   If        isuseSpoolOut
     C                   if        *inof = *on
     C                             or q4lin# >= 51
     C                   eval      xxpage = xxpage + 1
     C                   eval      xxetxt = 'for Item #1'
     C                   except    sohead
     C                   except    othphd
     C                   move      *off          *inof
     C                   endif
     C                   Endif
     C*
     C                   Exsr      LocPrint
     C                   Endsl
     C                   Endif                                                  xxoad1<> *blank
     C*
     C                   CLEAR                   XOFEIH
     C                   CLEAR                   XOFEID
     C                   CLEAR                   XOSICH
     C                   CLEAR                   XOSICD
     C                   CLEAR                   XONAIH
     C                   CLEAR                   XONAID
     C                   Clear                   xxPhysCity       25
     C                   Clear                   xxPhysState       2
     C                   Clear                   xxPhysZip         9 0
     C                   Clear                   xxMailCity       25
     C                   Clear                   xxMailState       2
     C                   Clear                   xxMailZip         9 0
     C*
     C                   If        A5SIC  <> *ZEROS AND A5SIC <> *BLANKS
     C                   move      *on           *in29
     C                   move(P)   A5SIC         XOSICD
     C                   move(P)   XZSICH        XOSICH
     C                   endif
     C                   If        A5NAIC <> *ZEROS AND A5NAIC <> *BLANKS
     C                   move      *on           *in29
     C                   move(P)   A5NAIC        XONAID
     C                   move(P)   XZNAIH        XONAIH
     C                   endif
     C*
     C                   move      a5div         xxdiv1
     C                   movel     a5elid        xxelid
     C                   Move      a5ELType      xxELType
     C                   Move      a5BusType     xxBusType
     C                   Eval      xxLocPhn  = A5Phn
     C                   Eval      xxLocPhnA = A5Area
     C                   Eval      xxLocFax  = A5Fax
     C                   Eval      xxLocFaxA = A5FAra
     C                   eval      locempy = a5naempy
     C                   eval      locencd = a5naencd
     C                   eval      locnlkc = a5nanlkc
     C                   Eval      locencdFed = A5naencdF
     C                   Eval      locnlkcFed = A5nanlkcF
     C                   eval      locemlink = a5emlink
     C                   if        a5efdt =0
     C                   eval      *in69 = *off
     C                   eval      xoefdt = *zeros
     C                   else
     C                   z-add     a5efdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         xoefdt
     C                   eval      *in69 = *on
     C                   endif
      *
     C                   if        a5dldt =0
     C                   eval      *in79 = *off
     C                   eval      xodldt = *zeros
     C                   else
     C                   z-add     a5dldt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         xodldt
     C                   eval      *in79 = *on
     C                   endif
     C*
     C     n1ky          chain     pn102                              60
     C
     C                   if        (n1fein <> *zeros  ) and *in60 = *off
     C                   move      *on           *in29
     C                   move(P)   n1fein        XOFEID
     C                   move(P)   XZFEIH        XOFEIH
     C                   endif
     C*
     C                   move(P)   N1lsid        x01sid
     C                   move(P)   N1lsds        x01sds
     c                   eval      x1txid = N1txid
     c                   eval      x3txid = N1rxid
     C
     c                   Clear                   x0sue#
     C                   If        N1SUE1 <> *ZEROS AND N1SUE1 <> *BLANKS
     C                   move      *on           *in29
     C                   move(P)   N1sue1        x0sue#
     C                   endif                                                   EMUE#<> 0
     C*
     C*
     C                   movel     N1nam1        name(1)
     C                   movel     N1nam2        name(2)
     C                   movel     N1nam3        name(3)
     C                   movel     N1nam4        name(4)
     C                   movel     N1nam5        name(5)
     C                   movel     N1nam6        name(6)
     C                   movel     N1nam7        name(7)
     C                   movel     N1nam8        name(8)
     C                   movel     N1nam9        name(9)
     C*
     C                   movel     name(1)       xxonam
     C                   movel     name(2)       xxonm2
     C                   movel(p)  N1DBAName     xxLocName
     C                   movel(p)  N1FedName     xxLocFdnm
     C
     C                   movel     A5adr1        xxoad1
     C                   movel     A5adr2        xxoad2
     C*
     C                   Eval      xxPhysCity = A5City
     C                   Eval      xxPhysState = A5St
     C                   Eval      xxPhysZip = A5Zip
     C                   clear                   xxocsz
     C                   move      A5zip         xxzip
     C                   movel     A5st          xxost
     C                   movel     A5city        xxocsz
     C     xxocsz        cat       ',':0         xxocsz
     C     xxocsz        cat       xxost:1       xxocsz
     C     xxocsz        cat       xxzip5:2      xxocsz
     *
     C                   if        xxzip4 <> '0000'
     C     xxocsz        cat       '-':0         xxocsz
     C     xxocsz        cat       xxzip4:0      xxocsz
     C                   endif
     C*
     C                   Eval      xosicd  = A5sic
     C                   Eval      xonaid  = A5naic
     C*
     C                   Eval      numFein = N1FEIN
     c                   if        fnpeof <> ' '
     c                   movel     x1lshd        xxlshd           11
     c                   else
     c                   move      *blanks       xxlshd
     c                   move      *blanks       n1lsid
     c                   move      *blanks       n1lsds
     c                   endif
     C
     C                   clear                   x2oad1
     C                   clear                   x2oad2
     C                   clear                   x2ocsz
     C*
     C* Set previous record values
     C                   z-add     a5nlnk        xxxlnk
     C                   z-add     a5nlkc        xxxlkc
     C*
     C                   Endif                                                  A5NlK <> 'xxxnlk'
     C
     C                   Enddo                                                  *in60 = *off
     C*
     C                   endsr                                                  PrintAddress
      *====================================================================
      * LocPrint - Subroutine to print location information on schedule.
      *====================================================================
     C     LocPrint      begsr
     C
     C                   Eval      XOFEIH2 = %trim(XOFEIH)
     C
     C     1             do        9             x
     C
     C                   if        name(x) <> *blanks
     C                   movel(p)  name(x)       xxnm56
     C
     C                   If        isuseSpoolOut
     C                   Select
     C                   When      printer1 = 'W7413O1'
     C                   Write     othnm1
     C                   Other
     C                   Except    othnam
     C                   Endsl
     C                   Endif
     C
     C                   Clear                   XOFEIH
     C                   Clear                   XOFEIH2
     C                   Clear                   XOFEID
     C                   endif
     C
     C                   enddo                                                  do x = 1 to 9
     C
      /free
       clear XO1ds;
       //Populate left side (addresses)
       n = 1;
       if xxoad1 <> *blanks;
         XO1ds(n).Left = %trim(xxoad1);
         n +=1;
       endif;
       if xxoad2 <> *blanks;
         XO1ds(n).Left = %trim(xxoad2);
         n +=1;
       endif;
       if xxocsz <> *blanks;
         XO1ds(n).Left = %trim(xxocsz);
         n +=1;
       endif;
         XO1ds(n).Left = *blanks; //blank line before Mailing address
         n +=1;
       if x2oad1 <> *blanks;
         XO1ds(n).Left = XO1Indent + 'Mailing:';
         n +=1;
         XO1ds(n).Left = XO1Indent + %trim(x2oad1);
         n +=1;
       endif;
       if x2oad2 <> *blanks;
         XO1ds(n).Left = XO1Indent + %trim(x2oad2);
         n +=1;
       endif;
       if x2ocsz <> *blanks;
         XO1ds(n).Left = XO1Indent + %trim(x2ocsz);
         n +=1;
       endif;

       //Populate Right side (Location specifics)
       n = 1;
       If (X0SUE# <> *blanks);
         XO1ds(n).Right = 'State UE#:';
         XO1ds(n).Right2 = X0SUE#;
         n +=1;
       endif;
       Select;
       When (x1txid <> *blanks);
         XO1ds(n).Right = 'NJ Taxpayer ID#:';
         XO1ds(n).Right2 = x1txid;
         n +=1;
       When (x3txid <> *blanks);
         XO1ds(n).Right = 'State Risk ID#:';
         XO1ds(n).Right2 = x3txid;
         n +=1;
       endsl;
       if xoefdt <> 0;
         XO1ds(n).Right = 'Eff date:' + %trim(%char(%date(XOEFDT:*usa):*mdy/));
         if xoDlDt <> 0;
            XO1ds(n).Right = %trim(XO1ds(n).Right) + ' Exp date:' +
                       %trim(%char(%date(XODLDT:*usa):*mdy/));
         Else;
            XO1ds(n).Right = 'Eff date: ';
            XO1ds(n).Right2 = %char(%date(XOEFDT:*usa):*mdy/);
         endif;
         n +=1;
       endif;
       Select;
       When (XONAID <> *blanks);
         XO1ds(n).Right = %trim(XONAIH);
         XO1ds(n).Right2 = %trim(XONAID);
         n +=1;
       When (XOSICD <> *blanks);
         XO1ds(n).Right = %trim(XOSICH);
         XO1ds(n).Right2 = %trim(XOSICD);
         n +=1;
       Other;
       Endsl;
       if (fnpeof <> ' ');
         XO1ds(n).Right = %trim(N1LSID);
         XO1ds(n).Right2 = %trim(N1LSDS);
         n +=1;
       endif;
       XO1ds(n).Right = 'DIV #: ';
       XO1ds(n).Right2 = %editc(xxdiv1:'X');
       n +=1;
       XO1ds(n).Right = 'E/L Number: ';
       XO1ds(n).Right2 = xxelid;
       n +=1;

       For n = 1 to 10;
         if (XO1ds(n) <> *blanks) or XO1ds(n+1) <> *blanks;
            XO1Ln = *blanks;
            XO1Ln = XO1ds(n);
            XO1Left = XO1ds(n).Left;
            If %subst(XO1ds(n).Right:1:3) = 'Eff'
             and %subst(XO1ds(n).Right:19:3) = 'Exp';
               Xo1Right = %subst(XO1ds(n).Right:1:17);
               Xo1Right2 = %subst(XO1ds(n).Right:19:17);
            Else;
               Xo1Right = %subst(XO1ds(n).Right:1:16);
               Xo1Right2 = XO1ds(n).Right2;
            Endif;

          If isuseSpoolOut;
            Select;
            When printer1 = 'W7413O1';
               Write Othad1;
            Other;
               Except OthPdt1;
            Endsl;
          Endif;

         endif;
       endfor;
       XO1Ln = *blanks;
       Clear XO1Left;
       Clear XO1Right;
       Clear XO1Right2;

       If isuseSpoolOut;
       Select;
       When printer1 = 'W7413O1';
          Write Othad1;
       Other;
          Except OthPdt1;
       Endsl;
       Endif;

      /end-free
     C                   Exsr      ScriptAddLocs
     C
     C                   endsr                                                  LocPrint subr
      *====================================================================
      * writeDE - writes Delaware Deductible Form (Project 114WTJ)
      *====================================================================
     C     writeDE       begsr                                                  writeDE
     C                   if        not printedDE
     C                   eval      printedDE = *on
     C                   eval      de2enam = EMNAME + EMNAM2
     C                   eval      de2fnam = FNNAME
     C                   If        isuseSpoolOut
     C                   write     NoticDE3
     C                   write     NoticDE1
     C                   write     NoticDE2
     C                   Endif
     C                   Exsr      ScriptDE
     C                   endif
     C                   endsr                                                  writeDE
     C*********************************************************************
     C*  srCommon - Set common variables here
     C*********************************************************************
     C     srCommon      begsr
     C                   move      '1'           nxexpp
    C*
     C                   if        elpfdt < 0960101
     C                   eval      nxexpa = 11
     C                   else
     C                   eval      nxexpa = 00
     C                   endif
    C*
     C                   move      'A'           nxstat
     C                   movel     q1user        nxuser
     C                   movel     q1pgm         nxpgm
    C*
     C                   eval      NXDT   = sysDt7
     C                   eval      NXTIME = TimeTo6(SystemTime)
    C*
     C                   eval      nxidt = nxdt
     C                   movel     q1user        nxiusr
     C                   clear                   nxeapr
     C                   endsr                                                  srCommon
     C*********************************************************************
     C*  srCalPSur - Calculate Policy Surcharge rate for assessments
     C*********************************************************************
     C     srCalPSur     begsr
     C                   if        xxtstc = 00935 or xxtstc = 00936
     C                   if        xxtstf <> *zero
     C                             and xxtfpr <> *zero
     C                   eval      xxprem = xxtapr + xxtfpr
     C                   eval(h)   nxpsur = xxtamt / xxprem
     C                   else
     C                   eval      nxpsur = xxtrt / 100
     C                   endif
     C                   else
     C                   eval      nxpsur = 0
     C                   endif
     *
     C                   clear                   nxrt
     C                   if        xxtstc <> 00935
     C                             and xxtstc <> 00936
    C*
     C                   if        xxtstf <> *zero
     C                             and xxtfpr <> *zero
     C                   eval      xxprem = xxtapr + xxtfpr
     C                   eval(h)   xxrt = xxtamt / xxprem
     C                   eval      nxrt = xxrt * 10000
     C                   else
     C                   eval      nxrt = xxtrt * 100
     C                   endif
     C                   endif
    C*
     C                   endsr
     C*
     C*********************************************************************
     c*  srFlatRateAdj - IL Flat rate Adjustment.
     C*********************************************************************
     c     srFlatRateAdj begsr
     c*
     c* Check opt out flag for IL 1110901 rate change
     c                   z-add     1110901       xxSpltDt          7 0
     c                   eval      xxstcd = 0
     c*
     c                   if        not (xxst = 'IL' and
     c                                  elpfdt < xxSpltDt and
     c                                  elptdt > xxSpltDt and
     c                                  ApplyRateSplit(xxst:xxSpltDt:xxstcd))
     c                   leavesr
     c                   endif
     c*
     C*** Find matching state in sttots
     C     1             do        52            d
     C     d             occur     sttots
     C                   if        tast = *blanks
     C                   iter
     C                   endif
     c                   if        tast = 'IL'
     c                   leave
     c                   endif                                                  TAST IFEQ
     C                   enddo                                                  1 - 52 on sttots
      *
     c* No IL coverage on policy, skip processing
     c                   if        tast <> 'IL'
     c                   leavesr
     c                   endif
     c*
     c                   eval      xtpred = 0
     C     epky9         chain     xep01                              60
     c                   dow       *in60 = *off
     c                   if        epelcd = 0
     c                   eval      xtpred = xtpred + epempr
     c                   endif
     C     epky9         reade     xep01                                  60
     c                   enddo

     c* Calculate Flat rate adjustment amount.
     c                   eval      xxFlrtAdj = tas01  - xtpred
     c                   eval      xtpred = 0

     c                   if        xxFlrtAdj <> 0
     c                   eval      epco#  = xxco#
     c                   eval      epfnd  = xxfnd
     c                   eval      epemp# = xxemp#
     c                   eval      epclas = xxstcd
     c                   eval      epcode = xxstcd
     c                   eval      epefdt = xxSpltDt
     c                   eval      epempr = xxFlrtAdj
     c                   eval      eparat = 0
     c                   eval      epeapr = 0
     C                   eval      epecnt = 0
     c                   eval      epdesc = xcILRate
     c                   eval      eppst  = 'IL'
     C                   eval      EPtdf = outTdf
     C                   write     xep01
      *
      * Write another record to XEP01 with
     c                   eval      epco#  = xxco#
     c                   eval      epfnd  = xxfnd
     c                   eval      epemp# = xxemp#
     C                   move      '**'          eppst
     c                   eval      epclas = xxstcd
     c                   eval      epcode = xxstcd
     c                   eval      epefdt = xxSpltDt
     c                   eval      epempr = xxFlrtAdj
     c                   eval      epdesc = xcILRate
     C                   write     xep01

     c                   endif                                                  xxFlrtAdj

     c                   endsr
      /free
       // *=========================================================================
       // *  GetCXDT - Get Employer Effective/Cancellation date
       // *=========================================================================
       Begsr GetCXDT;



       Chain(n) (ELCo#:ELEmp#:ELDiv:ELFnd) pem03;
       y1 = 5;

       Dow  ed3(y1) = 0 and (y1 > 1);
          y1 = y1 - 1;
       Enddo;
       yyefdt = ed3(y1);
       yycxdt = cd3(y1);
       //*** begin chg ***  01/04/25  ***************************************
       //*****If yycxdt = xxStRptCxDt or yycxdt > ELPtdt;
       //* Check for cx detail record.
       Setgt (ELCo#:ELFnd:ELFyr:ELEmp#:ELDiv) pcx00;
       Readpe(n) (ELCo#:ELFnd:ELFyr:ELEmp#:ELDiv) pcx00;
       If (not %eof and CXEnfl = ' ' and yycxdt = xxStRptCxDt) or
        yycxdt > ELPtdt;
       //*** end chg *****  01/04/25  ***************************************
          yycxdt = 0;
       Endif;
       //*** begin add ***  01/04/25  ***************************************
       //* Clear deletion date if it did not occur in policy year.
       If yycxdt = ELPtdt and (%eof or CXRedt <> 0);
          yycxdt = 0;
       Endif;
       //*** end add *****  01/04/25  ***************************************

       Endsr;
       // *=========================================================================
       // *  updDivDates - Update Division Name & Dates based on Latest entity
       // *=========================================================================
       Begsr updDivDates;

       If elpfdt < NANamEfd and svefdt <> svexdt;
          NaNamEfd = elpfdt;
          xxchg = 'Y';
       Else;
          If NANamEfd = NAPtdt;
             NANamEfd = elpfdt;
             xxchg = 'Y';
          Endif;
       Endif;

       if napfdt <> naptdt;
          if elpfdt < napfdt;
             napfdt = elpfdt;
             xxchg = 'Y';
          endif;
          if elptdt > naptdt;
             naptdt = elptdt;
             xxchg = 'Y';
          endif;
       else;
          //If cancelled, update to latest cancellation date for name.
          if cxStatus = 'midTermCx';
             if cd(xl) > napfdt;
                napfdt = cd(xl);
                naptdt = cd(xl);
                xxchg  = 'Y';
             endif;
          else;
          //If name is no longer cancelled then update dates.
             napfdt = elpfdt;
             naptdt = elptdt;
             xxchg = 'Y';
          endif;
       endif;

       Endsr;
       // *=========================================================================
       // *  updLocDates - Update Location Name & Dates based on Latest entity
       // *=========================================================================
       Begsr updLocDates;

       If svefdt < NANamEfd and svefdt <> svexdt;
          NaNamEfd = svefdt;
          xxchg = 'Y';
       Else;
          If NANamEfd = NAPtdt;
             NANamEfd = svefdt;
             xxchg = 'Y';
          Endif;
       Endif;

       if napfdt <> naptdt;
          if xaefdt < napfdt;
             napfdt = xaefdt;
             xxchg = 'Y';
          endif;
          if xadldt > naptdt;
             naptdt = xadldt;
             xxchg = 'Y';
          endif;
       else;
          //If cancelled, update to latest cancellation date for name.
          if xxdldt <> 0;
             if xxdldt > napfdt;
                napfdt = xxdldt;
                naptdt = xxdldt;
                xxchg  = 'Y';
             endif;
          else;
          //If name is no longer cancelled then update dates.
             napfdt = xaefdt;
             naptdt = elptdt;
             xxchg = 'Y';
          endif;
       endif;

       Endsr;

       // *=========================================================================
       // *  SchedFormInfo - Retrieve form information for dec page/schedules.
       // *=========================================================================
       Begsr SchedFormInfo;

       Clear addNameFile;
       Clear addLocFile;
       Clear premiumFile;
       Clear endorseFile;
       Clear declareForm;
       Clear addNameForm;
       Clear addLocForm;
       Clear premiumForm;
       Clear endorseForm;
       Clear declareDesc;
       Clear addNameDesc;
       Clear addLocDesc;
       Clear premiumDesc;
       Clear endorseDesc;
       Clear declareDate;
       Clear addNameDate;
       Clear addLocDate;
       Clear premiumDate;
       Clear endorseDate;
       Clear addNameSeq;
       Clear addLocSeq;
       Clear premiumSeq;
       Clear endorseSeq;
       Clear instSchdForm;
       Clear instSchdFile;
       Clear instSchdSeq;
       Clear instSchdDate;
       Clear instSchdDesc;
       Clear declareNatFm;
       Clear addNameNatFm;
       Clear addLocNatFm;
       Clear premiumNatFm;
       Clear endorseNatFm;

       mainSt = RSJrst;
       //* For State National pull declaration page for CA if CA is on policy.
       If cltid = '148' and F2Car# = 30406 and xxCaSt = 'Y' and mainSt <> 'CA';
          mainSt = 'CA';
       Endif;

       //* Declaration Page
       sType = 'D';
       Exsr SchedTemplate;

       If PPCltFrm# <> ' ';
          declareForm = %trim(PPCltFrm#);
          declareNatFm = %trim(PPNatFm);
          //*** Beg Add ***** 05/28/24 **************************
          DeclareSt = PPST;
          //*** End Add ***** 05/28/24 **************************
       Endif;
       declareDate = PPEditDt;
       If PPDesc <> ' ';
          declareDesc = %trim(PPDesc);
       Endif;
       If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
          If PPOrgFrm# <> ' ';
             declareForm = %trim(PPOrgFrm#);
          Endif;
          declareDate = PPEditDtO;
          If PPOrgDesc <> ' ';
             declareDesc = %trim(PPOrgDesc);
          Endif;
       Endif;

       //* Additional Named Insured
       sType = 'N';
       Exsr SchedTemplate;

       If PPCltFrm# <> ' ';
          addNameForm = %trim(PPCltFrm#);
          addNameNatFm = %trim(PPNatFm);
       Endif;
       addNameDate = PPEditDt;
       If PPDesc <> ' ';
          addNameDesc = %trim(PPDesc);
       Endif;
       If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
          If PPOrgFrm# <> ' ';
             addNameForm = %trim(PPOrgFrm#);
          Endif;
          addNameDate = PPEditDtO;
          If PPOrgDesc <> ' ';
             addNameDesc = %trim(PPOrgDesc);
          Endif;
       Endif;

       //* Additional WorkPlaces
       sType = 'W';
       Exsr SchedTemplate;

       If PPCltFrm# <> ' ';
          addLocForm = %trim(PPCltFrm#);
          addLocNatFm = %trim(PPNatFm);
       Endif;
       addLocDate = PPEditDt;
       If PPDesc <> ' ';
          addLocDesc = %trim(PPDesc);
       Endif;
       If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
          If PPOrgFrm# <> ' ';
             addLocForm = %trim(PPOrgFrm#);
          Endif;
          addLocDate = PPEditDtO;
          If PPOrgDesc <> ' ';
             addLocDesc = %trim(PPOrgDesc);
          Endif;
       Endif;

       //* Premium
       sType = 'P';
       Exsr SchedTemplate;

       If PPCltFrm# <> ' ';
          premiumForm = %trim(PPCltFrm#);
          premiumNatFm = %trim(PPNatFm);
       Endif;
       premiumDate = PPEditDt;
       If PPDesc <> ' ';
          premiumDesc = %trim(PPDesc);
       Endif;
       If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
          If PPOrgFrm# <> ' ';
             premiumForm = %trim(PPOrgFrm#);
          Endif;
          premiumDate = PPEditDtO;
          If PPOrgDesc <> ' ';
             premiumDesc = %trim(PPOrgDesc);
          Endif;
       Endif;

       //* Endorsements
       sType = 'E';
       Exsr SchedTemplate;

       If PPCltFrm# <> ' ';
          endorseForm = %trim(PPCltFrm#);
          endorseNatFm = %trim(PPNatFm);
       Endif;
       endorseDate = PPEditDt;
       If PPDesc <> ' ';
          endorseDesc = %trim(PPDesc);
       Endif;
       If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
          If PPOrgFrm# <> ' ';
             endorseForm = %trim(PPOrgFrm#);
          Endif;
          endorseDate = PPEditDtO;
          If PPOrgDesc <> ' ';
             endorseDesc = %trim(PPOrgDesc);
          Endif;
       Endif;
       //*** begin add ***  01/09/24  ******************************************
       Clear instSchd1;
       Clear instSchd2;
       Clear instSchd3;

       sType = '1';
       Exsr SchedTemplate;

       If not %eof;
          If PPCltFrm# <> ' ';
             instSchd1 = %trim(PPCltFrm#);
          Endif;
          If SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
             If PPOrgFrm# <> ' ';
                instSchd1 = %trim(PPOrgFrm#);
             Endif;
          Endif;
       Endif;

       sType = '2';
       Exsr SchedTemplate;

       If not %eof;
          If PPCltFrm# <> ' ';
             instSchd2 = %trim(PPCltFrm#);
          Endif;
          If SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
             If PPOrgFrm# <> ' ';
                instSchd2 = %trim(PPOrgFrm#);
             Endif;
          Endif;
       Endif;

       sType = '3';
       Exsr SchedTemplate;

       If not %eof;
          If PPCltFrm# <> ' ';
             instSchd3 = %trim(PPCltFrm#);
          Endif;
          If SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
             If PPOrgFrm# <> ' ';
                instSchd3 = %trim(PPOrgFrm#);
             Endif;
          Endif;
       Endif;
       //*** end add *****  01/09/24  ******************************************

       // Installment Schedule - Do not populate if no template set up.
       xxKey = %EditC(ELbscd:'X');
       Chain tbkey pbs01;
       If %found;

          Select;
          When BSpayr = 'Y';
             sType = '3';
          When BSsefl = 'E';
             sType = '1';
          When BSsefl = 'S';
             sType = '2';
          EndSl;
          Exsr SchedTemplate;

          If not %eof;
             If PPCltFrm# <> ' ';
                instSchdForm = %trim(PPCltFrm#);
             Endif;
             instSchdDate = PPEditDt;
             If PPDesc <> ' ';
                instSchdDesc = %trim(PPDesc);
             Endif;
             If SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
                If PPOrgFrm# <> ' ';
                   instSchdForm = %trim(PPOrgFrm#);
                Endif;
                instSchdDate = PPEditDtO;
                If PPOrgDesc <> ' ';
                   instSchdDesc = %trim(PPOrgDesc);
                Endif;
             Endif;
          Endif;
       EndIf;
       mainSt = RSJrst;

       Endsr;

       // *=========================================================================
       // *  ScriptXML - Reserve/Update XML record for Scriptura output.
       // *=========================================================================
       Begsr ScriptXML;

       If not isUseXML;
          Leavesr;
       Endif;

       mainSt = RSJrst;

       // If processing midterm endorsement, the XML Prep Request
       // record was written in W7051R1
       If xxProcessType = 'Mid-Term Endorsement';
          Chain(n) ldOutputFile xp103;
          xmlFile = XPXmlT;
          outputFile  = ldOutputFile;
          LeaveSr;
       Endif;

       xmlFile = ' ';
       message = %trim(processType);
       string = ' ';


       If isMassReq;

          StLetter('XMLREQUEST':xmlFile:message:' ':'000000000':'  ':
           'PolicyPage':'000':'000':massFlag:xmlLink);

          isMassReq = *off;
          xmlFileName = xmlFile;
          xmlLink = xmlFile;

          Chain (xmlFile) xp100;
          XPCat = 'PS';
          Update xp100;

       Endif;

       StLetter('XMLREQUEST':xmlFile:message:'E':%editc(x@RRN:'X'):
        xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'):massFlag:xmlLink);

       If xmlFileName = ' ';
          xmlFileName = xmlFile;
       Endif;

       //* The template XML file name must be pulled from record for work files for
       //* single request policy page.  Otherwise it has been returned from the
       //* XML Request call.
       If xmlLink = ' ';
          Chain (xmlFile) xp100;
          xmlFile = XPXmlT;
       Else;
          Chain (xmlFileBlank:xmlLink:xmlFile) xp100;
       Endif;

       outputFile = XPFile;

       //* Set the output file name into the local area for endorsements to pick up.
       In svlda;
       ldOutputFile = outputFile;
       Out svlda;

       If xxpbcg = *off and xxowcg = *off;
          Clear ldeedt;
       Endif;

       order = 1;

       XPData = 'Y';
       sType = 'D';
       Exsr SchedTemplate;

       //* Bundle the declaration page and schedule of premium for Starstone.
       If not %eof and SHCode <> 'K' and *in24 = *off;
          If cltid = '148' and F2Car# = 38073;
             XPBundle = 1;
          Endif;
       Endif;
       XPDcid = XTDcid;
       XPPath = XTPath;
       XPLang = XTLang;

       XPPgm  = Q1PGM;
       XPUser = Q1USER;
       XPTime = Timeto6(SystemTime());
       XPDt   = Dateto7(SystemDate());

       Update xp100;


       Endsr;

       // *=========================================================================
       // *  ScriptFile - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptFile;

       If not isUseXML;
          Leavesr;
       Endif;
       Exsr ScriptVA;

       If order <> 1 and *in32 = *off;

          If xmlLink = ' ';
             Chain (xmlFileName) xp100;
             xmlFile = XPXmlT;
          Else;
             Chain (xmlFileBlank:xmlLink:xmlFile) xp100;
          Endif;

          XPOrder = order;

          Update xp100;

       Endif;

       Open wxpwp;
       Clear ppw0p;

       PWXML  = xmlFile;
       PWCo#  = xxCo#;
       PWFnd  = xxFnd;
       PWEmp# = xxEmp#;
       PWDiv  = xxDiv;
       PWFyr  = xxFyr;

       //* NJ Present on policy
       If *in56 = *on;
          PWNJ = 'Y';
       Endif;

       //* CA style policy page
       If prtCA = *on;
          PWCA = 'Y';
       Endif;

       //* 2nd Limits on policy
       If *in97 = *on;
          PW2ndLmt = 'Y';
       Endif;

       //* Net rate on policy
       If *in84 = *on;
          PWNetRate = 'Y';
       Endif;

       //* Policy page overlay/page segment name for images
       If xxPDF = 'Y';
          PWImage = %trim(F2Dcid);
       Endif;

       //* Premium or Contribution wording
       If *in58 = *on;
          PWPrmWord = 'Premium';
       Else;
          PWPrmWord = 'Contribution';
       Endif;

       If *in24 = *on;
          PWReissue = 'Reissue';
       Endif;

       If *in25 = *on;
          If prtCA;
             PWRenew = 'Renewal';
          Else;
             PWRenew = 'Renewal Agreement';
          Endif;
       Endif;

       If (shcode = 'W' or shcode = 'K');
          If (cltid = '148' and F2Car# = 38073);
             PWRewrite = 'Y';
          Endif;
       Endif;

       //* Group Name/Address
       PWInsNam = %trim(FNName);
       If prtCA;
          PWInsAd1 = %trim(faa(1));
          If faa(3) <> ' ';
             PWInsAd2 = %trim(faa(2));
             PWInsCSZ = %trim(faa(3));
          Else;
             PWInsCSZ = %trim(faa(2));
          Endif;
       Else;
          PWInsAd1 = %trim(FNMAd1);
          PWInsAd2 = %trim(FNMAd2);
          PWInsCSZ = %trim(xxFCSZ);
       Endif;
       PWInsCity = %trim(xxfCity);
       PWInsSt = xxfSt2;
       PWInsZip = xxfZip;

       //* Agent Information
       PWPrdHdg = %trim(xhProd);
       PWAgtHdg = %trim(xxAHdr);
       PWAgt#   = SHAgt#;
       If prtCA;
          PWAgtNam = %trim(xxPrag);
       Else;
          PWAgtNam = %trim(xxAgNm);
       Endif;
       PWAgtAdr = %trim(xxAgAd);
       PWAgtCSZ = %trim(xxACSZ);
       PWAgtCity = %trim(xxaCity);
       PWAgtSt = xxaSt;
       PWAgtZip = xxaZip;
       PWPrtLink = EXPrtL;

       //* Carrier Info
       PWCar#   = F2Car#;
       PWPEOTax = %trim(xxPEOH);

       PWPEOName = ##PEO1 + ##PEO2;

       //* Policy Info
       PWPolHdg  = 'Carrier Policy #:';
       PWPol#    = %trim(xPol);
       PWPPolHdg = 'Carrier Prior Policy #:';
       PWPPol#   = %trim(xPPol);
       PWNJTaxHd = 'N.J. Taxpayer Identification No.:';
       PWNJTaxId = %trim(xxTxId);
       PWFileHdg = 'File #:';
       PWFile#   = %editc(xxfnd:'X') + %editc(xxemp#:'X') + %editc(xxfyr:'X');
       PWFein    = xaFein;

       //* Policy Name/Address

       PWPolName = xxSchName;
       PWPolFdnm = xxSchFdnm;
       PWPolAdr1 = xxSchAdr1;
       PWPolAdr2 = xxSchAdr2;
       PWPolCity = xxSchCity;
       PWPolSt   = xxSchSt;
       PWPolZip  = xxSchZip;

       PWDecNam1 = QQName1;
       PWDecNam2 = QQName2;
       PWDecNam3 = QQName3;
       PWDecNam4 = QQName4;
       PWDecAdr1 = %trim(amn(##adrl));
       PWDecAdr2 = %trim(amn(##adrl+1));
       PWDecAdr3 = %trim(amn(##adrl+2));

       //* Type of Business
       PWBusType = %trim(xxBTyp4);

       //* CA override was here for type of businesses.

       If *in23 = *on;
          PWOtherW  = 'See Schedule of Operations';
          If prtCA;
             PWOtherW  = 'See Schedule of Locations';
          Endif;
          If addLocDesc <> ' ';
             PWOtherW  = 'See ' + %trim(addLocDesc);
          Endif;
       Else;
          PWOtherW  = 'No Other Workplaces for this Policy';
       Endif;

       PWRisk#   = %trim(xxRisk);

       PWFrmDate = xxPfDt;
       PWToDate  = xxPtDt;

       For x = 1 to 50;
          arr3ast(x) = xst(x);
       Endfor;

       //* Limits info
       PWLmtAcc  = xxAcc;
       PWLmtAgg  = xxAgg;
       PWLmtDis  = xxDis;

       PWLmtAcc2 = x2Acc;
       PWLmtAgg2 = x2Agg;
       PWLmtDis2 = x2Dis;

       PWLmt2Dt  = x8i2Ef;

       PW3CText1 = %trim(xxpp3c);
       PW3CText2 = %trim(xxppc3);

       //* Endorsements
       Clear ENFormO;
       If *in95 = *off;
          Open wxp4p;
          count = 0;
          For x = 1 to 20;
             If xf(x) <> ' ';
                endsForm = xf(x);
                muenst = xfSt(x);
                mudesc = xfDesc(x);
                mudsc2 = xfDesc(x);
                mueedt = 0;
                eneddt = 0;
                Exsr ScriptForms;
             Endif;
          Endfor;
          Close wxp4p;
       Else;
          PW3dText = %trim(ddtl);
          If endorseDesc <> ' ' and %trim(ddtl) <> %trim(d2dtl);
             PW3dText = 'See ' + %trim(endorseDesc);
          Endif;
       Endif;

       PWClsText = 'See Schedule of Operations';
       If addLocDesc <> ' ';
          PWClsText = 'See ' + %trim(premiumDesc);
       Endif;

       //* Premium info
       PWEstPrm  = xxPrm;
       PWProPrm  = xxPror;
       PWMinPrm  = xxMnpr;
       PWExpCst  = xxExcn;
       PWPrmDisc = tam(7);
       PWProExp  = xxtxpc;
       // Send FWCIGA total and total including FWCIGA to Scriptura
       If decFWCIGATotal <> 0;
          PWFWCIGA = decFWCIGATotal;
          //*** Beg Chg *****  02/28/25  *******************************************
          // Expense Constant is already got added to xxPrm and
          // Total Cost on Desclaration Page is printed only for FL
          //*** PWFlTtlA = PWEstPrm + PWExpCst + PWFWCIGA;
          PWFlTtlA = PWEstPrm + PWFWCIGA;
          //*** End Chg *****  02/28/25  *******************************************
       Endif;
       Clear decFWCIGATotal;
       If prtCA;
          PWDepPrm  = xxPdpr;
       Else;
          PWDepPrm  = xxDep;
       Endif;
       PWAssTtl = TAM(21);
       PWTotal = TAM(22);

       PWExpMod  = xxExm1;
       PWPrtDate = xxDate;
       PWSrvOff  = %trim(xxOfad);
       PWPrmAdj = 'Annually';

       //* Form info
       If not prtCA;

          PWForm#   = xxDecForm;
          PWAddFrm# = xxDecForm;
          PWLocFrm# = xxDecForm;
          PWPrmFrm# = xxDecForm;
          PWEndFrm# = xxDecForm;
          If declareForm <> ' ';
             PWForm# = declareForm;
          Endif;
          If addNameForm <> ' ';
             PWAddFrm# = addNameForm;
          Endif;
          If addLocForm <> ' ';
             PWLocFrm# = addLocForm;
          Endif;
          If premiumForm <> ' ';
             PWPrmFrm# = premiumForm;
          Endif;
          If endorseForm <> ' ';
             PWEndFrm# = endorseForm;
          Endif;
          If instSchdForm <> ' ';
             PWInsFrm# = instSchdForm;
          Endif;

       Else;

          PWCAFrm#1 = 'WC 04 00 01 A @1998 by the Workers'' Compensation In' +
           'surance Rating Bureau of California.  All';
          PWCAFrm#2 = 'rights reserved.  From the WCIRB''s CA Workers'' Com' +
           'pensation Insurance Forms Manual @2001.';

          PWAddCF#1 = 'WC 04 00 02  @1998 by the Workers'' Compensation In' +
           'surance Rating Bureau of';
          PWAddCF#2 = 'California. All rights reserved. From the WCIRB''s ' +
           'California Workers''';
          PWAddCF#3 = 'Compensation Insurance Forms Manual @2001.';

          PWLocCF#1 = 'WC 04 00 03  @1998 by the Workers'' Compensation In' +
           'surance Rating Bureau of';
          PWLocCF#2 = 'California. All rights reserved. From the WCIRB''s ' +
           'California Workers''';
          PWLocCF#3 = 'Compensation Insurance Forms Manual @2001.';

          PWEndCF#1 = 'WC 04 00 04  @1998 by the Workers'' Compensation In' +
           'surance Rating Bureau of';
          PWEndCF#2 = 'California. All rights reserved. From the WCIRB''s ' +
           'California Workers''';
          PWEndCF#3 = 'Compensation Insurance Forms Manual @2001.';

          PWPrmCF#1 = 'WC 04 00 05  @1998 by the Workers'' Compensation In' +
           'surance Rating Bureau of';
          PWPrmCF#2 = 'California. All rights reserved. From the WCIRB''s ' +
           'California Workers''';
          PWPrmCF#3 = 'Compensation Insurance Forms Manual @2001.';
          If declareForm <> ' ';
             PWCAFrm#1 = declareForm;
             Clear PWCAFrm#2;
          Endif;
          If addNameForm <> ' ';
             PWAddCF#1 = addNameForm;
             Clear PWAddCF#2;
             Clear PWAddCF#3;
          Endif;
          If addLocForm <> ' ';
             PWLocCF#1 = addLocForm;
             Clear PWLocCF#2;
             Clear PWLocCF#3;
          Endif;
          If premiumForm <> ' ';
             PWPrmCF#1 = premiumForm;
             Clear PWPrmCF#2;
             Clear PWPrmCF#3;
          Endif;
          If endorseForm <> ' ';
             PWEndCF#1 = endorseForm;
             Clear PWEndCF#2;
             Clear PWEndCF#3;
          Endif;
          If instSchdForm <> *blanks;
             PWInsCF#1 = instSchdForm;
             Clear PWInsCF#2;
             Clear PWInsCF#3;
          Endif;

       Endif;

       //* Edition dates for declartion page/schedules
       PWFormDt = DtMDYY(declareDate);
       PWAddDt  = DtMDYY(addNameDate);
       PWLocDt  = DtMDYY(addLocDate);
       PWPrmDt  = DtMDYY(premiumDate);
       PWEndDt  = DtMDYY(endorseDate);
       //* Default edition dates based on declaration page used, using 1/1/1998 for CA.
       If *in75 = *on;
          xxDecDate = 980101;
       Endif;
       If PWFormDt = 0;
          PWFormDt = DtMDYY(xxDecDate);
       Endif;
       If PWAddDt = 0;
          PWAddDt = DtMDYY(xxDecDate);
       Endif;
       If PWLocDt = 0;
          PWLocDt = DtMDYY(xxDecDate);
       Endif;
       If PWPrmDt = 0;
          PWPrmDt = DtMDYY(xxDecDate);
       Endif;
       If PWEndDt = 0;
          PWEndDt = DtMDYY(xxDecDate);
       Endif;
       PWAddSeq = addNameSeq;
       PWLocSeq = addLocSeq;
       PWPrmSeq = premiumSeq;
       PWEndSeq = endorseSeq;
       PWInsDt  = DtMdyy(instSchdDate);
       PWInsSeq = instSchdSeq;

       //* List federal name first on schedules for NJ.
       If *in56 = *on;
          PWSchNam1 = xxSchFdnm;
          PWSchNam2 = xxSchName;
       Else;
          PWSchNam1 = xxSchName;
          PWSchNam2 = xxSchFdnm;
       Endif;

       PWSchAdr1 = %trim(xxead1);
       PWSchAdr2 = %trim(xxead2);
       PWSchAdr3 = %trim(xxecsz);
       PWSchRisk = %trim(x4txid);
       PWSchDivH = xxhdiv;
       PWSchLocH = xxhlid1;

       If cltId = '140';
          PWsupd = 'Y';
       Endif;

       PWPgm  = Q1PGM;
       PWUser = Q1USER;
       PWTime = Timeto6(SystemTime());
       PWDt   = Dateto7(SystemDate());

       Write ppw0p;
       Close wxpwp;
       //* Set the premium for endorsements into the LDA.
       In svlda;
       ldEndrPrem = PWProPrm + PWProExp;
       Out svlda;

       Endsr;

       // *=========================================================================
       // *  ScriptAddNames - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptAddNames;

       If not isUseXML;
          Leavesr;
       Endif;

       //* Do not print flat cancelled additional named insured for Amwins
       If cltid = '148' and xoefdt <> 0 and xoefdt = xodldt;
          Leavesr;
       Endif;

       Clear pp20p;

       If addNameFile = ' ';
          message = %trim(xxProcessType);

          templateFile = outputFile;
          StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
           xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

          Chain (templateFile) xt100;

          sType = 'N';
          Exsr SchedTemplate;
          XTType = 'Schedule of Named Insureds';

          Update xt100;

          addNameFile = templateFile;
       Endif;

       P2XML    = addNameFile;

       count = count + 1;
       P2Key = count;

       P2Type   = 'A';
       P2AddNam = ANName + ANNam2;
       Select;
       When EMpAd1 <> *blanks;
          P2physAd1 = EMpAd1;
          P2physAd2 = EMpAd2;
          P2physCty = EMpCty;
          P2physSt  = EMpSt;
          P2physZip = EMpZip;
       When EMpAd1 = *blanks and EMmAd1 <> *blanks;
          P2physAd1 = EMmAd1;
          P2physAd2 = EMmAd2;
          P2physCty = EMmCty;
          P2physSt  = EMmSt;
          P2physZip = EMmZip;
       Endsl;
       If clientLCF = 'Y';
          P2AddNam = %trim(QQPEOExt) + ' ' + %trim(P2AddNam);
       Endif;
       P2Fein   = %editc(ANFein : 'X');
       P2Seq# = ANSeq#;
       P2link = locemlink;
       P2LocElty = ' ';
       P2LocBTyp = xxBusType;

       If *in69 = *on;
          P2EffDate = xoEfdt;
       Endif;

       If *in79 = *on;
          P2ExpDate = xoDldt;
       Endif;

       P2Pgm  = Q1PGM;
       P2User = Q1USER;
       P2Time = Timeto6(SystemTime());
       P2Dt   = Dateto7(SystemDate());

       Write pp20p;

       Endsr;

       // *=========================================================================
       // *  ScriptAddLocs - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptAddLocs;

       If not isUseXML;
          Leavesr;
       Endif;

       If ldAddNamed = '1';
          Leavesr;
       Endif;

       //* Do not print flat cancelled locations for Amwins
       If cltid = '148' and xoefdt <> 0 and xoefdt = xodldt;
          Leavesr;
       Endif;

       Clear pp20p;

       If addLocFile = ' ';
          message = %trim(xxProcessType);

          templateFile = outputFile;
          StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
           xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

          Chain (templateFile) xt100;

          sType = 'W';
          Exsr SchedTemplate;
          XTType = 'Schedule of Workplaces';

          Update xt100;

          addLocFile = templateFile;
       Endif;

       P2XML    = addLocFile;

       count = count + 1;
       P2Key = count;

       P2Type    = 'L';
       P2LocName = %trim(xxLocName);
       P2LocFdnm = %trim(xxLocFdnm);
       If n1fein <> 0;
          P2Fein    = %editc(n1fein:'X');
       Endif;

       If *in69 = *on;
          P2EffDate = xoEfdt;
       Endif;

       If *in79 = *on;
          P2ExpDate = xoDldt;
       Endif;

       P2PhysAd1 = %trim(xxoad1);
       P2PhysAd2 = %trim(xxoad2);
       P2PhysCsz = %trim(xxocsz);
       P2PhysCty = %trim(xxPhysCity);
       P2PhysSt  = %trim(xxPhysState);
       P2PhysZip = xxPhysZip;

       P2MailAd1 = %trim(x2oad1);
       P2MailAd2 = %trim(x2oad2);
       P2MailCsz = %trim(x2ocsz);
       P2MailCty = %trim(xxMailCity);
       P2MailSt  = %trim(xxMailState);
       P2MailZip = xxMailZip;

       P2StUE#   = %trim(x0SUE#);
       P2TaxID   = %trim(x1TxID);
       P2RiskID  = %trim(x3TxID);
       P2NAICS   = %trim(xoNAID);
       P2SIC     = %trim(xoSICD);
       P2LeaseID = %trim(N1LsID);
       P2LeaseDs = %trim(N1LsDs);

       P2Div# = xxDiv1;
       P2Loc# = xxELID;
       P2encd = locencd;
       P2nlkc = locnlkc;
       P2encdFed = locencdFed;
       P2nlkcFed = locnlkcFed;
       P2empy = locempy;
       P2link = locemlink;
       P2LocElty = xxELType;
       P2LocBTyp = xxBusType;
       P2LocPhn  = xxLocPhn;
       P2LocArea = xxLocPhnA;
       P2LocFax  = xxLocFax;
       P2LocFAra = xxLocFaxA;

       P2Pgm  = Q1PGM;
       P2User = Q1USER;
       P2Time = Timeto6(SystemTime());
       P2Dt   = Dateto7(SystemDate());

       Write pp20p;

       Endsr;

       // *=========================================================================
       // *  ScriptPremPage - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptPremPage;

       If not isUseXML;
          Leavesr;
       Endif;

       Clear pp30p;

       If premiumFile = ' ';
          message = %trim(xxProcessType);

          templateFile = outputFile;
          StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
           xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

          Chain (templateFile) xt100;

          sType = 'P';
          Exsr SchedTemplate;
          XTType = 'Schedule of Classifications';

          Update xt100;

          premiumFile = templateFile;
          If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
             Chain (templateFile) xt100;

          //* Bundle the declaration page and schedule of premium for Starstone.
             If cltid = '148' and F2Car# = 38073;
                XTBundle = 1;
             Endif;

             Update xt100;
          Endif;
       Endif;

       P3XML = premiumFile;

       count = count + 1;
       P3Key = count;

       P3Type = ' ';
       P3St   = xxpst;

       If *in52 = *on;
          P3NoPay = 'Y';
       Endif;

       If *in96 = *on;
          P3ModTxt = 'Merit Rating';
       Else;
          P3ModTxt = 'Experience Modifiers';
       Endif;

       If P3St = '**';
          Clear P3State;
          P3Exm1   = xxexm1;
          P3Exm2   = xxexm2;
          P3Exm3   = xxexm3;
          P3ExmDt1 = xxemd1;
          P3ExmDt2 = xxemd2;
          P3ExmDt3 = xxemd3;
          //*** Beg Chg *** 02/14/25 *****************************
          //***If *in43 = *on;
          //***   P3Prem   = tam(12);
          //***Else;
          //***   P3Prem   = tam(10);
          //***Endif;
          P3Prem   = tam(12);
          //*** End Chg *** 02/14/25 *****************************

          P3Total  = tam(22);
       Else;
          P3State = %trim(TitleCase(getStateName(P3St)));
          P3Exm1   = xsexm1;
          P3Exm2   = xsexm2;
          P3Exm3   = xsexm3;
          P3ExmDt1 = xsemd1;
          P3ExmDt2 = xsemd2;
          P3ExmDt3 = xsemd3;
          P3Arp1 = xsArp1;
          P3Arp2 = xsArp2;
          P3Arp3 = xsArp3;
          P3TeRtHdg = xxTerHdg;
          P3TeRtFct = xxTerFac;
          //*** Beg Chg *** 02/14/25 *****************************
          //***If *in43 = *on;
          //***   P3Prem   = tas12;
          //***Else;
          //***   P3Prem   = tas10;
          //***Endif;
          P3Prem   = tas12;
          //*** End Chg *** 02/14/25 *****************************

          P3Total  = tas22;
       //* Terrorism breakdown
          If tas29 <> 0;
             If RRTerH <> ' ';
                P3TerDes = RRTerH;
             Else;
                P3TerDes = con(30);
             Endif;
             P3TerPay = tasTerPay;
             P3TerRte = tasTerRate;
             P3TerAmt = tasTerPrm;
             P3TerNPay = tasTerPay2;
             P3TerNRte = RRTer2;
             P3TerNAmt = tasTerPrm2;
             P3TerTotl = tas29;
          Endif;

       //* Domestic Terrorism breakdown
          If tasDtr <> 0;
             If RRDTrH <> ' ';
                P3DomDes = RRDTrH;
             Else;
                P3DomDes = con(36);
             Endif;
             P3DomPay = tasDomPay;
             P3DomRte = tasDomRate;
             P3DomAmt = tasDtr;
          Endif;

          //Experience Modifier Status
          If xsExMd1NF = 'Y';
             P3ModSts1 = 'N';            //N = Not Final
          Else;
             P3ModSts1 = ' ';            //Blank = Final
          Endif;

          If xsExMd2NF = 'Y';
             P3ModSts2 = 'N';            //N = Not Final
          Else;
             P3ModSts2 = ' ';            //Blank = Final
          Endif;

          If xsExMd3NF = 'Y';
             P3ModSts3 = 'N';            //N = Not Final
          Else;
             P3ModSts3 = ' ';            //Blank = Final
          Endif;

       Endif;

       P3Pgm  = Q1PGM;
       P3User = Q1USER;
       P3Time = Timeto6(SystemTime());
       P3Dt   = Dateto7(SystemDate());

       Write pp30p;

       Endsr;

       // *=========================================================================
       // *  ScriptPremDtl - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptPremDtl;

       If not isUseXML;
          Leavesr;
       Endif;

       Clear pp30p;

       Select;
       When item4Type = 1;
          P3Type = 'E';
       When item4Type = 3;
          P3Type = 'P';
       Other;
          Leavesr;
       Endsl;

       P3XML = premiumFile;

       count = count + 1;
       P3Key = count;

       P3St  = xxpst;

       Select;
       When item4Type = 1;

          P3PayCls  = x3clas;
          P3PaySpc  = EPSpec;
          P3PayExt  = xxext;
          P3PayDes  = %trim(EPDesc);
          P3PayAmt  = x2eapr;
          P3Sign    = xnemsn;
          If *in84 = *on;
             P3PayRte  = xnarat;
             P3PayPrm  = xnempr;
          Else;
             P3PayRte  = EPArat;
             P3PayPrm  = EPEmpr;
          Endif;
          P3tdf  = outTDF;
          P3PayLink = EPLink;

          If *in91 = *on;
             P3PayEfd = Dtmdyy(EPFrav);
             P3PayExd = Dtmdyy(EPToav);
          Else;
             If EPEfdt <> *hival;
                P3PayEfd = Dtmdyy(EPEfdt);
             Else;
                P3PayEfd = Dtmdyy(ELPfdt);
             Endif;
             P3PayExd = Dtmdyy(ELPtdt);
          Endif;

          If *in92 = *on;
             P3PayAdl  = EPAdld;
             Select;
             When *in64 = *off;
                P3PayAdv = 'Additional Load';
                If monoState;
                   P3PayAdv = 'Stop Gap Premium';
                Endif;
             When *in64 = *on;
                P3PayAdv = 'Territory Differential';
             When *in35 = *on;
                P3PayAdv = 'Charge';
             Endsl;
          Endif;

       When item4Type = 3;

          P3PrmHdg  = %trim(xxhdg);
          If xxHeading <> ' ';
             P3PrmHdg  = %trim(xxHeading);
          Endif;
          P3Sign = xxSign;
          P3PrmPrc = xxPercent;
          P3PrmPrcF = xxPercentF;
          P3PrmFact = xxFactor;
          P3PrmCode = xxStatCode;
          P3PrmAmt  = xxtam;
          P3PrmAss = assFlg;

       Endsl;


       P3Pgm  = Q1PGM;
       P3User = Q1USER;
       P3Time = Timeto6(SystemTime());
       P3Dt   = Dateto7(SystemDate());

       Write pp30p;

       Endsr;

       // *=========================================================================
       // *  ScriptForms - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptForms;

       If not isUseXML;
          Leavesr;
       Endif;

       Clear pp40p;

       If *in95 = *on and endorseFile = ' ';
          message = %trim(xxProcessType);

          templateFile = outputFile;
          StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
           xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

          Chain (templateFile) xt100;

          sType = 'E';
          Exsr SchedTemplate;
          XTType = 'Schedule of Endorsements';

          Update xt100;

          endorseFile = templateFile;
       Endif;

       If *in95 = *on;
          P4XML = endorseFile;
       Else;
          P4XML = xmlFile;
       Endif;
       strSvP4XML = P4XML;
       P4Occur = 1;
       P4Form  = endsForm;
       //*** Beg Chg ***** 05/28/24 **********************************
       //***P4St = muenst;
       If MUdsc2 = 'Declaration Page';
          P4St = xxenst;
       Else;
          P4St = muenst;
       Endif;
       //*** End Chg ***** 05/28/24 **********************************
       If MUdsc2 <> *blanks;
          P4Desc = MUdsc2;
       Else;
          P4Desc = MUdesc;
       Endif;

       P4EffDt = DtMDYY(mueedt);
       P4EdiDt = DtMDYY(eneddt);
       P4formO = ENformO;

       count = count + 1;
       P4Key = count;

       P4Pgm  = Q1PGM;
       P4User = Q1USER;
       P4Time = Timeto6(SystemTime());
       P4Dt   = Dateto7(SystemDate());

       Write pp40p;

       Endsr;

       // *=========================================================================
       // *  ScriptLoss - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptLoss;

       If not isUseXML or NXSPLN = 'Y';
          Leavesr;
       Endif;

       Clear pp60p;

       message = %trim(xxProcessType);

       templateFile = outputFile;
       StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
        xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

       Chain (templateFile) xt100;

       XTOrder = order;

       Setgt ('N':'L':SHFnd:xxLossSt:strPdt) ppp00;
       Readpe(n) ('N':'L':SHFnd:xxLossSt) ppp00;
       If not %eof;
          If PPPolDocC <> ' ';
             XTDcid = PPPolDocC;
             XTPath = PPPolPthC;
             XTLang = PPLangC;
          Else;
             XTDcid = PPPolDoc;
             XTPath = PPPolPth;
             XTLang = PPLangD;
          Endif;
       Else;
          Setgt ('N':'L':000:xxLossSt:strPdt) ppp00;
          Readpe(n) ('N':'L':000:xxLossSt) ppp00;
          If not %eof;
             If PPPolDocC <> ' ';
                XTDcid = PPPolDocC;
                XTPath = PPPolPthC;
                XTLang = PPLangC;
             Else;
                XTDcid = PPPolDoc;
                XTPath = PPPolPth;
                XTLang = PPLangD;
             Endif;
          Endif;
       Endif;

       XTType = 'Loss Prevention Notice';

       Update xt100;

       order = order + 1;

       P6XML = templateFile;

       P6PrevSt = xxLossSt;
       P6DeptName = %trim(NXDept);
       P6DeptArea = NXDPAR;
       P6DeptPhn# = NXDPPN;
       P6FNName = FNName;
       P6FNMad1 = FNMad1;
       P6FNMad2 = FNMad2;
       P6FNMCty = FNMCty;
       P6FNMSt  = FNMSt;
       P6FNMZip = FNMZip;

       P6Pgm  = Q1PGM;
       P6User = Q1USER;
       P6Time = Timeto6(SystemTime());
       P6Dt   = Dateto7(SystemDate());

       Write pp60p;

       Endsr;
       // *=========================================================================
       // *  SchedTemplate - Check the policy page setup file for schedule template.
       // *=========================================================================
       Begsr SchedTemplate;

          Setgt ('S':sType:SHFnd:mainSt:strPdt) ppp00;
          Readpe(n) ('S':sType:SHFnd:mainSt) ppp00;
          If not %eof;
             If PPPolDocC <> ' ';
                XTDcid = PPPolDocC;
                XTPath = PPPolPthC;
                XTLang = PPLangC;
             Else;
                XTDcid = PPPolDoc;
                XTPath = PPPolPth;
                XTLang = PPLangD;
             Endif;
          Else;
             Setgt ('S':sType:SHFnd:'  ':strPdt) ppp00;
             Readpe(n) ('S':sType:SHFnd:'  ') ppp00;
             If not %eof;
                If PPPolDocC <> ' ';
                   XTDcid = PPPolDocC;
                   XTPath = PPPolPthC;
                   XTLang = PPLangC;
                Else;
                   XTDcid = PPPolDoc;
                   XTPath = PPPolPth;
                   XTLang = PPLangD;
                Endif;
             Else;
                Setgt ('S':sType:000:mainSt:strPdt) ppp00;
                Readpe(n) ('S':sType:000:mainSt) ppp00;
                If not %eof;
                   If PPPolDocC <> ' ';
                      XTDcid = PPPolDocC;
                      XTPath = PPPolPthC;
                      XTLang = PPLangC;
                   Else;
                      XTDcid = PPPolDoc;
                      XTPath = PPPolPth;
                      XTLang = PPLangD;
                   Endif;
                Else;
                   Setgt ('S':sType:000:'  ':strPdt) ppp00;
                   Readpe(n) ('S':sType:000:'  ') ppp00;
                   If not %eof;
                      If PPPolDocC <> ' ';
                         XTDcid = PPPolDocC;
                         XTPath = PPPolPthC;
                         XTLang = PPLangC;
                      Else;
                         XTDcid = PPPolDoc;
                         XTPath = PPPolPth;
                         XTLang = PPLangD;
                      Endif;
                   Endif;
                Endif;
             Endif;
          Endif;
          If not %eof and SHCode <> 'K' and *in24 = *off and PPPolDocO <> ' ';
             XTDcid = PPPolDocO;
             XTPath = PPPolPthO;
             XTLang = PPLangO;
          Endif;

       Endsr;
       // *=========================================================================
       // *  ScriptOrder - Assign proper order value for the schedules in work files.
       // *=========================================================================
       Begsr ScriptOrder;

       If xxProcessType = 'Mid-Term Endorsement';
          LeaveSr;
       Endif;

       //* Additional named insured
       If addNameFile <> ' ';
          Chain (addNameFile) xt100;
          If %found;
             order = order + 1;
             XTOrder = order;
             Update xt100;
          Endif;
       Endif;

       //* Additional Workplaces
       If addLocFile <> ' ';
          Chain (addLocFile) xt100;
          If %found;
             order = order + 1;
             XTOrder = order;
             Update xt100;
          Endif;
       Endif;

       //* Classifications
       If premiumFile <> ' ';
          Chain (premiumFile) xt100;
          If %found;
             order = order + 1;
             XTOrder = order;
             Update xt100;
          Endif;
       Endif;

       //* Endorsements
       If endorseFile <> ' ';
          Chain (endorseFile) xt100;
          If %found;
             order = order + 1;
             XTOrder = order;
             Update xt100;
          Endif;
       Endif;

       Endsr;

       // *=========================================================================
       // *  ScriptDE - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptDE;

       If not isUseXML;
          Leavesr;
       Endif;
       Setgt (xxco#:xxfnd:'DE':xxefdt) pnx01m;
       Readpe(n) (xxco#:xxfnd:'DE') pnx01m;
       If (not %eof and NXSPLN = 'Y') or *in32 = *on;
          Leavesr;
       Endif;

       message = %trim(xxProcessType);

       templateFile = outputFile;
       StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
        xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

       Chain (templateFile) xt100;

       XTOrder = order;

       Setgt ('N':'D':SHFnd:'DE':strPdt) ppp00;
       Readpe(n) ('N':'D':SHFnd:'DE') ppp00;
       If not %eof;
          If PPPolDocC <> ' ';
             XTDcid = PPPolDocC;
             XTPath = PPPolPthC;
             XTLang = PPLangC;
          Else;
             XTDcid = PPPolDoc;
             XTPath = PPPolPth;
             XTLang = PPLangD;
          Endif;
       Else;
          Setgt ('N':'D':000:'DE':strPdt) ppp00;
          Readpe(n) ('N':'D':000:'DE') ppp00;
          If not %eof;
             If PPPolDocC <> ' ';
                XTDcid = PPPolDocC;
                XTPath = PPPolPthC;
                XTLang = PPLangC;
             Else;
                XTDcid = PPPolDoc;
                XTPath = PPPolPth;
                XTLang = PPLangD;
             Endif;
          Endif;
       Endif;

       XTType = 'Policy Form';

       Update xt100;

       order = order + 1;

       Endsr;
       // *=========================================================================
       // *  ScriptVA - Write record to work file for Scriptura output
       // *=========================================================================
       Begsr ScriptVA;

       q1emp# = %editc(shemp#:'X');
       q1div  = %editc(shdiv:'X');
       q1fyr  = %editc(shfyr:'X');
       @@rtcd = 'N';

       W7413RMPD(qqco#:qqfnd:q1emp#:q1div:q1fyr:@@rtcd);

       If @@rtcd <> ' ';
          Clear @@rtcd;
          Leavesr;
       Endif;
       Setgt (xxco#:xxfnd:'VA':xxefdt) pnx01m;
       Readpe(n) (xxco#:xxfnd:'VA') pnx01m;
       If (not %eof and NXSPLN = 'Y') or *in32 = *on;
          Leavesr;
       Endif;

       message = %trim(xxProcessType);

       templateFile = outputFile;
       StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
        xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));

       Chain (templateFile) xt100;

       XTOrder = order;

       Setgt ('N':'P':SHFnd:'VA':strPdt) ppp00;
       Readpe(n) ('N':'P':SHFnd:'VA') ppp00;
       If not %eof;
          If PPPolDocC <> ' ';
             XTDcid = PPPolDocC;
             XTPath = PPPolPthC;
             XTLang = PPLangC;
          Else;
             XTDcid = PPPolDoc;
             XTPath = PPPolPth;
             XTLang = PPLangD;
          Endif;
       Else;
          Setgt ('N':'P':000:'VA':strPdt) ppp00;
          Readpe(n) ('N':'P':000:'VA') ppp00;
          If not %eof;
             If PPPolDocC <> ' ';
                XTDcid = PPPolDocC;
                XTPath = PPPolPthC;
                XTLang = PPLangC;
             Else;
                XTDcid = PPPolDoc;
                XTPath = PPPolPth;
                XTLang = PPLangD;
             Endif;
          Endif;
       Endif;

       XTType = 'Policy Form';

       Update xt100;

       order = order + 1;

       Endsr;

       // *=========================================================================
       // *  InstallSched - Print a schedule of installments
       // *=========================================================================
       Begsr InstallSched;

       If not isuseSpoolOut;
          Leavesr;
       Endif;
       Clear arrDate;
       Clear arrPrem;
       Clear arrSurc;
       Clear arrFee;
       Clear arrTotal;
       Clear svMM;

       Setll (SHCo#:SHFnd:SHFyr:SHEmp#) pea15;
       Reade (SHCo#:SHFnd:SHFyr:SHEmp#) pea15;
       If %eof;
          LeaveSR;
       Endif;

       x7pfdt = EAPodt;
       svpodt = DtMDYY(EAPodt);
       svMM = mm;
       x = 1;

       Dow not %eof;

          x7pfdt = EAPodt;

          If svMM <> mm;
             arrTotal(x) = arrPrem(x) + arrSurc(x) + arrFee(x);
             arrDate(x) = svpodt;
             x = x + 1;
             svMM = mm;
             svpodt = DtMDYY(EAPodt);
          Endif;

          Select;
          When EAARTY = 'F' and (EACTYP = '1' or EACTYP = '2' or EACTYP = '3' or
           EACTYP = '4' or EACTYP = '5' or EACTYP = '6' or EACTYP = '7' or
           EACTYP = 'T');
             arrSurc(x) = arrSurc(x) + EAAMT;
          When EAARTY = 'F';
             arrFee(x) = arrFee(x) + EAAMT;
          When EAARTY = 'A' or EAARTY = 'B';
             arrPrem(x) = arrPrem(x) + EAAMT;
          Endsl;

          Reade (SHCo#:SHFnd:SHFyr:SHEmp#) pea15;
       Enddo;

       arrTotal(x) = arrPrem(x) + arrSurc(x) + arrFee(x);
       arrDate(x) = svpodt;

       Write constAM;
       Write const5AM;
       Write boxes5AM;

       z = 1;
       Dow z <= x;
          insprtdt = arrDate(z);
          insDesc  = 'Installment ' + %editc(z:'Z') + ' of ' + %editc(x:'Z');
          insPrem  = arrPrem(z);
          insSurc  = arrSurc(z);
          insFee   = arrFee(z);
          insTotal = arrTotal(z);

          Write det5AM;
          z = z + 1;
       Enddo;

       insPremT  = %xfoot(arrPrem);
       insSurcT  = %xfoot(arrSurc);
       insFeeT   = %xfoot(arrFee);
       insTotalT = %xfoot(arrTotal);

       Write tot5AM;
       Write foot5AM;

       Endsr;

      /end-free
      //*------------------------------------------------------------------
      // POCNotice2 -  POC Notice - Allows multiple runs
      //*------------------------------------------------------------------
       Begsr PocNotice2;
       For d = 1 to 15;
          If sst(d) = 'MI';
             Exsr POCNotice;
          Endif;
       Endfor;
       Endsr;
    C*====================================================================
    C* POCNotice - POC Notice
    C*====================================================================
     C     POCNotice     begsr
     C*
     C* Setup POC record for the state if there is an address present, there
     C* is a POC form setup for the state, and this is the first new or renewal
     C* policy page for this state.
     C*
     C                   Clear                   xxPOCDoc         60
     C                   Clear                   xxPOCPth        250
     C                   Clear                   xxPOCLng         40
     C*
     C                   Eval      i = 1
     C     sst(d)        Lookup    pocSt(i)                               60
     c                   If        *in60 = *on
     C*
      /free
       Setgt ('N':'C':SHFnd:sst(d):strPdt) ppp00;
       Readpe(n) ('N':'C':SHFnd:sst(d)) ppp00;
       If not %eof;
          If PPPolDocC <> ' ';
             xxPOCDoc = PPPolDocC;
             xxPOCPth = PPPolPthC;
             xxPOCLng = PPLangC;
          Else;
             xxPOCDoc = PPPolDoc;
             xxPOCPth = PPPolPth;
             xxPOCLng = PPLangD;
          Endif;
       Else;
          Setgt ('N':'C':000:sst(d):strPdt) ppp00;
          Readpe(n) ('N':'C':000:sst(d)) ppp00;
          If not %eof;
             If PPPolDocC <> ' ';
                xxPOCDoc = PPPolDocC;
                xxPOCPth = PPPolPthC;
                xxPOCLng = PPLangC;
             Else;
                xxPOCDoc = PPPolDoc;
                xxPOCPth = PPPolPth;
                xxPOCLng = PPLangD;
             Endif;
          Endif;
       Endif;

       //* A form has been set up for the state, write record, or update if
       //* it has not been submitted yet.
       If xxPOCDoc <> ' ';

          Chain(n) (SHCo#:SHFnd:SHEmp#:SHDiv:SHFyr:sst(d)) ppo00;

          If %found;
             If POSbdt <> 0;
                Leavesr;
             Endif;
             Chain (SHCo#:SHFnd:SHEmp#:SHDiv:SHFyr:sst(d)) ppo00;
          Else;
             Clear ppo00;
             POCo# = SHCo#;
             POFnd = SHFnd;
             POEmp# = SHEmp#;
             PODiv = SHDiv;
             POFyr = SHFyr;
             POState = sst(d);
          Endif;

          POSbdt = 0;
          POUnid = SHUnid;
          POTrdt = sysDt7;
          PODoc  = xxPOCDoc;
          POPath = xxPOCPth;
          POLang = xxPOCLng;
          POPgm  = Q1PGM;
          POUser = Q1USER;
          POTime = Timeto6(SystemTime());
          PODt   = Dateto7(SystemDate());

          If not %found;
             Write ppo00;
          Else;
             Update ppo00;
          Endif;

       Endif;

      /end-free
     C*
     C                   Endif
     C*
     C                   Endsr                                                  POCNotice subr
    C*====================================================================
    C* SRDeduct - Populate WXPEP record for generic deductible endorsements
    C*====================================================================
      /free
       Begsr SrDeduct;

       // Write WXPEP for base LD forms or for custom LD forms that
       //  print with SRLRGDED or SRTEXT
        Select;
        When intBdx <> 0;
        When intSdx <> 0 And (ENpgm2 = 'SRLRGDED' Or ENpgm2 = 'SRTEXT');
        Other;
           Write ppe01;
           LeaveSr;
        EndSl;

       // Check if states are set up in Excluded States file
        flgApprOrExcl = *Blank;
        Chain (MUco#:MUform) pes00;
        If %Found;
           flgApprOrExcl = ESapex;
        EndIf;

        Clear aryLdSt;
       // Loop through policy and write WXPEP for each state
       //  that endorsement applies to
        Setll Elky2 pel02;
        Dou %EOF(Wdell1);
           Reade(n) Elky2 pel02;
           If %Eof;
              Leave;
           Endif;
           Exsr GetCxdt;
           xadldt = yycxdt;
        //* Determine if division has already reported as cancelled and if so skip.
           Exsr CheckCXStatus;

           If processMe;

          // Report state one time per policy
           Chain (Elco#:ELrtcd) prs01;
           intIdx = %LookUp(RSjrst:aryLdSt);
           If intIdx <> 0;
              Iter;
           Else;
              intIdx = %LookUp(*Blanks:aryLdSt);
              aryLdSt(intIdx) = RSjrst;
           EndIf;

          // Populate NCCI state number to record
           xxKey = RSjrst;
           Chain stky pst01;
           If %Found;
              PEst = %Int(STnst);
           EndIf;

          // Validate state against group setup
           Select;
           When ENst <> *Blanks And RSjrst <> ENst;
              Iter;
           When ENst = *Blanks And flgApprOrExcl <> *Blank;
              Chain (MUco#:MUform:RSjrst) pes00;
              If ESexdt = 0;
                 ESexdt = *hival;
              Endif;
              Select;
              When %Found And flgApprOrExcl = 'A' and ESADte <= ELPfdt and
               ELPfdt <= ESExdt;
              When Not(%Found) And flgApprOrExcl = 'E' and ESADte <= ELPfdt and
               ELPfdt <= ESExdt;
              Other;
                 Iter;
              EndSl;
           EndSl;

          // Validate large deductible is set up for state
           xxPlan = RtvDeductible(ELco#:ELfnd:ELemp#:ELdiv:ELfyr:xxPremPct:
            xxDedAmt:xxDedAgg:xxLossSub:xxBasisDed:xxDedNet:xxDedVerb:
            xxDedClas:xxDedPct);
           Select;
           When xxPlan = *Blank;
              Iter;
           //*** Beg Chg ***  07/23/24  *****************************************
           //*** When MUform = 'WC290604'
           //***  or MUform = 'WC290605';
           When MUform = 'WC290605';
           //*** End Chg ***  07/23/24  *****************************************
              Clear E29601ds;
              xxbia = xxDedAmt;
              xxbid = xxDedAmt;
              xxbiap = xxDedAmt;
              xxbidp = xxDedAmt;
              xxabi = xxDedAgg;
              xxagpp = xxDedAgg;
              PEData = E29601ds;
           Other;
              Clear E00403;
              xxdac = xxDedAmt;
              xxprp = xxPremPct;
              xxlsd = xxLossSub;
              xxbdc = xxBasisDed;
              xxdpc = xxDedPct;
              xxdag = xxDedAgg;
              PEData = E00403;
           EndSl;

           Write ppe01;
           Endif;
        Enddo;

       // Reset file cursor
        Chain(n) elky pel01;
        Chain (Elco#:ELrtcd) prs01;

       Endsr;
      /Free
       //==================================================
       Begsr AmWinsInstSchd;
       //==================================================
       isPrtInstSched = *Off;
       If cltId <> '148';
          LeaveSr;
       Endif;
       //*** Beg Chg ***  06/04/24  *****************************************
       //*** If Not(isUseXML);
       If Not(isUseXML) and xxsix = *off;
       //*** End Chg ***  06/04/24  *****************************************
          LeaveSr;
       Endif;
       // Look for template set up.  LeaveSr if not found.
       xxKey = %EditC(ELbscd:'X');
       Chain tbkey pbs01;
       If Not(%Found);
          LeaveSr;
       EndIf;
       Select;
       When BSpayr = 'Y';
          sType = '3';
          idxStart = 1;
       When BSsefl = 'E';
          sType = '1';
          idxStart = 2;
       When BSsefl = 'S';
          sType = '2';
          idxStart = 1;
       EndSl;
       Exsr SchedTemplate;
       If %Eof;
          LeaveSr;
       Else;
          savXtDCid = XTDcid;
          savXTPath = XTPath;
          savXTLang = XTLang;
       EndIf;
       isPrtInstSched = *On;
       //*** Beg Add ***  06/04/24  *****************************************
       If xxsix = *on;
          LeaveSR;
       Endif;
       //*** End Add ***  06/04/24  *****************************************
       If Not %Open(WXP7P);
          Open WXP7P;
       Endif;
       If Not %Open(WXP7P1);
          Open WXP7P1;
       Endif;
       message = %trim(xxProcessType);
       templateFile = outputFile;
       StLetter('TEMPLRQST':templateFile:message:'E':%editc(x@RRN:'X'):
        xxPre:string:%editc(SHCo#:'X'):%editc(SHFnd:'X'));
       Chain (templateFile) xt100;
       XTType = 'Schedule of Installments';
       XTDcid = savXtDCid;
       XTPath = savXTPath;
       XTLang = savXTLang;
       Update xt100;
       instSchdFile = templateFile;
       GetInvoiceDates();
       P7xml = templateFile;
       // The first installment is the down payment
       P7#ofInst = insCount - 1;
       // Self reporting schedules don't require annual premium
       P7TtAnnPrm = %Xfoot(insAmount);
       P7DownPay = insAmount(1);
       Select;
       When BSfreq = 'W';
          P7PyrlFreq = 'weekly';
          Eval(h) P7DownPct = 1/insCount * 100;
       Other;
          P7PyrlFreq = 'monthly';
          P7DownPct = insPct(1);
       EndSl;
       P7User = Q1user;
       P7Pgm  = Q1pgm;
       P7Dt   = %Dec(%Date():*Cymd);
       P7Time = %Dec(%Time():*Hms);
       Write pp70p;
       For index = idxStart by 1 to 55;
          If insToDt(index) = 0;
             Leave;
          Endif;
          P7xml = templateFile;
          P7DueDate = insDueDt(index);
          P7InstAmt = insAmount(index);
          P7RptFrDt = insFrDt(index);
          P7RptToDt = insToDt(index);
          P7User = Q1user;
          P7Pgm  = Q1pgm;
          P7Dt   = %Dec(%Date():*Cymd);
          P7Time = %Dec(%Time():*Hms);
          Write pp701;
       EndFor;

       If %Open(WXP7P);
          Close WXP7P;
       Endif;
       If %Open(WXP7P1);
          Close WXP7P1;
       Endif;

       Endsr;

       //==================================================
       //
       //==================================================
       Begsr NoOfOccur;
        Open WXP4L;
        Setll strSvP4XML pp400;
        Reade strSvP4XML pp400;
        Dow Not %Eof(WXP4L);
           Clear intCount;
           intLength = %Scan('(':P4Form) - 1;
           If intLength > 0;
              strForm = %Subst(P4Form:1:intLength);
              Setll outputFile xi100;
              Reade outputFile xi100;
              Dow not %eof(XMLTEML);
                 intLength = %scan('.':XTdcid) - 1;
                 If intLength > 0;
                    If %Subst(XTdcid:1:intLength) = strForm;
                       intCount += 1;
                    Endif;
                 Endif;
                 Reade outputFile xi100;
              Enddo;
              If intCount <> 0;
                 P4Occur = intCount;
                 Update pp400;
              Endif;
           Endif;
           Reade strSvP4XML pp400;
        Enddo;
        Close WXP4L;
       Endsr;

      /End-Free

     O/COPY W7413OSPEC

     OPNA01     E            PNA01E

     P*====================================================================
     P* Put together City, St  Zip
     P*====================================================================
     PGetCityStZip     b
     DGetCityStZip     pi           100
     D inCity                              like(FNPCTY)
     D inSt                                like(FNPST)
     D inZipCode                           like(FNPZIP)

     C                   return    %trim(inCity) + ', ' +
     C                             %trim(inSt)  + '  ' +
     C                             GetZipCode(inZipCode)

     PGetCityStZip     e





     P*====================================================================
     P* Put together phone #
     P*====================================================================
     PGetPhone#        b
     DGetPhone#        pi            13
     D inArea                         3  0
     D inPhone#                       7  0
     D inType                         1    options(*nopass)

     D area            s              3
     D phone#          s              7
     D type            s              1    inz('1')

     C                   eval      area   = %editc(inArea:'Z')
     C                   eval      phone# = %editc(inPhone#:'Z')

     C                   if        %parms >= 3
     C                   eval      type = inType
     C                   endif

     C                   select
     C                   when      type = '1'
     C* xxx-xxx-xxxx
     C                   return    area + '-' +
     C                             %subst(phone#:1:3) +
     C                             '-' +
     C                             %subst(phone#:4:4)
     C                   when      type = '2'
     C* (xxx)xxx-xxxx
     C                   return    '(' + area + ')' +
     C                             %subst(phone#:1:3) +
     C                             '-' +
     C                             %subst(phone#:4:4)
     C                   when      type = '3'
     C* xxx-xxxx
     C                   return    %subst(phone#:1:3) +
     C                             '-' +
     C                             %subst(phone#:4:4)
     C                   endsl

     PGetPhone#        e





     P*====================================================================
     P* Split the zip code if needed
     P*====================================================================
     PGetZipCode       b
     DGetZipCode       pi            10
     D inZipCode                      9  0

     D zipCode         s              9

     C                   eval      zipCode = %editc(inZipCode:'Z')

     C                   if        %subst(zipCode:6:4) = '0000'
     C                   return    %subst(zipCode:1:5)
     C                   else
     C                   return    %subst(zipCode:1:5) + '-' +
     C                             %subst(zipCode:6:4)
     C                   endif
     C*
     C                   return    *blanks

     PGetZipCode       e
     P*====================================================================
     P* Get the PEO's FEIN
     P*====================================================================
     PGetPEOFein       b
     DGetPEOFein       pi             9  0
     D  employer#      s              9  0
     D  division       s              5  0

     D  fein           s              9  0

     C                   eval      employer# = xxemp#
     C                   eval      division = xxdiv

     C* Let's get the PEO's FEIN

     C                   eval      xxemp# = 1
     C                   eval      xxdiv  = 0

     C     emky1         chain     pem01
     C                   if        %found
     C                   eval      fein = emfein
     C                   else
     c                   eval      fein = 0
     c                   endif
     C                   If        addNameFein <> 0
     c                   Eval      fein = addNameFein
     C                   Endif

     c* Now let's retrieve the original employers info

     C                   eval      xxemp# = employer#
     C                   eval      xxdiv  = division

     C     emky1         chain     pem01

     C* Now return the value

     C                   return    fein

     PGetPEOFein       e





     P*====================================================================
     P* Determine if the object exists
     P*====================================================================
     PObjExists        b
     DObjExists        pi             1n
     D object                        10    const
     D objType                        7    const

     D obj             s             10
     D type            s              7
     D error           s              1n

     C                   call      'SRCHKOBJ'
     C                   parm      object        obj
     C                   parm      objType       type
     C                   parm                    error

     C                   return    not error

     PObjExists        e

     *=============================================================================================
      * Gets loss cost multiplier for payroll class being reported  (returns 1 if no LCM)
     *=============================================================================================
     p getLossCost     b
     d getLossCost     pi             5  4
     d  class                               like(EPCLAS)
     d  effDt                               like(EPEFDT) const

     d qqco#           s              3
     d qqfnd           s              3
     d qqrtcd          s              3
     d qqclas          s              5
     d qqefdt          s              7
     d qqlcm           s              5
     d lossCostMult    s              5  4       inz(1)

     c                   move(p)   ELCO#         qqco#
     c                   move(p)   ELFND         qqfnd
     c                   move(p)   ELRTCD        qqrtcd
     c                   move(p)   class         qqclas
     c                   move(p)   effDt         qqefdt

     c                   call      'SRLCM'
     c                   parm                    qqco#
     c                   parm                    qqfnd
     c                   parm                    qqrtcd
     c                   parm                    qqclas
     c                   parm                    qqefdt
     c                   parm      *blanks       qqlcm

     c                   if        (qqlcm <> *blanks)
     c                   move      qqlcm         lossCostMult
     c                   endif

     c                   return    lossCostMult

     p getLossCost     e

     *=============================================================================================
      * Gets rating date for discount/factor/charge.
     *=============================================================================================
     p getRateDate     b
     d getRateDate     pi             7  0
     d  effDt                               like(EPEFDT)

     d qqco#           s              3
     d qqfnd           s              3
     d qqrtcd          s              3
     d qqefdt          s              7
     d qqlcm           s              5
     d RateDate        s              7  0       inz(1)

     c                   move(p)   ELCO#         qqco#
     c                   move(p)   ELFND         qqfnd
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C                   MOVE      effDt         Q@DATE
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q@DATE            7
     C                   MOVE      Q@DATE        RateDate

     c                   return    RateDate

     p getRateDate     e
     *=============================================================================================
      * GetStateName - returns name of state
     *=============================================================================================
     p getStateName    b
     d getStateName    pi            40
     d  state                               like(xxst)
     d  kkst           s             10
     c     stkey         klist
