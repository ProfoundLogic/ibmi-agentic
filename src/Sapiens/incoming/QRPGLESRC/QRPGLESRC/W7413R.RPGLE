     c* Moved to later part so that it is called only once
     C*
     C* Calculate/accumulate terrorism charge breakdown amounts.
     C*
      /free

          Select;
          When xxTerPay2 <> 0;
             xxTerPay = %dech((xxTerPay / 100) * RRTerr : 11 : 0);
             tasTerPrm  = tasTerPrm + xxTerPay;
             tasTerPrm2 = tasTerPrm2 + (ELETer - xxTerPay);
          Other;
             tasTerPrm = tasTerPrm + ELETer;
          Endsl;

      /end-free
     C                   Z-add     ELTerr        tasTerRate
     C                   Z-add     ELDtrr        tasDomRate
     *
     *  GET MINIMUM PREMIUM FOR INCREASED LIMIT.  PRORATE IF
     *  LIMIT IS EFFECTIVE FOR ONLY PART OF THE POLICY PERIOD.
     *
     C                   If        xxminf = 'Y' and emstrp <> 'Y'
     C                   If        elein1 <> 0
     C                   Z-add     elein1        xomin1
     C                   Endif
     C                   If        elein2 <> 0
     C                   Z-add     elein2        xomin2
     C                   Endif
     C                   Endif
     C                   if        elemnp = 'Y'
     C                             and not (cltid = '114' and FNGrpAsc = 'AFN')
     C                             and not UnitedWis
     *
     C                   select
     C                   when      cltid = '102'
     C                   z-add     elenmp        xxmnpr

     C                   other
     C                   if        xxst <> 'NJ'
     C                   eval      xxmnpr = elanpr
     C                   endif
     *
     C                   endsl
     *
     C                   else
     *
     C                   eval      xxmin1 = *zero
     *
     C                   if        elilcd <> *blank
     *
     C                   if        elilef = *zero
     C                   eval      xxlmef = elpfdt
     C                   else
     C                   eval      xxlmef = elilef
     C                   endif
     *
     C                   if        elilex <> *zero
     C                   eval      xxlmex = elilex
     C                   else
     C                   eval      xxlmex = elptdt
     C                   endif
     *
     *   GET LIMIT MINIMUM
     *
     C                   clear                   xxilcd
     C                   movel     elilcd        xxilcd
     C                   eval      xxilef = elpfdt
     *
     C     lmky          setgt     plm01
     C     lmky1         readpe    plm01                                  60
     C                   dow       *in60 = *off
     C                             and lmstat = 'I'
     C     lmky1         readpe    plm01                                  60
     C                   enddo
     *
     C                   if        *in60 = *on
     C                   eval      xxmin1 = *zero
     C                   else
     c                   if        xxMinPrm = *off
     C                   eval      xxmin1 = lmmin
     c                   else
     C                   eval      xxmin1 = lmmine
     c                   endif
     C                   endif
     *
     C                   eval      xxpday = 0
     *
     * PRORATE MINIMUM FOR INCREASED LIMIT
     *
     C                   if        xxmin1 > 0
     C                             and elpfdt <> elptdt
     *
     C                   if        xxlmef > elpfdt
     C                             or xxlmex < elptdt
     *
     *  CALCULATE THE NUMBER OF DAYS IN THE POLICY
     *
     C                   eval      xqFrom = DtMDYY(ELPFDT)
     C                   eval      xqTo   = DtMDYY(ELPTDT)
    C*
     C                   move      xqfrom        qqfrom
     C                   move      xqto          qqto
     C                   eval      qqdays = *zero
     C                   clear                   qqerr
     C                   move      '1'           qqterm
     *
     C                   call      'SRDDIF8'
     C                   parm                    qqfrom
     C                   parm                    qqto
     C                   parm                    qqdays
     C                   parm                    qqerr
     C                   parm                    qqterm
     *
     C                   exsr      srleap
     *
     C                   eval      xxpday = qqdays
     *
     * CALCULATE NUMBER OF DAYS LIMIT IS IN EFFECT
     *
     C                   eval      xqFrom = DtMDYY(xxLmEf)
     C                   eval      xqTo   = DtMDYY(xxLmEx)
    C*
     C                   move      xqfrom        qqfrom
     C                   move      xqto          qqto
     C                   eval      qqdays = *zero
     C                   clear                   qqerr
     C                   move      '1'           qqterm
     *
     C                   call      'SRDDIF8'
     C                   parm                    qqfrom
     C                   parm                    qqto
     C                   parm                    qqdays
     C                   parm                    qqerr
     C                   parm                    qqterm
     *
     C                   exsr      srleap
     *
     C                   eval      xxlday = qqdays
     *
     * CALCULATE PRORATED MINIMUM FOR LIMIT
     *
     C                   eval(h)   xxfact = xxlday / xxpday
     C                   eval(h)   xxmin1 = xxmin1 * xxfact
     *
     C                   endif
     *
     C                   endif
     *
     C                   endif
     *
     * ADD INCREASED LIMITS MIN PREMIUM INTO MIN PREMIUM
     *
     C                   if        xxmin1 > xlmin1
     C                   eval      xlmin1 = xxmin1
     C                   endif
     *
     C                   eval      xxmin2 = *zero
     *
     C                   if        elinl2 <> *blank
     *
     C                   eval      xxlmef = eli2ef
     *
     C                   if        eli2ex <> *zero
     C                   eval      xxlmex = elilex
     C                   else
     C                   eval      xxlmex = elptdt
     C                   endif
     *
     *   GET LIMIT MINIMUM
     *
     C                   clear                   xxilcd
     C                   movel     elinl2        xxilcd
     C                   eval      xxilef = elpfdt
     *
     C     lmky          setgt     plm01
     C     lmky1         readpe    plm01                                  60
     C                   dow       *in60 = *off
     C                             and lmstat = 'I'
     C     lmky1         readpe    plm01                                  60
     C                   enddo
     *
     C                   if        *in60 = *on
     C                   eval      xxmin2 = *zero
     C                   else
     c                   if        xxMinPrm = *off
     C                   eval      xxmin2 = lmmin
     c                   else
     C                   eval      xxmin2 = lmmine
     c                   endif
     C                   endif
     *
     C                   eval      xxpday = 0
     *
     * PRORATE MINIMUM FOR INCREASED LIMIT
     *
     C                   if        xxmin2 > 0
     C                             and elpfdt <> elptdt
     *
     C                   if        xxlmef > elpfdt
     C                             or xxlmex < elptdt
     *
     *  CALCULATE THE NUMBER OF DAYS IN THE POLICY
     *
     C                   eval      xqFrom = DtMDYY(ELPFDT)
     C                   eval      xqTo   = DtMDYY(ELPTDT)
    C*
     C                   move      xqfrom        qqfrom
     C                   move      xqto          qqto
     C                   eval      qqdays = *zero
     C                   clear                   qqerr
     C                   move      '1'           qqterm
     *
     C                   call      'SRDDIF8'
     C                   parm                    qqfrom
     C                   parm                    qqto
     C                   parm                    qqdays
     C                   parm                    qqerr
     C                   parm                    qqterm
     *
     C                   exsr      srleap
     *
     C                   eval      xxpday = qqdays
     *
     * CALCULATE NUMBER OF DAYS LIMIT IS IN EFFECT
     *
     C                   eval      xqFrom = DtMDYY(xxLmEf)
     C                   eval      xqTo   = DtMDYY(xxLmEx)
    C*
     C                   move      xqfrom        qqfrom
     C                   move      xqto          qqto
     C                   eval      qqdays = *zero
     C                   clear                   qqerr
     C                   move      '1'           qqterm
     *
     C                   call      'SRDDIF8'
     C                   parm                    qqfrom
     C                   parm                    qqto
     C                   parm                    qqdays
     C                   parm                    qqerr
     C                   parm                    qqterm
     *
     C                   exsr      srleap
     *
     C                   eval      xxlday = qqdays
     *
     * CALCULATE PRORATED MINIMUM FOR LIMIT
     *
     C                   eval(h)   xxfact = xxlday / xxpday
     C                   eval(h)   xxmin2 = xxmin2 * xxfact
     *
     C                   endif
     *
     C                   endif
     *
     C                   endif
     *
     * ADD INCREASED LIMITS MIN PREMIUM INTO MIN PREMIUM
     *
     C                   if        xxmin2 > xlmin2
     C                   eval      xlmin2 = xxmin2
     C                   endif
     *
    C*
     C                   endif
    C*
     C                   endif
    C*
    C*  WRITE NAME AND ADDRESS TRANSACTION FOR ELECTRONIC REPORTING
    C*
     C                   if        wcfl03 = 'Y'
     C                             and xxdiv <> shdiv
     C                             and *in32 = *off
     C                             and cxStatus <> 'flatCx'
     C                             or wcfl03 = 'Y'
     C                             and xxdiv = shdiv
     C                             and *in32 = *off
     C                             and emmad1 <> *blanks
     C                             and empad1 <> *blanks
     C                             and cxStatus <> 'flatCx'
     C                             or (cltid = '148' and F2Car# = 38073
     C                             and xxdiv <> shdiv
     C                             and cxStatus <> 'flatCx')
     C                             or (cltid = '148' and F2Car# = 38073
     C                             and xxdiv = shdiv
     C                             and emmad1 <> *blanks
     C                             and empad1 <> *blanks
     C                             and cxStatus <> 'flatCx')
     C                   eval      svencd = naencd
     C                   eval      svnlkc = nanlkc
    C* Create long (100) names from 2 fields
     C                   exsr      crtlem
     C                   If        clientLCF = 'Y'
     C                   Eval      xxf100 = %trim(QQPEOExt) + ' ' +
     C                             %trim(xxf100)
     C                   Endif
     C*
     C                   If        clientLCF = 'Y'
     C                   Eval      xxn100 = %trim(QQPEOExt) + ' ' +
     C                             %trim(xxn100)
     C                   Endif
    C*
    C* Concatinate Federal and DBA names for NJ policies
     C                   if        xxpeon = 'Y'
     C                   if        EMFDNM <> *BLANKS
     C                   exsr      dba
     C                   movel(p)  xxf100        xxn100
     C                   ELSE
