      //*** begin chg ***  10/11/24  ***************************************
      //*****  If xxminf = 'Y';
     C     elky          chain     pel01                              60
      //* Do not back into annualized balance to minimum for NJ.
        If xxminf = 'Y' and xxmpst = 29;
           Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pmp01;
           annMin = MPEBal;
           If ELPror <> 0 and ELPror <> 1;
              Eval(h) annMin = annMin / ELPror;
           Endif;
        Endif;
        If xxminf = 'Y' and xxmpst <> 29;
      //*** end chg *****  10/11/24  ***************************************
           Setll elky2 pel02;
           Reade elky2 pel02;
           annMin = ELEmna;
           Dow not %eof;
              Chain (xxCo#:xxFnd:xxFyr:xxEmp#:ELDiv) pmp01;
              Eval annMin = annMin - ELPRTF - MPEnmp + ELEin1 + ELEin2 + MPEwav;
              Reade elky2 pel02;
           Enddo;
