     C                   eval      nxempr = nxempr * -1
     C                   endif
     C*** end chg *****  06/20/24  ******************************************
     C                   write     pnx01
    C*
     C* Following code is moved to srCommon
    C*
     C                   else
     C* Report separate records for domesctic if rate changes between periods
     C                   if        tcdtr1 <> 0
     C                   eval      nxefdt = tcef1
     C                   eval      nxrt = tcdtr1 * 100
     C                   eval      nxempr = tcdta1
     C                   eval      nxclas = tca1d1
     C                   write     pnx01
     C                   endif
     C                   if        tcdtr2 <> 0
     C                   eval      nxefdt = tcef2
     C                   eval      nxrt = tcdtr2  * 100
     C                   eval      nxempr = tcdta2
     C                   eval      nxclas = tca1d2
     C                   write     pnx01
     C                   endif
