     C                   eval      nxrt = tcdtr3  * 100
     C                   eval      nxempr = tcdta3
     C                   eval      nxclas = tca1d3
     C                   write     pnx01
     C                   endif
     C*
     C                   endif                                                  tcdtr2=0=tcdtr3
     C                   endif
