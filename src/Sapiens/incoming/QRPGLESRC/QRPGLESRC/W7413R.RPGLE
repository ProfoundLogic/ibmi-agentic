     C                   parm                    qqhold
     C                   Endif
    C*
    C*  CLEAR OUT STATE TOTS STORED IN MULTI-OCCURENCE DATA STRUCTURE
    C*
     C                   clear                   arrst
     C                   z-add     *zeros        N1LINK
     C                   z-add     *zeros        N1LNKC
     C                   Z-add     0             xxN1Link          3 0
     C                   Z-add     0             xxN1Lnkc          2 0
     C                   Z-add     0             xxN1Co#           3 0
     C                   Z-add     0             xxN1Fnd           3 0
     C                   Z-add     0             xxN1Emp#          9 0
     C                   Z-add     0             xxN1Fyr           3 0
     C                   Move      *blanks       xn1elid          10
     C                   Z-add     0             xn1div            4 0
     C     1             do        52            w
     C     w             occur     sttots
     C                   clear                   sttots
       // Remove all records from WMMUP2 for this Employer
       Setll (SHco#:SHfnd:SHfyr:SHemp#) pmup2;
       Reade (SHco#:SHfnd:SHfyr:SHemp#) pmup2;
       Dow Not %Eof(WMMUP2L1);
          Delete pmup2;
          Reade (SHco#:SHfnd:SHfyr:SHemp#) pmup2;
       Enddo;
       intSeq# = 0;
     C                   eval      arrst(w) = '99'
     C                   enddo
    C*
