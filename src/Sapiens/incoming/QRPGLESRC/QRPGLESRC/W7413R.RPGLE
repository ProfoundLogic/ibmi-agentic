    C*
     C                   movel     muform        svform
     C     muky          reade(n)  pmu07                                  60
     C                   enddo
      *
      *   Call W7413C2 to update endorsement file WXPEP so that WCPOLS will
      *   populate properly for the endorsement records
      *
     c                   if        xxsix = *on
     C                   Eval      @@rtcd = ' '
     C                   If        not isuseSpoolOut
     C                   Eval      @@rtcd = 'N'
     C                   Endif
     C                   Eval      @@spool = 'Y'
     C                   If        not isuseSpoolOut
     C                   Eval      @@spool = 'N'
     C                   Endif
     c                   call      'W7413C2'
     c                   parm                    qqco#
     c                   parm                    qqfnd
     c                   parm                    ##emp#
     c                   parm                    ##div
     c                   parm                    ##fyr
     c                   parm                    cmdcid
     c                   parm                    cmfold
     c                   parm                    af
     c                   parm                    syofif
     c                   parm                    qqpol#
     c                   parm                    @@rtcd
     c                   parm                    qqsdoc
