     C                   if        *in50 = *on
     C                   clear                   psh01
     C                   move      xxco#         shco#
     C                   move      xxfnd         shfnd
     C                   move      xxemp#        shemp#
     C                   move      xxdiv         shdiv
     C                   move      xxfyr         shfyr
     C                   move      'P'           shtype
     C                   move      '2'           shstat
     C                   movel     q1user        shuser
     C                   movel     q1pgm         shpgm
    C*
     C                   eval      SHDT = sysDt7
    C*
     C                   eval      shagt# = *zero
     C     ahky          setgt     pah01
     C                   readp     pah01                                  60
     C                   dow       *in60 = *off
     C                             and ahstat = 'I'
     C                   readp     pah01                                  60
     C                   enddo
    C*
     C                   if        *in60 = *off
     C                             and xxco# = ahco#
     C                             and xxfnd = ahfnd
     C                             and xxemp# = ahemp#
     C                             and xxdiv = ahdiv
     C                             and xxfyr = ahfyr
     C                   movel     ahagt#        shagt#
