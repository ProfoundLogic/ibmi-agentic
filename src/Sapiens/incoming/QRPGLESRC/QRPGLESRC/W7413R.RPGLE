    C*====================================================================
    C* LoadExt - Load common data for extension pages
    C*====================================================================
     C     LoadExt       begsr
     C*
     C                   eval      footA = 'Insured:'
     C                   eval      footB = 'Policy Number:'
     C                   eval      footC = 'Effective Date:'
     C                   eval      footD = 'WC 99 06 56'
     C                   eval      footuf = 'WC 00 00 01 A'
     c                   move      *blanks       xxuehd
     c                   if        n1sue1 <> *blanks
     c                   eval      xxuehd = uehd
     c                   endif
     C                   select
     C                   when      xxpa2 = 'Y'
     C                   eval      footE = 'GL-HL-1'
     C                   when      prtFL
     C                   eval      footE = 'WC 99 06 55'
     C                   when      prtNJ

      /free
       footE = 'WC 00 00 01 B';
       If strPDt >= 1150101;
          footE = 'WC 00 00 01 A';
       Endif;
      /end-free
     C                   when      cltID = '139'
     C                   eval      footE = 'WC 00 00 01 A'
     C                   other
     C                   eval      footE = *blanks
     C                   endsl
     c                   if        addnameins
     c                   eval      footF = 'WC 99 06 58'
     c                   else
     C                   eval      footF = 'WC 99 06 57'
     c                   endif
     C*
     c                   if        ##naml = 1
     C                   eval      empName = x1name
     c                   else
     c     x1name        cat(p)    x2name:0      empname
     c                   endif
     C                   eval      currPol# = xPol
    C*
     C                   eval      effDate = AlphaUSA(CvtToDate(xxPfDt))
     c                   if        ullico = 'Y'
     c*
     c                   if        ##naml = 1
     c                   else
     c     x1name        cat(p)    x2name:0      empname
     c                   endif

     c                   callp     GetAddress
     C                   eval      prtDate = AlphaUSA(CvtToDate(xxdate))
     c*
     c                   endif                                                  ullico = 'Y'
     c                   if        bancInsure
     c                   eval      bieadr1 = xxenm3
     c                   eval      bieadr2 = xxenm2
     c                   eval      bieadr3 = xxead1
     c                   eval      bieadr4 = xxead2
     c                   eval      bieadr5 = xxecsz
     c                   eval      bicpol# = xPol
     C                   eval      bipfrdt = AlphaUSA(CvtToDate(xxPfDt))
     C                   eval      biptodt = AlphaUSA(CvtToDate(xxPtDt))
     c                   endif                                                  bancInsure
     c                   if        prt132
     c*
     c                   exsr      LoadFormData
     c*
     C                   eval      poltime = '12:01 A.M. Standard Time at ' +
     c                                       'the described location'
     C                   eval      footIC = 'INSURED COPY'
     C                   If        cltid = '114' and FNGrpAsc = 'AFN'
     C                   Clear                   footIC
     C                   Endif
     C                   eval      footF# = 'WC000001A'
     C                   eval      footE# = 'Ed 0588'
     C                   If        cltid = '114' and FNGrpAsc = 'AFN' and
     c                             ((strPDt < 1150101 and xxPolst = 'NJ') or
     c                             (strPDt >= 1150101 and xxPolst <> 'NJ'))
     C                   eval      footF# = 'WC000001B'
     C                   eval      footE# = 'Ed 0199'
     C                   Endif
     C                   eval      footPO = 'Printed on'
     C                   eval      footP  = 'Page'
     c*
     c*
     c                   endif                                                  if prt132
      /free
       If isOptaComp;
          footOC = 'This endorsement changes the policy to which it is attache+
           d and is effective on the date issued unless otherwise stated.';
          footOC1= '(The information below is required only when this endorsem+
           ent is issued subsequent to preparation of the policy.)';
          footF# = 'WC 99 06 02';
          footE# = 'Ed 02-11';
          footPO = 'Printed on';
          footEfDtD = 'Endorsement Effective Date:';
          footPolNo = 'Policy No.:';
          footEndNo = 'Endorsement No.:';
          footInName= 'Insured Name:';
          //  DBA Name
          footDBANM = GetEmpFullName(xxEMP#:xxDIV:x#RRN:xxFND:xxCO#:'DBA');
          //  FED Name
          footFEDNM = GetEmpFullName(xxEMP#:xxDIV:x#RRN:xxFND:xxCO#:'FED');
          footInComp= 'Insured Company:';
          If isContri = '1';
             footPremD = 'Contribution';
          Else;
          footPremD = 'Premium:';
          Endif;
          footPrem = xxprm;
          footIsDt  = 'Issue Date:';
          prtDate = AlphaUSA(CvtToDate(xxdate));
          If ObjExists('SGNJOE':'*PAGSEG') and F2spsg <> ' ';
            LOGHRZ =  1.1;
            LOGVRT = 0.2;
          Endif;
       Endif;

       If unitedWis;
          footUW1 = 'This endorsement changes the policy to which it is attac'+
           'hed and is effective on the date issued unless otherwise stated.';
          footUW2 = 'The information below is required only when this end'+
           'orsement is issued subsequent to the preparation of the policy.';
          footUW3 = 'Endorsement Effective';
          footUW4 = 'Policy No.';
          footUW5 = 'Endorsement No.';
          footUW6 = 'Insured';
          footUW7 = 'Insurance Company';
          footUW8 = 'Countersigned by  _______________________________________';
          If addNameIns;
             footUW9 = 'WC 99 06 04';
          Else;
             footUW9 = 'WC 99 06 05';
          Endif;
          footUW10 = '(Ed. 3-08)';

          foot4U1  = 'WC 99 06 01';
          foot4U2  = '(Ed. 3-08)';

          Clear footUWD3;
          Clear footUWD4;
          Clear footUWD5;
          Clear footUWD6;
          Clear footUWD7;

          //* Populate footer info if mid-term endorsement.
          If *in32 = *on;
             footUWD3 = ldeedt;
             footUWD4 = xPol;
             footUWD5 = ldend#;
             footUWD6 = GetEmpFullName(xxEMP#:xxDIV:x#RRN:xxFND:xxCO#:'FED');
             If footUWD6 = *blanks;
                footUWD6 = GetEmpFullName(xxEMP#:xxDIV:x#RRN:xxFND:xxCO#:'DBA');
             Endif;
             footUWD7 = FNName;
          Else;
             Clear footUW1;
             Clear footUW2;
             Clear footUW3;
             Clear footUW4;
             Clear footUW5;
             Clear footUW6;
             Clear footUW7;
             Clear footUW8;
          Endif;

       Endif;
       If amTrust;
          grpName = FNName;
          prtDate = AlphaUSA(CvtToDate(xxdate));
          polNam1 = xxamn1;
          Clear polNam2;
          If EMFDN2 <> ' ' or EMFDNM = ' ' and EMNAM2 <> ' ';
             polNam2 = xxAMN2;
          Endif;

          Select;
          When xxPolSt = 'NJ';
             form#AM2 = 'WC 00 00 01 B';
          When xxPolSt = 'FL';
             form#AM2 = 'WC 00 00 01 A';
          Other;
             form#AM2 = 'WC 99 00 01 B';
          Endsl;

       Endif;
      /end-free
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LoadExtItem1 - Load common data for extension page Item 1
    C*====================================================================
     C     LoadExtItem1  begsr
     C*
     C                   exsr      LoadExt
     C*
     c                   if        addnameins
     c                   eval      item1Nprtd = *on
     c                   else
     C                   eval      item1Prtd = *on
     c                   endif
     C*
     C                   clear                   addName
     C                   clear                   addFEIN
     C                   clear                   addAdr1
     C                   clear                   addAdr2
     C                   clear                   addAdr3
     C                   Clear                   xhefdt2
     C                   Clear                   xoefdt2
     C                   Clear                   xhdldt2
     C                   Clear                   xodldt2
     C*
     C                   Eval      xhefdt2 = 'Eff Date:'
     C                   Eval      xoefdt2 = xoefdt
     C                   Eval      xhdldt2 = 'Exp Date:'
     C                   Eval      xodldt2 = xodldt
    C*
     C                   select
     C                   when      addNameIns
     C                   movel     anname        addname
     c                   cat       annam2:0      addname
     C                   when      otherLoc = 1
     C                   movel     xxonam        addname
     c                   cat       xxonm2:1      addname
     C                   eval      addAdr1 = xxOAd1
     C                   eval      addAdr2 = xxOAd2
     C                   eval      addAdr3 = xxOCSZ
     C                   when      otherLoc = 2
     C                   movel     x2onam        addname
     c                   cat       x2onm2:1      addname
     C                   eval      addAdr1 = x2OAd1
     C                   eval      addAdr2 = x2OAd2
     C                   eval      addAdr3 = x2OCSZ
     C                   eval      addsic   = A5SIC
     C                   endsl
     C*
     C                   select
     C                   when      numFEIN <> *zero
     C                   eval      addFEIN = %editc(numFEIN:'X')
     C                   other
     C                   eval      addFEIN = *blanks
     C                   endsl
     C*
     C                   if        addAdr1 = *blanks
     C                   eval      addAdr1 = addAdr2
     C                   eval      addAdr2 = addAdr3
     C                   eval      addAdr3 = *blanks
     C                   endif
     C                   if        addAdr2 = *blanks
     C                   eval      addAdr2 = addAdr3
     C                   eval      addAdr3 = *blanks
     C                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LoadExtItem3D - Load common data for extension page Item 3D
    C*====================================================================
     C     LoadExtItem3D begsr
     C*
     C                   exsr      LoadExt
     C*
     C                   eval      item3DPrtd = *on
     C*
     C                   if        prtNJ
     C                   eval      formName3D = 'WC 00 00 01 B'
     c                   If        strPDt >= 1150101
     C                   eval      formName3D = 'WC 00 00 01 A'
     c                   Endif
     C                   endif
     C*
     C                   eval      endST = '  '
     C                   if        endEdition = *blanks
     C                   select
     C                   when      MUFORM = 'WC000001A'
     C                   eval      endEdition = '(01/90)'
     C                   when      MUFORM = 'WC990655'
     C                   eval      endEdition = '(08/04)'
     C                   when      MUFORM = 'WC990656'
     C                   eval      endEdition = '(08/04)'
     C                   when      MUFORM = 'WC990657'
     C                   eval      endEdition = '(08/04)'
     C                   other
     C                   eval      endEdition = *blanks
     C                   endsl
     C                   endif
    C*
     C                   eval      endst   = MUENST
     C                   eval      endForm = MUFORM
     C                   eval      endEdt  = CenterFld(endEdition)
     C                   eval      endDesc = MUDESC
     C*
     C                   select
     C                   when      cltID = '139'
     C                   select
     C                   when      MUFORM = 'WC990655'
     C                   eval      endDesc = xxFD55
     C                   when      MUFORM = 'WC990656'
     C                   eval      endDesc = xxFD56
     C                   endsl
     C                   eval      endDesc = upper(endDesc)
     c                   when      bancInsure
     c                   eval      qqxf  = MUFORM
     c                   eval      qqxf1 = *blanks
     C                   callp     getAltEndNm (qqxf : qqxf1 )
     c                   eval      biEnForm = qqxf1
     c                   when      unitedWis
     c                   eval      foot3U1 = 'WC 99 06 09 A'
     c                   eval      foot3U2 = '(Ed. 11-08)'
      /free
                         Select;
                         When muform = 'WC990601';
                            endEdition = '(03/08)';
                         When muform = 'WC990604';
                            endEdition = '(03/08)';
                         When muform = 'WC990605';
                            endEdition = '(03/08)';
                         When muform = 'WC990609A';
                            endEdition = '(11/08)';
                         Endsl;
                         endEdt = centerFld(endEdition);
                         endEdition = *blanks;
      /end-free
     C                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LoadExtItem4 - Load common data for extension page Item 4
    C*====================================================================
     C     LoadExtItem4  begsr
     C*
     C                   exsr      LoadExt
     C*
     C                   eval      item4Prtd = *on
     C*
     C                   if        prtNJ
     C                   eval      formName3D = 'WC 00 00 01 B'
     c                   If        strPDt >= 1150101
     C                   eval      formName3D = 'WC 00 00 01 A'
     c                   Endif
     C                   endif
     C*
     C                   clear                   premForSt
     C                   clear                   classDesc
     C                   clear                   classCode
     C                   clear                   annRenum
     C                   clear                   ratePer100
     C                   clear                   subToMod
     C                   clear                   allOther
     C                   clear                   premDesc
     C                   clear                   premCode
     C                   clear                   premPer100
     C                   clear                   premium
     C                   clear                   expModDesc
     C                   clear                   expMod1
     C                   clear                   expMod2
     C                   clear                   expMod3
     c                   clear                   premiumu
     c                   clear                   schst
     c                   clear                   state
     c                   clear                   premState
     c                   clear                   premDescAm
     c                   clear                   prem#EmpAm
     c                   clear                   premCodeAm
     c                   clear                   premPayAm
     c                   clear                   premRateAm
     c                   clear                   premPremAm
     C*
     C                   select
     C                   when      *in94
      /Free
       If isContri = '1';
          premForSt = '*****  Cntrbtn Information-
           For ' + xxPSt + '  *****';
          scHst = xxPst + '  **';
          state = xxPst;
       Else;
          premForSt = '*****  Premium Information-
           For ' + xxPSt + '  *****';
          scHst = xxPst + '  **';
          state = xxPst;
       Endif;
          premState = getStateName(xxPst);
      /End-free
     c                   other
     c                   eval      schst = '  **'
     c                   eval      state = 'Summary'
     C                   eval      premState = 'Summary for All States'
     C                   endsl
     C*
     c                   if        bancInsure
     c                   eval      biItem4Vb = 'Item 4. - Information Page ' +
     c                                        biFormNm  +
     c                                       ' Continued:'
     c                   if        *in94
     c                   eval      biSt4Vb = 'Workers'' Compensation Schedule: '
     c                                        + getStateName(xxPst)
     c                   else
     c                   eval      biSt4Vb = *blanks
     c                   endif
     c                   endif
     C*
     C                   eval      premForSt = CenterFld(premForSt)
     C*
     C                   eval      empSIC   = 'SIC: '   + EMSIC
     C                   eval      empNAICS = 'NAICS: ' + EMNAIC
     C*
     C                   select
    C*
    C* Class codes
     C                   when      item4Type = 1
     C                   eval      classDesc = EPDESC
     C*
     C                   eval      classCode = %editc(EPCLAS:'Z')
     C                   eval      classCode = RightJstfy(classCode:5)
     C                   select
     C                   when      not *in75
     C                   eval      classCode = %trimr(classCode) + ' ' +
     C                                         EPSPEC
     C                   when      *in75 and *in78
     C                   eval      classCode = %trimr(classCode) + ' (' +
     C                                         xxExt + ')'
     C                   endsl
     C*
     C                   eval      annRenum  = %editc(x2EaPr:'2')
     C*
     C                   select
     C                   when      *in84
     C                   eval      ratePer100 = %editc(xnARat:'1')
     C                   eval      subToMod   = xnEmPr
     C                   eval      premiumu   = xnEmPr
     C                   when      not *in84
     C                   eval      ratePer100 = %editc(EPARAT:'1')
     C                   eval      subToMod   = EPEMPR
     C                   eval      premiumu   = epempr
     C                   endsl

     c                   if        bancInsure  and
     C                             item4Line# > maxClassBI
     C                   eval      item4Line# = 0
     C                   endif
     C                   If        amTrust
     C                   Eval      premDescAm =  EPDESC
     C                   Eval      prem#EmpAm = x2ecnt
     C                   Eval      premCodeAm = EPCLAS
     C                   Eval      premPayAm  = x2eapr
     C                   Eval      premRateAm = eparat
     C                   Eval      premPremAm = epempr
     C                   Endif
    C*
    C* Additional info
     C                   when      item4Type = 2
     C                   if        *in91
     C                   eval      classDesc = '  (' + %editc(xxFrAv:'Y') +
     C                                         ' - ' + %editc(xxToAv:'Y') +
     C                                         ')'
     C                   endif
     C                   if        *in92
     C                   eval      allOther  = EPADLD
     C                   eval      premiumu   = epadld
     C                   select
     C                   when      *in64
     C                   eval      %subst(classDesc:subst) = 'Territory Diff.'
     C                   when      *in35
     C                   eval      %subst(classDesc:subst) = 'Charge'
     C                   when      not *in64
     C                   eval      %subst(classDesc:subst) = 'Add''l Load'
     C                   endsl
     C                   endif
     C                   If        amTrust
     C                   Eval      premDescAm =  classDesc
     C                   Eval      premPremAm =  premiumu
     C                   Endif
    C*
    C* Premium info
     C                   when      item4Type = 3
     C*
     C                   eval      premDesc = xxHdg
     C                   eval      premCode = %subst(premCd:2:4)
     C                   eval      premCd = *blanks
      /Free
       If prt132 and (((xxHdg = con(53) or xxHdg = con(54)) and isContri <> '1')
           or ((xxHdg = con(70) or xxHdg = con(71)) and isContri = '1'));
      /End-free
     c                   select
     c                   when      xxhdg = con(53)
     c                   movel     con(53)       xxh22            22
     c                   move(p)   xxh22         premdesc
     c                   when      xxhdg = con(54)
     c                   movel     con(54)       xxh19            19
     c                   move(p)   xxh19         premdesc
      /Free
       When xxHdg = con(70);
            xxh22 = con(70);
            premdesc = xxh22;
       When xxHdg = con(71);
            xxh19 = con(71);
            premdesc = xxh19;
      /End-free
     c                   endsl
     c
     c                   endif
     C*
     C                   select
     C                   when      premRt55 <> *zero
     C                   eval      premPer100 = %editc(premRt55:'1')
     C                   when      premRt54 <> *zero
     C                   eval      premPer100 = %editc(premRt54:'1')
     C                   other
     C                   eval      premPer100 = *blanks
     C                   endsl
     C*
     C                   clear                   premRt54
     C                   clear                   premRt55
     C*
     C                   clear                   premium
     C                   clear                   premOther
     C*
     C                   select
     C                   when      xxNegF = *on
     C                   eval      premAmt = xxTAm * -1
     C                   other
     C                   eval      premAmt = xxTAm
     C                   endsl
     C                   eval      xxNegF = *off
     C*
     C                   select
     C* Expense Constant
     C                   when      printer1 <> 'W7413O1FL'
     C                              and premDesc = con(9)
     C                   eval      premOther = premAmt
     C* Terrorism Risk Act
     C                   when      printer1 <> 'W7413O1FL'
     C                              and premDesc = con(30)
     C                             or printer1 <> 'W7413O1FL'
     c                             and premDesc = rrterh
     C                   eval      premOther = premAmt
     C                   other
     C                   eval      premium  = premAmt
     C                   endsl
     C                   eval      premiumu   = premAmt
     C*
     c                   select
     c                   when      bancInsure
     C                   if        item4Line# > maxClassBI
     C                   eval      item4Line# = 0
     C                   endif
     c                   when      amTrust
     c                   other
     C                   if        item4Line# > maxClass
     C                   eval      item4Line# = 0
     C                   endif
     c                   endsl
     C                   If        amTrust
     C                   Eval      premDescAm =  premDesc
     C                   If        premCode <> ' '
     C                   Eval      premCodeAm =  %int(premCode)
     C                   Endif
     C                   Eval      premPremAm =  premiumu
     C                   Endif
    C*
    C* Experience Mod Info
     C                   when      item4Type = 4
     C*
     C                   select
     C                   when      *in96
     C                   eval      expModDesc = 'Merit Rating'
     C                   when      not *in96
     C                   eval      expModDesc = 'Experience Modifiers'
     C                   endsl
     C*
     C                   eval      expMod1 = '  ' + %editc(xxExM1:'2') +
     C                              ' ' + AlphaUSA(CvtToDate(xxEmD1))
     C                   eval      expMod2 = '  ' + %editc(xxExM2:'2') +
     C                              ' ' + AlphaUSA(CvtToDate(xxEmD2))
     C                   eval      expMod3 = '  ' + %editc(xxExM3:'2') +
     C                              ' ' + AlphaUSA(CvtToDate(xxEmD3))
     C*
     C                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LoadFormData - Load common data for form
    C*====================================================================
     C     LoadFormData  begsr
     C                   Clear                   mailHd1
     C                   Clear                   mailHd2
     C                   Clear                   mailHd3
     C                   Clear                   mailHd4
     C                   Clear                   decCopy
     C                   Clear                   polReis
     C                   Clear                   polRenw
     C                   Clear                   polPerd
     C                   Clear                   servOHd
     C                   Clear                   adjHead
     C                   Clear                   servOff
     C                   Clear                   prtDtHd
     C                   Clear                   prtDate
     C                   Clear                   cntSign
     C                   Clear                   decForm
     C                   Clear                   decEDt
     C                   Clear                   decFormT
     C                   Clear                   decEDtT
     C*
     C* Group Information
     C                   eval      NCCICoNo = F2CAR#
     C                   eval      grpName = FNNAME
     c                   clear                   grpadr
     C*
     C                   eval      adrLn = 0
     C                   if        cltID = '139'
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = 'A Stock Company'
     C                   select
     C                   when      FNPAD1 <> *blanks
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = %trim(FNPCTY) + ', ' +
     C                                             %trim(FNPST)
     C                   when      FNMAD1 <> *blanks
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = %trim(FNMCTY) + ', ' +
     C                                             %trim(FNMST)
     C                   endsl
     C                   endif
     C*
     C                   if        FNMAD1 <> *blanks
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = FNMAD1
     C                   if        FNMAD2 <> *blanks
     C                   select
     C                   when      cltID = '139'
     C                   eval      grpAdr(adrLn) = %trim(grpAdr(adrLn)) +
     C                               ', ' + FNMAD2
     C                   other
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = FNMAD2
     C                   endsl
     C                   endif
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = GetCityStZip(FNMCTY:
     C                                             FNMST:FNMZIP)
     C                   endif
     C*
     c                   if        not prt132
     C                   if        cltID <> '139' or adrLn < 3
     C                   if        FNPAD1 <> *blanks
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = FNPAD1
     C                   if        FNPAD2 <> *blanks
     C                   select
     C                   when      cltID = '139'
     C                   eval      grpAdr(adrLn) = %trim(grpAdr(adrLn)) +
     C                               ', ' + FNPAD2
     C                   other
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = FNPAD2
     C                   endsl
     C                   endif
     C                   eval      adrLn = adrLn + 1
     C                   eval      grpAdr(adrLn) = GetCityStZip(FNPCTY:
     C                                             FNPST:FNPZIP)
     C                   endif
     C                   endif
     C                   endif
     C*
     C                   if        not prtNJ
     c                             and not prt132
     C                   eval      adrLn = adrLn + 1
     c                   select

     c                   when      cltid = '139'
     C                   select
     C                   when      FNPH1 <> *zero
     C                   eval      grpAdr(adrLn) = 'For questions, ' +
     C                             'issues call ' + GetPhone#(FNPH1A:FNPH1)
     C                   when      FNPH2 <> *zero
     C                   eval      grpAdr(adrLn) = 'For questions, ' +
     C                             'issues call ' + GetPhone#(FNAREA:FNPH2)
     C                   endsl

     c                   other
     C                   select
     C                   when      FNPH1 <> *zero
     C                   eval      grpAdr(adrLn) = GetPhone#(FNPH1A:FNPH1)
     C                   when      FNPH2 <> *zero
     C                   eval      grpAdr(adrLn) = GetPhone#(FNAREA:FNPH2)
     C                   endsl
     C                   endsl
     C                   endif
     C*
     C* Employer Information
     C                   eval      NJTaxID = xxTxID
     c                   if        ##naml = 1
     C                   eval      empName = x1name
     c                   else
     c     x1name        cat(p)    x2name:0      empname
     c                   endif

     c                   callp     GetAddress
     C*
     C                   eval      currPol# = xPol
     C                   eval      prevPol# = xPPol
     C*
     C*   Type of Business
     C                   select
     C*    Sole proprietorship
     C                   when      EMTPOB = '1'
     C*    Partnership
     C                   when      emtpob = '2'
     C*    Corporation
     C                   when      emtpob = '3'
     C*    Other
     C                   other
     C                   eval      typeOfBusi = xxBTyp
     C                   endsl
     C*
     C                   eval      empRisk# = xxRisk
     C*
     C                   select
     C                   when      xxFEIN <> *zero
     C                   eval      empFEIN = %editc(xxFEIN:'X')
     C                   other
     C                   eval      empFEIN = *blanks
     C                   endsl
     C*
     C* Item 2
     C                   eval      polFrDt = AlphaUSA(CvtToDate(xxPfDt))
     C                   eval      polToDt = AlphaUSA(CvtToDate(xxPtDt))
     C*
     C* Item 3A
     c                   clear                   item3a1
     c                   clear                   item3a2
     C                   do        25            i
     C                   eval      i3 = i + 25
     C                   eval      item3A1 = %trim(item3A1) + ' ' + xSt(i)
     C                   eval      item3A2 = %trim(item3A2) + ' ' + xSt(i3)
     C                   enddo
     C*
     C* Item 3B
     C                   eval      item3B1 = xxAcc
     C                   eval      item3B2 = xxAgg
     C                   eval      item3B3 = xxDis
     C*
     C* Item 3C
     C                   eval      item3C1 = xxPP3C
     C                   eval      item3C2 = xxPPC3
     C                   eval      item3C1c = comp3c1
     C                   eval      item3C2c = comp3c2
     C*
     C* Item 3D
     c                   if        (cltid = '139') and (prtfl)
     c                   eval      item3D1 = 'See Item 3.D. Schedule '
     c                             + 'WC 99 06 56'
     c                   else
     C                   eval      item3D1 = LeftJstify(ddtl)
     c                   endif
     C*
     C* Premium
     C                   eval      inL2Prem  = tam(3) + tam(20)
     C                   eval      manprem   = tam(1)
     C                   eval      safedisc  = tam(16)
     C                   eval      drugdisc  = tam(6)
     C                   eval      contdisc  = tam(2)
     C                   eval      terrprem  = tam(25)
     c                   eval      modexfac  = xxexm1
     C                   eval      expMod    = xxExM1
     C                   eval      expMPrem  = tam(41)
     C                   eval      modExPrm  = tam(4)
     C                   eval      oth1Prem  = tam(5) - tam(4)
     C                   eval      stdPrem   = tam(5)
     C                   eval      premDisc  = tam(7)
     C                   eval      expConst  = tam(9)
     C                   eval      estPrem   = tam(10) - tam(28) - tam(25)
     C                   eval      oth2Prem  = tam(28) + tam(25)
     C                   eval      injSur2   = xx935
     C                   eval      uniEmpSur = xx936
     C                   eval      annPrem   = tam(10)
     C                   eval      minPrem   = xxMnPr
     C                   eval      depPrem   = xxPdPr
     C*
     C* Intermin Adjustments
