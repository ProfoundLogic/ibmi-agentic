       If (MUenSt = *blanks or MUenSt = 'MT') and (MUform <> 'WC000000C')
        and (MUform <> 'FORM 25-2');

       // Write record for Endorsement Form
          M2Co# = MUco#;
          M2fnd = MUfnd;
          M2Fyr = MUfyr;
