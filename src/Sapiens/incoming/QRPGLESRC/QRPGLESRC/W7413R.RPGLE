     C                   if        MUFORM = 'WC000402'
     C*
     C                   if        *IN37 = *OFF
     C*
     C                   MOVEL(P)  XXST          XXKEY
     C     stky          chain     pst01                              60
     C                   if        *in60 = *off
     C                   move      stnst         pest
     C                   endif
     C*
     C                   ELSE
     C                   MOVE      99            PEST
     C                   ENDIF                                                  *in37 ifeq
     C*
     C                   ENDIF                                                  muform ifeq
     C                   movel     q1user        peuser
     C                   movel     q1pgm         pepgm
     C                   eval      PETIME = TimeTo6(SystemTime)
     C                   eval      PEDT = sysDt7
     C                   movel     q1user        peiusr
     C                   movel     q1pgm         peipgm
     C                   eval      PEITIM = TimeTo6(SystemTime)
     C                   eval      PEIDT = PEDT
    C*
      /Free
               // Check 1st 8 positions of MUFORM against CTDATA arrays
               //  to verify if large deductible endorsement or not.
               //  These endorsements write their WXPEP records here
               //  instead of their respective
                chrForm8 = %Subst(MUform:1:8);
                intBdx = %Lookup(chrForm8:baseLdForms);
                Select;
                When cltID = '150' And intBdx = 0;
                   intSdx = %Lookup(chrForm8:sunzLdForms);
                When cltID = '153' And intBdx = 0;
                   intSdx = %Lookup(chrForm8:vitalLdForms);
     *** Beg Add *** 07/16/24 *** 148WEW **********************************
                When cltID = '148' And intBdx = 0;
                   intSdx = %Lookup(chrForm8:amwinsLdForms);
     *** End Add *** 07/16/24 *** 148WEW **********************************
                Endsl;
                If intBdx = 0 And intSdx = 0;
                   Write ppe01;
                Else;
                   Exsr SrDeduct;
                EndIf;
             EndIf;
          EndIf;
       EndIf;
      /End-Free
      *
     c                   If        ENexfl <> 'Y'
    C*
     C                   Movel(p)  MUForm        svform2          15
     C                   If        ENFormO <> ' '
