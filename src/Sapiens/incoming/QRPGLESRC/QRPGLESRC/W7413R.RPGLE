     C                   endif
    C*
     C                   move      '1'           nxexpp
    C*
     C                   if        elpfdt < 0960101
     C                   eval      nxexpa = 11
     C                   else
     C                   eval      nxexpa = 00
     C                   endif
    C*
     C                   move      'A'           nxstat
     C                   movel     q1user        nxuser
     C                   movel     q1pgm         nxpgm
    C*
     C                   eval      NXDT   = sysDt7
     C                   eval      NXTIME = TimeTo6(SystemTime)
    C*
     C                   eval      nxidt = nxdt
