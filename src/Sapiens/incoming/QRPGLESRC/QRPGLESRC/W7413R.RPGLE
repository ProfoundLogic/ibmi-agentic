     C                   MOVE      *BLANKS       NANAM2
     C                   MOVE      *BLANKS       NANAM4
     C                   if        XXPEON =  'Y'                                 NJ Policy
     C                   MOVEL     XXNAM4        NANAME
     C                   MOVEL     XXNAM4        NANAM4
     C                   ENDIF                                                  XXNJST IFEQ
     C                   MOVE      EMNAMP        NANAMP
     C                   If        emnami <> 'Y'
     C                   Exsr      srpeoe
     C                   Endif
     C*
     C                   clear                   nanam2
     C                   when      xsname = ' '
