     C*
     C                   Endif
     C                   Clear                   xxNatFm
    C*
     C                   Eval      xxform1 = xxform
     C                   Endif
     C                   Eval      muenst = '  '
     C                   eval      xxEnSt = '**'
     C* Add declaration page for Starstone policies.
     C*
     C                   If        (cltid = '148' and F2Car# = 38073) or (cltid
     C                             = '148' and *in75 = *off and xxCAst = 'Y')
     C                             or (cltid <> '148' and *in75 = *off and
     C                             xxCAst = 'Y')
     C*
     C                   Eval      endsForm = %trim(xxDecForm2)
     C*
     C                   If        declareForm <> ' '
     C                   Eval      endsForm = declareForm
      //*** Beg Add ***** 05/28/24 **********************************
        xxenst = declareST;
      //*** End Add ***** 05/28/24 **********************************
     C                   Endif
     C*
     C                   If        declareDesc = ' '
     C                   Eval      declareDesc = xxfd01a
     C                   Endif
     C*
     C                   If        declareDate = 0
     C                   Eval      declareDate = xxDecDate
     C                   Endif
     C*
     C                   Eval      ENEddt = declareDate
     C     endsForm      cat(p)    '(':0         endsForm
     C                   cat       xxedmm:0      endsForm
     C                   cat       '/':0         endsForm
     C                   cat       xxedyy:0      endsForm
     C                   cat       ')':0         endsForm
    C*
     C                   If        *in75 = *on
     C                   Eval      muenst = 'CA'
