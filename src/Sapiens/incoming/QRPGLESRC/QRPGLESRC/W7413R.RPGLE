     C*
     C* List schedules on schedule of endorsements
     C* (if not already listed by client or state conditions)
     C*
     C                   Select
     C                   When      unitedWis
     C* Already attached.
     C                   When      xxListSchd = 'Y' or *in75 = *on
      /free
       If cltid = '148' and F2Car# = 38073;
          xxForm = 'WC000000C';
          xxEnd# = 0;
          Chain(n) muky1 pmu01;
          If %found;
             endsForm = xxForm;
             Setgt enky pen01;
             Readpe enky pen01;
             If not %eof;
                endsForm = %trim(endsForm) + '(' + xxedmm + '/' + xxedyy + ')';
                Exsr ScriptForms;
                listWC000 = 'Y';
             Endif;
          Endif;
       Endif;
      /end-free
     C* Attach schedules here.
     C*
     C                   Eval      mueedt = ELPfdt
     C                   Eval      muenst = '  '
     C                   eval      xxEnSt = '**'
     C                   Clear                   ENFormO
     C* Add declaration page for CA.
     C                   If        *in75 = *on
     C                             and not (cltid = '148' and F2Car# = 38073)
     C*
     C                   Eval      endsForm = xx4001
     C                   If        declareForm <> ' '
     C                   Eval      endsForm = %trim(declareForm)
     C                   Endif
     C*
     C                   Eval      ENEddt = 0980101
     C                   If        declareDate <> 0
     C                   Eval      ENEddt = declareDate
     C                   Endif
     C     endsForm      cat(p)    '(':0         endsForm
     C                   cat       xxedmm:0      endsForm
     C                   cat       '/':0         endsForm
     C                   cat       xxedyy:0      endsForm
     C                   cat       ')':0         endsForm
    C*
     C                   Eval      muenst = 'CA'
     C                   Eval      mudsc2 = xxfd01
     C                   If        declareDesc <> ' '
     C                   Eval      mudsc2 = %trim(declareDesc)
     C                   Endif
    C*
     C                   Exsr      ScriptForms
    C*
     C*
     C* Attach CA dec page, removing base if client is specified.
     C*
     C                   movel(p)  xx4001        xxform
     C                   movel(p)  xxfd01        xxdesc
     C                   eval      xxend# = 0
     C                   Eval      xxNatFm = declareNatFm
     C                   eval      xxEnSt = 'CA'
    C*
     C                   If        declareForm <> ' '
     C
     C     muky1         chain     pmu01                              60
     C                   if        *in60 = *off
     C                   delete    pmu01
     C                   endif
     C
     C                   Eval      xxform = declareForm
     C                   Exsr      ClearSpaces
     C                   Eval      xxdesc = declareDesc
     C
     C                   Endif
    C*
     C     muky1         chain     pmu01                              60
     C                   if        *in60 = *on
     C                   exsr      attmu
     C                   Else
     C                   If        MuNatFm <> xxNatFm
     C                   Delete    pmu01
     C                   Exsr      Attmu
