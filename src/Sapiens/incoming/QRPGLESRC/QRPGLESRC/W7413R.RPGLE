             M2form = MUform;
          Endif;
          If MUdsc2 <> *blanks;
             M2desc = MUdsc2;
          Else;
             M2desc = MUdesc;
          Endif;
          M2imprt = 'Y';
          M2pgm  = Q1pgm;
          M2user = Q1user;
          M2time = TimeTo6(SystemTime);
