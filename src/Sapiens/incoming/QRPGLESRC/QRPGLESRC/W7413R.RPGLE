     C                   update    psh01
     C                   endif
     *
     C                   endif
    C*
      /Free
       If isUseXml and turn = 1;
          ReseqXmlOrder(OutputFile:xxCo#:xxFnd);
       Endif;
      /End-Free
     C     next          tag
    C*
     C                   if        zzemp# = *zero
    C*
    C*  IF PROCESSING FOR ALL EMPLOYERS, GET THE NEXT EMPLOYER.
    C*
     C                   if        turn = 2
     C     shky1         reade     psh02                                  50
     C                   else
     C     shky1         reade     psh03                                  50
     C                   endif
     C                   move      shemp#        xxemp#
     C                   move      shdiv         xxdiv
    C*
    C*  IF MAXIMUM NUMBER OF SPOOL FILES ARE WRITTEN, SUBMIT A
    C*  NEW JOB AND END THIS ONE.
    C*
     C                   if        *in50 = *off
     C                             and xsspl# >= xxmxsp
     *  End of a run, but not end of job... RESUBMIT
     C                             or *in50 = *on
     C                             and turn < 2
     C                             and xsspl# >= xxmxsp
     C                   if        turn < 2
     C                   move      '1'           qqstep
     C                   else
     C                   move      '2'           qqstep
     C                   endif
     C                   call      'W7415C'
     C                   parm                    qqco#
     C                   parm                    qqfnd
     C                   parm                    qqemp#
     C                   parm                    qqdiv
     C                   parm                    qqreis
     C                   parm                    qqque
     C                   parm                    qqstep
     C                   parm                    qqdart
     C                   parm                    qqhard
     C                   parm                    qqagto
     C                   parm                    qqrnb
     C                   parm                    qqdmbr
    C*
     C                   clear                   qqfina
    C*
     C                   eval      turn = 5
     C                   move      *on           *in50
     C                   endif
    C*
    C*  IF PROCESSING A SINGLE EMPLOYER, KILL THE LOOP.
    C*
     C                   else
     C                   move      *on           *in50
     C                   endif
    C*
     C                   enddo
     C                   if        qqagto = 'Y'
     C                             and *in32 = *off
     C                   eval      turn = turn + 1
     C                   if        turn = 2
     C                   move      '2'           qqstep
     C                   if        zzemp# = *zero
     C                   clear                   qqb1
     C                   clear                   qqb2
     C                   If        isuseSpoolOut
     C                   call      'W7413C4'
     C                   parm                    qqb1
     C                   parm                    qqb2
     C                   parm                    qqcpy
     C                   parm                    qqdart
     C                   parm                    qqque
     C                   parm                    x1hold
     C                   parm                    x1save
     C                   parm                    qqdmbr
     C                   parm      ' '           xxordr
     C                   parm                    QQDC22
     C                   parm                    qqiflr
     C                   parm                    x1draw
     C                   parm      cmuncn        qquncn          255
     C                   parm      cmifsp        qqifsp            1
     C                   Endif
     C                   endif
     C                   endif
     *  If job has been resubmitted, turn has been z-added to 5
     *  to facilitate drop thru to end this job.
     C                   if        turn < 3
     C                   goto      turnt
     C                   endif
     C                   endif
    C*
    C*  FOR MID TERM ENDORSEMENTS, WRITE A REC TO THE MERGE DATA WORKFILE
    C*
     C                   if        *in32 = *on
     C                             and *in23 = *on
     C                             or *in23 = *off
     C                             and xxpbcg = *on
     C                   if        xxPDF <> 'Y'
     C                   open      wxicp
     C                   movel(p)  'MTPOLS'      xxdcid
     C                   movel(p)  'AMTEMP'      xxfold
     C                   call      'SA039R'
     C                   parm                    xxfold
     C                   exsr      increc
     C                   close     wxicp
     C                   endif
     C                   endif
    C*
     C                   if        q1prms >= 17
     C                   eval      qqPRTF = printer
     C                   endif
    C*
     C                   if        q1prms >= 18
     C                   eval      qqPRTF1 = printer1
     C                   endif

     c     *LOCK         in        PremVal
     c                   move      xxpdpr        depprm
     c                   move      tam(10)       tam10
     c                   out       PremVal
    C*
    C* CLEAR OUT ANY PAYROLL RECORDS.
    C*
     C     fnky          chain     xep02                              60
     C                   dow       *in60 = *off
     C                   delete    xep02
     C     fnky          reade     xep02                                  60
     C                   enddo
    C*
      /Free
       Select;
       When xxProcessType = 'Mid-Term Endorsement';
       When xmlFileName   = *Blanks;
       Other;
          Monitor;
             S4401C(xmlFileName + '$');
          On-error;
          //* Reset records if running mass policy page and throw error.
             If zzemp# = 0 and polStamp <> ' ';
                Setll ('3':'P':xxco#:xxfnd) psh05;
                Reade ('3':'P':xxco#:xxfnd) psh05;
                Dow not %eof;
                   If SHRun = polStamp;
                      SHStat = '2';
                      Clear SHStep;
                      Clear SHTrdt;
                      Clear SHUnid;
                      Clear SHCode;
                      Clear SHSbdt;
                      Clear SHSbtm;
                      Clear sst;
                      Clear sss;
                      Clear ssc;
                      Clear ssd;
                      Clear sti;
                      Update psh05;
                   Endif;
                   Reade ('3':'P':xxco#:xxfnd) psh05;
                Enddo;
             Endif;
             msgDta = 'S4401C has encountered an error with java or ' +
              'Scriptura. Review error spool file and job log';
             SendEscMsg('CPF9898':'QCPFMSG   QSYS':msgDta:%size(msgDta):
              '*ESCAPE':'*':2:msgKey:errorDS);
          Endmon;
       Endsl;

       *Inlr = *On;
      /End-free
    C*====================================================================
    C*  INITIALIZATION SUBROUTINE
    C*====================================================================
     C     *inzsr        begsr

     C                   call      'RTVCLTID'
