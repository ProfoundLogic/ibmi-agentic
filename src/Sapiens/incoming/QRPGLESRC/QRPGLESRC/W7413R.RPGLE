     c                   endif
     c                   if        EMTPOB <> *blank
     c                   movel(p)  'BUSI'        xxtbid
     c                   movel(p)  EMTPOB        xxkey
     c     gtky          chain     pgt01
     c                   if        %found
     c                   movel     GTDESC        xxtypb
     c                   else
     c                   clear                   xxtypb
     c                   endif
     c                   endif
     c                   eval      xxemp# = employer#
     c                   eval      xxdiv  = division
     c     emky1         chain     pem01
     c                   return    xxtypb
     p getPEOTypB      e
     *=============================================================================================
      * getPEOProd - returns most current producer for the PEO Master
     *=============================================================================================
     p getPEOProd      b
     d getPEOProd      pi            60
     d  co#            s                   like(ELCO#)
     d  fnd            s                   like(ELFND)
     d  emp#           s                   like(ELEMP#)
     d  div            s                   like(ELDIV)
     d  fyr            s                   like(ELFYR)
     d  agt#           s              5  0 inz
     d  agt_name       s             60    inz
     d  prod           s              5  0
     d  prod_nm        s             60
     d  area_cd        s              3  0
     d  phone#         s              7  0
     d  plan           s              1
     d  asOfDate       s              8  0
     c                   callp     getAgtInfo( xxco#    :
     c                                         xxfnd    :
     c                                         1        :
     c                                         0        :
     c                                         xxfyr    :
     c                                         agt#     :
     c                                         agt_name :
     c                                         prod     :
     c                                         prod_nm  :
     c                                         area_cd  :
     c                                         phone#   :
     c                                         plan     :
     c                                         asOfDate )

     c                   move      agt#          qqagt#
     c                   move      prod          qqprod
     c                   clear                   qqagnm
     c                   clear                   qqamad
     c                   clear                   qqamcz
     c                   clear                   qqapad
     c                   clear                   qqapcz
     c                   clear                   qqprnm
     c                   clear                   qqmcty
     c                   clear                   qqmst
     c                   clear                   qqmzip
     c                   clear                   qqpcty
     c                   clear                   qqpst
     c                   clear                   qqpzip
     c                   clear                   qqare1
     c                   clear                   qqphn1
     c                   clear                   qqMail
    
     c                   call      'SRAGT'
     c                   parm                    qqco#
     c                   parm                    qqfnd
     c                   parm                    qqagt#
     c                   parm                    qqprod
     c                   parm                    qqagnm
     c                   parm                    qqamad
     c                   parm                    qqamcz
     c                   parm                    qqapad
     c                   parm                    qqapcz
     c                   parm                    qqprnm
     c                   parm                    qqmcty
     c                   parm                    qqmst
     c                   parm                    qqmzip
     c                   parm                    qqpcty
     c                   parm                    qqpst
     c                   parm                    qqpzip
     c                   parm                    qqare1
     c                   parm                    qqphn1
     C                   parm                    qqMail
     c                   movel     qqprnm        prod_nm
     c                   return    prod_nm
     p getPEOProd      e
     *=============================================================================================
      * aggregate - Determine is this employer is an aggrogate employer
     *=============================================================================================
     p aggregate       b
     d aggregate       pi              n
     d  k1co#                              like(ELCO#)
     d  k1fnd                              like(ELFND)
     d  k1emp#                             like(ELEMP#)
     d  k1div                              like(ELDIV)
     d  k1fyr                              like(ELFYR)

     C     ldky1         klist
     C                   kfld                    k1co#
     C                   kfld                    k1fnd
     C                   kfld                    k1emp#
     C                   kfld                    k1div
     C                   kfld                    k1fyr

     C     ldky1         chain     pld02
     C                   if        %found and ldamg1<>0
     C                   return    *on
     C                   else
     C                   return    *off
     C                   endif

     p aggregate       e
      *=============================================================
      * ApplyRateSplit - Check option flag to apply rate split
      *=============================================================
     p ApplyRateSplit  b
     d ApplyRateSplit  pi              n
     d   inState                      2a
     d   inDate                       7  0
     d   outstcd                      5  0 options(*nopass)
      *
     d xxState         s              2a
     d xxSpltDt        s              7  0
     d xxPrcRate       s               n
      *
     C     rtky          klist
     C                   kfld                    xxco#
     C                   kfld                    xxfnd
     C                   kfld                    xxstate
     C                   kfld                    xxSpltDt          7 0
     C*
     C                   eval      xxPrcRate = *on
     C                   eval      xxState = inState
     C                   eval      xxSpltDt = inDate
     C     rtky          chain     prt0x
     C                   if        %found and rxopt = 'Y'
     C                   eval      xxPrcRate = *off
     C                   endif
     c                   if        %parms >= 3 and %found
     c                   eval      outstcd = rxstat
     c                   endif
     C*
     C                   return    xxPrcRate
     C*
     p ApplyRateSplit  e

     *=============================================================================================
      * GetAddress - load Employer address fields
     *=============================================================================================
     p GetAddress      b
     d GetAddress      pi

     d a1              s              3  0
     d n1              s              3  0

     c                   eval      n1 = ##adrl

     c     1             do        5             a1
     c                   eval      empa(a1) = *blanks

     c                   if        n1 <= 7
     c                   eval      empa(a1) = emn(n1)
     c                   endif

     c                   eval      n1 = n1 + 1
     c                   enddo

     p GetAddress      e
      *================================================================
      * setNmAddr - used to for GIC name/address formatting in
      *             W7413OCLT/W7413OFL/W7413ONJ.
      *================================================================
     p setNmAddr       b
     d setNmAddr       pi
     d x1              s              3  0 inz(1)
     d y1              s              3  0 inz(0)
      *
      *  MH2 positions 'Mailing Address:' on NJ forms.
      *
     c                   eval      njMaHdr    = 'Mailing Address:'
     c                   eval      mh2 = 2.50 + (.15 * (##adrl - 1))
     c                   if        ##peo1 <> *blank
     c                   eval      namAddr(x1) = ##peo1
     c                   add       1             x1
     c                   eval      mh2 = mh2 + .15
     c                   endif
     c                   if        ##peo2 <> *blank
     c                   eval      namAddr(x1) = ##peo2
     c                   add       1             x1
     c                   eval      mh2 = mh2 + .15
     c                   endif
     c                   if        ##emn1 <> *blank
     c                   eval      namAddr(x1) = ##emn1
     c                   add       1             x1
     c                   endif
     c                   if        ##emn2 <> *blank
     c                   eval      namAddr(x1) = ##emn2
     c                   add       1             x1
     c                   endif
     c                   if        ##emn3 <> *blank
     c                   eval      namAddr(x1) = ##emn3
     c                   add       1             x1
     c                   endif
     c                   if        ##emn4 <> *blank
     c                   eval      namAddr(x1) = ##emn4
     c                   add       1             x1
     c                   endif
     c                   if        ##emn5 <> *blank
     c                   eval      namAddr(x1) = ##emn5
     c                   add       1             x1
     c                   endif
     c                   if        ##emn6 <> *blank
     c                   eval      namAddr(x1) = ##emn6
     c                   add       1             x1
     c                   endif
     c                   if        ##emn7 <> *blank
     c                   eval      namAddr(x1) = ##emn7
     c                   add       1             x1
     c                   endif
     p setNmAddr       e
      *================================================================
      *====================================================================
      *  Updates date range in WXNAP if applicable
      *====================================================================

      *====================================================================
      *  Updates date range in WXNAP if applicable
      *====================================================================
     p updatWXNAP      b
     d updatWXNAP      pi
     d  typeAddress                   1    const                                Mailing or Physical

     C                   Z-add     NANamEfd      svNamEfd          7 0
     C*
     C* If new info is active, and old info is active, update to earlier date.
     C*
     C                   If        xrefdt <> xrexdt and
     C                             napfdt <> naptdt
     C*
     C                   If        svefdt < NANamEfd
     C                             and svefdt <> svexdt
     C                   Eval      NANamEfd = svefdt
     C                   Eval      NAAdrEfd = svefdt
     C                   Eval      xxchg = 'Y'
     C                   Endif
     C*
     C                   Else
     C*
     C* If new or old info is not active, then check for gap in coverage.  If one
     C* exists, then update to reflect beginning date of later coverage.  Otherwise
     C* update to earlier beginning date.
     C*
     C                   If        svefdt > NAptdt or xrexdt < NANamEfd
     C*
     C* Update if gap in coverage, and existing info is from earlier period.
     C*
     C                   If        svefdt > NAptdt
     C                             and svefdt <> svexdt
     C                   Eval      NANamEfd = svefdt
     C                   Eval      NAAdrEfd = svefdt
     c                   Eval      xxchg = 'Y'
     C                   Endif
     C*
     C                   Else
     C*
     C* If no gap in coverage then update to earlier date eff date.
     C*
     C                   If        svefdt < NANamEfd
     C                             and svefdt <> svexdt
     C                   Eval      NANamEfd = svefdt
     C                   Eval      NAAdrEfd = svefdt
     C                   Eval      xxchg = 'Y'
     C                   Endif
     C*
     C                   Endif                                                  Gap in coverage
     C*
     C                   Endif                                                  Both active

     c                   if        NAPFDT <> NAPTDT
     c                   if        cxStatus = *blanks
     c                   if        xrefdt < NAPFDT
     C                             and svefdt <> svexdt
     c                   eval      NAPFDT = xrefdt
     c                   eval      NAPFD2 = xrefdt
     c                   eval      xxchg = 'Y'
     c                   endif
     c                   if        xrexdt > NAPTDT
     C                             and svefdt <> svexdt
     c                   eval      NAPTDT = xrexdt
     c                   eval      NAPTD2 = xrexdt
     c                   eval      xxchg = 'Y'
     c                   endif
     c                   Endif
     c                   else
     c                   if        cxStatus = 'midTermCx'
      * Update to later cx date if applicable.
     c                   if        xrefdt > NAPFDT
     c                   eval      NAPFDT = xrefdt
     c                   eval      NAPFD2 = xrefdt
     c                   eval      NAPTDT = xrexdt
     c                   eval      NAPTD2 = xrexdt
     c                   eval      xxchg = 'Y'
     c                   endif                                                  xrefdt > NAPFDT
     c                   else
      * Update the address dates if no longer cancelled
     C                   If        svefdt > NAptdt or xrexdt < svNamEfd
     c                   eval      NAPFDT = xrefdt
     c                   eval      NAPFD2 = xrefdt
     c                   eval      NAPTDT = xrexdt
     c                   eval      NAPTD2 = xrexdt
     c                   Else
     c                   eval      NAPFDT = NANamEfd
     c                   eval      NAPFD2 = NANamEfd
     c                   eval      NAPTDT = xrexdt
     c                   eval      NAPTD2 = xrexdt
     c                   Endif
     c                   eval      xxchg = 'Y'
     c                   endif                                                  cxStatus = midTermCx
     c                   endif                                                  NAPFDT <> NAPTDT

     c                   if        xxchg = 'Y'
     c                   update    pna01
     c                   callp     updatWXA5l2( 'typeAddress')
     c                   eval      *in61 = *off
     c                   else
     c                   eval      *in61 = *on
     c                   endif                                                  xxchg <> *blank
     c   61              except    pna01e

     p updatWXNAP      e
      *====================================================================
      *  Updates date range in WXA5L2 if WXNAP was updated
      *====================================================================
     p updatWXA5L2     b
     d updatWXA5L2     pi
     d  typeAddress                   1    const                                Mailing or Physical
     d  keyAddr        s                   like(A5ADDR)                         Mailing or Physical
     d                 ds

     c     a5key         klist
     c                   kfld                    xxco#
     c                   kfld                    xxfnd
     c                   kfld                    xxemp#
     c                   kfld                    xxfyr
     c                   kfld                    keyAddr

     c     n1key         klist
     c                   kfld                    xxco#
     c                   kfld                    xxfnd
     c                   kfld                    xxemp#
     c                   kfld                    xxfyr
     c                   kfld                    L2A5NLNK
     c                   kfld                    L2A5NLKC
      * Construct keyAddr to read WXA5L2 by A5ADDR (Concat of address fields)
     c                   eval      keyAddr = NAMAD1 +
     c                              NAMAD2 +
     c                              %trim(NAMCTY) + ', ' +
     c                              NAMST  + '  ' +
     c                              %subst(%editc(NAMZIP : 'X') : 1 : 5)

     c                   if        %subst(%editc(NAMZIP:'X'):6:4) <> '0000'
     c                   eval      keyAddr = %trim(keyAddr) + '-' +
     c                              %subst(%editc(NAMZIP:'X'):6:4)
     c                   endif
      * Read thru WXA5L2 by keyAddr. Check name(x) against WXN1P to make sure we have the
      * WXA5P record that belongs to the name we are processing.  Update the date range if
      * effective date is less or exp date is greater (0 means not expired)
     c     a5key         setll     pa5l2
     c     a5key         reade     pa5l2
     c                   dow       not(%eof)
     c     n1key         chain     pn102
     c                   if        name(1) = N1NAM1 and
     c                             name(2) = N1NAM2 and
     c                             name(3) = N1NAM3 and
     c                             name(4) = N1NAM4 and
     c                             name(5) = N1NAM5 and
     c                             name(6) = N1NAM6 and
     c                             name(7) = N1NAM7 and
     c                             name(8) = N1NAM8 and
     c                             name(9) = N1NAM9
     C*
     C* If new info is active, and old info is active, update to earlier date.
     C*
     C                   If        xaefdt <> xadldt and
     C                             L2A5EFDT <> L2A5DLDT
     c                   if        xaefdt   < L2A5EFDT
     c                   eval      L2A5EFDT = xaefdt
     c                   endif
     c                   if        xadldt   > L2A5DLDT or xadldt = 0
     c                   eval      L2A5DLDT = xadldt
     c                   endif
     C                   Else
     C*
     C* If new or old info is not active, then check for gap in coverage.  If one
     C* exists, then update to reflect beginning date of later coverage.  Otherwise
     C* update to earlier beginning date.
     C*
     C                   If        xaefdt > L2A5DLDT or xadldt < L2A5EFDT
     C*
     C* Update if gap in coverage, and existing info is from earlier period.
     C*
     C                   If        xaefdt > L2A5DLDT
     C                             and xaefdt <> xadldt
     C                   Eval      L2A5EFDT = xaefdt
     C                   Eval      L2A5DLDT = xadldt
     C                   Endif
     C*
     C                   Else
     C*
     C* If no gap in coverage then update to earlier date eff date.
     C*
     C                   If        xaefdt < L2A5EFDT
     C                             and xaefdt <> xadldt
     C                   Eval      L2A5EFDT = xaefdt
     C                   Eval      L2A5DLDT = xadldt
     C                   Endif
     C*
     C                   Endif                                                  Gap in coverage
     C*
     C                   Endif                                                  Both active
     c                   update    pa5l2
     c                   endif
     c     a5key         reade     pa5l2
     c                   enddo

     p updatWXA5L2     e
      *====================================================================
      *  Total all F-class or harbor exposure payroll on policy
      *====================================================================
     p FClassTotal     b
     d FClassTotal     pi            11  2

     d xxTotal         s             11  2 inz(0)

     C                   open      wmepl1
     C*
     C     epky3         chain     pep02                              99
     C*
     C                   dow       not *in99
     C*
     C                   if        epstat<>'I'
     C*
     C                   Z-ADD     0             X1EFDT
     C                   MOVE(P)   ELCO#         ##CO#             3
     C                   MOVE(P)   ELFND         ##FND             3
     C                   MOVE(P)   ELFYR         ##FYR             3
     C                   MOVE(P)   ELEMP#        ##EMP#            9
     C                   MOVE(P)   ELDIV         ##DIV             5
     C                   MOVE(P)   EPEFDT        ##DATE            7
     C                   MOVE(P)   'P'           ##TYPE            1
     C                   MOVE(P)   EPCLAS        ##CLAS            5
      *
     C                   CALL      'SREFFD'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##FYR
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##DATE
     C                   PARM                    ##TYPE
     C                   PARM                    ##CLAS
      *
     C                   MOVE      ##DATE        X1EFDT
     C     prky3         setgt     ppr01
     C     prky4         readpe    ppr01                                  60
     C                   if        *in60 = *off
     C                             and prlhcd = 'Y'
     C                             or EPSpec = 'F'
     C*
     C                   Add       EPEmpr        xxTotal
     C*
     C                   endif                                                  *in60 = *off
     C*
     C                   endif                                                  EPSTAT IFNE
     C*
     C     epky3         reade     pep02                                  99
     C                   enddo
     C*
     C                   close     wmepl1
     C*
     C                   Return    xxTotal

     p FClassTotal     e
      *====================================================================
      *  Returing the flag which denotes if there has been a premium change.
      *====================================================================
      *====================================================
      * Return NCCI State Code
      *====================================================
     p GetNcciStCode   b
     d GetNcciStCode   pi             2
     d  physState                     2
     d  mailState                     2
     d xxState         s             10
      /free
       Select;
       When physState <> *blanks;
          xxState = physState;
       When mailState <> *blanks;
          xxState = mailState;
       Endsl;
       Chain xxState pst01;
       Return STnst;
      /end-free
     p GetNcciStCode   e
     *=============================================================================================
      * ReseqXmlOrder - Resequence Xml Order
     *=============================================================================================
     P ReseqXmlOrder   b
     D ReseqXmlOrder   pi
     D  XmlKey                       60
     D  XmlCo#                        3  0
     D  XmlFnd                        3  0
     D                 DS
     D XmlInfo                       99    DIM(99999) ASCEND
     D   Type                         1    Overlay(XmlInfo:1)     INZ(*HIVAL)
     D   File                        60    Overlay(XmlInfo:*next) INZ(*HIVAL)
     D   OldOrder                     7S 2 Overlay(XmlInfo:*next) INZ(*HIVAL)
     D   NewOrder                     5S 0 Overlay(XmlInfo:*next) INZ(*HIVAL)
     D   PosFlag                      1    Overlay(XmlInfo:*next) INZ(*HIVAL)
     D   DscXml                      25    Overlay(XmlInfo:*next) INZ(*HIVAL)
      *
      * Stand Alone
      *
     D xxForm          S                   LIKE(ENFORM)inz
     D xxCo#           S                   LIKE(ENco#) inz
     D xxFnd           S                   LIKE(ENfnd) inz
     D OutputFile      S                   LIKE(XPFILE) inz
     D TemplateFile    S                   LIKE(XTXMLT) inz
     D Ix              S              5  0 INZ
     D Ij              S              5  0 INZ
     D Dorder          S              5  0 INZ
     D FormEnd         S              5  0 INZ
     D xxDcId          S             60    INZ

      /Free
       // Incoming parameters
       OutputFile = XmlKey;
       xxCo#      = XmlCo#;
       xxFnd      = XmlFnd;
       Read(n) psc0p;

       //Load Current Xml Order
       Setll OutputFile xp103;
       Reade OutputFile xp103;
       Dow not %eof(XMLPREL3);
          Ix = Ix + 1;
          Type(Ix)     =  'P';
          File(Ix)     =  XPxmlt;
          OldOrder(Ix) =  XPorder;
          NewOrder(Ix) =  *Zeros;
          PosFlag(Ix)  =  *Blanks;
          DscXml(Ix)   =  XPdcid;
          Reade OutputFile xp103;
       Enddo;

       TemplateFile = XmlKey;
       Setll TemplateFile xi100;
       Reade TemplateFile xi100;

       Dow not %eof(XMLTEML);
          FormEnd = %scan('.':XTdcid);
          If FormEnd > *Zeros;
             xxForm = %subst(XTdcid:1:FormEnd-1);
          Else;
             xxForm = 'Not a Form';
          Endif;

         Ix = Ix + 1;
         Type(Ix)     =  'T';
         File(Ix)     =  XTxmlt;
         OldOrder(Ix) =  XTorder;
         NewOrder(Ix) =  *Zeros;
          Chain (xxCo#:xxFnd:xxForm) WTENL;
          If %found(WTENL);
             If ENdpos = *Blanks;
                PosFlag(IX) = 'E';
             Else;
                PosFlag(Ix) =  ENdpos;
             Endif;
          Else;
             PosFlag(Ix) = *blanks;
             If XTType = 'Schedule of Installments' and
              cltid = '148' and F2Car# = 38073;
                PosFlag(IX) = 'B';
             Endif;
             If XTType = 'Schedule of Classifications' and XTBundle <> 0 and
              cltid = '148' and F2Car# = 38073;
                OldOrder(Ix) =  XPOrder + .5;
             Endif;
          Endif;
          DscXml(Ix) = XTdcid;

          If xxForm <> 'Not a Form';

             Clear xxSig;
             Clear xxSig2;
             Clear xxFolder;
             Clear xxFolder2;

             Setgt ('E':SHFnd:xxForm:mainSt:sysDt7) spp01;
             Readpe(n) ('E':SHFnd:xxForm:mainSt) spp01;
             If not %eof;
                xxSig = PP1stSig;
                xxFolder = PP1stSPth;
                xxSig2 = PP2ndSig;
                xxFolder2 = PP2ndSPth;
             Else;
                Setgt ('E':SHFnd:xxForm:'  ':sysDt7) spp01;
                Readpe(n) ('E':SHFnd:xxForm:'  ') spp01;
                If not %eof;
                   xxSig = PP1stSig;
                   xxFolder = PP1stSPth;
                   xxSig2 = PP2ndSig;
                   xxFolder2 = PP2ndSPth;
                Else;
                   Setgt ('E':000:xxForm:mainSt:sysDt7) spp01;
                   Readpe(n) ('E':000:xxForm:mainSt) spp01;
                   If not %eof;
                      xxSig = PP1stSig;
                      xxFolder = PP1stSPth;
                      xxSig2 = PP2ndSig;
                      xxFolder2 = PP2ndSPth;
                   Else;
                      Setgt ('E':000:xxForm:'  ':sysDt7) spp01;
                      Readpe(n) ('E':000:xxForm:'  ') spp01;
                      If not %eof;
                         xxSig = PP1stSig;
                         xxFolder = PP1stSPth;
                         xxSig2 = PP2ndSig;
                         xxFolder2 = PP2ndSPth;
                      Endif;
                   Endif;
                Endif;
             Endif;

             If xxSig <> ' ';
                StLetter('SIGNATURE':xxSig:xxFolder);
                XTFrmSig = %trim(xxSig);
                XTTempIFS = %trim(xxFolder);
                XTTempWin = %trim(SCSigDir);
             Endif;

             If xxSig2 <> ' ';
                StLetter('SIGNATURE':xxSig2:xxFolder2);
                XTFrmSig2 = %trim(xxSig2);
                XTTempIFS = %trim(xxFolder);
                XTTempWin = %trim(SCSigDir);
             Endif;

             If xxSig <> ' ' or xxSig2 <> ' ';
                Update xi100;
             Endif;

          Endif;

          Reade TemplateFile xi100;
       Enddo;

       //Sort by Old order
       SortA OldOrder;           //For viewing purposes

       Dorder = *zeros;

       //Process 'D' positions

       // CA 34-2005 1008
       For Ij = 1 to ix;
         xxDcId  = DscXml(ij);
         FormEnd = %scan('.':xxDcId);
         If FormEnd > *Zeros;
            xxForm  = %subst(xxDcId:1:FormEnd-1);
         Else;
            xxForm = 'Not a Form';
         Endif;

         If PosFlag(ij) = 'D' and %subst(xxForm:1:10) = 'PN34051008';
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
            Leave;
         Endif;
       Endfor;

       //Other 'D' positions;
       For Ij = 1 to ix;
         xxDcId  = DscXml(ij);
         FormEnd = %scan('.':xxDcId);
         If FormEnd > *Zeros;
            xxForm  = %subst(xxDcId:1:FormEnd-1);
         Else;
            xxForm = 'Not a Form';
         Endif;

         If PosFlag(ij) = 'D' and %subst(xxForm:1:10) <> 'PN34051008';
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
         Endif;
       Endfor;

       //Process Blank Positions
       For Ij = 1 to ix;
         If PosFlag(ij) = *blanks;
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
         Endif;
       Endfor;

       //Process 'B' positions
       For Ij = 1 to ix;
         If PosFlag(ij) = 'B';
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
         Endif;
       Endfor;

          //Process 'E' positions
       For Ij = 1 to ix;
         If PosFlag(ij) = 'E';
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
         Endif;
       Endfor;

           //Process 'A' positions
       For Ij = 1 to ix;
         If PosFlag(ij) = 'A';
            Dorder       = Dorder + 1;
            NewOrder(ij) = Dorder;
         Endif;
       Endfor;

       //Sort by new order
       SortA NewOrder;

       // Update file with new order.

       For ij = 1 to ix;
          Select;

          When Type(ij) = 'T';
             TemplateFile = File(ij);
             Chain TemplateFile XT100;
             If %found(XMLTEML1);
               XTorder = NewOrder(ij);
               strLang = XTLang;
               Clear strLangCode;
               StLetter('LANGUAGE':strLang:strLangCode);
               XTLang = %trim(strLangCode);
               Update XT100;
             Endif;

          When Type(ij) = 'P';
             OutputFile = File(ij);
             Chain OutputFile xu103;
             If %found(XMLPREL2);
               XPorder = NewOrder(ij);
               strLang = XPLang;
               Clear strLangCode;
               StLetter('LANGUAGE':strLang:strLangCode);
               XPLang = %trim(strLangCode);
               Update xu103;
             Endif;

          Endsl;
       Endfor;


       Return;
      /End-Free

     p ReseqXmlOrder   e

     P*--------------------------------------------------
     P* Procedure name: GetInvoiceDates
     P* Purpose: Populates date arrays for AmWins
     P*          installment schedule
     P* Returns: N/A
     P*--------------------------------------------------
     pGetInvoiceDates  b
     dGetInvoiceDates  pi

     d intPfDow        s              1  0
     d intDays         s              2  0
     d intRptDow       s              1  0
     d intSrDays       s              2  0
     d i               s              2  0
     d j               s              2  0 Inz(1)
     d k               s              2  0 Inz(1)
     d m               s              2  0 Inz(1)
     d isMonthly       s               n
     d isWeekly        s               n
     d isBiMonthly     s               n
     d dateBillStart   s               d   DatFmt(*Usa)
     d dateMonthEnd    s               d   DatFmt(*Usa)
     d dateNxtWeekly   s               d   DatFmt(*Usa)
     d datePolicyBeg   s               d   DatFmt(*Usa)
     d datePolicyEnd   s               d   DatFmt(*Usa)
     d dsDate          ds                  Qualified
     d  workDate                      8  0 Overlay(dsDate)
     d  month                         2  0 Overlay(workDate)
     d  day                           2  0 Overlay(workDate:*Next)
     d  year                          4  0 Overlay(workDate:*Next)
     d workDate        s               d   DatFmt(*Usa)

      /Free
       reset insAmount;
       reset insDueDt;
       reset insFrDt;
       reset insToDt;
       reset insPct;
       isMonthly   = (BSfreq = 'M' or BSfreq = *Blank);
       isWeekly    = (BSfreq = 'W');
       isBiMonthly = (BSfreq = 'T');   // Not expecting this plan to be used
       dateBillStart = %Date(ELbsdt:*Cymd);
       datePolicyBeg = %Date(ELpfdt:*Cymd);
       datePolicyEnd = %Date(ELptdt:*Cymd);
       // Write out estimating schedule
       If BSsefl = 'E' and isMonthly;
         // Get first post date
          For i = 1 by 1 to 12;
             If ab(i) <> 0;
                eval(h) insPct(j) = ab(i) * 100;
                insDueDt(j) =
                 %Dec(%Char(dateBillStart + %Months(i-1):*Usa0):8:0);
                dsDate.workDate = insDueDt(j);
                If i <> 1 and ELblfl <> 'Y' and dsDate.day <> 1;
                   dsDate.day = 1;
                   insDueDt(j) = dsDate.workDate;
                Endif;
               // Find next installment date
                k = i + 1;
                m = 0;
                For k = i + 1 by 1 to 12;
                   m += 1;
                   If ab(k) <> 0;
                      Leave;
                   Endif;
                EndFor;
                insDueDt(j+1) =
                 %Dec(%Char(%Date(insDueDt(j):*Usa) + %Months(m):*Usa0):8:0);
                dsDate.workDate = insDueDt(j+1);
                If ELblfl <> 'Y' and dsDate.day > 1;
                   dsDate.day = 1;
                   insDueDt(j+1) = dsDate.workDate;
                Endif;
               // Subtract 1 day from next installment date unless on last
               //  bucket. Use policy expiration date to pull all
               //  remaining A/R into last bucket.
                If %Date(insDueDt(j+1):*Usa) >= datePolicyEnd;
                   insToDt(j) = insDueDt(j + 1);
                Else;
                   insToDt(j) =
                    %Dec(%Char(%Date(insDueDt(j+1):*Usa)-%Days(1):*Usa0):8:0);
                Endif;
                WriteArInst(insDueDt(j):insToDt(j):j);
                j += 1;
             Endif;
          EndFor;
          insCount = j - 1;
       Endif;
       // Write self reporting schedule. Overwrite dates from estimating plan
       //  if flagged for S/R Pay
       If isMonthly and (BSsefl = 'S' or BSpayr = 'Y');
         // Calculate first reporting period
          j = 1;
          insFrDt(j) = %Dec(%Char(dateBillStart:*Usa0):8:0);
          dateMonthEnd = dateBillStart + %Months(j);
          intDays = %Subdt(dateMonthEnd:*Days);
          dateMonthEnd = dateMonthEnd - %Days(intDays);
          insToDt(j) = %Dec(%Char(dateMonthEnd:*Usa0):8:0);
          insDueDt(j) =
           %Dec(%Char(dateMonthEnd + %Days(FNmidy):*Usa0):8:0);
         // Calculate the rest
          For i = 2 by 1 to 12;
             j = i - 1;
             insFrDt(i) =
              %Dec(%Char(%Date(insToDt(j):*Usa) + %Days(1):*Usa0):8:0);
             dateMonthEnd = %Date(insFrDt(i):*Usa) + %Months(1);
             intDays = %Subdt(dateMonthEnd:*Days);
             dateMonthEnd = dateMonthEnd - %Days(intDays);
             insToDt(i) = %Dec(%Char(dateMonthEnd:*Usa0):8:0);
             insDueDt(i) =
              %Dec(%Char(dateMonthEnd + %Days(FNmidy):*Usa0):8:0);
             If %Date(insToDt(i):*Usa) >= datePolicyEnd;
                insToDt(i) = %Dec(%Char(datePolicyEnd:*Usa0):8:0);
                Leave;
             Endif;
          EndFor;
       Endif;
       // Write out weekly schedule
       If isWeekly;
          Select;
          When BSdowk = 'MO';
             intRptDow = 1;
          When BSdowk = 'TU';
             intRptDow = 2;
          When BSdowk = 'WE';
             intRptDow = 3;
          When BSdowk = 'TH';
             intRptDow = 4;
          When BSdowk = 'FR';
             intRptDow = 5;
          When BSdowk = 'SA';
             intRptDow = 6;
          When BSdowk = 'SU';
             intRptDow = 7;
          Endsl;
          insFrDt(j) = %Dec(%Char(dateBillStart:*Usa0):8:0);
          intPfDow = Dow(insFrDt(j));
          Select;
          When intRptDow <= intPFDow;
             intDays = intRptDow - intPfDow + 7;
          Other;
             intDays = intRptDow - intPfDow;
          Endsl;
          dateNxtWeekly = dateBillStart + %Days(intDays);
          insToDt(j) = %Dec(%Char(dateNxtWeekly:*Usa0):8:0);
          If BSsefl = 'S' or BSpayr = 'Y';
             intSrDays = FNwidy;
          Endif;
          insDueDt(j) =
           %Dec(%Char(dateNxtWeekly + %Days(intSrDays):*Usa0):8:0);
          If BSsefl = 'E';
             WriteARInst(insFrDt(j):insToDt(j):j);
          Endif;
          For i = 2 by 1 to 55;
             j = i - 1;
             workDate = %Date(insToDt(j):*Usa);
             insFrDt(i) =
              %Dec(%Char(workDate + %Days(1):*Usa0):8:0);
             insToDt(i) =
              %Dec(%Char(workDate + %Days(7):*Usa0):8:0);
             If BSsefl = 'E';
                WriteARInst(insFrDt(i):insToDt(i):i);
             Endif;
             insDueDt(i) =
              %Dec(%Char(%Date(insToDt(i):*Usa) + %Days(intSrDays):*Usa0):8:0);
             insCount = j;
             If BSsefl = 'E' and %Date(insToDt(i):*Usa) >= datePolicyEnd
              or BSsefl = 'S' and %Date(insFrDt(i):*Usa) >= datePolicyEnd;
                insFrDt(i) = 0;
                insToDt(i) = 0;
                insDueDt(i) = 0;
                Leave;
             Endif;
          EndFor;
       Endif;
      /End-Free

     pGetInvoiceDates  e
      *--------------------------------------------------
      * Procedure name: WriteArInst
      * Purpose:        Write A/R Installments for AmWins installment
      *                  schedule page
      * Returns:
      * Parameter:      fromDate
      * Parameter:      toDate
      * Parameter:      index
      *--------------------------------------------------
     p WriteArInst     b
     d WriteArInst     pi
     d  frDateUsa                     8  0 Const
     d  toDateUsa                     8  0 Const
     d  index                         2  0 Const

     d frDateCymd      s              7  0
     d toDateCymd      s              7  0

      /Free
       frDateCymd = %Dec(%Char(%Date(frDateUsa:*Usa):*Cymd0):7:0);
       toDateCymd = %Dec(%Char(%Date(toDateUsa:*Usa):*Cymd0):7:0);
       If toDateCymd >= ELptdt;
          toDateCymd = *Hival;
       Endif;
       Setll (ELco#:ELfnd:ELfyr:ELemp#:frDateCymd) pea15;
       Dou %Eof;
          Reade (ELco#:ELfnd:ELfyr:ELemp#) pea15;
          If %Eof;
             Leave;
          Endif;
          If EApodt > toDateCymd;
             Leave;
          Endif;
          If (EActyp = 'P' or EActyp = 'E') and (EAarty = 'B' or EAarty = 'A');
             insAmount(index) += EAamt;
          Endif;
       Enddo;
      /End-Free

     p WriteArInst     e
