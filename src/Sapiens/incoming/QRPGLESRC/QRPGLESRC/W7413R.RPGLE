     c                   else
     c                   eval      horzLinePos = 2
     c                   endif
     c                   eval      hpos(a#) = horzLinePos
     c                   enddo
     c                   endif
      *
      * Remove slashes and insert parenthesis around L/C/F and insert at beginning of next line
      *
     c                   eval      pos# = %scan('L/C/F': x2name )
     c                   if        pos# > 0
     c                   eval      x2name = %subst(x2name : 1 : pos# - 1)
     c                   eval      xxemn3 = '(LCF) ' + xxemn3
     c                   else
