     C                             and rsjrst <> 'NJ'
     c                             and  xxpeon = 'Y'
     c
     C                             or NANAM4 = XXNAM4
     C                             and rsjrst = 'NJ'
     c                             and xxpeon = 'Y'
     C                             or xna100 = xxn100
     C                             and rsjrst = 'NJ'
     c                             and xxpeon <> 'Y'
    C*
     C                   Eval      xxchg = ' '
