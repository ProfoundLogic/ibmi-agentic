    C*
    C*====================================================================
    C* addEPOver - Add Override to WMEPP
    C*====================================================================
     C     addEPOver     begsr
     C*
     C* Determine if in Quote.
     C*
     C                   call      'CHKQUOTE'
     C                   parm      ' '           qcqte
     C*
     C* Determine if DataCenter Client
     C*
     C                   call      'SA030R'
     C                   parm      '   '         ##suffix
     C*
     C                   if        qcqte='Q'
     C*
     C                   eval      command=%trim(cmd2(1)) + 'PDSFIL' +
     C                             %trim(##suffix) + '/WMEPL1)'
     C                   eval      length=%len(%trim(command))
     C*
     C                   call      'QCMDEXC'                              60
     C                   parm                    command
     C                   parm                    length
     C*
     C                   endif
     C*
     C                   endsr
    C*====================================================================
    C* ClearSpaces - Remove any spaces from string
    C*====================================================================
     C     ClearSpaces   Begsr
     C*
     C                   CLEAR                   FORMB
     C                   CLEAR                   FORMA
     C                   MOVEA     xxForm        FORMB
     C                   Z-ADD     1             T
     C                   Z-ADD     1             U                 3 0
     C*
     C     T             DOWLE     15
     C*
     C     FORMB(T)      IFNE      ' '
     C                   MOVE      FORMB(T)      FORMA(U)
     C                   ADD       1             U
     C                   ENDIF
     C*
     C                   ADD       1             T
     C                   ENDDO
     C*
     C                   MOVEA     FORMA         xxForm
     C*
     C                   Endsr                                                  ClearSpaces subr
    C*====================================================================
    C* dltEPOver - Delete Override to WMEPP
    C*====================================================================
     C     dltEPOver     begsr
     C*
     C                   if        qcqte='Q'
     C*
     C                   eval      command=%trim(cmd2(2))
     C                   eval      length=%len(%trim(command))
     C*
     C                   call      'QCMDEXC'                              60
     C                   parm                    command
     C                   parm                    length
     C*
     C                   endif
     C*
     C                   endsr
    C*====================================================================
    C* CLT025CCS - Print Clt025 CCS forms.
    C*====================================================================
     C     clt025ccs     begsr
     C*
     C                   eval      xxtbid='PTYP'
     C                   eval      xxkey=elqtyp
     C     gtky          chain     pgt01
     C                   if        %found
     C*
     C                   do        4             cnt
     C                   select
     C                   when      cnt=1
     C                   eval      sort025(cnt)=gtfg02 + 'RCL025'
     C                   when      cnt=2
     C                   eval      sort025(cnt)=gtfg03 + 'CCS025'
     C                   when      cnt=3
     C                   eval      sort025(cnt)=gtfg04 + 'KEY025'
     C                   when      cnt=4
     C                   eval      sort025(cnt)=gtfg05 + 'RISK025'
     C                   endsl
     C                   enddo
     C*
     C                   sorta     sort025
     C*
     C                   do        4             cnt
     C*
     C                   eval      form025=%subst(sort025(cnt):2:10)
     C                   eval      order025=%subst(sort025(cnt):1:1)
     C*
     C                   if        order025<>*blanks
     C                   select
     c                   when      form025='RCL025' and
     c                             elnwrw <> 'N'
     c                   exsr      srRCL025
     c                   when      form025='CCS025'
     c                   exsr      srCCS025
     c                   when      form025='KEY025'
     c                   exsr      srKEY025
     c                   when      form025='RISK025'
     c                   exsr      srRISK025
     C                   endsl
     C                   endif
     C*
     C                   enddo
     C*
     C                   endif
     C*
     C                   endsr
    C*====================================================================
    C* getCCS1dta - Get the CCS1 letter data
    C*====================================================================
     C     getCCS1dta    begsr
    C*
     C                   z-add     elpfdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzpfdt            8
    C*
     C                   z-add     elptdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzptdt            8
     C*
     C                   move      zzpfdt        zzfyr
     C                   move      zzptdt        zztyr
     C*
     C                   eval      zzyears=zzfyr + '-' + %subst(zztyr:3:2)
     C*
     C                   eval      z1emp#=%trim(%editc(ememp#:'4'))
     C                   eval      z1semp=emsemp
     C*
     C                   movel(p)  emname        zzemnm
     C                   movel(p)  emname        z1emnm
     C                   movel(p)  emname        z2emnm
     C*
     C                   endsr
    C*====================================================================
    C* getCCS23dta - Get the CCS2 and CCS3 letter data - Aggregate + Full
    C*====================================================================
     C     getCCS23dta   begsr
    C*
     C                   z-add     elpfdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzpfdt            8
    C*
     C                   z-add     elptdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzptdt            8
     C*
     C                   move      zzpfdt        zzfyr
     C                   move      zzptdt        zztyr
     C*
     C                   eval      zzyears=zzfyr + '-' + %subst(zztyr:3:2)
     C                   eval      z1years=zzfyr + '-' + %subst(zztyr:3:2)
     C                   select
     C                   when      %subst(zzpfdt:1:2) = '01'
     C                   eval      month='January'
     C                   when      %subst(zzpfdt:1:2) = '02'
     C                   eval      month='February'
     C                   when      %subst(zzpfdt:1:2) = '03'
     C                   eval      month='March'
     C                   when      %subst(zzpfdt:1:2) = '04'
     C                   eval      month='April'
     C                   when      %subst(zzpfdt:1:2) = '05'
     C                   eval      month='May'
     C                   when      %subst(zzpfdt:1:2) = '06'
     C                   eval      month='June'
     C                   when      %subst(zzpfdt:1:2) = '07'
     C                   eval      month='July'
     C                   when      %subst(zzpfdt:1:2) = '08'
     C                   eval      month='August'
     C                   when      %subst(zzpfdt:1:2) = '09'
     C                   eval      month='September'
     C                   when      %subst(zzpfdt:1:2) = '10'
     C                   eval      month='October'
     C                   when      %subst(zzpfdt:1:2) = '11'
     C                   eval      month='November'
     C                   when      %subst(zzpfdt:1:2) = '12'
     C                   eval      month='December'
     C                   endsl
     C*
     C                   select
     C                   when      %subst(zzptdt:1:2) = '01'
     C                   eval      toMonth='January'
     C                   when      %subst(zzptdt:1:2) = '02'
     C                   eval      toMonth='February'
     C                   when      %subst(zzptdt:1:2) = '03'
     C                   eval      toMonth='March'
     C                   when      %subst(zzptdt:1:2) = '04'
     C                   eval      toMonth='April'
     C                   when      %subst(zzptdt:1:2) = '05'
     C                   eval      toMonth='May'
     C                   when      %subst(zzptdt:1:2) = '06'
     C                   eval      toMonth='June'
     C                   when      %subst(zzptdt:1:2) = '07'
     C                   eval      toMonth='July'
     C                   when      %subst(zzptdt:1:2) = '08'
     C                   eval      toMonth='August'
     C                   when      %subst(zzptdt:1:2) = '09'
     C                   eval      toMonth='September'
     C                   when      %subst(zzptdt:1:2) = '10'
     C                   eval      toMonth='October'
     C                   when      %subst(zzptdt:1:2) = '11'
     C                   eval      toMonth='November'
     C                   when      %subst(zzptdt:1:2) = '12'
     C                   eval      toMonth='December'
     C                   endsl
     C*
     C                   move      elpfdt        day               2 0
     C                   move      elptdt        toDay             2 0
     C*
     C                   select
     C                   when      day=1 or day=21 or day=31
     C                   move      'st'          ordinal           2
     C                   when      day=2 or day=22
     C                   move      'nd'          ordinal
     C                   when      day=3 or day=23
     C                   move      'rd'          ordinal
     C                   other
     C                   move      'th'          ordinal
     C                   endsl
     C*
     C                   eval      zzper='12:01 a.m. ' + %trim(month) + ' '
     C                             + %trim(%editc(day:'4')) + ', ' + zzfyr +
     C                             ' through 12:01 a.m. ' + %trim(toMonth) +
     C                             ' ' + %trim(%editc(toDay:'4')) + ', ' + zztyr
     C*
     C                   eval      z2date=%trim(month) + ' ' +
     C                             %trim(%editc(day:'4')) + ordinal + ','
     C*
     C                   eval      z3date=%trim(month) + ' ' +
     C                             %trim(%editc(day:'4')) + ', ' +
     C                             zzfyr
    C*
     C                   eval      elpfdt=elpfdt-10000
     C                   z-add     elpfdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzpfdt            8
     C                   eval      elpfdt=elpfdt+10000
    C*
     C                   eval      elptdt=elptdt-10000
     C                   z-add     elptdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzptdt            8
     C                   eval      elptdt=elptdt+10000
     C*
     C                   move      zzpfdt        zzfyr2            4
     C                   move      zzptdt        zztyr2            4
     C*
     C                   eval      zzcyears=zzfyr2 + '-' + %subst(zztyr2:3:2)
     C*
     C                   eval      z1emp#=%trim(%editc(ememp#:'4'))
     C                   eval      z1semp=emsemp
     C*
     C                   movel(p)  emname        zzemnm
     C                   movel(p)  emname        z1emnm
     C                   movel(p)  emname        z2emnm
     C                   movel(p)  emname        z4emnm
     C*
     C                   clear                   classCod
     C                   clear                   classDsc
     C                   clear                   classAmtA
     C                   clear                   classAmtN
     C                   clear                   classRat
     C                   clear                   zztamt
     C                   eval      currentYear=*on
     C                   eval      liveYear=*off
     C*
     C                   z-add     0             zntamt            9 0
     C                   exsr      addEPOver
     C                   open      wmepl1
     C                   eval      xxfyr=xxfyr-1
     C     epky3         chain     pep02                              99
     C                   if        *in99
     C                   exsr      dltEPOver
     C                   close     wmepl1
     C                   open      wmepl1
     C                   eval      xxfyr=xxfyr+1
     C     epky3         chain     pep02                              99
     C                   eval      currentYear=*off
     C                   else
     C                   eval      liveYear=*on
     C                   endif
     C*
     C                   dow       not *in99
     C                   if        epstat<>'I'
     C*
     C     prky5         setgt     ppr01
     C     prky4         readpe    ppr01
     C*
     C                   if        epext<>*blanks
     C                   clear                   ##st
     C     PXKY          setgt     PPX01
     C     PXKY1         readpe    PPX01                                  99
     C                   if        *in99 = *on
     C                   move      xxst          ##st
     C     PXKY          setgt     PPX01
     C     PXKY1         readpe    PPX01                                  99
     C                   if        *in99 = *off
     C                   eval      prdesc = pxdesc
     C                   endif
     C                   else
     C                   eval      prdesc = pxdesc
     C                   endif
     C                   endif
     C*
     C                   if        currentYear
     C                   z-add     epeapr        zzeapr            9 0
     C                   endif
     C*
     C*** begin del ***  08/14/24  *********************************************
     C*********          move      elpfdt        strpdt
     C*** end del *****  08/14/24  *********************************************
     c                   if        (f1netr = 'Y') and
     c                             (strpdt >= f1netd)
     c                   eval      zzrt = epentr/100
     c                   else
     c                   eval      zzrt = eparat/100
     c                   endif
     C*
     C                   eval      cnt2=%lookup(prclas:classCod)
     C                   if        cnt2=0
     C                   eval      cnt2=%lookup(*zeros:classCod)
     C                   if        cnt2=0
     C                   leave
     C                   endif
     C                   endif
     C*
     C                   eval      classCod(cnt2)=epclas
     C                   movel(p)  prdesc        desc20
     C                   eval      classDsc(cnt2)=
     C                             %trim(%editc(epclas:'4')) + '-' +
     C                             desc20
     C*
     C                   if        currentYear
     C                   eval      classAmtN(cnt2)=classAmtN(cnt2)+epeapr
     C                   eval      zntamt=zntamt+zzeapr
     C                   endif
     C*
     C                   eval      classRat(cnt2)=
     C                             %trim(%editw(zzrt:'0 .      '))
     C*
     C                   endif
     C     epky3         reade     pep02                                  99
     C                   enddo
     c*
     C                   if        liveYear
     C                   exsr      dltEPOver
     C                   endif
     C*
     C                   close     wmepl1
     C*
     C* Get rates
     C*
     C                   if        currentYear
     C                   open      wmepl1
     C                   eval      xxfyr=xxfyr+1
     C     epky3         chain     pep02                              99
     C                   dow       not *in99
     C                   if        epstat<>'I'
     C*
     C*** begin del ***  08/14/24  *********************************************
     C*********          move      elpfdt        strpdt
     C*** end del *****  08/14/24  *********************************************
     c                   if        (f1netr = 'Y') and
     c                             (strpdt >= f1netd)
     c                   eval      zzrt = epentr/100
     c                   else
     c                   eval      zzrt = eparat/100
     c                   endif
     C*
     C                   eval      cnt2=%lookup(epclas:classCod)
     C                   if        cnt2<>0
     C                   eval      classRat(cnt2)=
     C                             %trim(%editw(zzrt:'0 .      '))
     C                   endif
     C*
     C                   endif
     C     epky3         reade     pep02                                  99
     C                   enddo
     C                   close     wmepl1
     C                   endif
     C*
     C                   if        currentYear
     C     1             do        7             cnt2
     C                   if        classDsc(cnt2)<>*blanks
     C                   evalr     classAmtA(cnt2)=
     C                             %trim(%editc(classAmtN(cnt2):'N':*cursym))
     C                   endif
     C                   enddo
     C*
     C                   if        not currentYear
     C                   eval      xxfyr=xxfyr+1
     C                   endif
     C*
     C                   if        classDsc(1)<>*blanks
     C                   evalr     zztamt=%trim(%editc(zntamt:'N':*cursym))
     C                   endif
     C                   endif
     C*
     C                   eval      z1lirt=%trim(%editw(ldlirt:'0.         '))
     C*
     C                   endsr
    C*====================================================================
    C* getKEYdta - Get the Key Contact Data
    C*====================================================================
     C     getKEYdta     begsr
    C*
     C                   movel(p)  emname        zzemnm
     C*
     C                   movea     '000000000000'*in(01)
     C                   seton                                        4148
     C                   eval      heading=*off
     C                   eval      cnt3=1
     C                   clear                   hdg1
     C                   clear                   hdg2
     C                   clear                   shdg1
     C                   clear                   shdg2
     C                   clear                   nameTitle
     C                   clear                   extension
     C*
     C     chky          chain     pch01                              99
     C                   dow       not *in99
     C                   eval      heading=*on
     C     s2ky          chain     ps201                              99
     C                   if        not *in99
     C                   dow       not *in99
     C                   if        heading
     C                   movel(p)  chhdg1        hdg1(cnt3)
     C                   movel(p)  chhdg2        hdg2(cnt3)
     C                   movel(p)  s2hdg1        shdg1(cnt3)
     C                   movel(p)  s2hdg2        shdg2(cnt3)
     C                   eval      heading=*off
     C                   else
     C                   movel(p)  s2hdg1        shdg1(cnt3)
     C                   movel(p)  s2hdg2        shdg2(cnt3)
     C                   endif
     C*
     C                   eval      kkfnd=emfnd
     C     cnky          chain     pcn02
     C                   if        not %found
     C                   eval      kkfnd=0
     C     cnky          chain     pcn02
     C                   if        %found
     C                   if        cntitl=*blanks
     C                   evalr     nameTitle(cnt3)=%trim(cnname)
     C                   else
     C                   evalr     nameTitle(cnt3)=%trim(cnname) + ', ' +
     C                             %trim(cntitl)
     C                   endif
     C                   if        cnext#<>*zeros
     C                   evalr     extension(cnt3)= 'extension: ' +
     C                             %trim(%editc(cnext#:'4'))
     C                   endif
     C                   else
     C                   evalr     nameTitle(cnt3)=' '
     C                   evalr     extension(cnt3)=' '
     C                   endif
     C                   else
     C                   if        cntitl=*blanks
     C                   evalr     nameTitle(cnt3)=%trim(cnname)
     C                   else
     C                   evalr     nameTitle(cnt3)=%trim(cnname) + ', ' +
     C                             %trim(cntitl)
     C                   endif
     C                   if        cnext#<>*zeros
     C                   evalr     extension(cnt3)= 'extension: ' +
     C                             %trim(%editc(cnext#:'4'))
     C                   endif
     C                   endif
     C*
     C                   eval      cnt3=cnt3+1
     C                   if        cnt3>14
     C                   leave
     C                   endif
     C*
     C     s2ky          reade     ps201                                  99
     C                   enddo
     C*
     C                   else
     C                   movel(p)  chhdg1        hdg1(cnt3)
     C                   movel(p)  chhdg2        hdg2(cnt3)
     C                   eval      cnt3=cnt3+1
     C*
     C                   if        cnt3>14
     C                   leave
     C                   endif
     C                   endif
     C*
     C                   if        cnt3>14
     C                   leave
     C                   endif
     C*
     C     chky          reade     pch01                                  99
     C                   enddo
     C*
     C*  Determine if Heading or sub-heading prints
     C*
     C                   if        zzhead1a=*blanks and zzhead1b=*blanks
     C                   seton                                        01
     C                   endif
     C*
     C                   if        zzhead2a=*blanks and zzhead2b=*blanks
     C                   seton                                        02
     C                   endif
     C*
     C                   if        zzhead3a=*blanks and zzhead3b=*blanks
     C                   seton                                        03
     C                   endif
     C*
     C                   if        zzhead4a=*blanks and zzhead4b=*blanks
     C                   seton                                        04
     C                   endif
     C*
     C                   if        zzhead5a=*blanks and zzhead5b=*blanks
     C                   seton                                        05
     C                   endif
     C*
     C                   if        zzhead6a=*blanks and zzhead6b=*blanks
     C                   seton                                        06
     C                   endif
     C*
     C                   if        zzhead7a=*blanks and zzhead7b=*blanks
     C                   seton                                        07
     C                   endif
     C*
     C                   if        zzhead8a=*blanks and zzhead8b=*blanks
     C                   seton                                        08
     C                   endif
     C*
     C                   if        zzhead9a=*blanks and zzhead9b=*blanks
     C                   seton                                        09
     C                   endif
     C*
     C                   if        zzhead10a=*blanks and zzhead10b=*blanks
     C                   seton                                        10
     C                   endif
     C*
     C                   if        zzhead11a=*blanks and zzhead11b=*blanks
     C                   seton                                        11
     C                   endif
     C*
     C                   if        zzhead12a=*blanks and zzhead12b=*blanks
     C                   seton                                        12
     C                   endif
     C*
     C                   if        zzhead13a=*blanks and zzhead13b=*blanks
     C                   seton                                        41
     C                   endif
     C*
     C                   if        zzhead14a=*blanks and zzhead14b=*blanks
     C                   seton                                        48
     C                   endif
     C*
     C                   endsr
    C*====================================================================
    C* getRISKdta - Get Concentration of Risk Data
    C*====================================================================
     C     getRISKdta    begsr
    C*
     C*
     C                   endsr
    C*====================================================================
    C* getRCLdta - Get the Renewal Letter Data
    C*====================================================================
     C     getRCLdta     begsr
    C*
     C                   z-add     elpfdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzpfdt            8
    C*
     C                   z-add     elptdt        srdti
     C                   call      'SRCVTDAT'    dtmdy8
     C                   movel     srdto         zzptdt            8
     C*
     C                   move      zzpfdt        zzfyr
     C                   move      zzptdt        zztyr
     C*
     C                   eval      zzyears=zzfyr + '-' + %subst(zztyr:3:2)
     C                   eval      z1years=zzfyr + '-' + %subst(zztyr:3:2)
    C*
     C                   time                    dsdttm
     C                   eval      srdti = dsdate
     C                   call      'SRCVTDAT'    dtmdy2
     C                   movel     srdto         xxdate
     C                   eval      zzdate=%editc(xxdate:'Y')
     C*
     C                   movel(p)  emname        zzemnm
     C                   movel(p)  emname        z1emnm
     C                   movel(p)  emname        z2emnm
     C                   movel(p)  emname        z3emnm
     C*
     C                   movel(p)  emmad1        zzadr1
     C                   eval      zzadr2=%trim(emmcty) + ', ' + %trim(emmst) +
     C                             ' ' + %editw(emmzip:'0     -    ')
     C*
     C     ecky2         chain     pec02
     C                   if        %found
     C                   if        ecmid<>' '
     C                   eval      zzname=%trim(ectitl) + ' ' + %trim(ecfsn)
     C                             + ' ' + ecmid + '. ' + %trim(eclsn)
     C                   eval      z1name=%trim(ectitl) + ' ' + %trim(ecfsn)
     C                             + ' ' + ecmid + '. ' + %trim(eclsn) + ':'
     C                   else
     C                   eval      zzname=%trim(ectitl) + ' ' + %trim(ecfsn)
     C                             + ' ' + %trim(eclsn)
     C                   eval      z1name=%trim(ectitl) + ' ' + %trim(ecfsn)
     C                             + ' ' + %trim(eclsn) + ':'
     C                   endif
     C                   else
     C                   clear                   zzname
     C                   clear                   z1name
     C                   endif
     C*
     C                   eval      zzname=%trim(zzname)
     C                   eval      z1name=%trim(z1name)
     C*
      /Free
       Clear agt#;
       Clear agt_name;
      /End-free
     C*
     c                   callp     getAgtInfo( emco#    :
     c                                         emfnd    :
     c                                         ememp#   :
     c                                         emdiv    :
     c                                         elfyr    :
     c                                         agt#     :
     c                                         agt_name :
     c                                         prod     :
     c                                         prod_nm  :
     c                                         area_cd  :
     c                                         phone#   :
     c                                         plan     :
     c                                         asOfDate )
     c*
     C                   eval      zzagnm=agt_name
     C*
     C                   endsr
    C*====================================================================
    C* srCCS025 - Print CCS form
    C*====================================================================
     C     srCCS025      begsr
    C*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   if        f1clms='Y'
     C                   exsr      getccs1dta
     C                   write     ccs1025a
     C                   write     newpage025
     C                   write     ccs1025b
     C                   write     newpage025
     C                   write     ccs1025c
     C                   write     newpage025
     C                   write     ccs1025d
     C                   write     newpage025
     C                   else
     C                   if        aggregate(elco#:elfnd:elemp#:eldiv:elfyr)
     C                   exsr      getccs23dta
     C                   write     ccs2025a
     C                   write     newpage025
     C                   write     ccs2025b
     C                   write     newpage025
     C                   else
     C                   exsr      getccs23dta
     C                   write     ccs3025a
     C                   write     newpage025
     C                   write     ccs3025b
     C                   write     newpage025
     C                   endif
     C                   endif
     C*
     C                   endsr
       //====================================================================
       // Create WMMUP2 Records for MT 25-2 Endorsement Form
       //====================================================================
       Begsr srCrtWmmup2;
          Chain (SHco#:SHfnd:SHfyr:SHemp#:'WC000000C':0) pmu01;
          If %Found(WMMUL5);

             // Write record for form WC000000C
             M2Co# = SHco#;
             M2fnd = SHfnd;
             M2Fyr = SHfyr;
             M2Emp# = SHemp#;
             intSeq# = intSeq# + 1;
             M2seq# = intSeq#;
             M2form = 'WC000000C';
             M2desc = 'Workers Compensation and Employers Liability +
              Insurance Policy';
             M2imprt = 'Y';
             M2ipgm = Q1pgm;
             M2iusr = Q1user;
             M2itim = TimeTo6(SystemTime);
             M2idt  = sysDt7;
             M2pgm  = Q1pgm;
             M2user = Q1user;
             M2time = TimeTo6(SystemTime);
             M2dt   = sysDt7;
             Write pmup2;

          Endif;

          // Write record for Dec Page
          M2Co# = SHco#;
          M2fnd = SHfnd;
          M2Fyr = SHfyr;
          M2Emp# = SHemp#;
          intSeq# = intSeq# + 1;
          M2seq# = intSeq#;
          M2form = %Trim(xxDecForm2);
          If *in75 = *On;
             M2form = %Trim(xx4001);
          Endif;
          If declareForm <> *Blanks;
             M2form = %Trim(declareForm);
          Endif;
          M2desc = 'Information Page';
          If declareDesc <> *blanks;
             M2desc = declareDesc;
          Endif;

          M2imprt = 'Y';
          M2ipgm = Q1pgm;
          M2iusr = Q1user;
          M2itim = TimeTo6(SystemTime);
          M2idt  = sysDt7;
          M2pgm  = Q1pgm;
          M2user = Q1user;
          M2time = TimeTo6(SystemTime);
          M2dt   = sysDt7;
          Write pmup2;

          // Write record potentially for Additional Named Insured Schedule
          If xxAnam = 'Y';
             M2Co# = SHco#;
             M2fnd = SHfnd;
             M2Fyr = SHfyr;
             M2Emp# = SHemp#;
             intSeq# = intSeq# + 1;
             M2seq# = intSeq#;
             M2form = %Trim(xxDecForm2);
             If *in75 = *On;
                M2form = 'WC040002';
             Endif;
             If addNameForm <> *Blanks;
                M2form = %Trim(addNameForm);
             Endif;
             M2desc = 'Schedule of Named Insured';
             If addNameDesc <> *blanks;
                M2desc = addNameDesc;
             Endif;

             M2imprt = 'Y';
             M2ipgm = Q1pgm;
             M2iusr = Q1user;
             M2itim = TimeTo6(SystemTime);
             M2idt  = sysDt7;
             M2pgm  = Q1pgm;
             M2user = Q1user;
             M2time = TimeTo6(SystemTime);
             M2dt   = sysDt7;
             Write pmup2;
          Endif;

          // Write record potentially for Additional Location Schedule
          If xxAloc = 'Y';
             M2Co# = SHco#;
             M2fnd = SHfnd;
             M2Fyr = SHfyr;
             M2Emp# = SHemp#;
             intSeq# = intSeq# + 1;
             M2seq# = intSeq#;
             M2form = %Trim(xxDecForm2);
             If *in75 = *On;
                M2form = 'WC040003';
             Endif;
             If addLocForm <> *Blanks;
                M2form = %Trim(addLocForm);
             Endif;
             M2desc = 'Schedule of Workplaces';
             If addLocDesc <> *blanks;
                M2desc = addLocDesc;
             Endif;

             M2imprt = 'Y';
             M2ipgm = Q1pgm;
             M2iusr = Q1user;
             M2itim = TimeTo6(SystemTime);
             M2idt  = sysDt7;
             M2pgm  = Q1pgm;
             M2user = Q1user;
             M2time = TimeTo6(SystemTime);
             M2dt   = sysDt7;
             Write pmup2;
          Endif;

          // Write record for Premium Schedule
          M2Co# = SHco#;
          M2fnd = SHfnd;
          M2Fyr = SHfyr;
          M2Emp# = SHemp#;
          intSeq# = intSeq# + 1;
          M2seq# = intSeq#;
          M2form = %Trim(xxDecForm2);
          If *in75 = *On;
             M2form = %Trim('WC040005');
          Endif;
          If premiumForm <> *Blanks;
             M2form = %Trim(premiumForm);
          Endif;
          M2desc = 'Schedule of Premium';
          If premiumDesc <> *blanks;
             M2desc = premiumDesc;
          Endif;

          M2imprt = 'Y';
          M2ipgm = Q1pgm;
          M2iusr = Q1user;
          M2itim = TimeTo6(SystemTime);
          M2idt  = sysDt7;
          M2pgm  = Q1pgm;
          M2user = Q1user;
          M2time = TimeTo6(SystemTime);
          M2dt   = sysDt7;
          Write pmup2;

          // Write record potentially for Endorsements Schedule
          If *in95 = *On Or *in75 = *On Or xxListSchd = 'Y';
             M2Co# = SHco#;
             M2fnd = SHfnd;
             M2Fyr = SHfyr;
             M2Emp# = SHemp#;
             intSeq# = intSeq# + 1;
             M2seq# = intSeq#;
             M2form = %Trim(xxDecForm2);
             If *in75 = *On;
                M2form = 'WC040004';
             Endif;
             If endorseForm <> *Blanks;
                M2form = %Trim(endorseForm);
             Endif;
             M2desc = 'Schedule of Endorsements';
             If endorseDesc <> *blanks;
                M2desc = endorseDesc;
             Endif;

             M2imprt = 'Y';
             M2ipgm = Q1pgm;
             M2iusr = Q1user;
             M2itim = TimeTo6(SystemTime);
             M2idt  = sysDt7;
             M2pgm  = Q1pgm;
             M2user = Q1user;
             M2time = TimeTo6(SystemTime);
             M2dt   = sysDt7;
             Write pmup2;
          Endif;

          // Write record potentially for Installments Schedule
          If isPrtInstSched  = *On;
             M2Co# = SHco#;
             M2fnd = SHfnd;
             M2Fyr = SHfyr;
             M2Emp# = SHemp#;
             intSeq# = intSeq# + 1;
             M2seq# = intSeq#;
             M2form = %Trim(xxDecForm2);
             If instSchdForm <> *Blanks;
                M2form = %Trim(instSchdForm);
             Endif;
             M2desc = 'Schedule of Installments';
             If instSchdDesc <> *blanks;
                M2desc = instSchdDesc;
             Endif;

             M2imprt = 'Y';
             M2ipgm = Q1pgm;
             M2iusr = Q1user;
             M2itim = TimeTo6(SystemTime);
             M2idt  = sysDt7;
             M2pgm  = Q1pgm;
             M2user = Q1user;
             M2time = TimeTo6(SystemTime);
             M2dt   = sysDt7;
             Write pmup2;
          Endif;
       Endsr;
    C*====================================================================
    C* srKEY025 - Print Key Contacts Form
    C*====================================================================
     C     srKEY025      begsr
    C*
     C                   exsr      getkeydta
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   write     key025
     C                   write     newpage025
     C*
     C                   endsr
    C*====================================================================
    C* srRISK025 - Print Concentration of Risk Form
    C*====================================================================
     C     srRISK025     begsr
    C*
     C                   exsr      getriskdta
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   write     risk025
     C                   write     newpage025
     C*
     C                   endsr
    C*====================================================================
    C* srRCL025 - Print Renewal Letter Form
    C*====================================================================
     C     srRCL025      begsr
    C*
     C                   exsr      getrcldta
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   write     rcl025
     C                   write     newpage025
     C*
     C                   endsr
    C*====================================================================
    C* CRTLAL - Create long (100) name {XXN100} from ALNAME & ALFDNM
    C*====================================================================
     C     crtlal        begsr
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     ALFDNM        XXNM01
     C                   MOVEL     ALFDN2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      ALFDN2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXF100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     alfdnm        xxf100
     C                   move      alfdn2        xxf100
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     ALNAME        XXNM01
     C                   MOVEL     ALNAM2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      ALNAM2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXN100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     alname        xxn100
     C                   move      alnam2        xxn100
    C*
     C                   endsr
    C*
    C*====================================================================
    C* CRTLEM - Create long (100) name {XXN100} from EMNAME & EMNAM2
    C*====================================================================
     C     crtlem        begsr
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     EMNAME        XXNM01
     C                   MOVEL     EMNAM2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      EMNAM2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXN100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     emname        xxn100
     C                   move      emnam2        xxn100
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     EMFDNM        XXNM01
     C                   MOVEL     EMFDN2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      EMFDN2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXF100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     emfdnm        xxf100
     C                   move      emfdn2        xxf100
    C*
     C                   endsr
    C*
    C*====================================================================
    C* CRTLNA - Create long (100) name {XNA100} from NANAME & NANAM3
    C*====================================================================
     C     crtlna        begsr
    C*
     C                   MOVE      *BLANKS       XNA100
     C                   clear                   c
     C                   move      naname        xx1a
     C                   if        xx1a = *blank
     C                   eval      c = 1
     C                   endif
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     naname        xna100
     C                   move      nanam3        xna100
    C*
     C                   endsr
    C*
    C*====================================================================
    C* DBA - Concatinate the Federal Name + 'DBA' + DBA Name
    C*====================================================================
     C     dba           begsr
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     EMFDNM        XXNM01
     C                   MOVEL     EMFDN2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      EMFDN2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXF100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     emfdnm        xxf100
     C                   move      emfdn2        xxf100
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     EMNAME        XXNM01
     C                   MOVEL     EMNAM2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      EMNAM2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXN100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     emname        xxn100
     C                   move      emnam2        xxn100
    C*
     C     ' '           checkr    xxf100        len100
    C*
     C*
     C                   EXSR      SRPEON
    C*
     C                   clear                   emfdnm
     C                   clear                   emfdn2
    C*
     C                   endsr
    C*
    C*====================================================================
    C* DBAA - ConcatEnate the Federal Name + 'DBA' + DBA Name
    C*====================================================================
     C     dbaa          begsr
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     ALFDNM        XXNM01
     C                   MOVEL     ALFDN2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      ALFDN2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXF100
     C     XXNM01        CAT       XXNM02:1      XXF100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     alfdnm        xxf100
     C                   move      alfdn2        xxf100
    C*
     C                   MOVE      *BLANKS       XXNM01           50
     C                   MOVE      *BLANKS       XXNM02           50
     C                   MOVE      *BLANKS       XXNM10           10
     C                   MOVEL     ALNAME        XXNM01
     C                   MOVEL     ALNAM2        XXNM10
     C                   MOVE      XXNM10        XXNM01
     C                   MOVE      ALNAM2        XXNM02
     C*
     C                   MOVE      *BLANKS       XXN100
     c*
     c* Move name field over with no manipulation for Transform.
     c*
     C                   movel     alname        xxn100
     C                   move      alnam2        xxn100
    C*
    C*
     C*
     C                   EXSR      SRPEON
    C*
     C                   clear                   alfdnm
     C                   clear                   alfdn2
    C*
     C                   endsr
    C*
    C*====================================================================
    C* Process the CA schedule with the correct starting line for DTM
    C*====================================================================
     C     dtmsch        begsr
    C*
     C                   If        isuseSpoolOut
     C                   if        cltid<>'025'
     C                   if        dtm = 'Y' and qqdart = 'Y'
     C                   except    dtms
     C                   else
     C                   except    nodtms
     C                   endif
     C                   endif
    C*
     C                   Endif
     C                   endsr
    C*
    C*====================================================================
    C* Process the PA schedule with the correct starting line for DTM
    C*====================================================================
     C     dtmschp       begsr
    C*
     C                   If        isuseSpoolOut
     C                   if        dtm = 'Y' and qqdart = 'Y'
     C                   except    dtmsp
     C                   else
     C                   except    nodtmsp
     C                   endif
    C*
     C                   Endif
     C                   endsr
    C*
    C*====================================================================
    C* Print Item 4 Page
    C*====================================================================
     C     PrtItem4Pg    begsr
     C*
     C                   if        *in84 = *on
     C                   if        xnempr < 0
     C                   eval      xnemsn = '-'
     C                   else
     C                   eval      xnemsn = ' '
     C                   endif
     C                   else
     C                   if        epempr < 0
     C                   eval      xnemsn = '-'
     C                   else
     C                   eval      xnemsn = ' '
     C                   endif
     C                   endif
      * Don't print first digit if Logging class
     C                   eval      x3clas = epclas
     C                   eval      x3TDF = EPtdf
     C                   move      epclas        x3clas#           4
     C                   If         cltID = '102'
     C     PRLOGF        IFEQ      'Y'
     C                   CALL      'SRLOGCLAS'
     C                   PARM                    EPCLAS
     C                   PARM      *OFF          QQFOUND
     C                   PARM      *ZEROS        QQMPAYR
     C                   PARM      *ZEROS        QQMRATE
     C                   PARM      *ZEROS        QQRPTCLS
     C     QQFOUND       IFEQ      *ON
     C                   EVAL      x3clas = QQRPTCLS
     C                   endif
     C                   endif                                                  epclas = 12702
     C                   endif                                                  cltID = 102
     C*
     C                   Exsr      ScriptPremDtl
     C                   select
     C                   when      cltid='025'
     C                   when      cltID = '139' and not *in94
     C* Don't print summary page for client 139
     C                   when      printer1 = 'W7413O1FL'
     C                   exsr      WriteItem4FL
     C                   when      printer1 = 'W7413O1'
     C                   exsr      WriteItem4
     C                   when      item4Type = 1
     C                   movel     epdesc        x@desc           25
     C                   If        isuseSpoolOut
     C                   except    payrdt
     C                   Endif
     C                   eval      xxline = xxline + 2
     C                   when      item4Type = 3
     C                   If        isuseSpoolOut
     C                   except    prmdet
     C                   Endif
     C                   when      item4Type = 4
     C                   If        isuseSpoolOut
     C                   except    prmexp
     C                   Endif
     C                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* Print special endorsments for CLT139
    C*====================================================================
     C     Prt139End     begsr
    C*
     C                   eval      MUFORM = *blanks
     C                   eval      MUDESC = *blanks
     C                   eval      endEdition = *blanks
    C*
     C                   select
     C                   when      printer1 = 'W7413O1FL'
     C                   exsr      writeItem3DFL
     C                   when      printer1 = 'W7413O1'
     C                   exsr      writeItem3D
     C                   endsl
    C*
     c                   if        ullico <> 'Y'
     C                   eval      MUFORM = 'GIC Privacy Not'
     C                   eval      MUDESC = 'GIC Privacy Notice'
     C                   eval      endEdition = '(01/03)'
     c                   endif
    C*
     C                   select
     C                   when      printer1 = 'W7413O1FL'
     C                   exsr      writeItem3DFL
     C                   when      printer1 = 'W7413O1'
     C                   exsr      writeItem3D
     C                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C*====================================================================
     C     srleap        begsr
    C*
    C*  IF FEB 29 IS A VALID DATE AND IS IN THE RANGE, SUBTRACT ONE DAY
    C*
     C                   eval      xxlpdt = 0
    C*
     C                   eval      x1From = DtCYMD(xqFrom)
     C                   eval      x1To   = DtCYMD(xqTo)
    C*
     C                   eval      xxlpdt = x1from
     C                   move      '0229'        xxlpdt
    C*
     C                   if        xxlpdt < x1from
     C                   eval      xxlpdt = x1to
     C                   move      '0229'        xxlpdt
     C                   endif
    C*
     C                   if        xxlpdt < x1from
     C                             or xxlpdt > x1to
     C                   eval      xxlpdt = *zero
     C                   endif
    C*
     C                   if        xxlpdt <> *zero
    C*
     C                   eval      xqFrom = DtMDYY(xxLpDt)
    C*
     C                   clear                   srerr
    C*
     C                   eval      srdti = xqfrom
     C                   call      'SRCVTDAT'    datchk
     C                   movel     srdto         xqfrom
    C*
     C                   if        srerr <> '1'
     C                             and xxlpdt <> x1from
     C                   eval      qqdays = qqdays - 1
     C                   else
     C                   eval      xxlpdt = 0
     C                   endif
    C*
     C                   endif
    C*
     C                   endsr
     *
     *===============================================================
     * SRTRAK - Update New Business Tracking and Renewal Tracking
     *===============================================================
     C     srtrak        begsr
      *
      * Renewal Tracking installed (WCFL26 = 'Y')
      *
     c                   movel     'WC'          xxsyk
     c     syky          chain     swc01
     c                   if        %found and WCFL26 = 'Y'
     c                   else
     c                   leavesr
     c                   endif
      *
      * New business (*in25 = *off)
      *
     c                   if        *in25 = *off
     c     nbky          chain     pnb01
     c                   if        not(%found)
     c                   eval      NBCO#  = ELCO#
     c                   eval      NBFND  = ELFND
     c                   eval      NBEMP# = ELEMP#
     c                   eval      NBUSER = q1user
     c                   eval      NBIUSR = q1user
     c                   eval      NBPGM  = q1pgm
     c                   eval      NBIPGM = q1pgm
     c                   eval      NBDT   = sysDt7
     c                   eval      NBTIME = TimeTo6(SystemTime)
     c                   eval      NBIDT  = NBDT
     c                   eval      NBITM  = NBTIME
     c                   eval      NBPGDT = NBDT
     c                   write     pnb01
     c                   else
     c                   if        NBPGDT = 0
     c                   eval      NBUSER = q1user
     c                   eval      NBPGM  = q1pgm
     c                   eval      NBDT   = sysDt7
     c                   eval      NBTIME = TimeTo6(SystemTime)
     c                   eval      NBPGDT = NBDT
     c                   update    pnb01
     c                   endif                                                  NBPGDT=0
     c                   endif                                                  not(%found)
     c                   else                                                   *in25
     c     rtky          chain     prt01
     c                   if        not(%found)
     c                   eval      RTCO#  = ELCO#
     c                   eval      RTFND  = ELFND
     c                   eval      RTEMP# = ELEMP#
     c                   eval      RTFYR  = ELFYR
     c                   eval      RTUSER = q1user
     c                   eval      RTIUSR = q1user
     c                   eval      RTPGM  = q1pgm
     c                   eval      RTIPGM = q1pgm
     c                   eval      RTDT   = sysDt7
     c                   eval      RTTIME = TimeTo6(SystemTime)
     c                   eval      RTIDT  = RTDT
     c                   eval      RTITM  = RTTIME
     c                   eval      RTPGDT = RTDT
     c                   write     prt01
     c                   else
     c                   if        RTPGDT = 0
     c                   eval      RTUSER = q1user
     c                   eval      RTPGM  = q1pgm
     c                   eval      RTDT   = sysDt7
     c                   eval      RTTIME = TimeTo6(SystemTime)
     c                   eval      RTPGDT = RTDT
     c                   update    prt01
     c                   endif                                                  RTPGDT=0
     c                   endif                                                  not(%found)
     c                   endif                                                  *in25
    
     C                   endsr
    C*====================================================================
    C*  PRINT STATE SUMMARY PAGES
    C*====================================================================
     C     stpage        begsr
    C*
    C*  STORE VALUES FOR LATER REPLACEMENT/USE
    C*
     C                   move      *in91         svin91
     C                   move      *in92         svin92
     C                   move      *in93         svin93
     C                   move      xxexm1        svexm1
     C                   move      xxexm2        svexm2
     C                   move      xxexm3        svexm3
     C                   move      xxemd1        svemd1
     C                   move      xxemd2        svemd2
     C                   move      xxemd3        svemd3
    C*
     C                   move      *on           *in94
     C     1             do        52            d1                2 0
     C                   if        arrst(d1) = '99'
     C                   leave
     C                   endif                                                  arrst(d1) = '99'
     C                   move      arrst(d1)     xxst
     C*** Find matching state in sttots
     C     1             do        52            d
     C     d             occur     sttots
    C*
     C                   if        tast = *blanks
     C                   iter
     C                   endif
    C*
     c                   if        (tast = xxst)
     c                   leave
     c                   endif                                                  TAST IFEQ
    C*
     C                   enddo                                                  1 - 52 on sttots
     C*
     C                   eval      item4Line# = 0
     C                   Eval      xxLastItem = *off
    C*
     C                   move      tast          xxpst
     C                   eval      xxelcd = 0
     C                   move      tast          xxst
     C                   eval      xxdiv = xsdiv
     C     elky          chain     pel01                              60
     C                   eval      xxefdt = elpfdt
    C*
     C     rrky          setgt     prr01
     C     rrky2         readpe    prr01                                  60
     C                   Move      *off          monoState
     C*
     C* Set title for additional load for monopolistic states
     C*
     C                   If        RRMono = 'Y'
     C*
     C                   Select
     C                   When      cltid = '148'
     C                   Move      *on           monoState
     C                   Endsl
     C*
     C                   Endif
     C                   move      *off          *in96
     C                   if        elprom = 'M'
     C                   move      *on           *in96
     C                   endif
     C                   eval      xnpror = 1
     C     HCKEY         SETGT     PHC01
     C     HCKEY1        READPE    PHC01                                  60
     C                   MOVE      *BLANK        XXLRGD            1
    C*
     C*   VERIFY IF POLICY IS LARGE DEDUCTIBLE BASED ON BILLING SCHEDULE CODE
     C*
     C                   clear                   xxkey
     C                   movel     elbscd        xxkey
     C     tbkey         chain     pbs01                              60
     C*
     C                   if        *in60 = *off and bslpgm = 'L'
     C*
     C     ELKY          CHAIN     pld02                              60
     c                   if        *in60 = *off
     C                   MOVE      'Y'           XXLRGD
     C                   ENDIF                                                  *in60 = *off
     C*
     C                   endif
     c*
    C*
     C                   if        *in84 = *on
    C*
     C*
     C*  PULL STATE PREMIUM FROM ARRAY.
     C*
     c     1             do        52            w
     c     w             occur     sttot2
     C* MATCHING STATE
     c                   if        (t2st = xxst)
     c                   leave
     c                   endif                                                  TAST IFEQ
     C*
     c                   enddo                                                  DO W:1-52
     C*
     c                   if        (t2man <> *zero)
     c                   eval(h)   xnpror = (t2nor / t2man)
     c                   endif
    C*
    C*
     C                   endif
    C*
    C*
    C* Print payroll classes if producing hardcopy.
    C*
     c                   if        *in26 = *on
     C                             and xspfdt <> xsptdt
     C                   select
     C                   when      printer1 = 'SKIP'
     C                   when      printer1 = 'W7413O1FL'
     C                   when      printer1 = 'W7413O1'
     C                   other
     C                   clear                   xxline
     C                   eval      xxpage = xxpage + 1
     C                   clear                   tas17
     C                   eval      xxetxt = 'for Item #4'
     C                   If        isuseSpoolOut
     C                   except    sohead
     C                   move      *off          *inof
    C*
     C                   except    payrhd
     C                   Endif
     C                   endsl
    C*
     C  n67epky2         chain(n)  xep01                              52
     C   67epky3         chain(n)  xep01                              52
    C*
     C                   if        *in52 = *on
     C                   select
     C                   when      printer1 = 'SKIP'
     C                   when      printer1 = 'W7413O1FL'
     C                   when      printer1 = 'W7413O1'
     C                   other
     C                   If        isuseSpoolOut
     C                   except    payrnd
     C                   Endif
     C                   endsl
     C                   endif
     C                   Clear                   assFlg
     C                   If        tms18 <> 0 and cltid = '136' and taSt = 'CA'
     C                   Eval      xxTerFac = ELDev2F
     C                   If        rrdv2h = *blanks
     C                   Movel(p)  con(73)       xxTerHdg
     C                   Else
     C                   Movel(p)  rrdv2h        xxTerHdg
     C                   Endif
     c                   Else
     C                   Clear                   xxTerHdg         30
     C                   Clear                   xxTerFac          5 4
     c                   Endif
     C                   Exsr      ScriptPremPage
    C*
     C                   dow       *in52 <> *on
    C*
     c                   if        (*in67 = *off and *in68 = *off)
     c                             or (*in67 = *on and eppst = xxpst
     c                                 and epelcd <> 0)
     c                             or (*in68 = *on and epefdt = *hival)
    C*
     C                   select
     C                   when      printer1 = 'SKIP'
     C                   when      printer1 = 'W7413O1FL'
     C                   when      printer1 = 'W7413O1'
     C                   other
     C                   If        isuseSpoolOut
     C                   if        *inof = *on
     c                             or xxline > 38
     C                   eval      xxpage = xxpage + 1
     C                   eval      xxetxt = 'for Item #4'
     C                   except    sohead
     C                   except    payrhd
     C                   clear                   xxline
     C                   move      *off          *inof
     C                   endif
     C                   Endif
     C                   endsl
    C*
     C                   clear                   *in91
     C                   clear                   *in92
