     C                   movea     xxfold        dt(f)
     C     ' '           lookup    dt(f)                                  61
     C                   movel     ','           dt(f)
     C                   eval      f = f + 1
     C                   movel     ')'           dt(f)
    C*
     C                   movea     dt            icstmt
    C*
     C                   write     pic01
     C                   clear                   dt
    C*
     C                   endsr
    C*
    C*====================================================================
