     C                             and rsjrst = 'NJ'
     c                             and xxpeon <> 'Y'
     c*** begin add ***  02/05/25  ***********************************
     C* If a dba name then mark already reported if its been written already
     c* for the federal name its linked to.
     C                   If        writFD = 'N' or (writFD = 'Y' and
     C                             xfname = 'Y' and NAEncd = xfencd)
     c*** end add *****  02/05/25  ***********************************
     C                   move      'Y'           xsname
     c                   move      *on           *in61
    C*
     C                   Eval      xxchg = ' '
