    C*====================================================================
    C* CHKALA - Check address for WMAL*
    C*====================================================================
    C*
     C     chkala        begsr
    C*
     C                   move      'N'           writma
     C                   move      'N'           writpa
      /free
         isDupLocAddPA = *off;
         isDupLocAddMA = *off;
      /end-free
    C*
    C*  X-late address data for comparison w/o capitalization
     C                   exsr      xlatea
    C*
     C                   if        xamad1 <> *blanks
     C                   move      'Y'           writma
     C                   endif
    C*
     C                   if        xamad1 <> xapad1
     C                             or xamad2 <> xapad2
     C                             or xamcty <> xapcty
     C                             or xamst <> xapst
     C                             or almzip <> alpzip
     C                   if        xapad1 <> *blanks
     C                             or xapad2 <> *blanks
     C                   move      'Y'           writpa
     C                   endif
     C                   endif
    C*
    C*  Check location addresses against division addresses, can NOT
    C*   duplicate.
    C*
    C*  X-late address data for comparison w/o capitalization
    C*
    C*  Mailing address
    C*
    C*  Physical address
    C*
    C*
    C*  Reset values prior to address check
    C*
    C*
     C                   move      *on           cmpal
     C                   exsr      cmpnaa
      /free
       If cltid = '133';
       Select;
       When (writma='N' and writpa='N' and xapad1<>*blanks);
         isDupLocAddPA = *on;
       When (writma='N' and writpa='N' and xapad1=*blanks and xamad1<>*blanks);
         isDupLocAddMA = *on;
       endsl;
       Endif;
      /end-free
    C*
     C                   endsr
    C*
    C*====================================================================
    C* CHKEMA - Check address for WMEM*
    C*====================================================================
    C*
     C     chkema        begsr
    C*
     C                   move      'N'           writma
     C                   move      'N'           writpa
      /free
         isDupLocAddPA = *off;
         isDupLocAddMA = *off;
      /end-free
    C*
    C*  X-late address data for comparison w/o capitalization
     C                   exsr      xlatee
    C*
     C                   if        xemad1 <> *blanks
     C                             and xxdiv <> shdiv
     C                   move      'Y'           writma
     C                   endif
    C*
     C                   if        xemad1 <> xepad1
     C                             or xemad2 <> xepad2
     C                             or xemcty <> xepcty
     C                             or xemst <> xepst
     C                             or emmzip <> empzip
     C                   if        xepad1 <> *blanks
     C                             or xepad2 <> *blanks
     C                   move      'Y'           writpa
     C                   endif
     C                   endif
    C*
     C                   move      *on           cmpem
     C                   exsr      cmpnaa
      /free
       If cltid = '133';
       Select;
       When (writma='N' and writpa='N' and xepad1<>*blanks);
         isDupLocAddPA = *on;
       When (writma='N' and writpa='N' and xepad1=*blanks and xemad1<>*blanks);
         isDupLocAddMA = *on;
       endsl;
       Endif;
      /end-free
     C                   If        writma = 'N' and xemad1 <> *blanks and
     C                             shdiv = xxdiv  and shemp# <> 1
     C                   If        (fnpeof = 'M' or fnpeof = 'C') and
     C                             (##pgfl = '3' or
     C                             ##pgfl = '1')
     C                   move      *on           isDupLocAddMA
     C                   Endif
     C                   Endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* CMPNAA - Compare addresses to WXNAP records
    C*====================================================================
    C*
     C     cmpnaa        begsr
    C*
     C                   Clear                   xxchg
     C                   eval      svencd = naencd
     C                   eval      svnlkc = nanlkc
     C                   Move      xxStCode      saveSt            2
    C*
     C                   if        wcfl03 = 'Y'
     C                             and *in32 = *off
     C                             or (cltid = '148' and F2Car# = 38073)
    C*
     C     naky          chain     pna01                              60
    C*
     C                   dow       *in60 = *off
    C*
     C                   if        naencd = svencd
     C                             and nanlkc = svnlkc
     C                             and nast = saveSt
    C*
    C*  X-late address data for comparison w/o capitalization
     C                   exsr      xlaten
    C*
     C                   select
     C                   when      cmpem = *on
     C                   if        writpa = 'Y'
     C                             and xepad1 = xnmad1
     C                             and xepad2 = xnmad2
     C                             and xepcty = xnmcty
     C                             and xepst = xnmst
     C                             and empzip = namzip
     C**** Beg Add *** 07/22/25 **************************************
     C                             and emname + emnam2 = naname + nanam3
     C**** End Add *** 07/22/25 **************************************
     C                   move      'N'           writpa
     c                   callp     updatWXNAP( 'P' )
     C                   endif
     C                   if        writma = 'Y'
     C                             and xemad1 = xnmad1
     C                             and xemad2 = xnmad2
     C                             and xemcty = xnmcty
     C                             and xemst = xnmst
     C                             and emmzip = namzip
     C**** Beg Add *** 07/22/25 **************************************
     C                             and emname + emnam2 = naname + nanam3
     C**** End Add *** 07/22/25 **************************************
     C                   move      'N'           writma
     c                   callp     updatWXNAP( 'M' )
     C                   endif
     C                   when      cmpal = *on
     C                   if        writpa = 'Y'
     C                             and xapad1 = xnmad1
     C                             and xapad2 = xnmad2
     C                             and xapcty = xnmcty
     C                             and xapst = xnmst
     C                             and alpzip = namzip
     C**** Beg Add *** 07/22/25 **************************************
     C                             and alname + alnam2 = naname + nanam3
     C**** End Add *** 07/22/25 **************************************
     C                   move      'N'           writpa
     c                   callp     updatWXNAP( 'P' )
     C                   endif
     C                   if        writma = 'Y'
     C                             and xamad1 = xnmad1
     C                             and xamad2 = xnmad2
     C                             and xamcty = xnmcty
     C                             and xamst = xnmst
     C                             and almzip = namzip
     C**** Beg Add *** 07/22/25 **************************************
     C                             and alname + alnam2 = naname + nanam3
     C**** End Add *** 07/22/25 **************************************
     C                   move      'N'           writma
     c                   callp     updatWXNAP( 'M' )
     C                   endif
     C                   endsl
    C*
     C                   endif
    C*
     C     naky          reade     pna01                                  60
    C*
    C*  If both addresses have already been disallowed, end processing
     C                   if        writpa = 'N' and writma = 'N'
     C                   move      *on           *in60
     C                   endif
    C*
     C                   enddo
    C*
     C                   endif
    C*
     C                   move      *off          cmpal
     C                   move      *off          cmpem
     C                   move      svencd        naencd
     C                   eval      nanlkc = svnlkc
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LD2DED - Load 2nd Deductible info for printing
    C*====================================================================
     C     ld2ded        begsr
    C*
      /Free
       If isContri = '1';
          xxHdg = con(59);
       Else;
          xxHdg = con(37);
       Endif;
      /End-free
     C                   eval      xxtam = tas37
    C*
     C                   movel     eldcd2        xxddcd
     C                   eval      x7ddef = elpfdt
     C                   MOVE      EL2DEF        Q@DATE
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q@DATE            7
     C                   MOVE      Q@DATE        X7DDEF
    C*
     C     ddkyt2        setgt     pdd01
     C     ddkyt         readpe    pdd01                                  60
    C*
     C                   if        *in60 = *off
     C                              and ddstat = 'A'
    C*
     C                   eval      premCd = %editc(DDCLAS:'X')
    C*
     C                   clear                   xxasp
     C                   movel     ddpct         x1asp
    C*
     C                   if        ddpct >= 10
     C                             and ddpct < 100
     C                   movel     ' '           x1asp
     C                   endif
    C*
     C                   if        ddpct < 10
     C                   movel     '  '          x1asp
     C                   endif
    C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      premRt54 = DDPCT / 100
     C                   exsr      AddDedLimit
     C                   other
     C                   move      ddpct         x2p
     C                   movel     x2p           x2asp
     C                   move      '.'           xxdot
     C                   movel(p)  xxasp         xxaspx
     C                   move      '%  '         xxaspx
     C                   move      xxaspx        xxhdg
     C                   endsl
    C*
     C                   endif
     C                   Eval      xxHeading = con(37)
     C                   Clear                   xxPercent
     C                   Clear                   xxStatCode
     C                   If        *in60 = *off and DDStat = 'A'
     C                   Eval      xxPercent = DDPct
     C                   Eval      xxStatCode = DDClas
     C                   Endif
     C                   Clear                   xxPercentF
     C                   Clear                   xxFactor
     C                   Eval      xxSign = '-'
     C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      xxNegF = *on
     C                   endsl
    C*
     C                   if        *in26 = *on
     C                             and *in84 = *off
     C                   exsr      PrtPremInfo
     C                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C* LD1LRG - Load 1st Large Deductible info for printing
    C*====================================================================
     C     ld1lrg        begsr
     c
     C                   movel(p)  con(51)       xxhdg
     C                   eval      xxtam = tas14
      /Free
       If xxminf = 'Y';
          xxtam = tms14;
       Endif;
      /End-free
     C                   eval      premCd = %editc(LDCLS1:'X')
     C                   Eval      xxHeading = con(51)
     C                   Select
     C                   When      LDPct1 >= 100
     C                   Eval      LDPct1 = 99.999
     C                   When      LDPct1 < 0
     C                   Eval      LDPct1 = 0
     C                   Endsl
     C                   Eval      xxPercent = LDPct1
      /Free
       Monitor;
       Select;
       When cltID <> '150';
       When LDplv1 = 'E';
          Eval(h) xxPercent = %Dec((tas14/tas04*100):6:3);
       When LDplv1 = 'S';
          Eval(h) xxPercent = %Dec((tas14/tas04*100):6:3);
       When LDplv1 = 'D';
          Eval(h) xxPercent = %Dec((tas14/tas05*100):6:3);
       Endsl;
       On-error;
          If cltID = '150';
             Eval(h) xxPercent = %Dec(LDPct1:6:3);
          Endif;
       Endmon;
       //*** end add ***** 12/01/23  *******************************
      /End-Free
     C                   Eval      xxStatCode = LDCls1
     C                   Clear                   xxPercentF
     C                   Clear                   xxFactor
     C                   Eval      xxSign = '-'
     C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      premRt54 = LDPCT1 / 100
     C                   exsr      AddDedLimit
     C                   other
     c*
     c                   move      ldpct1        xxpct
     c*
     c                   move      *blanks       xxpct1           13
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
     c*
     c                   move      xxpct1        xxhdg
     c*
     C                   endsl
     C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      xxNegF = *on
     C                   endsl
     C*
     C                   if        *in26 = *on
     C                             and *in84 = *off
     C                   exsr      PrtPremInfo
     C                   endif
    C*
     C                   endsr                                                  ld1lrg subr
    C*
    C*====================================================================
    C* LD2LRG - Load 2nd Large Deductible info for printing
    C*====================================================================
     C     ld2lrg        begsr
    C*
     C                   movel(p)  con(52)       xxhdg
     C                   eval      xxtam = tas37
    C*
     C                   eval      premCd = %editc(LDCLS2:'X')
     C                   Eval      xxHeading = con(52)
     C                   Eval      xxPercent = LDPct2
      /Free
       Monitor;
       Select;
       When cltID <> '150';
       When LDplv1 = 'E';
          Eval(h) xxPercent = %Dec((tas14/tas04*100):6:3);
       When LDplv2 = 'S';
          Eval(h) xxPercent = %Dec((tas37/tas04*100):6:3);
       When LDplv2 = 'D';
          Eval(h) xxPercent = %Dec((tas37/tas05*100):6:3);
       Endsl;
       On-error;
          If cltID = '150';
             Eval(h) xxPercent = %Dec(LDPct2:6:3);
          Endif;
       Endmon;
      /End-Free
     C                   Eval      xxStatCode = LDCls2
     C                   Clear                   xxPercentF
     C                   Clear                   xxFactor
     C                   Eval      xxSign = '-'
    C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      premRt54 = LDPCT2 / 100
     C                   exsr      AddDedLimit
     C                   other
     c*
     c                   move      ldpct2        xxpct
     c*
     c                   move      *blanks       xxpct1           13
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
     c*
     c                   move      xxpct1        xxhdg
     c*
     C                   endsl
    C*
     C                   select
     C                   when      cltID = '139'
     C                   eval      xxNegF = *on
     C                   endsl
    C*
     C                   if        *in26 = *on
