     C* Change the condition to refer to the endorsement effective date
     C* rather than ind 60 which is being overridden.
     C                   if        ENeddt = 0
     C                   movel     muform        xf(idx)
     C                   eval      endEdition = *blanks
     C                   else
     C     muform        cat(p)    '(':0         xf(idx)
     C                   cat       xxedmm:0      xf(idx)
     C                   cat       '/':0         xf(idx)
     C                   cat       xxedyy:0      xf(idx)
     C                   cat       ')':0         xf(idx)
     C                   eval      endEdition = '(' + xxedmm + '/' +
     C                                                xxedyy + ')'
     C                   endif
     C                   endif
