     c                   movel     state         kkst
     c     stkey         chain     pst01
     c                   if        %found
     c                   return    STNAME
     c                   else
     c                   return    *blanks
     c                   endif
     p getStateName    e
     *=============================================================================================
      * getPEOTypB - returns type of business for PEO Master
     *=============================================================================================
     p getPEOTypB      b
     d getPEOTypB      pi            20
     d  employer#      s                   like(ememp#)
     d  division       s                   like(emdiv)
     d  xxtypb         s             20
     d
     c                   eval      employer# = xxemp#
     c                   eval      division = xxdiv
     c                   eval      xxemp# = 1
     c                   eval      xxdiv  = 0
     c     emky1         chain     pem01
     c                   if        %found
     c                   eval      xxtypb = EMTPOB
     c                   else
