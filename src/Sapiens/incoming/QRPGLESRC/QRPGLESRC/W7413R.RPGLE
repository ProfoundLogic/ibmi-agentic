     C                   Eval      muenst = 'CA'
     C                   Endif
     C                   If        addNameForm <> ' '
     C                   Eval      endsForm = %trim(addNameForm)
     C                   Endif
     C                   Clear                   ENEddt
     C                   If        *in75 = *on
     C                   Eval      ENEddt = 0980101
     C                   Else
     C                   Eval      ENEddt = xxDecDate
     C                   Endif
     C                   If        addNameDate <> 0
     C                   Eval      ENEddt = addNameDate
     C                   Endif
     C                   If        ENEddt <> 0
     C     endsForm      cat(p)    '(':0         endsForm
     C                   cat       xxedmm:0      endsForm
     C                   cat       '/':0         endsForm
     C                   cat       xxedyy:0      endsForm
     C                   cat       ')':0         endsForm
     C                   Endif
