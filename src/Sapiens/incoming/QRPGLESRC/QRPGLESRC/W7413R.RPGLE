     *
     *====================================================================
     * WriteCW - Write the Compwest "Loss Control Form"
     *====================================================================
     c     WriteCW       begsr
      *
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c                   IF        ObjExists('CAREWQB':'*PAGSEG')
     c                   write     Not136_1
     c                   endif

     c                   write     Not136_2

     c                   eval      n6h1 = 'OCCUPATIONAL SAFETY AND ' +
     c                             'HEALTH LOSS CONTROL CONSULTATION ' +
     c                             'SERVICES'
    
     c                   eval      n6P1L1 = 'Section 6354.5(a) of the ' +
     c                             'California Labor Code requires ' +
     c                             'Worker''s Compensation ' +
     c                             'Insurers to provide'
    
     c                   eval      n6P1L2 = 'occupational safety and ' +
     c                             'health loss control consultation ' +
     c                             'services, at no additional charge ' +
     c                             'to the'
    
     c                   eval      n6P1L3 = 'policyholder.'
    
     **** P2
     c                   eval      n6P2L1 = 'Care West Insurance ' +
     c                             'Company has available to you ' +
     c                             'Loss Control/Consultation Services ' +
     c                             'which include'

     c                   eval      n6P2L2 = 'the following:'

     c                   eval      n6P2L3P1 = 'Workplace surveys to identify'

     c                   eval      n6P2L3P2 = 'Health and Safety'

     c                   eval      n6P2L3P3 = 'issues.'
    
     c                   eval      n6P2L4P1 = 'Review of your'
    
     c                   eval      n6P2L4P2 = 'Historical Injury records.'
    
     c                   eval      n6P2L5P1 = 'Development of plans to ' +
    c                                        'improve'
    
     c                   eval      n6P2L5P2 = 'Employer Health'
    
     c                   eval      n6P2L5P3 = 'and'
    
     c                   eval      n6P2L5P4 = 'Safety Loss Records,'
    
     c                   eval      n6P2L5P5 = 'including'
    
     c                   eval      n6P2L6P1 = 'Occupational Injury'
    
     c                   eval      n6P2L6P2 = 'and'
    
     c                   eval      n6P2L7 = 'Illness Prevention Programs.'
    
     **** P3

     c                   eval      n6P3L1 = 'To inquire about these ' +
     c                                      'services contact the ' +
     c                                      'following:'

     c                   eval      n6P3L2 = 'Risk Management Department'

     c                   eval      n6P3L3 = 'Care West Insurance Company'

     c                   eval      n6P3L4 = 'P O Box 2710'

     c                   eval      n6P3L5 = 'Rocklin, CA 95677'

     c                   eval      n6P3L6 = 'Or call:'

     c                   eval      n6P3L7 = '877 625-6566'
    
     **** P4

     c                   eval      n6P4L1 = 'You are entitled to ' +
     c                             'register comments about Care West''s ' +
     c                             'loss control consultation services ' +
     c                             'by writing to:'

     c                   eval      n6P4L2 = 'Department of Industrial ' +
     c                                      'Relations'

     c                   eval      n6P4L3 = 'Commission on Health and ' +
     c                             'Safety Workers Compensation'

     c                   eval      n6P4L4 = '455 Golden Gate Avenue'

     c                   eval      n6P4L5 = 'San Francisco, CA 94102'

     c                   eval      n6P4L6 = 'Or call:'

     c                   eval      n6P4L7 = 'Loss Control Coordinator ' +
     c                             '(CSHCW) at (415) 703-4220'

     C                   write     NOTICECW
    
     C                   endsr
    C*
    C*
    C*====================================================================
    C* WriteNJ - Write the NJ form
    C*====================================================================
     C     WriteNJ       begsr
     C*
     C                   exsr      LoadFormData
    C*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
