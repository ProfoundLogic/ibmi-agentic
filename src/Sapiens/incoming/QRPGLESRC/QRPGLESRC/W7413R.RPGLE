     C                   endif
     C                   eval      svencd = naencd
     C                   eval      svnlkc = nanlkc
     C                   select
     C                   when      writfd = 'Y'
     C                             and xfname = ' '
     C                   MOVEL     XXF100        NANAME
     C                   MOVE      XXF100        NANAM3
     C                   MOVE      *BLANKS       NANAM2
     C                   MOVE      *BLANKS       NANAM4
