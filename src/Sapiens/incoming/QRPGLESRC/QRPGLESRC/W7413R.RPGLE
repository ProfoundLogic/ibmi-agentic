     C                   clear                   xqto
     C                   if        elptdt > 0940101
     C                   do        6             x
     C                   if        rdat(x) >= 0930101
     C                             and rdat(x) <= 0931231
     C                   if        pdat(x) < 0940101
     C                   move      01011994      xqfrom
     C                   else
    C*
     C                   eval      xqFrom = DtMDYY(pdat(x))
    C*
     C                   endif
     C                   if        x <= 5
