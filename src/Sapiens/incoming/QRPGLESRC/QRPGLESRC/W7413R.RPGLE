     C                   move      elco#         ##co#             3
     C                   move      elfnd         ##fnd             3
     C                   move      elemp#        ##emp#            9
     C                   move      elfyr         ##fyr             3
     C                   move      *blank        ##rtn             1
     C*
     C                   call      'W1053R3'
     C                   parm                    ##co#
     C                   parm                    ##fnd
     C                   parm                    ##emp#
     C                   parm                    ##fyr
     C                   parm                    ##rtn
     C*
     C                   endif                                                   FNAER = 'Y'
