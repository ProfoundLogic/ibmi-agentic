    C*
    C*  Accumulate payroll/premium amounts for basis of terrorism charges.
    C*
      /free

          Select;
          When PRPCF = 'P';
             tasTerPay = tasTerPay + EPEapr;
             xxTerPay  = xxTerPay + EPEapr;
             tasDomPay = tasDomPay + EPEapr;
          When EPClas = RRDccd;
             tasTerPay2 = tasTerPay2 + EPAdld;
             xxTerPay2  = xxTerPay2 + EPAdld;
          When PRPCF <> 'P' and PROccd = ' ';
             tasTerPay2 = tasTerPay2 + EPEmpr;
             xxTerPay2  = xxTerPay2 + EPEmpr;
          Endsl;

      /end-free
    C*
    C*  APPLY 15.7% CREDIT TO PORTION OF MANUAL USING 1993 RATES;
    C*  GET CORRECT DATE FROM RDAT ARRAY TO DETERMINE RATING DATE USED
    C*  TO PULL RATE FROM FILE
    C*
     C                   eval      epdisc = *zeros
    C*
    C*  15.7% DISCOUNT IS APPLIED TO PORTION OF 94 POLICY USING
    C*  93 RATES
    C*
     C                   if        xx157 = 'Y'
    C*
     C                   eval      z = 1
     C     epefdt        lookup    pdat(z)                            60
     C                   if        *in60 = *on
     C                             and z > 1
     C                   eval      z = z - 1
     C                   eval      x2efdt = rdat(z)
     C                   else
     C                   eval      z = 1
     C                   eval      x2efdt = elpfdt
     C                   endif
    C*
     C                   if        x2efdt >= 0930101
     C                             and x2efdt <= 0931231
    C*
    C*  APPLY 15.7 % CREDIT TO UNEXPIRED PORTION OF POLICY
    C*
     C                   if        fdays <> *zeros
     C                   eval(h)   x2wk54 = pdays3 / fdays
     C                   else
     C                   eval      x2wk54 = *zeros
     C                   endif
    C*
    C*  HARBOR EXPOSURE CLASSES WILL ONLY RECEIVE UP TO 3.2 %
    C*  CREDIT ON UNEXPIRED PORTION OF POLICY
    C*
     C                   if        epspec = 'F'
     C                   eval(h)   xxmths = pdays3 / 30
     C                   eval      t = 1
     C     xxmths        lookup    mth(t)                             60
     C                   if        *in60 = *on
     C                   eval      xxwo54 = hp(t)
     C                   else
     C                   eval      xxwo54 = *zeros
     C                   endif
     C                   else
     C                   eval(h)   xxwo54 = x2wk54 * 0.157
     C                   endif
     C                   eval      xxwh54 = eparat / 100
     C                   eval      epempr = epeapr * xxwh54
    C*
     C                   eval(h)   xxsave = epempr / 1
     C                   eval      epempr = xxsave
    C*
    C*  IF THIS IS ANNIVERSARY RATED MANUAL PREMIUM, THEN WE
    C*  NEED TO APPLY FULL 15.7% CREDIT ON NON-HARBOR EXPOSURE,
    C*  FULL 3.2% CREDIT ON HARBOR EXPOSURE CLASS CODES
    C*
     C                   if        *in88 = *off
     C                   if        epspec = 'F'
     C                   eval(h)   epdisc = epempr * 0.032
     C                   else
     C                   eval(h)   epdisc = epempr * 0.157
     C                   endif
     C                   else
     C                   eval(h)   epdisc = epempr * xxwo54
     C                   endif
     C                   eval      epdisc = epdisc * -1
    C*
     C                   eval(h)   xxsave = epdisc / 1
     C                   eval      epdisc = xxsave
     C                   endif
    C*                                                    X2EFDT<=12/31/93
     C                   endif
    C*
    C*  OUTPUT THE WORK FILE RECORD.
