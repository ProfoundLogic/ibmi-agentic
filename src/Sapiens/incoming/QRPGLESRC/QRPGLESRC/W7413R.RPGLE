    C*====================================================================
    C* NewExtPage - Write a new page for the extension pages
    C*====================================================================
     C     NewExtPage    begsr
     C*
     C                   if        xxpbcg = *on or xxowcg = *on
     C                   eval      extras1 = *on
     C                   endif
     C                   if        cltID = '139' and curpol <> prvpol and
     C                             xxpbcg = *off and xxowcg = *off  and
     C                             zzemp# = *ZEROS
     C                   eval      extras1 = *OFF
     c                   eval      prvpol = curpol
     C                   endif
     C*
     C                   if        not extras1
     C                   select
     C                   when      cltID = '139'
     C                   exsr      Privacy139
     c                   if        ullico <> 'Y'
     C                   exsr      Jacket139
     c                   endif
     C                   endsl
     C                   eval      extras1 = *on
     C                   endif
    C*
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     C                   if        extPage# > 0
     C                   select
     C                   when      printer1 = 'W7413O1FL'
     C                   write     newExtFL
     C                   when      printer1 = 'W7413O1'
