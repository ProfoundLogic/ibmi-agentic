     C                   write     formNJ
     C                   write     boxesNJ
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem1 - Write the extension page Item 1
    C*====================================================================
     C     WriteItem1    begsr
     C*
     C                   exsr      LoadExtItem1
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
     c                   select
     c                   when      ullico = 'Y'

     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     schedhu
     C                   write     footu
     C                   select
     C                   when      addNameIns
     C                   write     const1nu
     C                   when      otherLoc > 0
     C                   write     const1lu
     C                   endsl
     C                   endif

     C                   select
     C                   when      addNameIns
     C                   write     item1nmu
     C                   eval      item1Line# = item1Line# + 2
     C                   if        item1Line# > maxItem1u
     C                   eval      item1Line# = 0
     C                   endif

     C                   when      otherLoc > 0
     C                   write     item1Oth
     C                   eval      item1Line# = item1Line# + 7
     C                   if        item1Line# > maxItem1u
     C                   eval      item1Line# = 0
     C                   endif

     C                   endsl

     c                   when      bancInsure
     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     headbi
     C                   write     bot1bi
     C                   select
     C                   when      addNameIns
     c                   eval      bi1verb = 'SCHEDULE OF NAMED INSUREDS'
     C                   when      otherLoc > 0
     c                   eval      bi1verb = '  SCHEDULE OF LOCATIONS   '
     C                   endsl
     C                   write     const1bi
     C                   endif

     C                   select
     C                   when      addNameIns
     C                   write     item1nbi
     C                   eval      item1Line# = item1Line# + 2
     C                   if        item1Line# > maxItem135
     C                   eval      item1Line# = 0
     C                   endif

     C                   when      otherLoc > 0
     C                   write     item1bi
     C                   eval      item1Line# = item1Line# + 5
     C                   if        item1Line# > maxItem135
     C                   eval      item1Line# = 0
     C                   endif

     C                   endsl

     c                   when      prt132

     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     schdh132
     C                   write     boxh132
     C                   write     schdv132
     C                   write     foot132
     C                   select
     C                   when      addNameIns
     C                   write     headn132
     C                   when      otherLoc > 0
     C                   write     headw132
     C                   endsl
     C                   endif

     C                   select
     C                   when      addNameIns
     c                   add       1             addnum
     C                   write     DETN132
     C                   eval      item1Line# = item1Line# + 2
     C                   if        item1Line# > maxItem1c
     C                   eval      item1Line# = 0
     C                   endif

     C                   when      otherLoc > 0
     c                   add       1             othnum
     C                   write     DETW132
     C                   eval      item1Line# = item1Line# + 7
     C                   if        item1Line# > maxItem1c
     C                   eval      item1Line# = 0
     C                   endif

     C                   endsl
     C                   When      unitedWis

     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     const1UW
     C                   write     boxes1UW
     C                   write     foot1UW
     C                   select
     C                   when      addNameIns
     C                   write     const1UWN
     C                   when      otherLoc > 0
     C                   write     const1UWL
     C                   endsl
     C                   endif
     C*
     C                   select
     C                   when      addNameIns
     C                   write     item1Nm
     C                   eval      item1Line# = item1Line# + 3
     C                   when      otherLoc > 0
     C                   Exsr      LocPrint
     C                   eval      item1Line# = item1Line# + 5
     C                   endsl
     C*
     C* Last record for page
     C                   if        item1Line# > maxItem1
     C                   eval      item1Line# = 0
     C                   endif

     C
     C                   When      amTrust

     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     constam
     C                   write     boxes1am
     C                   write     const1am
     C                   select
     C                   when      addNameIns
     C                   write     const1amn
     C                   when      otherLoc > 0
     C                   write     const1amw
     C                   endsl
     C                   endif
     C*
     C                   select
     C                   when      addNameIns
     C                   write     item1Nm
     C                   eval      item1Line# = item1Line# + 3
     C                   when      otherLoc > 0
     C                   Exsr      LocPrint
     C                   eval      item1Line# = item1Line# + 5
     C                   endsl
     C*
     C* Last record for page
     C                   if        item1Line# > maxItem1am
     C                   eval      item1Line# = 0
     C                   endif

     c                   other

     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     C                   write     const1
     C                   write     boxes1
     C                   write     foot1
     C                   select
     C                   when      addNameIns
     C                   write     const1Nm
     C                   when      otherLoc > 0
     C                   write     const1Ot
     C                   endsl
     C                   endif
     C*
     C                   select
     C                   when      addNameIns
     C                   write     item1Nm
     C                   eval      item1Line# = item1Line# + 3
     C                   when      otherLoc > 0
     C                   write     item1Oth
     C                   eval      item1Line# = item1Line# + 5
     C                   endsl
     C*
     C* Last record for page
     C                   if        item1Line# > maxItem1
     C                   eval      item1Line# = 0
     C                   endif

     c                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem1FL - Write the FL extension page Item 1
    C*====================================================================
     C     WriteItem1FL  begsr
     C*
     C                   dow       addNameIns or otherLoc > 0
     C*
     C                   exsr      LoadExtItem1
    C*
     C                   If        isuseSpoolOut
     C                   if        item1Line# = 0
     C                   exsr      NewExtPage
     c                   if        addnameins
     c                   write     const1nfl
     c                   else
     C                   write     const1FL
     c                   endif
     C                   write     boxes1FL
     C                   write     foot1FL
     C                   select
     C                   when      addNameIns
     C                   write     const1NmFL
     C                   when      otherLoc > 0
     C                   write     const1OtFL
     C                   endsl
     C                   endif
     C*
     C                   select
     C                   when      addNameIns
     C                   write     item1NmFL
     C                   eval      item1Line# = item1Line# + 2
     C                   when      otherLoc > 0
     C                   write     item1OthFL
     C                   eval      item1Line# = item1Line# + 5
     C                   endsl
     C*
     C* Last record for page
     C                   if        item1Line# > maxItem1
     C                   eval      item1Line# = 0
     C                   endif
     C                   Endif
     C*
     C                   eval      addNameIns = *off
     C                   select
     C                   when      otherLoc = 1 and x2oad1 <> *blanks
     C                   eval      otherLoc = 2
     c                   eval      x2onam = xxonam
     C                   other
     C                   eval      otherLoc = *zero
     C                   endsl
     C*
     C                   enddo
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem3D - Write the extension page Item 3D
    C*====================================================================
     C     WriteItem3D   begsr
     C*
     C                   exsr      LoadExtItem3D
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
    C*
     C                   if        idx = 1
     C                   exsr      NewExtPage
     c                   select
     c                   when      bancInsure
     c                   write     headbi
     c                   write     const3bi
     c                   write     bot3bi
     c                   when      ullico = 'Y'
     C                   write     schedhu
     C                   write     const1fu
     C                   write     footu
     c                   when      prt132
     C                   write     schdh132
     C                   write     boxh132
     C                   write     schdv132
     C                   write     foot132
     C                   write     heade132
      /free
       When isOptaComp;
         Write footOCOMP;
         Write HEADEOComp;
      /end-free
     c                   when      unitedWis
     C                   write     const3UW
     C                   write     boxes3UW
     C                   write     foot3UW
     C                   When      amTrust
     C                   write     constam
     C                   write     const3am
     C                   write     boxes3am
     c                   other
     C                   write     const3D
     C                   write     boxes3D
     C                   write     foot3D
     c                   endsl
     C                   endif
    C*
     c                   select
     c                   when      bancInsure
     C                   write     item3BI
     c                   when      prt132
     C                   write     DETE132
      /free
       When isOptaComp;
         Write DetEOComp;
      /end-free
     c                   when      unitedWis
     C                   write     item3UW
     C                   When      amTrust
     C                   write     det3am
     c                   other
     C                   write     item3D
     c                   endsl
    C*
     C* Last record for page
    c*
     c                   select
     c                   when      bancInsure
     C                   if        idx > maxItem3BI
     C                   eval      idx = 0
     C                   endif
     c                   when      ullico = 'Y'
     C                   if        idx > maxItem3u
     C                   eval      idx = 0
     C                   endif
     c                   when      prt132
     C                   if        idx > maxItem3c
     C                   eval      idx = 0
     C                   endif
     c                   other
     C                   if        idx > maxItem3d
     C                   eval      idx = 0
     C                   endif
     c                   endsl
    C*
     C                   endsr
    C*
    C*====================================================================
    C* WriteItem3DFL - Write the FL extension page Item 3D
    C*====================================================================
     C     WriteItem3DFL begsr
     C*
     C                   exsr      LoadExtItem3D
     C                   If        not isuseSpoolOut
     C                   Leavesr
     C                   Endif
    C*
     C                   if        idx = 1
     C                   exsr      NewExtPage
     C                   write     const3DFL
     C                   write     boxes3DFL
     C                   write     foot3DFL
     C                   endif
    C*
     C                   write     item3DFL
    C*
     C* Last record for page
     C                   if        idx > maxItem3d
