     *
     * OUTPUT THE FIRST ASSESSMENT EXPOSURE RECORD
      /free
       svState    = tast;
       svStCd     = rr1stc;
       svPrtZrFlg = 'N';
       svStatus   = 'I';
    
       Chain(n) keyWTSTL pst00;
       If %Found(wtstl);
          svPrtZrFlg = STflag;
          svStatus   = STstat;
       EndIf;
      /end-free
     *
      /free
            IF (tas24 <> 0 and rr1stc <> 0)
               OR (svPrtZrFlg = 'Y'and svStatus = 'A');
