     C                   move      *on           *in44
     C                   endif
     C                   if        f2docs = 'Y'
     C                   move      *on           *in46
     C                   endif
    C*
     C                   if        fnmad2 <> *blank
     C                   move      *on           *in20
     C                   endif
    C*
     C                   clear                   xxfcsz
     C                   Movel(p)  FNMCty        xxfCity
     C                   Movel(p)  FNMSt         xxfSt2
     C                   Move      FNMZip        xxfZip
     C                   move      fnmzip        xxzip
     C                   movel     fnmcty        xxfcsz
     C     xxfcsz        cat       ',':0         xxfcsz
     C     xxfcsz        cat       fnmst:1       xxfcsz
     C     xxfcsz        cat       xxzip5:2      xxfcsz
    C*
     C                   if        xxzip4 <> '0000'
     C     xxfcsz        cat       '-':0         xxfcsz
     C     xxfcsz        cat       xxzip4:0      xxfcsz
     C                   endif
      /Free
       SVpeof = FNpeof;
      /End-Free
    C*
    C*  Retrieve The Assessable Mutual Flag from Fund Aux File
    C*
    C*  PULL REMARK FROM ADMIN FILE
    C*
     c                   move      *off          *in67
     c                   move      *off          *in68
     C     fnky          chain     pex01                              60
     C                   if        *in60 = *off
     C                   movel(p)  exppcd        xxrmrk
