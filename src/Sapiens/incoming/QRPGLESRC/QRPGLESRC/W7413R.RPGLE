     C                   select
     C                   when      xfname = ' '
     C                             and writfd = 'Y'
     C                             or xsname = ' '
     C                             and writfd = 'N'
     c*** begin del ***  02/05/25  ***********************************
     C******                       or XSNAME = ' '
