     C                   movel     q1pgm         nxpgm
    C*
     C                   eval      NXDT   = sysDt7
     C                   eval      NXTIME = TimeTo6(SystemTime)
    C*
     C                   eval      nxidt = nxdt
     C                   movel     q1user        nxiusr
     C                   write     pnx01
     C                   endif
    C*
    C*  OUTPUT THE TERRORISM RISK ACT EXPOSURE RECORD
    C*
     C                   if        rrterc <> *zero
    C*
     C                   move      xxco#         nxco#
     C                   move      xxfnd         nxfnd
     C                   move      xxemp#        nxemp#
     C                   move      xxfyr         nxfyr
     C                   move      xxunid        nxunid
     C                   move      xxmst         nxst
     C                   move      rrterc        nxclas
     C* Move common code here
     C                   exsr      srCommon
     C* If no rate change for terrorism in array strtcg then process as existing
     C                   if        (tctrr1 = tctrr2 and (tctrr2 = tctrr3  or
     C                              tctrr3 = 0)) or (tctrr2 = 0 and tctrr3 = 0)
     C*

     C                   If        ELterr <> 0
     C                   Eval(h)   nxrt = ELterr * 100
     C                   Else
     C                   if        RRTERL <> 'Y'
     c                   eval(h)   rrterr = rrterr * getLossCost(RRTERC:
     c                                               getRateDate(elpfdt))
     C                   endif                                                      RRTERL IFNE
     C                   eval      nxrt = rrterr * 100
     C                   EndIf
     C                   clear                   nxefdt
     C     NHANDT        IFNE      *ZERO
     C                   Z-ADD     NHANDT        NXEFDT
     C                   ENDIF
     C                   clear                   nxeapr
     C*** begin chg ***  06/20/24  ******************************************
     C******             eval      nxempr = tas29
     C******             if        xxminf = 'Y'
     C******                       and elpror <> 1
     C******                       and elpror <> 0
     C******             eval(h)   xxwk10 = elpror * nxempr
     C******             eval      nxempr = xxwk10
     C******             endif
    C******
     C******             if        tas29 < 0
     C******             eval      nxempr = nxempr * -1
     C******             endif
     C                   eval      nxempr = tps29
    C*
     C                   if        tps29 < 0
     C                   eval      nxempr = nxempr * -1
     C                   endif
     C*** end chg *****  06/20/24  ******************************************
     C                   write     pnx01
    C*
     C* Following code is moved to srCommon
    C*
     C                   else
     C* Report separate records for terrorism if rate changes between periods
     C                   if        tctrr1 <> 0
     C                   eval      nxefdt = tcef1
     C                   eval      nxrt = tctrr1 * 100
     C                   eval      nxempr = tctra1
     C                   eval      nxclas = tca1f1
     C                   write     pnx01
     C                   endif
     C                   if        tctrr2 <> 0
     C                   eval      nxefdt = tcef2
     C                   eval      nxrt = tctrr2 * 100
     C                   eval      nxempr = tctra2
     C                   eval      nxclas = tca1f2
     C                   write     pnx01
     C                   endif
     C                   if        tctrr3 <> 0
     C                   eval      nxefdt = tcef3
     C                   eval      nxrt = tctrr3 * 100
     C                   eval      nxempr = tctra3
     C                   eval      nxclas = tca1f3
     C                   write     pnx01
     C                   endif
     C*
     C                   endif                                                  tctrr2=0=tctrr3
     C                   endif
    C*
    C*  OUTPUT THE DOMESTIC TERRORISM RISK ACT EXPOSURE RECORD
    C*
     C                   if        rrdtrc <> *zero
    C*
