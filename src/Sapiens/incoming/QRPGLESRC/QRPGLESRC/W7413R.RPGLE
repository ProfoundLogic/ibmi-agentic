     C                             and el1fpr <> *zero
     C                   eval      xxprem = el1apr + el1fpr
     C                   eval(h)   nxpsur = el1aam / xxprem
     C                   else
     C                   eval      nxpsur = rr1stp / 100
     C                   endif
     C                   else
     C                   eval      nxpsur = 0
     C                   endif
     *
