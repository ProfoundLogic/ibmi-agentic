     C                   eval      xxexm2 = xsexm2
     C                   eval      xxemd2 = xsemd2
     C                   eval      xxexm3 = xsexm3
     C                   eval      xxemd3 = xsemd3
     C                   if        xsexm1 <> *zero
     C                             or (tms18 <> 0 and cltid = '136' and
