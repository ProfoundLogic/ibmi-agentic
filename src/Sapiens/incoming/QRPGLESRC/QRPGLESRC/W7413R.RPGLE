     c                   endif
    C*
     C                   exsr      SetGrpPos
     C*
     c                   if        bancInsure
     c                   eval      bippol# = xpol
     c                   eval      bicpol# = xppol
     c                   eval      birisk# = xxrisk
     c                   eval      biefein = 'SEE LOCATIONS SCHEDULE'
     c                   if        FNPEOF <> *blank
     c                   eval      bitypbu = getPEOTypB
     c                   eval      biProd  = getPEOProd
     c                   else
     c                   eval      bitypbu = xxbtyp
     c                   eval      biProd  = xxprnm
     c                   endif
     C                   Exsr      DefAddress
     c
     c                   eval      biothwp = 'SEE LOCATIONS SCHEDULE'
     c                   eval      bipfrdt = polFrDt
     c                   eval      biptodt = polToDt
     c                   eval      bitm3a1 = item3a1
     c                   eval      bitm3a2 = item3a2
     c                   eval      bitm3b1 = xxAcc
     c                   eval      bitm3b2 = xxAgg
     c                   eval      bitm3b3 = xxDis
     c                   eval      bitm3c1 = xxPP3C
     c                   eval      bitm3c2 = xxPPC3
     c                   eval      bitm3d1 = 'See Forms List Attached'
     c                   eval      bipolad = xxofad100
     c                   eval      bidate  = %editw(xxdate : '  /  /    ')
      *
      * Position mailing address lines vertically
      *
     c     1             do        9             a#
     c                   select
     c                   when      a# = 1
     c                   eval      vertLinePos = 3.125
     c                   when      a# = a1
     c                   z-add     4.025         vertLinePos
     c                   eval      mhd = vertLinePos                            position mailhd
     c                   other
     c                   add       .15           vertLinePos
     c                   endsl
     c                   eval      vpos(a#) = vertLinePos
      *
      * Position mailing address lines horizontally
