     c                   eval      NAPFD2 = xrefdt
     c                   eval      NAPTD2 = xrexdt
     C                   move      elpfdt        nanamefd
     C                   move      elpfdt        naadrefd
     C                   movel     emnaob        nanaob
     C                   if        nanaob = *blanks
     C                             and svnaob <> *blanks
