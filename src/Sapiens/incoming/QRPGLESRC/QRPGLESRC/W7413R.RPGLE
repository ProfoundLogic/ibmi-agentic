    C*====================================================================
     C     njeue#        begsr
    C*
    C* UPDATE NAME/ADDRESS RCD WITH NEXT TAX ID IF NECESSARY.
    C*
     c                   move      *blanks       xxue#
     C                   If        xrefdt <> xrexdt
     C                   SELECT
     C                   WHEN      CLTID = '114'
     C                   movel     emue#         xxue#
     C                   OTHER
     C                   If        rsjrst = 'NJ'
     C                   Movel     emsemp        xxue#
     C                   Else
     C                   Movel     emue#         xxue#
     C                   Endif
     C                   ENDSL
     C                   Endif
     C                   If        xxue# = ' '
     C                   Leavesr
     C                   Endif

      /free
       If xsName = 'Y' and xxUE# <> *zero
        or xfName = 'Y' and xxUE# <> *zero;
          xxNcciStCode = getNcciStCode(EMpst:EMmst);
      /end-free
    C*
     C                   movel(p)  xna100        xnsav
     C                   move      nafein        xnfein
     C                   move      nalegn        xnlegn
     C                   Movel(p)  NANAM4        SVNAM4
     C*** begin add ***  10/15/25  **********************************************
     C                   Move      nanamp        xnnamp            1
     C*** end add *****  10/15/25  **********************************************
     C                   Move      nasus#        xnsus#            2 0
     C                   clear                   xxchg
     C                   move      *off          *in60
     C                   eval      xxnlkc = nanlkc
     C                   eval      xxencd = naencd
    C*
     C                   dow       *in60 = *off
     C                             and xxchg <> 'Y'
    C*
     C                   If        nasus# > xnsus#
     C                   Move      nasus#        xnsus#
     C                   Endif
     C                   if        (xxue# <> naue# or
     C                              xxNcciStCode <> nast1)
     C                             and (xxue# <> naue#2 or
     C                              xxNcciStCode <> nast2)
     C                             and (xxue# <> naue#3 or
     C                              xxNcciStCode <> nast3)
    C*
     C                   select
    C*
     C                   when      nast1 = *blanks
     C                   movel     xxue#         naue#
     c                   move      xxNcciStCode  NAst1
     C                   move      'Y'           xxchg
    C*
     C                   when      nast2 = *blanks
     C                   movel     xxue#         naue#2
     c                   move      xxNcciStCode  NAst2
     C                   move      'Y'           xxchg
    C*
     C                   when      nast3 = *blanks
     C                   movel     xxue#         naue#3
     c                   move      xxNcciStCode  NAst3
     C                   move      'Y'           xxchg
    C*
     C                   other
     C     naky1         reade     pna01                                  60
     C                   dow       *in60 = *off
     C                             and naname = *blanks
     C     naky1         reade     pna01                                  60
     C                   enddo
    C*
     C                   endsl
    C*
     C                   if        xxchg = 'Y'
     C                   move      'Y'           xxprin
     C                   else
     C                   if        *in60 = *on
     C                   movel     xxue#         naue#
     c                   move      xxNcciStCode  NAst1
     C                   clear                   naue#2
     C                   clear                   nast2
     C                   clear                   naue#3
     C                   clear                   nast3
     C                   Movel(p)  SVNAM4        NANAM4
     C                   Move      xnsus#        nasus#
     C                   eval      nasus# = nasus# + 1
     C                   clear                   namadt
     C                   movel     xnsav         naname
     C                   move      xnsav         nanam3
     C                   clear                   nanam2
     C                   move      xnfein        nafein
     C                   move      xnlegn        nalegn
     C*** begin add ***  10/15/25  **********************************************
     C                   Move      xnnamp        nanamp
     C*** end add *****  10/15/25  **********************************************
     C                   write     pna01
     C                   write     pna02
     C                   move      'Y'           xxprin
     C                   endif
    C*
     C                   endif
    C*
     C                   else
     C                   move      *on           *in60
     C                   endif
    C*
     C                   enddo
    C*
     C                   move      *on           *in60
     C                   endif
    C*
     C                   endsr
    C*
    C*====================================================================
    C*====================================================================
     C     njaue#        begsr
    C*
    C* UPDATE NAME/ADDRESS RCD WITH NEXT TAX ID IF NECESSARY.
    C*
     c                   move      *blanks       xxue#
     C                   If        xrefdt <> xrexdt
     C                   SELECT
