     c                   if        expppc = 'S'
     c                   move      *on           *in68
     c                   endif
     C                   else
     C                   clear                   xxrmrk
     C                   movel(p)  'Agent#'      exahdr
     C                   endif
     C                   movel(p)  exahdr        xxahdr
    C*
    C*  GET ELECTRONIC SUBMISSION FLAG AND DARTS COMMENT CODE
    C*
     C                   movel     'WC'          xxsyk
     C     syky          chain     swc01                              60
    C*
    C*  OPEN FILES NEEDED ONLY FOR ELECTRONIC REPORTING
    C*
     C                   if        wcfl03 = 'Y'
     C                   open      wxnhp
     C                   open      wxnxp
     C                   open      wxnal
     C                   open      wxnal1
     C                   open      wxnal11
     C                   open      wtddl2
     C                   endif
     C                   move      *off          *in59
     C                   if        wcfl18 = 'Y'
     C                   move      *on           *in59
     C                   endif
     C                   Clear                   pnPrint           1
     C                   If        %subst(WCSC04:1:1) = 'Y'
     C                   Eval      pnPrint = 'Y'
     C                   Endif
    C*
    C*  Set indicator based on system control flag WCFL14
     C                   eval      *in45 = wcfl14 = 'Y'
    C*
    C*  GET OFFICE INSTALL FLAG
    C*
     C                   movel     'SY'          xxsyk
     C     syky          chain     ssy01                              60
    C*
    C*  ESTABLISH MAXIMUM FORMS ALLOWED
    C*
     C                   eval      xxmxsp = 9000
    C*
    C*  DETERMINE IF PROCESSING FOR MID TERM ENDORSEMENTS
    C*
     C     *dtaara       define    *lda          svlda
     C                   in        svlda
     C                   out       svlda
    C*
     C                   if        ldpbcg = *on
     C                   move      *on           xxpbcg
     C                   move      *on           *in32
     C                   else
     C                   move      *off          xxpbcg
     C                   endif
    C*
     C                   if        ldowcg = *on
     C                   move      *on           xxowcg
     C                   move      *on           *in32
     C                   else
     C                   move      *off          xxowcg
     C                   endif
    C*
    C* NECESSARY TO AVOID POSSIBLE DATA DECIMAL ERROR
    C*
     C                   if        xxpbcg = *off
     C                             and xxowcg = *off
     C                   in        svlda
     C                   clear                   ldeedt
     C                   move      *blanks       ldenda
     C                   out       svlda
     C                   endif
    C*
      /Free
       isContri = GetPrmContFlg(xxCo#:xxFnd);
       If isContri = '1';
          *in58 = *off;
       Else;
          *in58 = *on;
       Endif;
      /End-free
     C                   endsr
    C*
    C*====================================================================
    C* Check for division cancellation/reporting status.
    C*====================================================================
     C     CheckCXStatus Begsr
    C*
     c                   move      elrtcd        xxrtcd
     c     rsky          chain     prs01                              60
     C                   movel(p)  rsjrst        xzst
     C                   movel(p)  'NCCI'        xxtbid
     C                   movel(p)  rsjrst        xxkey
     C     gtky          chain     pgt01                              60
     C                   If        *in60 = *off
     C                   move      'XX'          xzst
     C                   Endif
    C*
      /free
       processMe = *off;

       //* Check for cx detail record.
       Setgt (ELCo#:ELFnd:ELFyr:ELEmp#:ELDiv) pcx00;
       Readpe(n) (ELCo#:ELFnd:ELFyr:ELEmp#:ELDiv) pcx00;
       If %eof;
          cxcdat = xadldt;
          cxitm = *hival;
       Endif;

       //* Check for submission detail record.
       Setgt (ELCo#:ELFnd:ELEmp#:ELFyr:'P':xzst) ps101;
       Readpe(n) (ELCo#:ELFnd:ELEmp#:ELFyr:'P':xzst) ps101;

       //* Process the division if its not cancelled, or its cancelled and
       //* the cancellation date was written after last submission,
       //* or the state has never submitted.

       If xadldt = 0 or (xadldt <> 0 and (cxcdat > s1sbdt or (cxcdat =
        s1sbdt and cxitm > s1sbtm))) or %eof(wdshl1);
          processMe = *on;
       Endif;

      /end-free
     C                   Endsr
     C*** begin add ***  10/16/25  ************************************************
    C*====================================================================
    C* Check for additional location/named insured cancellation/reporting status.
    C*====================================================================
     C     CheckCXStatAdlBegsr
    C*
     c                   move      elrtcd        xxrtcd
     c     rsky          chain     prs01                              60
     C                   movel(p)  rsjrst        xzst
     C                   movel(p)  'NCCI'        xxtbid
     C                   movel(p)  rsjrst        xxkey
     C     gtky          chain     pgt01                              60
     C                   If        *in60 = *off
     C                   move      'XX'          xzst
     C                   Endif
    C*
      /free
       processMe = *off;

       //* Check for submission detail record.
       Setgt (ELCo#:ELFnd:ELEmp#:ELFyr:'P':xzst) ps101;
       Readpe(n) (ELCo#:ELFnd:ELEmp#:ELFyr:'P':xzst) ps101;

       //* Process if its not cancelled, or its cancelled and
       //* the cancellation date was written after last submission,
       //* or the state has never submitted.

       If xadldt = 0 or (xadldt <> 0 and (xxTrdt > s1sbdt or (xxTrdt =
        s1sbdt and xxTrtm > s1sbtm))) or %eof(wdshl1);
          processMe = *on;
       Endif;

      /end-free
     C                   Endsr
     C*** end add *****  10/16/25  ************************************************
    C*====================================================================
     C     DefAddress    begsr
     C* Default address line 1 when there is a state but no address
