     C                             or xna100 = xxf100
     C                             and rsjrst = 'NJ'
     c                             and xxpeon <> 'Y'
     C                   move      'Y'           xfname
     C                   eval      xfencd = naencd
     C                   eval      xfnlkc = nanlkc
    C*
     C                   Eval      xxchg = ' '
