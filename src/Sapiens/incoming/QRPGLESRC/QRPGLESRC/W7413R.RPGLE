     C                   move      xxfyr         nxfyr
     C                   move      xxunid        nxunid
     C                   move      xxmst         nxst
     C                   move      rrdtrc        nxclas

     C                   exsr      srCommon
     C* If no rate change for domestic in array strtcg then process as existing
     C                   if         (tcdtr1 = tcdtr2 and (tcdtr2 = tcdtr3  or
     C                               tcdtr3 = 0)) or (tcdtr2 = 0 and tcdtr3 = 0)
     C*
     C                   If        ELdtrr <> 0
     C                   Eval(h)   nxrt = ELdtrr * 100
     C                   Else
     C                   if        RRTERL <> 'Y'
     c                   eval(h)   rrdtrr = rrdtrr * getLossCost(RRDTRC:
     c                                               getRateDate(elpfdt))
     C                   endif                                                      RRTERL IFNE
     C                   eval      nxrt = rrdtrr * 100
     C                   Endif
     C                   clear                   nxefdt
     C     NHANDT        IFNE      *ZERO
     C                   Z-ADD     NHANDT        NXEFDT
     C                   ENDIF
     C                   clear                   nxeapr
     C*** begin chg ***  06/20/24  ******************************************
     C******             eval      nxempr = tasdtr
     C******             if        xxminf = 'Y'
     C******                       and elpror <> 1
     C******                       and elpror <> 0
     C******             eval(h)   xxwk10 = elpror * nxempr
     C******             eval      nxempr = xxwk10
     C******             endif
    C******
     C******             if        tasdtr < 0
     C******             eval      nxempr = nxempr * -1
     C******             endif
     C                   eval      nxempr = tpsdtr
