     c                   eval      polperf = 'From'
     c                   eval      polpert = 'To'
     c                   eval      poltype = 'INFORMATION PAGE'
     c*
     C                   eval      prtDate = AlphaUSA(CvtToDate(xxdate))
     C                   eval      polFrD1 = polFrDt
     C                   eval      polToD1 = polToDt
     c*
     c                   if        grpAdr(3) = *blanks
     c                   move      grpAdr(2)     grpAdr(3)
     c                   move      grpAdr(1)     grpAdr(2)
     c                   move      *blanks       grpAdr(1)
     c                   endif
     c*
     c                   endif                                                  if prt132
     c*
     c   24              eval      polreis = 'REISSUE'
     c   25              eval      polrenw = 'RENEWAL AGREEMENT'
     c*
      /free
       If strPDt >= 1150101 ;
          decForm = 'WC000001A';
          decEDt  = 'Ed 0588';
       Else;
          decForm = 'WC000001B';
          decEDt  = 'Ed 0199'  ;
       Endif;

       If strPDt >= 1150101 ;
          decForm2 = 'WC000001B';
          decEDt2  = 'Ed 0199'  ;
       Else;
          decForm2 = 'WC000001A';
          decEDt2  = 'Ed 0588'  ;
       Endif;

       NJTaxID = xxTxID;

       If cltid = '114' and FNGrpAsc = 'AFN';

          premDisc  = -1 * premDisc;
          pageHd = 'Page';
          prtDtHd = 'Printed on';
          prtDate = AlphaUSA(CvtToDate(xxdate));
          cntSign = 'Countersigned by:  _________________________'+
           '________';
          minPremHd = 'Minimum Premium';
          depPremHd = 'Deposit Premium';

          If FNMAD1 <> *blanks;
             If FNMAD2 <> *blanks;
                GrpAddr = %trim(FNMAD1) + ' ' + %trim(FNMAD2) + ', '
                 + GetCityStZip(FNMCTY:FNMST:FNMZIP);
             Else;
                GrpAddr = %trim(FNMAD1) + ', '
                 + GetCityStZip(FNMCTY:FNMST:FNMZIP);
             Endif;
          Else;
             If FNPAD2 <> *blanks;
                GrpAddr = %trim(FNPAD1) + ' ' + %trim(FNPAD2) + ', '
                 + GetCityStZip(FNPCTY:FNPST:FNPZIP);
             Else;
                GrpAddr = %trim(FNPAD1) + ', '
                 + GetCityStZip(FNPCTY:FNPST:FNPZIP);
             Endif;
          Endif;

          evalr premText1 = 'Premium for increased limits Part Two, if +
           applicable';
          evalr premText2 = 'Total Premium subject to experience modification';
          evalr premText3 = 'Premium modified to reflect experience modifica+
           tion of _____________';
          evalr premText4 = 'Other premium charges _________________________+
           ____________________';
          evalr premText5 = 'Total Estimated Standard Premium';
          evalr premText6 = 'Premium Discount, If applicable,__________%';
          evalr premText7 = 'Expense Constant Charge';
          evalr premText8 = 'Total Estimated Premium';
          evalr premText9 = 'Second Injury Fund Surcharge';
          evalr premText0 = 'Uninsured Employers Fund Surcharge';
          evalr premTextA = 'Total Estimated Cost';

          premText1$ = '$';
          premText2$ = '$';
          premText3$ = '$';
          premText4$ = '$';
          premText5$ = '$';
          premText6$ = '$';
          premText7$ = '$';
          premText8$ = '$';
          premText9$ = '$';
          premText0$ = '$';
          premTextA$ = '$';

       Endif;

       If unitedWis;

          mailHd1 = 'Mailing';
          mailHd2 = 'Address';
          mailHd3 = 'Mailing';
          mailHd4 = 'Address';

          modExPrm  = tam(4) - tam(41);
          premDisc  = -1 * premDisc;
          annPrem   = tam(22);

          grpName = CenterFld(grpName);
          If FNMAD1 <> *blanks;
             If FNMAD2 <> *blanks;
                GrpAddr = CenterFld(%trim(FNMAD1) + ' ' + %trim(FNMAD2) + ', '
                 + GetCityStZip(FNMCTY:FNMST:FNMZIP));
             Else;
                GrpAddr = CenterFld(%trim(FNMAD1) + ', '
                 + GetCityStZip(FNMCTY:FNMST:FNMZIP));
             Endif;
          Else;
             If FNPAD2 <> *blanks;
                GrpAddr = CenterFld(%trim(FNPAD1) + ' ' + %trim(FNPAD2) + ', '
                 + GetCityStZip(FNPCTY:FNPST:FNPZIP));
             Else;
                GrpAddr = CenterFld(%trim(FNPAD1) + ', '
                 + GetCityStZip(FNPCTY:FNPST:FNPZIP));
             Endif;
          Endif;

          polPerd = 'The policy is from ' + %trim(polFrDt) + ' to ' +
           %trim(polToDt) + ' 12:01 A.M. Standard Time, at the ' +
           'Insured''s mailing address.';

          item3C1c = xxPP3C;
          item3C2c = xxPPC3;

          If isContri = '1';
             adjHead = 'If Indicated Below, Interim Adjustment of Contribu' +
              'tion shall be made:';
          Else;
             adjHead = 'If Indicated Below, Interim Adjustment of Premium ' +
              'shall be made:';
          Endif;
          servOHd = 'Issuing Office:';
          servOff = xxofad100;
          prtDtHd = 'Date Printed:';
          prtDate = AlphaUSA(CvtToDate(xxdate));
          cntSign = 'Countersigned by:  _________________________'+
           '___________';

          If (xxPolst = 'NJ' and strPDt < 1150101) or
           (xxPolSt <> 'NJ' and strPdt >= 1150101);
             decForm = 'WC 00 00 01 B';
             decEDt  = '(Ed. 01-10)';
          Else;
             decForm = 'WC 00 00 01 A';
             decEDt  = '(Ed. 08-10)';
          Endif;

          decFormT = decForm;
          decEDtT  = decEdt;

       Endif;

       Clear xxamn2b;
       Clear grpNameS;
       Clear grpAdr1S;
       Clear grpAdr2S;
       Clear grpNameW;
       Clear grpAdr1W;
       Clear grpAdr2W;
       Clear chkindiv;
       Clear chkpart;
       Clear chkcorp;
       Clear chkoth;
       Clear typeBus;
       Clear grpBrck1;
       Clear grpBrck2;
       Clear grpBrck3;
       Clear grpBrck4;
       Clear grpBrck5;
       Clear grpBrck6;
       Clear grpBrck7;
       Clear grpBrck8;
       Clear grpBrck9;
       Clear grpBrck0;
       Clear ncciVal;
       Clear ncciHdg;
       Clear ncciVal2;
       Clear ncciHdg2;
       Clear entVal;
       Clear entHdg;
       Clear intVal;
       Clear intHdg;
       Clear rskHdg;
       Clear sicVal;
       Clear sicHdg;

       If amTrust;

          Select;
          When xxPolSt = 'NJ';
             form#AM = 'WC 00 00 01 B';
          When xxPolSt = 'FL';
             form#AM = 'WC 00 00 01 A';
          Other;
             form#AM = 'WC 99 00 01 B';
          Endsl;

          If xxPolSt <> 'NJ' and xxPolSt <> 'FL';
             grpBrck1 = x'BA';
             grpBrck2 = x'BB';
             grpBrck3 = x'BA';
             grpBrck4 = x'BB';
             grpBrck5 = x'BA';
             grpBrck6 = x'BB';
             grpBrck7 = x'BA';
             grpBrck8 = x'BB';
             grpBrck9 = x'BA';
             grpBrck0 = x'BB';
          Endif;

          If FNGrpAsc = 'WIC';
             grpNameW = grpName;
             grpAdr1W = '874 Walker Rd, Suite C';
             grpAdr2W = 'Dover, DE 19904';
          Else;
             grpNameS = grpName;
             grpAdr1S = 'PO Box 655028';
             grpAdr2S = 'Dallas, TX 75251';
          Endif;

          *in39 = *off;

          If xxPolSt = 'NJ' or xxPolSt = 'FL';
             rskHdg = 'Board File Number:';
             ncciHdg2 = 'Ncci Code:';
             ncciVal2 = %editc(F2CAR#:'X');
             If xxPolSt = 'NJ';
                *in39 = *on;
                ncciHdg = 'NJ Tax Id. #:';
                ncciVal = xxtxid;
             Endif;
             If xxPolSt = 'FL';
                intHdg = 'Interim Adjustment:';
                intVal = 'Annual';
                entHdg = 'Entity:';
                entVal = xxbtyp4;
                sicHdg = 'SIC Code:';
                sicVal = xxSic;
             Endif;
          Else;
             rskHdg = 'Risk Id:';
             ncciHdg = 'Ncci Code:';
             ncciVal = %editc(F2CAR#:'X');
          Endif;

          If EMFDN2 <> ' ' or EMFDNM = ' ' and EMNAM2 <> ' ';
             xxAMN2B = xxAMN2;
             xxAMN2 = ' ';
          Endif;

          If xxPolSt = 'FL';
             *in38 = *on;
          Else;
             *in38 = *off;
             Select;
             When EMTPOB = '1';
                chkindiv = 'X';
             When EMTPOB = '2';
                chkpart  = 'X';
             When EMTPOB = '3';
                chkcorp  = 'X';
             Other;
                chkoth  = 'X';
                typeBus = xxbtyp4;
             Endsl;
          Endif;

          polEffDt = polFrDt;
          polExpDt = polToDt;

          annprem0 = annprem;
          assprem0 = tam(21);
          totprem0 = annprem + tam(21);
          minprem0 = minprem;
          depprem0 = depprem;
          prtDate = AlphaUSA(CvtToDate(xxdate));

       Endif;

      /end-free
