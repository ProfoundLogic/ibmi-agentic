      /Free
          //Beg Chg *** 08/05/13 ****************************************
          EUICDind  = scICdind;
          If xxICD10 = '1' and scICdInd ='Y';
          //End Chg *** 08/05/13 ****************************************
             EUICD1001 = scDIa1;
             // If ICD10 is Active then no need of ICD9 fields
             EUDIA1 = *Blanks;
          //Beg Chg *** 08/05/13 ****************************************

          Else;
             EUDIA1 = scDIa1;
             // If ICD9 is Active then no need of ICD10 fields
             EUICD1001 = *Blanks;
