    H/TITLE LODSTSSP - Convert Data from WTSFP and Member list to STSSP
     H*********************************************************************
     H*  Created:  08/14/12    C:282   Project: WC2030
    H*********************************************************************
     H* REVISED:
     H*
     H* 06/08/15 C:280 Phaseware: 34144 inhouse
     H*                Change to user open on wcms only
    H*********************************************************************

     Fsmcop     if   e             disk    rename(pco01:pco0p)
     f***** Beg Chg 06/08/15 ******************************************

     F***** wtsfl     if   e           k disk    rename(psf01:psf00)
     Fwtsfl     if   e           k disk    rename(psf01:psf00) usropn

     f***** End Chg 06/08/15 ******************************************
     Fstssp     o    e             disk    rename(pss01:pss0p)
     Fstssl1    uf a e           k disk    rename(pss01:pss00)

     d #ofFiles        c                   468
     d fileDesc        s             70    dim(#ofFiles) ctdata perrcd(1)

     d intCo#          s              3  0
     d strCtId         s             10

     dfileInfo         ds
     d seq                            7a
     d   blank01                      1a
     d ctid                                like(ssctid)
     d   blank02                      1a
     d desc                                like(ssdesc)

     d i1              s              3  0

     D***** Beg Add 06/08/15 ******************************************
     d GetSysflg       pr                  extpgm('SA001R')
     d ##wcif                         1A
     d ##mcif                         1A
     d ##wcin                         1A
     d ##ar                           1A
     d ##ntwk                         1A
     d ##ur                           1A
     d ##med                          1A
     d ##edi                          1A
     d ##wckd                         1A
     d ##rhab                         1A
     d ##mss                          1A
     d ##fsch                         1A
     d ##prvb                         1A
     d ##npwc                         1A
     d ##os                           1A
     d ##arls                         1A
     d ##ccod                         1A
     d ##cchk                         1A
     d ##prom                         1A
     d ##mcrv                         1A
     d ##freq                         1A
     d ##crac                         1A
     d ##preo                         1A
     d ##parn                         1A
     d ##mgri                         1A
     d ##kcif                         1A
     d ##curs                         1A
     d ##pcib                         1A
     d ##clt#                         1A
     d ##ucpf                         1A
     d ##dcf                          1A
     d ##autb                         1A
     d ##deif                         1A
     d ##aure                         1A
     d ##cred                         1A
     d ##idrt                         1A
     d ##cprv                         1A
     d ##eft                          1A
     d ##govr                         1A
     d ##ncdc                         1A
     d*---------------------------------------------------
     d ##wcif          s              1A   inz(*blanks)
     d ##mcif          s              1A   inz(*blanks)
     d ##wcin          s              1A   inz(*blanks)
     d ##ar            s              1A   inz(*blanks)
     d ##ntwk          s              1A   inz(*blanks)
     d ##ur            s              1A   inz(*blanks)
     d ##med           s              1A   inz(*blanks)
     d ##edi           s              1A   inz(*blanks)
     d ##wckd          s              1A   inz(*blanks)
     d ##rhab          s              1A   inz(*blanks)
     d ##mss           s              1A   inz(*blanks)
     d ##fsch          s              1A   inz(*blanks)
     d ##prvb          s              1A   inz(*blanks)
     d ##npwc          s              1A   inz(*blanks)
     d ##os            s              1A   inz(*blanks)
     d ##arls          s              1A   inz(*blanks)
     d ##ccod          s              1A   inz(*blanks)
     d ##cchk          s              1A   inz(*blanks)
     d ##prom          s              1A   inz(*blanks)
     d ##mcrv          s              1A   inz(*blanks)
     d ##freq          s              1A   inz(*blanks)
     d ##crac          s              1A   inz(*blanks)
     d ##preo          s              1A   inz(*blanks)
     d ##parn          s              1A   inz(*blanks)
     d ##mgri          s              1A   inz(*blanks)
     d ##kcif          s              1A   inz(*blanks)
     d ##curs          s              1A   inz(*blanks)
     d ##pcib          s              1A   inz(*blanks)
     d ##clt#          s              1A   inz(*blanks)
     d ##ucpf          s              1A   inz(*blanks)
     d ##dcf           s              1A   inz(*blanks)
     d ##autb          s              1A   inz(*blanks)
     d ##deif          s              1A   inz(*blanks)
     d ##aure          s              1A   inz(*blanks)
     d ##cred          s              1A   inz(*blanks)
     d ##idrt          s              1A   inz(*blanks)
     d ##cprv          s              1A   inz(*blanks)
     d ##eft           s              1A   inz(*blanks)
     d ##govr          s              1A   inz(*blanks)
     d ##ncdc          s              1A   inz(*blanks)

     D***** End Add 06/08/15 ******************************************

     d psds          esds                  extname(szq1p)

     d/copy sPrDate

      **************************************************************
      * KLIST
      **************************************************************
     c     keyWTSFL      klist
     c                   kfld                    coco#
      *
     c     keySTSSL1     klist
     c                   kfld                    intCo#
     c                   kfld                    strCtId
      **************************************************************
      * Main
      **************************************************************
      /free

       //** Beg Add 06/08/15 ******************************************
         GetSysflg (##wcif :##mcif :##wcin :##ar
                    :##ntwk :##ur :##med :##edi :##wckd
                    :##rhab :##mss :##fsch :##prvb :##npwc
                    :##os :##arls :##ccod :##cchk :##prom
                    :##mcrv :##freq :##crac :##preo :##parn
                    :##mgri :##kcif :##curs :##pcib :##clt#
                    :##ucpf :##dcf :##autb :##deif :##aure
                    :##cred :##idrt :##cprv :##eft :##govr
                    :##ncdc);

         if ##wcif = 'Y';

           open wtsfl;

       //** End Add 06/08/15 ******************************************

       // Reading the record from System company file (SMCOP)
       Setll  1  pco0p;
       Read      pco0p;
       Dow Not %EOF(SMcop);
          Exsr  Process;
       Read      pco0p;
       Enddo;

       //** Beg Add 06/08/15 ******************************************

         close wtsfl;

         EndIf;

       //** End Add 06/08/15 ******************************************

       *InLr = *On;

      /end-free
     C*====================================================================
     C* Process each company
     C*====================================================================
      /free
       Begsr Process;

       // Writing the record from WTSFL into STSSP.
          Setll keyWTSFL psf00;
          Reade keyWTSFL psf00;
          Dow Not %EOF(WTsfl);
             Exsr  WriteRecord;
          Reade keyWTSFL psf00;
          Enddo;

       // Writing *Global record in file STSSP.
          Exsr WriteGRecord;

       // Writing record in file STSSP from Compile time array.
          intCo# = CoCo#;
          i1 = 1;
          Dow #ofFiles >= i1;
             fileInfo = fileDesc(i1);
             strCtId = CtId;

             Chain keySTSSL1 pss00;
             If Not %found(STssl1) And (CtId <> *blanks) And (CoCo# <> 0);
                Exsr WriteRecordCA;
             EndIf;
          i1 = i1 + 1;
          EndDo;

       Endsr;
      /end-free
      *====================================================================
      * Write records to STSSP from file WTSFP
      *====================================================================
      /free
       Begsr WriteRecord;

        Clear pss0p;

        SSco#  = SFco#;
        SSctid = SFrpid;
        SSdesc = SFdesc;
        SSmask = SFflag;
        SSlvl1 = SFlvl;
        SSty01 = SFty01;
        SSlvl2 = SFlvl;
        SSty02 = SFty02;
        SSlvl3 = SFlvl;
        SSty03 = SFty03;
        SSlvl4 = SFlvl;
        SSty04 = SFty04;
        SSlvl5 = SFlvl;
        SSty05 = SFty05;
        SSlvl6 = SFlvl;
        SSty06 = SFty06;
        SSstat = 'A';

        SSipgm = q1pgm;
        SSiusr = q1user;
        SSidt  = DateTo7(SystemDate);
        SSitim = TimeTo6(SystemTime);
        SSpgm  = q1pgm;
        SSuser = q1user;
        SSdt   = DateTo7(SystemDate);
        SStime = TimeTo6(SystemTime);

        Write  pss0p;

       Endsr;
      /end-free
      *====================================================================
      * Write *GLOBAL record in file STSSP
      *====================================================================
      /free
       Begsr WriteGRecord;

        Clear pss0p;

        SSco#  = COco#;
        SSctid = '*GLOBAL';
        SSdesc = 'Global Default';
        SSmask = 'Y';
        SSlvl1 = 001;
        SSty01 = '*';
        SSstat = 'A';

        SSipgm = q1pgm;
        SSiusr = q1user;
        SSidt  = DateTo7(SystemDate);
        SSitim = TimeTo6(SystemTime);
        SSpgm  = q1pgm;
        SSuser = q1user;
        SSdt   = DateTo7(SystemDate);
        SStime = TimeTo6(SystemTime);

        Write  pss0p;

       Endsr;
      /end-free
      *====================================================================
      * Write records to STSSP from file compile time array
      *====================================================================
      /free
       Begsr WriteRecordCA;

        Clear pss0p;

        SSco#  = COco#;
        SSctid = CtId;
        SSdesc = Desc;
        SSstat = 'I';

        SSipgm = q1pgm;
        SSiusr = q1user;
        SSidt  = DateTo7(SystemDate);
        SSitim = TimeTo6(SystemTime);
        SSpgm  = q1pgm;
        SSuser = q1user;
        SSdt   = DateTo7(SystemDate);
        SStime = TimeTo6(SystemTime);

        Write  pss0p;

       Endsr;

      /end-free

