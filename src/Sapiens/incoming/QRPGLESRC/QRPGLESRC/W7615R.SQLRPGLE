     C                   ENDIF
     C*
     C     EAKY2         READE     PEA02                                  60
     C                   END
     C*
     C*   FILL ARRAY IF BALANCE IS GREATER THAN 0.
     C*
     C     XXDUE         IFNE      0
     C     XXBAL         ANDGT     0
     C     *IN57         ANDNE     *ON
     C                   MOVEL     BSD(A)        XXPFDT
     C                   MOVE      'Due'         DUW(L)
     C                   EXSR      SRDUE
     C                   Z-ADD     XXDUE         AMT(L)
     C                   ADD       1             L
     C                   END
     C*
     C                   ADD       1             A
     C                   ADD       1             B
     C     B             IFNE      14
     C     BSD(B)        ANDNE     0
     C                   Z-ADD     0             XXDUE
     C                   GOTO      GETBAL
     C                   END
     C                   ELSE                                                   BSDOWK IFEQ
     C     BSFREQ        IFEQ      'T'
     C*
     C*  PROCESS TWICE A MONTH BILLING SCHEDULE CODES.
     C*
     C                   MOVEL(P)  TWICVB        INSTVB
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C                   Z-ADD     0             WKT
     C*
     C                   Z-ADD     ELBSDT        XXPFDT
     C*
     C* CHECK FOR FIRST INSTALLMENT ON/AFTER BILLING START DATE.
     C*
     C     DD            IFEQ      1
     C     DD            OREQ      15
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C     DD            IFLT      15
     C                   Z-ADD     15            DD
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ELSE
     C*
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ENDIF                                                  DD IFLT
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C                   Z-ADD     1             T                 3 0
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C* BUILD DATE ARRAY WITH EACH INSTALLMENT DATE.
     C*
     C     XXPFDT        DOWLT     ELPTDT
     C*
     C     DD            IFEQ      1
     C                   Z-ADD     15            DD
     C                   ELSE
     C*
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C     XXPFDT        IFLT      ELPTDT
     C                   ADD       1             T
     C                   Z-ADD     XXPFDT        WKD(T)
     C                   ENDIF                                                  XXPFDT IFLT
     C*
     C                   ENDDO                                                  XXPFDT DOWLT
     C*
     C                   ENDIF                                                  WKD,1 IFGE
     C*
     C* BILL EACH INSTALLMENT INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             X1INST           11 2
     C                   Z-ADD     0             Y
     C                   Z-ADD     0             ZZ                3 0
     C*
     C     1             DO        53            U
     C*
     C     WKD(U)        IFGE      XXYMD
     C*
     C     Y             IFLT      2
     C*
     C                   ADD       1             Y
     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
     C*
     C     Y             IFEQ      1
     C     EAKY2         CHAIN     PEA02                              60
     C*
     C     EAPODT        DOWLE     WKD(U)
     C     *IN60         ANDEQ     '0'
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     EAARTY        IFEQ      'B'
     C     EAARTY        OREQ      'A'
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     EAarcd        Andne     F1dvbl
     C                   ADD       EAAMT         AMT(1)
     C                   ENDIF                                                  *IN60 IFEQ 0
     C                   END
     C*
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'T'                                                      EES
     C     TTTYPE        ANDEQ     'F'                                                      EES
     C                   ADD       EAAMT         AMT(1)
     C                   ENDIF
     C                   ENDIF
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      '1'                                                      EES
     C     TTTYPE        ANDEQ     'F'                                                      EES
       //*** Begin Add *** 06/12/24 **********************************
       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs;
       //*** End   Add *** 06/12/24 **********************************
     C                   ADD       EAAMT         AMT(1)
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
     C                   ENDIF
     C                   ENDIF
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      '2'                                                      EES
