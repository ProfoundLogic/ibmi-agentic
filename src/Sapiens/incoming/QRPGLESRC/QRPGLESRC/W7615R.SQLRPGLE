     C                   MOVE      EMEMP#        XXEMP#
     C                   MOVE      EMDIV         XXDIV
     C     ELKEY         CHAIN(N)  PEL01                              60
     C                   eval      x#RRN = dbRRN
       //*** Begin Add *** 06/12/24 ****************************************
       // Check to see if SR and if SR Assessments is off
       isSRAs = *Off;
       xxKey = %EditC(ELbsCd:'X');
       Chain (xxCo#:xxKey) pbs01;
       If %Found(wtabl) And BSseFl = 'S';
          If ELsrAs = ' ';
          //*** begin chg ***  01/29/25  ****************************
          //*****   Chain (xxCo#:xxFnd) pf101;
          //*****   If %Found(wdf1l) And F1SRAs = 'Y';
             If F1SRAs = 'Y';
          //*** begin chg ***  01/29/25  ****************************
                isSRAs = *On;
             EndIf;
          Else;
             isSRAs = *On;
          EndIf;
       EndIf;
       //*** End   Add *** 06/12/24 ****************************************
     C*
     C     *IN60         CABEQ     '1'           ENDA
     C                   Z-ADD     *ZEROS        XXBAT#            9 0
     C     SVEMP#        IFNE      *ZEROS
     C     ELAMIN        ANDNE     *ZEROS
     C     ELKEY         CHAIN     PEL01                              60
     C     *IN60         IFEQ      *OFF
     C                   Z-ADD     ELAMIN        XXBAT#
     C                   CLEAR                   ELAMIN
     C                   UPDATE    PEL01
     C                   ENDIF                                                  *IN60 IFEQ *OFF
     C                   ENDIF                                                  SVEMP# IFNE 0
       // Update final quote flag
       If qqQte = 'Q' And qqFqt = 'Y' And svEmp# <> 0;
          Chain elKey pel01;
          If %Found(wdell);
             ELfQte = 'Y';
             Update pel01;
          EndIf;
       EndIf;
     C*
     c*
     c* Print Deductible, Exp Modifier, and Limits info on all bills except summary bill.
     c*
     C                   MOVE      *OFF          *IN58
     C     ELARSM        IFEQ      'Y'
     C                   MOVE      *ON           *IN57
      *
      * GET POLICY DAYS FROM STATE REPORTING DIVISION
      *
     C                   Z-ADD     EMDIV         SVDIV
     C     EMKEY1        CHAIN     PEM01                              60
     C     *IN60         DOWEQ     *OFF
      *
     C     EMSTRP        IFEQ      'Y'
     C                   Z-ADD     EMDIV         XXDIV
     C                   Z-ADD     EMDIV         XSDIV
     C                   LEAVE
     C                   ENDIF
      *
     C     EMKEY1        READE     PEM01                                  60
     C                   ENDDO
     C*
     C*  GET NUMBER OF EMPLOYER POLICY DAYS
     C*
     C     ELKEY         CHAIN(N)  PEL01                              60
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        SRPDAY            5 0
     C                   Z-ADD     SVDIV         XXDIV
     C     EMKEY         CHAIN     PEM01                              60
     C     ELKEY         CHAIN(N)  PEL01                              60
     C*
     C                   ENDIF
     C                   Z-ADD     0             XXRCTL
     C                   Z-add     0             depDays           3 0
     C                   MOVE      XXFND         QPFND
     C                   MOVE      XXEMP#        QPEMP#
     C                   MOVE      XXFYR         QPFYR
     C     ELFAF         IFEQ      'R'
     C                   MOVE      QQDUED        XXDUED
     C                   ELSE
     C*
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXDUED            8 0
     C*
     C     XXDAYS        IFGT      *ZERO
     C*
     C     ELARSM        IFNE      'Y'
     C                   MOVE      *ON           *IN72
     C                   ENDIF
     C*
     C                   TIME                    DSDTTM
     C                   Z-ADD     DSDATE        XXDT
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      XXDT          QQDT              8 0
     C                   PARM      XXDAYS        QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXFUTD            7 0
      *
     C     XXFUTD        IFGT      ELBSDT
     C                   MOVE      QQDT          XXDUED
     C                   Z-add     xxDays        depDays
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1DATE            7 0
     C*
     C                   If        x1date < elbsdt
     C*
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     XXFUTD        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   If        qqDays < xxDays
     C                   Z-add     qqDays        depDays
     C                   Endif
     C*
     C                   Endif
     C                   ELSE
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXDUED
     C                   ENDIF
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXDAYS IFGT
     C*
     C                   ENDIF                                                  ELFAF IFEQ
     C                   Z-ADD     0             XXDUDT
     C                   MOVEL     XXDUED        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXDUDT            7 0
     C*
     C*  CHECK IF EMPLOYER IS CANCELLED
     C*

      /Free
       intCxDate = GetCxDate(ELco#:ELfnd:ELemp#:ELdiv);
       *in60 = *off;
       Select;
       When intCxDate = 0;
       When OvrRenewalCx(xxMode:xxCo#:xxFnd:xxEmp#:
        xxDiv:xxFyr:intCxDate) = *Off;
          *in60 = *on;
       Endsl;
      *** Beg Add ***  10/15/24  ***  WC2984  ************************
       // Turning *In60 = *On, will allow single division bill to run
       // on a deleted employer as long as it was submitted from the
       // prompt screen as a single division and was unbilled.

       If *In60 = *On and *In59 = *On;
          *In60 = *Off;
       EndIf;

      *** End Add ***  10/15/24  ***  WC2984  ************************
      /End-Free
     C                   If        *in60 = *on
     C                   Goto      ENDA
     C                   Endif

     C     BLKEY2        CHAIN(N)  PBL01                              60
     C     *IN60         IFEQ      *OFF
     C     QQSTEP        IFGT      '0'
     C     BLSTEP        ANDGE     QQSTEP
     C                   GOTO      ENDA
     C                   ENDIF                                                  QQSTEP > '0'
     C                   ENDIF                                                  *IN60 IFEQ
     C     ELARSM        IFEQ      'Y'
     C                   MOVE      'Y'           XXSUM
     C                   ENDIF
     C     XXNEWF        IFEQ      'Y'
     C                   OPEN      W7615O
     C                   MOVE      *ON           XX1ST             1
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C*
     C     QQDART        IFEQ      'Y'
     C     XXNEWF        ANDEQ     *BLANK
     C     TURN          IFEQ      1
     C                   OPEN      QSYSPRT
     C                   MOVE      *ON           *INOF
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'
     C                   PARM                    QCA(3)
     C                   PARM                    LENGTH           15 5
     C                   Z-ADD     *ZEROS        XXPAGE            3 0
     C                   ENDIF                                                  TURN EQ 1
     C                   ENDIF                                                  DART EQ 'Y'
     C                   Z-ADD     Q4SPL#        XXSPL
     C                   Z-ADD     0             XXPAG4            3 0
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTO              8 0
     C                   Z-ADD     ELEMD1        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXEMD1            8 0
     C                   Z-ADD     ELEMD2        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXEMD2            8 0
     C                   Z-ADD     ELEMD3        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXEMD3            8 0
     C*** begin add ***  10/25/25  *****************************************
     C                   Clear                   noPayrollBill     1
     C*** end add *****  10/25/25  *****************************************

      //*** Beg Add ***** 09/01/23 *************************************
       If isUseXml;
          //Check if active Payroll record found for this division.
          flgPyrlExist = 'N';
          Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pep07;
          If %Found(wmepl7);
             flgPyrlExist = 'Y';
          //*** begin add ***  10/25/25  **********************************
          Else;
             flgPyrlExist = 'Y';
             noPayrollBill = 'Y';
          //*** end add *****  10/25/25  **********************************
          Endif;
          If saveEmp# <> EMemp#;
             Clear xmlBillName;
             Clear xmlSumName;
             Clear xmlCombName;
             Clear xmlSumCombName;
             Clear xmlRetroName;
             Clear xmlCombRetroName;
             Clear outputFile;
             Clear intBLKeyPyrlS;
             Clear strXPFile;
             Clear strXPDir;
             Clear strXPFileComb;
             Clear strXPDirComb;
             //*** Begin Add *** 05/07/24 ************************************
             Clear strXPFileSRD;
             Clear strXPDirSRD;
             isSummary = *Off;
             If xxSum = 'Y' and *In59 = *Off;
                isSummary =*On;
             Endif;
             //*** End   Add *** 05/07/24 ************************************
             saveEmp# = EMemp#;
          Endif;
          //Only generate XML if active payroll exist
          If flgPyrlExist = 'Y';
             Exsr ScriptXML;
          Endif;
          Clear intBLKeyPyrl;
       Endif;
      //*** End Add ***** 09/01/23 *************************************
      /free
       strMod = 'Mod '  ;
       strEffdt = 'Eff Dates';
       If ELARP1 <> 0 or ELARP2 <> 0 or ELARP3 <> 0;
          strARAP  = 'ARAP';
       Endif;
      /End-free
     C                   Z-ADD     ELEXM1        XXEXM1            5 4
     C                   Z-ADD     ELEXM2        XXEXM2            5 4
     C                   Z-ADD     ELEXM3        XXEXM3            5 4
     C                   Z-ADD     ELARP1        XXARP1            5 4
     C                   Z-ADD     ELARP2        XXARP2            5 4
     C                   Z-ADD     ELARP3        XXARP3            5 4
      /free
       Clear strMod1;
       Clear strMod2;
       Clear strMod3;
      /end-free
      /free
       //Only print first modifier if 1st Modifier is Rated (Elnoexm1 = ' ').
       //If IsActive(ELemd1);
       If IsActive(ELemd1) and Elnoexm1 = ' ';
          strMod1 = %editc(xxExm1:'2') + ' ' +
           %editc(xxArp1:'2') +
           '  ' + %char(%date(xxEmd1:*usa):*usa);
       Endif;
       //*** Begin Chg *** 07/30/23 ****************************************
       //*** If IsActive(ELemd2);
       //Only print first modifier if 2nd Modifier is Rated (Elnoexm2 = ' ').
       If IsActive(ELemd2) and Elnoexm2 = ' ';
       //*** End   Chg *** 07/30/23 ****************************************
          strMod2 = %editc(xxExm2:'2') + ' ' +
           %editc(xxArp2:'2') +
           '  ' + %char(%date(xxEmd2:*usa):*usa);
       Endif;
       //*** Begin Chg *** 07/30/23 ****************************************
       //*** If IsActive(ELemd3);
       //Only print first modifier if 3rd Modifier is Rated (Elnoexm3 = ' ').
       If IsActive(ELemd3) and Elnoexm3 = ' ';
       //*** End   Chg *** 07/30/23 ****************************************
          strMod3 = %editc(xxExm3:'2') + ' ' +
           %editc(xxArp3:'2') +
           '  ' + %char(%date(xxEmd3:*usa):*usa);
       Endif;
      /end-free

     C                   MOVEA     '000'         *IN(41)
     C*
     C*   IF ENTERED POST DT IS LESS THAN ELPFDT, THEN
     C*   OVERRIDE X@DATE FOR BILLING SCHEDULES
     C*
     C     XXYMD         IFLT      ELBSDT
     C                   Z-ADD     ELBSDT        XXYMD
     C                   END
     C                   MOVE      ELBSDT        XXBDAY            2 0
     C*
     C*  CHAIN FOR STAT RPT/RATING INFO
     C*
     C     RSKY          CHAIN     PRS01                              60
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   MOVE      RSJRST        XXST
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C                   Move      *off          *in49
     C*
     C* Set title for additional load for monopolistic states
     C*
     C                   If        RRMono = 'Y'
     C*
     C                   Select
     C                   When      cltid = '148'
     C                   Move      *on           *in49
     C                   Endsl
     C*
     C                   Endif
     c*
     c* Set the terrorism heading fields to optional or default heading.
     c*
     c                   if        rrterh <> *blanks
     c                   movel(p)  rrterh        con(33)
     c                   else
     c                   movel(p)  svterh        con(33)
     c                   endif
     c
     c                   if        rrdtrh <> *blanks
     c                   movel(p)  rrdtrh        con(40)
     c                   else
     c                   movel(p)  svdtrh        con(40)
     c                   endif
     C     EPKEY         CHAIN     PRP01                              60
     C     *IN60         IFEQ      *OFF
     C     RPCAP#        ANDNE     *BLANKS
     C                   MOVEL(P)  RPCAP#        XXCAP#           25
     C                   MOVE      *ON           *IN66
     C                   ELSE
     C                   MOVE      *BLANKS       XXCAP#
     C                   MOVE      *OFF          *IN66
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   Z-ADD     ELMFEE        F1MFEE
     C*
     C                   Z-ADD     XXCO#         @@CO#
     C                   Z-ADD     XXFND         @@FND
     C                   Z-ADD     XXEMP#        @@EMP#
     C                   Z-ADD     XXDIV         @@DIV
     C                   Z-ADD     XXFYR         @@FYR
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         @@DATE
     C                   MOVEL     '*'           @@PLAN
      *
     C                   CALL      'WA002R'
     C                   PARM                    @@CO#             3 0
     C                   PARM                    @@FND             3 0
     C                   PARM                    @@EMP#            9 0
     C                   PARM                    @@DIV             5 0
     C                   PARM                    @@FYR             3 0
     C                   PARM                    @@AGT#            5 0
     C                   PARM                    @@ANAM           60
     C                   PARM                    @@PROD            5 0
     C                   PARM                    @@PNAM           60
     C                   PARM                    @@AREA            3 0
     C                   PARM                    @@PHON            7 0
     C                   PARM                    @@PLAN            1
     C                   PARM                    @@DATE            8 0
     C*
     C     @@PLAN        IFNE      'A'
     C                   MOVE      *OFF          *IN37
     C                   ELSE
     C                   MOVE      *ON           *IN37
     C                   ENDIF
     C     *IN37         IFEQ      *ON
     C                   MOVEL     XXYMD         XXYM1             5 0
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXYM2             5 0
     C*
     C* DEFAULT TO ACCOUNT CURRENT DATE IF POSTING DATE IS IN PRIOR MONTH.
     C*
     C     XXYM1         IFLT      XXYM2
     C*
     C                   Z-ADD     0             XXACDT            8 0
     C*
     C                   Z-ADD     EXAOID        X1DAYS            5 0
     C*
     C* POSTING DATE (REVISED INTERIM DAYS PLUS THE PRESENT DATE)
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      DSDATE        QQDT              8 0
     C                   PARM      X1DAYS        QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   MOVE      QQDT          XXACDT            8 0
     C                   ENDIF
     C*
     C     XXACDT        IFNE      *ZERO
     C                   Z-ADD     XXACDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         XXYMD
     C*
     C     XXYMD         IFLT      ELBSDT
     C                   Z-ADD     ELBSDT        XXYMD
     C                   END
     C*
     C                   ENDIF                                                  XXACDT IFNE
     C*
     C                   ENDIF                                                  XXYM1 IFLT
     C*
     C                   ENDIF                                                  *IN37 IFEQ
     C*
     C*
     C*  GET BILLING SCHEDULE
     C*
     C                   MOVEL     ELBSCD        XXBLSC
     C     BSKEY1        CHAIN     PBS01                              50
     C*
      *** MAKE ROOM IN INSTALLMENT SECTION
     C                   MOVEL(P)  BSDESC        XBDESC           25
     C                   MOVE      *BLANK        XXLRGD            1
     C*
     C*   VERIFY IF POLICY IS LARGE DEDUCTIBLE BASED ON BILLING SCHEDULE CODE
     C*
     C*
     C                   if        *in50 = *off and bslpgm = 'L'
     C*
     C     ELKEY         CHAIN     pld01                              60
     c                   if        *in60 = *off
     C                   MOVE      'Y'           XXLRGD
     C                   ENDIF                                                  *in60 = *off
     C*
     C                   endif
     C*
     C                   SETOFF                                       63
     C*
     C**   DETERMINE IF ESTIMATED BILL
     C*
     C     ELFAF         IFEQ      'E'
     C                   SETON                                        63
     C                   END
     C*
     C**   DETERMINE IF RENEWAL QUOTE
     C*
     C                   MOVE      *OFF          *IN30
     C     ELRQFL        IFEQ      'Y'
     C                   MOVE      *ON           *IN30
     C                   ENDIF
     C                   MOVEA     '00'          *IN(92)
     C     *IN63         IFEQ      *OFF
     C                   MOVE      *ON           *IN92
     C     @@PLAN        IFEQ      'A'
     C                   MOVE      *OFF          *IN92
     C                   MOVE      *ON           *IN93
     C                   ENDIF
     C                   ENDIF
     C*
     C                   MOVEL(P)  QQRMCD        XXRM              5
     C*
     C     EMKEY         CHAIN     PA301                              60
     C*
     C                   MOVE      *BLANKS       EMN
     C                   Z-ADD     1             A
     C                   MOVE      *BLANKS       EMN2
     C                   Z-ADD     1             B
     C*
     C                   MOVEL(P)  EMNAME        EMN(A)
     C                   ADD       1             A
     C                   MOVEL(P)  EMNAME        EMN2(B)
     C                   ADD       1             B
     C*
     C     EMFDNM        IFNE      *BLANKS
     C                   MOVEL(P)  EMFDNM        EMN(A)
     C                   ADD       1             A
     C                   MOVEL(P)  EMFDNM        EMN2(B)
     C                   ADD       1             B
     C                   ENDIF                                                  EMFDNM IFNE
     C*
     C                   MOVE      *OFF          BCONT             1
     C     *IN60         IFEQ      *OFF
     C     A3STAT        ANDEQ     'A'
     C     A3CONT        ANDNE     *BLANKS
     C                   MOVEL     A3CONT        EMN2(B)
     C                   ADD       1             B
     C                   MOVE      *ON           BCONT
     C                   ENDIF
     C     *IN60         IFEQ      *OFF
     C     A3STAT        ANDEQ     'A'
     C     A3ADR1        ANDNE     *BLANKS
     C                   MOVEL     A3ADR1        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     A3ADR1        EMN2(B)
     C                   ADD       1             B
     C     A3ADR2        IFNE      *BLANKS
     C                   MOVEL     A3ADR2        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     A3ADR2        EMN2(B)
     C                   ADD       1             B
     C                   ENDIF
     C                   ELSE                                                   *IN60 IFEQ
     C*
     C     EMMPFL        IFEQ      'M'
     C                   MOVEL(P)  EMMAD1        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     EMMAD1        EMN2(B)
     C                   ADD       1             B
     C     EMMAD2        IFNE      *BLANKS
     C                   MOVEL(P)  EMMAD2        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     EMMAD2        EMN2(B)
     C                   ADD       1             B
     C                   ENDIF                                                  EMMAD2 IFNE
     C                   ELSE
     C                   MOVEL(P)  EMPAD1        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     EMPAD1        EMN2(B)
     C                   ADD       1             B
     C     EMPAD2        IFNE      *BLANKS
     C                   MOVEL(P)  EMPAD2        EMN(A)
     C                   ADD       1             A
     C                   MOVEL     EMPAD2        EMN2(B)
     C                   ADD       1             B
     C                   ENDIF                                                  EMPAD2 IFNE
     C                   ENDIF                                                  EMMPFL IFEQ
     C                   ENDIF                                                  *IN60 IFEQ
     C                   MOVE      *BLANKS       XXLAST
     C                   MOVE      *BLANKS       XXFRST
     C                   MOVE      *BLANKS       XXSTZP
     C                   MOVE      *BLANKS       XXZIP4
     C     *IN60         IFEQ      *OFF
     C     A3STAT        ANDEQ     'A'
     C     A3ADR1        ANDNE     *BLANKS
     C                   MOVEL     A3CTY         XXLAST
     C                   MOVEL     A3ST          XXSTZP           13
     C                   MOVEL     A3ZIP1        XXZZ              9
     C                   MOVE      A3ZIP2        XXZZ              9
     C                   MOVE      XXZZ          XXSTZP
     C                   ELSE
     C     EMMPFL        IFEQ      'M'
     C                   MOVEL     EMMCTY        XXLAST           56
     C                   MOVEL     EMMST         XXSTZP           13
     C                   MOVE      EMMZIP        XXSTZP
     C                   ELSE
     C                   MOVEL     EMPCTY        XXLAST           56
     C                   MOVEL     EMPST         XXSTZP           13
     C                   MOVE      EMPZIP        XXSTZP
     C                   END
     C                   ENDIF                                                  *IN60 IFEQ
     C                   MOVE      XXSTZP        XXZIP4            4
     C*
     C     XXZIP4        IFEQ      *ZERO
     C                   MOVE      '    '        XXSTZP
     C                   ELSE
     C                   MOVEL     '-'           XX5
     C                   MOVE      XXZIP4        XX5               5
     C     *IN60         IFEQ      *OFF
     C     A3STAT        ANDEQ     'A'
     C     A3ADR1        ANDNE     *BLANKS
     C                   MOVEL     A3ZIP1        XXST10           10
     C                   ELSE
     C     EMMPFL        IFEQ      'M'
     C                   MOVEL     EMMZIP        XXST10           10
     C                   ELSE
     C                   MOVEL     EMPZIP        XXST10           10
     C                   END
     C                   ENDIF                                                  *IN60 IFEQ
     C                   MOVE      XX5           XXST10           10
     C                   MOVE      XXST10        XXSTZP
     C                   END
     C*
     C                   MOVEL     XXSTZP        XXFRST           15
     C                   MOVE      '1'           XXTERM            1
     C                   CALL      'SRNAME'
     C                   PARM                    XXLAST
     C                   PARM                    XXFRST
     C                   PARM                    XXTERM
     C                   MOVEL     XXLAST        EMN(A)
     C                   MOVEL     XXLAST        EMN2(B)
     C     *IN60         IFEQ      *OFF
     C     A3STAT        ANDEQ     'A'
     C     A3ADR1        ANDNE     *BLANKS
     C     A3OOC         ANDNE     *BLANKS
     C                   MOVEL(P)  A3OOC         EMN(A)
     C                   MOVEL     A3OOC         EMN2(B)
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ADD       1             A
     C                   ADD       1             B
     C*
     C*  GET AGENT NAME VIA AGENT HISTORY AND AGENT MASTER FILES
     C*
     C                   MOVE      *BLANKS       XXPROD           45
     C                   MOVEL     XXYMD         XXEFDT
     C     AHKEY         SETGT     PAH01
     C                   READP     PAH01                                  50
     C     *IN50         DOWEQ     '0'
     C     AHSTAT        ANDEQ     'I'
     C                   READP     PAH01                                  50
     C                   END
     C*
     C     *IN50         IFEQ      '0'
     C     XXCO#         ANDEQ     AHCO#
     C     XXFND         ANDEQ     AHFND
     C     XXEMP#        ANDEQ     AHEMP#
     C     XXDIV         ANDEQ     AHDIV
     C     XXFYR         ANDEQ     AHFYR
     C                   MOVEL     AHAGT#        XXAGT#
     C*
     C     AAKEY         CHAIN     PAA01                              50
     C     *IN50         IFEQ      '0'
     C                   MOVEL     AAFEIN        XXFEIN
     C                   MOVEL     AAMOD         XXMOD
     C                   ELSE
     C                   MOVE      *ZEROS        XXFEIN
     C                   MOVE      *ZEROS        XXMOD
     C                   END
     C*
     C     APKY          CHAIN     PAP01                              50
     C     *IN50         IFEQ      *OFF
     c     xxclt#        andne     '025'
     C*
     C     APFSN         IFNE      *BLANKS
     C                   MOVEL     APFSN         XXPROD
     C                   CAT       APLSN:1       XXPROD
     C                   ELSE
     C                   MOVEL     APLSN         XXPROD
     C                   ENDIF                                                  APFSN IFNE
     C*
     C                   ENDIF                                                  *IN50 IFEQ
     C*
     C     AGKEY         CHAIN     PAG01                              50
     C     *IN50         IFEQ      '0'
     C                   MOVEL     AGNAME        ANAME            34
     C                   MOVE      *BLANKS       XXLAST
     C                   MOVE      *BLANKS       XXFRST
     C                   MOVE      *BLANKS       XXSTZP
     C                   MOVE      *BLANKS       XXZIP4
     C     AGMAD1        IFNE      *BLANKS
     C                   MOVEL     AGMAD1        AADD1            34
     C                   MOVEL     AGMCTY        XXSHRT           19
     C                   MOVEL     XXSHRT        XXLAST           56
     C                   MOVEL     AGMST         XXSTZP           13
     C                   MOVE      AGMZIP        XXSTZP
     C                   ELSE
     C                   MOVEL     AGPAD1        AADD1
     C                   MOVEL     AGPCTY        XXSHRT
     C                   MOVEL     XXSHRT        XXLAST
     C                   MOVEL     AGPST         XXSTZP
     C                   MOVE      AGPZIP        XXSTZP
     C                   ENDIF
     C                   MOVE      XXSTZP        XXZIP4            4
     C*
     C     XXZIP4        IFEQ      *ZERO
     C                   MOVE      '    '        XXSTZP
     C                   ELSE
     C                   MOVEL     '-'           XX5
     C                   MOVE      XXZIP4        XX5               5
     C     AGMAD1        IFNE      *BLANKS
     C                   MOVEL     AGMZIP        XXST10           10
     C                   ELSE
     C                   MOVEL     AGPZIP        XXST10           10
     C                   ENDIF
     C                   MOVE      XX5           XXST10           10
     C                   MOVE      XXST10        XXSTZP
     C                   ENDIF
     C*
     C                   MOVEL     XXSTZP        XXFRST           15
     C                   MOVE      '1'           XXTERM            1
     C                   CALL      'SRNAME'
     C                   PARM                    XXLAST
     C                   PARM                    XXFRST
     C                   PARM                    XXTERM
     C                   MOVEL     XXLAST        ACSZ             34
     C                   ELSE
     C                   MOVE      *BLANKS       ANAME
     C                   MOVE      *BLANKS       AADD1
     C                   MOVE      *BLANKS       ACSZ
     C                   MOVE      *ZEROS        AGARE1
     C                   MOVE      *ZEROS        AGPHN1
     C                   END
     C*
     C                   ELSE
     C                   MOVE      *BLANK        AHAGT#
     C                   MOVE      *BLANK        ANAME
     C                   MOVE      *BLANKS       AADD1
     C                   MOVE      *BLANKS       ACSZ
     C                   MOVE      *ZEROS        AGARE1
     C                   MOVE      *ZEROS        AGPHN1
     C                   END
     C*
     C     AGPHN1        IFEQ      *ZEROS
     C                   MOVE      *OFF          *IN69
     C                   ELSE
     C                   MOVE      *ON           *IN69
     C                   ENDIF
     C*
     C* BUILD STRINGS FOR NEW FORMAT BILL.
     C*
     C                   MOVE      *OFF          *IN90
     C                   Z-ADD     1             XQPROR            9 6
     C     XXNEWF        IFEQ      'Y'
     C*
     C* COUNT # OF DIVISIONS ON POLICY.
     C*
     C                   Z-ADD     0             XXDIVC            5 0
     C                   Z-ADD     0             XQANPR           11 2
     C     ELKY2         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
      *
     C     ELPFDT        IFNE      ELPTDT
     C                   ADD       1             XXDIVC
      /Free

        Chain(N) RSKY PRS01;
        If %Found(WMRSL);
           xxSt = RSjrst;
        Else;
           xxSt = *Blanks;
        Endif;

        xqAnpr = xqAnpr + GetAnnualAmt(ELco#:ELfnd:ELemp#:ELdiv:ELfyr);
        index = %lookup(xxSt:PolSts);
        If index = 0;
           index = %lookup('  ':Polsts);
           PolSts(index) = xxSt;
        Endif;

      /End-Free
     C                   ENDIF
      *
     C     ELKY2         READE     PEL02                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     ELKEY         CHAIN(N)  PEL01                              60
      /Free
        Chain(N) RSKY PRS01;
        If %Found(WMRSL);
           xxSt = RSjrst;
        Else;
           xxSt = *Blanks;
        Endif;
      /End-Free
     C* COMPUTE NET RATE FACTOR.
     C*
     C     F1NETR        IFEQ      'Y'
     C     ELPFDT        ANDGE     F1NETD
     C                   MOVE      *ON           *IN90
     C     ELMAPR        IFNE      *ZERO
     C     ELENMP        DIV(H)    ELMAPR        XZPROR            9 6
     C                   ENDIF
     C                   ENDIF
     C*
     c                   select
     c                   when      dbflag = *on  and
     c                             ofeftv <> ' ' and
     c                             bssefl <> 'S' and
     c                             elaeft = ' '
     C                   eval      xxchck = ofeftv
      *
     c                   when      dbflag = *on  and
     c                             ofeftv = ' '  and
     c                             bssefl <> 'S' and
     c                             elaeft = ' '
     C                   eval      xxchck = des1
     c                   when      dbflag = *on  and
     c                             bssefl <> 'S' and
     c                             elaeft = 'A'
     C                   eval      xxchck = des2
      *
     c                   other                                                  Existing func
     C                   MOVEL(P)  'MAKE CHE'    XXCHCK           65
     C                   CAT       'CKS PA':0    XXCHCK
     C                   CAT       'YABLE':0     XXCHCK
     C                   CAT       'TO':1        XXCHCK
     C     LO:UP         XLATE     X2CKNM        X1CKNM           40
     C                   CAT       X1CKNM:1      XXCHCK
      /Free
       // Use Third party Verbiage if Opted in
       xx3rdPV = ' ';
       If (Not isQuote And ICPolicyOpt(xxCo#:xxFnd:xxEmp#) = 'Y') Or
          (isQuote And ICGroupOpt(xxCo#:xxFnd));
          If OF3rdVrb <> ' ';
             xx3rdPV = OF3rdVrb;
             xxChck  = ' ';
          EndIf;
       EndIf;
       If xxClt# = '129';
          clear xxChCk;
       Endif;
      /End-Free
     C                   endsl
     C*
     C                   MOVEA     '00'          *IN(28)
     C     BSSEFL        IFEQ      'E'
     C                   MOVE      *ON           *IN29
     C   39              MOVE      *ON           *IN28
     C                   ENDIF                                                  BSSEFL IFEQ
     C*
     C                   MOVEL     XXPROD        X1PRNM
     C     XXCLT#        IFEQ      '025'
     C                   MOVEL     *BLANKS       X1PRNM
     C                   ENDIF
     c                   z-add     xxagt#        xqagt#
     C*
     C     ANAME         IFNE      *BLANKS
     C                   MOVEL     AGNAME        XQAGNM           40
     C                   MOVEL     AGNAME        X2AGNM
     C                   ELSE
     C                   MOVE      *BLANKS       XQAGNM
     C                   MOVE      *BLANKS       X2AGNM
     C                   ENDIF
     c                   select
     c                   when      cltid  = '025'
     c                   eval      xqqref = '      Participant #:'
     c                   when      cltid  = '071'
     c                   eval      xqqref = pol#71
     c                   eval      x2qref = pol#71
     c                   other
     c                   if        *in38 = *on
     c                   eval      xqqref = 'Quote Reference:'
     c                   else
     c                   eval      xqqref = 'Policy Reference:'
     c                   endif
     c                   endsl
     C*
     C* TITLE ON BILL
     C*
     C                   SELECT
     C     CLTID         WHENEQ    '071'
     C                   MOVEL(P)  T71(1)        X1T71            40
     C                   MOVEL(P)  T71(2)        X2T71            40
     C                   MOVEL(P)  T71(3)        X3T71            40
     C                   MOVEL(P)  T71(4)        X4T71            40
     C                   OTHER
     C                   MOVEL(P)  TIT2(1)       X1TITL           20
     C                   MOVEL(P)  TIT2(1)       X1TITL2          20
     C                   MOVEL(P)  TIT2(2)       X2TITL           20
     C                   MOVEL(P)  TIT2(2)       X2TITL2          20
     C                   MOVEL(P)  TIT2(3)       X3TITL           20
     C                   MOVEL(P)  TIT2(3)       X3TITL2          20
     C                   MOVEL(P)  TIT2(4)       X4TITL           20
     C                   MOVEL(P)  TIT2(4)       X4TITL2          20
     C                   ENDSL
     C*
     c                   select
     c                   when      cltid = '025'
     C                   call      'WA005R'
     C                   parm                    xxemp#
     C                   parm                    xxdiv
     C                   parm                    xxname
     C                   parm                    xxedn            80
     c                   eval      xqpol# = xxedn
     c                   other
     c                   move      qqpol#        xqpol#           15
     c                   endsl
     C     CLTID         IFEQ      '071'
     C                   EXSR      SRP71#
     C                   ENDIF
     C*
     C     XXDIVC        IFGT      1
     C     CLTID         OREQ      '071'
     C     CLTID         ORNE      '071'
     C                   MOVEL(P)  'Division'    XQDIVH           20
     C                   CAT       ':':0         XQDIVH
     C                   MOVE      XXDIV         XQDIV             5
     C                   ELSE
     C                   MOVE      *BLANKS       XQDIVH
     C                   MOVE      *BLANKS       XQDIV
     C                   ENDIF                                                  XXDIVC IFGT
     C*
     C                   MOVEL(P)  'Rating S'    XQRSTH           20
     C                   CAT       'tate:':0     XQRSTH
     C*
     C     *IN66         IFEQ      *ON
     C                   MOVEL(P)  'Carrier'     XQCAPH           20
     C                   CAT       'Pol#:':1     XQCAPH
     C                   ENDIF                                                  *IN66 IFEQ
     C*
     C   38              MOVEL(P)  'Proposal'    XQPROF           20
     C  N38              MOVEL(P)  'Policy'      XQPROF           20
     C                   CAT       'For:':1      XQPROF
     C*
     C  N38              MOVEL(P)  'Print'       XQPROD           20
     C  N38              CAT       'Date:':1     XQPROD
     C   38              MOVEL(P)  'Proposal'    X1PROD           20
     C   38              CAT       'Date:':1     X1PROD
     C*
     c                   select
     c                   when      cltid = '025'
     c                   eval      xqdsth = 'County District #:'
     c                   clear                   cndesc
     c                   select
     c                   when      EMPST <> *blanks
     c                   eval      xxkey = empst + emcnty
     c                   other
     c                   eval      xxkey = emmst + emcnty
     c                   endsl
     c     tbkey         chain     pcn01
     c                   if        CNDESC <> *blanks
     c                   eval      xqdstd = %trim(CNDESC)
     c                                      + '-' + %subst(EMSEMP:2:6)
     c                   else
     c                   eval      xqdstd = %subst(EMSEMP:2:6)
     c                   endif
     c                   eval      xqperd = 'Participation Period:'
     c                   eval      pdthz = 1.85
     c                   other
     c                   eval      xqperd = 'For Period:'
     c                   eval      pdthz = 1.4                                  policy dates X coord
     c                   endsl
     C*
     C                   SELECT
      /Free
       When cltid = '071' or cltid = '025' or isContri = '1';
      /End-free
     C                   MOVEL(P)  'Contri'      XQPRMW           30
     C                   CAT       'bution':0    XQPRMW
     C                   CAT       'Break':1     XQPRMW
     C                   CAT       'down':0      XQPRMW
     C                   OTHER
     C                   MOVEL(P)  'Premium'     XQPRMW           30
     C                   CAT       'Breakd':1    XQPRMW
     C                   CAT       'own':0       XQPRMW
     C                   ENDSL
     C*
     C                   MOVEL(P)  'Balance'     XQBALW           30
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY2
     C                   MOVEL     SRDTO         XQDT
     C*
     C                   Z-ADD     XXMTH         X
     C                   MOVEL(P)  MNTH(X)       XQPRDT           20
     C                   CAT       XXDAY:1       XQPRDT
     C                   CAT       ',':0         XQPRDT
     C                   CAT       XXYR:1        XQPRDT
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQDT
     C*
     C                   Z-ADD     XXMTH         X
     C                   MOVEL(P)  MNTH(X)       XQPFDT           20
     C                   CAT       XXDAY:1       XQPFDT
     C                   CAT       ',':0         XQPFDT
     C                   CAT       XXYR:1        XQPFDT
     C*
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQDT
     C*
     C                   Z-ADD     XXMTH         X
     C                   MOVEL(P)  MNTH(X)       XQPTDT           20
     C                   CAT       XXDAY:1       XQPTDT
     C                   CAT       ',':0         XQPTDT
     C                   CAT       XXYR:1        XQPTDT
     C*
     C                   MOVEL(P)  XQPFDT        XQPOLP           45
     C                   CAT       ' to':1       XQPOLP
     C                   CAT       XQPTDT:1      XQPOLP
     C*
     C                   MOVE      *BLANKS       XQMINM           45
     C     ELEMNP        IFEQ      'Y'
     C                   MOVEL     MSG(1)        XQMINM
     C                   ENDIF
      /Free
       If ELemnp = 'Y' and isContri = '1';
          clear XQMINM;
          XQMINM = MSG(2);
       Endif;
      /End-free
      *** Beg add ***** 07/07/23 **************************************
      /free
       MinPrmMsg1 = *Blanks;
       MinPrmMsg2 = *Blanks;
       // Add a note at the bottom of the balance box to indicate:
       // * Minimum has been invoked and all premium except terrorism charges are
       // billed to state reporting division.
       IF XXMINF = 'Y';
          MinPrmMsg1 = '* Minimum has been invoked and all premium except +
           terrorism';
          MinPrmMsg2 = 'charges are billed to state reporting division.';
       Endif;
      /end-free
      *** End Add *****  07/07/23  *******************************************
     C*
     C                   MOVE      *BLANKS       X1DUED
     C     XXDUED        IFNE      *ZERO
     C     XXDUED        ANDGT     99
