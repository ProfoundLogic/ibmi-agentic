     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  ELI2EF IFNE
     C*
     C*  GET DESCRIPTION
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVE      *BLANKS       XLDSC2
     C                   MOVEL     ELINL2        XXKEY
     C     LMKY          SETGT     PLM01
     C     LMKY2         READPE    PLM01                                  60
     C     *IN60         DOWEQ     '0'
     C     LMSTAT        ANDEQ     'I'
     C     LMKY2         READPE    PLM01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C     *IN60         IFEQ      *OFF
     C                   MOVEL(P)  LMDESC        XLDSC2           18
     C                   MOVE      XLDSC2        HDG(A)
     C                   MOVE      *BLANKS       XLMP              5
     C                   MOVE      LMPCT         XLMP
     C                   MOVEA     XLMP          NUM
     C                   MOVE      '.'           PCT(3)
     C                   MOVE      '%'           PCT(7)
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
     C                   MOVE      NUM(2)        PCT(2)
     C                   MOVE      NUM(3)        PCT(4)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ADD       1             A
      //*** Beg Add ***** 08/14/24 *********************************
      //Print Balance to 2nd Increased Limit Minimum
       If MPebil2 <> 0;
          HDG(A) = Con(81);
          TAM(A) = MPebil2;
          SGN(A) = '+';

          //*** Beg Add *****  05/12/25  *******************************************
          // Print an '*' appended to heading on the line item
          If ELPror > 0 and ELPror < 1;
             If (xxminf = 'Y' and xxst = 'NJ')
              OR (xxminf = 'Y' and ELcofl <> 'Y');
                HDG(A) = %trim(HDG(A)) + '*';
                PrintFlg = 'Y';
             Endif;
          Endif;
          //*** End Add *****  05/12/25  *******************************************

          A += 1;
       Endif;
      //*** End Add ***** 08/14/24 *********************************
     C                   ENDIF
