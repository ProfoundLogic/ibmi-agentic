     c*
     c*  1st Large Deductible applied to Manual
     c*
     c                   if        ldplv1 = 'M'
     c*
     C     ELEDCT        IFNE      *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     LDPCT1        ANDNE     *ZERO
     C*
     C     LDEFD1        IFNE      *ZERO
     C                   Z-ADD     LDEFD1        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
