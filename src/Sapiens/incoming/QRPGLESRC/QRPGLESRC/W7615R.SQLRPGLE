     C*
     C                   MOVE      *ON           *IN57
     C*
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C                   ENDIF
     C*
     C                   ADD       1             XXPAG4
     C*
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        ANDEQ     *BLANK
     C                   ADD       1             XXPAGE
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    SUMF
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF
     C*
     C     XXNEWF        IFEQ      *BLANK
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C   68              EXCEPT    SUMFT
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  XXNEWF IFEQ
     C     XXNEWF        IFEQ      *BLANK
     C   68              MOVE      *ON           *INOA
     C                   ENDIF                                                  XXNEWF IFEQ
     C     XXNEWF        IFEQ      'Y'
     C                   CLOSE     W7615O
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C* CLOSE QSYSPRT FOR RESOLVING BILL TO DARTS
     C     TURN          IFEQ      1
     C*
     C     QQDART        IFEQ      'Y'
     C     XXNEWF        IFEQ      *BLANK
     C                   CLOSE     QSYSPRT
     C                   ENDIF
     C*
     C                   MOVE      XXFND         QPFND
     C                   MOVE      XXEMP#        QPEMP#
     C                   MOVE      XXFYR         QPFYR
     C                   MOVE      XXDIV         QPDIV             5
     C                   MOVEL     F2FOLD        QQSFLD
     C                   MOVE      *BLANKS       QQFOLD           80
     C                   MOVE      *BLANKS       QQDCID
     C                   MOVE      'BL'          QQPRE             2
     C*
     C* IF RESOLVING NEW FORMAT BILL THEN CHANGE DOC NAME TO .PDF
     C*
     C     XXNEWF        IFEQ      'Y'
     C                   MOVE      'P'           QQRTCD
     C                   ELSE
     C                   MOVE      *BLANK        QQRTCD
     C                   ENDIF                                                  XXNEWF IFEQ
     C                   CALL      'SNXTDCID'
     C                   PARM                    QQFOLD
     C                   PARM                    QQDCID
     C                   PARM                    QQPRE
     C                   PARM                    QQCO#
     C                   PARM                    QQFND
     C                   PARM                    QQRTCD            1
     C                   PARM      '00000'       QQSUB#            5
     C                   PARM      *BLANKS       QQPFLR           80
     C*
     C     QQPFLR        IFNE      *BLANKS
     C*
     C     QQPFLR        CAT       '/':0         QQPFLR
     C*
     C     F2FOLD        IFEQ      *BLANKS
     C     QQPFLR        CAT(P)    'WCPOLS':0    QQSFLD
     C                   ELSE
     C     QQPFLR        CAT(P)    F2FOLD:0      QQSFLD
     C                   ENDIF                                                  F2FOLD IFEQ
     C*
     C                   ENDIF                                                  QQPFLR IFNE
     C*
     C* IF RESOLVING NEW FORMAT BILL THEN CHANGE DOC NAME TO .PDF
     C*
       If isQuote and cltID = '114';
          QQspl# = 'QTE';
       Else;
          QQspl# = *Blanks;
       Endif;
     C*
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   CALL      'W7615C'
     C                   PARM      *Blanks       QQSPL#            4
     C                   PARM                    QQDCID           12
     C                   PARM                    QQPOL#
     C                   PARM                    QPDIV
     C                   PARM                    QQSFLD           40
     C                   PARM                    QQFOLD
     C                   PARM                    X1HOLD
     C                   PARM                    QQHARD
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C*
     C                   MOVE      'Y'           XXSUMD            1
     C                   EXSR      DARTS
     C                   MOVE      *BLANK        XXSUMD            1
     C*
     C                   ENDIF                                                  QQDART EQ Y
     C*
     C                   ENDIF                                                  TURN
     C*
     C                   If        divCombine = *off and turn = 1
     C                              and xxNewf = 'Y' and CltId = '133'
     c                              and isPortal = *Off and QQhard = 'Y'
     c                              and isAgentRunOnly = *Off
     C*
     C                   Move      *on           divPrints
     C*
     C                   Movel(p)  'P'           x3Splf
     C                   Move      xxEmp#        x3Splf
     C                   Move      *blanks       x3Hard
     C                   Move      *blanks       x3Save
     C                   Move      *blanks       x3Hold
     C                   Move      *blanks       x3Cpys
     C                   Move      'X'           x3Dart
     C                   Move      *blanks       x3Fold
     C                   Move      *blanks       x3Dcid
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
      *
     C                   Move      *blanks       x3Dart
     C*
     C                   Endif                                                  If divCombine = *off
     C                   If        divCombine = *off and turn = 2
     C                              and xxNewf = 'Y' and CltId = '133'
     c                              and isPortal = *Off and QQhard = 'Y'
     C*
     C                   Move      *on           divPrints
     C*
     C                   Move      *Zeros        x3Splf
     C                   Movel     'A'           x3Splf
     C                   Move      xxAgt#        x3Splf
     C                   Move      *blanks       x3Hard
     C                   Move      *blanks       x3Save
     C                   Move      *blanks       x3Hold
     C                   Move      *blanks       x3Cpys
     C                   Move      'X'           x3Dart
     C                   Move      *blanks       x3Fold
     C                   Move      *blanks       x3Dcid
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
      *
     C                   Move      *blanks       x3Dart
     C*
     C                   Endif                                                  If divCombine = *off
      *                                                                ***
     C                   If        divCombine = *on  and turn = 2
     C                              and xxNewf = 'Y' and CltId = '133'
     c                              and isPortal = *Off and QQhard = 'Y'
     C*
     C                   Move      *on           divPrints
     C*
     C                   Move      *Zeros        x3Splf
     C                   Movel     'A'           x3Splf
     C                   Move      xxAgt#        x3Splf
     C                   Move      *blanks       x3Hard
     C                   Move      *blanks       x3Save
     C                   Move      *blanks       x3Hold
     C                   Move      *blanks       x3Cpys
     C                   Move      *blanks       x3Dart
     C                   Move      *blanks       x3Fold
     C                   Move      *blanks       x3Dcid
     C                   IF        xxEmp# <> LubaEmp#
     C                   MOVE      'X'           X3DART
     C                   MOVE      xxEmp#        LubaEmp#
     C                   ENDIF
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
      *
     C                   Move      *blanks       x3Dart
     C*
     C                   Endif                                                  If divCombine = *off
      *
     C*
     C* Combine division bills together if report #6 has been set up.
      *
     C*
     C                   If        divCombine = *on and turn = 1
     C                              and xxNewf = 'Y'
     c                   If         (CltId <> '133') or
     c                              (CltId = '133' and isAgentRunOnly = *Off)
     C*
     C                   If        (xxDivC > 1 or ELARSM = 'Y')
     C                   Move      *on           divPrints
     C                   Endif
      **
     C                   move      *on           Del133            1
     C*
     C                   Movel(p)  'B'           x3Splf
      /Free
       If CltId = '133';
          x3Splf = 'P';
       Endif;
      /End-Free
     C                   Move      xxEmp#        x3Splf
     C                   Move      *blanks       x3Hard
     C                   Move      *blanks       x3Save
     C                   Move      *blanks       x3Hold
     C                   Move      *blanks       x3Cpys
     C                   Move      *blanks       x3Dart
     C                   Move      *blanks       x3Fold
     C                   Move      *blanks       x3Dcid
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C*
     C                   Endif                                                  If CltId
     C                   Endif                                                  If divCombine = *on
      /Free
               If divPrints = *on or QQHard <> 'Y' or
                  (Turn = 1 and isAgentRunOnly = *On) or Del133 = *On;

               //* Delete spool file for regular bill.
                  Monitor;
                     cmdString = 'DLTSPLF FILE(W7615O) SPLNBR(*LAST)';
                     length = 255;
                     QCMDEXC(cmdString:length);
                  On-Error;
                  EndMon;
             Del133 = *off;
               Else;

       //* If new running new format bill, release the spool file if needed.

                         If X1Hold <> '*YES' and XXNewF = 'Y';

                            Monitor;
                               cmdString = 'RLSSPLF FILE(W7615O) SPLNBR(*LAST)';
                               length = 255;
                               QCMDEXC(cmdString:length);
                            On-Error;
                            EndMon;

                         Endif;
               Endif;
      /End-free
     C                   ENDIF                                                  XXSUM IFEQ
     C*
     C* Resolve the combined bill together if report #6 has been set up.
     C*
     C                   If        divCombine = *on and xxNewF = 'Y'
     C                             and turn = 1 and divPrints = *on
     c                   If        (CltId <> '133') or
     c                             (CltId = '133' and isAgentRunOnly = *Off)
     C*
     C                   Movel(p)  'B'           x3Splf
      /Free
       If CltId = '133';
          x3Splf = 'P';
       Endif;
      /End-Free
      *** End   Add *** 12/09/19 ******************************************
     C                   Move      xxEmp#        x3Splf
     C                   Move      x6Save        x3Save
     C                   Move      x6Hold        x3Hold
     C                   Move      x6Cpys        x3Cpys
     C                   Move      QQHard        x3Hard
     C                   Move      QQDart        x3Dart
     C                   Move      *blanks       x3Fold
     C                   Move      *blanks       x3Dcid
     C*
     C* Request next available document name/folder for resolving.
     C*
     C                   If        QQDart = 'Y'
     C*
     C                   Move      *BLANKS       QQFOLD
     C                   Move      *BLANKS       QQDCID
     C                   Move      'BL'          QQPRE
     C                   Move      'P'           QQRTCD
     C*
     C                   CALL      'SNXTDCID'
     C                   PARM                    QQFOLD
     C                   PARM                    QQDCID
     C                   PARM                    QQPRE
     C                   PARM                    QQCO#
     C                   PARM                    QQFND
     C                   PARM                    QQRTCD
     C                   PARM      '00000'       QQSUB#
     C                   PARM      *BLANKS       QQPFLR
     C*
     C                   Movel(p)  QQFold        x3Fold
     C                   Movel(p)  QQDcid        x3Dcid
     C*
     C                   Endif                                                  If QQDart = 'Y'
     C*
     C* Create PDF document and release/save/delete spool file.
     C*
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
          If QQDart = ' ';
             X3Dart = 'N';
          Endif;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C*
     C* Create DARTS remark for combined bill.
     C*
     C                   If        QQDart = 'Y'
     C                   Z-add     xsDIV         xxDIV
     C                   Move      'C'           xxSUMD
     C                   Exsr      DARTS
     C                   Move      *BLANK        xxSUMD
     C                   Endif                                                  If QQDart = 'Y'
     C*
     C                   Endif                                                  If CltId
     C                   Endif                                                  If divCombine = *on
     C*
     C* RESET BILLING REQUEST FILE POINTER
     C*
     C*
     C*
     C*
     C*
     C*
     C*
     C*
     C*
     C*  IF MAXIMUM NUMBER OF SPOOL FILES ARE WRITTEN, SUBMIT A
     C*  NEW JOB AND END THIS ONE.
     C*
     C     SVEMP#        IFEQ      *ZERO
     C*
     C*  USE SYSTEM SPOOL FILE NUMBER INSTEAD OF MANUAL COUNTER TO
     C*  DETERMINE IF MAX JOB SPOOL FILES IS NEAR.
     C*
     C     XXSPL         ANDGE     XXMXSP                                       SYS SPL# > MAX??
     C     TURN          IFEQ      1
     C                   MOVE      '1'           QQSTEP
     C                   ELSE
     C                   MOVE      '2'           QQSTEP
     C                   ENDIF                                                  TURN EQ 1
     C                   CALL      'W7615C1'
     C                   PARM                    QQCO#
     C                   PARM                    QQFND
     C                   PARM                    QQFYR
     C                   PARM                    QQEMP#
     C                   PARM                    QQDIV
     C                   PARM                    QQDATE
     C                   PARM                    QQCOM1
     C                   PARM                    QQCOM2
     C                   PARM                    QQCOM3
     C                   PARM                    QQDUED
     C                   PARM                    QQDEP
     C                   PARM                    QQQTE
     C                   PARM                    QQRNB
     C                   PARM                    QQDART
     C                   PARM                    QQSTEP
     C                   PARM                    QQQUE
     C                   PARM                    QQCALL
     C                   PARM                    QQHARD
     C                   PARM                    QQAGTO
     C                   PARM                    QQFQT
     C                   PARM                    QQRMCD
     C                   PARM                    QQFCM1
     C                   PARM                    QQFCM2
     C                   PARM                    QQFCM3
     C*
     C                   Z-ADD     3             TURN
     C                   GOTO      END
     C                   ENDIF                                                  EMP NE 0 & SPL > MAX
     C                   Z-ADD     *ZEROS        XXPAG4
     C*
     C                   Z-ADD     *ZEROS        XXPAGE
     C                   ENDIF                                                  XXEMP# IFNE
     C     SVEMP#        CABEQ     *ZERO         READE
     C*
     C     END           TAG
     C     QQAGTO        IFEQ      'Y'
     C     XXNEWF        IFEQ      *BLANK
     C                   CLOSE     QSYSPRT1
     C                   ENDIF                                                  XXNEWF IFEQ
     C* NOTE: IF THIS JOB HAS BEEN RESUBMITTED, TURN HAS BEEN SET TO 3.
     C     TURN          IFEQ      1
     C                   MOVE      '2'           QQSTEP
     C                   ADD       1             TURN
     C                   GOTO      TURNT
     C                   ENDIF                                                  TURN EQ 1
     C                   ENDIF                                                  QQAGTO EQ Y

       //*** Beg add ***** 09/01/23 ***********************************
       If isUseXml;
          Close WSBLL;
          Close WSBL1L;
          Close WXBLP;
          Close WXBLP1;
          Close WXBLP2;
          Select;
          When xmlFileName = *Blanks;
          Other;
             ReorganizeTemplates(xmlFileName);
             inXml = xmlFileName + '$';
             Monitor;
                GenScriptOut(inXml);
             On-error;
             Endmon;
          Endsl;
          //Update LDA with Key and Seq#
          If isPortal;
             Chain (strXPFile1) xp103;
             If %Found(xmlprel3);
                strUncPath = %Trim(XPDir) + %Trim(XPFile);
                Exec sql
                 Select CMseq#
                 Into :x#seq#
                 From SDCMP
                 Where CMuncN = :strUncPath and CMkey = :q#Key;
                 In *Lock *dtaara;
                 keyEmail = q#Key;
                 keySeq#  = %Editc(x#seq#:'X');
                 Out *dtaara;
             Endif;
          Endif;
       Endif;
       //*** End add ***** 09/01/23 ***********************************
     C                   SETON                                        LR
      *
      *
      /free
       //=============================================================
       // Print Volunteered List
       //=============================================================
       Begsr PrtVolList;

       If CltId = '111';
         intCount = 1;
          If vol(1) <>  ' ' and vol#(1) > 0;
             fill = fill + 2;
             Exsr PrtHeader;

             If xxNewF = 'Y';
                Write QVOL1;
             Endif;
          Endif;

          Dow intCount <= 5;
             If vol(intCount) <> ' ' and vol#(intCount) > 0;
                xxVol    = vol(intCount);
                xxVolCnt = vol#(intCount);
                fill = fill + 1;
                Exsr PrtHeader;
                If xxNewF = 'Y';
                   write qvol;
                Endif;
             Endif;
             intCount = intCount + 1;
          Enddo;
       Endif;

       Endsr;

       //=============================================================
       // Print Header
       //=============================================================
       Begsr PrtHeader;

       If xxNewF = 'Y' and fill > 42;
          xxPag4  = xxPag4 + 1;
          *in51 = *off;
          Exsr DoPage;
          *in31 = *off;
          write QFOOT;
          write QHEAD;

         QuoteProposal();

          write QHEAD1;
          write QLINE1;
          write QHEAD2;
          write QHEAD3;
          write QBOX1;
          xx1st = *off;
          fill = 0;
       Endif;

       Endsr;
       //=============================================================
       // PrintSum - Load the arrays for summary premium section
       //=============================================================
       Begsr PrintSum;

       i = 1;

       //* Manual Premium
       qtam(i) = xtmapr;
       If cltid = '025' or isContri = '1';
          qhdg(i) = con(42);
       Else;
          qhdg(i) = con(1);
       Endif;
       i += 1;

       //* Subject Premium
       qtam(i) = xtesbj;
       If cltid = '025' or isContri = '1';
          qhdg(i) = con(47);
       Else;
          qhdg(i) = con(15);
       Endif;
       i += 1;

       //* Modified Premium
       qtam(i) = xtempm;
       If cltid = '025' or isContri = '1';
          qhdg(i) = 'Modified Contribution';
       Else;
          qhdg(i) = 'Modified Premium';
       Endif;
       i += 1;

       //* Balance to Minimum
       If xtmbal <> 0;
          qtam(i) = xtmbal;
          qhdg(i) = 'Balance to Minimum';
          i += 1;
       Endif;

       //* Standard Premium
       qtam(i) = xtstpr;
       If cltid = '025' or isContri = '1';
          qhdg(i) = con(43);
       Else;
          qhdg(i) = con(5);
       Endif;
       i += 1;

       //* Normal Premium
       qtam(i) = xtenmp;
       If cltid = '025' or isContri = '1';
          qhdg(i) = con(44);
       Else;
          qhdg(i) = con(8);
       Endif;
       i += 1;

       //* Expense Constant
       qtam(i) = xtexco;
       qhdg(i) = con(9);
       i += 1;

       //*** Beg Add *****  05/12/25  *******************************************
       // Move Terroism Charge to print just after Expense Constant line
       // Earlier it was printing just after Prorated Premium line

       //* Terrorism Charges
       If xteter <> 0 or xtedtr <> 0;
          qtam(i) = xteter + xtedtr;
          qhdg(i) = 'Terrorism Charges';
          i += 1;
       Endif;
       //*** End Add *****  05/12/25  *******************************************

       //* Estimated Premium
       qtam(i) = xtestp;
       //*** Beg Add *****  05/12/25  *******************************************
       // Add Terroism Charges
       qtam(i) = qtam(i) + xteter + xtedtr;
       //*** End Add *****  05/12/25  *******************************************
       If cltid = '025' or isContri = '1';
          qhdg(i) = con(45);
       Else;
          qhdg(i) = con(10);
       Endif;
       i += 1;

       //* Prorated Premium
       If xtestp <> xtpprm;
          qtam(i) = xtpprm;
          qhdg(i) = con(12);
          i += 1;
       Endif;

       //*** Beg Del *****  05/12/25  *******************************************
       // Move Terroism Charge to print just after Expense Constant line

       //* Terrorism Charges
       // If xteter <> 0 or xtedtr <> 0;
       //    qtam(i) = xteter + xtedtr;
       //    qhdg(i) = 'Terrorism Charges';
       //    i += 1;
       // Endif;
       //*** End Del *****  05/12/25  *******************************************

       //* State Tax
       If xttxdu <> 0;
          qtam(i) = xttxdu;
          qhdg(i) = con(7);
          i += 1;
       Endif;

       //* Total Premium
       //*** Beg Chg *****  05/12/25  *******************************************
       // If xteter <> 0 or xtedtr <> 0 or xttxdu <> 0;
       If xttxdu <> 0;
       //*** End Chg *****  05/12/25  *******************************************
          qtam(i) = xtanpr;
          If cltid = '025' or isContri = '1';
             qhdg(i) = con(48);
          Else;
             qhdg(i) = con(25);
          Endif;
          i += 1;
       Endif;

       Endsr;
       //=============================================================
       // GetVolCnt - Get Volunteer List and count
       //=============================================================
       Begsr GetVolCnt;

       // Build Volunteer Array

       Select;
       When EPclas = 7370 and EPspec = 'Q';
          x = 1;
       When EPclas = 7370 and EPspec = 'V';
          x = 2;
       When EPclas = 7520 and EPspec = 'V';
          x = 3;
       When EPclas = 7704 and EPspec = 'V';
          x = 4;
       When EPclas = 7720 and EPspec = 'Q';
          x = 5;
       When EPclas = 7720 and EPspec = 'V';
          x = 6;
       When EPclas = 8742 and EPspec = 'V';
          x = 7;
       When EPclas = 8810 and EPspec = 'V';
          x = 8;
       When EPclas = 9040 and EPspec = 'V';
          x = 9;
       When EPclas = 9101 and EPspec = 'V';
          x = 10;
       When EPclas = 7720 and EPspec = 'N';
          x = 11;
       Other;
          x = 0;
       Endsl;

       // Add Volunteer count to array if there is room.
       If x <> 0 and EPecnt > 0;
          y = 1;
          intCount = %lookUp(x:volA:y);
          If intCount = 0;
             If v < 12;
                v = v + 1;
                volA(v) = x;
                vol(v) = volH(x);
                vol#(v) = EPecnt;
             Endif;
          Else;
             vol#(intCount) = vol#(intCount) + EPecnt;
          Endif;
       Endif;

       Endsr;
      /end-free
      *===============================================================
      * SRQ136 - QUOTE BILL TEXT FOR CLT136
      *===============================================================
     C     SRQ136        BEGSR
      *
     C     CLTID         IFEQ      '136'
     C     QQQTE         ANDEQ     'Q'
     C                   WRITE     QLINE3
     C                   MOVEL(P)  SIG1          XSIGN1
     C                   MOVEL(P)  SIG2          XSIGN2
     C     'Signatur'    CAT(P)    'e':0         XSIGN3
     C                   MOVEL(P)  'Date'        XSIGN4
     C                   WRITE     QSIGN
     C                   ENDIF
      *
     C                   ENDSR
      *
      *
      *
      /free
       //==============================================================
       // SRTRK1 - Write/Update New Business Tracking
       //==============================================================
       Begsr srTrk1;
       // Leave if new business tracking module not installed or not
       //  estimated bill or not New Business
       If WCfl26 <> 'Y' or *in63 = *off or ELnwrw <> 'N';
          LeaveSr;
       Endif;
       // Leave if new business quote date has already been updated
       //  and not in quote.
       Chain(n)(xxco#:xxfnd:xxemp#) pnb01;
       If %found and NBqtdt <> 0 and *in38 = *off;
          LeaveSr;
       Endif;
       Chain (xxco#:xxfnd:xxemp#) pnb01;
       If %found;
          NBuser = Q1user;
          NBpgm  = Q1pgm;
          Exsr GetDtTm;
          NBdt   = sysDate7;
          NBtime = sysTime6;
          NBqtdt = NBdt;
          Update pnb01;
       Else;
          Clear pnb01;
          NBco#  = xxCo#;
          NBfnd  = xxFnd;
          NBemp# = xxEmp#;
          NBiusr = Q1user;
          NBipgm = Q1pgm;
          Exsr GetDtTm;
          NBidt  = sysDate7;
          NBitm  = sysTime6;
          NBuser = NBiusr;
          NBpgm  = NBipgm;
          NBdt   = NBidt;
          NBtime = NBitm;
          NBqtdt = NBdt;
          Write pnb01;
       Endif;
       Endsr;
       //==============================================================
       // SRTRK2 - Write/Update Renewal Tracking
       //==============================================================
       Begsr srTrk2;
       // Leave if renewal tracking module not installed or
       //  not a estimated bill or not a renewal policy or
       //  if a live bill and not a Print & Calc bill.
       If WCfl26 <> 'Y' or ELnwrw <> 'R' or *in63 = *off
        or (qqQte = 'W' and qqCall <> '2');
          LeaveSr;
       Endif;
       // Leave if a live Calc & Print is run and the
       //  agent quoted date <> 0
       Chain(n) (xxCo#:xxFnd:xxEmp#:xxFyr) prt01;
       If %found and qqQte = 'W' and qqCall = '2' and RTqadt <> 0;
          LeaveSr;
       Endif;
       Chain (xxCo#:xxFnd:xxEmp#:xxFyr) prt01;
       If %found;
          RTuser = Q1user;
          Rtpgm  = Q1pgm;
          Exsr GetDtTm;
          Rtdt   = sysDate7;
          RTtime = sysTime6;
          RTqadt = RTdt;
          Update prt01;
       Else;
          Clear prt01;
          RTco#  = xxCo#;
          RTfnd  = xxFnd;
          RTemp# = xxEmp#;
          RTiusr = Q1user;
          RTipgm = Q1pgm;
          Exsr GetDtTm;
          RTidt  = sysDate7;
          RTitm  = sysTime6;
          RTuser = NBiusr;
          RTpgm  = RTipgm;
          RTdt   = RTidt;
          RTtime = RTitm;
          RTqadt = RTdt;
          Write prt01;
       Endif;
       Endsr;
      /end-free
      *=============================================================
      * GetDtTm - Returns SysDate7 and SysTime6 for free form spec's
      *=============================================================
     c     GetDtTm       begsr
     c                   time                    dsdttm
     c     *mdy          move      dsdate        workDate
     c     *cymd         move      workDate      sysDate7          7 0
     c                   z-add     dstime        sysTime6          6 0
     c                   endsr
      *** end add ***** 01/07/15 *************************************
     C*==================================================================*
     C*   Set-up and Initialize            ** Subroutine **   S R 1 S T  *
     C*==================================================================*
     C*
     CSR   SR1ST         BEGSR
     C*
     C*  INITIALIZE FIELDS
     C*
     C                   TIME                    DSDTTM
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY2
     C                   MOVEL     SRDTO         XXDATE            8 0
     C*
     C     COKEY         CHAIN     SMCOL                              60
     C*
     C*  REMOVE LEADING BLANKS FROM COMPANY NAME
     C*
     C                   Z-ADD     1             Z                 2 0
     C     *BLANK        LOOKUP    CONM(Z)                            60
     C                   MOVEA     CONM(Z)       XXCONM           64
     C*
     C*  OPEN PRINT FILE
     C*
     C*
     C                   MOVE      '1'           *IN61                          1ST TIME INDIC.
     C*
     C                   ENDSR
     C*================================================================
     C*  DARTS - SUBROUTINE TO WRITE A DARTS RECORD
     C*================================================================
     C     DARTS         BEGSR
     C*
     C*  ESTABLISH KEY
     C*
     C                   MOVE      *BLANKS       QCKEY
     C                   Z-ADD     XXCO#         QCCO#
     C                   Z-ADD     XXFND         QCFND
     C                   Z-ADD     XXEMP#        QCEMP#
     C                   Z-ADD     XXDIV         QCDIV
     C*
     C     QQQTE         IFEQ      'Q'
     C                   MOVE      'Q'           QCQTE
     C                   ELSE
     C                   MOVE      *BLANK        QCQTE
     C                   ENDIF
       //*** Beg Add ***** 09/01/23 **********************
     C                   MOVEL(P)  QCKEY         Q#KEY
       If Not(isUseSpoolOut);
          LeaveSr;
       Endif;
       //*** End Add ***** 09/01/23 **********************
     C*
     C*          Call API to write a DARTS Remark
     C*          ------------------------------------------------------
     C                   MOVEL(P)  QCKEY         Q#KEY            40
     C                   MOVE      *BLANKS       Q#COMM
     C     QQQTE         IFEQ      'Q'
     C                   MOVEL(P)  RMK(5)        Q#COMM          256
     C     QQCALL        IFEQ      ' '
     C                   MOVEL(P)  RMK(8)        Q#COMM          256
     C                   ENDIF                                                  QTE = 'Q'
     C                   ELSE                                                   QTE = 'Q'
     C     *IN63         IFEQ      *OFF
     C                   MOVEL     RMK(2)        Q#COMM
     C                   ELSE                                                   *IN63 = Off
     C                   MOVEL     RMK(1)        Q#COMM
     C     QQCALL        IFEQ      ' '
     C                   MOVEL(P)  RMK(7)        Q#COMM          256
     C                   ENDIF                                                  QQCALL= ' '
     C                   ENDIF                                                  *IN63 = Off
     C
     C                   ENDIF                                                  QTE = 'Q'
     C     XXSUMD        IFEQ      'Y'
     C                   MOVEL     RMK(6)        Q#COMM
     C     QQCALL        IFEQ      ' '
     C     *IN63         ANDEQ     *ON
     C                   MOVEL(P)  RMK(9)        Q#COMM
     C                   ENDIF                                                  QQCALL= ' '
     C                   ENDIF                                                  SUMD = 'Y'
     C     xxSUMD        IFEQ      'C'
     C     *IN63         IFEQ      *OFF
     C                   MOVEL     RMK(13)       Q#COMM
     C                   ELSE
     C                   Movel(p)  RMK(11)       Q#COMM
     C     QQCALL        IFEQ      ' '
     C                   MOVEL(P)  RMK(12)       Q#COMM
     C                   ENDIF                                                  QQCALL= ' '
     C                   ENDIF                                                  *IN63 = *OFF
     C                   ENDIF                                                  SUMD = 'Y'
     C
     C
     C                   MOVEL(P)  XXRM          Q#RMCD            5
     C     Q#COMM        CAT       UPUSNM:1      Q#COMM
     C     Q#COMM        CAT       ', on':0      Q#COMM
     C                   Z-ADD     XXDATE        DSDT2
     C     Q#COMM        CAT       DSMM2:1       Q#COMM
     C     Q#COMM        CAT       '/':0         Q#COMM
     C     Q#COMM        CAT       DSDD2:0       Q#COMM
     C     Q#COMM        CAT       '/':0         Q#COMM
     C     Q#COMM        CAT       DSYY2:0       Q#COMM
     C     Q#COMM        CAT       'for':1       Q#COMM
     C     Q#COMM        CAT       'policy':1    Q#COMM
     C     Q#COMM        CAT       'year':1      Q#COMM
     C     XXFYR         IFGT      99
     C                   MOVE      XXFYR         XBFYR             3
     C     Q#COMM        CAT       XBFYR:1       Q#COMM
     C                   ELSE                                                   FYR > 99
     C                   MOVE      XXFYR         XAFYR             2
     C     Q#COMM        CAT       XAFYR:1       Q#COMM
     C                   ENDIF                                                  FYR > 99
     C     Q#COMM        CAT       '.':0         Q#COMM
     C     Q#COMM        CAT       RMK(3):2      Q#COMM
     C                   MOVEL(P)  ELBSCD        XXWK9A
     C     Q#COMM        CAT       XXWK9A:1      Q#COMM
     C     Q#COMM        CAT       '.':0         Q#COMM
     c                   If        isContri = '1'
     c     Q#COMM        CAT       RMK(10):2     Q#COMM
     c                   Else
     c     Q#COMM        CAT       RMK(4):2      Q#COMM
     c                   Endif
     C     Q#COMM        CAT       '$':1         Q#COMM
     C     XXSUMD        IFEQ      'Y'
     C                   Z-ADD     XXANPR        ELANPR
     C                   ENDIF                                                  SUMD = 'Y'
     C     XXSUMD        IFEQ      'C'
     C                   Z-add     xcANPR        ELANPR
     C                   ENDIF                                                  SUMD = 'C'
     C                   Z-ADD     ELANPR        XXWK90            9 0
     C     ELANPR        IFNE      *ZERO
     C                   MOVE      XXWK90        XXWK9A            9
     C     '0'           CHECK     XXWK9A        X
     C                   SUBST(P)  XXWK9A:X      XXWK9A
     C                   ELSE                                                   ANPR <> 0
     C                   MOVEL(P)  '0'           XXWK9A
     C                   ENDIF                                                  ANPR <> 0
     C     Q#COMM        CAT       XXWK9A:0      Q#COMM
     C     Q#COMM        CAT       '.':0         Q#COMM
     C     Q#COMM        CAT       '00':0        Q#COMM
     C     Q#COMM        CAT       '.':0         Q#COMM
     C                   MOVE      *BLANKS       Q#COM2           19
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C                   MOVEL(P)  SRDTO         Q#CDAT            8
     C     QQDART        IFEQ      'N'
     C                   MOVE(P)   *BLANKS       Q#DCID           12
     C                   MOVE(P)   *BLANKS       Q#FOLD           80
     C                   ELSE                                                   DART = 'N'
     C                   MOVEL(P)  QQDCID        Q#DCID
     C                   MOVEL(P)  QQFOLD        Q#FOLD
     C                   ENDIF                                                  DART = 'N'
     C                   MOVEL(P)  'W0050R'      Q#PNAM           10
     C                   MOVE      *ZEROS        Q#SECL            3
     C                   MOVEL(P)  Q1USER        Q#USER           10
     C                   MOVEL(P)  Q1PGM         Q#PGM            10
     C                   MOVEL(P)  *BLANK        Q#DIFL            1
     C                   MOVEL(P)  Q1PGM         Q#IPGM           10
     C                   MOVEL(P)  *BLANK        Q#FL01            1
     C                   MOVEL(P)  *BLANK        Q#FL02            1
     C                   MOVE      '00000'       Q#SEQ#            5
     C                   MOVE(P)   'N'           Q#SBYL            1

      /Free

        Select;
        When      cltId = '114' and xxSumD <> 'C';
        When      cltId = '114' and xxSumD = 'C';
           Q#SBYL = '$';
        When      xxSumD = 'C';
           Q#SBYL = '$';
        Endsl;

      /End-Free


     C                   MOVEL(P)  *BLANKS       Q#APID            2
     C                   MOVEL(P)  *BLANKS       Q#IDOC           12
     C                   MOVEL(P)  *BLANKS       Q#IQUE           10
     C     XXNEWF        IFEQ      'Y'
     C                   MOVEL(P)  'O'           Q#IMGF            1
     C                   ELSE
     C                   MOVEL(P)  *BLANK        Q#IMGF            1
     C                   ENDIF                                                  XXNEWF IFEQ
     C                   MOVEL(P)  *BLANKS       Q#IPTH           10
     C                   MOVE      *ZEROS        Q#PIDX            5
     C                   MOVEL(P)  *BLANK        Q#QPTY            1
     C                   MOVEL(P)  *BLANKS       Q#DCTP            5
     C                   MOVEL     *BLANKS       Q#CSID            2
     C                   MOVEL     *BLANKS       Q#CODE            2
     C                   CALL      'DA700R'
     C                   PARM                    Q#KEY
     C                   PARM                    Q#COMM
     C                   PARM                    Q#CDAT
     C                   PARM                    Q#DCID
     C                   PARM                    Q#PNAM
     C                   PARM                    Q#SECL
     C                   PARM                    Q#USER
     C                   PARM                    Q#PGM
     C                   PARM                    Q#FOLD
     C                   PARM                    Q#DIFL
     C                   PARM                    Q#IPGM
     C                   PARM                    Q#FL01
     C                   PARM                    Q#FL02
     C                   PARM                    Q#RMCD
     C                   PARM                    Q#SEQ#
     C                   PARM                    Q#SBYL
     C                   PARM                    Q#COM2
     C                   PARM                    Q#APID
     C                   PARM                    Q#IDOC
     C                   PARM                    Q#IQUE
     C                   PARM                    Q#IMGF
     C                   PARM                    Q#IPTH
     C                   PARM                    Q#PIDX
     C                   PARM                    Q#QPTY
     C                   PARM                    Q#DCTP
     C                   PARM                    Q#CSID
     C                   PARM                    Q#CODE
     C                   Move      q#Seq#        x#Seq#
      /free

       Chain keySDCMLA pcm0a;
       Chain keySDCMLA pcm0a;

       If %found;
          x#Dcid = CMDcid;
          x#Fold = CMFold;
          x#Uncn = CMUncn;

          If xxSumd = 'Y';
             x#Key = 'Est Summary Bill';
          Else;
             x#Key = 'Estimated Bill';
          Endif;
          If xxSumd = 'C';
             x#Key = 'Est Combined Bill';
          Endif;
          If isPortal;
             In *Lock *dtaara;
            //*** Beg Chg ***** 09/01/23 ******************
            //*** xxPath = X#uncn;
             keyEmail = q#Key;
             keySeq#  = %Editc(x#seq#:'X');
            //*** End Chg ***** 09/01/23 ******************
             Out *dtaara;
          Endif;

          GenerateNotice(x#RRN:x#Mode:x#Type:x#Key:x#Dcid:x#Fold:x#Seq#:x#Uncn);
       Endif;

      /end-free
     C                   ENDSR
     C*
     C*==================================================================*
     C*   Get Month for Printing           ** Subroutine **   S R D U E  *
     C*==================================================================*
     C*
     CSR   SRDUE         BEGSR
     C*
     C                   MOVE      *BLANK        MON
     C                   MOVEA     MNTH(MM)      DUE
     C                   Z-ADD     9             K                 2 0
     C     ARNDSR        TAG
     C*
     C     DUE(K)        IFEQ      *BLANK
     C                   SUB       1             K
     C                   GOTO      ARNDSR
     C                   END
     C                   MOVEA     DUE           MON
     C*
     C                   ADD       2             K
     C     L             IFEQ      1
     C     YYMM          ANDEQ     YYMM2
     C     DD2           IFNE      1
     C     DD2           IFGT      9
     C                   MOVEL     DD2           MON(K)
     C                   ADD       1             K
     C                   END
     C                   MOVE      DD2           MON(K)
     C                   ELSE
     C                   MOVE      '1'           MON(K)
     C                   END
     C                   ELSE
     C     ELBLFL        IFEQ      'Y'
     C     XXBDAY        IFNE      1
     C                   MOVEL     YYMM          XXVDTE
     C                   MOVE      XXBDAY        XXVDTE
     C                   Z-ADD     XXBDAY        SVBDAY            2 0
     C*
     C     MM            IFEQ      2
     C     XXBDAY        ANDGE     29
     C                   Z-ADD     XXVDTE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C*
     C     SRERR         IFEQ      '1'
     C                   Z-ADD     28            XXBDAY
     C                   ENDIF                                                  SRERR IFEQ *ON
     C*
     C                   ELSE
      *
     C     XXBDAY        IFGT      30
      *
     C     MM            IFEQ      4
     C     MM            OREQ      6
     C     MM            OREQ      9
     C     MM            OREQ      11
     C                   Z-ADD     30            XXBDAY
     C                   ENDIF                                                  XXBDAY GT 30
      *
     C                   ENDIF                                                  MM IFEQ 2
      *
     C                   ENDIF                                                  MM IFEQ 2
     C     XXBDAY        IFGT      9
     C                   MOVEL     XXBDAY        MON(K)
     C                   ADD       1             K
     C                   END
     C                   MOVE      XXBDAY        MON(K)
     C                   Z-ADD     SVBDAY        XXBDAY
     C                   ELSE
     C                   MOVE      '1'           MON(K)
     C                   END
     C                   ELSE
     C                   MOVE      '1'           MON(K)                                     IC.
     C                   ENDIF                                                  ELBLFL EQ 'Y'
     C                   END
     C                   ADD       1             K
     C                   MOVEA     ', '          MON(K)
     C                   ADD       2             K
     C     1900          ADD       YY            XX4               4 0
     C                   MOVE      XX4           XX4A              4
     C                   MOVEA     XX4A          MON(K)
     C                   MOVEA     MON           DDU(L)
     C*
     C                   ENDSR
     C*
     C*==================================================================*
     C*   Get Month for Printing -- FOR WEEKLY INSTALLMENTS              *
     C*==================================================================*
     C*
     CSR   SRDUEW        BEGSR
     C*
     C                   MOVE      *BLANK        MON
     C                   MOVE      'Due'         DUW(Y)
     C                   MOVEA     MNTH(MM)      DUE
     C                   Z-ADD     9             K                 2 0
     C     ARNDS1        TAG
     C*
     C     DUE(K)        IFEQ      *BLANK
     C                   SUB       1             K
     C                   GOTO      ARNDS1
     C                   END
     C                   MOVEA     DUE           MON
     C*
     C                   ADD       2             K
     C*
     C     DD2           IFNE      1
     C*
     C     DD2           IFGT      9
     C                   MOVEL     DD2           MON(K)
     C                   ADD       1             K
     C                   END
     C*
     C                   MOVE      DD2           MON(K)
     C                   ELSE
     C                   MOVE      '1'           MON(K)
     C                   END
     C*
     C                   ADD       1             K
     C                   MOVEA     ', '          MON(K)
     C                   ADD       2             K
     C     1900          ADD       YY            XX4               4 0
     C                   MOVE      XX4           XX4A              4
     C                   MOVEA     XX4A          MON(K)
     C                   MOVEA     MON           DDU(Y)
     C*
     C                   ENDSR
     C*
     C*
     C*
     C* SUBROUTINE TO DETERMINE IF A DATE RANGE CONTAINS FEBRUARY 29TH.
     C*
     C     SRLEAP        BEGSR
     C*
     C*  IF FEB 29 IS A VALID DATE AND IS IN THE RANGE, SUBTRACT ONE DAY
     C*
     C                   Z-ADD     0             XXLPDT
     C*
     C                   Z-ADD     XQFROM        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1FROM
     C*
     C                   Z-ADD     XQTO          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1TO
     C*
     C                   Z-ADD     X1FROM        XXLPDT
     C                   MOVE      '0229'        XXLPDT
     C*
     C     XXLPDT        IFLT      X1FROM
     C                   Z-ADD     X1TO          XXLPDT
     C                   MOVE      '0229'        XXLPDT
     C                   END
     C*
     C     XXLPDT        IFLT      X1FROM
     C     XXLPDT        ORGT      X1TO
     C                   Z-ADD     *ZERO         XXLPDT
     C                   END
     C*
     C     XXLPDT        IFNE      *ZERO
     C*
     C                   Z-ADD     XXLPDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C*
     C                   MOVE      *BLANK        SRERR             1
     C*
     C                   Z-ADD     XQFROM        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C                   MOVEL     SRDTO         XQFROM
     C*
     C     SRERR         IFNE      '1'
     C     XXLPDT        ANDNE     X1FROM
     C                   SUB       1             QQDAYS
     C                   ELSE
     C                   Z-ADD     0             XXLPDT
     C                   ENDIF
     C*
     C                   ENDIF
     C*
     C                   ENDSR                                                  SRLEAP
     C*
      *===============================================================
      * CPOL# - Flag if Carrier Policy Number entered
      *===============================================================
     C     CPOL#         BEGSR
      *
     C     *IN60         IFEQ      *OFF
     C     *IN38         ANDEQ     *OFF                                         not QUOTE
     C     X1EMP#        ANDEQ     *ZERO                                        MASS Bill
      *
      *  Do not allow billing if carrier policy number has not been
      *  entered for one of the employer divisions when carrier policy
      *  number is required and running mass billing.
      *
     C     GCKY          CHAIN     PGC01                              33
      *
     C     *IN33         IFEQ      *OFF
     C     GCCRFL        ANDEQ     'Y'
      *
     C     ELKY2         CHAIN     PEL02                              33
      *
     C     *IN33         DOWEQ     *OFF
     C                   CLEAR                   RPCAP#
     C     RPKY          CHAIN     PRP01                              33
      *
     C     RPCAP#        IFEQ      *BLANKS
     C     *IN33         OREQ      *ON
     C                   SETON                                        60
     C                   LEAVE
     C                   ENDIF                                                  RPCAP# = BLANKS
      *
     C     ELKY2         READE     PEL02                                  33
     C                   ENDDO                                                  EMKY
      *
     C                   ENDIF                                                  *IN33 IFEQ
      *
     C                   ENDIF                                                  *IN60
      *
     C                   ENDSR                                                  CPOL#
      *
      *
      *===============================================================
      * CPOL# - Flag if Debit/Credit factor is out of range
      *===============================================================
     C     SRDBCR        BEGSR
      *
     C     *IN60         IFEQ      *OFF
     C     *IN38         ANDEQ     *OFF                                         not QUOTE
     C     X1EMP#        ANDEQ     *ZERO                                        MASS Bill
      *
      *  Do not allow billing if DEBIT/CREDIT factor is out of range
      *  entered in reporting rating record.
      *
     C     ELKY2         CHAIN     PEL02                              33
      *
     C     *IN33         DOWEQ     *OFF
      *
     C     ELFAF         IFNE      'R'
     C     RSKY1         CHAIN     PRS01                              33
      *
     C     *IN33         IFEQ      *OFF
     C     RRKY3         SETGT     PRR01
     C     RRKY4         READPE    PRR01                                  33
      *
     C     *IN33         IFEQ      *OFF
     C     ELDBCR        ANDNE     *ZERO
      *
     C     ELDBCR        IFGT      1.0
      *
     C     ELDBCR        IFGT      RRDMAX
     C     RRDMAX        ANDNE     *ZERO
     C                   SETON                                        60
     C                   LEAVE
     C                   ENDIF                                                  RRDMAX
      *
     C                   ENDIF                                                  ELDBCR > 1
      *
     C     ELDBCR        IFLT      1.0
      *
     C     ELDBCR        IFLT      RRCMAX
     C     RRCMAX        ANDNE     *ZERO
     C                   SETON                                        60
     C                   LEAVE
     C                   ENDIF                                                  RRCMAX
      *
     C                   ENDIF                                                  ELDBCR < 1
      *
     C                   ENDIF                                                  RRKY
      *
     C                   ENDIF                                                  RSKY
      *
     C                   ENDIF                                                  ELFAF <> R
      *
     C     ELKY2         READE     PEL02                                  33
     C                   ENDDO                                                  ELKY
      *
     C                   ENDIF                                                  MASS BILL
      *
     C                   ENDSR                                                  SRDBCR
      *
      *
      *
     C*
     C     SRAGHD        BEGSR
     C*
     C                   CLEAR                   XXAHDR
     C     *IN60         IFEQ      *OFF
     C     EXAHDR        IFEQ      *BLANKS
     C                   MOVEL(P)  'Agent'       EXAHDR
     C                   ENDIF
     C*
     C                   ELSE
     C                   MOVEL(P)  'Agent'       EXAHDR
     C                   ENDIF
     C*
     C                   MOVEL(P)  EXAHDR        XXAHDR           16
     C     XXAHDR        CAT(P)    ':':0         XXAHDR
     C*
     C                   ENDSR
     C     DOPAGE        BEGSR
     C                   MOVE      *BLANKS       XXPAGH           15
     C                   MOVEL     'Page'        XXPAGH
     C*
     C                   SELECT
     C     XXPAG4        WHENGE    100
     C                   MOVE      XXPAG4        XXNUM3            3
     C                   CAT       XXNUM3:1      XXPAGH
     C     XXPAG4        WHENGE    10
     C                   MOVE      XXPAG4        XXNUM2            2
     C                   CAT       XXNUM2:1      XXPAGH
     C                   OTHER
     C                   MOVE      XXPAG4        XXNUM1            1
     C                   CAT       XXNUM1:1      XXPAGH
     C                   ENDSL
     C*
     C                   CAT       'of':1        XXPAGH
     C*
     C                   SELECT
     C     XXPAGC        WHENGE    100
     C                   MOVE      XXPAGC        XXNUM3            3
     C                   CAT       XXNUM3:1      XXPAGH
     C     XXPAGC        WHENGE    10
     C                   MOVE      XXPAGC        XXNUM2            2
     C                   CAT       XXNUM2:1      XXPAGH
     C                   OTHER
     C                   MOVE      XXPAGC        XXNUM1            1
     C                   CAT       XXNUM1:1      XXPAGH
     C                   ENDSL
     C*
     C                   ENDSR
      *================================================================
      *   SRP71# - CONCAT GRP-EMP-DIV WITHOUT LEADING ZEROS
      *================================================================
     C     SRP71#        BEGSR
      *
     C                   CLEAR                   XQP71#
     C                   MOVE(P)   QPFND         ZXFND             3
     C                   MOVE(P)   QPEMP#        ZXEMP             9
     C                   MOVE(P)   QPFYR         ZXFYR             3
     C     '0'           CHECK     ZXFND         X
     C                   SUBST     ZXFND:X       XXTMP1            3
     C     '0'           CHECK     ZXEMP         X
     C                   SUBST     ZXEMP:X       XXTMP2            9
     C     '0'           CHECK     ZXFYR         X
     C                   SUBST     ZXFYR:X       XXTMP3            3
     C     XXTMP1        CAT       '-':0         XQP71#           15
     C     XQP71#        CAT       XXTMP2:0      XQP71#
     C     XQP71#        CAT       '-':0         XQP71#
     C     XQP71#        CAT       XXTMP3:0      XQP71#
     C                   ENDSR
     C*====================================================================
     C* Determine if extra calls need to be made
     C*====================================================================
     C     EXTRAS        BEGSR
     C*
     C     BSSEFL        IFEQ      'E'
     C     QQQTE         ANDNE     'Q'
     C                   EXSR      W7321R
     C                   ENDIF
     C*
     C     BSSEFL        IFEQ      'S'
     C     QQQTE         ANDNE     'Q'
     C     BSONLI        ANDNE     'Y'
     C                   EXSR      W7221R
     C                   ENDIF
     C*
     C                   ENDSR
     C*====================================================================
     C* Call monthly interim notice program
     C*====================================================================
     C     W7221R        BEGSR
     C*
     C                   MOVE      XXCO#         ##CO#
     C                   MOVE      XXFND         ##FND
     C                   MOVE      XXEMP#        ##EMP#
     C                   MOVE      XXDIV         ##DIV
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY2
     C                   MOVEL     SRDTO         ##RNDT
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         ##BGDT
     C*
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         ##ENDT
     C*
     C                   MOVE      *HIVAL        #2TEMP            9 0
     C                   MOVE      #2TEMP        ##TEMP
     C*
     C                   CALL      'W7221C'
     C                   PARM                    ##CO#             3
     C                   PARM                    ##FND             3
     C                   PARM      *ZEROS        ##RPYM            6
     C                   PARM      QQQUE         ##QUE            10
     C                   PARM      'D'           ##MODE            1
     C                   PARM                    ##EMP#            9
     C                   PARM                    ##DIV             5
     C                   PARM                    ##RNDT            8
     C                   PARM      *ZEROS        ##DUE             9
     C                   PARM      *BLANKS       ##SRT             1
     C                   PARM      *ZEROS        ##FAGT            5
     C                   PARM      '99999'       ##TAGT            5
     C                   PARM                    ##BGDT            8
     C                   PARM                    ##ENDT            8
     C                   PARM      *ZEROS        ##FEMP            9
     C                   PARM                    ##TEMP            9
     C                   PARM      *BLANKS       ##LTAM            1
     C                   PARM      *BLANKS       ##LTCD            1
     C                   PARM      'Y'           ##PRMM            1
     C                   PARM      'Y'           ##CALL            1
     C                   PARM      ' '           ##COMPLETED       1
     C*                         Q
     C                   CLEAR                   XXCMD
     C                   MOVEL     QCA(5)        XXCMD            56
     C                   MOVE      '0'           XXRPT#
      *
     C                   MOVEL     'W7221R'      XXPGM
     C     ORKY          CHAIN     POR01                              60
     C     *IN60         IFEQ      *OFF
     C                   MOVE      ORCOPY        XXCOPY            1
     C                   ENDIF
     C                   Z-ADD     56            LENGTH
     C     *LIKE         DEFINE    *IN99         SVIN99
     C                   MOVE      *IN99         SVIN99
     C                   CALL      'QCMDEXC'                            99
     C                   PARM                    XXCMD
     C                   PARM                    LENGTH           15 5
     C                   MOVE      SVIN99        *IN99
     C*
     C                   ENDSR
     C*====================================================================
     C* Call premium notice program
     C*====================================================================
     C     W7321R        BEGSR
     C*
     C                   MOVE      *BLANKS       XXPPRT            1            PREM NOTICE PRT
     C                   MOVE      XXCO#         ##CO#
     C                   MOVE      XXFND         ##FND
     C                   MOVE      XXFYR         ##PYR
     C                   MOVE      XXEMP#        ##EMP#
     C                   MOVE      XXDIV         ##DIV
     C*
     C                   Z-ADD     XXYMD         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         ##DATE
     C                   MOVEL     SRDTO         ##DAT2
     C                   Move      depDays       ##ADDU
      /free
       Clear ##DRes;
       Clear ##DRmk;
       If QQDart = 'Y';
       // Get Default DARTS Remark Code From Admin/DARTS control maint
          Chain FNkey pex02;
          If %found and EXPnrm <> ' ';
             ##DRes = 'Y';
             ##DRmk = EXpnrm;
          Endif;
       Endif;
      /end-free
     C*

     c                   Call      'W7321R'
     c                   Parm                    ##Co#             3
     c                   Parm                    ##Fnd             3
     c                   Parm                    ##Date            8
     c                   Parm                    ##Dat2            8
     c                   Parm                    ##Addu            3
     c                   Parm      'Y'           ##Exdf            1
     c                   Parm      *Blanks       ##Com1            2
     c                   Parm      *Blanks       ##Com2            2
     c                   Parm      *Blanks       ##Com3            2
     c                   Parm                    ##PYr             3
     c                   Parm                    ##Emp#            9
     c                   Parm                    ##Div             5
     c                   Parm      *Zeros        ##FrDt            8
     c                   Parm      *Zeros        ##ToDt            8
     c                   Parm      *Blanks       ##Srt1            2
     c                   Parm      *Blanks       ##Srt2            2
     c                   Parm      *Blanks       ##FrEa            2
     c                   Parm      *Blanks       ##ToEa            2
     c                   Parm      *Blanks       ##FrAa            2
     c                   Parm      *Blanks       ##ToAa            2
     c                   Parm      *Blanks       ##FrEn            9
     c                   Parm      *Blanks       ##ToEn            9
     c                   Parm      *Blanks       ##FrAn            5
     c                   Parm      *Blanks       ##ToAn            5
     c                   Parm      qqQue         ##Que            10
     c     xxPPrt        Parm      'D'           ##Mode            1
     c                   Parm                    ##DRmk            5
     c                   Parm      *Zeros        ##IDys            3
     c                   Parm      'Y'           ##Grma            1
     c                   Parm      '0000001'     ##Minb            7
     c                   Parm                    ##DRes            1
     c                   Parm      'Y'           ##Dep             1
     c                   Parm      'Y'           ##Exp             1
     c                   Parm      'P'           ##PFB             1
     c                   Parm                    ##Mass
     c                   Parm      EXspyb        ##SupPrYr         1
     C                   Parm      'Y'           ##Call            1
     C*
      *
      * PREM NOTICE PGM WILL PASS BACK A 'Z' IF SPOOL FILE WAS PRODUCED SO
      * THAT CHGSPLFA COMMAND IS NOT EXECUTED IN ERROR
      *
     C     XXPPRT        IFEQ      'Z'
     C                   MOVEL     QCA(4)        XXCMD            56
     C                   MOVEL     'W7321R'      XXPGM
     C                   MOVE      '0'           XXRPT#
     C     ORKY          CHAIN     POR01                              60
     C     *IN60         IFEQ      *OFF
     C                   MOVE      ORCOPY        XXCOPY            1
     C                   ENDIF
     C                   Z-ADD     56            LENGTH
     C                   CALL      'QCMDEXC'
     C                   PARM                    XXCMD
     C                   PARM                    LENGTH           15 5
     C                   ENDIF                                                  XXPPRT
     C*
     C                   ENDSR
     C*
      *==================================================================*
      * QTELTR - Print Quote Disclosure Letter
      *==================================================================*
     CSR   QTELTR        BEGSR
      /Free

       If isQuote;

       Else;

      /End-Free
      *
     C     QQQTE         IFEQ      'Q'
     C     QQCALL        OREQ      '2'
     C*
     C                   MOVE      *BLANKS       #1FOLD           80
     C                   MOVE      *BLANKS       #1DCID           12
      *
     C     QQRMCD        IFNE      *BLANKS
     C     QQDART        ANDEQ     'Y'
      *
      * Get Resolved Document Name
      *
     C                   MOVE      QQCO#         #1CO#
     C                   MOVE      QQFND         #1FND
     C                   MOVE      'BL'          QQPRE             2
      *
     C                   CALL      'SNXTDCID'
     C                   PARM      *BLANKS       #1FOLD           80
     C                   PARM      *BLANKS       #1DCID           12
     C                   PARM      'BL'          #1PRE             2
     C                   PARM                    #1CO#             3
     C                   PARM                    #1FND             3
     C                   PARM      *BLANK        #1RTCD            1
      *
     C                   ENDIF                                                  QQRMCD NE BLANK
      *
      * Create Letter
      *
     C                   OPEN      WXTEP
      *
     C                   CLEAR                   PTE01
     C                   Z-ADD     ELCO#         TECO#
     C                   Z-ADD     ELFND         TEFND
     C                   Z-ADD     ELEMP#        TEEMP#
     C                   Z-ADD     ELDIV         TEDIV
     C                   Z-ADD     ELFYR         TEFYR
     C                   Z-ADD     ELETER        TEETER
     C                   MOVEL(P)  EMNAME        TEENAM
     C                   MOVEL(P)  FNNAME        TEFNAM
     C                   Z-ADD     XXDATE        TEISUD
      *
     C                   MOVEL(P)  EMNAME        TEENM1
     C                   MOVEL(P)  EMNAM2        XXNM10           10
     C                   MOVE      XXNM10        TEENM1
     C                   MOVE(P)   EMNAM2        TEENM2
      *
     C                   SELECT
      *
     C     EMMPFL        WHENEQ    'M'
     C                   MOVEL(P)  EMMAD1        TEADR1
     C                   MOVEL(P)  EMMAD2        TEADR2
     C                   MOVEL(P)  EMMCTY        TECITY
     C                   MOVEL(P)  EMMST         TEST
     C                   MOVEL(P)  EMMZIP        X5ZIP             5
     C                   MOVE(P)   EMMZIP        X4ZIP             4
      *
     C     EMMPFL        WHENEQ    'P'
     C                   MOVEL(P)  EMPAD1        TEADR1
     C                   MOVEL(P)  EMPAD2        TEADR2
     C                   MOVEL(P)  EMPCTY        TECITY
     C                   MOVEL(P)  EMPST         TEST
     C                   MOVEL(P)  EMPZIP        X5ZIP             5
     C                   MOVE(P)   EMPZIP        X4ZIP             4
      *
     C                   OTHER
     C                   ENDSL
      *
     C                   MOVEL(P)  X5ZIP         TEZIP
     C     X4ZIP         IFNE      *ZEROS
     C                   CAT       '-':0         TEZIP
     C                   CAT       X4ZIP:0       TEZIP
     C                   ENDIF
      *
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         TEPFDT
     C*
     C                   MOVEL(P)  EMUWTR        TEUWTR
     C                   MOVEL(P)  EMUWTR        UPUSNM
     C     EMUWTR        CHAIN     PUP02                              60
     C                   MOVEL     UPUSNM        TEUNNM
     C*
     C                   Z-ADD     ELFYR         XXFYR
     C     RPKY          CHAIN     PRP01                              60
      *
     C     *IN60         IFEQ      *OFF
     C     RPCAP#        ANDNE     *BLANKS
     C                   MOVEL     RPCAP#        TECAP#
      *
     C                   ELSE
      *
     C                   MOVEL(P)  ELFND         TECAP#
     C                   MOVEL(P)  ELEMP#        X1TMP             9
     C                   CAT(P)    X1TMP:0       TECAP#
     C                   MOVEL(P)  ELFYR         X1TMP             9
     C                   CAT(P)    X1TMP:0       TECAP#
     C                   ENDIF
      *
     C                   WRITE     PTE01
     C                   CLOSE     WXTEP
      *
     C                   CALL      'W4118C'
     C                   PARM      'CLT114'      #2SFLD           80
     C                   PARM      'QTEDISC'     #2SDOC           12
     C                   PARM      #1FOLD        #2PFLD           80
     C                   PARM      #1DCID        #2PDOC           12
     C                   PARM      QQQUE         #2OUTQ           10
      *
     C     QQRMCD        IFNE      *BLANKS
     C     QQDART        ANDEQ     'Y'
      *
      * Create DARTS remark
      *
     C                   MOVE      *BLANKS       QCKEY
     C                   Z-ADD     XXCO#         QCCO#
     C                   Z-ADD     XXFND         QCFND
     C                   Z-ADD     XXEMP#        QCEMP#
     C                   Z-ADD     XXDIV         QCDIV
     C*
     C     QQQTE         IFEQ      'Q'
     C                   MOVE      'Q'           QCQTE
     C                   ELSE
     C                   MOVE      *BLANK        QCQTE
     C                   ENDIF
     C                   MOVEL(P)  QCKEY         Q#KEY            40
     C                   MOVEL(P)  QQRMCD        Q#RMCD            5
      *
     C                   MOVE(P)   *BLANKS       Q#COMM
     C     'QUOTE DI'    CAT(P)    'SCLOSU':0    Q#COMM
     C                   CAT(P)    'RE':0        Q#COMM
     C                   CAT(P)    'LETTER':1    Q#COMM
      *
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C                   MOVEL(P)  SRDTO         Q#CDAT            8
      *
     C                   MOVEL(P)  #1DCID        Q#DCID
     C                   MOVEL(P)  #1FOLD        Q#FOLD
      *
     C                   CALL      'DA700R'
     C                   PARM                    Q#KEY            40
     C                   PARM                    Q#COMM
     C                   PARM                    Q#CDAT
     C                   PARM                    Q#DCID
     C                   PARM      'W0050R'      Q#PNAM           10
     C                   PARM      *ZEROS        Q#SECL            3
     C                   PARM      Q1USER        Q#USER           10
     C                   PARM      Q1PGM         Q#PGM            10
     C                   PARM                    Q#FOLD
     C                   PARM      *BLANK        Q#DIFL            1
     C                   PARM      Q1PGM         Q#IPGM           10
     C                   PARM      *BLANK        Q#FL01            1
     C                   PARM      *BLANK        Q#FL02            1
     C                   PARM                    Q#RMCD
     C                   PARM      '00000'       Q#SEQ#            5
     C                   PARM      'N'           Q#SBYL            1
     C                   PARM      *BLANKS       Q#COM2           19
     C                   PARM      *BLANKS       Q#APID            2
     C                   PARM      *BLANKS       Q#IDOC           12
     C                   PARM      *BLANKS       Q#IQUE           10
     C                   PARM      *BLANK        Q#IMGF            1
     C                   PARM      *BLANKS       Q#IPTH           10
     C                   PARM      *ZEROS        Q#PIDX            5
     C                   PARM      *BLANK        Q#QPTY            1
     C                   PARM      *BLANKS       Q#DCTP            5
     C                   PARM      *BLANKS       Q#CSID            2
     C                   PARM      *BLANKS       Q#CODE            2
      *
     C                   ENDIF                                                  QQRMCD
     C                   ENDIF
      /Free

       Endif;

      /End-Free
     C                   ENDSR                                                  QTELTR
      *==================================================================*
      * POLHLD - Print Policyholder Disclosure Letter                    *
      *==================================================================*
     C     POLHLD        BEGSR
     C                   MOVE      *BLANKS       #1FOLD           80
     C                   MOVE      *BLANKS       #1DCID           12
      *
     C     QQRMCD        IFNE      *BLANKS
     C     QQDART        ANDEQ     'Y'
      *
      * Get Resolved Document Name
      *
     C                   MOVE      QQCO#         #1CO#
     C                   MOVE      QQFND         #1FND
     C                   MOVE      'BL'          QQPRE             2
      *
     C                   CALL      'SNXTDCID'
     C                   PARM      *BLANKS       #1FOLD           80
     C                   PARM      *BLANKS       #1DCID           12
     C                   PARM      'BL'          #1PRE             2
     C                   PARM                    #1CO#             3
     C                   PARM                    #1FND             3
     C                   PARM      *BLANK        #1RTCD            1
      *
     C                   ENDIF                                                  QQRMCD NE BLANK
      *
      * Create Letter
      *
     C                   OPEN      WXTEP
      *
     C                   CLEAR                   PTE01
     C                   Z-ADD     ELCO#         TECO#
     C                   Z-ADD     ELFND         TEFND
     C                   Z-ADD     ELEMP#        TEEMP#
     C                   Z-ADD     ELDIV         TEDIV
     C                   Z-ADD     ELFYR         TEFYR
     C                   Z-ADD     ELETER        TEETER
     C                   MOVEL(P)  EMNAME        TEENAM
     C                   MOVEL(P)  FNNAME        TEFNAM
     C                   Z-ADD     XXDATE        TEISUD
     C*
     C*
     C                   Z-ADD     ELFYR         XXFYR
     C     RPKY          CHAIN     PRP01                              60
      *
     C     *IN60         IFEQ      *OFF
     C     RPCAP#        ANDNE     *BLANKS
     C                   MOVEL     RPCAP#        TECAP#
      *
     C                   ELSE
      *
     C                   MOVEL(P)  ELFND         TECAP#
     C                   MOVEL(P)  ELEMP#        X1TMP             9
     C                   CAT(P)    X1TMP:0       TECAP#
     C                   MOVEL(P)  ELFYR         X1TMP             9
     C                   CAT(P)    X1TMP:0       TECAP#
     C                   ENDIF
      *
     C                   WRITE     PTE01
     C                   CLOSE     WXTEP
     C                   If        isQuote
     C                   Eval      #1Dcid = 'QUOTE'
     C                   Endif
     C*
     C     ELPFDT        IFGE      1150101
     C                   CALL      'W4118C'
     C                   PARM      'CLT114'      #2SFLD           80
     C                   PARM      'DISCLLTR.1'  #2SDOC           12
     C                   PARM      #1FOLD        #2PFLD           80
     C                   PARM      #1DCID        #2PDOC           12
     C                   PARM      QQQUE         #2OUTQ           10
     C                   Movel(p)  'DISCLLTR.1'  xxDisclForm
     C                   ELSE
      *
     C                   CALL      'W4118C'
     C                   PARM      'CLT114'      #2SFLD           80
     C                   PARM      'DISCLLTR'    #2SDOC           12
     C                   PARM      #1FOLD        #2PFLD           80
     C                   PARM      #1DCID        #2PDOC           12
     C                   PARM      QQQUE         #2OUTQ           10
     C                   Movel(p)  'DISCLLTR'    xxDisclForm
     C                   ENDIF
      *
      /Free

       If isQuote;

       Else;

      /End-Free
     C     QQRMCD        IFNE      *BLANKS
     C     QQDART        ANDEQ     'Y'
      *
      * Create DARTS remark
      *
     C                   MOVE      *BLANKS       QCKEY
     C                   Z-ADD     XXCO#         QCCO#
     C                   Z-ADD     XXFND         QCFND
     C                   Z-ADD     XXEMP#        QCEMP#
     C                   Z-ADD     XXDIV         QCDIV
     C*
     C     QQQTE         IFEQ      'Q'
     C                   MOVE      'Q'           QCQTE
     C                   ELSE
     C                   MOVE      *BLANK        QCQTE
     C                   ENDIF
     C                   MOVEL(P)  QCKEY         Q#KEY            40
     C                   MOVEL(P)  QQRMCD        Q#RMCD            5
      *
     C                   MOVE(P)   *BLANKS       Q#COMM
     C     'DISCLOSU'    CAT(P)    'RE':0        Q#COMM
     C                   CAT(P)    'LETTER':1    Q#COMM
      *
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DATCHK
     C                   MOVEL(P)  SRDTO         Q#CDAT            8
      *
     C                   MOVEL(P)  #1DCID        Q#DCID
     C                   MOVEL(P)  #1FOLD        Q#FOLD
      *
     C                   CALL      'DA700R'
     C                   PARM                    Q#KEY            40
     C                   PARM                    Q#COMM
     C                   PARM                    Q#CDAT
     C                   PARM                    Q#DCID
     C                   PARM      'W0050R'      Q#PNAM           10
     C                   PARM      *ZEROS        Q#SECL            3
     C                   PARM      Q1USER        Q#USER           10
     C                   PARM      Q1PGM         Q#PGM            10
     C                   PARM                    Q#FOLD
     C                   PARM      *BLANK        Q#DIFL            1
     C                   PARM      Q1PGM         Q#IPGM           10
     C                   PARM      *BLANK        Q#FL01            1
     C                   PARM      *BLANK        Q#FL02            1
     C                   PARM                    Q#RMCD
     C                   PARM      '00000'       Q#SEQ#            5
     C                   PARM      'N'           Q#SBYL            1
     C                   PARM      *BLANKS       Q#COM2           19
     C                   PARM      *BLANKS       Q#APID            2
     C                   PARM      *BLANKS       Q#IDOC           12
     C                   PARM      *BLANKS       Q#IQUE           10
     C                   PARM      *BLANK        Q#IMGF            1
     C                   PARM      *BLANKS       Q#IPTH           10
     C                   PARM      *ZEROS        Q#PIDX            5
     C                   PARM      *BLANK        Q#QPTY            1
     C                   PARM      *BLANKS       Q#DCTP            5
     C                   PARM      *BLANKS       Q#CSID            2
     C                   PARM      *BLANKS       Q#CODE            2
      *
     C                   ENDIF                                                  QQRMCD
      /Free

       Endif;

      /End-free
      *
     C                   ENDSR                                                  POLHLD
     C*====================================================================
     C* W7321C - CALL W7321C TO WRITE PREMIUM NOTICE
     C*====================================================================
     C     W7321C        BEGSR
      *
      //*** Beg Add ***** 02/27/25 *******************************
       //Generate premium notice for SRD or non-summarized divisions
       If EMdiv = xsDiv or ELarsm = *Blank;
          //Generate Premium notice
       Else;
          Leavesr;
       Endif;
      //*** End Add ***** 02/27/25 *******************************
      *** Beg Add ***** 09/01/23 *************************************************
       If qqQte = 'Q';
          ##Mode = 'Q';
       Else;
          ##Mode = 'D';
       Endif;
      *** End Add ***** 09/01/23 *************************************************
     C                   MOVE      XXCO#         ##CO#
     C                   MOVE      XXFND         ##FND
     C                   MOVE      XXFYR         ##PYR
     C                   MOVE      XXEMP#        ##EMP#
     C                   MOVE      XXDIV         ##DIV
     C                   Z-ADD     XXYMD         SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         ##DATE
     C                   MOVEL     SRDTO         ##DAT2
     C                   SELECT
     C                   OTHER
     C                   MOVE      'P'           ##PFB             1
     C                   ENDSL
     C*
     C*   Get Default DARTS Remark Code From Admin/DARTS control maint
     C     FNKEY         CHAIN     PEX02                              60
     C     *IN60         IFEQ      *OFF
     C                   MOVEL     EXPNRM        ##DRMK
     C                   ELSE
     C                   MOVEL     QQRMCD        ##DRMK
     C                   ENDIF
     C                   Move      depDays       ##ADDU
     C*
     C                   CALL      'W7321C'
     C                   PARM                    ##CO#             3
     C                   PARM                    ##FND             3
     C                   PARM                    ##DATE            8
     C                   PARM                    ##DAT2            8
     C                   PARM                    ##ADDU            3
     C                   PARM      'Y'           ##EXDF            1
     C                   PARM      *BLANKS       ##COM1            2
     C                   PARM      *BLANKS       ##COM2            2
