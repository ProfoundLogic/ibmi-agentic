     C*
     C                   ENDSR                                                  DOBAL SUBR
     c*  srFlatRateAdj - IL Flat rate Adjustment.
     C*********************************************************************
     c     srFlatRateAdj begsr
     c*
     c                   eval      xxFlrtAdj = elmapr - xtpred
     c                   eval      xtpred = 0

     c                   if        xxFlrtAdj <> 0
     c                   clear                   pep01
     c                   eval      epco#  = xxco#
     c                   eval      epfnd  = xxfnd
     c                   eval      epfyr  = xxfyr
     c                   eval      epemp# = xxemp#
     c                   eval      epclas = xxstcd
     c                   eval      epcode = xxstcd
     c                   eval      epefdt = xxSpltDt
     c                   eval      epempr = xxFlrtAdj
     c                   eval      epeapr = 0
     c                   eval      eparat = 0
     c                   eval      epdesc = xcILRate
     c                   eval      eppst  = xxst
     c*
     c                   endif                                                  xxFlrtAdj

     c                   endsr
     c*********************************************************************
      *** Beg Add ***** 09/01/23 **************************
       //===============================================================
       // Write Scriptura Workfile - Bills Payroll
       //===============================================================
       Begsr ScriptPayrolls;
       // *IN90 = *On  - Net Rate flag (F1NETR) = 'Y'
       //Fields from QHEAD3
        Clear pbl0p1;
        B1CO# = EMCo#;
        B1FND = EMFnd;
        B1EMP# = EMEmp#;
        B1DIV  = EMDiv;
        B1FYR  = ELFyr;
        B1Type = xxBillType;

        B1Clas = EPCLAS;
        B1Spec = EPSpec;
        B1Ext = EPEXT;
        B1Desc = PRDESC;
        If *In90 = *Off;
           B1Rate = EPARAT;
        Else;
           B1NetRt = XQARAT;
        Endif;
        //Rate and Net Rate
        If *In90 = *On;
           B1NetRt = XQARAT;
        Else;
           B1Rate = EPARAT;
        Endif;
        B1Pay  = XXEAPR;
        B1Prem = XXEMPR;
        B1MPRMSN = XXEMSN;
        //Additional Load
        If *In62 = *On;
           B1ADDLOAD = XXADLD;
           Select;
           When *In49 = *Off and *In32 = *Off;
              B1ADDTXT = 'Additional Load';
           When *In49 = *Off and *In32 = *On;
              B1ADDTXT = 'Territory Differential';
           When *In49 = *On;
              B1ADDTXT = 'Stop Gap Premium';
           Endsl;
        Endif;
        //Class code From/To dates
        Select;
        When *In97 = *On;
           B1CLEFDT = XXFRDT;
           B1CLTODT = XXTODT;
        When *In97 = *Off and *In88 = *Off;
           B1CLEFDT = XXFRAV;
           B1CLTODT = XXTOAV;
        When *In97 = *Off and *In88 = *On;
           B1CLEFDT = X1FRAV;
           B1CLTODT = X1TOAV;
        Endsl;
        //Expiration Date
        If EPCADT <> 0;
           B1CLTODT = %Dec(%Char(%Date(EPcadt:*cymd):*usa0):8:0);
        Else;
           If B1CLTODT = %Dec(%Char(%Date(ELPTDT:*cymd):*usa0):8:0);
              Clear B1CLTODT;
           Endif;
        Endif;

        B1Pgm  = Q1PGM;
        B1User = Q1USER;
        B1Time = %Dec(%Char(%Time():*iso0):6:0);
        B1Dt   = %Dec(%Char(%Date():*cymd0):7:0);

        intBLKeyPyrl += 1;
        B1Key = intBLKeyPyrl;
        //Current Bill
        If xmlBillName <> *Blank;
           B1XML = xmlBillName;
           Write pbl0p1;
        Endif;

        //Combined Bill
        If xmlCombName <> *Blank;
           B1XML = xmlCombName;
           Write pbl0p1;
        Endif;

       Endsr;

       //===============================================================
       // Write Scriptura Workfile - Bills Payroll for Summarized Bill
       //===============================================================
       Begsr ScriptPayrolls_Sum;
       // *IN90 = *On  - Net Rate flag (F1NETR) = 'Y'
       //Fields from QHEAD3
        Clear pbl0p1;
        B1CO# = EMCo#;
        B1FND = EMFnd;
        B1EMP# = EMEmp#;
        B1DIV  = EMDiv;
        B1FYR  = ELFyr;
        B1Type = xxBillType;

        B1PAYDIV = EPDIV;         //Payroll Division
        B1RATEST = XXst;          //Rating State
        B1Clas = EPCLAS;
        B1Spec = EPSpec;
        B1Ext = EPEXT;
        //Effective date
        B1CLEFDT = XPEFDT;
        //Expiration date
        If EPCADT <> 0;
           B1CLTODT = %Dec(%Char(%Date(EPcadt:*cymd):*usa0):8:0);
        Else;
           Clear B1CLTODT;
        Endif;
        B1Desc = EPDESC;
        If *In90 = *Off;
           B1Rate = EPARAT;
        Else;
           B1NetRt = XQARAT;
        Endif;
        //Additional Load
        If EPADLD <> 0;
           B1ADDLOAD = EPADLD;
           ##CO# = %editc(ELCO#: 'X');
           ##FND = %editc(ELFND: 'X');
           ##FYR = %editc(ELFYR: 'X');
           ##EMP# = %editc(ELEMP#: 'X');
           ##DIV = %editc(ELDIV: 'X');
           ##DAT1 = %editc(EPEFDT: 'X');
           ##TYPE = 'P';
           ##Clas = %editc(EPCLAS: 'X');
           SrEffd(##CO#:##FND:##FYR:##EMP#:##DIV:##DAT1:##TYPE:##CLAS);
           xxEFDT1 = %Int(##DAT1);
           Setgt (EPco#:EPClas:EPExt:RSJRST:XXEfDt1) ppx01;
           Readpe (EPco#:EPClas:EPExt:RSJRST) ppx01;
           B1ADDTXT = 'Additional Load';
           If not %Eof(WMPXL1) and PXcode <> *Zero and EPext <> *Blanks;
              B1ADDTXT = 'Territory Differential';
           Endif;
        Endif;
        B1Pay  = EPEAPR;
        B1Prem = EPEMPR;
        B1MPRMSN = XXEMSN;
        B1Pgm  = Q1PGM;
        B1User = Q1USER;
        B1Time = %Dec(%Char(%Time():*iso0):6:0);
        B1Dt   = %Dec(%Char(%Date():*cymd0):7:0);

        intBLKeyPyrlS += 1;
        B1Key = intBLKeyPyrlS;
        //Summarized Bill
        If xmlSumName <> *Blank;
           B1XML = xmlSumName;
           Write pbl0p1;
        Endif;

        //Summarized Combined Bill
        If xmlSumCombName <> *Blank;
           B1XML = xmlSumCombName;
           Write pbl0p1;
        Endif;

       Endsr;
       //=========================================================================
       //  ScriptXML - Reserve/Update XML record for Scriptura output.
       //=========================================================================
       Begsr ScriptXML;

       XXBLSC = %Editc(ELBSCD:'X');
       Chain BSKey1 pbs01;
       Chain Q1User pup01;

       xmlFile = ' ';
       message = %trim(processType);
       string = ' ';

       If isMassReq;

          In *Lock *dtaara;
          Out *dtaara;

          If ldMassFile <> ' ';
             xmlFile = %trim(ldMassFile);
          Else;

             // Create mass entry
             StLetter('XMLREQUEST':xmlFile:message:' ':'000000000':'  ':
             processTypeD:'000':'000':massFlag:xmlLink);

             // Update LDA with mass flow name
             In *Lock *dtaara;
             ldMassFile = %trim(xmlFile);
             Out *dtaara;

             Chain (xmlFile) xp100;
             XPCat = 'PS';
             Update xp100;
          EndIf;

          isMassReq = *off;
          massReqGen = 'Y';
          xmlFileName = xmlFile;
          xmlLink = xmlFile;
       Endif;

       // Create individual entry
       StLetter('XMLREQUEST':xmlFile:message:'E':%editc(x#RRN:'X'):xxPre:
        string:%editc(xxCo#:'X'):%editc(xxFnd:'X'):massFlag:xmlLink);

       If xmlFileName = *Blank;
          xmlFileName = xmlFile;
       Endif;

       //Update XMLPrep record that was created above
       If xmlLink = *Blank;
          Chain (xmlFile) xp100;
          xmlFile = XPxmlT;
       Else;
          Chain (xmlFileBlank:xmlLink:xmlFile) xp100;
       Endif;

       If %Found(xmlprel1);

          XPdata = 'Y';
          If BLpathc <> *Blank;
             XPdcid = BLdocc;
             XPPath = BLpathc;
          Else;
             XPdcid = BLdoc;
             XPPath = BLpath;
          Endif;

          //Remark code for Mid-term endorsement
          // Skip solo document if agent copy and don't create darts.
          If qqStep = '2';  // 04/23/2024
             XPdart = ' ';
             XPrmCd = ' ';
             XPskip = 'Y';
          Else;
             // Skip solo document if combo document is created.
             If (xxCombine = 'Y' And xmlLink <> *Blank);
                XPskip = 'Y';
             EndIf;

             If XPDart = 'Y' and ldEndA <> *Blank and ldEndA <> *Zeros;
                If EXRev <> *Blank;
                   XPRmCd = EXRev;
                Else;
                   XPRmCd = QQRmCd;
                Endif;
             Endif;
          Endif;

          If xxEmail = 'Y' and ldEndA <> *Blank and ldEndA <> *Zeros;
             Clear XPMail;
             Clear XPMailAdd;
             If xxCombine = *Blank;
                XPEmaild = keyEmail;
             Else;
                XPEmaild = *Blank;
             Endif;
          Endif;

          If (ldEndA = *Zeros or ldEndA = *Blank) and xxCombine = 'Y';
             Clear XPMail;
             Clear XPMailAdd;
          Endif;

          If qqQte = 'Q';
             XPQte = 'Q';
          Else;
             XPQte = *Blank;
          Endif;

       //*** begin chg ***  11/25/25  *************************************
       //*****   If xxCombine = 'Y' Or qqCall = '2';
          If xxCombine = 'Y' Or QQStep = '2';
             XPEmaild = *Blank;
       //*** end chg *****  11/25/25  *************************************
             Clear XPMail;
             Clear XPMailAdd;
          Endif;
          XPIDesc = RtviDartsDesc(processType:'I');
          Update xp100;
       Endif;

       //Set keyEmial field in LDA. This value will get picked up and written to
       // XMLPREP record of the individual premium notice to later set them as
       // an additional attachment to the individual bill email.
       If (ldEndA = *Zeros or ldEndA = *Blank) and xxCombine <> 'Y';
          If isPrmNotice = *On;
             In *Lock *dtaara;
             keyEmail= %Trim(Q1User) + %subst(%char(%timestamp:*iso0):1:17);
             Out *dtaara;
          Endif;
       Endif;

       xmlBillName = xmlFile;

       strXPFile = XPFile;
       strXPDir = XPDir;

       If xmlCombName = *Blank;
          strXPFile1 = XPFile;         //Store output file name for single div bill
       Endif;

       //*** Begin Add *** 05/07/24 **********************************
       If EMstRp = 'Y';
          strXPFileSRD = XPFile;
          strXPDirSRD  = XPDir;
       EndIf;
       //*** End   Add *** 05/07/24 **********************************

       //Request Additional Template for Retrospective Rating Plan
       If qqQte = 'Q' and (BSlpgm = 'P' or BSlpgm = 'I');
          outputFile = XPFile;
          templateFile = outputFile;
          StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
          xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));
          Chain (templateFile) xt101;
          If %Found(xmlteml1);
             //Set Template file name and Path
             If BLNotePC <> *BLank;
                XTDcId = BLNoteDC;
                XTPath = BLNotePC;
             Else;
                XTDcId = BLNoteD;
                XTPath = BLNoteP;
             Endif;
             XTType = 'Notice of Election of Retrospective Rating';
             //*** Beg Add ***** 02/04/25 **************************************
             XTData = 'Y';
             XTCo#  = EMCo#;
             XTFnd  = EMFnd;
             XTEmp# = EMEmp#;
             XTDiv  = EMDiv;
             XTFyr  = ELFyr;
             //*** End Add ***** 02/04/25 **************************************
             Update xt101;
          Endif;
          xmlRetroName = templateFile;
       Endif;

       //Summarized Bill
       //*** Beg Chg ****** 05/07/24 **********************************
       //***If xxARSUM = 'Y' and xmlLink <> *Blank and xmlSumName = *Blank;

       //***   StLetter('XMLREQUEST':xmlFile:message:'E':%editc(x#RRN:'X'):xxPre:
       //***    string:%editc(xxCo#:'X'):%editc(xxFnd:'X'):massFlag:xmlLink);
       //*** Beg Chg ****** 01/02/25 **********************************
       //***If xxARSUM = 'Y' and xmlLink <> *Blank and xmlSumName = *Blank and
       //*** xsRRN <> 0;
       If xxARSUM = 'Y' and xmlLink <> *Blank and xmlSumName = *Blank and
        xsRRN <> 0 and isSummary;
       //*** End Chg ****** 01/02/25 **********************************

          StLetter('XMLREQUEST':xmlFile:message:'E':%editc(xsRRN:'X'):xxPre:
           string:%editc(xxCo#:'X'):%editc(xxFnd:'X'):massFlag:xmlLink);
       //*** End Chg ****** 05/07/24 **********************************

          Chain (xmlFileBlank:xmlLink:xmlFile) xp100;
          If %Found(xmlprel1);
       //*** begin add ***  12/05/24  ********************************
             If XPDart = 'Y' and ldEndA <> *Blank and EXRev <> ' ';
                XPRmCd = EXRev;
             Endif;
       //*** end add *****  12/05/24  ********************************

             // If we are doing the agent turn then don't create
             // DARTS and set item to be skipped for agent and
             // insured copies
             If (qqStep = '2') Or
                (qqStep <> '2' And xxCombine = 'Y' And xmlLink <> *Blank);
                XPskip = 'Y';
                If (qqStep = '2');
                   XPrmCd    = ' ';
                   XPdart    = ' ';
                   XPMail    = ' ';
                   XPMailAdd = ' ';
                EndIf;
             EndIf;

             XPdata = 'Y';
             If BLSumPC <> *BLank;
                XPDcId = BLsumDC;
                XPPath = BLSumPC;
             Else;
                XPDcId = BLsumD;
                XPPath = BLSumP;
             Endif;

             If xxEmail = 'Y' and ldEndA <> *Blank and ldEndA <> *Zeros;
                Clear XPMail;
                Clear XPMailAdd;
                If xxCombine = *Blank;
                   XPEmaild = keyEmail;
                Else;
                   XPEmaild = *Blank;
                Endif;
             Endif;

             //*** Beg Chg ***** 05/07/24 *******************************
             //***If (ldEndA = *Zeros or ldEndA = *Blank) and xxCombine = 'Y';
             //*** End Chg ***** 05/07/24 *******************************
             //***   Clear XPMail;
             //***   Clear XPMailAdd;
             //***Endif;
             //Clear these fields as Summary Bill will never be emailed by itself. It's either
             // emailed as part of Combo doc or as an additional attachment to regular bill email
             Clear XPMail;
             Clear XPMailAdd;
             //*** End Chg ***** 05/07/24 *******************************

             If qqQte = 'Q';
                XPQte = 'Q';
             Else;
                XPQte = *Blank;
             Endif;

             XPIDesc = RtviDartsDesc(processType:'S');
             Update xp100;
          Endif;
          xmlSumName = xmlFile;
       Endif;

       //*** Begin Add *** 05/07/24 ********************************
       // Setting email preferences on summary bills
       If xmlSumName <> ' ' And strXPfileSRD <> ' ' And
          xxCombine <> 'Y';
          Chain (xmlFileBlank:xmlLink:xmlSumName) xp100;
          If %Found(xmlprel1);
             XPEmailF = strXPFileSRD;
             XPEmailD = strXPDirSRD;
             Update xp100;
          EndIf;
       EndIf;
       //*** End   Add *** 05/07/24 ********************************

       //Combined Bill
       If xxCombine = 'Y' And xmlLink <> *Blank And qqStep <> '2' and
        xsRRN <> 0;

          If xmlCombName = *Blank;
             //For Combined Bill: This will generate XMLPREP for the first division for Employer
             StLetter('XMLREQUEST':xmlFile:message:'E':%editc(xsRRN:'X'):xxPre:
              string:%editc(xxCo#:'X'):%editc(xxFnd:'X'):massFlag:xmlLink);

             Chain (xmlFileBlank:xmlLink:xmlFile) xp100;
             If %Found(xmlprel1);
          //*** begin add ***  12/05/24  ********************************
                If XPDart = 'Y' and ldEndA <> *Blank and EXRev <> ' ';
                   XPRmCd = EXRev;
                Endif;
          //*** end add *****  12/05/24  ********************************
                //*** Beg Add ***** 02/04/25 *****************************************
                comboBillXMLKey = xmlFile;
                //*** End Add ***** 02/04/25 *****************************************
                XPdata = 'Y';
                //Set Template file name and Path
                If BLPathC <> *BLank;
                   XPDcId = BLDocC;
                   XPPath = BLPathC;
                Else;
                   XPDcId = BLDoc;
                   XPPath = BLPath;
                Endif;

                //This will keep the combination bill from being included in the
                //Overall combined document for the entired process
                XPNoComb = 'Y';
                XPEmaild = *Blank;

                If xxEmail = 'Y' and ldEndA <> *Blank and ldEndA <> *Zeros;
                   Clear XPMail;
                   Clear XPMailAdd;
                   XPEmaild = keyEmail;
                Endif;

                If qqQte = 'Q';
                   XPQte = 'Q';
                Else;
                   XPQte = *Blank;
                Endif;
             //*** begin add ***  07/17/25  ***********************************
             //*** begin del ***  10/25/25  ***********************************
             //*****   Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xsDiv) pep07;
             //*****   If not %Found(wmepl7);
             //*****      XPType = ' ';
             //*****      XPDcid = 'Blank.scd';
             //*****      XPPath = '/Reports/Base/Policy/';
             //*****   Endif;
             //*** end del *****  10/25/25  ***********************************
             //*** end add *****  07/17/25  ***********************************

                XPIDesc = RtviDartsDesc(processType:'C');
                Update xp100;
             Endif;

             //Set keyEmial field in LDA. This value will get picked up and written to
             // XMLPREP record of the individual premium notice to later set them as
             // an additional attachment to the combination bill email.
             If xxEmail = 'Y' and (ldEndA = *Zeros or ldEndA = *Blank)
              and isPrmNotice = *On and BDMrgprn = *Blank;
                In *Lock *dtaara;
                keyEmail= %Trim(Q1User) +
                 %subst(%char(%timestamp:*iso0):1:17);
                Out *dtaara;
             Endif;

             xmlCombName = xmlFile;
             outputFileComb = XPFile;
             strXPFileComb = XPFile;
             strXPDirComb = XPDir;
             strXPFILE1 = XPFile;         //Store output file name for Combined bill
             // Update LDA with output file name
             In *Lock *dtaara;
             ldOutputFile = %trim(outputFileComb);
             Out *dtaara;

             //*** Beg Add ***** 02/04/25 **********************************************
             //If division being processed in not State Reporting Division,
             // save the xml key for SRD and request XMLTEMP for the div being processed
             If EMdiv = xsDiv;
                xmlCombName = comboBillXMLKey;
             Else;
                //Request XMLTEMP for division being processed
                templateFile = outputFileComb;
                StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
                xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));
                Chain (templateFile) xt101;
                If %Found(xmlteml1);
                   //Set Template file name and Path
                   If BLPathC <> *BLank;
                      XTDcId = BLDocC;
                      XTPath = BLPathC;
                   Else;
                      XTDcId = BLDoc;
                      XTPath = BLPath;
                   Endif;
                   XTData = 'Y';
                   XTCo#  = EMCo#;
                   XTFnd  = EMFnd;
                   XTEmp# = EMEmp#;
                   XTDiv  = EMDiv;
                   XTFyr  = ELFyr;
                   Update xt101;
                Endif;
                xmlCombName = templateFile;
             Endif;
             //*** End Add ***** 02/04/25 **********************************************

             //Request Additional Template for Retrospective Rating Plan for combined bill
             If qqQte = 'Q' and (BSlpgm = 'P' or BSlpgm = 'I');
                templateFile = outputFileComb;
                StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
                xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));
                Chain (templateFile) xt101;
                If %Found(xmlteml1);
                   //Set Template file name and Path
                   If BLNotePC <> *BLank;
                      XTDcId = BLNoteDC;
                      XTPath = BLNotePC;
                   Else;
                      XTDcId = BLNoteD;
                      XTPath = BLNoteP;
                   Endif;
                   XTType = 'Notice of Election of Retrospective Rating';
                   //*** Beg Add ***** 02/04/25 **************************************
                   XTData = 'Y';
                   XTCo#  = EMCo#;
                   XTFnd  = EMFnd;
                   XTEmp# = EMEmp#;
                   XTDiv  = EMDiv;
                   XTFyr  = ELFyr;
                   //*** End Add ***** 02/04/25 **************************************
                   Update xt101;
                Endif;
                xmlCombRetroName = templateFile;
             Endif;

             //*** Beg Chg ***** 01/02/25 **********************************
             //***If xxARSUM = 'Y';
             If xxARSUM = 'Y' and isSummary;
             //*** End Chg ***** 01/02/25 **********************************
                templateFile = outputFileComb;
                StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
                xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));
                Chain (templateFile) xt101;
                If %Found(xmlteml1);
                   //Set Template file name and Path
                   If BLPathC <> *BLank;
                      XTDcId = BLsumDC;
                      XTPath = BLSumPC;
                   Else;
                      XTDcId = BLsumD;
                      XTPath = BLSumP;
                   Endif;
                   //*** Beg Add ***** 02/04/25 **************************************
                   XTData = 'Y';
                   XTCo#  = EMCo#;
                   XTFnd  = EMFnd;
                   XTEmp# = EMEmp#;
                   XTDiv  = XSDiv;
                   XTFyr  = ELFyr;
                   //*** End Add ***** 02/04/25 **************************************
                   Update xt101;
                Endif;
                xmlSumCombName = templateFile;
             Endif;
          Else;
             //For Combined Bill: This will generate Additional Template for other divisions
             //*** Beg Add ***** 02/04/25 ***********************************************
             If EMdiv = xsDiv;
                xmlCombName = comboBillXMLKey;
                //Change Template order in the case where first processing Div was not SRD
                Setgt (outputFileComb) xt100;
                Readpe (outputFileComb) xt100;
                If %Found(xmlteml);
                   Chain (xmlFileBlank:xmlLink:comboBillXMLKey) xp100;
                   If %Found(xmlprel1);
                      XPOrder = XIorder + 1;
                      Update xp100;
                   Endif;
                Endif;
             Else;
             //*** End Add ***** 02/04/25 ***********************************************
                templateFile = outputFileComb;
                StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
                xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));

                Chain (templateFile) xt101;
                If %Found(xmlteml1);
                   //Set Template file name and Path
                   If BLPathC <> *BLank;
                      XTDcId = BLDocC;
                      XTPath = BLPathC;
                   Else;
                      XTDcId = BLDoc;
                      XTPath = BLPath;
                   Endif;
                   //*** Beg Add ***** 02/04/25 **************************************
                   XTData = 'Y';
                   XTCo#  = EMCo#;
                   XTFnd  = EMFnd;
                   XTEmp# = EMEmp#;
                   XTDiv  = EMDiv;
                   XTFyr  = ELFyr;
                   //*** End Add ***** 02/04/25 **************************************
                   Update xt101;
                Endif;
                xmlCombName = templateFile;
             //*** Beg Add ***** 02/04/25 **************************************
             Endif;
             //*** End Add ***** 02/04/25 **************************************
             //Request Additional Template for Retrospective Rating Plan for combined bill
             If qqQte = 'Q' and (BSlpgm = 'P' or BSlpgm = 'I');
                templateFile = outputFileComb;
                StLetter('TEMPLRQST':templateFile:message:'E':%editc(x#RRN:'X'):
                xxPre:string:%editc(xxCo#:'X'):%editc(xxFnd:'X'));
                Chain (templateFile) xt101;
                If %Found(xmlteml1);
                   //Set Template file name and Path
                   If BLNotePC <> *BLank;
                      XTDcId = BLNoteDC;
                      XTPath = BLNotePC;
                   Else;
                      XTDcId = BLNoteD;
                      XTPath = BLNoteP;
                   Endif;
                   XTType = 'Notice of Election of Retrospective Rating';
                   //*** Beg Add ***** 02/04/25 **************************************
                   XTData = 'Y';
                   XTCo#  = EMCo#;
                   XTFnd  = EMFnd;
                   XTEmp# = EMEmp#;
                   XTDiv  = EMDiv;
                   XTFyr  = ELFyr;
                   //*** End Add ***** 02/04/25 **************************************
                   Update xt101;
                Endif;
                xmlCombRetroName = templateFile;
             Endif;

          Endif;                                //xmlCombName = *Blank
       Endif;                                   //xxCombine = 'Y'
       //*** begin add ***  10/25/25  **********************************
       If noPayrollBill = 'Y';
          Clear pbl0p1;
          B1CO# = EMCo#;
          B1FND = EMFnd;
          B1EMP# = EMEmp#;
          B1DIV  = EMDiv;
          B1FYR  = ELFyr;
          B1Type = xxBillType;

          B1Desc = '<No Payrolls Exist>';

          B1Pgm  = Q1PGM;
          B1User = Q1USER;
          B1Time = %Dec(%Char(%Time():*iso0):6:0);
          B1Dt   = %Dec(%Char(%Date():*cymd0):7:0);

          intBLKeyPyrl += 1;
          B1Key = intBLKeyPyrl;
          //Current Bill
          If xmlBillName <> *Blank;
             B1XML = xmlBillName;
             Write pbl0p1;
          Endif;

          //Combined Bill
          If xmlCombName <> *Blank;
             B1XML = xmlCombName;
             Write pbl0p1;
          Endif;

       Endif;
       //*** end add *****  10/25/25  **********************************

       Endsr;
      *** End add ***** 09/01/23 **************************

     O/COPY W7615OSPEC
      *** Beg add ***** 09/01/23 **************************
       //===============================================================
       // Write Scriptura Workfile - Bills Header
       //===============================================================
       Dcl-Proc ScriptHeader;
       Dcl-Pi *N;
        inXMLFileName Char(60);
       End-Pi;
        //  *In38 = *Off - Estimated Bill, Revised Bill
        //  *In38 = *On  - Quotation, Renewal Quote

        //Fields from QHEAD2
        Clear pbl0p;
        B0XML = inXMLFileName;
        B0CO# = EMCo#;
        B0FND = EMFnd;
        B0EMP# = EMEmp#;
        B0DIV  = EMDiv;
        B0FYR  = ELFyr;
        B0TYPE = xxBillType;
        //Title
        B0Title = billTitle;
        //Valid Until
        If *In38 = *On and EX#DYS <> 0;
           B0ValDtHd = 'Valid Until:';
           If DSDate <> 0;
              wkDate = %Dec(%Char(%Date(DSDate:*mdy):*usa0):8:0);
              wkDate1 = %Date(wkDate:*usa) + %Days(EX#DYS);
              B0ValDate = %Dec(wkDate1);
           Endif;
        Endif;
        //Premium/Contribution
        If isContri = '1';
           B0PrmWord = 'Contribution';
        Else;
           B0PrmWord = 'Premium';
        Endif;

        //Reference#
        If *in38 = *On;
           B0RefHdg = 'Quote Reference:';
        Else;
           B0RefHdg = 'Policy Reference:';
        Endif;
        B0Policy# = QQpol#;

        B0PerdHd = XQperd;          //Policy Period heading:Participation Period OR For Period
        B0PfDate = %Dec(%Char(%Date(ELpfdt:*cymd):*usa0):8:0);
        B0PtDate = %Dec(%Char(%Date(ELptdt:*cymd):*usa0):8:0);
        B0DivHd  = XQDivH;
        If XQDiv <> *Blank;
           B0Div = %Int(XQDiv);
        Endif;
        If *In38  = *On;
           B0PrtDtHd = X1PROD;
        Else;
           B0PrtDtHd = XQPROD;
        Endif;
        If DSDate <> 0;
           B0PrtDate = %Dec(%Char(%Date(DSDate:*mdy):*usa0):8:0);
        Endif;
        If *In87  = *On;
           B0AnvDtHd = XQAnnH;
           If ELandt <> 0;
              B0AnvDate = %Dec(%Char(%Date(ELandt:*cymd):*usa0):8:0);
           Endif;
        Endif;
        B0RtStHd = XQRstH;
        B0RateSt = XXst;
        B0CarHdg = XQCapH;
        B0CarPol = XXCap#;
        B0WName1 = XXEMN1;
        B0WName2 = XXEMN2;
        B0WName3 = XXEMN3;
        B0WName4 = XXEMN4;
        B0WAddr1  = XXEMN5;
        B0WAddr2  = XXEMN6;
        B0WAddr3  = XXEMN7;

        //Experiene Modifiers
        If *In58 = *Off;
           If IsActive(ELemd1);
              If ELnoexm1 = 'Y';
                 B0MOD1 = *Zeros;
              Else;
                 B0MOD1 = ELExm1;
              Endif;
              B0MODDT1 = ELEmd1;
              B0ARP1   = ELArp1;
           Endif;
           If IsActive(ELemd2);
              If ELnoexm2 = 'Y';
                 B0MOD2 = *Zeros;
              Else;
                 B0MOD2 = ELExm2;
              Endif;
              B0MODDT2 = ELEmd2;
              B0ARP2   = ELArp2;
           Endif;
           If IsActive(ELemd3);
              If ELnoexm3 = 'Y';
                 B0MOD3 = *Zeros;
              Else;
                 B0MOD3 = ELExm3;
              Endif;
              B0MODDT3 = ELEmd3;
              B0ARP3   = ELArp3;
           Endif;
        Endif;
        //*** Beg Add ***** 06/06/25 *****************************
        //increased Limits
        If ELilcd <> *blanks;
           B0EMLB = LMDESC;
           B0LMACC = LMACC;
           B0LMDIS = LMDIS;
           B0LMAGG = LMAGG;
        Endif;
        //*** End Add ***** 06/06/25 *****************************
        //Standard Liability Limits
        //*** begin chg *** 11/05/25 *****************************
        //*****If *In58 = *Off and *In48 = *Off;
        If ELilcd = *blanks;
        //*** end chg ***** 11/05/25 *****************************
           B0EMLB = RREMLB;
           B0LMACC = RRACC;
           B0LMDIS = RRDIS;
           B0LMAGG = RRAGG;
        Endif;
        //Deductible Info: Ded Plan,Description,Amount per occurance/Claim, Aggregate amount
        If *In46 = *Off;
           B0dedt = XXdedt;          //Deductible Plan
           B0ddd1 = XXddd1;          //Deductible Description
           B0Ampo = XXampo;
           B0amag = XXamag;
           B0ddvb = XXddvb;          //'Per Claim' or 'Per Occurrence'
        Endif;
        //Amount Due
        If *In57 = *Off;
           B0NetP = QNETP;
           //*** Beg Add ***** 02/25/25 ************************************************
           //For Credit balance, QNetp is zero so print Balance (xxBal) instead of 0
           If QNetP = *Zeros and xxBal < 0 and *In29 = *On;     //*In29=*On - Estimating Acct Bill
              B0NetP = xxBal;
           Endif;
           //*** End Add ***** 02/25/25 ***********************************************
        Endif;
        //Amount Due date:
        If *In57 = *Off;
           If *In29 = *On;
              B0duDt = DDUB;
           Else;
              B0duDt = X1Dued;
           Endif;
        Endif;
        //Comment
        B0COM1 = BCCOM1;
        B0COM2 = BCCOM2;
        B0COM3 = BCCOM3;
        //Make the Check Payable verbiage
        //*** begin del ***  03/31/25  ***********************************
        //*****If xxClt# = '129';
        //*****   clear xxChCk;
        //*****Endif;
        //*** end del *****  03/31/25  ***********************************
        If xx3rdPV <> *Blank;
           B0PayVbg = xx3rdPV;
        Else;
           B0PayVbg = XXChCk;
        ENDIF;
        //Footer
        B0ConNam = OFACNM;
        B0ConAdr1 = OFAAD1;
        B0ConAdr2 = OFAAD2;
        //*** Beg Chg ***** 07/02/25 ***************************
        //*B0ConAdr3 = %Trim(OFACTY) + ', ' + %Trim(OFst) + ' ' + OFMZ1;
        B0ConAdr3 = %Trim(OFACTY) + ', ' + %Trim(OFAst) + ' ' + OFMZ1;
        //*** End Chg ***** 07/02/25 ***************************
        If OFMZ2 <> '0000';
           B0ConAdr3 = %Trim(B0ConAdr3) + '-' + OFMZ2;
        Endif;
        B0ConArea = OFAAra;
        B0ConPhn# = OFAPhn;
        B0AgtNam = X1PrNm;
        B0AgtAdr1 = X2AGNM;
        B0AgtAdr2 = AADD1;
        B0AgtAdr3 = ACSZ;
        B0Agt# = XQAGT#;
        B0Foot1 = %Subst(EXBTXT:1:80);
        B0Foot2 = %Subst(EXBTXT:81:80);
        B0Foot3 = %Subst(EXBTXT:161:80);
        B0AgtArea = AGARE1;
        B0AgtPhn# = AGPHN1;

        //Net Rate Flag
        B0NetRtF = F1NETR;

        //Minimum Premium Invoked Flag
        B0MinF = XXMINF;

        //Retrospective Rating fields
        B0Mnfc = ELMnfc;
        B0Mxfc = ELMxfc;
        B0lcvf = ELlcvf;
        B0bsfc = ELbsfc;
        B0tax  = ELtax;
        B0taxF = ELtaxF;
        B0elp  = ELelp;
        B0elpF = ELelpF;
        B0rdf1 = ELrdf1;
        B0rdf2 = ELrdf2;
        B0rdf3 = ELrdf3;
        B0retn = ELretn;

        B0Pgm  = Q1PGM;
        B0User = Q1USER;
        B0Time = %Dec(%Char(%Time():*iso0):6:0);
        B0Dt   = %Dec(%Char(%Date():*cymd0):7:0);

        If inXMLFileName = xmlBillName;
           If ELARSM = 'Y';                   //If AR summarized policy
              B0SUMM = 'Y';
           Endif;
           Write pbl0p;
           If xmlCombName <> *Blank;
              B0XML = xmlCombName;
              Write pbl0p;
           Endif;
           B0SUMM = ' ';
           If xmlRetroName <> *Blank;
              B0XML = xmlRetroName;
              Write pbl0p;
           Endif;
           If xmlCombRetroName <> *Blank;
              B0XML = xmlCombRetroName;
              Write pbl0p;
           Endif;
        Endif;
        If inXMLFileName = xmlSumName;
           B0SUMM = ' ';
           B0Title = %Trim(billTitle) + ' SUMMARY';
           Write pbl0p;
           If xmlSumCombName <> *Blank;
              B0XML = xmlSumCombName;
              Write pbl0p;
           Endif;
        Endif;

       End-Proc;
       //===============================================================
       // Write Scriptura Workfile - Bill Premium/Balance/Installments
       //===============================================================
       Dcl-Proc ScriptPremium;
       Dcl-Pi *N;
        inXMLFileName Char(60);
       End-Pi;
        //QPREM1
        Clear pbl0p2;
        Clear intBLKey;
        B2XML = inXMLFileName;
        B2CO# = EMCo#;
        B2FND = EMFnd;
        B2EMP# = EMEmp#;
        B2DIV  = EMDiv;
        B2FYR  = ELFyr;
        B2Type = xxBillType;
        B0PRMWORD = 'Premium/Contribution';
        B2Item = 'P';        //Premium
        B2Pgm  = Q1PGM;
        B2User = Q1USER;
        B2Time = %Dec(%Char(%Time():*iso0):6:0);
        B2Dt   = %Dec(%Char(%Date():*cymd0):7:0);
        For Index = 1 to 30;
           If QHdg(Index)  = *Blank;
              Leave;
           Endif;
           B2Hdg = QHdg(Index);
           //*** Beg Add *****  05/12/25  *******************************************
           // Print Full heading/message
           If B2Hdg = '* Indicated items not Prorated';
              B2Hdg = '* Indicated line items do not get prorated';
           Endif;
           //*** End Add *****  05/12/25  *******************************************
           //Percentage or Factor in Premium section
           Clear B2PrmPrc;
           Clear B2prmFact;
           intPos = %Scan('%':QPrc(index));
           If intPos <> 0;
              xxPercent = %Scanrpl('%':' ':QPrc(index));
              If xxPercent <> *Blank;
                 B2PrmPrc = %Dec(xxPercent:9:6);
              Endif;
           Else;
              If QPrc(index) <> *Blank;
                 B2prmFact = %Dec(QPrc(index):9:6);
              Endif;
           Endif;
           B2TAm = QTAm(Index);
           B2Sgn = QSgn(Index);
           intBLKey += 1;
           B2Key = intBLKey;
           //Write Premium record for current Bill for division
           B2XML = inXMLFileName;
           Write pbl0p2;
           //Write Premium record for combined Bill: For each Div
           If inXMLFileName = xmlBillName;
              If xmlCombName <> *Blank;
                 B2XML = xmlCombName;
                 Write pbl0p2;
              Endif;
           Endif;
           //Write Premium record for Summary Bill - Once for each employer
           If inXMLFileName = xmlSumName;
              If xmlSumCombName <> *Blank;
                 B2XML = xmlSumCombName;
                 Write pbl0p2;
              Endif;
           Endif;
        EndFor;

       End-Proc;
       //===============================================================
       // Write Scriptura Workfile - Balance
       //===============================================================
       Dcl-Proc ScriptBalance;
       Dcl-Pi *N;
        inXMLFileName Char(60);
       End-Pi;
        Clear pbl0p2;
        B2XML = inXMLFileName;
        B2CO# = EMCo#;
        B2FND = EMFnd;
        B2EMP# = EMEmp#;
        B2DIV  = EMDiv;
        B2FYR  = ELFyr;
        B2Type = xxBillType;
        B0PRMWORD = 'Balance';
        B2Item = 'B';           //Balance
        B2Pgm  = Q1PGM;
        B2User = Q1USER;
        B2Time = %Dec(%Char(%Time():*iso0):6:0);
        B2Dt   = %Dec(%Char(%Date():*cymd0):7:0);
        For Index = 1 to 20;
           If AHD(Index) <> *Blank or APC(Index) <> 0
            or AAM(Index) <> 0;
              B2AHD = AHD(Index);
              B2APC = APC(Index);
              B2AAM = AAM(Index);
              B2APS = APS(Index);
              //Write Balance record for current Bill for division
              B2XML = inXMLFileName;
              intBLKey += 1;
              B2Key = intBLKey;
              Write pbl0p2;
              //Write Balance record for combined Bill: For each Div
              If inXMLFileName = xmlBillName;
                 If xmlCombName <> *Blank;
                    B2XML = xmlCombName;
                    Write pbl0p2;
                 Endif;
              Endif;
              //Write Balance record for Summary Bill - Once for each employer
              If inXMLFileName = xmlSumName;
                 If xmlSumCombName <> *Blank;
                    B2XML = xmlSumCombName;
                    Write pbl0p2;
                 Endif;
              Endif;
           Endif;
        EndFor;

       End-Proc;
       //===============================================================
       // Write Scriptura Workfile - Installments
       //===============================================================
       Dcl-Proc ScriptInstallments;
       Dcl-Pi *N;
        inXMLFileName Char(60);
       End-Pi;
        Clear pbl0p2;
        B2XML = inXMLFileName;
        B2CO# = EMCo#;
        B2FND = EMFnd;
        B2EMP# = EMEmp#;
        B2DIV  = EMDiv;
        B2FYR  = ELFyr;
        B2Type = xxBillType;
        B0PRMWORD = 'Installments';
        B2Item = 'I';           //Installments
        B2Pgm  = Q1PGM;
        B2User = Q1USER;
        B2Time = %Dec(%Char(%Time():*iso0):6:0);
        B2Dt   = %Dec(%Char(%Date():*cymd0):7:0);
        For Index = 1 to 12;
           If DDU(Index) <> *Blanks or DUW(Index) <> *Blank or AMT(Index) <> 0;
              If BSFreq = 'W' or BSFreq = 'T';
              Monitor;
                 //For Weekly/Twice Weekly installment plan, only first two
                 // installments records are written
                 If Index = 1;
                    B2DUE = DUW(Index);
                    B2IAMT = AMT(Index);
                    If DDU(Index) <> *Blank;
                       intPos = %Scan(' ':DDU(Index):1);
                       strMonth = %Subst(DDU(Index):1:(intPos-1));
                       IndexMth = %Lookup(strMonth:Mnth);
                       intPos1 = %Scan(',':DDU(Index):1);
                       intDay=%Dec((%Subst(DDU(Index):(intPos+1):
                        (intPos1-1))):2:0);
                       intYear = %Dec((%Subst(DDU(Index):(intPos1+2))):4:0);
                       intDate = %Dec((%Editc(IndexMth:'X') +
                        %Editc(intDay:'X') + %Editc(intYear:'X')):8:0);
                       B2IDate = intDate;
                       B2IInfo = B2Due + '  ' +
                        %Char(%Date(B2IDate:*USA):*USA) + '  ' +
                        %Trim(%EditC(B2IAmt:'K':*CURSYM));
                    Endif;
                 Endif;
                 If Index = 3;
                    B2IDate = X1WKDT;
                    B2INum = ZZ;
                    B2IAMT = AMT(Index);
                    B2DUE = *Blanks;
                    B2DDU = *Blanks;
                    B2AMT = 0;
                    Clear B2IInfo;
                    If B2INum <> 0 and B2IAmt <> 0 and B2IDate <> 0;
                       Select;
                       When INSTVB = TWICVB;             //Twice a Month
                          B2IInfo = ', then ' +
                           %Char(B2INum) + 'weekly installments of ' +
                           %Trim(%EditC(B2IAmt:'K':*CURSYM)) + ' starting on ' +
                           %Char(%Date(B2IDate:*USA):*USA);
                       When INSTVB = WEEKVB;             //Weekly
                          B2IInfo = ', then ' +
                           %Char(B2INum) + ' ' +
                           'installments on the 1st and 15th of each month ' +
                           'starting ' + %Char(%Date(B2IDate:*USA):*USA) +
                           ' of ' + %Trim(%EditC(B2IAmt:'K':*CURSYM));
                       Endsl;
                    Endif;
                 Endif;
              On-Error;
              EndMon;
              Else;
                 B2DUE = DUW(Index);
                 B2DDU = DDU(Index);
                 B2AMT = AMT(Index);
              Endif;
              intBLKey += 1;
              B2Key = intBLKey;
              //Write Installment record for current Bill for division
              B2XML = inXMLFileName;
              Write pbl0p2;
              //Write Installment record for combined Bill: For each Div
              If inXMLFileName = xmlBillName;
                 If xmlCombName <> *Blank;
                    B2XML = xmlCombName;
                    Write pbl0p2;
                 Endif;
              Endif;
              //Write Installment record for Summary Bill - Once for each employer
              If inXMLFileName = xmlSumName;
                 If xmlSumCombName <> *Blank;
                    B2XML = xmlSumCombName;
                    Write pbl0p2;
                 Endif;
              Endif;
           Endif;
        EndFor;

       End-Proc;
       //===============================================================
       // Write Scriptura Workfile - Installments
       //===============================================================
       Dcl-Proc RtviDartsDesc;
       Dcl-Pi *N Char(256);
        inProessType Char(60);
        inBillType Char(1) const;
       End-Pi;

          xxTest = %xlate(lo:up:%subst(inProessType:1:1));
          If xxTest = 'E';
             strDesc = 'An';
          Else;
             strDesc = 'A';
          Endif;

          Select;
          //Individual Bill
          When inBillType = 'I';
             strDesc = %Trim(strDesc) + ' ' + %trim(inProessType);
          //Summary Bill
          When inBillType = 'S';
             pos = %Scan(' ':inProessType);
             strDesc = %Trim(strDesc) + ' ' + %Subst(inProessType:1:pos-1) +
              ' Summary Bill';
          //Combined Bill
          When inBillType = 'C';
             strDesc = 'A Combined ' + %trim(inProessType);
          Endsl;

          strDesc = %Trim(strDesc) + ' was requested by ' + %Trim(UPUSNM) +
           ' on ' + %Char(%Date():*USA) + ' for policy year ' +
           %Char(xxFyr) + '.';

          Return strDesc;

       End-Proc;
      *** End add ***** 09/01/23 **************************
      *=============================================================
      * ApplyRateSplit - Check option flag to apply rate split
      *=============================================================
     p ApplyRateSplit  b
     d ApplyRateSplit  pi              n
     d   inState                      2a
     d   inDate                       7  0
     d   outstcd                      5  0 options(*nopass)
      *
     d xxState         s              2a
     d xxSpltDt        s              7  0
     d xxPrcRate       s               n
      *
     C     rtky          klist
     C                   kfld                    xxco#
     C                   kfld                    xxfnd
     C                   kfld                    xxstate
     C                   kfld                    xxSpltDt          7 0
     C*
     C                   eval      xxPrcRate = *on
     C                   eval      xxState = inState
     C                   eval      xxSpltDt = inDate
     C     rtky          chain     prt0x
     C                   if        %found and rxopt = 'Y'
     C                   eval      xxPrcRate = *off
     C                   endif
     c                   if        %parms >= 3 and %found
     c                   eval      outstcd = rxstat
     c                   endif
     C*
     C                   return    xxPrcRate
     C*
     p ApplyRateSplit  e

       //***** Beg Add ******* 06/19/15 ********************************
     P* --------------------------------------------------
     P* Procedure name: QuoteProposal
     P* Purpose:        Print quote proposal document
     P* --------------------------------------------------
     P QuoteProposal   B
     D QuoteProposal   PI

      /Free

       If isPrtQuoteProposal and isQuote and qqDart = 'Y';

          isPrtQuoteProposal = *off;

          if XXCLT# = '114';
             QuoteProposal114();
          Endif;

       Endif;
      /End-free

     P QuoteProposal   E

     P* --------------------------------------------------
     P* Procedure name: QuoteProposal114
     P* Purpose:        Quote proposal for client 114
     P* --------------------------------------------------
     P QuoteProposal114...
     P                 B
     D QuoteProposal114...
     D                 PI
     D  index          s              3  0

      /Free

       Clear PB;
       Clear pfName1;
       Clear pfName2;
       // Clear pfName3;
       Clear xqRtCo;

       //  Format some of the data to be output

       //  Prepared for.
       pfName1 = EMname;
       pfname2 = %trim(EMfdnm) + %subst(EMfdn2:1:10);
       // pfname3 = %Subst(Emfdn2:11);

       index = 1;

       PB(index) = AGname;

       //If AGfdnm > *Blanks;
       //   index = index + 1;
       //   PB(index) = AGfdnm;
       //Endif;

       index = index + 1;
       PB(index) = AADD1;

       index = index + 1;
       PB(index) = ACSZ;

       //  Agent Phone number
       If AGare1 > 0;
          index = index + 1;
          PB(index) = 'Phone: (' + %char(AGare1) + ') ' +
                  %subst(%char(AGphn1):1:3) + '-' +
                  %subst(%char(AGphn1):4:4);
       Endif;

       //  Agent fax number
       If AGfaxa > 0;
          index = index + 1;
          PB(index) = 'Fax: (' + %char(AGfaxa) + ') ' +
                  %subst(%char(AGfax#):1:3) + '-' +
                  %subst(%char(AGfax#):4:4);
       Endif;

       Write QP114_1;
       write NEWPAGE;

       Write QP114_2;
       write NEWPAGE;

       Chain (xxCo#:'CRR ':GCdcar) wtgtl;
       If %found(WTGTL);
          xqRtCo = GTdesc;
       Endif;

       If xqRtCo = *blanks;
          xqRtCo = FNname;
       Endif;

       If xxToav <> *zeros;
          dsdt2 = xxToav;
          xxToAvc =  dsmm2 + '/' + dsdd2 + '/' + dsyy2;
       Else;
          xxToavc = 'N/A';
       Endif;

       For index = 1 to 50;
          If PolSts(index) > *Blanks;
             If index = 1;
                xqState = PolSts(index);
             Else;
                xqState = %trim(xqState) + ', ' + %trim(PolSts(index));
             Endif;
          Endif;
       Endfor;

       xxKey = ELilcd;
       Setgt (xxco#:xxFnd:xxst:xxKey:ELpfdt) WTLML1;
       Readpe (xxco#:xxFnd:xxst:xxKey) WTLML1;
       Dow not %EOF and LMstat = 'I';
          LMacc = *zeros;
          Readpe (xxco#:xxFnd:xxst:xxKey) WTLML1;
       Enddo;

       If LMacc > 0;
          xqAcc = LMacc;
          xqAgg = LMdis;
          xqDis = LMagg;
       Else;
          xqAcc = RRacc;
          xqAgg = RRdis;
          xqDis = RRagg;
       Endif;

       Write QP114_3;
       write NEWPAGE;

      /End-free

     P QuoteProposal114...
     P                 E

     P*================================================================
     P* ExcludeICArCodes - Checks to see if A/R Code is excluded from IC
     P*================================================================
     P ExcludeICArCodes...
     P                 B
     D ExcludeICArCodes...
     D                 PI              n
     d inCo#                          3  0 Const
     d inGroup                        3  0 Const
     d inState                        2    Const
     d inEfDt                         7  0 Const
     D inType                         2a   Const

     D arCode          s             10a
     d excludeIC       s               n   Inz(*Off)

      /Free

       arCode = ' ';

       Select;
       When inType = 'P';  // Premium
          // Find the default code
          Exec Sql Select EXesCd Into :arCode From WMEXP
              Where EXco#=:inCo# And EXfnd=:inGroup;
          // No default so get first
          If arCode = ' ';
             Exec Sql Select TTkey Into :arCode From WTTTP
                Where TTco#=:inCo# And TTtype='B' And TTcTyp='P'
                Limit 1;
          EndIf;
       When inType = 'T';  // Tax
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='T'
             Limit 1;
       When inType = 'D';  // Deposit
          // Find the default coe
          Exec Sql Select EXdaCd Into :arCode From WMEXP
              Where EXco#=:inCo# And EXfnd=:inGroup;
          // No default so get first
          If arCode = ' ';
             Exec Sql Select TTkey Into :arCode From WTTTP
                Where TTco#=:inCo# And TTtype='H' And TTcTyp='D'
                Limit 1;
          EndIf;
       When inType = 'TD'; // Tax On Deposit
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='D'
             Limit 1;
       When inType = 'I';  // Installment Fees
          Exec Sql Select IFifBl Into :arCode From WMIFP a
             Where IFco#=:inCo# And IFfnd=:inGroup and
                IFst=:inState And IFEfDt = (Select Max(b.IFefDt)
                From WMIFP b Where a.IFco#=b.IFco# And a.IFfnd=b.IFfnd
                  And a.IFst=b.IFst And b.IFefDt <= :inEfDt);
       When inType = 'A1'; // Assessment 1
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='1'
             Limit 1;
       When inType = 'A2'; // Assessment 2
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='2'
             Limit 1;
       When inType = 'A3'; // Assessment 3
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='3'
             Limit 1;
       When inType = 'A4'; // Assessment 4
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='4'
             Limit 1;
       When inType = 'A5'; // Assessment 5
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='5'
             Limit 1;
       When inType = 'A6'; // Assessment 6
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='6'
             Limit 1;
       When inType = 'A7'; // Assessment 7
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='7'
             Limit 1;
       When inType = 'E';  // Expense Constant
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='B' And TTcTyp='E'
             Limit 1;
       When inType = 'M';  // Membership Fee
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='M'
             Limit 1;
       When inType = 'S';  // Safety Fee
          Exec Sql Select TTkey Into :arCode From WTTTP
             Where TTco#=:inCo# And TTtype='F' And TTcTyp='S'
             Limit 1;
       EndSl;

       // Has the A/R code been excluded from Invoice Cloud?
       Exec Sql Select TTexIC Into :excludeIC From WTTTP
                Where TTco#=:inCo# And TTkey=:arCode;

       If excludeIC = 'Y';
          Return *On;
       Else;
          Return *Off;
       EndIf;

      /End-free

     P ExcludeICArCodes...
     P                 E
     P* --------------------------------------------------
     P* Procedure name: GetAnnualAmt
     P* Purpose:        Calculate annual amount costs
     P* Returns:
     P* Parameter:      inCo#
     P* Parameter:      inFnd
     P* Parameter:      inEmp#
     P* Parameter:      inDiv
     P* Parameter:      inFyr
     P* --------------------------------------------------
     P GetAnnualAmt    B
     D GetAnnualAmt    PI            11S 2
     D  inCo#                         3  0
     D  inFnd                         3  0
     D  inEmp#                        9  0
     D  inDiv                         5  0
     D  inFyr                         3  0

     D* Your local fields go here
     D outAmt          S             11S 2
      /Free

       Clear outAmt;
       Setgt (inCo#:inFnd:inEmp#:inDiv:inFyr) WMEAL6;
       Readpe (inCo#:inFnd:inEmp#:inDiv:inFyr) WMEAL6;
       Dow not %EOF;
          If EACTYP <> 'D';
             outAmt = outAmt + EAamt;
          EndIf;
          Readpe (inCo#:inFnd:inEmp#:inDiv:inFyr) WMEAL6;
       Enddo;

       Return    outAmt;

      /End-free
     P GetAnnualAmt    E
      *============================================
      * Returns *on if a split modifier condition
      * is detected
      *--------------------------------------------
     p isSplitMod      b
      *--------------------------------------------
     d isSplitMod      pi              n
     d  inFact1                            like(ELexm1)
     d  inFact2                            like(ELexm1)
     d  inPrem1                            like(ELexp1)
     d  inPrem2                            like(ELexp1)
     d  inDate1                            like(ELemd1)
     d  inDate2                            like(ELemd1)
      /free
       If (inPrem1 <> 0 or inFact1 = 1) and IsActive(inDate1) and
        (inPrem2 <> 0 or inFact2 = 1) and IsActive(inDate2)   and
        inFact1 <> inFact2;
          Return *on;
       Else;
          Return *off;
       Endif;
      /end-free
     p isSplitMod      e
      *============================================
      * Returns *on if inDate is within policy date
      * range
      *--------------------------------------------
     p isActive        b
      *--------------------------------------------
     d isActive        pi              n
     d  effDt                              like(ELemd1)
      /free
       If effDt < ELptdt and effDt <> 0;
          Return *On;
       Else;
          Return *Off;
       Endif;
      /end-free
     p isActive        e
      *============================================
      /Free
       Dcl-Proc AddWaiverToHdg;
       Dcl-Pi *N Char(30);
        inHdg Char(30);
       End-Pi;
       Dcl-S intLenWvVbg Zoned(1:0);
       Dcl-S intWvCnt Zoned(3:0);
       Dcl-S strWvVbg Char(7);
       If ELwvtp = 'B';
          Return inHdg;
       Endif;
       Select;
       When ELwvpc <> 0;
          %Subst(inHdg:28:3) = '(%)';
       When ELfchg <> 0;
          Setll (ELco#:ELfnd:ELemp#:ELdiv:ELfyr) pwv01;
          Dou %Eof(WMWVL1);
             Reade (ELco#:ELfnd:ELemp#:ELdiv:ELfyr) pwv01;
             If %Eof;
                Leave;
             Endif;
             intWvCnt += 1;
          Enddo;
          strWvVbg = '(' + %Trim(%EditC(intWvCnt:'Z')) + ')';
          intLenWvVbg = %Len(%Trim(strWvVbg));
          %Subst(inHdg:31 - intLenWvVbg:intLenWvVbg) = %Trim(strWvVbg);
       EndSl;
       Return inHdg;
       End-Proc;
      /End-Free
      //*** Beg Add ***** 09/01/23 *************************
       //===============================================================
       // Get Billing Template
       //===============================================================
       Dcl-Proc GetBillingTemplate;
       Dcl-Pi *N Char(25);
        inCo# Packed(3:0);
        inType Char(50);
        inFnd Packed(3:0);
        inSt Char(2);
       End-Pi;
       Dcl-S hasTempFound Ind Inz(*Off);
       //Retrieve Bill Document setup file
       Chain inCo# sbl00;
       //Retrieve Bill Documents Template Setup File
       Setgt (inCo#:inType:inFnd:inSt:xxCrDt) pbl100;
       Readpe (inCo#:inType:inFnd:inSt) pbl100;
       If Not %Eof(WSBL1L);
          hasTempFound = *On;
       Endif;
       Return hasTempFound;
       End-Proc;
      *=================================================================
      * Reorganize Templates so the combined document prints in order
      *=================================================================
       Dcl-Proc ReorganizeTemplates;
       Dcl-Pi *N;
        inXPLink Char(60);
       End-Pi;

       Dcl-S intLastOrder# Zoned(5:0);
       Dcl-S arrXMLFile Char(60) Dim(99999);

       //Re-arrange template order for Combined document: all the Bills will be printed
       // first, then Summary bill followed by Premium notices.
       Setll (xmlFileBlank:inXPLink) xp100;
       Reade (xmlFileBlank:inXPLink) xp100;
       Dow not %Eof(xmlprel1);
          If XPAddT = 'Y';
             //Find last template number (XTORDER) used for this combined bill
             Setgt (XPFile) xt100;
             Readpe (XPFile) xt100;
             //*** Beg Chg ***** 02/27/25 *************************
             //***If %Found(xmlteml);
             If not %Eof(xmlteml);
             //*** End Chg ***** 02/27/25 *************************
                intLastOrder# = XIorder;
                //Re-assign XTORDER for Summary Bill Document
                Setll (XPFile) xt100;
                Reade (XPFile) xt100;
                Dow not %Eof (xmlteml);
                   If XIDcid = BLSumd or XIDcid = BLSumDC;
                      intLastOrder# += 1;
                      Chain (XIxmlt) xt101;
                      If %Found(xmlteml1);
                         XTOrder = intLastOrder#;
                         Update xt101;
                         Leave;
                      Endif;
                   Endif;
                   Reade (XPFile) xt100;
                Enddo;
                //Re-assign XTORDER for Premium notice documents
                index = 0;
                Clear arrXMLFile;
                Setll (XPFile) xt100;
                Reade (XPFile) xt100;
                Dow not %Eof(xmlteml);
                   If XIType = 'Premium Notice';
                      index += 1;
                      arrXMLFile(index) = XIxmlt;
                   Endif;
                   Reade (XPFile) xt100;
                Enddo;
                index = 1;
                Dow arrXMLFile(Index) <> *Blank;
                   Chain (arrXMLFile(Index)) xt101;
                   If %Found(xmlteml1);
                      intLastOrder# += 1;
                      XTOrder = intLastOrder#;
                      Update xt101;
                   Endif;
                   index += 1;
                EndDo;
             Endif;
          Endif;
          Reade (xmlFileBlank:inXPLink) xp100;
       Enddo;
       End-Proc;
      //*** End Add ***** 09/01/23 *************************
