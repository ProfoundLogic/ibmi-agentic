     C     LDPCT1        ANDNE     *ZERO
     C*
     C     LDEFD1        IFNE      *ZERO
     C                   Z-ADD     LDEFD1        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     LDEXP1        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     LDEXP1        IFNE      *ZERO
     C                   Z-ADD     LDEXP1        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   Z-ADD     ELEDCT        TAM(A)
     C     ELEDCT        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDCT        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C                   MOVEL     CON(70)       HDG(A)
     c*
     c                   move      ldpct1        xxpct
     c*
     c                   move      *blanks       xxpct1           13
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
     c*
     c                   move      xxpct1        hdg(a)
     c*
     C                   ADD       1             A
     C                   END
     c*
     c                   endif                                                  if ldplv1 = 'S'
     c*
     c*  2nd Large Deductible applied to Standard
     c*
     c                   if        ldplv2 = 'S'
     c*
     C     ELEDD2        IFNE      *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     LDPCT2        ANDNE     *ZERO
     C*
     C     LDEFD2        IFNE      *ZERO
     C                   Z-ADD     LDEFD2        SRDTI
     C                   ELSE
     C                   Z-ADD     LDEXP1        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C*
     C                   Z-ADD     LDEXP2        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C*
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   Z-ADD     ELEDD2        TAM(A)
     C*
     C     ELEDD2        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDD2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C                   MOVEL     CON(71)       HDG(A)
     c*
     c                   move      ldpct2        xxpct
     c*
     c                   move      *blanks       xxpct1           13
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
     c*
     c                   move      xxpct1        hdg(a)
     c*
     C                   ADD       1             A
     C*
     C                   ENDIF
     c*
     c                   endif                                                  if ldplv2 = 'S'
     c*
     c                   ENDIF                                                  XXLRGD IFEQ 'Y'
     C*
     C*   CALCULATE MEMBERSHIP DUES PAID
     C*
     C                   Z-ADD     *ZERO         XXMFEE
     C                   MOVE      *OFF          *IN52
     C                   MOVE      'Q'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'M'                                          MEMBERSHIP FEES
     C                   ADD       EAAMT         XXMFEE            9 2
     C                   ENDIF
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C*   CALCULATE MEMBERSHIP DUES. PRORATE IT IF INDICATED.
     C*
     C                   Z-ADD     *ZERO         XXMDUE            7 2
     C     F1PMFL        IFEQ      'Y'                                          PRORATE MEMBER FEE
     C     PDAYS         ANDNE     FDAYS
     C                   Z-ADD     *ZERO         XXMPRO            5 4
     C     FDAYS         IFNE      *ZERO
     C     PDAYS         DIV(H)    FDAYS         XXMPRO
     C                   ENDIF                                                  IF FDAYS <> 0
     C     F1MFEE        MULT(H)   XXMPRO        XXMDUE
     C                   ELSE
     C                   Z-ADD     F1MFEE        XXMDUE                         BILL FULL MEMBER FEE
     C                   ENDIF                                                  IF F1PMFL = Y
     C                   Z-ADD(H)  XXMDUE        XXWK10
     C                   Z-ADD     XXWK10        XXMDUE
     C                   Z-ADD     ELMFAM        XXMDUE
     C                   Z-ADD     0             XXINST           11 2
     C                   Z-ADD     0             XXINPD           11 2
     C                   MOVE      *OFF          *IN67
     C     RRKY          SETGT     PIF01
     C     RRKY2         READPE    PIF01                                  60
      *
      * If ELIFFL flag is set to 'Y' or the IFEXPD date exists and  policy
      * effective date is after IFEXPD, do not bill the installment fees
      *
     C     *IN60         IFEQ      *OFF
     C     ELIFFL        IFEQ      'Y'
     C     IFEXPD        ORNE      *ZEROS
     C     ELPFDT        ANDGE     IFEXPD
     C                   MOVE      *ON           *IN60
     C                   ENDIF                                                  EFIFFL = 'Y'
     C                   ENDIF                                                  *IN60 = *ON
      *
     C     *IN60         IFEQ      *OFF
     C                   MOVE      'Q'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C     EAARCD        IFEQ      IFIFPD                                                   EES
     C     EAARCD        OREQ      IFIFTR                                                   EES
     C     EAARCD        OREQ      IFIFTC                                                   EES
     C                   ADD       EAAMT         XXINPD
     C                   ENDIF
     C*
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C                   ELSE
     C                   MOVE      *BLANK        IFIFBL
     C                   MOVE      *BLANK        IFIFPD
     C                   MOVE      *BLANK        IFIFTR
     C                   MOVE      *BLANK        IFIFTC
     C                   Z-ADD     0             IFIFEE
     C                   ENDIF
     C*
     C*   CALCULATE SAFETY FEES
     C*
     C                   Z-ADD     *ZERO         XXSDUE           11 0
     C                   Z-ADD     *ZERO         XXSFEE           11 2
     C                   MOVE      *OFF          *IN53
     C*
     C     ELSFPC        IFNE      *ZERO
     C     ELSFMN        ORNE      *ZERO
     C     QQQTE         IFEQ      'Q'
     C     QQCALL        OREQ      '2'
     C*
     C                   Z-ADD     0             XXPREM           15 4
     C                   SELECT
     C     RRSFAP        WHENEQ    'J'
     C                   Z-ADD     ELESBJ        XXPREM
     C     RRSFAP        WHENEQ    'E'
     C                   Z-ADD     ELEFRS        XXPREM
     C     RRSFAP        WHENEQ    'S'
     C                   Z-ADD     ELSTPR        XXPREM
     C     RRSFAP        WHENEQ    'D'
     C                   Z-ADD     ELENMP        XXPREM
     C     RRDV1L        IFEQ      'D'
     C                   ADD       ELEDC2        XXPREM
     C                   ENDIF
     C     RRDV2L        IFEQ      'D'
     C                   ADD       ELEDV2        XXPREM
     C                   ENDIF
     C                   ENDSL                                                  RRSFAP SELC
     C*
     C     ELSFPC        MULT      XXPREM        XXSFAM           15 4
     C     XXSFAM        DIV(H)    100           XXSDUE
     C*
     C     RRSPFL        IFEQ      'Y'
     C                   MULT(H)   ELPROR        XXSDUE
     C                   ENDIF                                                  RRSPFL IFEQ
     C*
     C     XXSDUE        IFLT      ELSFMN
     C                   Z-ADD     ELSFMN        XXSDUE
     C                   ENDIF                                                  XXSFEE IFLT
     C*
     C                   ELSE                                                   QQQTE IFEQ
     C*
     C                   MOVE      'F'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'S'                                          SAFETY FEES
     C                   ADD       EAAMT         XXSDUE
     C                   ENDIF
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C                   MOVE      'Q'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'S'                                          SAFETY FEES
     C                   ADD       EAAMT         XXSFEE
     C                   ENDIF
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C                   ENDIF                                                  QQQTE IFEQ
     C*
     C     RRSFHD        IFEQ      *BLANKS
     C                   MOVEL(P)  CON(32)       XXSFHD           20
     C                   ELSE
     C                   MOVEL(P)  RRSFHD        XXSFHD
     C                   ENDIF
     C*** begin add ***  04/03/25  *******************************************
     C* Store safety fee heading if it hasnt been set yet.
     C                   If        RRSFHD <> ' ' and svSFHD = ' '
     C                             and svSFHDFlg = ' '
     C                   Movel(p)  RRSFHD        svSFHD
     C*
     C                   Else
     C* If safety fee heading is different clear out stored value.
     C                   If        xxSFHD <> svSFHD
     C                   Clear                   svSFHD
     C                   Move      'Y'           svSFHDFlg
     C                   Endif
     C*
     C                   Endif                                                  If RRSFHD <> ' '
     C*** end add *****  04/03/25  *******************************************
     C                   Z-ADD     ELSFAM        XXSDUE
     C*
     C                   ENDIF                                                  ELSFPC IFNE
     C*** Begin Add ***  06/24/24  *********************************************
     C*
     C*   Calculate Collateral Payment and Billing Amounts
     C*
     C                   Z-ADD     0             XXCOLB           11 2
     C                   Z-ADD     0             XXCOLP           11 2
      /Free
       // Collateral Payment
       Exec Sql Select Sum(EAamt) Into :XXCOLP From WMEAP
          Where EAco# = :xxCo# And EAfnd = :xxFnd And EAemp# = :xxEmp#
          And EAdiv = :xxDiv and EAfyr = :xxFyr and (EAarcd = :EXcolp or
          EAarcd = :EXcolt);

       // Collateral Billing
       If *in63 = *on;                          // Estimated Bill
          If ELcolwa <> 0;
             XXCOLB = ELcolwa;
          Endif;
          If ELcolwa = 0 and ELcolwp <> 0;
             XXCOLB = %DecH((ELmapr * ELcolwp)/100:11:0);
          Endif;
       Else;                                    // Revised Bill
          Exec Sql Select Sum(EAamt) Into :XXCOLB From WMEAP
             Where EAco# = :xxCo# And EAfnd = :xxFnd And EAemp# = :xxEmp#
             And EAdiv = :xxDiv and EAfyr = :xxFyr and (EAarcd = :EXcolb or
             EAarcd = :EXcolo);
       Endif;
      /End-Free
     C*** End   Add ***  06/24/24  *********************************************
     C*
     C*   CALCULATE 1ST ASSESSMENT FEES
     C*
     C                   Z-ADD     *ZERO         XX1STD           11 0
     C                   Z-ADD     *ZERO         XX1STB           11 2
     C                   Z-ADD     *ZERO         XX1PD            11 2
     C                   MOVE      *OFF          *IN55
     C                   MOVE      *BLANKS       XX1STP            9
     C                   Z-ADD     RDAT(1)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   If        xspfdt <> 0
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   Endif
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C*
     C     RR1STP        IFNE      *ZERO
     C*
     C     EL1AAM        ORNE      *ZERO
     C*
     C     RR1STP        IFEQ      *ZERO
     C     RR1STF        ANDEQ     *ZERO
     C     RDAT(2)       ANDNE     *ZERO
     C*
     C     XXST          IFEQ      'PA'
     C                   Z-ADD     RDAT(2)       XXEFDT
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C                   ENDIF                                                  XXST IFEQ
     C*
     C                   ENDIF                                                  RR1STP IFEQ
      *
     C     RR1STH        IFEQ      *BLANKS
     C                   MOVEL(P)  CON(26)       XX1STH           20
     C                   ELSE
     C                   MOVEL(P)  RR1STH        XX1STH
     C                   ENDIF
     C*
     C                   MOVE      *BLANKS       X1ST              7
     C     RR1STF        IFNE      *ZERO
     C     EL1FPR        ANDNE     *ZERO
     C     EL1APR        ADD       EL1FPR        XXPREM
     C     EL1APR        DIV       XXPREM        XX1P              9 6
     C     EL1FPR        DIV       XXPREM        XX1F              9 6
     C                   MULT(H)   RR1STP        XX1P
     C                   MULT(H)   RR1STF        XX1F
     C                   ADD(H)    XX1P          XX1F
     C                   Z-ADD(H)  XX1F          X196              9 6
     C                   ELSE
     C                   MOVE      RR1STP        X196
     C                   ENDIF                                                  RR1STF IFNE
     C     X196          IFNE      *ZERO
     C                   MOVE      '%'           X196P
     C                   ENDIF
     C                   MOVEA     X1ST          NUM7
     C                   MOVE      '.'           PCT9(4)
     C                   MOVE      '%'           PCT9(9)
     C     NUM7(1)       IFNE      '0'
     C                   MOVE      NUM7(1)       PCT9(1)
     C                   ENDIF
     C     NUM7(2)       IFNE      '0'
     C     NUM7(1)       ORGT      '0'
     C                   MOVE      NUM7(2)       PCT9(2)
     C                   ENDIF
     C                   MOVE      NUM7(3)       PCT9(3)
     C                   MOVE      NUM7(4)       PCT9(5)
     C                   MOVE      NUM7(5)       PCT9(6)
     C                   MOVE      NUM7(6)       PCT9(7)
     C                   MOVE      NUM7(7)       PCT9(8)
     C                   MOVEA     PCT9          XX1STP
     C                   CLEAR                   PCT9
     C*
     C     QQQTE         IFEQ      'Q'
     C*** Begin Add *** 06/12/24 **********************************
     C     isSRAs        AndEq     *Off
     C*** End   Add *** 06/12/24 **********************************
     C     QQCALL        OREQ      '2'
     C*** Begin Add *** 06/12/24 **********************************
     C     isSRAs        AndEq     *Off
     C*** End   Add *** 06/12/24 **********************************
     C*
     C*
     C                   Z-ADD     EL1APR        XXPREM           15 4
     C*
     C     RR1STF        MULT      EL1FPR        XXAMT3           15 4
     C     RR1STP        MULT      EL1APR        XXPREM
     C                   ADD       XXPREM        XXAMT3
     C     XXAMT3        DIV(H)    100           XX1STD
     C                   Z-ADD     XX1STD        XX1STB
     C*
     C                   ELSE
     C*
     C*
     C*
     C*
     C                   ENDIF                                                  QQQTE IFEQ
     C*
       //*** Begin Add *** 06/12/24 **********************************
       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs;
       //*** End   Add *** 06/12/24 **********************************
     C                   Z-ADD     EL1AAM        XX1STB
       //*** Begin Add *** 06/12/24 ****************************************
       EndIf;
       //*** End   Add *** 06/12/24 ****************************************
      *
      *
     C*
     C                   ENDIF                                                  RR1STP IFNE
     C                   MOVE      'Q'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      '1'
       //*** Begin Add *** 06/12/24 **********************************
       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs;
       //*** End   Add *** 06/12/24 **********************************
     C                   ADD       EAAMT         XX1PD
     C                   ADD       EAAMT         XXDPRP
       //*** Begin Add *** 06/12/24 ****************************************
       EndIf;
       //*** End   Add *** 06/12/24 ****************************************
     C                   ENDIF
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C     BSSEFL        IFEQ      'S'
     C                   SUB       XX1PD         XX1STB
     C                   ENDIF                                                  BSSEFL IFEQ
     C     XX1STB        IFNE      *ZERO
     C                   MOVE      *ON           *IN55
     C                   ENDIF
     C*
     C*   CALCULATE 2ND ASSESSMENT FEES
     C*
     C                   Z-ADD     *ZERO         XX2NDD           11 0
     C                   Z-ADD     *ZERO         XX2NDB           11 2
     C                   Z-ADD     *ZERO         XX2PD            11 2
     C                   MOVE      *BLANKS       XX2NDP            9
     C                   Z-ADD     RDAT(1)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   If        xspfdt <> 0
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   Endif
     C                   ENDIF
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C                   MOVE      *OFF          *IN56
     C*
     C     RR2NDP        IFNE      *ZERO
     C     EL2AAM        ORNE      *ZERO
     C*
     C     RR2NDP        IFEQ      *ZERO
     C     RR2NDF        ANDEQ     *ZERO
     C     RDAT(2)       ANDNE     *ZERO
     C*
     C     XXST          IFEQ      'PA'
     C                   Z-ADD     RDAT(2)       XXEFDT
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C                   ENDIF                                                  XXST IFEQ
     C*
     C                   ENDIF                                                  RR2NDP IFEQ
     C*
     C     RR2NDH        IFEQ      *BLANKS
     C                   MOVEL(P)  CON(27)       XX2NDH           20
     C                   ELSE
     C                   MOVEL(P)  RR2NDH        XX2NDH
     C                   ENDIF
     C*
     C                   MOVE      *BLANKS       X2ND              7
     C     RR2NDF        IFNE      *ZERO
     C     EL2FPR        ANDNE     *ZERO
     C     EL2APR        ADD       EL2FPR        XXPREM
     C     EL2APR        DIV       XXPREM        XX2P              9 6
     C     EL2FPR        DIV       XXPREM        XX2F              9 6
     C                   MULT(H)   RR2NDP        XX2P
     C                   MULT(H)   RR2NDF        XX2F
     C                   ADD(H)    XX2P          XX2F
     C                   Z-ADD(H)  XX2F          X296              9 6
     C                   ELSE
     C                   MOVE      RR2NDP        X296
     C                   ENDIF                                                  RR2NDF IFNE
     C     X296          IFNE      *ZERO
     C                   MOVE      '%'           X296P
     C                   ENDIF
     C                   MOVEA     X2ND          NUM7
     C                   MOVE      '.'           PCT9(4)
     C                   MOVE      '%'           PCT9(9)
     C     NUM7(1)       IFNE      '0'
     C                   MOVE      NUM7(1)       PCT9(1)
     C                   ENDIF
     C     NUM7(2)       IFNE      '0'
     C     NUM7(1)       ORGT      '0'
     C                   MOVE      NUM7(2)       PCT9(2)
     C                   ENDIF
     C                   MOVE      NUM7(3)       PCT9(3)
     C                   MOVE      NUM7(4)       PCT9(5)
     C                   MOVE      NUM7(5)       PCT9(6)
     C                   MOVE      NUM7(6)       PCT9(7)
     C                   MOVE      NUM7(7)       PCT9(8)
     C                   MOVEA     PCT9          XX2NDP
     C                   CLEAR                   PCT9
     C*
     C     QQQTE         IFEQ      'Q'
     C*** Begin Add *** 06/12/24 **********************************
     C     isSRAs        AndEq     *Off
     C*** End   Add *** 06/12/24 **********************************
     C     QQCALL        OREQ      '2'
     C*** Begin Add *** 06/12/24 **********************************
     C     isSRAs        AndEq     *Off
     C*** End   Add *** 06/12/24 **********************************
     C*
     C*
     C                   Z-ADD     EL2APR        XXPREM
     C*
     C     RR2NDF        MULT      EL2FPR        XXAMT3           15 4
     C     RR2NDP        MULT      EL2APR        XXPREM
     C                   ADD       XXPREM        XXAMT3
     C     XXAMT3        DIV(H)    100           XX2NDD
     C                   Z-ADD     XX2NDD        XX2NDB
     C*
     C                   ELSE
     C*
     C*
     C*
     C*
     C                   ENDIF                                                  QQQTE IFEQ
     C*
       //*** Begin Add *** 06/12/24 **********************************
       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs;
       //*** End   Add *** 06/12/24 **********************************
     C                   Z-ADD     EL2AAM        XX2NDB
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
       //*** End   Add *** 06/12/24 **********************************
      *
      *
     C*
     C                   ENDIF                                                  RR2NDP IFNE
     C                   MOVE      'Q'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      '2'
       //*** Begin Add *** 06/12/24 ****************************************
       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs;
       //*** End   Add *** 06/12/24 ****************************************
     C                   ADD       EAAMT         XX2PD
     C                   ADD       EAAMT         XXDPRP
       //*** Begin Add *** 06/12/24 ****************************************
       EndIf;
       //*** End   Add *** 06/12/24 ****************************************
     C                   ENDIF
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   ENDDO
     C*
     C     BSSEFL        IFEQ      'S'
     C                   SUB       XX2PD         XX2NDB
     C                   ENDIF                                                  BSSEFL IFEQ
     C     XX2NDB        IFNE      *ZERO
     C                   MOVE      *ON           *IN56
     C                   ENDIF
     C*
     C*   CALCULATE 3RD ASSESSMENT FEES
     C*
     C                   Z-ADD     *ZERO         XX3RDD           11 0
     C                   Z-ADD     *ZERO         XX3RDB           11 2
     C                   Z-ADD     *ZERO         XX3PD            11 2
     C                   MOVE      *BLANKS       XX3RDP            9
     C                   Z-ADD     RDAT(1)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   If        xspfdt <> 0
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   Endif
     C                   ENDIF
