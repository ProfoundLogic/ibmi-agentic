     C                   MOVE(P)   PRC(D)        QPRC(E)           8
     C                   MOVE(P)   HDG(D)        XXTEST            3
     C*
     C     *IN90         IFEQ      *OFF
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(44)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(45)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(46)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(12)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(40)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(48)
     C     *IN90         OREQ      *ON
     C     HDG(D)        ANDEQ     CON(33)
     C     *IN90         OREQ      *ON
     C     XXTEST        ANDEQ     '*  '
     C                   Z-ADD     TAM(D)        QTAM(E)          11 2
     C                   MOVE      SGN(D)        QSGN(E)           1
     C                   ENDIF                                                  *IN90 IFEQ
     C*
     C                   ADD       1             E
     C                   ENDIF                                                  HDG,A IFNE
     C*
     C                   OTHER
      /Free
       If (Hdg(D) <> *blanks and E <= 23 and
       *in90 = *off) or (isContri = '0'
        and Hdg(D) <> *blanks and E <= 23
        and Hdg(D) <> Con(1) and Hdg(D) <> Con(5)
        and Hdg(d) <> Con(15)) or (isContri = '1'
        and Hdg(D) <> *blanks and E <= 23 and
        Hdg(D) <> Con(42) and Hdg(D) <> Con(43)
        and Hdg(d) <> Con(47));
      /End-free
     C*
     C                   If        cltID = '102' And hdg(d) = dbcrHdg And
     C                             *in90 = *On
     C                   Iter
     C                   Endif
     C                   MOVEL(P)  HDG(D)        QHDG(E)          30
     C                   MOVE(P)   PRC(D)        QPRC(E)           8
     C                   MOVE(P)   HDG(D)        XXTEST            3
     C*
      /Free
       If *in90 = *off or (*in90 = *on and Hdg(D) = Con(8)
        and isContri ='0') or (*in90 = *on and Hdg(D) = Con(9))
        or (*in90 = *on and Hdg(D) = Con(10) and isContri = '0')
        or (*in90 = *on and Hdg(D) = Con(11) and isContri = '0')
        or (*in90 = *on and Hdg(D) = Con(12)) or
        (*in90 = *on and Hdg(D) = Con(40)) or
        (*in90 = *on and Hdg(D) = Con(25)) or
        (*in90 = *on and Hdg(D) = Con(33) and isContri = '0')
        or (*in90 = *on and Hdg(D) = Con(44) and isContri = '1')
        or (*in90 = *on and Hdg(D) = Con(45) and isContri = '1')
        or (*in90 = *on and Hdg(D) = Con(46) and isContri = '1')
        or (*in90 = *on and Hdg(D) = Con(48) and isContri = '1')
        or (*in90 = *on and xxTest = '*');
      /End-free
     C                   Z-ADD     TAM(D)        QTAM(E)          11 2
