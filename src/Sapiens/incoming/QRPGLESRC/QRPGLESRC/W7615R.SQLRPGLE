     C                   MOVE      *BLANKS       ##EMN6           50
     C                   MOVE      *BLANKS       ##EMN7           50
     C                   CALL      'SRADDR'
     C                   PARM                    ##CO#
     C                   PARM                    ##FND
     C                   PARM                    ##EMP#
     C                   PARM                    ##DIV
     C                   PARM                    ##ODR
     C                   PARM                    ##NODR
     C                   PARM                    ##AODR
     C                   PARM                    ##EMN1
     C                   PARM                    ##EMN2
     C                   PARM                    ##EMN3
     C                   PARM                    ##EMN4
     C                   PARM                    ##EMN5
     C                   PARM                    ##EMN6
     C                   PARM                    ##EMN7
     C*
     C                   MOVE      ##EMN1        XXEMN1           50
     C                   MOVE      ##EMN2        XXEMN2           50
     C                   MOVE      ##EMN3        XXEMN3           50
     C                   MOVE      ##EMN4        XXEMN4           50
     C                   MOVE      ##EMN5        XXEMN5           50
     C                   MOVE      ##EMN6        XXEMN6           50
     C                   MOVE      ##EMN7        XXEMN7           50
     C*
     C                   MOVE      'TEST1'       QDTXT1           80
     C                   MOVE      'TEST2'       QDTXT2           80
     C                   MOVE      *BLANKS       QQTXT1           80
     C                   MOVE      *BLANKS       QQTXT2           80
     C                   MOVE      *BLANKS       QQTXT3           80
     C                   Z-ADD     0             Q#DAYS            3 0
     C*
     C     FNKEY         CHAIN     PEX02                              60
     C                   EXSR      SRAGHD
     C     *IN60         IFEQ      *OFF
     C*
     C                   MOVEL     EXBTXT        QQTXT1
     C                   MOVE      EXBTXT        XQTEMP          160
     C                   MOVEL     XQTEMP        QQTXT2
     C                   MOVE      EXBTXT        QQTXT3
     C                   Z-ADD     EX#DYS        Q#DAYS
     C*
     C                   ENDIF                                                  *IN60 IFEQ
     C*
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C*  OUTPUT HEADINGS
     C*
     C                   MOVE      *BLANK        HDG
     C                   MOVE      *BLANK        DSH
     C                   MOVE      *BLANK        SGN
     C                   MOVE      *BLANK        TAM
     C                   MOVE      *BLANK        PRC
     C                   Z-ADD     0             XXDEPA
     C                   Z-ADD     0             X1TXDU
     C                   Z-ADD     0             XXDPRL
     C                   Z-ADD     0             XXDPDU
     C                   Z-ADD     0             XXMFEE
     C                   Z-ADD     0             XXSFEE
     C                   Z-ADD     0             XXECDU
     C                   Z-ADD     0             XXTLDU
     C*
     C                   Z-ADD     0             XXPRO
     C                   Z-ADD     0             XXMFDU
     C                   Z-ADD     0             XXSFDU
     C                   Z-ADD     0             XX1STB
     C                   Z-ADD     0             X196
     C                   Z-ADD     0             XX2NDB
     C                   Z-ADD     0             X296
     C                   Z-ADD     0             XX3RDB
     C                   Z-ADD     0             X396
     C                   Z-ADD     0             X496
     C                   Z-ADD     0             X596
     C                   MOVE      *BLANK        X196P
     C                   MOVE      *BLANK        X296P
     C                   MOVE      *BLANK        X396P
     C                   MOVE      *BLANK        X496P
     C                   MOVE      *BLANK        X596P
     C                   Z-ADD     0             XX6THB
     C                   Z-ADD     0             XX7THB
     C                   Z-ADD     0             X696
     C                   Z-ADD     0             X796
     C                   MOVE      *BLANK        X696P             1
     C                   MOVE      *BLANK        X796P             1
     C                   MOVE      *BLANKS       XX6THD
     C                   MOVE      *BLANKS       XX7THD
     C                   Z-ADD     0             XXINST
     C                   Z-ADD     0             XXEXCN
     C                   Z-ADD     0             XXTXDU
     C                   Z-ADD     0             XXDPRP
     C                   Z-ADD     0             XXBAL
     C                   Z-ADD     0             AMT
     C                   MOVE      *BLANKS       XXSFHD
     C                   MOVE      *BLANKS       XX1STD
     C                   MOVE      *BLANKS       XX2NDD
     C                   MOVE      *BLANKS       XX3RDD
     C                   MOVE      *BLANKS       XXTHD
     C                   MOVE      *BLANKS       DUW
     C                   MOVE      *BLANKS       DDU
     C                   Z-ADD     0             EFD
     C                   Z-ADD     0             EXD
     C                   MOVE      *BLANK        XXPRT             1
     C                   MOVE      *BLANK        X2PRT             1
     C                   MOVE      *BLANK        X3PRT             1
     C                   Move      *blanks       xxDisclForm      10
     C                   MOVEA     '0000000'     *IN(01)
     C                   MOVEA     '0000000'     *IN(08)
     C                   MOVEA     '0000000'     *IN(15)
     C                   MOVEA     '000'         *IN(22)
      /Free
       *in27 = *off;
      /End-free
     c*
     c* Print "Net Rate per 100"
     c*
     c                   if        xxnewf = 'Y'
     c
     c                   select
     c                   when      cltid = '025'
     c                   move      *on           *in27
     c                   endsl
     c
     c                   endif
     C*
     C*  FLAG IF ANNIVERSARY RATING DATE IS IN EFFECT
     C*  LOAD ANNIV OUTPUT DATES
     C*
     C                   Z-ADD     0             XXANDT
     C                   Z-ADD     0             XXFRAV            8 0
     C                   Z-ADD     0             XXTOAV            8 0
     C     ELANDT        COMP      0                                      88
     C  N88ELANDT        COMP      ELPFDT                                 88
     C  N88              Z-ADD     ELANDT        XXANDT
     C  N88              ADD       1             XXANYR
     C                   Z-ADD     ELANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXANNV            8 0
     C  N88XXANDT        COMP      ELPFDT                               8888
     C*
     C                   MOVE      '0'           *IN87
     C  N88              MOVE      '1'           *IN87
     C  N88XXANDT        IFGE      ELPTDT
     C     XXANDT        ORLE      ELPFDT
     C                   MOVE      '1'           *IN88
     C                   END
     C*
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTOAV
     C                   MOVE      '1'           *IN89
     C     *IN88         IFEQ      '0'
     C     ELEMD1        ANDEQ     ELANDT
     C     ELEMD2        ANDEQ     XXANDT
     C     ELEXM1        ANDNE     ELEXM2
     C                   MOVE      '0'           *IN89
     C                   END
     C  N88              Z-ADD     XXANDT        SVANDT            7 0
     C*
     C*  GET NUMBER OF FUND POLICY DAYS
     C*
     C                   Z-ADD     0             XXLPDT            7 0
     C                   Z-ADD     F1STPO        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     F1ENPO        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        FDAYS             5 0
     C*
     C*  GET NUMBER OF EMPLOYER POLICY DAYS
     C*
     C                   Z-ADD     ELPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM            8 0
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO              8 0
     C                   MOVE      XQFROM        QQFROM            8 0
     C                   MOVE      XQTO          QQTO              8 0
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     QQDAYS        PDAYS             5 0
     C*
     C*  CLEAR/LOAD EFFECTIVE DATE/RATE ARRAYS
     C*
     C                   Z-ADD     0             PDAT
     C                   Z-ADD     0             RDAT
     C                   Z-ADD     9999999       DDAT
     C*
     C                   Z-ADD     ELPFDT        PDAT(1)
     C  N87              Z-ADD     ELPFDT        RDAT(1)
     C                   If        xspfdt <> 0
     C                   Z-add     xspfdt        rdat(1)
     C                   Endif
     C   87              Z-ADD     ELANDT        RDAT(1)
     C                   Z-ADD     2             X                 2 0
     C     *IN88         IFEQ      '0'
     C                   Z-ADD     XXANDT        PDAT(X)
     C                   Z-ADD     XXANDT        RDAT(X)
     C                   ADD       1             X
     C                   END                                                      *IN88='0'
     C                   Z-ADD     ELPTDT        PDAT(X)
     C                   MOVE      *OFF          *IN96
     C                   MOVE      *BLANK        XXOCT             1
     C*
     C* CHECK IF ANY POLICY PERIODS NEED TO BE SPLIT FOR 4/1/3 RATES.
     C*
     C     XXST          IFEQ      'FL'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *ZERO
     C*
     C     RDAT(W)       IFGE      1030101
     C     RDAT(W)       ANDLE     1030331
     C     PDAT(W)       ANDLT     1030401
     C     PDAT(Z)       ANDGT     1030401
     C*
     C                   MOVE      *ON           *IN96
     C*
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C     RDAT(W)       IFLT      1031001
     C     PDAT(W)       ANDLT     1031001
     C     PDAT(Z)       ANDGT     1031001
     C                   MOVE      'Y'           XXOCT
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 4 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* DE RATE SPLIT FOR 10/01/08
     C*
     C                   MOVE      *OFF          XXDEFL            1
     C     XXST          IFEQ      'DE'
     C*DE rate split flag
     C     EXDE08        ANDNE     'Y'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *ZERO
     C*
     C     RDAT(W)       IFLT      1081001
     C     PDAT(W)       ANDLT     1081001
     C     PDAT(Z)       ANDGT     1081001
     C                   MOVE      *ON           XXDEFL
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* FL RATE SPLIT FOR 07/01/09 for GIC
     C*
     C                   MOVE      *OFF          XX0709            1
     C     XXST          IFEQ      'FL'
     C     XXCLT#        ANDEQ     '139'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *ZERO
     C*
     C     RDAT(W)       IFGE      1090401
     C     RDAT(W)       ANDLT     1090701
     C     PDAT(W)       ANDLT     1090701
     C     PDAT(Z)       ANDGT     1090701
     C                   MOVE      *ON           XX0709
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C* AZ RATE SPLIT FOR 01/01/2010
     C*
     C                   MOVE      *OFF          XXAZ10            1
     C     XXST          IFEQ      'AZ'
     C*
     C                   DO        6             W                 2 0
     C     W             ADD       1             Z
     C*
     C     RDAT(W)       IFNE      *ZERO
     C*
     c                   if        rdat(w) >= 1091001 and
     c                             rdat(w) <= 1091231 and
     c                             pdat(w) <  1100101 and
     c                             pdat(z) >  1100101
     C                   MOVE      *ON           XXAZ10
     C                   ENDIF                                                  RDAT,W IFGE
     C*
     C                   ENDIF                                                  RDAT,W IFNE
     C*
     C                   ENDDO                                                  DO 6 X
     C*
     C                   ENDIF                                                  XXST IFEQ
     C* OK RATE SPLIT FOR 09/01/2010
     C*
     C                   move      *off          xxOK10            1
     C                   if        xxst = 'OK'
     C* Check opt out flag for OK 1100901 rate change
     C                   z-add     1100901       xxSpltDt          7 0
     C                   if        ApplyRateSplit(xxst:xxSpltDt)
     C                   do        6             W                 2 0
     C                   eval      z = w + 1
     C*
     C                   if        rdat(w) <> *zero   and
     C                             rdat(w) < xxSpltDt and
     C                             pdat(w) < xxSpltDt and
     C                             pdat(z) > xxSpltDt
     C                   eval      xxOK10 = *on
     C                   endif                                                  RDAT,W IFGE
     C*
     C                   enddo                                                  DO 6 X
     C                   endif                                                  ApplyRateSplit
     C*
     C                   endif                                                  xxst
     C*
     C  N87              Z-ADD     ELPFDT        DDAT(1)
     C   87              Z-ADD     ELANDT        DDAT(1)
     C                   Z-ADD     2             X                 2 0
     C     *IN88         IFEQ      '0'
     C                   Z-ADD     XXANDT        DDAT(X)
     C                   ADD       1             X
     C                   END                                                      *IN88='0'
     C     *IN96         IFEQ      '1'
     C                   Z-ADD     1030401       DDAT(X)
     C                   ADD       1             X
     C                   END                                                      *IN96='1'
     C     XXOCT         IFEQ      'Y'
     C                   Z-ADD     1031001       DDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                  XXOCT IFEQ
     C     XXDEFL        IFEQ      *ON
     C                   Z-ADD     1081001       DDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                  XXOCT IFEQ
     C     XX0709        IFEQ      *ON
     C                   Z-ADD     1090701       DDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                  XXOCT IFEQ
     C     XXAZ10        IFEQ      *ON
     C                   Z-ADD     1100101       DDAT(X)
     C                   ADD       1             X
     C                   ENDIF                                                  XXOCT IFEQ
     C*   OK RATE SPLIT FOR 09/01/2010
     C                   if        xxOK10 = *on
     C                   Z-ADD     xxSpltDt      DDAT(X)                        SPLIT DATE
     C                   ADD       1             X
     C                   endif                                                  XXOK10 = *ON
     C                   Z-ADD     ELPTDT        DDAT(X)
     C*
     C                   SORTA     DDAT
     C*
     C                   DO        6             X
     C*
     C     DDAT(X)       IFEQ      9999999
     C                   Z-ADD     *ZERO         DDAT(X)
     C                   ENDIF
     C*
     C                   ENDDO
     C*
     C*  GET ACTUAL NUMBER OF DAYS IN EACH ANNIV RATING PERIOD
     C*
     C                   Z-ADD     0             DYS
     C*
     C     *IN88         IFEQ      '1'
     C*
     C                   Z-ADD     PDAYS         DYS(1)
     C*
     C                   ELSE
     C*
     C                   Z-ADD     PDAT(1)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   Z-ADD     PDAT(2)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   Z-ADD     2             X
     C     X             DOWLT     4
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C                   EXSR      SRLEAP
     C*
     C                   Z-ADD     XQTO          XQFROM
     C*
     C     X             IFEQ      2
     C                   Z-ADD     QQDAYS        DYS(1)
     C     PDAT(3)       IFEQ      ELPTDT
     C     PDAYS         SUB       DYS(1)        DYS(2)
     C                   Z-ADD     4             X
     C                   ELSE
     C                   Z-ADD     PDAT(3)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   END
     C                   END
     C*
     C     X             IFEQ      3
     C                   Z-ADD     QQDAYS        DYS(2)
     C     DYS(1)        ADD       DYS(2)        XXWK30            3 0
     C     PDAYS         SUB       XXWK30        DYS(3)
     C                   Z-ADD     4             X
     C                   END
     C*
     C                   ADD       1             X
     C*
     C                   END
     C*
     C                   END                                                     *IN88
     C*
     C                   Z-ADD     0             PDAYS3            5 0
     C*
     C*  CALCULATE NUMBER OF DAYS 1993 RATES WERE USED.  THE NUMBER
     C*  OF DAYS WILL BE USED IF THE 15.7% 93 RATE CREDIT IS TO BE
     C*  APPLIED
     C*
     C                   MOVE      'N'           XX157             1
     C                   MOVE      *ZEROS        XQFROM
     C                   MOVE      *ZEROS        XQTO
     C     FNMST         IFEQ      'FL'
     C     ELPTDT        IFGT      940201
     C     ELEMNP        ANDNE     'Y'
     C                   DO        4             X
     C     RDAT(X)       IFGE      930101
     C     RDAT(X)       ANDLE     931231
     C     PDAT(X)       IFLT      940101
     C                   MOVE      01011994      XQFROM
     C                   ELSE
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQFROM
     C                   END
     C     X             IFLE      3
     C                   ADD       1             X
     C                   Z-ADD     PDAT(X)       SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XQTO
     C                   END
     C                   MOVE      'Y'           XX157
     C                   END
     C                   END
     C                   END
     C                   ENDIF                                                  FNMST = FL
     C*
     C     XX157         IFEQ      'Y'
     C*
     C                   MOVE      XQFROM        QQFROM
     C                   MOVE      XQTO          QQTO
     C                   Z-ADD     *ZERO         QQDAYS
     C                   MOVE      *BLANK        QQERR
     C                   MOVE      '1'           QQTERM
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C     QQERR         IFEQ      '0'
     C*
     C*  SUBTRACT 1 FROM 1ST ANNIV PERIOD IF IT IS LEAP YEAR AND
     C*  FEBRUARY 29 FALLS WITHIN THE FIRST PERIOD.
     C*
     C     XXLPDT        IFNE      0
     C     XXLPDT        ANDLT     XXANDT
     C                   SUB       1             QQDAYS
     C                   END
     C*
     C                   Z-ADD     QQDAYS        PDAYS3
     C                   END                                                    QQERR = ' '
     C                   END                                                    XX157 = 'Y'
     C*
     C     XXDIV         IFEQ      XSDIV
     C*
     C                   MOVEL     QQPOL#        SXPOL#           15
     C                   MOVEL     XXFROM        SXFROM            8
     C                   MOVEL     XXTO          SXTO              8
     C                   MOVEL     XXANNV        SXANNV            8
     C                   MOVE      *IN87         SXIN87            1
     C                   MOVEL     EMN(1)        SXEMN1           37
     C                   MOVEL     EMN(2)        SXEMN2           37
     C                   MOVEL     EMN(3)        SXEMN3           37
     C                   MOVEL     EMN(4)        SXEMN4           37
     C                   MOVEL     EMN(5)        SXEMN5           37
     C                   MOVEL     AHAGT#        SXAGT#            5
     C                   MOVEL     ANAME         SXNAME           34
     C                   MOVEL     AADD1         SXADD1           34
     C                   MOVEL     ACSZ          SXACSZ           34
     C                   MOVE      *IN69         SXIN69            1
     C                   MOVEL     AGARE1        SXARE1            3
     C                   MOVEL     AGPHN1        SXPHN1            7
     C*
     C                   ENDIF                                                  XXDIV IFEQ
     C*
     C                   CLEAR                   XTADLD           11 2
     C                   MOVE      *ZERO         TPREM            11 2
     C                   MOVE      *BLANK        XXRATE            1
     C                   CLEAR                   XTOCCD           11 2
     C                   CLEAR                   XTNRAT           11 2
     C                   MOVE      *BLANKS       XXOCCD           30
     C                   MOVE      *BLANK        XXIN71            1
     C                   MOVE      '0'           *IN48
      /free
       //******** beg add ******* 07/11/14 ********************************
       vol  = *blanks;
       vol# = 0;
       volA = 0;
       v = 0;
       //******** end add ******* 07/11/14 ********************************
      /end-free
