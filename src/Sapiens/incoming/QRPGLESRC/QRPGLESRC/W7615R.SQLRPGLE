     C     ELSDEX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELSDEX        IFNE      *ZERO
     C                   Z-ADD     ELSDEX        SRDTI
     C                   ELSE
