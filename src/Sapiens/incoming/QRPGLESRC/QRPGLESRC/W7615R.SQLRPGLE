     C*
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        ANDEQ     *BLANK
     C                   ADD       1             XXPAGE
       //*** Beg Add ***** 09/01/23 ***********************
