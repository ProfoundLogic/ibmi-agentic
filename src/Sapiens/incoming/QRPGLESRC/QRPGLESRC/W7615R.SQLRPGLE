     C*
     C*  APPLY 15.7% CREDIT TO PORTION OF MANUAL USING 1993 RATES;
     C*  GET CORRECT DATE FROM RDAT ARRAY TO DETERMINE RATING DATE USED
     C*  TO PULL RATE FROM FILE
     C*
     C                   Z-ADD     *ZEROS        XXDISC
     C                   Z-ADD     EPEMPR        XXEMPR            9 0
     C                   MOVE      '0'           *IN94
     C*
     C*  15.7% DISCOUNT IS APPLIED TO PORTION OF 94 POLICY USING
     C*  93 RATES
     C*
     C     XX157         IFEQ      'Y'
     C*
     C                   Z-ADD     1             Z
     C     EPEFDT        LOOKUP    PDAT(Z)                            60
     C     *IN60         IFEQ      '1'
     C     Z             ANDGT     1
     C                   SUB       1             Z
     C                   Z-ADD     RDAT(Z)       X2EFDT
     C                   ELSE
     C                   Z-ADD     1             Z
     C                   Z-ADD     ELPFDT        X2EFDT
     C                   END
     C*
     C     X2EFDT        IFGE      930101
     C     X2EFDT        ANDLE     931231
     C                   ADD       1             FILL
     C                   MOVE      '1'           *IN94
     C*
     C*  APPLY 15.7 % CREDIT TO UNEXPIRED PORTION OF POLICY
     C*
     C     FDAYS         IFNE      *ZEROS
     C     PDAYS3        DIV(H)    FDAYS         X2WK54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        X2WK54
     C                   END
     C*
     C*  HARBOR EXPOSURE CLASSES WILL ONLY RECEIVE UP TO 3.2 %
     C*  CREDIT ON UNEXPIRED PORTION OF POLICY
     C*
     C     EPSPEC        IFEQ      'F'
     C     PDAYS3        DIV(H)    30            XXMTHS            3 1
     C                   Z-ADD     1             T                 3 0
     C     XXMTHS        LOOKUP    MTH(T)                             60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     HP(T)         XXWO54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXWO54
     C                   END                                                    *IN60
     C                   ELSE
     C     X2WK54        MULT(H)   0.157         XXWO54
     C                   END                                                    HARBOR EXP
     C*
     C     PRPCF         IFEQ      'P'
     C     EPARAT        DIV       100           XXWH54            5 4
     C     EPEAPR        MULT(H)   XXWH54        XXEMPR
     C                   ELSE
     C*
     C     WCFL42        IFEQ      'Y'
     C     EPARAT        DIV       10            XXWH54            5 4
     C     EPEAPR        MULT(H)   XXWH54        XXEMPR
     C                   ELSE
     C     EPEAPR        MULT(H)   EPARAT        XXEMPR
     C                   ENDIF
     C                   ENDIF
     C*
     C*  IF THIS IS ANNIVERSARY RATED MANUAL PREMIUM, THEN WE
     C*  NEED TO APPLY FULL 15.7% CREDIT ON NON-HARBOR EXPOSURE,
     C*  FULL 3.2% CREDIT ON HARBOR EXPOSURE CLASS CODES
     C*
     C     *IN88         IFEQ      '0'
     C     EPSPEC        IFEQ      'F'
     C     XXEMPR        MULT(H)   0.032         XXDISC
     C                   ELSE
     C     XXEMPR        MULT(H)   0.157         XXDISC
     C                   END
     C*
     C*  CHECK TO SEE IF ANY OF THE ANNIVERSARY RATED MANUAL PREMIUM
     C*  WAS BEFORE 1/1/94.  IF SO, WE ONLY APPLY THE PORTION OF THE
     C*  15.7% CREDIT THAT CORRESPONDS TO THE AMOUNT OF ANNIVERSARY
     C*  RATED MANUAL PREMIUM AFTER 1/1/94
     C*
     C*
     C     EPEFDT        IFLT      940101
     C*
     C*  FIND THE NUMBER OF DAYS FROM 1/1/94 TO THE END OF THE
     C*  CURRENT PAYROLL CLASS CODE EFFECTIVE PERIOD
     C*
     C                   MOVE      01011994      QQFROM
     C     EPEFDT        IFEQ      XXANDT
     C*
     C*  93 RATES ARE BEING APPLIED TO THE SECOND SET OF EFFECTIVE
     C*  PAYROLLS
     C*
     C                   Z-ADD     ELPTDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTODT            8 0
     C                   ELSE
     C*
     C*  93 RATES ARE BEING APPLIED TO THE FIRST SET OF EFFECTIVE
     C*  PAYROLLS
     C*
     C                   Z-ADD     XXANDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         XXTODT
     C                   END
     C*
     C                   MOVE      XXTODT        QQTO
     C                   Z-ADD     *ZERO         QQDAYS            5 0
     C                   MOVE      *BLANK        QQERR             1
     C                   MOVE      '1'           QQTERM            1
     C                   CALL      'SRDDIF8'
     C                   PARM                    QQFROM
     C                   PARM                    QQTO
     C                   PARM                    QQDAYS
     C                   PARM                    QQERR
     C                   PARM                    QQTERM
     C*
     C     QQERR         IFEQ      '0'
     C                   MOVE      QQDAYS        XXDYS1            5 0
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXDYS1
     C                   END
     C*
     C*  RETRIEVE THE NUMBER OF DAYS IN THE CURRENT PAYROLL CLASS
     C*  CODE EFFECTIVE PERIOD
     C*
     C                   Z-ADD     1             X
     C     EPEFDT        LOOKUP    PDAT(X)                            60
     C     *IN60         IFEQ      '1'
     C                   SUB       1             X
     C                   ELSE
     C                   Z-ADD     1             X
     C                   END
     C*
     C     X             IFGE      1
     C                   Z-ADD     DYS(X)        XXDYS2            5 0
     C                   END
     C*
     C*  ONLY APPLY PORTION OF 15.7% THAT CORRESPONDS TO AMOUNT
     C*  OF ANNIVERSARY RATED PAYROLL IN THE 1994 YEAR
     C*
     C     XXDYS2        IFNE      *ZEROS
     C     XXDYS1        DIV(H)    XXDYS2        XXWR54            5 4
     C                   ELSE
     C                   Z-ADD     *ZEROS        XXWR54
     C                   END
     C     EPSPEC        IFEQ      'F'
     C     XXWR54        MULT(H)   0.032         XXWO54
     C                   ELSE
     C     XXWR54        MULT(H)   0.157         XXWO54
     C                   END
     C     XXEMPR        MULT(H)   XXWO54        XXDISC           11 2
     C                   END                                                    EPEFDT<1/1/94
     C                   ELSE
     C     XXEMPR        MULT(H)   XXWO54        XXDISC           11 2
     C                   END                                                    *IN88 = 0
     C                   MULT      -1            XXDISC
     C*
     C*  ROUND TO NEAREST DOLLAR
     C*
     C                   Z-ADD     XXDISC        XXSAVE           11 2
     C     XXDISC        IFLT      *ZERO
     C                   MULT      -1            XXDISC
     C                   END
     C                   MOVE      XXDISC        XX                2 0
     C     XX            IFGE      50
     C                   ADD       1             XXDISC
     C                   END
     C                   MOVE      '00'          XXDISC
     C     XXSAVE        IFLT      *ZERO
     C     XXDISC        MULT      -1            XXDISC
     C                   END
     C                   END                                                    X2EFDT>=01/01/93
     C*                                                    X2EFDT<=12/31/93
     C                   END                                                    XX157 = 'Y'
     C*
     C*  DON'T PRINT RATE CREDIT IF IT IS ZERO
     C*
     C     XXDISC        IFEQ      *ZEROS
     C                   MOVE      '0'           *IN94
     C                   END
     C     *IN90         IFEQ      *ON
     C     PPKY1         SETGT     PPP01
     C     PPKY          READPE    PPP01                                  60
     C     *IN60         IFEQ      *OFF
     C     PPMAPR        ANDGT     *ZERO
     C     PPENMP        DIV       PPMAPR        XQPROR
     C                   ELSE
     C                   Z-ADD     XZPROR        XQPROR
     C                   ENDIF
     C     EPENTR        IFNE      *ZERO
     C                   Z-ADD     EPENTR        XQARAT            9 4
     C                   Z-ADD     EPENTP        XXEMPR
     C                   ELSE
     C     EPARAT        MULT(H)   XQPROR        XQARAT            9 4
     C                   MULT(H)   XQPROR        XXEMPR
     C                   ENDIF
     C                   ENDIF                                                  *IN90 IFEQ
     C                   IF        XXEMPR < 0
     C                   MOVE      '-'           XXEMSN
     C                   ELSE
     C                   MOVE      ' '           XXEMSN
     C                   ENDIF
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        ANDEQ     *BLANK
       //*** Beg Chg ***** 09/01/23 ***********************
     C***                EXCEPT    DET
       If isUseSpoolOut;
     C                   EXCEPT    DET
       Endif;
       //*** End Chg ***** 09/01/23 ***********************
     C                   ENDIF                                                  TURN EQ 1
     C     XXNEWF        IFEQ      *BLANK
       //*** Beg Chg ***** 09/01/23 ***********************
     C***68              EXCEPT    DETT
       If isUseSpoolOut;
     C   68              EXCEPT    DETT
       Endif;
       //*** End Chg ***** 09/01/23 ***********************
     C                   ELSE
     C                   SELECT
       //*** Beg Add ***** 09/01/23 ***********************
       When Not(isUseSpoolOut);
       //*** End Add ***** 09/01/23 ***********************
     C     CLTID         WHENEQ    '071'
     C                   WRITE     QDET71
     C                   OTHER
     C                   WRITE     QDET
     C                   ENDSL
     C                   ENDIF                                                  XXNEWF IFEQ
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseXml;
          Exsr ScriptPayrolls;
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C     *IN88         IFEQ      '1'
     C     *IN62         ANDEQ     '0'
     C     *IN94         ANDEQ     '1'
     C     *IN97         ANDEQ     '0'
     C                   SUB       1             FILL
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        ANDEQ     *BLANK
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    DET2
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  TURN EQ 1
     C     XXNEWF        IFEQ      *BLANK
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C   68              EXCEPT    DET2T
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  XXNEWF IFEQ
     C                   ELSE
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        ANDEQ     *BLANK
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    DET1
     C                   EXCEPT    DET2
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  TURN EQ 1
     C     XXNEWF        IFEQ      *BLANK
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C   68              EXCEPT    DET1T
     C   68              EXCEPT    DET2T
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  XXNEWF IFEQ
     C                   END
     C*
     C*
     C*  WRITE RECORDS TO THE SUMMARY PAYROLL FILE
     C*
     C     ELARSM        IFEQ      'Y'
     C     TURN          ANDEQ     1
     C*
     C                   Z-ADD     EPDIV         EPDISC
     C                   MOVE      XXST          EPPST
     C                   Z-ADD     XXEAPR        EPEAPR
     C                   Z-ADD     XXEMPR        EPEMPR
     C                   Z-ADD     XXADLD        EPADLD
     C                   MOVEL(P)  PRDESC        EPDESC
     C                   WRITE     XEP01
     C*
     C                   ENDIF                                                  ELARSM IFEQ
     c                   if        xxst = 'IL' and *in50 = *off
     c                   eval      xtpred = xtpred + epempr
     c                   endif
     C*
     C*
     C                   END
     C                   END
      /free
       If CltId = '111';
          Exsr PrtVolList;
       Endif;
      /end-free
     C*
     C* CA FLAT RATE INCREASE FOR 2002 POLICIES (ANNIVERSARY OR EFF DT)
     C*
     C     XXST          IFEQ      'CA'
     C*
     C                   MOVEL     ELPFDT        XXPFYR            3 0
     C                   MOVEL     ELANDT        XXAYR             3 0
     C*
     C     XXPFYR        IFEQ      102
     C     XXAYR         OREQ      102
     C*
     C                   MOVE      'Y'           XXRATE
     C                   ADD       4             FILL              2 0
     C*
     C     XXPAG4        IFEQ      *ZERO
     C     FILL          CABGT     32            FULLT                54
     C                   ELSE
     C     FILL          CABGT     44            FULLT                54
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXPFYR
     C*
     C                   ENDIF                                                  XXST IFEQ
     C*
     C     RTAG          TAG
     C*
     C     XXRATE        IFEQ      'Y'
     C*
     C                   MOVE      *BLANK        XXRATE
     C                   SETOFF                                       54
     C                   SETON                                        51
     C                   Z-ADD     4             FILL
     C                   MOVE      '1'           XXPRT             1
     C                   MOVE      '1'           X2PRT             1
     C*
     C                   Z-ADD     0             EPCLAS
     C                   MOVE      *BLANK        EPSPEC
     C                   MOVEL(P)  CON(31)       PRDESC
     C                   Z-ADD     0             XXEAPR
     C                   Z-ADD     0             EPARAT
     C                   Z-ADD     TPREM         XXEMPR
     C*
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    DET
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C   68              EXCEPT    DETT
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C*
     C                   MOVEL(P)  CON(32)       PRDESC
     C                   Z-ADD     0             XXEAPR
     C                   Z-ADD     0             EPARAT
     C     ELMAPR        SUB       TPREM         XXEMPR
     C*
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    DET
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C   68              EXCEPT    DETT
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C*
     C                   ENDIF                                                  XXRATE IFEQ
     C*
     C*  CALCULATE DEPOSIT FOR SELF-REPORTING ACCOUNTS
     C*
      /free
       Select;
       When BSsefl = 'S';
            xxAB01 = BSab01;
            If BSab01 = 0;
               xxAB01 = BSab02;
            Endif;
       When BSsefl = 'E';
            xxAB02 = BSesdp;
            If BSesdp = 0;
               xxAB02 = BSesd2;
            Endif;
            xxAB01 = xxAB02/100;
       Endsl;
      /end-free
      /free
       If BSsefl = 'E' and xxAB01 = 0;
       Else;
      /end-free
     C                   Z-ADD     0             XXWKDP            9 0
     C     F1DPS         IFEQ      'S'
     C     CLTID         IFEQ      '102'
     C     XXAB01        MULT(H)   ELEMPM        XXWKDP
     C                   ELSE
     C     XXAB01        MULT(H)   ELSTPR        XXWKDP
     C                   ENDIF
     C                   ELSE
     C     F1DPS         IFEQ      'M'
     C     XXAB01        MULT(H)   ELMAPR        XXWKDP
     C                   ELSE
     C     F1DPS         IFEQ      'N'
     C     XXAB01        MULT(H)   ELENMP        XXWKDP
     C                   ELSE
     C     ELANPR        SUB       ELPRTD        XXAM12           11 2
     C     XXAB01        MULT(H)   XXAM12        XXWKDP
     C                   ENDIF                                                  F1DPS IFEQ
     C                   END
     C                   END
     C                   Z-ADD     XXWKDP        XXDEPA            9 2
      /Free
       Select;
       When BSmaxDep = 0;
       When xxDepA > BSmaxDep;
          xxDepA = BSmaxDep;
       Endsl;
      /End-free
     C*
     C*   ACCUMULATE AMOUNTS FOR DEPOSIT ROLLOVER
     C*
      *
      *  TURN ON THE DEPOSIT MODE BY YEAR FLAG (XXDMFL) IF THE POLICY YEAR
      *  IS DEFINED AS SUCH IN WDF1P
      *
     C     F1DPYM        IFEQ      'Y'
     C                   MOVE      'Y'           XXDPYM            1
     C                   ELSE
     C                   MOVE      'N'           XXDPYM            1
     C                   ENDIF
      *
     C                   IF        QQQTE <> 'Q'
     C                   Z-ADD     0             XXDPRL
     C                   MOVE      'I'           XXTYPE
     C     EAKY3         SETLL     PEA03                              40
     C     ARND1         TAG
     C     EAKY3         READE     PEA03                                  40
     C     *IN40         CABEQ     '1'           TAGBC
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
      * DO NOT INCLUDE PRIOR YEAR DEPOSIT TRANSACTIONS IF THAT YEAR IS FLAGGED
      * AS A PER YEAR DEPOSIT MODE
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDLT     XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C                   GOTO      ARND1
     C     TAGBC         TAG
     C*
     C*
     C                   MOVE      'R'           XXTYPE
     C     EAKY3         SETLL     PEA03                              40
     C     EAKY3         READE     PEA03                                  40
     C     *IN40         DOWEQ     *OFF
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDEQ     'D'
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
      * DO NOT INCLUDE PRIOR YEAR DEPOSIT TRANSACTIONS IF THAT YEAR IS FLAGGED
      * AS A PER YEAR DEPOSIT MODE
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDLT     XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
     C     EAFYR         IFEQ      XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
     C                   ENDIF
     C                   ENDSL
     C                   ENDIF
     C     EAKY3         READE     PEA03                                  40
     C                   ENDDO
      *
     C                   MOVE      'T'           XXTYPE
     C     EAKY3         SETLL     PEA03                              40
     C     EAKY3         READE     PEA03                                  40
     C     *IN40         DOWEQ     *OFF
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDEQ     'D'
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
      * DO NOT INCLUDE PRIOR YEAR DEPOSIT TRANSACTIONS IF THAT YEAR IS FLAGGED
      * AS A PER YEAR DEPOSIT MODE
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDLT     XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C                   ENDIF
     C                   ENDSL
     C                   ENDIF
     C     EAKY3         READE     PEA03                                  40
     C                   ENDDO
     C*
     C                   Z-ADD     0             XXPRDP
     C                   Z-ADD     0             xxPrYrDpBill     11 2
     C                   MOVE      'H'           XXTYPE
     C     EAKY3         SETLL     PEA03                              40
     C     ARND2         TAG
     C     EAKY3         READE     PEA03                                  40
     C     *IN40         CABEQ     '1'           TAGB2
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP           11 2
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
      * DO NOT INCLUDE PRIOR YEAR DEPOSIT TRANSACTIONS IF THAT YEAR IS FLAGGED
      * AS A PER YEAR DEPOSIT MODE
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ADD       EAAMT         xxPrYrDpBill
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C                   GOTO      ARND2
     C     TAGB2         TAG
     C                   ENDIF                                                  QQQTE <> 'Q'
     C*
     C*   ACCUMULATE AMOUNTS FOR DEPOSIT ROLLOVER - LIVE ENVIRONMENT.
     C*
     C     QQQTE         IFEQ      'Q'
     C*
     C* - PAYMENTS:
     C                   MOVE      'I'           XXTYPE
     C     EAKY3         CHAIN     PEA03L                             40
     C     *IN40         DOWEQ     *OFF
     C*
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C*
     C     EAKY3         READE     PEA03L                                 40
     C                   ENDDO                                                  *IN40 DOWEQ
     C*
     C                   MOVE      'T'           XXTYPE
     C     EAKY3         CHAIN     PEA03L                             40
     C     *IN40         DOWEQ     *OFF
     C*
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDEQ     'D'
      *
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXDPRL
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C*
     C                   ENDIF
     C*
     C     EAKY3         READE     PEA03L                                 40
     C                   ENDDO                                                  *IN40 DOWEQ
      *
     C                   MOVE      'R'           XXTYPE
     C     EAKY3         CHAIN     PEA03L                             40
     C     *IN40         DOWEQ     *OFF
     C*
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDEQ     'D'
      *
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     CLTID         OREQ      '140'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   SUB       EAAMT         XXDPRL
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C*
     C                   ENDIF
     C*
     C     EAKY3         READE     PEA03L                                 40
     C                   ENDDO                                                  *IN40 DOWEQ
     C*
     C* - BILLINGS:
     C                   MOVE      'H'           XXTYPE
     C     EAKY3         CHAIN     PEA03L                             40
     C     *IN40         DOWEQ     *OFF
     C*
     C                   SELECT
     C     CLTID         WHENEQ    '109'
     C     XXDPYM        OREQ      'Y'
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
     C                   OTHER
     C     EAFYR         IFLE      XXFYR
      *
     C     F1KEY2        SETLL     PF101
     C     F1KEY2        READE     PF101                                  60
     C     F1DPYM        IFNE      'Y'
     C     EAFYR         ANDNE     XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ADD       EAAMT         xxPrYrDpBill
     C                   ENDIF
      *
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRDP
     C                   ENDIF
      *
     C                   ENDIF
     C                   ENDSL
     C*
     C     EAKY3         READE     PEA03L                                 40
     C                   ENDDO                                                  *IN40 DOWEQ
     C*
     C                   ENDIF                                                  QQQTE IFEQ
     C*
     C* RESET GROUP DETAIL
     C*
     C     F1KEY         SETLL     PF101
     C     F1KEY         READE     PF101                                  60
     C*
     C* DETERMINE IF DEPOSIT ADJUSTMENT IS WITHIN THRESHOLD.
     C*
     C     XXPRDP        IFNE      0
     C*
     C     XXDEPA        SUB       XXPRDP        XXTA             11 2
     C                   IF        ELNWRW = ' '
     C                   CALL      'WA069R'
     C                   PARM      ELCO#         #@CO#             3 0
     C                   PARM      ELFND         #@FND             3 0
     C                   PARM      ELEMP#        #@EMP#            9 0
     C                   PARM      ELFYR         #@FYR             3 0
     C     ELNWRW        PARM      *BLANKS       #@NWRW            1
     C                   ENDIF
     C*
     C*

     c                   eval      xxAdjDepFl = *off
     c                   select
     c                   when      ELFAF <> 'R'
     c                   if            F1BRFL = 'Y'
     c                             and ELNWRW = 'R'
     c                              or ELNWRW = 'N'
     c                   eval      xxAdjDepFl = *on
     c                   endif
     c                   when      ELFAF  = 'R'
     c                   if            F1BVFL = 'Y'
     c                   eval      xxAdjDepFl = *on
     c                   endif
     c                   endsl
     c
     c                   if        xxAdjDepFl = *off
     C                   Z-ADD     XXPRDP        XXDEPA
     C                   ELSE
     C*
     C     XXTA          IFGE      0
     C*
     C* DO NOT POST ADJ IF LESS THAN DEBIT THRESHOLD
     C*
     C     XXTA          IFLT      F1DADJ
     C                   Z-ADD     XXPRDP        XXDEPA
     C                   ENDIF                                                  XXTA IFLT
     C*
     C                   ELSE
     C*
     C* DO NOT POST ADJ IF LESS THAN CREDIT THRESHOLD
     C*
     C     XXTA          MULT      -1            XXTMP            11 2
     C*
     C     XXTMP         IFLT      F1CADJ
     C                   Z-ADD     XXPRDP        XXDEPA
     C                   ENDIF                                                  XXTA IFLT
     C*
     C                   ENDIF                                                  XXTA IFGE
     C*
     C                   ENDIF                                                  F1BRFL IFNE
     C*
     C                   ENDIF                                                  XXPRDP IFNE
     C*
     C*
     C* Just pull deposit billed from A/R if running a revised bill
     C* on a non-summarized division/policy.
     C*
     C                   If        ELARSM <> 'Y' and ELFAF = 'R'
     C                   Z-add     xxPRDP        XXDEPA
     C                   Endif
      /free
       // Subtract prior year deposit billed from the calculated deposit and
       //  prior deposit billed if UBIC. Prior year deposit paid has already
       //  been exlucded from xxDpRl for UBIC
       If cltID = '140';
          xxDePa = xxDePa - xxPrYrDpBill;
          xxPrDp = xxPrDp - xxPrYrDpBill;
       Endif;
      /end-free
     C*
     C* Add tax on deposit to the deposit total for estimating accounts.
     C*
     C                   If        bssefl = 'E'
     C*
     C                   Z-ADD     0             XXPRTX
     C                   MOVE      'F'           XXTYPE
     C*
     C     EAKY3         CHAIN     PEA03                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDEQ     'D'
     C     CLTID         IFEQ      '109'
     C     CLTID         OREQ      '140'
     C     CLTID         OREQ      '136'
     C*
     C     EAFYR         IFEQ      XXFYR
     C                   ADD       EAAMT         XXPRTX
     C                   ENDIF
     C*
     C                   ELSE
     C                   ADD       EAAMT         XXPRTX           11 2
     C                   ENDIF                                                  CLTID IFEQ
     C                   ENDIF
     C*
     C     EAKY3         READE     PEA03                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C*
     C     XXDEPA        SUB       XXPRDP        XXPREM
     C*
     C* CALCULATE STATE TAX ON DEPOSIT FOR BALANCE INFORMATION
     C*
     C     RRTDFL        IFNE      'Y'
     C                   Z-ADD     0             XXTXDU
     C                   ELSE
     C*
     C     QQQTE         IFEQ      'Q'
     C     RRTXPC        MULT(H)   XXPREM        XXWK10           11 0
     C                   MULT(H)   .01           XXWK10
     C                   Z-ADD     XXWK10        XXTXDU
     C     RRTEFL        IFEQ      'Y'
     C     F1DPS         ANDEQ     'N'
     C     ELPRTD        MULT(H)   RRTXPC        XETXDU            9 0
     C                   MULT(H)   .01           XETXDU
     C                   ADD       XETXDU        XXTXDU
     C                   ENDIF
     C                   ELSE
     C*
     C     RRTXPC        MULT(H)   XXPREM        XXWK10           11 0
     C                   MULT(H)   .01           XXWK10
     C                   Z-ADD     XXWK10        XXTXDU
     C     RRTEFL        IFEQ      'Y'
     C     F1DPS         ANDEQ     'N'
     C     ELPRTD        MULT(H)   RRTXPC        XETXDU            9 0
     C                   MULT(H)   .01           XETXDU
     C                   ADD       XETXDU        XXTXDU
     C                   ENDIF
     C*
     C                   MOVE      'Q'           XXTYPE
     C     EAKY3         CHAIN     PEA03                              60
     C     *IN60         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'D'
     C     EAFYR         ANDLE     XXFYR
     C     CLTID         IFEQ      '109'
     C     CLTID         OREQ      '140'
     C     CLTID         OREQ      '136'
     C*
     C     EAFYR         IFEQ      XXFYR
     C                   Add       EAAMT         xxDPRL
     C                   ENDIF
     C*
     C                   ELSE
     C                   Add       EAAMT         xxDPRL
     C                   ENDIF                                                  CLTID IFEQ
     C                   ENDIF
     C                   ENDIF
     C*
     C     EAKY3         READE     PEA03                                  60
     C                   ENDDO
     C*
     C                   ENDIF
     C*
     C                   ENDIF                                                  RRTDFL IFNE
     C                   ADD       XXPRTX        XXTXDU
     C*
     C                   Add       xxTXDU        xxDEPA
     C*
     C                   Z-add     0             xxTXDU
     C                   Z-add     0             xxPRTX
     C*
     C                   Endif
     C*
     C*   CALCULATE DEPOSIT DUE
     C*

     C     XXDEPA        SUB       XXDPRL        XXDPDU            9 24142
     C     ELARSM        IFEQ      'Y'
     C                   ADD       XXDEPA        XTDEPA
     C                   ADD       XXDPRL        XTDPRL
     C                   ADD       XXDPDU        XTDPDU
     C                   ENDIF
      /free
       Endif;                         //If BSself = 'E' and xxAb01 = 0;
       //***** Beg Add ***** 07/07/23 **************************************
       Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pmp01;
       //***** End Add ***** 07/07/23 **************************************
      /end-free
      *** Beg Add *****  05/12/25  *******************************************
     C                   Move      *blank        PrintFlg          1
      *** End Add *****  05/12/25  *******************************************
     C*
     C*
     C*  RETRIEVE PRORATA PREMIUM
     C*
     C     ELANPR        SUB       ELPRTD        XXPRO            11 2
      /free
       xxDivAmt = PrintDividend(ELCo#:ELFnd:ELEmp#:ELDiv:ELFyr:qqQte);
       xxPro    = xxPro - xxDivAmt;
      /end-free
      /free
       If CltId = '111';
          xxDvnd = 0;

          Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pdv00;
          If %found and DVamt <> *zero;
             xxDvnd = DVamt;
             xxPro  = xxPro - DVamt;
          Endif;
       Endif;
      /end-free
     C*
     C*  EXPENSE CONSTANT COMES FROM ELPRTD
     C*
     C                   Z-ADD     ELPRTD        XXEXCN            9 2
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPPRTD        XXEXCN
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C*  LOAD CORRECT EXPENSE CONSTANT FROM FUND DETAIL
     C*
     C*
     C*  CHECK ESTIMATED MIN. PREMIUM FLAG
     C*  AND
     C*  CALCULATE ESTIMATED PREMIUM
     C*
     C     FNKEY         CHAIN     PEX02                              60
     C                   EXSR      SRAGHD
     C     *IN60         IFEQ      *ON
     C                   MOVE      *BLANK        EXBEXP
     C                   ENDIF
     C*
     C                   MOVE      '0'           *IN34
     C     ELEMNP        IFEQ      'Y'
     C                   MOVE      '1'           *IN34
     C                   ENDIF
     C                   MOVE      '0'           *IN44
     C     ELEMNP        IFEQ      'Y'
     C                   MOVE      '1'           *IN44
     C                   Z-ADD     0             XXEXCN            9 2
     C     EXBEXP        IFEQ      'Y'
     C                   MOVE      '0'           *IN44
     C                   Z-ADD     ELPRTD        XXEXCN
      *** Begin Chg *** 11/02/23 *******************************************
     C*****              Z-ADD     ELPRTD        XXEXCO
     C                   Z-ADD     ELPRTF        XXEXCO
      *** End   Chg *** 11/02/23 *******************************************
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPPRTD        XXEXCN
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C                   ENDIF                                                  EXBEXP IFEQ
     C                   ELSE
     C                   Z-ADD     0             XXEXCO
     C     ELFFL9        IFEQ      ' '
     C                   Z-ADD     ELPRTF        XXEXCO
     C                   ELSE
     C                   Z-ADD     ELPRTD        XXEXCO
     C                   ENDIF
     C*
     C                   END
     C     ELFND         IFEQ      2
     C     CLTID         ANDEQ     '114'
     C                   MOVE      *ON           *IN44
     C                   ENDIF                                                  ELFND IFNE
     C     ELFND         IFEQ      101
     C     CLTID         ANDEQ     '114'
     C                   MOVE      *ON           *IN44
     C                   ENDIF                                                  ELFND IFNE
     C*
     C*  LOAD TOTAL ARRAYS
     C*
     C                   Z-ADD     1             A                 3 0          MANUAL PREM
     C                   SELECT
      /Free
       When cltid = '071' or cltid = '025' or isContri = '1';
      /End-free
     C                   MOVEL     CON(42)       HDG(A)
     C                   OTHER
     C                   MOVEL     CON(1)        HDG(A)
     C                   ENDSL
     C                   Z-ADD     ELMAPR        TAM(A)
     C*
     C*  IF MIN PREM, DON'T INCLUDE THE INCR LIMIT MIN IN MANUAL PREM
     C*
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        IFEQ      'Y'
     C     XXMINF        IFEQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C                   SUB       ELEIN1        TAM(A)
     C                   SUB       ELEIN2        TAM(A)
     C                   SUB       ELEWAV        TAM(A)
      *** Beg Add *****  07/07/23  *******************************************
     C                   Z-ADD     MPMAPR        TAM(A)
     C*  Increased limits amounts do not have to be subtracted from MPMAPR
     C*  they are not included in this field.
     C*****              SUB       MPEWAV        TAM(A)
      *** End Add *****  07/07/23  *******************************************
     C                   END
     C*
     C                   ADD       2             A
     C     ELEWAV        IFNE      *ZERO
     C     ELWVFL        ANDEQ     *BLANK
     C                   MOVE      'M'           ELWVFL
     C                   ENDIF
     C*
     C*
     C* DEVIATION #1 APPLIED TO MANUAL
     C*
     C     RRDV1L        IFEQ      'M'
     C*
     C     ELEDC2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELASP2        ANDNE     *ZERO
     C*
     C                   Z-ADD     ELEDC2        TAM(A)
     C     ELASP2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDC2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV1H        IFEQ      *BLANK
     C                   MOVEL     CON(6)        HDG(A)
     C                   ELSE
     C                   MOVEL     RRDV1H        HDG(A)
     C                   ENDIF
     C*
     C     ELDVEF        IFNE      *ZERO
     C                   Z-ADD     ELDVEF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELDVEX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELDVEX        IFNE      *ZERO
     C                   Z-ADD     ELDVEX        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   MOVE      '%'           PCT(7)
     C                   MOVE      '.'           PCT(4)
     C     ELASP2        IFLT      0
      *
     C     ELASP2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
      *
     C                   ELSE
     C                   MOVE      ELASP2        XXASP2            5
     C                   ENDIF                                                  ELASP2
     C                   MOVEA     XXASP2        NUM
      *
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF                                                  NUM,1 IFNE
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF                                                  NUM,2 IFNE
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELEDC2 IFNE
     C*
     C                   ENDIF                                                  RRDV1L IFEQ
     C*
     C* DEVIATION #1 2ND PERIOD APPLIED TO MANUAL
     C     RRDV1L        IFEQ      'M'
     C*
     C     ELD1E2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELD1S2        ANDNE     *ZERO
     C                   Z-ADD     ELD1E2        TAM(A)
     C     ELD1S2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPD1E2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV1H        IFEQ      *BLANK
     C     con(6)        CAT       @2nper:1      HDG(A)
     C                   ELSE
     C     rrdv1h        CAT       @2nper:1      HDG(A)
     C                   ENDIF
     C*
     C     ELD1D2        IFNE      *ZERO
     C                   Z-ADD     ELD1D2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD1X2        ORNE      0
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD1X2        IFNE      *ZERO
     C                   Z-ADD     ELD1X2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPTDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   MOVE      '%'           PCT(7)
     C                   MOVE      '.'           PCT(4)
     C     ELD1S2        IFLT      0
     C     ELD1S2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
     C                   ELSE
     C                   MOVE      ELD1S2        XXASP2            5
     C                   ENDIF                                                  ELD1S2
     C                   MOVEA     XXASP2        NUM
      *
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF                                                  NUM,1 IFNE
     C*
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF                                                  NUM,2 IFNE
     C*
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELD1E2 IFNE
     C*
     C                   ENDIF                                                  RRDV1L IFEQ
     C*  LOAD 2ND DEVIATION IF APPLIED TO MANUAL PREMIUM
     C*
     C     RRDV2L        IFEQ      'M'
     C*
     C     ELEDV2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELDEV2        ANDNE     *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELSTFC        ANDNE     *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELDEV2F       ANDNE     *ZERO
     C*
     C                   Z-ADD     ELEDV2        TAM(A)
     C                   Select
     C                   When      ELdev2  <> 0
     C                   If        ELdev2 < *Zeros
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELstFc  <> 0
     C                   If        ELstFc > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELdev2F <> 0
     C                   If        ELdev2F > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   EndSl
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDV2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV2H        IFEQ      *BLANK
     C  N25              MOVEL     CON(19)       HDG(A)
     C   25              MOVEL     CON(72)       HDG(A)
     C                   ELSE
     C                   MOVEL     RRDV2H        HDG(A)
     C                   ENDIF
     C*
     C     ELD2EF        IFNE      *ZERO
     C                   Z-ADD     ELD2EF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD2EX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD2EX        IFNE      *ZERO
     C                   Z-ADD     ELD2EX        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   Select
     C*>>>>>>>>>>>>>>>>> Stabilization Factor
     C                   When      cltID = '025'
     C                   MOVE      ELSTFC        XXASP8            8
     C                   MOVEA     XXASP8        NUM8
      *
     C                   MOVE      NUM8(2)       PCT(1)
     C                   MOVE      '.'           PCT(2)
     C                   MOVE      NUM8(3)       PCT(3)
     C                   MOVE      NUM8(4)       PCT(4)
     C                   MOVE      NUM8(5)       PCT(5)
     C                   MOVE      NUM8(6)       PCT(6)
     C                   MOVE      NUM8(7)       PCT(7)
     C                   MOVE      NUM8(8)       PCT(8)
     C*>>>>>>>>>>>>>>>>> Territory Rating
     C                   When      cltID = '136'
     C                   MOVE      ELdev2F       XXASP3
     C                   MOVEA     XXASP3        NUM

     C                   MOVE      NUM(1)        PCT(2)
     C                   MOVE      '.'           PCT(3)
     C                   MOVE      NUM(2)        PCT(4)
     C                   MOVE      NUM(3)        PCT(5)
     C                   MOVE      NUM(4)        PCT(6)
     C                   MOVE      NUM(5)        PCT(7)
     C*>>>>>>>>>>>>>>>>> Default Deviation #2
     C                   Other
     C     ELDEV2        IFLT      0
      *
     C     ELDEV2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
      *
     C                   ELSE
     C                   MOVE      ELDEV2        XXASP2            5
     C                   ENDIF                                                  ELEDV2
     C                   MOVEA     XXASP2        NUM
      *
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVE      '%'           PCT(7)
     C                   EndSl
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELEDV2 IFNE
     C*
     C                   ENDIF                                                  RRDV2L IFEQ
     C*
     C*  LOAD 2ND DEVIATION 2ND PERIOD IF APPLIED TO MANUAL PREMIUM
     C     RRDV2L        IFEQ      'M'
     C*
     C     ELD2E2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELD2S2        ANDNE     *ZERO
     C*
     C     XXCLT#        ANDNE     '025'
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELSTFC        ANDNE     *ZERO
     C     XXCLT#        ANDEQ     '025'
     C                   Z-ADD     ELD2E2        TAM(A)
     C     XXCLT#        IFNE      '025'
     C     ELD2S2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
     C*FOR CLIENT 025
     C                   ELSE
     C     ELSTFC        IFGT      1
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
     C                   ENDIF                                                  XXCLT#<>'025'
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPD2E2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV2H        IFEQ      *BLANK
     C  N25con(19)       CAT       @2nper:1      HDG(A)
     C   25              MOVEL     CON(72)       HDG(A)
     C                   ELSE
     C     rrdv2h        CAT       @2nper:1      HDG(A)
     C                   ENDIF
     C*
     C     ELD2D2        IFNE      *ZERO
     C                   Z-ADD     ELD2D2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD2X2        ORNE      0
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD2X2        IFNE      *ZERO
     C                   Z-ADD     ELD2X2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPTDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C     XXCLT#        IFNE      '025'
     C                   MOVE      '%'           PCT(7)
     C                   MOVE      '.'           PCT(4)
     C     ELD2S2        IFLT      0
     C     ELD2S2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
     C                   ELSE
     C                   MOVE      ELD2S2        XXASP2            5
     C                   ENDIF                                                  ELD2S2
     C                   MOVEA     XXASP2        NUM
      *
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
     C*
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF
     C*
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C*FOR CLIENT 025
     C                   ELSE
     C                   MOVE      '.'           PCT(2)
     C                   MOVE      ELSTFC        XXASP8            8
     C                   MOVEA     XXASP8        NUM8
     C                   MOVE      NUM8(2)       PCT(1)
     C                   MOVE      NUM8(3)       PCT(3)
     C                   MOVE      NUM8(4)       PCT(4)
     C                   MOVE      NUM8(5)       PCT(5)
     C                   MOVE      NUM8(6)       PCT(6)
     C                   MOVE      NUM8(7)       PCT(7)
     C                   MOVE      NUM8(8)       PCT(8)
     C                   ENDIF                                                  XXCLT# = '025'
     C*
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELD2E2 IFNE
     C*
     C                   ENDIF                                                  RRDV2L IFEQ
     C*
