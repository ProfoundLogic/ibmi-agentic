     C                   END
     C*
     C     GETBAL        TAG
     C*
     C                   IF        @BLARQ <> 0
     C     EAKYD         SETLL     PEA0D
     C     EAKYD         READE     PEA0D
     C                   DOW       NOT(%EOF) AND
     C                             EAPODT >= BSD(A) AND
     C                             EAPODT <  BSD(B)
