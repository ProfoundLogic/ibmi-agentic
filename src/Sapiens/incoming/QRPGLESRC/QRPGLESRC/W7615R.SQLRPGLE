     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     LDEXP1        IFNE      *ZERO
     C                   Z-ADD     LDEXP1        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   Z-ADD     ELEDCT        TAM(A)
     C     ELEDCT        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDCT        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C                   MOVEL     CON(70)       HDG(A)
     c*
     c                   move      ldpct1        xxpct
     c*
     c                   move      *blanks       xxpct1           13
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
     c*
     c                   move      xxpct1        hdg(a)
     c*
     C                   ADD       1             A
     C                   END
     c*
     c                   endif                                                  if ldplv1 = 'M'
     c*
     c*  2nd Large Deductible applied to Manual
     c*
     c                   if        ldplv2 = 'M'
     c*
     C     ELEDD2        IFNE      *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     LDPCT2        ANDNE     *ZERO
     C*
     C     LDEFD2        IFNE      *ZERO
     C                   Z-ADD     LDEFD2        SRDTI
     C                   ELSE
     C                   Z-ADD     LDEXP1        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C*
     C                   Z-ADD     LDEXP2        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C*
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   Z-ADD     ELEDD2        TAM(A)
     C*
     C     ELEDD2        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDD2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C                   MOVEL     CON(71)       HDG(A)
     c*
     c                   move      ldpct2        xxpct
     c*
     c                   move      *blanks       xxpct1
     c                   movel     xxp1          xxpct1
     c                   cat       '.':0         xxpct1
     c                   cat       xxp2:0        xxpct1
     c                   cat       '%':0         xxpct1
