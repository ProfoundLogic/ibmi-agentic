     C                   Z-ADD     MPEWAV        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
      /Free
       //*** Beg Add *****  05/12/25  *******************************************
       // Print an '*' appended to heading on the line item
       If ELPror > 0 and ELPror < 1;
          If xxminf = 'Y';
             HDG(A) = %trim(HDG(A)) + '*';
             PrintFlg = 'Y';
          Endif;
       Endif;
       //*** End Add *****  05/12/25  *******************************************

       If tam(a) <> 0;
          hdg(a) = AddWaiverToHdg(hdg(a));
       Endif;
      /End-Free
     C                   ADD       1             A
     C*
     C                   ENDIF                                                  ELEWAV IFNE
     C*
     C                   ENDIF                                                  RRWVFL IFEQ
     C*
     C* INCREASED LIMITS
     C*
     C*
     C                   MOVE      '0'           *IN48
     C*
     C     RREMLB        IFEQ      *BLANKS
     C                   MOVE      *ON           *IN48
     C                   ENDIF
     C*
     C     ELILCD        IFNE      *BLANKS                                      INCR LIMITS
     C                   MOVE      '1'           *IN48
     C                   MOVEL     CON(3)        HDG(A)
      //*** Beg Chg ***** 08/14/24 *********************************
     C***                Z-ADD     ELEIN1        TAM(A)
     C***  ELEIN1        IFNE      *ZERO                                        INCR LIMITS
     C***                MOVE      '+'           SGN(A)
     C***                ENDIF
       Tam(A) = MPein1;
       If MPein1 <> 0;
          SGN(A) = '+';
       Endif;
      //*** End Chg ***** 08/14/24 *********************************
     C     ELILEF        IFNE      *ZERO
     C                   Z-ADD     ELILEF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELILEX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELILEX        IFNE      *ZERO
     C                   Z-ADD     ELILEX        SRDTI
     C                   ELSE
     C     ELI2EF        IFNE      *ZERO
     C                   Z-ADD     ELI2EF        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF                                                  ELI2EF IFNE
     C                   ENDIF                                                  ELILEX IFNE
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C*  GET DESCRIPTION
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVE      *BLANKS       XLDSC1
     C                   MOVEL     ELILCD        XXKEY
     C     LMKY          SETGT     PLM01
     C     LMKY2         READPE    PLM01                                  60
     C     *IN60         DOWEQ     '0'
     C     LMSTAT        ANDEQ     'I'
     C     LMKY2         READPE    PLM01                                  60
     C                   ENDDO                                                  *IN60 DOWEQ
     C     *IN60         IFEQ      *OFF
     C                   MOVE      *BLANKS       XLMP              5
     C                   MOVE      LMPCT         XLMP
     C                   MOVEA     XLMP          NUM
     C                   MOVE      '.'           PCT(3)
     C                   MOVE      '%'           PCT(7)
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
     C                   MOVE      NUM(2)        PCT(2)
     C                   MOVE      NUM(3)        PCT(4)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   MOVEL(P)  LMDESC        XLDSC1           18
     C                   MOVE      XLDSC1        HDG(A)
     C                   ENDIF                                                  *IN60 IFEQ
     C                   ADD       1             A
     C*
      //*** Beg Add ***** 08/14/24 *********************************
      //Print Balance to Increased Limit Minimum
       If MPebil <> 0;
          HDG(A) = Con(80);
          TAM(A) = MPebil;
          SGN(A) = '+';

          //*** Beg Add *****  05/12/25  *******************************************
          // Print an '*' appended to heading on the line item
          If ELPror > 0 and ELPror < 1;
             If (xxminf = 'Y' and xxst = 'NJ')
              OR (xxminf = 'Y' and ELcofl <> 'Y');
                HDG(A) = %trim(HDG(A)) + '*';
                PrintFlg = 'Y';
             Endif;
          Endif;
          //*** End Add *****  05/12/25  *******************************************

          A += 1;
       Endif;
      //*** End Add ***** 08/14/24 *********************************
     C                   ENDIF
     C*
     C* 2ND INCREASED LIMITS
     C*
     C     ELINL2        IFNE      *BLANKS
     C                   MOVEL     CON(23)       HDG(A)
      //*** Beg Chg ***** 08/14/24 *********************************
     C***                Z-ADD     ELEIN2        TAM(A)
     C***  ELEIN2        IFNE      *ZERO
     C***                MOVE      '+'           SGN(A)
     C***                ENDIF
       Tam(A) = MPein2;
       If MPein2 <> 0;
          SGN(A) = '+';
       Endif;
      //*** End Chg ***** 08/14/24 *********************************
     C*
     C     ELI2EF        IFNE      ELPFDT
     C     ELI2EX        ORNE      0
     C*
     C                   Z-ADD     ELI2EF        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
