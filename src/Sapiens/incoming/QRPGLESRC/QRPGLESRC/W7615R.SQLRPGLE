     C     ELANPR        SUB       XXDPRP        XXBAL            11 2
      /free
       If CltId = '111';
          xxBal = xxBal - xxDvnd;
       Endif;
      /end-free
     C                   ADD       XXMFDU        XXBAL
     C                   ADD       XXSFDU        XXBAL
