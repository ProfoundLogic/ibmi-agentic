     C                   ADD       XXCOLB        XXBAL
     C                   SUB       XXCOLP        XXBAL
      *** End Add *****  06/24/24  *******************************************
      /free
       xxdprp = xxdprp + xxdprl;
       xxbal = xxbal + xxdepa - xxdprl;
      /end-free
      /free
       xxBal  = xxBal - xxDivAmt;
       If ELarsm = 'Y';
          xtDivAmt = xtDivAmt + xxDivAmt;
       Endif;
      /end-free
