      /Free
       If cltid <> '025' and isContri = '0';
      /End-free
     C   29
     CAN 63
     CAN 39              MOVEL     CON(52)       AHD(D)
     C   29
     CANN63
     CAN 39              MOVEL     CON(53)       AHD(D)
     C                   ELSE
     C   29
     CAN 63
     CAN 39              MOVEL     CON(73)       AHD(D)
     C   29
     CANN63
     CAN 39              MOVEL     CON(74)       AHD(D)
     C                   ENDIF                                                  XXCLT# = '025'
     C   29
     CAN 39              Z-ADD     XXPRO         AAM(D)
      /free
       // Add Dividend Amount back to premium total
       aam(d) = aam(d) + xxDivAmt;
      /end-free
      *** Beg add ***** 07/07/23 **************************************
      /free
       // Add a * note beside the word Premium and add a note at the bottom of the
       // balance box to indicate:
       // * Minimum has been invoked and all premium except terrorism charges are
       // billed to state reporting division.
       IF XXMINF = 'Y';
          ahd(d) = 'Premium *';
       Endif;
      /end-free
      *** End Add *****  07/07/23  *******************************************
     C*
     C  N29
     CAN 39              MOVEL     CON(54)       AHD(D)
     C  N29
     CAN 39              Z-ADD     XXDEPA        AAM(D)
     C*
     C                   ADD       1             D
      /free
       // Print Dividend Amount. It's already been substracted from
       //  balance due (xxBal).
       If xxDivAmt <> 0;
          ahd(d)   = 'Dividend';
          aam(d)   = xxDivAmt;
          d = d + 1;
       Endif;
      /end-free
