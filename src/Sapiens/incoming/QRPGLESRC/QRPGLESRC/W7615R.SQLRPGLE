      /Free
       If achFlg = *On;

          outFyr =  %editc(BLfyr:'X');
          outEnv = qqQte;
          GetEFTStatus(%EditC(EMco#:'X'):
                       'E':
                       %EditC(EMfnd:'X'):
                       %EditC(EMemp#:'X') + %EditC(EMdiv:'X'):
                       %Char(%Date():*Cymd0):
                       strEft:
                       strPre:
                       outRrn:outEobT:outCkTp:outFyr:outEnv);
         dbFlag = strEft;
       EndIf;
      /End-Free

     C*
     C                   Z-ADD     0             XXDPRP
     C                   MOVE      *OFF          *IN57
     C                   MOVE      *BLANKS       XXCKNM           30
     C                   MOVE      *BLANKS       XXCONM
     C                   MOVE      *BLANKS       X2CKNM           40
     C                   Z-ADD     1             A
