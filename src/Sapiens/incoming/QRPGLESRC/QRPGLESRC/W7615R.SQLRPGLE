     C*
     C*** begin chg ***  11/13/23  *******************************************
     C*
     C* Re-write bottom section of premium line items for new ordering plus
     C* the balance to minimum changes.  Starting with normal premium all the
     C* way thru bottom line total premium.
     C*
     C* Normal Premium
     C                   Select
     C                   When      cltid = '071' or cltid = '025'
     C                             or isContri = '1'
     C                   MOVEL     CON(44)       HDG(A)
     C                   OTHER
     C                   MOVEL     CON(8)        HDG(A)
     C                   ENDSL
     C                   If        xxminf = 'Y'
     C                   Z-ADD     MPENMP        TAM(A)
     C                   Add       tasmin        TAM(A)
     C                   Else
     C                   Z-ADD     ELENMP        TAM(A)
     C                   Endif
     C                   ADD       1             A
     C*
     C* Expense Constant
     C                   MOVEL     CON(9)        HDG(A)                         EXP CONSTANT
     C*
     C     XXEXCO        IFGT      *ZERO
     C                   Z-ADD     XXEXCO        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   Z-ADD     0             TAM(A)
     C                   END
      *** Beg Add *****  05/12/25  *******************************************
      * Print an '*' appended to heading on the line item
       If ELPror > 0 and ELPror < 1;
          Setgt rrky pec01;
          Readpe rrky2 pec01;
          If not %eof(wdecl);
             If (ECsful = 'Y' and ELcofl <> 'Y');
                HDG(A) = %trim(HDG(A)) + '*';
                PrintFlg = 'Y';
             Endif;
          Endif;
       Endif;
      *** End Add *****  05/12/25  *******************************************
     C                   ADD       1             A
      *** Beg Add *****  05/12/25  *******************************************
     C* Move both Terroism Charge to print just after Expense Constant line
     C* Earlier it was printing just after Prorata Factor line
     C*
     C* TERRORISM RISK CHARGE
     C     ELETER        IFNE      *ZERO
     C                   MOVEL     CON(33)       HDG(A)
     C*    Pro-rate Terrorism charges
     C*****              Eval(h)   xxwk11 = ELeter * ELpror
     C* Remove Pro-rate Terrorism charges
     C                   Eval(h)   xxwk11 = ELeter * 1
     C                   Z-ADD     xxwk11        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
     C*
     C* DOMESTIC TERRORISM CHARGE
     C     ELEDTR        IFNE      *ZERO
     C                   MOVEL     CON(40)       HDG(A)
     C*    Pro-rate Terrorism charges
     C*****              Eval(h)   xxwk11 = ELedtr * ELpror
     C* Remove Pro-rate Terrorism charges
     C                   Eval(h)   xxwk11 = ELedtr * 1
     C                   Z-ADD     xxwk11        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
      *** End Add *****  05/12/25  *******************************************
     C*
     C* FACULTATIVE REINSURANCE CHARGE
     C     ELEARC        IFNE      *ZERO
     C                   MOVEL     CON(50)       HDG(A)
     C                   Z-ADD     ELEARC        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
     C*
     C* Annualize 1st assessment on quote bill for CoveRisk and include in
     C* estimated premium total.
     C                   Z-ADD     0             XX1STA           11 0
     C                   Z-ADD     0             XP1STA           11 2
     C     QQQTE         IFEQ      'Q'
     C     CLTID         ANDEQ     '129'
     C     ELPROR        ANDNE     *ZERO
     C*
     C     EL1APR        DIV(H)    ELPROR        X11APR           15 4
     C     EL1FPR        DIV(H)    ELPROR        X11FPR           15 4
     C     RR1STF        MULT      X11FPR        XXAMT3           15 4
     C     RR1STP        MULT      X11APR        XXPREM
     C                   ADD       XXPREM        XXAMT3
     C     XXAMT3        DIV(H)    100           XX1STA
     C*
     C                   Z-add     el1aam        xp1sta
     C*
     C                   ENDIF
     C*
     C     XX1STA        IFNE      *ZERO
     C*
     C     RR1STH        IFEQ      *BLANKS
     C                   MOVEL     'MA DIA Charg'HDG(A)
     C                   CAT       'e':0         HDG(A)
     C                   ELSE
     C                   MOVEL     RR1STH        HDG(A)
     C                   ENDIF
     C                   Z-ADD     XX1STA        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C*
     C                   ENDIF
     C*
     C*  HARBOR EXPOSURE FEE
     C     ELHXMN        IFNE      *ZERO
     C                   MOVEL     CON(51)       HDG(A)
     C                   Z-ADD     ELHXMN        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
     C*
     C*  Policy Fee
     C     ELEPF         IFNE      *ZERO
     C                   If        RRPFHD = ' '
     C                   Eval      HDG(A) = xxSt + ' ' + con(79)
     C                   Else
     C                   Eval      HDG(A) = RRPFHD
     C                   Endif
     C                   Z-ADD     ELEPF         TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
     C*
     C* ESTIMATED PREMIUM
     C                   Select
     C                   When      cltid = '071' or cltid = '025'
     C                             or isContri = '1'
     C                   MOVEL     CON(45)       HDG(A)
     C                   Other
     C                   MOVEL     CON(10)       HDG(A)                         EST PREM
     C                   Endsl
     C                   IF        XXMINF = 'Y'
     C     XXEXCO        ADD       MPENMP        TAM(A)
     C                   ADD       ELHXMN        TAM(A)
     C                   ADD       MPEARC        TAM(A)
     C                   ADD       XX1STA        TAM(A)
     C                   Add       ELEPF         TAM(A)
     C                   Add       tasmin        TAM(A)
     C                   Else
     C     XXEXCO        ADD       ELENMP        TAM(A)
     C                   ADD       ELHXMN        TAM(A)
     C                   ADD       ELEARC        TAM(A)
     C                   ADD       XX1STA        TAM(A)
     C                   Add       ELEPF         TAM(A)
     C                   ENDIF
      *** Beg Add *****  05/12/25  *******************************************
     C* Add Full Domestic Terrorism charges and Terrorism charges
     C                   Add       ELeter        TAM(A)
     C                   Add       ELedtr        TAM(A)
      *** End Add *****  05/12/25  *******************************************
     C     A             SUB       1             B                 2 0
     C                   MOVE      *ON           *IN(B)
     C                   ADD       2             A
     C*
     C* Prorata Factor
     C     ELPROR        IFNE      1
     C                   Z-ADD     ELANPR        TAM(A)
