     C*
     C* COPY ALL BALANCE FIELDS TO GENERIC VARIABLES.
     C*
     C                   EXSR      DOBAL
     C*
     C                   EXSR      DOPAGE
     C                   MOVE      *OFF          *IN31
     C     XXDEP         IFEQ      'N'
     C                   MOVE      '1'           *IN57
     C                   MOVE      '1'           *IN84
     C                   MOVE      'Y'           RSTFLG
     C                   ENDIF
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseXml;
          If xmlSumName <> *Blank;
             ScriptHeader(xmlSumName);
             ScriptPremium(xmlSumName);
             ScriptBalance(xmlSumName);
             If *In57 = *Off;
                ScriptInstallments(xmlSumName);
             Endif;
          Endif;
       Endif;
