     C     XXSDUE        SUB       XXSFEE        XXSFEE
     C     XXSFEE        IFNE      *ZERO
     C                   MOVE      *ON           *IN53
     C                   ELSE
     C                   MOVE      *OFF          *IN53
     C                   ENDIF
     C                   ENDIF
     C*
     C*  LOAD DISCOUNT AMT INTO ARRAY IF NOT EQUAL TO 0
     C*
     C     ELEDC3        IFNE      *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELASP3        ANDNE     *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELDISC        ANDNE     *BLANK
     C*
     C                   Z-ADD     ELEDC3        TAM(A)                         DISCOUNT
     C     ELEDC3        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDC3        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDSHD        IFEQ      *BLANKS
     C                   MOVEL     CON(7)        HDG(A)
     C                   ELSE
     C                   MOVEL     RRDSHD        HDG(A)
     C                   ENDIF                                                  RRDSHD IFEQ
     C*
     C     ELEDC3        IFEQ      0
     C                   ADD       1             A
     C                   ELSE
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      '%'           PCT(7)
     C     ELASP3        IFNE      *ZERO
     C                   MOVE      ELASP3        XXASP3            5
     C                   ELSE
     C                   MOVE      ELDISP        XXASP3            5
     C                   ENDIF
     C                   MOVEA     XXASP3        NUM
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   END
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   END
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   END
     C                   ENDIF
     C*
     C*  LOAD DEVIATION IF APPLIED TO DISCOUNTED PREMIUM
     C*
     C     RRDV1L        IFEQ      'D'
     C*
     C     ELEDC2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELASP2        ANDNE     *ZERO
     C*
     C                   Z-ADD     ELEDC2        TAM(A)
     C     ELASP2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDC2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV1H        IFEQ      *BLANK
     C                   MOVEL     CON(6)        HDG(A)
     C                   ELSE
     C                   MOVEL     RRDV1H        HDG(A)
     C                   ENDIF
     C     ELDVEF        IFNE      *ZERO
     C                   Z-ADD     ELDVEF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELDVEX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELDVEX        IFNE      *ZERO
     C                   Z-ADD     ELDVEX        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      '%'           PCT(7)
     C     ELASP2        IFLT      0
      *
     C     ELASP2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
      *
     C                   ELSE
     C                   MOVE      ELASP2        XXASP2            5
     C                   ENDIF                                                  ELASP2
     C                   MOVEA     XXASP2        NUM
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF                                                  NUM,1 IFNE
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF                                                  NUM,2 IFNE
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELEDC2 IFNE
     C*
     C                   ENDIF                                                  RRDV1L IFEQ
     C*
     C*  LOAD DEVIATION 1 2ND PERIOD IF APPLIED TO DISCOUNTED PREMIUM
     C     RRDV1L        IFEQ      'D'
     C*
     C     ELD1E2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELD1S2        ANDNE     *ZERO
     C                   Z-ADD     ELD1E2        TAM(A)
     C     ELD1S2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPD1E2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV1H        IFEQ      *BLANK
     C     con(6)        CAT       @2nper:1      HDG(A)
     C                   ELSE
     C     rrdv1h        CAT       @2nper:1      HDG(A)
     C                   ENDIF
     C*
     C     ELD1D2        IFNE      *ZERO
     C                   Z-ADD     ELD1D2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD1X2        ORNE      0
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD1X2        IFNE      *ZERO
     C                   Z-ADD     ELD1X2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPTDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      '%'           PCT(7)
     C     ELD1S2        IFLT      0
     C     ELD1S2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
     C                   ELSE
     C                   MOVE      ELD1S2        XXASP2            5
     C                   ENDIF                                                  ELD1S2
     C*
     C                   MOVEA     XXASP2        NUM
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF                                                  NUM,1 IFNE
     C*
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF                                                  NUM,2 IFNE
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELD1E2 IFNE
     C*
     C                   ENDIF                                                  RRDV1L IFEQ
     C*  LOAD 2ND DEVIATION IF APPLIED TO DISCOUNTED PREMIUM
     C*
     C     RRDV2L        IFEQ      'D'
     C*
     C     ELEDV2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELDEV2        ANDNE     *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELSTFC        ANDNE     *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELDEV2F       ANDNE     *ZERO
     C*
     C                   Z-ADD     ELEDV2        TAM(A)
     C                   Select
     C                   When      ELdev2  <> 0
     C                   If        ELdev2 < *Zeros
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELstFc  <> 0
     C                   If        ELstFc > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELdev2F <> 0
     C                   If        ELdev2F > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   EndSl
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDV2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV2H        IFEQ      *BLANK
     C  N25              MOVEL     CON(19)       HDG(A)
     C   25              MOVEL     CON(72)       HDG(A)
     C                   ELSE
     C                   MOVEL     RRDV2H        HDG(A)
     C                   ENDIF
     C     ELD2EF        IFNE      *ZERO
     C                   Z-ADD     ELD2EF        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD2EX        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD2EX        IFNE      *ZERO
     C                   Z-ADD     ELD2EX        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   Select
     C*>>>>>>>>>>>>>>>>> Stabilization Factor
     C                   When      cltID = '025'
     C                   MOVE      ELSTFC        XXASP8            8
     C                   MOVEA     XXASP8        NUM8
      *
     C                   MOVE      NUM8(2)       PCT(1)
     C                   MOVE      '.'           PCT(2)
     C                   MOVE      NUM8(3)       PCT(3)
     C                   MOVE      NUM8(4)       PCT(4)
     C                   MOVE      NUM8(5)       PCT(5)
     C                   MOVE      NUM8(6)       PCT(6)
     C                   MOVE      NUM8(7)       PCT(7)
     C                   MOVE      NUM8(8)       PCT(8)
     C*>>>>>>>>>>>>>>>>> Territory Rating
     C                   When      cltID = '136'
     C                   MOVE      ELdev2F       XXASP3
     C                   MOVEA     XXASP3        NUM

     C                   MOVE      NUM(1)        PCT(2)
     C                   MOVE      '.'           PCT(3)
     C                   MOVE      NUM(2)        PCT(4)
     C                   MOVE      NUM(3)        PCT(5)
     C                   MOVE      NUM(4)        PCT(6)
     C                   MOVE      NUM(5)        PCT(7)
     C*>>>>>>>>>>>>>>>>> Default Deviation #2
     C                   Other
     C     ELDEV2        IFLT      0
      *
     C     ELDEV2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
      *
     C                   ELSE
     C                   MOVE      ELDEV2        XXASP2            5
     C                   ENDIF                                                  ELEDV2
     C                   MOVEA     XXASP2        NUM
      *
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C                   MOVE      '%'           PCT(7)
     C                   EndSl
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELEDV2 IFNE
     C*
     C                   ENDIF                                                  RRDV2L IFEQ
     C*  LOAD 2ND DEVIATION 2ND PERIOD IF APPLIED TO DISCOUNTED PREMIUM
     C     RRDV2L        IFEQ      'D'
     C*
     C     ELD2E2        IFNE      *ZERO                                        DEVIATION
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELD2S2        ANDNE     *ZERO
     C*
     C     XXCLT#        ANDNE     '025'
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     ELSTFC        ANDNE     *ZERO
     C     XXCLT#        ANDEQ     '025'
     C                   Z-ADD     ELD2E2        TAM(A)
     C     XXCLT#        IFNE      '025'
     C     ELD2S2        IFLT      *ZERO
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
     C                   ELSE
     C     ELSTFC        IFGT      1
     C                   MOVE      '+'           SGN(A)
     C                   ELSE
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXCLT#<>'025'
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPD2E2        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
     C*
     C     RRDV2H        IFEQ      *BLANK
     C  N25con(19)       CAT       @2nper:1      HDG(A)
     C   25              MOVEL     CON(72)       HDG(A)
     C                   ELSE
     C     rrdv2h        CAT       @2nper:1      HDG(A)
     C                   ENDIF
     C*
     C     ELD2D2        IFNE      *ZERO
     C                   Z-ADD     ELD2D2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     ELD2X2        ORNE      0
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     ELD2X2        IFNE      *ZERO
     C                   Z-ADD     ELD2X2        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPTDT        SRDTI
     C                   ENDIF
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C*
     C     XXCLT#        IFNE      '025'
     C                   MOVE      '.'           PCT(4)
     C                   MOVE      '%'           PCT(7)
     C     ELD2S2        IFLT      0
     C     ELD2S2        MULT      -1            XXASPN
     C                   MOVE      XXASPN        XXASP2
     C                   ELSE
     C                   MOVE      ELD2S2        XXASP2            5
     C                   ENDIF                                                  ELD2S2
     C*
     C                   MOVEA     XXASP2        NUM
     C     NUM(1)        IFNE      '0'
     C                   MOVE      NUM(1)        PCT(1)
     C                   ENDIF
      *
     C     NUM(2)        IFNE      '0'
     C     NUM(1)        ORGT      '0'
     C                   MOVE      NUM(2)        PCT(2)
     C                   ENDIF
      *
     C                   MOVE      NUM(3)        PCT(3)
     C                   MOVE      NUM(4)        PCT(5)
     C                   MOVE      NUM(5)        PCT(6)
     C*FOR CLIENT 025
     C                   ELSE
     C                   MOVE      '.'           PCT(2)
     C                   MOVE      ELSTFC        XXASP8            8
     C                   MOVEA     XXASP8        NUM8
     C                   MOVE      NUM8(2)       PCT(1)
     C                   MOVE      NUM8(3)       PCT(3)
     C                   MOVE      NUM8(4)       PCT(4)
     C                   MOVE      NUM8(5)       PCT(5)
     C                   MOVE      NUM8(6)       PCT(6)
     C                   MOVE      NUM8(7)       PCT(7)
     C                   MOVE      NUM8(8)       PCT(8)
     C                   ENDIF                                                  XXCLT# = '025'
     C*
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELD2E2 IFNE
     C*
     C                   ENDIF                                                  RRDV2L IFEQ
     C*
     C* WAIVER SURCHARGE
     C*
     C     ELWVFL        IFEQ      'D'
     C*
      *** Beg Chg *****  02/28/25  *******************************************
     C*****ELEWAV        IFNE      *ZERO
     C                   If        (ELEWAV <> 0 and XXMINF <> 'Y') OR
     C                             (MPEWAV <> 0 and XXMINF = 'Y')
      *** End Add *****  02/28/25  *******************************************
     C*
     C     RRWVHD        IFEQ      *BLANKS
     C                   MOVEL     CON(27)       HDG(A)
     C                   ELSE
     C                   MOVEL     RRWVHD        HDG(A)
     C                   ENDIF                                                  RRWVHD IFEQ
     C*
     C                   Z-ADD     ELEWAV        TAM(A)
     C                   MOVE      '+'           SGN(A)
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEWAV        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
      /Free
       //*** Beg Add *****  05/12/25  *******************************************
       // Print an '*' appended to heading on the line item
       If ELPror > 0 and ELPror < 1;
          If xxminf = 'Y';
             HDG(A) = %trim(HDG(A)) + '*';
             PrintFlg = 'Y';
          Endif;
       Endif;
       //*** End Add *****  05/12/25  *******************************************

       If tam(a) <> 0;
          hdg(a) = AddWaiverToHdg(hdg(a));
       Endif;
      /End-Free
     C                   ADD       1             A
     C*
     C                   ENDIF                                                  ELEWAV IFNE
     C*
     C                   ENDIF                                                  RRWVFL IFEQ
      *** Beg Add *****  07/07/23  *******************************************
      * Re-arrange coding in this ordering:
      *   Large deductible applied to 'D'.
      *   ARAP charge.
      *   Facultative reinsurance.
      *   Balance to minimum premium.
      *   Normal premium/Minimum premium.
      *   Terrorism charges.
      *   Harbor exposure minimum.
      *   Expense constant.
      *   Policy fee.
      *   Estimated premium.
      *   Prorated premium.
      *   State tax
      *   Total due.
      *** End Add *****  07/07/23  *******************************************
      *** Beg Add *****  11/10/23  *******************************************
      * Re-arrange coding in this ordering:
      *   Manual Premium
      *   Inc Limits
      *   Subject Premium
      *   Experience Mod
      *   Standard Premium
      *   Stock Discountges
      *   Expense Constant
      *   Estimated Premium
      *   Prorata Factor
      *   Balance to Minimum
      *   Minimum Premium
      *   Terrorism Charge
      *   Domestic Terrorism Charge
      *   Total Premium
      *** End Add *****  11/10/23  *******************************************
     C*
     C* ADDITIONAL LOAD
     C*
     C     RRASFL        IFEQ      'D'
     C*
     C     XTADLD        IFNE      *ZERO
      *** Beg Del *****  07/07/23  *******************************************
     C***  ELEMNP        ANDNE     'Y'
      *** End Del *****  07/07/23  *******************************************
     C                   MOVEL     CON(18)       HDG(A)
     C   49              Eval      HDG(A) = 'Stop Gap Premium'
     C                   Z-ADD     XTADLD        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   ADD       1             A
     C                   ENDIF
     C*
     C                   ENDIF                                                  RRASFL IFEQ
     c     XXLRGD        IFEQ      'Y'
     c*
     c*  1st Large Deductible applied to Discounted
     c*
     c                   if        ldplv1 = 'D'
     c*
     C     ELEDCT        IFNE      *ZERO
      *** Beg Chg *****  07/07/23  *******************************************
     C***  ELEMNP        OREQ      'Y'
     C     XXMINF        OREQ      'Y'
      *** End Chg *****  07/07/23  *******************************************
     C     LDPCT1        ANDNE     *ZERO
     C*
     C     LDEFD1        IFNE      *ZERO
     C                   Z-ADD     LDEFD1        SRDTI
     C                   ELSE
     C                   Z-ADD     ELPFDT        SRDTI
     C                   ENDIF
     C*
     C     SRDTI         IFNE      ELPFDT
     C     LDEXP1        ORNE      0
     C*
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EFD(A)
     C     LDEXP1        IFNE      *ZERO
     C                   Z-ADD     LDEXP1        SRDTI
     C                   ELSE
     C                   Z-ADD     0             SRDTI
     C                   ENDIF
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         EXD(A)
     C     EFD(A)        IFNE      *ZERO
     C     EXD(A)        ANDNE     *ZERO
     C                   MOVE      '-'           DSH(A)
     C                   ENDIF
     C*
     C                   ENDIF                                                  SRDTI IFNE
     C*
     C                   Z-ADD     ELEDCT        TAM(A)
     C     ELEDCT        IFNE      *ZERO
     C                   MOVE      '-'           SGN(A)
     C                   ENDIF
      *** Beg Add *****  07/07/23  *******************************************
     C                   IF        XXMINF = 'Y'
     C                   Z-ADD     MPEDCT        TAM(A)
     C                   ENDIF
      *** End Add *****  07/07/23  *******************************************
