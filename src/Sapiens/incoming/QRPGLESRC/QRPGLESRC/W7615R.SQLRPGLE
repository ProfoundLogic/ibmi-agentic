     C*
     C* LOAD THE STATE TAX INTO ARRAY
     C     ELTXDU        IFNE      0
     C*
     C     RRTXHD        IFNE      *BLANKS
     C                   MOVEL(P)  RRTXHD        XXTHD            20
     C                   ELSE
     C                   MOVEL(P)  CON(24)       XXTHD            20
     C                   ENDIF
     C                   Z-ADD     ELTXDU        TAM(A)
     C                   MOVE      '+'           SGN(A)
     C                   CLEAR                   TMP
     C                   CLEAR                   XTX
     C                   MOVE      *BLANKS       XXTXPD
     C                   MOVE      *BLANKS       XXTXPR
     C     RRTXHD        IFNE      *BLANKS
     C                   MOVEA     RRTXHD        TMP
     C                   ELSE
     C                   MOVEA     CON(24)       TMP
     C                   ENDIF                                                  RRTXHD IFNE
     C*
     C                   MOVE      ELTXPR        XXTXPD
     C* CENTS
     C                   MOVE      '.'           XXPER
     C                   MOVE      XXTXCD        XXTXC
     C* HUNDREDS
     C     ELTXPR        IFGE      1000
     C                   MOVE      ','           XXCM2
     C                   MOVE      XXTXHD        XXTXH
     C                   ENDIF
     C* THOUSANDS
     C     ELTXPR        IFGE      1000000
     C                   MOVE      ','           XXCM1
     C                   MOVE      XXTXTD        XXTXT
     C                   ENDIF
     C* HANDLE RANGES TO ELIMINATE LEADING ZEROES.
     C     ELTXPR        IFGE      0
     C     ELTXPR        ANDLT     1000
     C                   MOVEA     XXTXHD        XTX
     C     XTX(1)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(1)
     C     XTX(2)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(2)
     C                   ENDIF                                                  XTX,2 IFEQ
     C                   ENDIF                                                  XTX,1 IFEQ
     C                   MOVEA     XTX           XXTXH
     C                   ENDIF                                                  ELTXPR IFGE
     C*
     C     ELTXPR        IFGE      1000
     C     ELTXPR        ANDLT     1000000
     C                   MOVEA     XXTXTD        XTX
     C     XTX(1)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(1)
     C     XTX(2)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(2)
     C                   ENDIF                                                  XTX,2 IFEQ
     C                   ENDIF                                                  XTX,1 IFEQ
     C                   MOVEA     XTX           XXTXT
     C                   ENDIF                                                  ELTXPR IFGE
     C*
     C     ELTXPR        IFGE      1000000
     C                   MOVEA     XXTXMD        XTX
     C     XTX(1)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(1)
     C     XTX(2)        IFEQ      '0'
     C                   MOVE      *BLANK        XTX(2)
     C                   ENDIF                                                  XTX,2 IFEQ
     C                   ENDIF                                                  XTX,1 IFEQ
     C                   MOVEA     XTX           XXTXM
     C                   ENDIF                                                  ELTXPR IFGE
     C*
     C                   MOVEA     XXTXPR        TMP(13)
     C                   MOVE      '*'           TMP(28)
     C                   MOVEA     TMP           HDG(A)
     C                   CLEAR                   TMP
     C*
     C                   MOVE      '.'           PCT(3)
     C                   MOVE      RRTXPC        X6PROR            6
     C                   MOVEA     X6PROR        NUM6
     C     NUM6(1)       IFNE      '0'
     C                   MOVE      NUM6(1)       PCT(1)
     C                   END
     C     NUM6(2)       IFNE      '0'
     C     NUM6(1)       ORGT      '0'
     C                   MOVE      NUM6(2)       PCT(2)
     C                   END
     C                   MOVE      NUM6(3)       PCT(4)
     C                   MOVE      NUM6(4)       PCT(5)
     C                   MOVE      NUM6(5)       PCT(6)
     C                   MOVE      NUM6(6)       PCT(7)
     C                   MOVE      '%'           PCT(8)
     C                   MOVEA     PCT           PRC(A)
     C                   CLEAR                   PCT
     C                   ADD       1             A
     C                   ENDIF                                                  ELTXDU IFNE 0
     C*
     C* LOAD THE TOTAL PREMIUM INTO ARRAY
      *** Beg Chg *****  05/12/25  *******************************************
     C*****              If        ELTxdu <> 0 or ELETer <> 0 or
     C*****                        ELEDTr <> 0
     C                   If        ELTxdu <> 0
      *** End Chg *****  05/12/25  *******************************************
     C*
     C                   Select
     C                   When      cltid = '071' or cltid = '025'
     C                             or isContri = '1'
     C                   MOVEL     CON(48)       HDG(A)
     C                   OTHER
     C                   MOVEL     CON(25)       HDG(A)                         TOT ST TAX
     C                   ENDSL
     C                   IF        XXMINF = 'Y'
     C     ELTXDU        ADD       MPANPR        TAM(A)
     C* Add Pro-rate Domestic Terrorism charges and Terrorism charges
     C                   Eval(h)   xxwk11 = ELeter * ELpror
     C                   Add       xxwk11        TAM(A)
     C                   Eval(h)   xxwk11 = ELedtr * ELpror
     C                   Add       xxwk11        TAM(A)
     C* Add balance to minimum
     C                   Add       MPEbal        TAM(A)
     C*** begin add ***  11/08/24  *******************************************
     C                   Add       ELEPF         TAM(A)
     C*** end add *****  11/08/24  *******************************************
      *** Beg Add *****  05/12/25  *******************************************
     C                   ADD       MPEARC        TAM(A)
      *** End Add *****  05/12/25  *******************************************
     C
     C                   ELSE
     C     ELTXDU        ADD       ELANPR        TAM(A)
     C                   ENDIF
     C
     C* Add Coverisk 1st assessment on quotes
     C                   ADD       xp1STA        TAM(A)
     C     XXMINF        IFEQ      'Y'
     C                   MOVE      '*'           SGN(A)
     C                   ENDIF
     C     A             SUB       1             B                 2 0
     C                   MOVE      *ON           *IN(B)
     C                   ADD       1             A
     C*
     C                   Endif                                                  Total Premium
      *** end chg *****  11/13/23  *******************************************
      //*** Beg Add *****  05/12/25  *******************************************
      // Print "* Indicated line items do not get prorated"
       If PrintFlg = 'Y';
          TAM(A) = 0;
          HDG(A) = MSG(3);
          A += 1;
       Endif;
      //*** End Add *****  05/12/25  *******************************************
     C*
     C*  GET BILLING COMMENT DESCRIPTIONS
     C*
     C     XXCOM1        IFNE      *BLANK
     C                   MOVEL     XXCOM1        XXBCOM
     C     BCKEY1        CHAIN     PBC01                              50
      //*** Beg Chg ***** 09/01/23 *****************************
     C***  N50              MOVEL     BCDESC        BCCOM1           30
       If %Found(wtabl);
          BCCOM1 = %Trim(TitleCase(BCdesc));
       Endif;
      //*** End Chg ***** 09/01/23 *****************************
     C                   END
     C*
     C     XXCOM2        IFNE      *BLANK
     C                   MOVEL     XXCOM2        XXBCOM
     C     BCKEY1        CHAIN     PBC01                              50
      //*** Beg Chg ***** 09/01/23 *****************************
     C***  N50              MOVEL     BCDESC        BCCOM2           30
       If %Found(wtabl);
          BCCOM2 = %Trim(TitleCase(BCdesc));
       Endif;
       //*** End Chg ***** 09/01/23 *****************************
     C                   END
     C*
     C     XXCOM3        IFNE      *BLANK
     C                   MOVEL     XXCOM3        XXBCOM
     C     BCKEY1        CHAIN     PBC01                              50
      //*** Beg Chg ***** 09/01/23 *****************************
     C***  N50              MOVEL     BCDESC        BCCOM3           30
       If %Found(wtabl);
          BCCOM3 = %Trim(TitleCase(BCdesc));
       Endif;
      //*** End Chg ***** 09/01/23 *****************************
     C                   END
     C     QQFCM1        IFNE      *BLANKS
     C     QQFCM2        ORNE      *BLANKS
     C     QQFCM3        ORNE      *BLANKS
     C                   MOVEL(P)  QQFCM1        BCCOM1
     C                   MOVEL(P)  QQFCM2        BCCOM2
     C                   MOVEL(P)  QQFCM3        BCCOM3
     C                   ENDIF                                                  QQFCM1 IFNE
     C*
     C*  CALCULATE STATE TAX BALANCE
     C*
     C                   Z-ADD     0             XXTAXP           11 2
     C*
     C     QQQTE         IFEQ      'Q'
     C                   Z-ADD     ELTXDU        XXTXDU
     C                   ELSE
     C*
     C                   Z-ADD     ELTXDU        XXTXDU           11 2
     C     EAKY2         CHAIN     PEA02                              60
     C     *IN60         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'T'
     C     TTTYPE        ANDEQ     'Q'
     C                   ADD       EAAMT         XXTAXP
     C                   ENDIF
     C                   ENDIF
     C*
     C     EAKY2         READE     PEA02                                  60
     C                   ENDDO
     C*
     C                   ENDIF
     C*
     C     XXTXDU        COMP      *ZEROS                                 45
     C*
     C                   ADD       ELANPR        xcANPR
     C                   Z-ADD     0             XXWKDT            7 0
     C                   Z-ADD     0             X
     C                   CLEAR                   RCR
     C*
     C*  PERFORM CALCULATIONS FOR ESTIMATING ACCOUNTS
     C*
     C     BSSEFL        IFEQ      'E'
     C     BLARQ#        IFNE      0
     C     SVEMP#        ANDEQ     0
     C     XXBAT#        ORNE      0
     C     SVEMP#        ANDNE     0
     C*
     C     BLARQ#        IFNE      0
     C                   MOVE      BLARQ#        @BLARQ
     C                   ELSE
     C                   MOVE      XXBAT#        @BLARQ
     C                   ENDIF                                                  BLARQ# IFNE 0
     C*
     C     EAKYD         CHAIN     PEA0D                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     EAARCD        IFEQ      F1RCCD
     C                   ADD       EAAMT         XXRCTL
     C                   ENDIF                                                  EAARCD IFEQ F1RCCD
     C*
     C     EAKYD         READE     PEA0D                                  60
     C                   ENDDO                                                  *IN60 DOWEQ *OFF
     C                   ENDIF                                                  BLARQ# IFNE 0
     C*
     C*  ACCUMULATE AMOUNTS FOR PREMIUM PAID
     C*

      /free
       xxType = 'P';
       Setll eaKey pea01;
       Reade eaKey pea01;
       Dow not(%eof);
       // Exclude Dividend Premium Cash from balance calc
          If EAarcd = F1dvpd or EAarcd = F1dvxr;
             Reade eaKey pea01;
             Iter;
          Endif;
          If EAarcd <> F1rccd;
             xxDprp = xxDprp + EAamt;
          Else;
             xxRctl = xxRctl + EAamt;
          Endif;
       Reade eaKey pea01;
       Enddo;
      /end-free

     C                   MOVE      'T'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     TTCTYP        IFNE      'D'
     C                   ADD       EAAMT         XXDPRP
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   END
     C                   MOVE      'N'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C                   SUB       EAAMT         XXDPRP            9 2
     C     EAKEY         READE     PEA01                                  40
     C                   END
     C                   MOVE      'R'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     TTCTYP        IFNE      'D'
     C                   SUB       EAAMT         XXDPRP            9 2
     C                   ENDIF
     C     EAKEY         READE     PEA01                                  40
     C                   END
     C                   ADD       XXTAXP        XXDPRP
     C*
     C*   INCLUDE MEMBERSHIP FEES PAID IN PREVIOUS PREM PAID AMOUNT
     C*   AND ADD MEMBERSHIP FEES BILLED AMT TO PREM AMT BEFORE BALANCE.
     C*
     C                   Z-ADD     *ZERO         XXMFDU                         MEMBER FEE BALANCE
     C                   Z-ADD     XXMDUE        XXMFDU            7 2
     C                   ADD       XXMFEE        XXDPRP
     C     XXMFDU        IFNE      *ZERO
     C                   MOVE      *ON           *IN52
     C                   ELSE
     C                   MOVE      *OFF          *IN52
     C                   ENDIF
     C                   ADD       XXINPD        XXDPRP
     C*
     C*   INCLUDE SAFETY FEES PAID IN PREVIOUS PREM PAID AMOUNT
     C*   AND ADD SAFETY FEES BILLED AMT TO PREM AMT BEFORE BALANCE    .
     C*
     C                   Z-ADD     *ZERO         XXSFDU
     C                   Z-ADD     XXSDUE        XXSFDU           11 2
     C                   ADD       XXSFEE        XXDPRP
     C     XXSFDU        IFNE      *ZERO
     C                   MOVE      *ON           *IN53
     C                   ELSE
     C                   MOVE      *OFF          *IN53
     C                   ENDIF
     C*
     C*
     C* ACCUMULATE PREVIOUSLY BILLED FOR AGENCY BILLING - REVISED BILL
     C*
     C     *IN93         IFEQ      *ON
     C*
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         X1DATE            7 0
     C                   Z-ADD     0             XXDPRP
     C                   MOVE      'B'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     Eaarcd        Andne     F1dvbl
     C     EATRDT        IFLT      X1DATE
     C     EAPODT        ANDLT     X1DATE
     C                   ADD       EAAMT         XXDPRP
     C                   ENDIF                                                  EATRDT IFLT
     C                   ENDIF                                                  *IN60 IFEQ 0
     C     EAKEY         READE     PEA01                                  40
     C                   END
     C*
     C                   MOVE      'A'           XXTYPE
     C     EAKEY         CHAIN     PEA01                              40
     C     *IN40         DOWEQ     '0'
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     EATRDT        IFLT      X1DATE
     C                   ADD       EAAMT         XXDPRP
     C                   ENDIF                                                  EATRDT IFLT
     C                   ENDIF                                                  *IN60 IFEQ 0
     C     EAKEY         READE     PEA01                                  40
