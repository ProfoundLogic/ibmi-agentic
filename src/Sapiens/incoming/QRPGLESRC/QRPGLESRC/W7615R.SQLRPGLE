     C                   MOVE      *BLANKS       QSGN
     C*
     C     1             DO        27            D                 2 0
     C                   SELECT
     C     CLTID         WHENEQ    '071'
     C     CLTID         OREQ      '025'
      *
     C     HDG(D)        IFNE      *BLANKS
     C     E             ANDLE     23
     C     *IN90         ANDEQ     *OFF
     C     HDG(D)        ANDNE     CON(9)
     C     HDG(D)        ORNE      *BLANKS
     C     E             ANDLE     23
     C     HDG(D)        ANDNE     CON(42)
     C     HDG(D)        ANDNE     CON(43)
     C     HDG(D)        ANDNE     CON(47)
     C     HDG(D)        ANDNE     CON(9)
     C*
