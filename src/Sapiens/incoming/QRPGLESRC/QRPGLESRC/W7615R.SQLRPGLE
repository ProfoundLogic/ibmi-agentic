     C                   Z-ADD     EL2DEF        X7DDEF
     C                   MOVE      EL2DEF        Q1DATX
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q1DATX            7
     C*
     C                   MOVE      Q1DATX        X7DDEF
     C*
     C     DDKY          SETGT     PDD01
     C     DDKY2         READPE    PDD01                                  47
     C*
     C     *IN47         IFEQ      *OFF
     C     DDSTAT        ANDEQ     'A'
     C*
     C                   SELECT
     C     DDVERB        WHENEQ    'C'
