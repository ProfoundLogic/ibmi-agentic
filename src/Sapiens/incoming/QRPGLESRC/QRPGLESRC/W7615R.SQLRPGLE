     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
