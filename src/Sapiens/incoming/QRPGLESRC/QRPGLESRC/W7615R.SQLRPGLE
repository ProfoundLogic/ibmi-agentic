     C     EAKY2         READE     PEA02                                  60
     C                   ENDDO
     C                   Z-ADD     WKD(U)        XXPFDT
     C                   Z-ADD     WKD(U)        XXYMD
     C  N57              EXSR      SRDUEW
     C*
     C                   ELSE                                                   Y IFEQ 1
     C*
     C                   MOVE      '.'           DUW(3)
     C                   Z-ADD     WKD(U)        XXPODT
     C     EAKY4         CHAIN     PEA02                              60
     C*
     C     *IN60         DOWEQ     *OFF
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     EAARTY        IFEQ      'B'
     C     EAARTY        OREQ      'A'
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     EAarcd        Andne     F1dvbl

     C                   ADD       EAAMT         AMT(3)
     C                   ENDIF                                                  *IN60 IFEQ 0
     C                   END
