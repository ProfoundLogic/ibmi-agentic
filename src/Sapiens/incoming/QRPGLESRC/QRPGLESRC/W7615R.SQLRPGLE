     C     EAARTY        OREQ      'A'
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     EAarcd        Andne     F1dvbl
     C                   ADD       EAAMT         AMT(1)
     C                   ENDIF                                                  *IN60 IFEQ 0
     C                   END
