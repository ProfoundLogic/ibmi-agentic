     C***                ELSE
     C***  BLKEY1        READE     PBL05                                  60
     C***                ENDIF                                                  QQRNB EQ B
     C***                ENDIF                                                  TURN EQ 1
       If turn = 1;
          If qqRNB = 'B';
             Reade keyCoFnd pbl02;
          Else;
             Reade blKey1 pbl04;
          Endif;
       Else;
          If qqRNB = 'B';
             Reade keyCoFnd pbl03;
          Else;
             Reade blKey1 pbl05;
          Endif;
       Endif;
       *in60 = %EOF;
