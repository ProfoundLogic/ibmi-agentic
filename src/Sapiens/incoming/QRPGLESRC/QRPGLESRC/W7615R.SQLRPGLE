      /Free
       *in26 = *off;
       If xxClt# = '025';
          *in25 = *on;
          *in26 = *on;
       Endif;
       pgmName   = 'WIQTEBILL';
       pgmExists = *Off;
       isPortal  = *Off;
       ChkPgmStack(pgmName:pgmExists);
       If pgmExists = *On;
          isPortal  = *On;
       EndIf;
       If QQagto = 'O';
          QQagto = 'Y';
          isAgentRunOnly = *On;
       Endif;
        // Set 3rd Party Quote Flag
        isSubmitQte3rd = *Off;
        If qqFqt = 'I' Or qqFqt = 'B';
           isSubmitQte3rd = *On;
        EndIf;

        // Modify Final Quote Parameter
        Select;
        When qqFqt = 'I';
           qqFqt = ' ';
        When qqFqt = 'B';
           qqFqt = 'Y';
        EndSl;
      /End-free
