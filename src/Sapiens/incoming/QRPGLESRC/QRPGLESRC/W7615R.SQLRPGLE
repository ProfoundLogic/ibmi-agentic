       If ELPror > 0 and ELPror < 1;
          If xxminf = 'Y';
             HDG(A) = %trim(HDG(A)) + '*';
             PrintFlg = 'Y';
          Endif;
       Endif;
       //*** End Add *****  05/12/25  *******************************************

       If tam(a) <> 0;
          hdg(a) = AddWaiverToHdg(hdg(a));
       Endif;
