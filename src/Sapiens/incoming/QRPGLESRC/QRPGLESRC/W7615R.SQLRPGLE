     C***                ELSE
     C***  BLKEY1        SETLL     PBL05
     C***                ENDIF                                                  QQRNB EQ B
     C***                ENDIF                                                  TURN EQ 1
       // Rename BLKEY
       If turn = 1;
          If qqRNB = 'B';
             Setll keyCoFnd pbl02;
          Else;
             Setll blKey1 pbl04;
          Endif;
       Else;
          If qqRNB = 'B';
             Setll keyCoFnd pbl03;
          Else;
             Setll blKey1 pbl05;
          Endif;
       Endif;
