       // Don't Print Assessments if SR Policy and Assessments
       If Not isSRAs Or TTcTyp = 'T' Or TTcTyp = 'M' Or TTcTyp = 'T';
       //*** End   Add *** 06/12/24 **********************************
     C                   ADD       EAAMT         XXDPRP
       //*** Begin Add *** 06/12/24 **********************************
       EndIf;
