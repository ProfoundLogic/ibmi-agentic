     C*  GET DESCRIPTION
     C*
     C                   MOVE      *OFF          *IN47
     C                   MOVE      *ON           *IN46
     C                   CLEAR                   XXDDVB
     C     ELDCDE        IFNE      *BLANK
     C                   CLEAR                   XXDDVB
     C                   MOVE      ELDCDE        XXCODE
     C                   Z-ADD     ELPFDT        X7DDEF
     C                   MOVE      ELDCEF        Q1DATX
     C                   MOVE      ELFYR         Q1FYR
     C                   MOVE      ELEMP#        Q1EMP#
     C                   MOVE      ELDIV         Q1DIV
     C*
     C                   CALL      'SREFFD'
     C                   PARM                    QQCO#             3
     C                   PARM                    QQFND             3
     C                   PARM                    Q1FYR             3
     C                   PARM                    Q1EMP#            9
     C                   PARM                    Q1DIV             5
     C                   PARM                    Q1DATX            7
     C*
     C                   MOVE      Q1DATX        X7DDEF
     C     DDKY          SETGT     PDD01
     C     DDKY2         READPE    PDD01                                  46
     C     *IN46         IFEQ      *OFF
     C     DDSTAT        ANDEQ     'A'
     C*
     C                   SELECT
     C     DDVERB        WHENEQ    'C'
     C                   MOVEL(P)  CLM           XXOCCL           15
     C                   MOVEL(P)  XXOCCL        XXDDVB
     C                   OTHER
     C                   MOVEL(P)  OCC           XXOCCL
     C                   MOVEL(P)  XXOCCL        XXDDVB
     C                   ENDSL
     C*
     C                   MOVEL(P)  DDDESC        XXDDD1           27
     C     DDTYPE        IFEQ      'G'
     C                   MOVEL     'Gross'       XXDEDT            5
     C                   ELSE
     C                   MOVEL     'Net  '       XXDEDT
     C                   ENDIF                                                  DDTYPE IFEQ
     C*
     C*
     C                   Z-ADD     DDAMPO        XXAMPO
     C                   Z-ADD     DDAMAG        XXAMAG
     C*
     C                   ENDIF                                                  *IN46 IFEQ
     C*
     C                   ENDIF                                                  ELDDCT IFNE
     C*
