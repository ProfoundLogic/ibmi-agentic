     C                   If        ELdev2 < *Zeros
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELstFc  <> 0
     C                   If        ELstFc > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
     C                   When      ELdev2F <> 0
     C                   If        ELdev2F > 1
     C                   Eval      sgn(a) = '+'
     C                   Else
     C                   Eval      sgn(a) = '-'
     C                   EndIf
