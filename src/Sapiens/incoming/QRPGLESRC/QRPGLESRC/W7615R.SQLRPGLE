     C*
     C* Print more line items on summary and include balance to min changes.
     C*
     C                   Eval      xxwk11 = MPEBal
     C                   If        ELpror > 0 and ELpror < 1 and MPEBal <> 0
     C                   Eval(h)   xxwk11 = annMin
     C                   Endif

     C* Premium levels.
     C                   IF        XXMINF = 'Y'
     C                   ADD       MPMAPR        XTMAPR
     C                   ADD       MPESBJ        XTESBJ
     C                   ADD       MPEMPM        XTEMPM
     C                   ADD       MPSTPR        XTSTPR
     C                   Add       xxwk11        XTSTPR
     C                   ADD       MPENMP        XTENMP
     C                   Add       xxwk11        XTENMP
     C                   ADD       MPENMP        XTESTP
     C                   Add       xxwk11        XTESTP
     C                   Add       xxwk11        XTMBAL
     C                   ELSE
     C                   ADD       ELMAPR        XTMAPR
     C                   ADD       ELESBJ        XTESBJ
     C                   ADD       ELEMPM        XTEMPM
     C                   ADD       ELSTPR        XTSTPR
     C                   ADD       ELENMP        XTENMP
     C                   ADD       ELENMP        XTESTP
     C                   ENDIF

     C* Expense constant
     C     ELFFL9        IFEQ      ' '
     C                   ADD       ELPRTF        XTEXCO
     C                   ADD       ELPRTF        XTESTP
     C                   ELSE
     C                   ADD       ELPRTD        XTEXCO
     C                   ADD       ELPRTD        XTESTP
     C                   ENDIF

     C* Estimated premium
     C                   ADD       XX1STA        XTESTP

     C* Prorated premium
     C                   ADD       ELANPR        XTPPRM
