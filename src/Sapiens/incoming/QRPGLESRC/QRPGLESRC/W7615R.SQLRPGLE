      /Free

         QuoteProposal();

      /End-Free
     C                   WRITE     QHEAD1
     C                   WRITE     QLINE1
     C                   WRITE     QHEAD2
     C                   WRITE     QHEAD3
     C                   ENDSL
      *** Beg Chg ***** 09/01/23 **************************
     C***                WRITE     QBOX1
       If isUseSpoolOut;
          Write qBox1;
       Endif;
      *** End Chg ***** 09/01/23 **************************
     C                   MOVE      *OFF          XX1ST
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C                   ENDIF                                                  *IN54 = *OFF
     C*
     C* DO NOT EXCEPT THESE OUTPUT SPECS FOR ESTIMATED BILLS
     C*
     C     BILL          IFEQ      'A'
     C                   MOVE      *BLANKS       XXGHDG           20
     C                   MOVE      *ZEROS        XXGAMT           11 2
     C                   Z-ADD     0             XXLFEE           11 2
       //*** Beg Add ***** 09/01/23 ***********************
       If isUseSpoolOut;
       //*** End Add ***** 09/01/23 ***********************
     C                   EXCEPT    TOTA
     C                   EXCEPT    TOTAT
     C                   EXCEPT    SUMAT1
     C                   EXCEPT    SUMAT
     C                   EXCEPT    SUMA1
     C                   EXCEPT    SUMA
     C                   EXCEPT    TOTA1
     C                   EXCEPT    TOTAT1
       //*** Beg Add ***** 09/01/23 ***********************
       Endif;
       //*** End Add ***** 09/01/23 ***********************
     C                   ENDIF                                                  BILL IFEQ A
     C*
     C                   MOVE      '0'           XXPRT
     C                   END
     C*
     C*  IF MORE PAYROLL RECORDS TO READ, RETURN TO PAYROLL FILE
     C*
     C     XXRATE        IFEQ      'Y'
     C                   GOTO      RTAG
     C                   ENDIF
     C*
     C     *IN54         IFEQ      '1'
     C                   READP     PEP01                                  50
     C     *IN50         IFEQ      '0'
     C     EPCO#         ANDEQ     XXCO#
     C     EPFND         ANDEQ     XXFND
     C     EPEMP#        ANDEQ     XXEMP#
     C     EPDIV         ANDEQ     XXDIV
     C                   GOTO      READPR
     C                   END
     C                   END
     C     TURN          IFEQ      2
     C     QQAGTO        OREQ      'N'
       // Only communicate to IC if allowed and quote
       If qqQte = 'Q' And isProcessICQuote And isSubmitQte3rd;

          If xxEmp# <> holdEmp# Or xxDiv <> holdDiv;

             Clear decInvoice#;

             // Need to get the invoice#
             Exec Sql Select Min(EANinv) Into :decInvoice# From WMEAP
                Where EAco# = :xxCo# And EAfnd = :xxFnd And EAemp# = :xxEmp#
                      And EAdiv = :xxDiv and EAfyr = :xxFyr;

             // Call Third Party invoicing Summarized - Estimated
             Select;
             When decInvoice# = 0;
             // Do nothing
             When QQQTE = 'Q' and
              QuotePaymentRecieved(xxCo#:xxFnd:xxEmp#:xxDiv);
             // Do nothing
             Other;
                chrJson = '{' +
                       '"type":"quote billing",' +
                       '"invoice":"'  + %EditC(decInvoice#:'X') + '",' +
                       '"company":"'  + %EditC(xxCo#:'X')       + '",'  +
                       '"group":"'    + %EditC(xxFnd:'X')       + '",'  +
                       '"employer":"' + %EditC(xxEmp#:'X')      + '",'  +
                       '"division":"' + %EditC(xxDiv:'X')       + '",'  +
                       '"active":"true"' +
                       '}';
                ThirdPartyInvoicing(chrJson);
                FinalizeThirdPartyInvoicing(xxCo#:xxFnd);
             Endsl;

             holdEmp# = xxEmp#;
             holdDiv  = xxDiv;
          EndIf;
       EndIf;
     C*
     C*  IF ALL FLAGS IN BILLING TRANS FILE ARE BLANK THEN DELETE RCD
     C*
     C     BLKEY2        CHAIN     PBL01                              60
     C     *IN60         IFEQ      '0'
     C     BLFLG1        ANDEQ     *BLANK
     C     BLFLG2        ANDEQ     *BLANK
     C     BLFLG3        ANDEQ     *BLANK
     C                   DELETE    PBL01
     C                   END
      *
      *  Update New Business Tracking records
      *
      * Always check to see if need to update Agent Quote Date.
     C                   EXSR      SRTRK1
     C*
     C*  UPDATE THE AGENT QUOTE FILE WITH THE ESTIMATED ANNUAL
     C*  PREMIUM PLUS A FULL YEARS EXPENSE CONSTANT FOR EACH
     C*  ACTIVE AGENT.  GET ACTIVE AGT FROM AGT HISTORY FILE.
     C*
     C     AHKY1         CHAIN     PAH01                              60
     C     *IN60         DOWEQ     '0'
     C     AHSTAT        IFNE      'I'
     C                   MOVE      AHAGT#        XXAGT#
     C                   Select
     C                   When      qqQte = *blank
     C                   Eval      xxQte = 'W'
     C                   Other
     C                   Eval      xxQte = qqQte
     C                   Endsl
     C     QTKY          CHAIN     PQT01                              60
     C*
     C     *IN60         DOWEQ     '0'                                          ALL RECS FOR AGT
     C*
      /free
         Select;
           When QTTYPE = 'F';
                QTTYPE = 'p';
           When QTTYPE = 'G';
                QTTYPE = 'q';
         Endsl;
      /End-free
     C*
     C*  CHANGE QUOTE TYPE TO 'Q' IF APPLICABLE
     C*
     C     QQQTE         IFEQ      'Q'
     C     QTTYPE        ANDEQ     'P'
     C     QQFQT         ANDEQ     'Y'
     C                   MOVE      'Q'           QTTYPE
      *  UPDATE TYPE CHANGE DATE
     C                   MOVEL     XXCRDT        QTWKDT
     C                   END
      *
     C*
     C*  CHANGE RENEWAL QUOTE TYPE TO 'G' IF APPLICABLE
     C*
     C     QQQTE         IFEQ      'Q'
      *** Beg Del ***** 09/16/24 ****************************************
     C***  QTTYPE        ANDEQ     'p'
      *** End Del ***** 09/16/24 ****************************************
     C     QQFQT         ANDEQ     'Y'
     C                   MOVE      'q'           QTTYPE
      *** Beg Add ***** 09/27/24 ****************************************
      * Check for New Business Quote
     C                   If        EMRQFL <> 'Y'
     C                   MOVE      'Q'           QTTYPE
     C                   ENDIF
      *** End Add ***** 09/27/24 ****************************************
      *  UPDATE TYPE CHANGE DATE
     C                   MOVEL     XXCRDT        QTWKDT
     C                   END
      /free
       exsr srTrk2;
      /end-free
     C*
     C*  ADD FULL YEAR'S EXPENSE CONSTANT TO PREMIUM AMOUNT IF
     C*  MINIMUM PREMIUM IS NOT INVOKED AND IF STATE REPORTING
     C*  FLAG IS YES
     C*
     C*  PREMIUM SHOULD BE UPDATED EVERY TIME A QUOTE BILL IS RUN
     C                   Z-ADD     *ZEROS        QTPREM
     C     ELEMNP        IFNE      'Y'
     C     F1EXDV        OREQ      'Y'
     C     ELEMNP        ANDNE     'Y'
     C     XXEXCO        ADD       ELENMP        QTPREM
     C                   ELSE
     C                   Z-ADD     ELENMP        QTPREM
     C                   END
     C                   ADD       ELETER        QTPREM
     C                   ADD       ELEDTR        QTPREM
     C                   ADD       ELHXMN        QTPREM
     C                   ADD       ELEARC        QTPREM
     C*
     C*
     C                   ADD       1             DSTIME
     C                   MOVE      Q1USER        QTUSER
     C                   MOVE      Q1PGM         QTPGM
     C                   Z-ADD     DSDATE        SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         QTDT
     C                   Z-ADD     DSTIME        QTTIME
     C                   UPDATE    PQT01
      /free
          UpdFQLockSts(QTco#:QTfnd:QTemp#:QTdiv:QTtype);
      /end-free
     C*
     C     QTKY          READE     PQT01                                  60
     C                   END                                                    IF *60 QTKY
     C                   END                                                    IF ACTIVE
     C     AHKY1         READE     PAH01                                  60
     C                   END                                                    DOW *60 AHKY
     C                   ENDIF                                                  TURN EQ 2
     C     XXNEWF        IFEQ      'Y'
     C                   CLOSE     W7615O
     C                   Move      x2Prt         xxPrt             1
     C                   ENDIF                                                  XXNEWF IFEQ
     C*
     C     TURN          IFEQ      1
     C     QQDART        ANDEQ     'Y'
     C     XXNEWF        OREQ      'Y'
     C                   ADD       1             XXSPOL            4 0
     C     XXSPOL        IFEQ      999
     C                   Z-ADD     9990          XXSPL
     C                   ENDIF                                                  XXSPOL EQ 999
     C                   ENDIF                                                  TURN = 1
     C*
     C* CLOSE QSYSPRT FOR RESOLVING BILL TO DARTS
     C     TURN          IFEQ      1
     C*
     C     QQDART        IFEQ      'Y'
     C     XXNEWF        IFEQ      *BLANK
     C                   CLOSE     QSYSPRT
     C                   ENDIF                                                  XXNEWF IFEQ 9
     C*
     C     X2PRT         IFEQ      '1'
     C                   MOVE      XXSPOL        QQSPL#
     C                   MOVE      XXFND         QPFND
     C                   MOVE      XXEMP#        QPEMP#
     C                   MOVE      XXFYR         QPFYR
     C                   MOVE      XXDIV         QPDIV             5
     C                   MOVEL     F2FOLD        QQSFLD
     C                   MOVE      *BLANKS       QQFOLD           80
     C                   MOVE      *BLANKS       QQDCID
     C                   MOVE      'BL'          QQPRE             2
     C*
     C* IF RESOLVING NEW FORMAT BILL THEN CHANGE DOC NAME TO .PDF
     C*
     C     XXNEWF        IFEQ      'Y'
     C                   MOVE      'P'           QQRTCD
     C                   ELSE
     C                   MOVE      *BLANK        QQRTCD
     C                   ENDIF                                                  XXNEWF IFEQ
     C                   CALL      'SNXTDCID'
     C                   PARM                    QQFOLD
     C                   PARM                    QQDCID
     C                   PARM                    QQPRE
     C                   PARM                    QQCO#
     C                   PARM                    QQFND
     C                   PARM                    QQRTCD            1
     C                   PARM      '00000'       QQSUB#            5
     C                   PARM      *BLANKS       QQPFLR           80
     C*
     C     QQPFLR        IFNE      *BLANKS
     C*
     C     QQPFLR        CAT       '/':0         QQPFLR
     C*
     C     F2FOLD        IFEQ      *BLANKS
     C     QQPFLR        CAT(P)    'WCPOLS':0    QQSFLD
     C                   ELSE
     C     QQPFLR        CAT(P)    F2FOLD:0      QQSFLD
     C                   ENDIF                                                  F2FOLD IFEQ
     C*
     C                   ENDIF                                                  QQPFLR IFNE
     C*
     C* IF RESOLVING NEW FORMAT BILL THEN CHANGE DOC NAME TO .PDF
     C*
      /Free

       If isQuote and cltID = '114';
          QQspl# = 'QTE';
       Else;
          QQspl# = *Blanks;
       Endif;

      /End-Free
      *
      * Print Policyholder Disclosure Letter
      *
     C     CLTID         IFEQ      '114'
     C     CLTID         OREQ      '152'
     C     ELFND         IFNE      2
     C     ELFND         ANDNE     101
     C     isOptaComp    ANDNE     '1'
     C                   EXSR      POLHLD
     C                   ENDIF
     C                   ENDIF
     C*
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   CALL      'W7615C'
     C                   PARM                    QQSPL#            4
     C                   PARM                    QQDCID           12
     C                   PARM                    QQPOL#
     C                   PARM                    QPDIV
     C                   PARM                    QQSFLD           40
     C                   PARM                    QQFOLD
     C                   PARM                    X1HOLD
     C                   PARM                    QQHARD
     C*
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C                   EXSR      DARTS
     C*
     C                   MOVE      *BLANK        X2PRT
      *
     C* Convert to P + Policy Number
      *
     C                   If        CltId = '133' and isAgentRunOnly = *Off and
     C                             QQhard = 'Y' and
     C                             (divCombine = *Off or
     C                             (xxDivc <= 1 and ELARSM <> 'Y'))
     C                   Movel(p)  'P'           x3Splf           10
     C                   Move      xxEmp#        x3Splf
     C                   Move      *blanks       x3Hard            1
     C                   Move      *blanks       x3Save            4
     C                   Move      *blanks       x3Hold            4
     C                   Move      *blanks       x3Cpys            2
     C                   Move      *blanks       x3Dart            1
     C                   Move      *blanks       x3Fold           80
     C                   Move      *blanks       x3Dcid           12

     C                   Move      'X'           x3Dart
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************

     C                   Move      *blanks       x3Dart
      /Free
       //* Delete spool file for regular bill.
          Monitor;
             cmdString = 'DLTSPLF FILE(W7615O) SPLNBR(*LAST)';
             length = 255;
             QCMDEXC(cmdString:length);
          On-Error;
          EndMon;
          If X1Hold <> '*YES';
             //* Release spool file for renamed bill.
             Monitor;
                cmdString = 'RLSSPLF FILE(' + x3splf + ') SPLNBR(*LAST)';
                length = 255;
                QCMDEXC(cmdString:length);
             On-Error;
             EndMon;
          Endif;
      /End-Free
     C                   Endif
     C                   ENDIF                                                  X2PRT IFEQ
     C                   ENDIF                                                  QQDART EQ Y
     C                   ENDIF                                                  TURN
     C* Convert to A + Agency Number
      *
     C                   If        CltId = '133' and turn = 2 and
     C                             QQhard = 'Y' and
     C                             (divCombine = *Off or
     C                             (xxDivc <= 1 and ELARSM <> 'Y'))
     C                   Move      *Zeros        x3Splf
     C                   Movel     'A'           x3Splf
     C                   Move      xxagt#        x3Splf
     C                   Move      *blanks       x3Hard            1
     C                   Move      *blanks       x3Save            4
     C                   Move      *blanks       x3Hold            4
     C                   Move      *blanks       x3Cpys            2
     C                   Move      *blanks       x3Dart            1
     C                   Move      *blanks       x3Fold           80
     C                   Move      *blanks       x3Dcid           12

     C                   Move      'X'           x3Dart
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************

     C                   Move      *blanks       x3Dart
      /Free
       //* Delete spool file for regular bill.
          Monitor;
             cmdString = 'DLTSPLF FILE(W7615O) SPLNBR(*LAST)';
             length = 255;
             QCMDEXC(cmdString:length);
          On-Error;
          EndMon;
          If X1Hold <> '*YES';
             //* Release spool file for renamed bill.
             Monitor;
                cmdString = 'RLSSPLF FILE(' + x3splf + ') SPLNBR(*LAST)';
                length = 255;
                QCMDEXC(cmdString:length);
             On-Error;
             EndMon;
          Endif;
      /End-Free
     C                   Endif                                                  divCombine=*off
     C*
     C* Combine division bills together if report #6 has been set up.
      * Policy
     C*
     C                   If        divCombine = *on and turn = 1
     C                             and xxPrt = '1'
     C                             and (xxDivC > 1 or ELARSM = 'Y')
     C                             and xxNewf = 'Y'
     c                   If        (CltId <> '133') or
     c                             (CltId = '133' and isAgentRunOnly = *Off)
     c
     C*
     C                   Move      *on           divPrints
     C*
     C                   Movel(p)  'B'           x3Splf           10
      /Free
       If CltId = '133';
          x3Splf = 'P';
       Endif;
      /End-Free
     C                   Move      xxEmp#        x3Splf
     C                   Move      *blanks       x3Hard            1
     C                   Move      *blanks       x3Save            4
     C                   Move      *blanks       x3Hold            4
     C                   Move      *blanks       x3Cpys            2
     C                   Move      *blanks       x3Dart            1
     C                   Move      *blanks       x3Fold           80
     C                   Move      *blanks       x3Dcid           12
     C
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C*
     c                   Endif                                                  If Cltid
     C                   Endif                                                  If divCombine = *on
     C* Combine division bills together if report #6 has been set up.
      * Agent run - LUBA only
     C*
     C                   If        CltId = '133'
     C                             and divCombine = *on and turn = 2
     C                             and xxPrt = '1'
     C                             and (xxDivC > 1 or ELARSM = 'Y')
     C                             and xxNewf = 'Y'
      ** Restore next 2 lines if issue with quote
     C** Restore?                  and (xxDivC > 1 or ELARSM = 'Y' or
     C** Restore?                       isQuote = *On)
     C*
     C                   Move      *on           divPrints
     C*
     C                   Move      *Zeros        x3Splf           10
     C                   Movel     'A'           x3Splf
     C                   Move      xxagt#        x3Splf
     C                   Move      *blanks       x3Hard            1
     C                   Move      *blanks       x3Save            4
     C                   Move      *blanks       x3Hold            4
     C                   Move      *blanks       x3Cpys            2
     C                   Move      *blanks       x3Dart            1
     C                   Move      *blanks       x3Fold           80
     C                   Move      *blanks       x3Dcid           12
     C                   IF         xxEmp# <> LubaEmp#
     C                   MOVE      'X'           X3DART
     C                   MOVE      XXEMP#        LUBAEMP#
     C                   ENDIF
      *** Beg Add ***** 09/01/23 *************************************
       If isUseSpoolOut;
      *** End Add ***** 09/01/23 *************************************
     C                   Call      'W7615C3'
     C                   Parm                    x3Splf
     C                   Parm                    x3Hard
     C                   Parm                    x3Save
     C                   Parm                    x3Hold
     C                   Parm                    x3Cpys
     C                   Parm                    x3Dart
     C                   Parm                    x3Fold
     C                   Parm                    x3Dcid
      *** Beg Add ***** 09/01/23 *************************************
       Endif;
      *** End Add ***** 09/01/23 *************************************
     C                   Endif                                                  If divCombine = *on
      /Free
       //* Remove spool files if merging (do not need originals) or if no hardcopy.
               If divPrints = *on or QQHard <> 'Y' or
                  (Turn = 1 and isAgentRunOnly = *On);

               //* Delete spool file for regular bill.
                  Monitor;
                     cmdString = 'DLTSPLF FILE(W7615O) SPLNBR(*LAST)';
                     length = 255;
                     QCMDEXC(cmdString:length);
                  On-Error;
                  EndMon;

               Else;

       //* If new running new format bill, release the spool file if needed.

                         If X1Hold <> '*YES' and XXNewF = 'Y' and xxPrt = '1';

                            Monitor;
                               cmdString = 'RLSSPLF FILE(W7615O) SPLNBR(*LAST)';
                               length = 255;
                               QCMDEXC(cmdString:length);
                            On-Error;
                            EndMon;

                         Endif;
               Endif;
      /End-free
     C                   Move      *Blanks       xxPrt
     C*
      *
      *
      * Print Quote Disclosure Letter
      *
     C     CLTID         IFEQ      '114'
     C     CLTID         OREQ      '152'
     C     EMSTRP        IFEQ      'Y'
     C     ELFND         ANDNE     2
     C     ELFND         ANDNE     101
     C     isOptaComp    ANDNE     '1'
     C                   EXSR      QTELTR
     C                   ENDIF
     C                   ENDIF
      *
      //*** Beg Chg ***** 09/01/23 *************************************
     C***                SELECT
     C***  CLTID         WHENEQ    '102'
     C***                EXSR      EXTRAS
     C***  EXOBFL        WHENEQ    'Y'
     C***  *IN63         ANDEQ     *ON                                          ORIGBILL
     C***  *IN38         ANDEQ     *OFF                                         NOTQUOTE
     C***  QQCALL        ANDEQ     '4'                                          CALC,UPDT,PRINT
     C***  TURN          ANDEQ     1                                            EMPRUN
     C***  QQHARD        ANDEQ     'Y'                                          HARDCOPY
     C***                EXSR      W7321C
     C***  EXRBFL        WHENEQ    'Y'
     C***  *IN63         ANDEQ     *OFF                                         ORIGBILL
     C***  *IN38         ANDEQ     *OFF                                         NOTQUOTE
     C***  TURN          ANDEQ     1                                            EMPRUN
     C***  QQHARD        ANDEQ     'Y'                                          HARDCOPY
     C***                EXSR      W7321C
     C***                ENDSL
      //
       Select;
       When CLTID = '102';
          Exsr EXTRAS;
       When isUseXML = *On;
         //*** Beg Add ***** 10/24/24 *****************************
         If isPortal = *Off;
         //*** End Add ***** 10/24/24 *****************************
          Select;
          When isUseXML = *On and BDPrmNQ = 'Y'         //Premium Notice when Scriptura for Quote
           and *In63 = *On and *In38 = *On
         //*** begin chg ***  10/24/25  **************************************
         //*****  and Turn = 1 and QQHard = 'Y' and flgPyrlExist = 'Y';
           and Turn = 1 and QQHard = 'Y' and (flgPyrlExist = 'Y' or
           (EMStrp = 'Y' and ELArsm = 'Y'));
         //*** end chg *****  10/24/25  **************************************
             Exsr W7321C;
          When isUseXML = *On and BDPrmNE = 'Y'         //Premium Notice when Scriptura for Est Bill
           and *In63 = *On and *In38 = *Off
         //*** begin chg ***  10/24/25  **************************************
         //*****  and Turn = 1 and QQHard = 'Y' and flgPyrlExist = 'Y';
           and Turn = 1 and QQHard = 'Y' and (flgPyrlExist = 'Y' or
           (EMStrp = 'Y' and ELArsm = 'Y'));
         //*** end chg *****  10/24/25  **************************************
             Exsr W7321C;
          When isUseXML = *On and BDPrmNR = 'Y'         //Premium Notice when Scriptura for Rev Bill
           and *In63 = *Off and *In38 = *Off
         //*** begin chg ***  10/24/25  **************************************
         //*****  and Turn = 1 and QQHard = 'Y' and flgPyrlExist = 'Y';
           and Turn = 1 and QQHard = 'Y' and (flgPyrlExist = 'Y' or
           (EMStrp = 'Y' and ELArsm = 'Y'));
         //*** end chg *****  10/24/25  **************************************
             Exsr W7321C;
          Endsl;
         //*** Beg Add ***** 10/24/24 *****************************
         Endif;
         //*** End Add ***** 10/24/24 *****************************
       When EXOBFL = 'Y'                             //Premium Notice with Original Bill
        and *IN63 = *On  and *IN38 = *Off
        and QQCALL = '4'
        and TURN = 1  and QQHARD = 'Y';
          Exsr W7321C;
       When EXRBFL = 'Y'                             //Premium Notice with Revised Bill
        and *IN63 = *Off  and *IN38 = *Off
        and TURN = 1 and QQHARD = 'Y';
          Exsr W7321C;
       Endsl;
       If (ldEndA = *Zeros or ldEndA = *Blank);
          If xxEmail = 'Y' and keyEmail <> *blank;
             strEmailD = keyEmail;
             Setll strEmailD xp105;
             Reade strEmailD xp105;
             Dow not %Eof(xmlprel5);
                //*** Begin Chg *** 05/07/24 **********************************
                //***If strXPFileComb <> *Blank and strXPDirComb <> *Blank;
                //***   XPEmailD = strXPDirComb;
                //***   XPEmailF = strXPFileComb;
                //***Else;
                //***   XPEmailD = strXPDir;
                //***   XPEmailF = strXPFile;
                //***Endif;
                Select;
                When strXPFileComb <> *Blank and strXPDirComb <> *Blank;
                   XPEmailD = strXPDirComb;
                   XPEmailF = strXPFileComb;
                When strXPFileSRD <> *Blank and strXPDirSRD <> *Blank And
                     isSummary;
                   XPEmailD = strXPDirSRD;
                   XPEmailF = strXPFileSRD;
                Other;
                   XPEmailD = strXPDir;
                   XPEmailF = strXPFile;
                EndSl;
                //*** End   Chg *** 05/07/24 **********************************
                Update xp105;
                Reade strEmailD xp105;
             Enddo;
          Endif;
       Endif;
      //*** End Chg ***** 09/01/23 *************************************
     C*
     C*  UPDATE BILLING RECORD WITH THE STEP COMPLETED.
     C*
     C     SVEMP#        IFEQ      *ZERO
     C*
     C     BLKEY2        CHAIN     PBL01                              60
     C     *IN60         IFEQ      *OFF
     C*
     C     TURN          IFEQ      1
     C     QQAGTO        ANDEQ     'Y'
     C                   MOVE      '1'           BLSTEP
     C                   ELSE
     C                   MOVE      '2'           BLSTEP
     C                   ENDIF                                                  TURN EQ 1
     C*
     C                   UPDATE    PBL01
     C                   ENDIF                                                  *IN60 == 0
     C                   ENDIF                                                  SVEMP# EQ 0
     C*
     C     ENDA          TAG
     C*
     C  N59EMKEY1        READE     PEM01                                  60
     C   59EMKEY         READE     PEM01                                  60
     C*
     C                   ENDDO                                                  *IN60 DOWEQ
      //************************************************************************************
      // End of reading all the divisions Employer master loop.
      // Next section starts here to print Summary Bill
      //************************************************************************************
     C*
     C* PRINT SUMMARY FOR POLICY IF APPLICABLE
     C*
     C     XXSUM         IFEQ      'Y'
     C     *IN59         ANDEQ     *OFF
     C                   MOVE      *BLANK        XXSUM             1
     C*
     C                   Z-ADD     XSDIV         XXDIV
     C     EMKEY         CHAIN     PEM01                              60
     C*
     C* REBUILD ADDRESS FOR SUMMARY
     C*
     C                   MOVEL     SXPOL#        QQPOL#
     C                   MOVEL     SXFROM        XXFROM
     C                   MOVEL     SXTO          XXTO
     C                   MOVEL     SXANNV        XXANNV
     C                   MOVE      SXIN87        *IN87
     C                   MOVEL     SXEMN1        EMN(1)
     C                   MOVEL     SXEMN2        EMN(2)
     C                   MOVEL     SXEMN3        EMN(3)
     C                   MOVEL     SXEMN4        EMN(4)
     C                   MOVEL     SXEMN5        EMN(5)
     C                   MOVEL     SXAGT#        AHAGT#
     C                   MOVEL     SXNAME        ANAME
     C                   MOVEL     SXADD1        AADD1
     C                   MOVEL     SXACSZ        ACSZ
     C                   MOVE      SXIN69        *IN69
     C                   MOVEL     SXARE1        AGARE1
     C                   MOVEL     SXPHN1        AGPHN1
     C                   MOVE      *ON           *IN58
     C*
     C*
     C* BUILD AN ARRAY OF HEADINGS TO USE FOR THE ASSESSMENTS.
     C*
     C                   CLEAR                   ASS
     C                   CLEAR                   ASH
     C                   CLEAR                   ASP
     C*
     C     ELKY2         CHAIN     PEL02                              60
     C     *IN60         DOWEQ     *OFF
     C*
     C     RSKY          CHAIN     PRS01                              60
     C     *IN60         IFEQ      *OFF
     C                   MOVE      RSJRST        XXST
     C                   ELSE
     C                   MOVE      *BLANKS       XXST
     C                   ENDIF
      /Free

        index = %lookup(xxSt:PolSts);
        If index = 0;
           index = %lookup('  ':Polsts);
           PolSts(index) = xxSt;
        Endif;

      /End-Free
     C*
     C                   Z-ADD     RDAT(1)       XXEFDT
     C     XXST          IFEQ      'NJ'
     C                   Z-ADD     ELPFDT        XXEFDT
     C                   If        xspfdt <> 0
     C                   Z-ADD     xsPFDT        XXEFDT
     C                   Endif
     C                   ENDIF
     C*
     C     RRKY          SETGT     PRR01
     C     RRKY2         READPE    PRR01                                  60
     C*
     C* 1ST ASSESSMENT HEADING.
     C*
     C     RR1STH        IFNE      *BLANKS
     C     ASS(1)        IFEQ      *BLANKS
     C                   MOVE      XXST          ASS(1)
     C                   MOVEL     RR1STH        ASH(1)
     C                   Z-ADD     RR1STP        ASP(1)
     C                   ELSE
     C     XXST          IFNE      ASS(1)
     C                   MOVE      *BLANKS       ASH(1)
     C                   Z-ADD     0             ASP(1)
     C                   ENDIF
     C                   ENDIF
     C                   ENDIF                                                  RR1STH IFNE
     C*
     C* 2ND ASSESSMENT HEADING.
     C*
     C     RR2NDH        IFNE      *BLANKS
     C     ASS(2)        IFEQ      *BLANKS
     C                   MOVE      XXST          ASS(2)
     C                   MOVEL     RR2NDH        ASH(2)
     C                   Z-ADD     RR2NDP        ASP(2)
     C                   ELSE
     C     XXST          IFNE      ASS(2)
     C                   MOVE      *BLANKS       ASH(2)
     C                   Z-ADD     0             ASP(2)
     C                   ENDIF
     C                   ENDIF
     C                   ENDIF                                                  RR2NDH IFNE
     C*
     C* 3RD ASSESSMENT HEADING.
     C*
     C     RR3RDH        IFNE      *BLANKS
     C     ASS(3)        IFEQ      *BLANKS
     C                   MOVE      XXST          ASS(3)
     C                   MOVEL     RR3RDH        ASH(3)
     C                   Z-ADD     RR3RDP        ASP(3)
     C                   ELSE
     C     XXST          IFNE      ASS(3)
     C                   MOVE      *BLANKS       ASH(3)
     C                   Z-ADD     0             ASP(3)
     C                   ENDIF
     C                   ENDIF
     C                   ENDIF                                                  RR3RDH IFNE
     C*
     C* 4TH ASSESSMENT HEADING.
     C*
     C     RR4THH        IFNE      *BLANKS
     C     ASS(4)        IFEQ      *BLANKS
     C                   MOVE      XXST          ASS(4)
     C                   MOVEL     RR4THH        ASH(4)
     C                   Z-ADD     RR4THP        ASP(4)
