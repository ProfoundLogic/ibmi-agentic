     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK4(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK4           XXCOMP
     C     XXCOMP        IFNE      XN4THB
     C     XN4THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK4(1)
     C                   ENDIF
     C     XN5THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK5(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK5           XXCOMP
     C     XXCOMP        IFNE      XN5THB
     C     XN5THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK5(1)
     C                   ENDIF
     C     XN6THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK6(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK6           XXCOMP
     C     XXCOMP        IFNE      XN6THB
     C     XN6THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK6(1)
     C                   ENDIF
     C*
     C     XN7THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK7(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK7           XXCOMP
     C     XXCOMP        IFNE      XN7THB
     C     XN7THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK7(1)
     C                   ENDIF
     C*
     C* BILL EACH INSTALLMENT INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     0             Y
     C                   Z-ADD     0             ZZ                3 0
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXYMD
     C                   ADD       WKA(U)        XXAMT2
     C                   ADD       WKT(U)        XXAMT2
     C                   ADD       WK1(U)        XXAMT2
     C                   ADD       WK2(U)        XXAMT2
     C                   ADD       WK3(U)        XXAMT2
     C                   ADD       WK4(U)        XXAMT2
     C                   ADD       WK5(U)        XXAMT2
     C                   ADD       WK6(U)        XXAMT2
     C                   ADD       WK7(U)        XXAMT2
     C                   ELSE
     C*
     C     Y             IFLT      2
     C*
     C                   ADD       1             Y
     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
     C*
     C     Y             IFEQ      1
     C     WKA(U)        ADD       WKT(U)        AMT(1)
     C                   ADD       XXAMT2        AMT(1)
     C                   ADD       WK1(U)        AMT(1)
     C                   ADD       WK2(U)        AMT(1)
     C                   ADD       WK3(U)        AMT(1)
     C                   ADD       WK4(U)        AMT(1)
     C                   ADD       WK5(U)        AMT(1)
     C                   ADD       WK6(U)        AMT(1)
     C                   ADD       WK7(U)        AMT(1)
     C*
     C                   Z-ADD     WKD(U)        XXPFDT
     C                   Z-ADD     WKD(U)        XXYMD
     C                   EXSR      SRDUEW
     C                   ELSE
     C                   MOVE      '.'           DUW(3)
     C     WKA(U)        ADD       WKT(U)        AMT(3)
     C                   ADD       IFIFEE        AMT(3)
     C*
     C                   ADD       WK1(U)        AMT(3)
     C                   ADD       WK2(U)        AMT(3)
     C                   ADD       WK3(U)        AMT(3)
     C                   ADD       WK4(U)        AMT(3)
     C                   ADD       WK5(U)        AMT(3)
     C                   ADD       WK6(U)        AMT(3)
     C                   ADD       WK7(U)        AMT(3)
     C*
     C                   ADD       IFIFEE        X1INST
     C                   ENDIF
     C*
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   ENDIF
     C*
     C                   ELSE
     C                   ADD       1             ZZ
     C                   ENDIF                                                  Y IFLT 2
     C*
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C     ZZ            MULT      X1INST        XXINST
     C     XXINST        IFNE      *ZERO
     C                   MOVE      *ON           *IN67
     C                   ELSE
     C                   MOVE      *OFF          *IN67
     C                   ENDIF
     C                   ADD       XXINST        XXBAL
     C                   ELSE                                                   BSFREQ IFEQ
     C*
     C*  PROCESS WEEKLY BILLING SCHEDULE CODES.
     C*
     C                   MOVEL(P)  WEEKVB        INSTVB
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C                   Z-ADD     0             WKT
     C                   Z-ADD     0             WK1
     C                   Z-ADD     0             WK2
     C                   Z-ADD     0             WK3
     C                   Z-ADD     0             WK4
     C                   Z-ADD     0             WK5
     C                   Z-ADD     0             WK6
     C                   Z-ADD     0             WK7
     C*
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         SRDTE
     C                   MOVE      *BLANK        SRSDAY
     C                   MOVE      *BLANK        SRLDAY
     C                   MOVE      *BLANK        SRERR
     C                   CALL      'SRDAY8'
     C                   PARM                    SRDTE             8 0          M/D/YY
     C                   PARM                    SRSDAY            4            Abbreviation
     C                   PARM                    SRLDAY            9            Full Day Name
     C                   PARM                    SRERR                          Error Flag
     C*
     C                   MOVEL     SRSDAY        XXDAY             2
     C                   Z-ADD     0             XXCNT             3 0
     C*
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER BILLING START DATE.
     C*
     C     XXDAY         IFEQ      BSDOWK
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C                   Z-ADD     0             X1                3 0
     C                   Z-ADD     0             X2                3 0
     C                   Z-ADD     1             T                 3 0
     C*
     C     XXDAY         LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X1
     C                   ENDIF                                                  *IN60
     C*
     C     BSDOWK        LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X2
     C                   ENDIF                                                  *IN60
     C*
     C     X2            SUB       X1            XXCNT
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      XXCNT         QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(1)
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXDAY IFEQ
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ENDIF                                                  WKD,1 IFGE
     C*
     C                   Z-ADD     1             T                 3 0
     C                   ADD       7             XXCNT
     C*
     C* BUILD DATE ARRAY WITH EACH WEEKLY INSTALLMENT DATE.
     C*
     C     ELARSM        IFEQ      'Y'
     C                   Z-ADD     SRPDAY        X1DAYS            5 0
     C                   ELSE
     C                   Z-ADD     PDAYS         X1DAYS
     C                   ENDIF
      *
     C     XXCNT         DOWLT     X1DAYS
     C*
     C                   ADD       1             T
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      7             QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(T)
     C                   ENDIF
     C*
     C                   ADD       7             XXCNT
     C                   ENDDO                                                  XXCNT IFLT
     C*
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C*
     C     XXPRO         DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKA(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKA           XXCOMP
     C     XXCOMP        IFNE      XXPRO
     C     XXPRO         SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKA(1)
     C                   ENDIF
     C*
     C* WEEKLY STATE TAX
     C*
     C     XXTXDU        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKT(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKT           XXCOMP
     C     XXCOMP        IFNE      XXTXDU
     C     XXTXDU        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKT(1)
     C                   ENDIF
     C     XN1STB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK1(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK1           XXCOMP
     C     XXCOMP        IFNE      XN1STB
     C     XN1STB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK1(1)
     C                   ENDIF
     C     XN2NDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK2(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK2           XXCOMP
     C     XXCOMP        IFNE      XN2NDB
     C     XN2NDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK2(1)
     C                   ENDIF
     C     XN3RDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK3(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK3           XXCOMP
     C     XXCOMP        IFNE      XN3RDB
     C     XN3RDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK3(1)
     C                   ENDIF
     C     XN4THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK4(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK4           XXCOMP
     C     XXCOMP        IFNE      XN4THB
     C     XN4THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK4(1)
     C                   ENDIF
     C     XN5THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK5(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK5           XXCOMP
     C     XXCOMP        IFNE      XN5THB
     C     XN5THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK5(1)
     C                   ENDIF
     C     XN6THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK6(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK6           XXCOMP
     C     XXCOMP        IFNE      XN6THB
     C     XN6THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK6(1)
     C                   ENDIF
     C*
     C     XN7THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK7(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK7           XXCOMP
     C     XXCOMP        IFNE      XN7THB
     C     XN7THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK7(1)
     C                   ENDIF
     C*
     C* BILL WEEKLY INSTALLMENTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     0             Y
     C                   Z-ADD     0             ZZ                3 0
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXYMD
     C                   ADD       WKA(U)        XXAMT2
     C                   ADD       WKT(U)        XXAMT2
     C                   ADD       WK1(U)        XXAMT2
     C                   ADD       WK2(U)        XXAMT2
     C                   ADD       WK3(U)        XXAMT2
     C                   ADD       WK4(U)        XXAMT2
     C                   ADD       WK5(U)        XXAMT2
     C                   ADD       WK6(U)        XXAMT2
     C                   ADD       WK7(U)        XXAMT2
     C                   ELSE
     C*
     C     Y             IFLT      2
     C*
     C                   ADD       1             Y
     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
     C*
     C     Y             IFEQ      1
     C     WKA(U)        ADD       WKT(U)        AMT(1)
     C                   ADD       XXAMT2        AMT(1)
     C*
     C                   ADD       WK1(U)        AMT(1)
     C                   ADD       WK2(U)        AMT(1)
     C                   ADD       WK3(U)        AMT(1)
     C                   ADD       WK4(U)        AMT(1)
     C                   ADD       WK5(U)        AMT(1)
     C                   ADD       WK6(U)        AMT(1)
     C                   ADD       WK7(U)        AMT(1)
     C*
     C                   Z-ADD     WKD(U)        XXPFDT
     C                   Z-ADD     WKD(U)        XXYMD
     C                   EXSR      SRDUEW
     C                   ELSE
     C                   MOVE      '.'           DUW(3)
     C     WKA(U)        ADD       WKT(U)        AMT(3)
     C                   ADD       IFIFEE        AMT(3)
     C*
     C                   ADD       WK1(U)        AMT(3)
     C                   ADD       WK2(U)        AMT(3)
     C                   ADD       WK3(U)        AMT(3)
     C                   ADD       WK4(U)        AMT(3)
     C                   ADD       WK5(U)        AMT(3)
     C                   ADD       WK6(U)        AMT(3)
     C                   ADD       WK7(U)        AMT(3)
     C*
     C                   ADD       IFIFEE        X1INST
     C                   ENDIF
     C*
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   ENDIF
     C*
     C                   ELSE
     C                   ADD       1             ZZ
     C                   ENDIF                                                  Y IFLT 2
     C*
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C     ZZ            MULT      X1INST        XXINST
     C     XXINST        IFNE      *ZERO
     C                   MOVE      *ON           *IN67
     C                   ELSE
     C                   MOVE      *OFF          *IN67
     C                   ENDIF
     C                   ADD       XXINST        XXBAL
     C                   ENDIF                                                  BSFREQ IFEQ
     C                   ENDIF                                                  BSDOWK IFEQ
     C*
     C*
     C                   ADD       XXDEPA        AMT(1)
     C                   ADD       XXEXCN        AMT(1)
     C                   ADD       XXMFDU        AMT(1)                         ADD MEMBER FEES
     C                   ADD       XXSFDU        AMT(1)                         ADD SAFETY FEES
     C                   ADD       XT1STB        AMT(1)
     C                   ADD       XT2NDB        AMT(1)
     C                   ADD       XT3RDB        AMT(1)
     C                   ADD       XT4THB        AMT(1)
     C                   ADD       XT5THB        AMT(1)
     C                   ADD       XT6THB        AMT(1)
     C                   ADD       XT7THB        AMT(1)
      *** Beg Add *****  06/24/24  *******************************************
     C                   ADD       XXCOLB        AMT(1)
     C                   SUB       XXCOLP        AMT(1)
      *** End Add *****  06/24/24  *******************************************
     C*
     C                   END
      /free
       If CltId = '111';
          xxPro = xxPro + xxDvnd;
       Endif;
      /end-free
     C*
     C                   ELSE
     C*
     C*   CALCULATIONS FOR REVISED BILLING
     C*
     C*   FILL DATE ARRAY USED TO CALCULATE BALANCE DUE.
     C*
     C                   Z-ADD     1             L                 2 0
     C                   Z-ADD     1             I                 2 0
     C     EAKY2         CHAIN     PEA01                              60
     C                   MOVE      *BLANK        DDU
     C                   MOVE      *BLANK        AMT
     C                   MOVE      *BLANK        DUW
     C                   MOVE      *BLANK        BSD
     C                   Z-ADD     0             XXDUE
     C*
     C*  PROCESS NON-WEEKLY BILLING SCHEDULE CODES.
     C*
     C     BSDOWK        IFEQ      *BLANKS
     C     BSFREQ        ANDNE     'T'
     C*
     C     I             DOUEQ     13
     C*
     C     BSA(I)        IFNE      0
     C     YYMM          ANDGE     YYMM2
     C     YYMM          OREQ      YYMM2
     C                   MOVEL     YY            XXBDTE            7
     C                   MOVEL     MM            XXTEMP            4
     C     L             IFEQ      1
     C     YYMM          ANDEQ     YYMM2
     C                   MOVE      DD2           XXTEMP
     C                   ELSE
     C     ELBLFL        IFEQ      'Y'
     C                   MOVE      XXBDAY        XXTEMP
     C                   ELSE
     C                   MOVE      '01'          XXTEMP
     C                   ENDIF                                                  ELBLFL EQ 'Y'
     C                   END
     C                   MOVE      XXTEMP        XXBDTE
     C                   MOVE(P)   XXBDTE        XXVDTE            7 0
     C*
     C     SRERR         DOUEQ     '0'
     C                   Z-ADD     XXVDTE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C*
     C     SRERR         IFEQ      '1'
     C                   SUB       1             XXVDTE
     C                   ENDIF
     C*
     C                   MOVE(P)   XXVDTE        XXBDTE
     C*
     C                   ENDDO
     C                   MOVE      XXBDTE        BSD(L)
     C                   ADD       1             L
     C                   END
     C*
     C     MM            IFEQ      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ELSE
     C                   ADD       1             MM
     C                   END
     C*
     C                   ADD       1             I
     C                   END
     C*
     C     L             IFEQ      1
     C                   Z-ADD     XXYMD         XXPFDT
     C                   MOVEL     YY            XXBDTE
     C                   MOVEL     MM            XXTEMP
     C     YYMM          IFEQ      YYMM2
     C                   MOVE      DD2           XXTEMP
     C                   ELSE
     C     ELBLFL        IFEQ      'Y'
     C                   MOVE      XXBDAY        XXTEMP
     C                   ELSE
     C                   MOVE      '01'          XXTEMP
     C                   ENDIF                                                  ELBLFL EQ 'Y'
     C                   END
     C                   MOVE      XXTEMP        XXBDTE
     C                   MOVE(P)   XXBDTE        XXVDTE            7 0
     C*
     C     SRERR         DOUEQ     '0'
     C                   Z-ADD     XXVDTE        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C*
     C     SRERR         IFEQ      '1'
     C                   SUB       1             XXVDTE
     C                   ENDIF
     C*
     C                   MOVE(P)   XXVDTE        XXBDTE
     C*
     C                   ENDDO
     C                   MOVE      XXBDTE        BSD(L)
     C                   ADD       1             L
     C                   END
     C*
     C                   MOVE      ELPTDT        BSD(L)
     C     BSD(L)        IFLT      BSD(1)
     C                   Z-ADD     BSD(1)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY
     C                   MOVEL     SRDTO         XXDT              6 0
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      XXDT          QQDT              8 0
     C                   PARM      1             QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         BSD(L)
     C                   ENDIF
     C*
     C                   ENDIF                                                  BSD,L IFLT
     C*
     C*  GET THE BALANCE DUE AND FILL PRINT ARRAYS
     C*
     C                   Z-ADD     1             L
     C                   Z-ADD     1             A
     C                   Z-ADD     2             B                 2 0
     C     EAKY2         CHAIN     PEA02                              60
