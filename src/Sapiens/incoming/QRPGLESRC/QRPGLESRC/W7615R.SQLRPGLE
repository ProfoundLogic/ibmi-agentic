      *
      * Sub Retro payments from monthly billings
      *
     c                   if        cltid = '071'

     c                   eval      in# = x - 1
     c                   eval      thisMonth = ELPFDT
     c                   move      '01'          thisMonth
     c     *cymd         move      thisMonth     workdate1
     c     workDate1     adddur    in#:*months   workDate1
     c     *cymd         move      workDate1     thisMonth
     c     workDate1     adddur    1:*months     workDate2
     c     *cymd         move      workDate2     nextMonth

     c                   if        @blarq <> 0
     c     eakyd         setll     pea0d
     c     eakyd         reade     pea0d
     c                   dow       not(%eof) and
     c                             EAPODT >= thisMonth and
     c                             EAPODT <  nextMonth
     c                   sub       EAAMT         xxamt2
     c     eakyd         reade     pea0d
     c                   enddo                                                  *in60 doweq *off
     c                   endif                                                  blarq# ifne 0

     c                   move      'P'           xxtype
     c     eakey1        setll     pea01
     c     eakey         reade     pea01
     c                   dow       not(%eof) and EAPODT < nextMonth
     c     EAARCD        ifeq      F1RCCD
     c                   sub       EAAMT         xxamt2
     c                   endif
     c     eakey         reade     pea01
     c                   enddo

     c                   endif

     C     YYMM          IFGE      YYMM2
     C     BSA(X)        ANDNE     *ZERO
     C     YYMM          OREQ      YYMM2
     C                   Z-ADD     XXAMT2        AMT(L)
     C                   MOVE      'Due'         DUW(L)
     C                   EXSR      SRDUE
     C                   ADD       1             L
     C                   Z-ADD     *ZEROS        XXAMT2
     C                   END
     C                   ADD       1             X
     C                   ADD       1             MM
     C                   END
     C*
     C     L             IFEQ      1
     C                   Z-ADD     XXYMD         XXPFDT
     C                   Z-ADD     XXAMT2        AMT(L)
     C                   MOVE      'Due'         DUW(L)
     C                   EXSR      SRDUE
     C                   END
     C*
     C                   XFOOT     AMT           XXCOMP           11 2
     c                   eval      xxcomp = xxcomp + xxrctl
     C     XXPRO         ADD       ELTXDU        XXPRO1           11 2
     C     RR1STB        IFEQ      'Y'
     C                   ADD       XX1STB        XXPRO1
     C                   ENDIF
     C     RR2NDB        IFEQ      'Y'
     C                   ADD       XX2NDB        XXPRO1
     C                   ENDIF
     C     RR3RDB        IFEQ      'Y'
     C                   ADD       XX3RDB        XXPRO1
     C                   ENDIF
     C     RR4THB        IFEQ      'Y'
     C                   ADD       XX4THB        XXPRO1
     C                   ENDIF
     C     RR5THB        IFEQ      'Y'
     C                   ADD       XX5THB        XXPRO1
     C                   ENDIF
     C     RR6THB        IFEQ      'Y'
     C                   ADD       XX6THB        XXPRO1
     C                   ENDIF
     C     RR7THB        IFEQ      'Y'
     C                   ADD       XX7THB        XXPRO1
     C                   ENDIF
     C     XXCOMP        IFNE      XXPRO1
     C     XXPRO1        SUB       XXCOMP        XXDIFR           11 2
     C                   Z-ADD     1             X
     C                   MOVE      '0'           *IN60
     C     X             DOWLE     12
     C     *IN60         ANDEQ     '0'
     C*
     C     AMT(X)        IFNE      0
     C                   ADD       XXDIFR        AMT(X)
     C                   MOVE      '1'           *IN60
     C                   END
     C*
     C                   ADD       1             X
     C                   END
     C  N60              ADD       XXDIFR        AMT(1)
     C                   END
     C                   ELSE                                                   BSDOWK IFEQ
     C     BSFREQ        IFEQ      'T'
     C*
     C*  PROCESS TWICE A MONTH BILLING SCHEDULE CODES.
     C*
     C                   MOVEL(P)  TWICVB        INSTVB
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C                   Z-ADD     0             WKT
     C                   Z-ADD     0             WK1
     C                   Z-ADD     0             WK2
     C                   Z-ADD     0             WK3
     C                   Z-ADD     0             WK4
     C                   Z-ADD     0             WK5
     C                   Z-ADD     0             WK6
     C                   Z-ADD     0             WK7
     C*
     C                   Z-ADD     ELBSDT        XXPFDT
     C*
     C* CHECK FOR FIRST INSTALLMENT ON/AFTER BILLING START DATE.
     C*
     C     DD            IFEQ      1
     C     DD            OREQ      15
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C     DD            IFLT      15
     C                   Z-ADD     15            DD
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ELSE
     C*
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   Z-ADD     XXPFDT        WKD(1)
     C                   ENDIF                                                  DD IFLT
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C                   Z-ADD     1             T                 3 0
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C* BUILD DATE ARRAY WITH EACH INSTALLMENT DATE.
     C*
     C     XXPFDT        DOWLT     ELPTDT
     C*
     C     DD            IFEQ      1
     C                   Z-ADD     15            DD
     C                   ELSE
     C*
     C                   Z-ADD     1             DD
     C                   ADD       1             MM
     C     MM            IFEQ      13
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ENDIF
     C*
     C                   ENDIF                                                  DD IFEQ
     C*
     C     XXPFDT        IFLT      ELPTDT
     C                   ADD       1             T
     C                   Z-ADD     XXPFDT        WKD(T)
     C                   ENDIF                                                  XXPFDT IFLT
     C*
     C                   ENDDO                                                  XXPFDT DOWLT
     C*
     C                   ENDIF                                                  WKD,1 IFGE
     C*
     C* CALCULATE EACH INSTALLMENT AMOUNT.
     C*
     C     XXPRO         DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKA(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKA           XXCOMP
     C     XXCOMP        IFNE      XXPRO
     C     XXPRO         SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKA(1)
     C                   ENDIF
     C*
     C* STATE TAX
     C*
     C     ELTXDU        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKT(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKT           XXCOMP
     C     XXCOMP        IFNE      ELTXDU
     C     ELTXDU        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKT(1)
     C                   ENDIF
     C*
     C*
     C     RR1STB        IFEQ      'Y'
     C     XX1STB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK1(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK1           XXCOMP
     C     XXCOMP        IFNE      XX1STB
     C     XX1STB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK1(1)
     C                   ENDIF
     C                   ENDIF                                                  RR1STB IFEQ
     C*
     C     RR2NDB        IFEQ      'Y'
     C     XX2NDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK2(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK2           XXCOMP
     C     XXCOMP        IFNE      XX2NDB
     C     XX2NDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK2(1)
     C                   ENDIF
     C                   ENDIF                                                  RR2NDB IFEQ
     C*
     C     RR3RDB        IFEQ      'Y'
     C     XX3RDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK3(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK3           XXCOMP
     C     XXCOMP        IFNE      XX3RDB
     C     XX3RDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK3(1)
     C                   ENDIF
     C                   ENDIF                                                  RR3RDB IFEQ
     C     RR4THB        IFEQ      'Y'
     C     XX4THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK4(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK4           XXCOMP
     C     XXCOMP        IFNE      XX4THB
     C     XX4THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK4(1)
     C                   ENDIF
     C                   ENDIF                                                  RR4THB IFEQ
     C*
     C     RR5THB        IFEQ      'Y'
     C     XX5THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK5(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK5           XXCOMP
     C     XXCOMP        IFNE      XX5THB
     C     XX5THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK5(1)
     C                   ENDIF
     C                   ENDIF                                                  RR5THB IFEQ
     C     RR6THB        IFEQ      'Y'
     C     XX6THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK6(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK6           XXCOMP
     C     XXCOMP        IFNE      XX6THB
     C     XX6THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK6(1)
     C                   ENDIF
     C                   ENDIF                                                  RR6THB IFEQ
     C*
     C     RR7THB        IFEQ      'Y'
     C     XX7THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK7(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK7           XXCOMP
     C     XXCOMP        IFNE      XX7THB
     C     XX7THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK7(1)
     C                   ENDIF
     C                   ENDIF                                                  RR7THB IFEQ
     C* BILL EACH INSTALLMENT INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     0             Y
     C                   Z-ADD     0             ZZ                3 0
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXYMD
     C                   ADD       WKA(U)        XXAMT2
     C                   ADD       WKT(U)        XXAMT2
     C                   ADD       WK1(U)        XXAMT2
     C                   ADD       WK2(U)        XXAMT2
     C                   ADD       WK3(U)        XXAMT2
     C                   ADD       WK4(U)        XXAMT2
     C                   ADD       WK5(U)        XXAMT2
     C                   ADD       WK6(U)        XXAMT2
     C                   ADD       WK7(U)        XXAMT2
     C                   ELSE
     C*
     C     Y             IFLT      2
     C*
     C                   ADD       1             Y
     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
     C*
     C     Y             IFEQ      1
     C     WKA(U)        ADD       WKT(U)        AMT(1)
     C                   ADD       XXAMT2        AMT(1)
     C                   ADD       WK1(U)        AMT(1)
     C                   ADD       WK2(U)        AMT(1)
     C                   ADD       WK3(U)        AMT(1)
     C                   ADD       WK4(U)        AMT(1)
     C                   ADD       WK5(U)        AMT(1)
     C                   ADD       WK6(U)        AMT(1)
     C                   ADD       WK7(U)        AMT(1)
     C                   Z-ADD     WKD(U)        XXPFDT
     C                   Z-ADD     WKD(U)        XXYMD
     C                   EXSR      SRDUEW
     C                   ELSE
     C                   MOVE      '.'           DUW(3)
     C     WKA(U)        ADD       WKT(U)        AMT(3)
     C                   ADD       IFIFEE        AMT(3)
     C*
     C                   ADD       WK1(U)        AMT(3)
     C                   ADD       WK2(U)        AMT(3)
     C                   ADD       WK3(U)        AMT(3)
     C                   ADD       WK4(U)        AMT(3)
     C                   ADD       WK5(U)        AMT(3)
     C                   ADD       WK6(U)        AMT(3)
     C                   ADD       WK7(U)        AMT(3)
     C*
     C                   ENDIF
     C*
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   ENDIF
     C*
     C                   ELSE
     C                   ADD       1             ZZ
     C                   ENDIF                                                  Y IFLT 2
     C*
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C                   ELSE                                                   BSFREQ IFEQ
     C*
     C*  PROCESS WEEKLY BILLING SCHEDULE CODES.
     C*
     C                   MOVEL(P)  WEEKVB        INSTVB
     C                   Z-ADD     0             WKD
     C                   Z-ADD     0             WKA
     C                   Z-ADD     0             WKT
     C                   Z-ADD     0             WK1
     C                   Z-ADD     0             WK2
     C                   Z-ADD     0             WK3
     C                   Z-ADD     0             WK4
     C                   Z-ADD     0             WK5
     C                   Z-ADD     0             WK6
     C                   Z-ADD     0             WK7
     C*
     C                   Z-ADD     ELBSDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         SRDTE
     C                   MOVE      *BLANK        SRSDAY
     C                   MOVE      *BLANK        SRLDAY
     C                   MOVE      *BLANK        SRERR
     C                   CALL      'SRDAY8'
     C                   PARM                    SRDTE             8 0          M/D/YY
     C                   PARM                    SRSDAY            4            Abbreviation
     C                   PARM                    SRLDAY            9            Full Day Name
     C                   PARM                    SRERR                          Error Flag
     C*
     C                   MOVEL     SRSDAY        XXDAY             2
     C                   Z-ADD     0             XXCNT             3 0
     C*
     C* CHECK FOR FIRST DAY OF WEEK ON/AFTER BILLING START DATE.
     C*
     C     XXDAY         IFEQ      BSDOWK
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ELSE
     C*
     C                   Z-ADD     0             X1                3 0
     C                   Z-ADD     0             X2                3 0
     C                   Z-ADD     1             T                 3 0
     C*
     C     XXDAY         LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X1
     C                   ENDIF                                                  *IN60
     C*
     C     BSDOWK        LOOKUP    DAY(T)                                 60
     C     *IN60         IFEQ      '1'
     C                   Z-ADD     T             X2
     C                   ENDIF                                                  *IN60
     C*
     C     X2            SUB       X1            XXCNT
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      XXCNT         QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(1)
     C                   ENDIF
     C*
     C                   ENDIF                                                  XXDAY IFEQ
     C*
     C     WKD(1)        IFGE      ELPTDT
     C                   Z-ADD     ELBSDT        WKD(1)
     C                   ENDIF                                                  WKD,1 IFGE
     C*
     C                   Z-ADD     1             T                 3 0
     C                   ADD       7             XXCNT
     C*
     C* BUILD DATE ARRAY WITH EACH WEEKLY INSTALLMENT DATE.
     C*
     C     XXCNT         DOWLT     PDAYS
     C*
     C                   ADD       1             T
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      SRDTE         QQDT              8 0
     C                   PARM      7             QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTE
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         WKD(T)
     C                   ENDIF
     C*
     C                   ADD       7             XXCNT
     C                   ENDDO                                                  XXCNT IFLT
     C*
     C* CALCULATE EACH WEEKLY INSTALLMENT AMOUNT.
     C*
     C     XXPRO         DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKA(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKA           XXCOMP
     C     XXCOMP        IFNE      XXPRO
     C     XXPRO         SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKA(1)
     C                   ENDIF
     C*
     C* WEEKLY STATE TAX
     C*
     C     ELTXDU        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WKT(U)
     C                   ENDDO
     C*
     C                   XFOOT     WKT           XXCOMP
     C     XXCOMP        IFNE      ELTXDU
     C     ELTXDU        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WKT(1)
     C                   ENDIF
     C*
     C*
     C     RR1STB        IFEQ      'Y'
     C     XX1STB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK1(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK1           XXCOMP
     C     XXCOMP        IFNE      XX1STB
     C     XX1STB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK1(1)
     C                   ENDIF
     C                   ENDIF                                                  RR1STB IFEQ
     C*
     C     RR2NDB        IFEQ      'Y'
     C     XX2NDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK2(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK2           XXCOMP
     C     XXCOMP        IFNE      XX2NDB
     C     XX2NDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK2(1)
     C                   ENDIF
     C                   ENDIF                                                  RR2NDB IFEQ
     C*
     C     RR3RDB        IFEQ      'Y'
     C     XX3RDB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK3(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK3           XXCOMP
     C     XXCOMP        IFNE      XX3RDB
     C     XX3RDB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK3(1)
     C                   ENDIF
     C                   ENDIF                                                  RR3RDB IFEQ
     C     RR4THB        IFEQ      'Y'
     C     XX4THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK4(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK4           XXCOMP
     C     XXCOMP        IFNE      XX4THB
     C     XX4THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK4(1)
     C                   ENDIF
     C                   ENDIF                                                  RR4THB IFEQ
     C*
     C     RR5THB        IFEQ      'Y'
     C     XX5THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK5(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK5           XXCOMP
     C     XXCOMP        IFNE      XX5THB
     C     XX5THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK5(1)
     C                   ENDIF
     C                   ENDIF                                                  RR5THB IFEQ
     C     RR6THB        IFEQ      'Y'
     C     XX6THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK6(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK6           XXCOMP
     C     XXCOMP        IFNE      XX6THB
     C     XX6THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK6(1)
     C                   ENDIF
     C                   ENDIF                                                  RR6THB IFEQ
     C*
     C     RR7THB        IFEQ      'Y'
     C     XX7THB        DIV(H)    T             XXAMT2
     C     EXRNDI        IFEQ      'Y'
     C                   Z-ADD(H)  XXAMT2        XXWK10
     C                   Z-ADD     XXWK10        XXAMT2
     C                   ENDIF                                                  EXRNDI IFEQ
     C*
     C     1             DO        T             U                 3 0
     C                   Z-ADD     XXAMT2        WK7(U)
     C                   ENDDO
     C*
     C                   XFOOT     WK7           XXCOMP
     C     XXCOMP        IFNE      XX7THB
     C     XX7THB        SUB       XXCOMP        XXDIFR
     C                   ADD       XXDIFR        WK7(1)
     C                   ENDIF
     C                   ENDIF                                                  RR7THB IFEQ
     C* BILL WEEKLY INSTALLMENTS INTO A/R, CATCHING UP TO CURRENT DATE
     C* IF NECESSARY.
     C*
     C                   Z-ADD     0             XXAMT2
     C                   Z-ADD     0             Y
     C                   Z-ADD     0             ZZ                3 0
     C*
     C     1             DO        53            U
     C*
     C     WKA(U)        IFNE      *ZERO
     C*
     C     WKD(U)        IFLT      XXYMD
     C                   ADD       WKA(U)        XXAMT2
     C                   ADD       WKT(U)        XXAMT2
     C                   ADD       WK1(U)        XXAMT2
     C                   ADD       WK2(U)        XXAMT2
     C                   ADD       WK3(U)        XXAMT2
     C                   ADD       WK4(U)        XXAMT2
     C                   ADD       WK5(U)        XXAMT2
     C                   ADD       WK6(U)        XXAMT2
     C                   ADD       WK7(U)        XXAMT2
     C                   ELSE
     C*
     C     Y             IFLT      2
     C*
     C                   ADD       1             Y
     C     Y             IFEQ      2
     C                   ADD       1             ZZ
     C                   MOVE      *ON           *IN86
     C                   Z-ADD     WKD(U)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
     C                   MOVEL     SRDTO         X1WKDT            8 0
     C                   ENDIF
     C*
     C     Y             IFEQ      1
     C     WKA(U)        ADD       WKT(U)        AMT(1)
     C                   ADD       XXAMT2        AMT(1)
     C*
     C                   ADD       WK1(U)        AMT(1)
     C                   ADD       WK2(U)        AMT(1)
     C                   ADD       WK3(U)        AMT(1)
     C                   ADD       WK4(U)        AMT(1)
     C                   ADD       WK5(U)        AMT(1)
     C                   ADD       WK6(U)        AMT(1)
     C                   ADD       WK7(U)        AMT(1)
     C*
     C                   Z-ADD     WKD(U)        XXPFDT
     C                   Z-ADD     WKD(U)        XXYMD
     C                   EXSR      SRDUEW
     C                   ELSE
     C                   MOVE      '.'           DUW(3)
     C     WKA(U)        ADD       WKT(U)        AMT(3)
     C                   ADD       IFIFEE        AMT(3)
     C*
     C                   ADD       WK1(U)        AMT(3)
     C                   ADD       WK2(U)        AMT(3)
     C                   ADD       WK3(U)        AMT(3)
     C                   ADD       WK4(U)        AMT(3)
     C                   ADD       WK5(U)        AMT(3)
     C                   ADD       WK6(U)        AMT(3)
     C                   ADD       WK7(U)        AMT(3)
     C*
     C                   ENDIF
     C*
     C     XXAMT2        IFNE      *ZERO
     C                   Z-ADD     0             XXAMT2
     C                   ENDIF
     C*
     C                   ELSE
     C                   ADD       1             ZZ
     C                   ENDIF                                                  Y IFLT 2
     C*
     C                   ENDIF                                                  WKD,U IFLT
     C*
     C                   ENDIF                                                  WKA,U IFNE
     C*
     C                   ENDDO                                                  1 DO 53
     C*
     C                   ENDIF                                                  BSFREQ IFEQ
     C                   ENDIF                                                  BSDOWK IFEQ
     C*
     C                   ADD       XXDEPA        AMT(1)
     C                   ADD       XXEXCN        AMT(1)
     C                   ADD       XXMDUE        AMT(1)                         ADD MEMBER FEES
     C                   ADD       XXSDUE        AMT(1)                         ADD SAFETY FEES
     C     RR1STB        IFNE      'Y'
     C                   ADD       XX1STB        AMT(1)
     C                   ENDIF
     C     RR2NDB        IFNE      'Y'
     C                   ADD       XX2NDB        AMT(1)
     C                   ENDIF
     C     RR3RDB        IFNE      'Y'
     C                   ADD       XX3RDB        AMT(1)
     C                   ENDIF
     C     RR4THB        IFNE      'Y'
     C                   ADD       XX4THB        AMT(1)
     C                   ENDIF
     C     RR5THB        IFNE      'Y'
     C                   ADD       XX5THB        AMT(1)
     C                   ENDIF
     C     RR6THB        IFNE      'Y'
     C                   ADD       XX6THB        AMT(1)
     C                   ENDIF
     C     RR7THB        IFNE      'Y'
     C                   ADD       XX7THB        AMT(1)
     C                   ENDIF
      *** Beg Add *****  06/24/24  *******************************************
     C                   ADD       XXCOLB        AMT(1)
     C                   SUB       XXCOLP        AMT(1)
      *** End Add *****  06/24/24  *******************************************
     C*
     C                   END
     C     XXPRO         IFGT      0
     C     ELARSM        IFNE      'Y'
     C     EMSTRP        OREQ      'Y'
     C                   Z-ADD     1             X                 2 0
     C                   Z-ADD     1             L                 2 0
     C                   Z-ADD     ELBSDT        XXPFDT
     C     BSDOWK        IFEQ      *BLANKS
     C     BSFREQ        ANDNE     'T'                                          BSFREQ IFEQ
     C*
     C     X             DOUEQ     13
     C     MM            IFGT      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   END
     C     BSA(X)        IFNE      *ZERO
     C     X             ANDNE     1
     C     L             ANDNE     1
     C                   Z-ADD     IFIFEE        XXAMT2
     C                   ENDIF
     C     YYMM          IFGE      YYMM2
     C     BSA(X)        ANDNE     *ZERO
     C     YYMM          OREQ      YYMM2
     C     *IN57         IFNE      *ON
     C                   ADD       XXAMT2        AMT(L)
     C                   ENDIF
     C                   ADD       XXAMT2        XXINST
     C                   ADD       1             L
     C                   Z-ADD     *ZEROS        XXAMT2
     C                   END
     C                   ADD       1             X
     C                   ADD       1             MM
     C                   END
     C                   ELSE
     C     ZZ            MULT      IFIFEE        XXINST
     C                   ENDIF                                                  BSDOWK IFEQ
     C*
     C     XXINST        IFNE      *ZERO
     C                   MOVE      *ON           *IN67
     C                   ELSE
     C                   MOVE      *OFF          *IN67
     C                   ENDIF
     C                   ADD       XXINST        XXBAL
     C                   ENDIF                                                  ELARSM IFNE
     C                   ENDIF                                                  XXBAL IFGT
     C     ELARSM        IFEQ      'Y'
     C                   ADD       XXINST        XTINST
     C                   ADD       XXINST        XTBAL
     C                   ENDIF
      /free
       If CltId = '111';
          xxPro = xxPro + xxDvnd;
       Endif;
      /end-free
     C*
     C                   ELSE
     C*
     C*   CALCULATIONS FOR REVISED BILLING
     C*
     C*   FILL DATE ARRAY USED TO CALCULATE BALANCE DUE.
     C*
     C                   Z-ADD     1             L                 2 0
     C                   Z-ADD     1             I                 2 0
     C     EAKY2         CHAIN     PEA01                              60
     C                   MOVE      *BLANK        DDU
     C                   MOVE      *BLANK        AMT
     C                   MOVE      *BLANK        DUW
     C                   MOVE      *BLANK        BSD
     C                   Z-ADD     0             XXDUE
     C*
     C*
     C*  PROCESS NON-WEEKLY BILLING SCHEDULE CODES.
     C*
     C     BSDOWK        IFEQ      *BLANKS
     C     BSFREQ        ANDNE     'T'
     C     I             DOUEQ     13
     C*
     C     BSA(I)        IFNE      0
     C     YYMM          ANDGE     YYMM2
     C     YYMM          OREQ      YYMM2
     C                   MOVEL     YY            XXBDTE            7
     C                   MOVEL     MM            XXTEMP            4
     C     L             IFEQ      1
     C     YYMM          ANDEQ     YYMM2
     C                   MOVE      DD2           XXTEMP
     C                   ELSE
     C     ELBLFL        IFEQ      'Y'
     C                   MOVE      XXBDAY        XXTEMP
     C                   ELSE
     C                   MOVE      '01'          XXTEMP
     C                   ENDIF                                                  ELBLFL EQ 'Y'
     C                   END
     C                   MOVE      XXTEMP        XXBDTE
     C                   MOVE      XXTEMP        DD3               2 0
     C     DD3           IFNE      1
     C     MM            IFEQ      2
     C     XXBDAY        ANDGE     29
     C                   MOVE      29            XXBDTE
     C                   Z-ADD     XXPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
      *
     C     SRERR         IFEQ      *ON
     C                   MOVE      28            XXBDTE
     C                   ENDIF                                                  SRERR IFEQ *ON
      *
     C                   ELSE
      *
     C     XXBDAY        IFGT      30
      *
     C     MM            IFEQ      4
     C     MM            OREQ      6
     C     MM            OREQ      9
     C     MM            OREQ      11
     C                   MOVE      30            XXBDTE
     C                   ENDIF                                                  MM IFEQ 4
      *
     C                   ENDIF                                                  DD IFGT 30
      *
     C                   ENDIF                                                  MM IFEQ 2
      *
     C                   ENDIF                                                  DD3 IFNE
     C                   MOVE      XXBDTE        BSD(L)
     C                   ADD       1             L
     C                   END
     C*
     C     MM            IFEQ      12
     C                   Z-ADD     1             MM
     C                   ADD       1             YY
     C                   ELSE
     C                   ADD       1             MM
     C                   END
     C*
     C                   ADD       1             I
     C                   END
     C*
     C     L             IFEQ      1
     C                   Z-ADD     XXYMD         XXPFDT
     C                   MOVEL     YY            XXBDTE
     C                   MOVEL     MM            XXTEMP
     C     YYMM          IFEQ      YYMM2
     C                   MOVE      DD2           XXTEMP
     C                   ELSE
     C     ELBLFL        IFEQ      'Y'
     C                   MOVE      XXBDAY        XXTEMP
     C                   ELSE
     C                   MOVE      '01'          XXTEMP
     C                   ENDIF                                                  ELBLFL EQ 'Y'
     C                   END
     C     MM            IFEQ      2
     C     DD            ANDGE     29
     C                   MOVE      29            XXPFDT
     C                   Z-ADD     XXPFDT        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDYY
      *
     C     SRERR         IFEQ      *ON
     C                   MOVE      28            XXTEMP
     C                   ENDIF                                                  SRERR IFEQ *ON
      *
     C                   ELSE
      *
     C     DD            IFGT      30
      *
     C     MM            IFEQ      4
     C     MM            OREQ      6
     C     MM            OREQ      9
     C     MM            OREQ      11
     C                   MOVE      30            XXTEMP
     C                   ENDIF                                                  MM IFEQ 4
      *
     C                   ENDIF                                                  DD IFGT 30
      *
     C                   ENDIF                                                  MM IFEQ 2
      *
     C                   MOVE      XXTEMP        XXBDTE
     C                   MOVE      XXBDTE        BSD(L)
     C                   ADD       1             L
     C                   END
     C*
     C                   MOVE      ELPTDT        BSD(L)
     C     BSD(L)        IFLT      BSD(1)
     C                   Z-ADD     BSD(1)        SRDTI
     C                   CALL      'SRCVTDAT'    DTMDY
     C                   MOVEL     SRDTO         XXDT              6 0
     C*
     C                   CALL      'SRFUTR8'
     C                   PARM      XXDT          QQDT              8 0
     C                   PARM      1             QQDAYS            5 0
     C                   PARM                    QQERR             1
     C                   PARM                    QQTERM            1
     C*
     C     QQERR         IFNE      '1'
     C                   Z-ADD     QQDT          SRDTI
     C                   CALL      'SRCVTDAT'    DTCYMD
     C                   MOVEL     SRDTO         BSD(L)
     C                   ENDIF
     C*
     C                   ENDIF                                                  BSD,L IFLT
     C*
     C*  GET THE BALANCE DUE AND FILL PRINT ARRAYS
     C*
     C                   Z-ADD     1             L
     C                   Z-ADD     1             A
     C                   Z-ADD     2             B                 2 0
     C                   IF        @BLARQ <> 0
     C     EAKYD         SETLL     PEA0D
     C     EAKYD         READE     PEA0D
     C                   DOW       NOT(%EOF) AND EAPODT < BSD(A)
     C                   IF        EAARCD = F1RCCD
     C                   SUB       EAAMT         XXDUE
     C                   ENDIF
     C     EAKYD         READE     PEA0D
     C                   ENDDO                                                  *IN60 DOWEQ *OFF
     C                   ENDIF                                                  BLARQ# IFNE 0
     C     EAKY2         CHAIN     PEA02                              60
     C     EAPODT        DOWLT     BSD(A)
     C     *IN60         ANDEQ     '0'
     C                   IF        EAARCD = F1RCCD AND @BLARQ = 0
     C                   SUB       EAAMT         XXDUE
     C                   ENDIF
     C                   MOVE      *BLANKS       XXKEY
     C                   MOVEL     EAARCD        XXKEY
     C     TBKEY         CHAIN     PTT01                              60
     C     EAARTY        IFEQ      'B'
     C     EAARTY        OREQ      'A'
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        ANDNE     'C'
     C     EAarcd        Andne     F1dvbl
     C                   SELECT
     C     CLTID         WHENEQ    '071'
     C     EAARCD        IFNE      F1RDCD
     C                   ADD       EAAMT         XXDUE             9 2
     C                   ENDIF
     C                   OTHER
     C                   ADD       EAAMT         XXDUE             9 2
     C                   ENDSL
     C                   ENDIF                                                  *IN60 IFEQ 0
     C                   END
     C*
     C     *IN60         IFEQ      *OFF
     C     TTCTYP        IFEQ      'T'                                                      EES
     C     TTTYPE        ANDEQ     'F'                                                      EES
     C                   ADD       EAAMT         XXDUE
     C                   ENDIF
     C                   ENDIF
