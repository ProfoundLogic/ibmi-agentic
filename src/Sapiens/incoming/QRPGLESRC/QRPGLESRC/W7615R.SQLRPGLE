     C                   Z-ADD     0             XN5THB           11 2
     C                   Z-ADD     0             XN6THB           11 2
     C                   Z-ADD     0             XN7THB           11 2
     C                   Z-ADD     0             XT6THB           11 2
     C                   Z-ADD     0             XT7THB           11 2
     C                   Clear                   divPrints         1
     C                   Z-ADD     0             xcANPR           11 2
     C                   Z-ADD     0             xspfdt            7 0
     C*** begin add ***  04/03/25  *******************************************
     C                   Move      *blanks       svSFHD           20
     C                   Move      *blank        svSFHDFlg         1
     C*** end add *****  04/03/25  *******************************************
      *** Beg Add *****  07/07/23  *******************************************
     C                   EVAL      tasmin = 0
     C                   EVAL      XXMINF = ' '
      *** End Add *****  07/07/23  *******************************************
      /Free
        //* Find policy effective date of state rpt division.
        //*** Beg Add ***** 09/01/23 ***********************
        Clear xxSt;
        //*** End Add ***** 09/01/23 ***********************
        //*** Begin Add *** 05/07/24 ************************************
        xsRRN = 0;
        //*** End   Add *** 05/07/24 ************************************
        Setll emkey1 pem01;
        Reade emkey1 pem01;
        Dow not %eof;
           If EMStrp = 'Y';
              Chain(n) (XXCO#:XXFND:XXEMP#:EMDIV:XXFYR) pel01;
              If %found;
                 //*** Begin Add *** 05/07/24 ****************************
                 xsRRN  = dbrrn;
                 //*** End   Add *** 05/07/24 ****************************
                 xspfdt = ELPfdt;
                //*** Beg Add ***** 09/01/23 ***************
                 xxSt = GetRatingState(xxCo#:xxFnd:xxEmp#:xxDiv);
                //*** End Add ***** 09/01/23 ***************
           //*** begin add ***  07/07/23  *******************************************
                 If ELEmnp = 'Y';
                    xxminf = 'Y';
                 Endif;
           //*** end add *****  07/07/23  *******************************************
              Endif;
              Leave;
           Endif;
           Reade emkey1 pem01;
        Enddo;
       //*** Beg Add ***** 09/01/23 ***************
        Select;
        When hasBeenRead = *On;
        When qqQte = 'Q';
           xxBillType = processTypeQ;
           xxBillType1 = 'Q';
           processType = processTypeQ;
           processTypeD = 'Quote_Bill';
           If ELRQFL = 'Y';
              billTitle = TIT2(4);
           Else;
              billTitle = TIT2(3);
           Endif;
        When ELfaf = 'E';
           xxBillType = processTypeE;
           xxBillType1 = 'E';
           processType = processTypeE;
           processTypeD = 'Estmd_Bill';
           billTitle = TIT2(1);
        When ELfaf = 'R';
           xxBillType = processTypeR;
           xxBillType1 = 'R';
           processType = processTypeR;
           processTypeD = 'Revsd_Bill';
           billTitle = TIT2(2);
        EndSl;
        If hasBeenRead = *Off;
           hasBeenRead = *On;
           isUseSpoolOut = UseSpoolOut(processType);
           //*** Beg Chg ***** 10/24/24 ********************************************
           //***isUseXML = UseScriptura(processType);
           isUseXML = *Off;
           If UseScriptura(processType) and qqHard = 'Y';
              isUseXML = *On;
           Endif;
           //*** End Chg ***** 10/24/24 ********************************************
           If isUseXml = *On;
              Open WSBLL;
              Open WSBL1L;
              Open WXBLP;
              Open WXBLP1;
              Open WXBLP2;
           Endif;
        EndIf;
        Clear xxDivC;
        Clear xxArSum;
        Clear xxCombine;
       // Check if multi-div or A/R Summarized
       // to possibly write combined bill
        Setll elky2 pel02;
        Dou %Eof(WDELL1);
           Reade elky2 pel02;
           If %Eof;
              Leave;
           Endif;
           xxDivC += 1;
           If ELarsm = 'Y';
              xxArSum = ELarsm;
           Endif;
           If xxDivC > 1 or xxArSum = 'Y';
              Leave;
           Endif;
        Enddo;
        // Find billing template
        If isUseXml = *On;
           For idx = 1 to 4;
              Select;
              When idx = 1;
                 outFnd = xxFnd;
                 outSt = xxSt;
              When idx = 2;
                 outFnd = xxFnd;
                 outSt = *Blanks;
              When idx = 3;
                 outFnd = 0;
                 outSt = xxSt;
              When idx = 4;
                 outFnd = 0;
                 outSt = *Blanks;
              Endsl;
              hasBillingTemplate =
               GetBillingTemplate(xxCo#:xxBillType1:
               outFnd:outSt);
              If hasBillingTemplate = *On;
                 Leave;
              Endif;
           EndFor;
        Endif;
       // Check if flagged to combine bill output
       // Multi-Div, Summarized A/R, Merge Prm Notice
        Select;
        //*** Beg Chg ***** 02/24/25 *************************************
        //***When hasBillingTemplate = *Off;
        When hasBillingTemplate = *Off or *In59 = *On;
        //*** End Chg ***** 02/24/25 *************************************
        When xxBillType = processTypeE;
          If BDCombE = 'Y' and (xxDivC <> 1 Or xxArSum = 'Y')
           Or (BDPrmNE = 'Y' and BDMrgPrN <> 'N' and BDMrgPrN <> *Blank);
             xxCombine = 'Y';
          EndIf;
        When xxBillType = processTypeR;
          If BDCombR = 'Y' and (xxDivC <> 1 Or xxArSum = 'Y')
           Or (BDPrmNR = 'Y' and BDMrgPrN <> 'N' and BDMrgPrN <> *Blank);
             xxCombine = 'Y';
          EndIf;
        When xxBillType = processTypeQ;
          If BDCombQ = 'Y' and (xxDivC <> 1 Or xxArSum = 'Y')
           Or (BDPrmNQ = 'Y' and BDMrgPrN <> 'N' and BDMrgPrN <> *Blank);
             xxCombine = 'Y';
          EndIf;
        Endsl;
        isPrmNotice = *Off;
        Select;
        When xxBillType = processTypeE;
          If BDPrmNE = 'Y' ;
             isPrmNotice = *On;
          EndIf;
        When xxBillType = processTypeR;
          If BDPrmNR = 'Y';
             isPrmNotice = *On;
          EndIf;
        When xxBillType = processTypeQ;
          If BDPrmNQ = 'Y';
             isPrmNotice = *On;
          EndIf;
        Endsl;

        //Mass Request Flag
        If massReqGen = 'N';
           If svEmp# <> 0 and xxDivC = 1 and ELarsm <> 'Y' and isPrmNotice=*Off;
           Else;
              isMassReq = *On;
              massFlag = 'Y';
           Endif;
        Endif;
       //*** End Add ***** 09/01/23 ***************

      /End-Free
     C*** begin add ***  11/13/23  *******************************************
     C                   Z-add     0             annMin           11 0
      *** Beg Add *****  05/12/25  *******************************************
     C                   Z-add     0             sav_MPebal       11 2
      *** End Add *****  05/12/25  *******************************************
      //*** begin chg ***  10/11/24  ***************************************
      //*****  If xxminf = 'Y';
      //* Do not back into annualized balance to minimum for NJ.
        If xxminf = 'Y' and xxst = 'NJ';
           Chain (xxCo#:xxFnd:xxFyr:xxEmp#:xxDiv) pmp01;
           annMin = MPEBal;
           If ELPror <> 0 and ELPror <> 1;
              Eval(h) annMin = annMin / ELPror;
           Endif;
        Endif;
        If xxminf = 'Y' and xxst <> 'NJ';
      //*** end chg *****  10/11/24  ***************************************
           Setll elky2 pel02;
           Reade elky2 pel02;
           annMin = ELEmna;
           Dow not %eof;
              Chain (xxCo#:xxFnd:xxFyr:xxEmp#:ELDiv) pmp01;
              Eval annMin = annMin - ELPRTF - MPEnmp + ELEin1 + ELEin2 + MPEwav;
              //*** Beg Add *****  05/12/25  *******************************************
              If MPebal > 0;
                 sav_MPebal = MPebal;
              Endif;
              //*** End Add *****  05/12/25  *******************************************
              Reade elky2 pel02;
           Enddo;
           //*** Beg Add *****  05/12/25  *******************************************
           If annMin < sav_MPebal;
              annMin = sav_MPebal;
           Endif;
           //*** End Add *****  05/12/25  *******************************************
        Endif;
     C*** end add *****  11/13/23  *******************************************
     C                   MOVE      *BLANK        XXNY              1
     C                   MOVE      *BLANK        XXMA              1
     C                   MOVE      *BLANK        XXPRF             1
     c                   eval      xtpred = 0
     c                   eval      xxFlrtAdj = 0
     C                   MOVE      *BLANKS       DDUB
     C*
     C  N59EMKEY1        CHAIN     PEM01                              60
     C   59EMKEY         CHAIN     PEM01                              60
     C*
      *
      * Make sure all employer divisions have carrier pol # entered
      *
     C                   EXSR      CPOL#
      *
      *
      * Make sure DEBIT/CREDIT factors for policy are within range
      *
     C                   EXSR      SRDBCR
      //*** Beg Add ***** 09/01/23 *************************************
        Clear saveEmp#;
      //*** End Add ***** 09/01/23 *************************************
      *
     C     *IN60         DOWEQ     *OFF
     C*
      /Free
          If saveEmp <> EMemp#;

             isPrtQuoteProposal = *on;
             saveEmp = EMemp#;

          Endif;
      /End-Free
       // Check and make sure the group is included for IC Quote processing
       If decSaveGroup <> EMfnd;
          isProcessICQuote = ICQuoteOpt(EMco#:EMfnd);
          decSaveGroup = EMfnd;
       EndIf;
     C     EMSTRP        IFEQ      'Y'
     C                   Z-ADD     EMDIV         XSDIV
