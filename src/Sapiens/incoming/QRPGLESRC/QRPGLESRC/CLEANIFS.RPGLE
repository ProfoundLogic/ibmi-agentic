     H option(*nodebugio:*srcstmt)
     H DATEDIT(*DMY)
     H DftActGrp(*No)
     H BndDir( 'QC2LE' )
     H*====================================================================
     H/TITLE CLEANIFS - Program to Clean the IFS XML folder.
     H*====================================================================
     H*  Description:
     H*
     H*  This program can be called to clean up files within the indicated
     H*  IFS folder which are older, or equal to, than the days value passed in.
     H*
     H*  Example:  If 'TESTFOLD' and '0007' are passed in then the program will
     H*            delete any files in /TESTFOLD which are at least a week old.
     H*            If a file within the folder is 0-6 days old, by access date,
     H*            then it will not be deleted.  If '0000' or nothing is passed
     H*            in for the Days parameter then everything will be deleted as
     H*            no files should have an access date greater than today.
     H*
     H*  Created:  02/24/15  C:65  Project: SY251
     H*====================================================================
     H*  Revisions:
     H*
     H*
     H*====================================================================

     D PSDS          ESDS                  extname(SZQ1P)

      *---------------------------------------------------------------------
      * Prototype for API procedures
      *----------------------------------------------------------------*
     Dlstat            PR            10I 0 EXTPROC('lstat')
     D                                 *   VALUE
     D                                 *   VALUE

     Dopendir          PR              *   EXTPROC('opendir')
     D                                 *   VALUE

     Dreaddir          PR              *   EXTPROC('readdir')
     D                                 *   VALUE

     Dclosedir         PR            10I 0 EXTPROC('closedir')
     D                                 *   VALUE

     D unlink          PR            10I 0 ExtProc('unlink')
     D   path                          *   Value options(*string)

     D SndPgmMsg       PR              N
     D Qmsgid                         7    CONST
     D Qmsgf                         20    CONST
     D Qmsg                         128    CONST
     D Qmsgtp                        10    CONST OPTIONS(*NOPASS)

      *---------------------------------------------------------------------
      * Prototypes for retrieving error generated by procedure call
      *---------------------------------------------------------------------
     D StrErr          PR              *   ExtProc( 'strerror' )
     D  Err                          10I 0 Value

     D ErrTxt          PR            79
     D                                1    Options( *Omit )

     D GetErr          PR              *   ExtProc( '__errno' )
     D                                1    Options( *Omit )

      *----------------------------------------------------------------*
     D*** stat data structure returned by procedure lstat()
     D StatDS          DS           128
     D  st_mode                      10U 0
     D  st_ino                       10U 0
     D  st_nlink                      5U 0
     D  reserved1                     2A
     D  st_uid                       10U 0
     D  st_gid                       10U 0
     D  st_size                      10U 0
     D  st_atime                     10U 0
     D  st_mtime                     10U 0
     D  st_ctime                     10U 0
     D  st_dev                       10U 0
     D  st_blksize                   10I 0
     D  st_allocsize                 10I 0
     D  st_objtype                   10A
     D  reserved2                     2A
     D  st_codepage                   5U 0
     D  st_reserved1                 62A
     D  st_ino_gen_id                10U 0

     D*** direntry data structure returned by procedure readdir()
     D DirEntry        DS
     D d_reserved1                   16A
     D d_fileno_genid                10U 0
     D d_fileno                      10U 0
     D d_reclen                      10U 0
     D d_reserved3                   10I 0
     D d_reserved4                    6A
     D d_reserved5                    2A
     D d_ccsid                       10I 0
     D d_country_id                   2A
     D d_language_id                  3A
     D d_nls_reserved                 3A
     D d_namelen                     10U 0
     D d_name                       640A

     D Null            S              1A   Inz(X'00')
     D ReturnInt       S             10I 0
     D ReturnDir       S               *
     D PtrToEntry      S               *
     D RtnEntry        S                   BASED(PtrToEntry) Like(DirEntry)
     D EntryName       S            120A
     D EntryPath       S            256A
     D printPath       S            100A
     D CmdLine         S            512
     D CmdLen          S             15  5
     D DirError        C                   'Error occurred when attempting to -
     D                                     open directory'

      * Input Parameters
     D DirName         S            100A
     D FullName        S            256A
     D Days            S              4A
     D Days#           S              4  0 Inz(0)
     D FileName        S            100A
     D DelFileName     S            100A   Inz(' ')
     D epoch           S               Z   inz(z'1970-01-01-00.00.00.000000')
     D modtime         S               Z
     D currDate        S               D
     D testDate        S               D

     D up              C                   'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
     D lo              C                   'abcdefghijklmnopqrstuvwxyz'

      * Work variables

     D ObjVar          S             90
     D ObjVarLen       S             10I 0 Inz(%size(ObjVar))
     D ObjVarFmt       S              8
     D ObjTyp          S             10

     D FoldName        S             63
     D DocDesc         S             44
     D DocType         S              8

     D APIERR          DS
     D  ERRSIZ                 1      4B 0 INZ(256)
     D  ERRLEN                 5      8B 0 INZ(0)
     D  ERRMIC                 9     15
     D  ERRNBR                16     16
     D  ERRDTA                17    272

     D***** PSDS           SDS           512
      *----------------------------------------------------------------*


     C                   Eval      FullName = %trimr(DirName) + Null
      * Open directory
     C                   Eval      ReturnDir = opendir(%addr(FullName))

      * Terminate if error occurred when opening directory
     C                   If        ReturnDir = *Null
     C                   Callp     SndPgmMsg('CPF9898':'QCPFMSG'
     C                                       :ErrTxt(*Omit))
     C                   Eval      *inlr = *on
     C                   Return
     C                   Endif
     C
     C                   Dou       PtrToEntry = *Null
      * Read next directory entry
     C                   Eval      PtrToEntry  = readdir(ReturnDir)

      * Directory entry name is in field d_name
     C                   If        PtrToEntry <> *Null
     C                   Eval      DirEntry = RtnEntry
     C
      * Get directory entry name
     C                   Eval      EntryName = %str(%addr(d_name))

      * Determine object type of entry
     C                   Eval      EntryPath = %trim(DirName) + '/'
     C                             + %trimr(EntryName) + Null
     C                   Eval      ReturnInt = lstat(%addr(EntryPath)
     C                                         : %addr(StatDS))
      *
     C                   Eval      FoldName = DirName
     C                   Eval      DocDesc = EntryName
     C                   Eval      DocType = st_objtype
     C*
     C                   If        %subst(DirName:1:1) <> '/'
     C                   Eval      printPath = '/' + %trim(EntryPath)
     C                   Else
     C                   Eval      printPath = %trim(EntryPath)
     C                   Endif
     C
     C* figure out date & time:
     c     epoch         adddur    st_atime:*S   modtime
     c                   move      modtime       testDate

      * Delete file if older than cut off date.
     C                   If        testDate <= currDate
     C
     C                   If        delFileName = ' ' or
     C                             %xlate(lo:up:delFileName) =
     C                             %xlate(lo:up:EntryName)
     C
      /free
                         unlink(printPath);
      /end-free
     C                   Endif
     C
     C                   Endif
     C
     C
     C                   Endif

     C                   Enddo

      * Close directory and printer file
     C                   Eval      ReturnInt = closedir(ReturnDir)

     C                   Eval      *inlr = *on

      *----------------------------------------------------------------*
     C     *Inzsr        Begsr

     C     *Entry        Plist
     C                   Parm                    DirName
     C                   Parm                    Days
     C                   Parm                    FileName

     C     Qcmdexc       Plist
     C                   Parm                    CmdLine
     C                   Parm                    CmdLen
      /free
          currDate = %date;
      /end-free

     C                   If        q1prms >= 2

     C                   If        Days <> ' '
     C                   Testn                   Days                 60

     C     *IN60         Ifeq      *ON
     C                   Move      Days          Days#
     C     currDate      subdur    Days#:*days   currDate
     C                   Endif

     C                   Endif

     C                   Endif

     C                   If        q1prms >= 3
     C                   Eval      delFileName = FileName
     C                   Endif

     C                   Endsr

      *----------------------------------------------------------------*
      * Send pgm message
      *----------------------------------------------------------------*
     P SndPgmMsg       B
     D                 PI              N
     D Msgid                          7    CONST
     D Msgf                          20    CONST
     D Msgdta                       128    CONST
     D Msgtp                         10    CONST OPTIONS(*NOPASS)

      * Work variables
     D Qmsgid          S              7
     D Qmsgf           S             20
     D Qmsgdta         S            128
     D Qmsgln          S             10I 0
     D Qmsgtp          S             10
     D Qmsgq           S             10
     D Qmsgqn          S             10I 0      INZ(3)
     D Qmsgky          S              4
     D Qmsger          S             15


      * Insert default for library if msg file library is blank
     C                   Eval      Qmsgid = Msgid
     C                   Eval      Qmsgf = Msgf
     C                   Eval      Qmsgdta = Msgdta
     C                   If        %subst(Qmsgf:11:10) = *blank
     C                   Eval      %subst(Qmsgf:11:10) = '*LIBL'
     C                   Endif
     C                   Eval      Qmsgln = %len(%trim(Qmsgdta))
     C                   Eval      Qmsgq = '*'
     C                   Eval      Qmsgtp = '*DIAG'
     C                   If        %parms > 3
     C                   Eval      Qmsgtp = Msgtp
     C                   Endif
     C                   If        Qmsgtp = '*STATUS'
     C                   Eval      Qmsgq = '*EXT'
     C                   Endif

     C                   Call      'QMHSNDPM'                           99
     C                   Parm                    Qmsgid                     Msg ID
     C                   Parm                    Qmsgf                      Msg file
     C                   Parm                    Qmsgdta                    Msg text
     C                   Parm                    Qmsgln                     Msg length
     C                   Parm                    Qmsgtp                     Msg type
     C                   Parm                    Qmsgq                      Pgm queue
     C                   Parm                    Qmsgqn                     Pgm lvl
     C                   Parm                    Qmsgky                     Msg key
     C                   Parm      *LOVAL        Qmsger                     Error field

     C                   Return    *on
     P                 E

      *----------------------------------------------------------------*
      * Return the previous API function's error in text format
     P ErrTxt          B                   Export

     D ErrTxt          PI            79
     D  DummyParm                     1    Options( *Omit )

      * Local variable(s)
     D ErrNo           S             10I 0 Based( ErrNoPtr )
     D RetChr          S             79
     D Chr300          S            300    Based( Chr300Ptr )

     C                   Eval      ErrNoPtr  = GetErr( *Omit )
     C                   Eval      Chr300Ptr = StrErr( ErrNo )
     C                   Eval      RetChr    = %Str( Chr300Ptr )
     C                   Return    RetChr

     P ErrTxt          E

