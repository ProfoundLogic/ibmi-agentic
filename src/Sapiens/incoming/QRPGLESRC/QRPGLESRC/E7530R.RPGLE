     H option(*nodebugio:*srcstmt)
     H dftactgrp(*no) actgrp('QILE')
     H/define CONVERT
     H*
    H* StoneRiver is a trademark of StoneRiver, Inc.                 *
     H**
     H/TITLE E7530R - WEIGHTING & BALLAST VALUE LISTING
     H*****************************************************************
     H**                                                             **
     H**   PROGRAM DESCRIPTION:                                      **
     H**     THIS PROGRAM PRINT A LIST OF THE                        **
     H**     EXPECTED LOSS & WEIGHTING VALUE & BALLAST VALUE         **
     H**                                                             **
     H**   CALLED FROM:                                              **
     H**     E7530C                                                  **
     H**   CALLS TO:                                                 **
     H**     NONE                                                    **
     H**   PROGRAMMER: ALAN M. MOSS                                  **
     H**   CREATED:    02/25/91     PROJECT: EXP MOD                 **
     H**                                                             **
     H** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **
     H**                                                             **
     H** MODIFICATIONS:                                              **
     H**                                                             **
     H**08/05/15 C:307 Project: SY354                                **
     H**               -Adding 'Route To:'                           **
     H**                                                             **
     H**  08/26/14 C:298 Project: SY354                              **
     H**               -Implement Routing Page Changes.              **
     H**
     H**  01/28/10  C:249  Project: SY215                            **
     H**            C:189  Retrieve brand Name                       **
     H**                                                             **
     H** 08/12/98  C:90  PROJ:WC853                                  **
     H**           MODIFIED TO VERSION 3 STANDARDS                   **
     H**                                                             **
     H** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **
     H**                                                             **
     H** INDICATOR USAGE:                                            **
     H**   INDICATOR            FUNCTION DESCRIPTION                 **
     H**                                                             **
     H**     *IN                                                     **
     H**      08     DEMAND MODE                                     **
     H**      09     BATCH  MODE                                     **
     H**      50     DOWEQ    EMEXL                                  **
     H**      60     NO HIT ON FILE                                  **
     H**                                                             **
     H**                                                             **
     H** * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * **
     H** FILE USAGE:                                                 **
     H** FILES:                                                      **
     H**    SMCOL (PCO01): CO FILE                                   **
     H**    SMORL (POR01): OVERRIDE FILE                             **
     H**    EMUPL (PUP01): USER FILE                                 **
     H**    EMWBL (PWB01): CO/LOSS/SELECT STAT <> I                  **
     H*****************************************************************
     H*
     FSMORL     IF   E           K DISK
     FSMCOL     IF   E           K DISK
     FEMUPL     IF   E           K DISK
     FEMWBL1    IF   E           K DISK
     FQSYSPRT   O    F   80        PRINTER OFLIND(*INOA)

     D                 DS
     D  DSDTTM                 1     12  0
     D  DSTIME                 1      6  0
     D  DSDATE                 7     12  0
     D PSDS          ESDS                  EXTNAME(SZQ1P)

     C*
     C*   KEY LIST FOR THE COMPANY FILE
     C*
     C     COKEY         KLIST
     C                   KFLD                    XXCO#
     C*
     C*   KEY LIST FOR THE USER PARAMETER FILE
     C*
     C     UPKEY         KLIST
     C                   KFLD                    Q1USER
     C*
     C*   KEY LIST FOR THE OVERRIDE FILE
     C*
     C     ORKEY         KLIST
     C                   KFLD                    Q1PGM
     C                   KFLD                    XXPRT             1
     C*
     C*   WEIGHING & BALLAST TABLE
     C*
     C     WBKEY         KLIST
     C                   KFLD                    XXCO#
     C                   KFLD                    XXLOSS
     C*
     C*
     C     *ENTRY        PLIST
     C                   PARM                    QQCO#             3
     C                   PARM                    QQQUE            10
     C                   PARM                    QQMODE            1
     C*
     C* Define Work Fields
     C*
     C     *LIKE         DEFINE    WBLOSS        XXLOSS
     C                   MOVE      *BLANKS       XXLOS             9 2
     C                   MOVE      *BLANKS       XXWEIG            3 2
     C                   MOVE      *BLANKS       XXBALL            7 2
     C*
     C                   MOVE      QQCO#         XXCO#             3 0
     C                   MOVE      QQMODE        XXMODE            1
     C*
     C                   TIME                    DSDTTM
     C*
     C*   SET-UP AND INITIALIZE
     C*
     C     XXMODE        IFEQ      'D'
     C                   SETON                                        09        DEMAND MODE
     C                   ELSE
     C                   SETON                                        08        BATCH MODE
     C                   END
     C*
     C*    CHAIN TO THE USER PARAMETER FILE
     C*
     C     UPKEY         CHAIN     PUP01                              60
     C*
     C*   CHAIN TO THE COMPANY FILE
     C*
     C     COKEY         CHAIN     PCO01                              60
     C*
     C*** BEG ADD ***** 01/28/10 **************************************
     C                   CALL      'RTVBRND'
     C                   PARM      '@'           #BTYPE            1
     C                   PARM      *BLANKS       #BRND1           80
     C                   PARM      *BLANKS       #BRND2           80
     C*** END ADD ***** 01/28/10 **************************************
     C*   GET THE DISTRIBUTION INFORMATION
     C*
      ***** Beg Del ***** 08/26/14 ************************************
     C********           MOVE      '0'           XXPRT
     C********     ORKEY         CHAIN     POR01                              60
     C********     *IN60         IFEQ      '0'
     C*
     C*   PRINT THE DISTRIBUTION INFORMATION
     C*
     C********             EXCEPT    ROUTE
     C********                   END
      ***** End Del ***** 08/26/14 ************************************
     C*
     C*   PRINT PAGE HEADING
     C*
     C                   EXCEPT    HEAD
     C*
     C****   READ EXPECTED LOSS  FILE
     C*
     C     WBKEY         SETLL     PWB01
     C                   READ      PWB01                                  50
     C     *IN50         DOWEQ     '0'
     C*
     C                   MOVE      *BLANKS       XXWEIG
     C*
     C                   Z-ADD     WBLOSS        XXLOS
     C     WBWEIG        MULT      .01           XXWEIG
     C                   Z-ADD     WBBALL        XXBALL
     C*
     C*   PRINT THE LINE
     C*
     C     *INOA         IFEQ      '1'
     C                   EXCEPT    HEAD
     C                   MOVE      '0'           *INOA
     C                   END
     C*
     C                   EXCEPT    DET1
     C*
     C                   READ      PWB01                                  50
     C                   END
     C*
      /Free
       //***** Beg Add ***** 08/26/14 ***********************************
       xxPrt = '0';
       Chain orKey POR01;
       If %found;
          Except Route;
       Endif;
       //***** End Add ***** 08/26/14 ***********************************
      /End-free
     C                   MOVE      '1'           *INLR
     C*
     OQSYSPRT   E            ROUTE          1 06
