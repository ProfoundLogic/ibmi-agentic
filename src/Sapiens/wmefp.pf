     A** WORKERS' COMP EFT ACCOUNT FILE
     A*
     A                                      REF(WREFP)
     A          R PEF01                     TEXT('EFT ACCOUNT FILE')
     A            EFCO#     R               REFFLD(CO#)
     A            EFEFDT    R               REFFLD(DT)
     A                                      COLHDG('EFFECTIVE DATE')
     A            EFEXDT    R               REFFLD(DT)
     A                                      COLHDG('EXPIRATION DATE')
     A            EFTRCD    R               REFFLD(CODE)
     A                                      COLHDG('TRANSACTION CODE')
     A            EFPRE     R               REFFLD(CODE)
     A                                      COLHDG('PRENOTE TRANS CODE')
     A            EFID#          8A         COLHDG('RECIEVING DFI ID#')
     A            EFDGIT    R               REFFLD(FLAG)
     A                                      COLHDG('RECIEVE DFI' 'CHECK DIGIT')
     A            EFACCT        17A         COLHDG('DFI ACCOUNT #')
     A            EFPDT     R               REFFLD(DT)
     A                                      COLHDG('PRENOTE DATE')
     A            EFADT     R               REFFLD(DT)
     A                                      COLHDG('APPROVED DATE')
     A            EFFTDT    R               REFFLD(DT)
     A                                      COLHDG('DATE OF' 'FIRST TRANSFER')
     A            EFLTDT    R               REFFLD(DT)
     A                                      COLHDG('DATE OF' 'LAST TRANSFER')
     A*
     A            EFFND     R               REFFLD(FND)
     A            EFFYR     R               REFFLD(FYR)
     A            EFCASE    R               REFFLD(CASE)
     A            EFSEQ#    R               REFFLD(SEQ#)
     A                                      COLHDG('ADDL ADDR SEQ#')
     A            EFFEIN    R               REFFLD(FEIN)
     A            EFMOD     R               REFFLD(MOD)
     A            EFTYPE    R               REFFLD(FLAG)
     A                                      COLHDG('TYPE OF PAYEE')
     A*
     A            EFSTAT    R               REFFLD(STAT)
     A            EFUSER    R               REFFLD(USER)
     A            EFPGM     R               REFFLD(PGM)
     A            EFTIME    R               REFFLD(TIME)
     A            EFDT      R               REFFLD(DT)
     A                                      COLHDG('DATE' 'MAINTAINED')
     A            EFIUSR    R               REFFLD(USER)
     A                                      COLHDG('INITIAL' 'USER')
     A            EFIPGM    R               REFFLD(PGM)
     A                                      COLHDG('INITIAL' 'PROGRAM')
     A            EFITM     R               REFFLD(TIME)
     A                                      COLHDG('INITIAL' 'TIME')
     A            EFIDT     R               REFFLD(DT)
     A                                      COLHDG('INITIAL' 'DATE')
