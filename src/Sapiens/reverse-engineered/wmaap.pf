     A**********************************************************************
     A* WMAAP - Agency Assignments (REVERSE-ENGINEERED placeholder)
     A**********************************************************************
     A          R PAA01
     A            AACO#          3P 0       TEXT('Company Number')
     A            AAFEIN         9P 0       TEXT('Federal EIN')
     A            AAMOD          3P 0       TEXT('Modifier')
     A            AAFND          3P 0       TEXT('Fund Number')
     A            AAAGT#         5P 0       TEXT('Agent Number')
     A            AANAME        40A         TEXT('Assignment Name')
     A            AAL            1A         TEXT('Active flag')
