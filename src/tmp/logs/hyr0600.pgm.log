   3366     // For totes, look for the associated shipment, using the first                                                  003340
   3367     // shipment found.                                                                                               003341
   3368     //   1) If the screen is currently subsetted by shipping lane,                                                   003342
   3369     //      find the most recent open shipment group for the tote                                                    003343
   3370     //      where it has been associated with that shipping lane.                                                    003344
   3371     //   2) If the screen is not currently subsetted by shipping lane                                                003345
   3372     //      (or it is subsetted by shipping lane but the tote was not                                                003346
   3373     //      found associated with the shipping lane), find the most                                                  003347
   3374     //      recent open shipment group for the tote (regardless of                                                   003348
   3375     //      shipping lane).                                                                                          003349
   3376     //   3) If, after steps 1 and 2, the shipment group has not yet                                                  003350
   3377     //      been identified, find the most recent shipment group                                                     003351
   3378     //      for the tote (regardless of status and shipping lane).                                                   003352
   3379     IF F4DVRT > *Zero;                                                                                               003353
   3380       EXEC SQL select coalesce(max(GDGRP#),0), count(*)                                                              003354
   3381                 into :wk_GDGRP#, :wk_RcdCnt                                                                          003355
   3382                from HYPSGDT a                                                                                        003356
