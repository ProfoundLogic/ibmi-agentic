            "smodeldsc": {
              "type": "char",
              "length": 40
            },
            "scustname": {
              "type": "char",
              "length": 40
            },
            "ssitename": {
              "type": "char",
              "length": 40
            },
            "sbuilt": {
              "type": "char",
              "length": 10
            },
            "sstatusd": {
              "type": "char",
              "length": 10
            }
          }
        }
      }
    }
