     A                                      UNIQUE
     A          R FLMACHR                   TEXT('Fletcher Machine Inst Base')
     A            FLSER          8A         COLHDG('Serial' 'Number')
     A                                      TEXT('Machine serial number')
     A            FLMMODL       10A         COLHDG('Model')
     A                                      TEXT('Model code')
     A            FLMCUST        6P 0       COLHDG('Cust' 'Number')
     A                                      TEXT('Owning customer')
     A            FLMSITE        6P 0       COLHDG('Site' 'Number')
     A                                      TEXT('Mine site')
     A            FLMBUILD       8S 0       COLHDG('Build' 'Date')
     A                                      TEXT('Build date YYYYMMDD')
     A            FLMSHIP        8S 0       COLHDG('Ship' 'Date')
     A                                      TEXT('Ship date YYYYMMDD')
     A            FLMHOURS       9P 0       COLHDG('Operating' 'Hours')
     A                                      TEXT('Operating hours')
     A            FLMSTAT        1A         COLHDG('Sts')
     A                                      TEXT('A=Active P=Parked S=Scrapped')
     A            FLMLSVC        8S 0       COLHDG('Last' 'Service')
     A                                      TEXT('Last service YYYYMMDD')
     A            FLMLMOD        8S 0       COLHDG('Last' 'Modern')
     A                                      TEXT('Last modernization YYYYMMDD')
     A            FLMMODT        1A         COLHDG('Mod' 'Typ')
     A                                      TEXT('N=None P=Partial F=Full')
     A          K FLSER
