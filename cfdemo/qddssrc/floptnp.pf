     A                                      UNIQUE
     A          R FLOPTNR                   TEXT('Fletcher Machine Option')
     A            FLOSER         8A         COLHDG('Serial' 'Number')
     A                                      TEXT('Machine serial number')
     A            FLOCODE       10A         COLHDG('Option' 'Code')
     A                                      TEXT('Option code')
     A            FLODESC       40A         COLHDG('Option Description')
     A                                      TEXT('Option description')
     A            FLOFITD        8S 0       COLHDG('Fitted' 'Date')
     A                                      TEXT('Fitted date YYYYMMDD')
     A          K FLOSER
     A          K FLOCODE
