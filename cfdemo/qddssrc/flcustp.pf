     A                                      UNIQUE
     A          R FLCUSTR                   TEXT('Fletcher Customer Master')
     A            FLCUST         6P 0       COLHDG('Cust' 'Number')
     A                                      TEXT('Fletcher customer number')
     A            FLCNAME       40A         COLHDG('Customer Name')
     A                                      TEXT('Mining company name')
     A            FLCCITY       30A         COLHDG('City')
     A                                      TEXT('City')
     A            FLCSTATE       2A         COLHDG('St')
     A                                      TEXT('State code')
     A            FLCCNTRY       3A         COLHDG('Ctry')
     A                                      TEXT('Country code')
     A            FLCREGN       10A         COLHDG('Region')
     A                                      TEXT('Sales region')
     A            FLCMGR        30A         COLHDG('Account' 'Manager')
     A                                      TEXT('Account manager')
     A            FLCSTAT        1A         COLHDG('Sts')
     A                                      TEXT('Status A=Active I=Inactive')
     A            FLCSINCE       8S 0       COLHDG('Customer' 'Since')
     A                                      TEXT('Customer since YYYYMMDD')
     A          K FLCUST
