     A                                      UNIQUE
     A          R FLPARTR                   TEXT('Fletcher Part Master')
     A            FLPART        15A         COLHDG('Part Number')
     A                                      TEXT('Part number')
     A            FLPDESC       40A         COLHDG('Description')
     A                                      TEXT('Part description')
     A            FLPDESC2      40A         COLHDG('Description 2')
     A                                      TEXT('Additional description')
     A            FLPLINE        3A         COLHDG('Prod' 'Line')
     A                                      TEXT('Product line')
     A            FLPUOM         3A         COLHDG('UOM')
     A                                      TEXT('Unit of measure')
     A            FLPPRICE      11P 2       COLHDG('Unit' 'Price')
     A                                      TEXT('Unit price')
     A            FLPSTOCK       7P 0       COLHDG('On' 'Hand')
     A                                      TEXT('Quantity on hand')
     A            FLPLEAD        3P 0       COLHDG('Lead' 'Days')
     A                                      TEXT('Lead time days')
     A            FLPSUPER      15A         COLHDG('Superseded' 'By')
     A                                      TEXT('Supersede-to part number')
     A            FLPSTAT        1A         COLHDG('Sts')
     A                                      TEXT('A=Actv S=Superseded O=Obs')
     A            FLPCREAT       8S 0       COLHDG('Date' 'Created')
     A                                      TEXT('Date created YYYYMMDD')
     A          K FLPART
