     A* FLWOP - machine build work orders.  (GJA-917)
     A*
     A* FLWNOTE holds the scheduler's free-text note - the sticky note
     A* from the physical board. It is deliberately unstructured,
     A* because that is how the information actually exists today.
     A*
     A                                      UNIQUE
     A          R FLWOR                     TEXT('Machine build work order')
     A            FLWO           8P 0       COLHDG('Work' 'Order')
     A                                      TEXT('Work order number')
     A            FLWSER         8A         COLHDG('Serial' 'Number')
     A                                      TEXT('Assigned machine serial')
     A            FLWMODL       10A         COLHDG('Model')
     A                                      TEXT('Model code')
     A            FLWCUST        6P 0       COLHDG('Cust' 'Number')
     A                                      TEXT('Ordering customer')
     A            FLWSITE        6P 0       COLHDG('Site' 'Number')
     A                                      TEXT('Destination mine site')
     A            FLWTYPE        1A         COLHDG('Typ')
     A                                      TEXT('N=New M=Modern R=Rebuild')
     A            FLWSTAT        1A         COLHDG('Sts')
     A                                      TEXT('P/R/I/H/C order status')
     A            FLWPRIO        1A         COLHDG('Pri')
     A                                      TEXT('H=High M=Medium L=Low')
     A            FLWOPEN        8S 0       COLHDG('Order' 'Date')
     A                                      TEXT('Order date YYYYMMDD')
     A            FLWPROM        8S 0       COLHDG('Promised' 'Ship')
     A                                      TEXT('Promised ship YYYYMMDD')
     A            FLWSTRT        8S 0       COLHDG('Actual' 'Start')
     A                                      TEXT('Actual start YYYYMMDD')
     A            FLWCOMP        8S 0       COLHDG('Actual' 'Compl')
     A                                      TEXT('Completed YYYYMMDD')
     A            FLWWCTR        6A         COLHDG('Current' 'Wk Ctr')
     A                                      TEXT('Current work centre')
     A            FLWPCT         3P 0       COLHDG('Pct' 'Rptd')
     A                                      TEXT('Percent complete reported')
     A            FLWVALUE      11P 2       COLHDG('Order' 'Value')
     A                                      TEXT('Order value')
     A            FLWDESC       40A         COLHDG('Description')
     A                                      TEXT('Build description')
     A            FLWNOTE       60A         COLHDG('Scheduler' 'Note')
     A                                      TEXT('Scheduler free-text note')
     A          K FLWO
