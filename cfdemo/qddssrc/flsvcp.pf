     A          R FLSVCR                    TEXT('Fletcher Service Event')
     A            FLVSER         8A         COLHDG('Serial' 'Number')
     A                                      TEXT('Machine serial number')
     A            FLVDATE        8S 0       COLHDG('Service' 'Date')
     A                                      TEXT('Service date YYYYMMDD')
     A            FLVTYPE        1A         COLHDG('Typ')
     A                                      TEXT('A=Audit R=Rpr P=PM W=Wrnty')
     A            FLVTECH       30A         COLHDG('Technician')
     A                                      TEXT('Technician name')
     A            FLVDESC       60A         COLHDG('Description')
     A                                      TEXT('Event description')
     A            FLVDOWN        5P 1       COLHDG('Down' 'Hours')
     A                                      TEXT('Downtime hours')
     A            FLVCOST       11P 2       COLHDG('Cost')
     A                                      TEXT('Service cost')
     A          K FLVSER
