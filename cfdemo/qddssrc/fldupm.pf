     A                                      UNIQUE
     A          R FLDUPMR                   TEXT('Duplicate cluster member')
     A            FLDMID         9P 0       COLHDG('Cluster')
     A                                      TEXT('Cluster id')
     A            FLDMPART      15A         COLHDG('Part Number')
     A                                      TEXT('Part number')
     A            FLDMROLE       1A         COLHDG('Role')
     A                                      TEXT('S=survivor L=loser U=undec')
     A            FLDMWHY       80A         COLHDG('Match Note')
     A                                      TEXT('Member match note')
     A            FLDMBOM        5P 0       COLHDG('BOM')
     A                                      TEXT('BOM lines referencing')
     A            FLDMORD        5P 0       COLHDG('Ords')
     A                                      TEXT('Order lines referencing')
     A            FLDMSTK        7P 0       COLHDG('On Hand')
     A                                      TEXT('Quantity on hand')
     A            FLDMVAL       11P 2       COLHDG('Stock' 'Value')
     A                                      TEXT('Stock value')
     A          K FLDMID
     A          K FLDMPART
