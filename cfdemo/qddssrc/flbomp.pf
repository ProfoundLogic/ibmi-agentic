     A          R FLBOMR                    TEXT('Fletcher Part Fitment / BOM')
     A            FLBMODL       10A         COLHDG('Model')
     A                                      TEXT('Model code')
     A            FLBASSY       20A         COLHDG('Assembly')
     A                                      TEXT('Assembly name')
     A            FLBPART       15A         COLHDG('Part Number')
     A                                      TEXT('Part number')
     A            FLBQTY         5P 0       COLHDG('Qty')
     A                                      TEXT('Quantity per assembly')
     A            FLBPOS         4P 0       COLHDG('Pos')
     A                                      TEXT('Position within assembly')
     A            FLBOPTN       10A         COLHDG('Option' 'Reqd')
     A                                      TEXT('Option required blank=all')
     A            FLBFSER        8A         COLHDG('From' 'Serial')
     A                                      TEXT('Effective from serial')
     A            FLBTSER        8A         COLHDG('To' 'Serial')
     A                                      TEXT('Effective to serial')
     A          K FLBMODL
