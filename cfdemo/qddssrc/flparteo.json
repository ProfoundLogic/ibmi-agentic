{
  "type": "ejs",
  "formats": {
    "partctl": {
      "description": "Fletcher Parts Finder - parts that fit a machine",
      "template": "/profoundui/userdata/ui/flparts/parts.ejs?v=1",
      "css": [
        "/profoundui/userdata/ui/fletcher/fletcher-theme.css?v=1",
        "/profoundui/userdata/ui/flparts/parts.css?v=1"
      ],
      "fields": {
        "action": {
          "type": "char",
          "length": 10
        },
        "sserial": {
          "type": "char",
          "length": 8
        },
        "ssearch": {
          "type": "char",
          "length": 40
        },
        "smodel": {
          "type": "char",
          "length": 10
        },
        "smodeldsc": {
          "type": "char",
          "length": 40
        },
        "scustname": {
          "type": "char",
          "length": 40
        },
        "ssitename": {
          "type": "char",
          "length": 40
        },
        "sbuilt": {
          "type": "char",
          "length": 10
        },
        "soptions": {
          "type": "char",
          "length": 200
        },
        "sdupwarn": {
          "type": "zoned",
          "length": 5
        },
        "soptdesc": {
          "type": "char",
          "length": 40
        },
        "msg": {
          "type": "char",
          "length": 78
        }
      },
      "subfiles": {
        "partsfl": {
          "description": "Parts fitted to this machine",
          "clear": "sflclear",
          "fields": {
            "sopt": {
              "type": "char",
              "length": 2
            },
            "spart": {
              "type": "char",
              "length": 15
            },
            "sdescr": {
              "type": "char",
              "length": 40
            },
            "sassy": {
              "type": "char",
              "length": 20
            },
            "sqty": {
              "type": "packed",
              "length": 5
            },
            "sstock": {
              "type": "packed",
              "length": 7
            },
            "sprice": {
              "type": "packed",
              "length": 11,
              "decimals": 2
            },
            "slead": {
              "type": "packed",
              "length": 3
            },
            "sstatusd": {
              "type": "char",
              "length": 12
            },
            "sdupes": {
              "type": "zoned",
              "length": 3
            }
          }
        }
      }
    }
  }
}