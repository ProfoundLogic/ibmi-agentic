     A                                      UNIQUE
     A          R FLDUPCR                   TEXT('Duplicate part cluster')
     A            FLDCID         9P 0       COLHDG('Cluster')
     A                                      TEXT('Cluster id')
     A            FLDCRUN        9P 0       COLHDG('Run')
     A                                      TEXT('Detector run number')
     A            FLDCKEY      100A         COLHDG('Signature')
     A                                      TEXT('Normalised signature')
     A            FLDCCNT        3P 0       COLHDG('Mbrs')
     A                                      TEXT('Number of members')
     A            FLDCCONF       3P 0       COLHDG('Conf')
     A                                      TEXT('Confidence percent 0-100')
     A            FLDCREAS     150A         COLHDG('Reason')
     A                                      TEXT('Why this was flagged')
     A            FLDCSTAT       1A         COLHDG('Sts')
     A                                      TEXT('N=new M=merge R=rej D=defer')
     A            FLDCSURV      15A         COLHDG('Survivor')
     A                                      TEXT('Chosen survivor part')
     A            FLDCUSER      18A         COLHDG('Reviewer')
     A                                      TEXT('Reviewed by user')
     A            FLDCDATE       8S 0       COLHDG('Reviewed')
     A                                      TEXT('Reviewed date YYYYMMDD')
     A            FLDCNOTE     120A         COLHDG('Note')
     A                                      TEXT('Reviewer note')
     A            FLDCVAL       13P 2       COLHDG('Stock' 'Value')
     A                                      TEXT('Stock value in cluster')
     A            FLDCBOM        5P 0       COLHDG('BOM')
     A                                      TEXT('BOM lines affected')
     A          K FLDCID
