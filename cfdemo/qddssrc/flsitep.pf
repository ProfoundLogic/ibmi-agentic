     A                                      UNIQUE
     A          R FLSITER                   TEXT('Fletcher Mine Site')
     A            FLSITE         6P 0       COLHDG('Site' 'Number')
     A                                      TEXT('Mine site number')
     A            FLSCUST        6P 0       COLHDG('Cust' 'Number')
     A                                      TEXT('Owning customer')
     A            FLSNAME       40A         COLHDG('Site Name')
     A                                      TEXT('Mine site name')
     A            FLSSTATE       2A         COLHDG('St')
     A                                      TEXT('State code')
     A            FLSTYPE        1A         COLHDG('Typ')
     A                                      TEXT('C=Coal M=Metal I=IndMin')
     A            FLSSEAM        5P 1       COLHDG('Seam' 'Height')
     A                                      TEXT('Seam height inches')
     A            FLSSTAT        1A         COLHDG('Sts')
     A                                      TEXT('Status A=Active I=Inactive')
     A          K FLSITE
