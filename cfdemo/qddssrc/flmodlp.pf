     A                                      UNIQUE
     A          R FLMODLR                   TEXT('Fletcher Machine Model')
     A            FLMODL        10A         COLHDG('Model')
     A                                      TEXT('Model code')
     A            FLMDESC       40A         COLHDG('Model Description')
     A                                      TEXT('Model description')
     A            FLMLINE        3A         COLHDG('Prod' 'Line')
     A                                      TEXT('RBC RBM DJ SCL MRS PL PMT')
     A            FLMINTRO       8S 0       COLHDG('Intro' 'Date')
     A                                      TEXT('Introduced YYYYMMDD')
     A            FLMSTAT        1A         COLHDG('Sts')
     A                                      TEXT('Status C=Current L=Legacy')
     A          K FLMODL
