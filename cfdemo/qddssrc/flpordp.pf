     A                                      UNIQUE
     A          R FLPORDR                   TEXT('Fletcher Parts Order History')
     A            FLOORD         8P 0       COLHDG('Order' 'Number')
     A                                      TEXT('Parts order number')
     A            FLOSERM        8A         COLHDG('Serial' 'Number')
     A                                      TEXT('Machine serial number')
     A            FLOCUST        6P 0       COLHDG('Cust' 'Number')
     A                                      TEXT('Customer number')
     A            FLODATE        8S 0       COLHDG('Order' 'Date')
     A                                      TEXT('Order date YYYYMMDD')
     A            FLOPART       15A         COLHDG('Part Number')
     A                                      TEXT('Part number')
     A            FLOQTY         5P 0       COLHDG('Qty')
     A                                      TEXT('Quantity ordered')
     A            FLOAMT        11P 2       COLHDG('Amount')
     A                                      TEXT('Extended amount')
     A          K FLOORD
