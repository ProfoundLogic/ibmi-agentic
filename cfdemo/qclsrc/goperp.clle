             /* ============================================================ */
             /*  GOPERP - Bridge from the Agentic Coding Demo menu to the    */
             /*           PERP Demo menu (PERPDEMO/PERPMNU).                 */
             /*                                                              */
             /*  PERPMNU's own options call PERP programs unqualified, and   */
             /*  every PERP program reads tables in PERPDEMO, so PERPDEMO    */
             /*  has to be on the library list before the menu is shown.     */
             /*  The AIDEMO job description does not carry it, so add it     */
             /*  here and leave it in place for the rest of the session.     */
             /* ============================================================ */
             PGM

             ADDLIBLE   LIB(PERPDEMO) POSITION(*LAST)
             MONMSG     MSGID(CPF2103)  /* Already on the library list */

             GO         MENU(PERPDEMO/PERPMNU)

             ENDPGM
