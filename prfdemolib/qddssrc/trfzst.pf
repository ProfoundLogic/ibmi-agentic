      * @MBRTEXT: TRF - Zero Shipped Transfer Detail Process file
     A* Reconstructed from the PRFDEMOLIB/TRFZST object by
     A* prfdemolib/tools/reconstruct-dds.py. Format level
     A* identifier of the shipped object: 424FEB8C86F00
     A          R RTRFZST                   TEXT('ZERO SHIPPED TRANSFER DTL')
     A            TRFBCH         8
     A                                      TEXT('Transfer Batch Number')
     A                                      COLHDG('Trf' 'Batch' 'Number')
     A            TRFFLC         5P 0
     A                                      TEXT('From Store or Warehouse')
     A                                      COLHDG('Frm' 'Store' '/Whse')
     A                                      EDTCDE(Z)
     A            TRFTLC         5P 0
     A                                      TEXT('To Store or Warehouse')
     A                                      COLHDG('To' 'Store' '/Whse')
     A                                      EDTCDE(Z)
     A            INUMBR         9P 0
     A                                      TEXT('SKU NUMBER')
     A                                      COLHDG('SKU' 'NUMBER')
     A                                      EDTCDE(Z)
     A            TRFALC         7P 0
     A                                      TEXT('Quantity Allocate')
     A                                      COLHDG('Quantity' 'Allocate')
     A                                      EDTCDE(Z)
     A            TRFIDT         6S 0
     A                                      TEXT('Initiation Date')
     A                                      COLHDG('Initiation' 'Date')
     A                                      EDTWRD('  /  /  ')
     A            TRFSDT         6S 0
     A                                      TEXT('Ship Date')
     A                                      COLHDG('Ship' 'Date')
     A                                      EDTWRD('  /  /  ')
     A            TRFREF         8
     A                                      TEXT('Transfer Reference Number P-O-
     A                                       Number, W-O Number,')
     A                                      COLHDG('Ref' 'Number')
     A            TRFPO#         8S 0
     A                                      TEXT('Purchase Order Number')
     A                                      COLHDG('Purch' 'Order' 'Number')
     A                                      EDTCDE(Z)
     A            TRFBO#         2S 0
     A                                      TEXT('Bck Ord Nbr')
     A                                      COLHDG('Bck' 'Ord' 'Nbr')
     A                                      EDTCDE(Z)
     A            TRZSRB         6P 0
     A                                      TEXT('Release Batch')
     A                                      COLHDG('Release' 'Batch')
     A                                      EDTCDE(Z)
     A            TRZSRS         1
     A                                      TEXT('Release Status')
     A                                      COLHDG('Release' 'Status')
     A            TRFNTR         8
     A                                      TEXT('NEW Batch Number')
     A                                      COLHDG('NEW' 'Batch' 'Number')
     A            IDEPT          3S 0
     A                                      TEXT('DEPT')
     A                                      COLHDG('DEPT')
     A                                      EDTCDE(Z)
     A            ISDEPT         3S 0
     A                                      TEXT('Sub Department')
     A                                      COLHDG('Sub Department')
     A                                      EDTCDE(Z)
     A            ICLAS          3S 0
     A                                      TEXT('Class')
     A                                      COLHDG('Class')
     A                                      EDTCDE(Z)
     A          K TRZSRS
     A          K IDEPT
     A          K ISDEPT
     A          K ICLAS
     A          K INUMBR
     A          K TRFTLC
     A          K TRFBCH
