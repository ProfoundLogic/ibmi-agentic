{
  "type": "ejs",
  "formats": {
    "simtest": {
      "description": "Simple camera test - isolate the iPad barcode problem",
      "template": "/profoundui/userdata/ui/gtsimd/simtest.ejs?v=20260811k",
      "css": [
        "/profoundui/userdata/ui/gtcommon/gt-theme.css?v=20260811k",
        "/profoundui/userdata/ui/gtsimd/simtest.css?v=20260811k"
      ],
      "js": [
        "/profoundui/userdata/ui/gtsimd/simtest.js?v=20260811k"
      ],
      "fields": {
        "action":   { "type": "char",  "length": 10 },
        "scanval":  { "type": "char",  "length": 120 },
        "langpref": { "type": "char",  "length": 2 },
        "msg":      { "type": "char",  "length": 78 },

        "lastval":  { "type": "char",  "length": 120 },
        "lastsymb": { "type": "char",  "length": 20 },
        "lastlen":  { "type": "zoned", "length": 5 },
        "lasttime": { "type": "char",  "length": 8 },

        "diag":     { "type": "char",  "length": 240 }
