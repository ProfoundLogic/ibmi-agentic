      "subfiles": {
        "simsfl": {
          "description": "Every barcode read this session, newest first",
          "clear": "sflclear",
          "fields": {
            "sseq":  { "type": "zoned", "length": 3 },
            "sval":  { "type": "char",  "length": 60 },
            "ssymb": { "type": "char",  "length": 20 },
            "stime": { "type": "char",  "length": 8 }
          }
        }
      }
    }
  }
}
