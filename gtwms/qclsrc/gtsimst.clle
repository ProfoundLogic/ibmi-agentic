/*==================================================================*/
/*  GTSIMST -- entry point for the simple camera test.               */
/*                                                                   */
/*  Called from option 5 of the sign-on menu, fully qualified as     */
/*  TIGERPOC/GTSIMST so that it is reachable no matter what is on    */
/*  the library list at sign-on. Same shape as GTSTART, and for the  */
/*  same reason: the display file and program are resolved through   */
/*  *LIBL after this, so no source below ever names a library.       */
/*==================================================================*/

             PGM

             ADDLIBLE   LIB(TIGERPOC) POSITION(*FIRST)
             /* CPF2103 -- already on the library list. Expected on a  */
             /* second entry within the same session.                  */
             MONMSG     MSGID(CPF2103)

             CALL       PGM(GTSIMR)

             ENDPGM
