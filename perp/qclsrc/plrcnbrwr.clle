/* PLRCNBRWR - Launch RCNBRWR (PERP reconciliation log browse) directly. */
/* Bypasses the PERP menus. Sets the library list, sets company ACM  */
/* in *LDA(1:3), then calls the target by name.                      */

PGM

  ADDLIBLE LIB(PERPDEMO) POSITION(*LAST)
  MONMSG   MSGID(CPF2103)  /* Already on the library list */

  CHGDTAARA DTAARA(*LDA (1 3)) VALUE('ACM')

  CALL     PGM(RCNBRWR)

ENDPGM
