     A  60                                  DSPATR(HI)
     A  60                                  COLOR(RED)
     A                                  6  2'Type option, press Enter.'
     A                                  7  4'2=Change   4=Delete'
     A                                  9  2'Opt'
     A                                      DSPATR(UL)
     A                                  9  5'Lot'
     A                                      DSPATR(UL)
     A                                  9 26'Qty On Hand'
     A                                      DSPATR(UL)
     A                                  9 44'Received'
     A                                      DSPATR(UL)
     A                                  9 56'Expiry'
