<%
/* ====================================================================
 * Item Lookup -- detail.
 *
 * The most graphical screen in the application and the one the demo opens
 * with, so it is treated as the brand showpiece: large imagery first, then
 * facts as chips and stat tiles rather than a form, then where the stock is.
 *
 * The carousel is a CSS scroll-snap strip. It swipes natively with no
 * JavaScript; gt-carousel.js only syncs the dots. If that file never loads,
 * the screen still works.
 * ==================================================================== */
var lang = (typeof langpref !== 'undefined' && langpref &&
            langpref.toString().trim().toUpperCase() === 'FR') ? 'FR' : 'EN';

var T = {
  EN: { appName:'GT Warehouse', appSub:'ITEM LOOKUP',
        onHand:'On hand', available:'Available', inBulk:'In bulk', locations:'Locations',
        details:'Product details', sku:'SKU', dept:'Department', uom:'Unit',
        casePack:'Case pack', weight:'Weight', dims:'Dimensions', retail:'Retail',
        upc:'Consumer barcode', caseCode:'Case barcode',
        whereIsIt:'Where is it', noStock:'No stock on hand anywhere',
        loc:'Location', qty:'Qty', alloc:'Allocated', zone:'Zone',
        back:'Back to results', menu:'Menu', noImage:'No image',
        prev:'Previous image', next:'Next image',
        addPhoto:'Add photo', photoTitle:'Add a photo',
        usePhoto:'Use this photo', retake:'Retake', cancel:'Cancel',
        takePhoto:'Take photo', closeCamera:'Close camera', chooseFile:'Choose a file',
        yourPhoto:'Your photo', images:'images', yours:'by you',
        photoHint:'Photograph the stock as it actually is \u2014 damage, ' +
                  'labelling, how the skid is built.',
        depts:{GROC:'Grocery',CLEA:'Cleaning',HLTH:'Health & Beauty',HOME:'Home',
               APPL:'Apparel',SEAS:'Seasonal',PETS:'Pet Supplies',TOYS:'Toys'},
        types:{PICK:'Pick face',BULK:'Bulk',STAG:'Staging',RETN:'Returns',DAMG:'Damage'} },
  FR: { appName:'GT Entrepôt', appSub:'RECHERCHE D’ARTICLE',
        onHand:'En stock', available:'Disponible', inBulk:'En vrac', locations:'Emplacements',
        details:'Détails du produit', sku:'UGS', dept:'Rayon', uom:'Unité',
        casePack:'Qté par caisse', weight:'Poids', dims:'Dimensions', retail:'Prix',
        upc:'Code à barres unitaire', caseCode:'Code à barres de caisse',
        whereIsIt:'Où est-il', noStock:'Aucun stock nulle part',
        loc:'Emplacement', qty:'Qté', alloc:'Réservé', zone:'Zone',
        back:'Retour aux résultats', menu:'Menu', noImage:'Aucune image',
        prev:'Image précédente', next:'Image suivante',
        addPhoto:'Ajouter une photo', photoTitle:'Ajouter une photo',
        usePhoto:'Utiliser cette photo', retake:'Reprendre', cancel:'Annuler',
        takePhoto:'Prendre la photo', closeCamera:'Fermer la caméra',
        chooseFile:'Choisir un fichier',
        yourPhoto:'Votre photo', images:'images', yours:'par vous',
        photoHint:'Photographiez la marchandise telle qu\u2019elle est \u2014 ' +
                  'avaries, étiquetage, montage de la palette.',
        depts:{GROC:'Épicerie',CLEA:'Nettoyage',HLTH:'Santé et beauté',HOME:'Maison',
               APPL:'Vêtements',SEAS:'Saisonnier',PETS:'Animalerie',TOYS:'Jouets'},
        types:{PICK:'Emplacement de prélèvement',BULK:'Vrac',STAG:'Zone de transit',
               RETN:'Retours',DAMG:'Avaries'} }
}[lang];

var s = function (v) { return (v === undefined || v === null) ? '' : v.toString().trim(); };
var has = function (v) { return s(v) !== ''; };
var loc = lang === 'FR' ? 'fr-CA' : 'en-CA';
var num = function (v, dp) {
  return Number(v || 0).toLocaleString(loc, { minimumFractionDigits: dp || 0,
                                              maximumFractionDigits: dp || 0 });
};
var money = function (v) {
  return Number(v || 0).toLocaleString(loc, { style: 'currency', currency: 'CAD' });
};
var IMG = '/profoundui/userdata/ui/gtimg/';

/* Only the image slots RPG actually filled. Eight discrete fields rather
 * than a subfile because a carousel is a fixed, small number of images and
 * a subfile would cost a second record format for no gain.
 *
 * src 'C' is catalogue imagery, 'P' is a photograph an operator took of the
 * real stock. They are badged differently so nobody mistakes a picture of a
 * water-damaged carton for what the product is meant to look like. */
var imgs = [];
[[typeof dimg1 !== 'undefined' ? dimg1 : 0, typeof dcap1 !== 'undefined' ? dcap1 : '', typeof dsrc1 !== 'undefined' ? dsrc1 : ''],
 [typeof dimg2 !== 'undefined' ? dimg2 : 0, typeof dcap2 !== 'undefined' ? dcap2 : '', typeof dsrc2 !== 'undefined' ? dsrc2 : ''],
 [typeof dimg3 !== 'undefined' ? dimg3 : 0, typeof dcap3 !== 'undefined' ? dcap3 : '', typeof dsrc3 !== 'undefined' ? dsrc3 : ''],
 [typeof dimg4 !== 'undefined' ? dimg4 : 0, typeof dcap4 !== 'undefined' ? dcap4 : '', typeof dsrc4 !== 'undefined' ? dsrc4 : ''],
 [typeof dimg5 !== 'undefined' ? dimg5 : 0, typeof dcap5 !== 'undefined' ? dcap5 : '', typeof dsrc5 !== 'undefined' ? dsrc5 : ''],
 [typeof dimg6 !== 'undefined' ? dimg6 : 0, typeof dcap6 !== 'undefined' ? dcap6 : '', typeof dsrc6 !== 'undefined' ? dsrc6 : ''],
 [typeof dimg7 !== 'undefined' ? dimg7 : 0, typeof dcap7 !== 'undefined' ? dcap7 : '', typeof dsrc7 !== 'undefined' ? dsrc7 : ''],
 [typeof dimg8 !== 'undefined' ? dimg8 : 0, typeof dcap8 !== 'undefined' ? dcap8 : '', typeof dsrc8 !== 'undefined' ? dsrc8 : '']]
  .forEach(function (p) {
    if (Number(p[0]) > 0) {
      imgs.push({ id: Number(p[0]), cap: s(p[1]), src: s(p[2]).toUpperCase() });
    }
  });
var nPhotos = imgs.filter(function (im) { return im.src === 'P'; }).length;

var rows = (typeof locsfl !== 'undefined' && locsfl) ? locsfl : [];
%>
<div class="gt-app gt-itemdetl-screen" data-gt-lang="<%= lang %>">

  <header class="gt-header">
    <div class="gt-logo">
      <span class="gt-logo-mark">GT</span>
      <span class="gt-logo-text"><%= T.appName %><small><%= T.appSub %></small></span>
    </div>
    <div class="gt-header-spacer"></div>
    <div class="gt-operator">
      <strong><%= s(typeof opername !== 'undefined' ? opername : '') %></strong>
    </div>
    <div class="gt-lang">
      <button type="button" class="<%= lang === 'EN' ? 'is-active' : '' %>"
              onclick="pui.submit({action:'LANGEN'})">EN</button>
      <button type="button" class="<%= lang === 'FR' ? 'is-active' : '' %>"
              onclick="pui.submit({action:'LANGFR'})">FR</button>
    </div>
  </header>

  <main class="gt-main gt-detl-main">
    <% if (has(typeof msg !== 'undefined' ? msg : '')) { %>
      <div class="gt-msg"><%= s(msg) %></div>
    <% } %>

    <div class="gt-detl-split">

      <!-- ---- Carousel: CSS scroll-snap, works with no JS ---------- -->
      <section class="gt-detl-media">
        <div class="gt-car">
          <div class="gt-car-strip">
            <% if (imgs.length) { %>
              <% imgs.forEach(function (im) { %>
                <div class="gt-car-slide">
                  <img src="<%= IMG %><%= im.id %>.jpg" alt="<%= im.cap %>" loading="lazy">
                  <% if (im.src === 'P') { %>
                    <span class="gt-car-badge"><%= T.yourPhoto %></span>
                  <% } %>
                  <% if (im.cap) { %><span class="gt-car-cap"><%= im.cap %></span><% } %>
                </div>
              <% }); %>
            <% } else { %>
              <div class="gt-car-slide"><span class="gt-car-none"><%= T.noImage %></span></div>
            <% } %>
          </div>

          <% if (imgs.length > 1) { %>
            <button type="button" class="gt-car-nav gt-car-prev"
                    aria-label="<%= T.prev %>">&lsaquo;</button>
            <button type="button" class="gt-car-nav gt-car-next"
                    aria-label="<%= T.next %>">&rsaquo;</button>
            <div class="gt-car-dots">
              <% imgs.forEach(function (im, i) { %>
                <button type="button" class="gt-car-dot<%= i === 0 ? ' is-on' : '' %>"
                        aria-label="<%= i + 1 %>"></button>
              <% }); %>
            </div>
          <% } %>

          <%# Camera button sits ON the carousel, bottom-left, clear of the
              centred dots and of the right-hand next arrow. Rendered
              unconditionally and never hidden by a breakpoint: it is the only
              way to add a photo, so it has to survive the narrowest phone. If
              gt-photo.js never loads it simply does nothing, rather than the
              screen depending on JS to draw itself. %>
          <button type="button" class="gt-car-add" title="<%= T.addPhoto %>"
                  aria-label="<%= T.addPhoto %>"
                  onclick="if(window.gtPhoto)gtPhoto.open()">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M9 3 7.2 5H4a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h16a2 2 0 0 0
                       2-2V7a2 2 0 0 0-2-2h-3.2L15 3H9Zm3 5.5A4.5 4.5 0 1 1 7.5
                       13 4.5 4.5 0 0 1 12 8.5Zm0 2A2.5 2.5 0 1 0 14.5 13 2.5
                       2.5 0 0 0 12 10.5Z"/>
              <path d="M19.5 2.5v2h2v1.5h-2v2H18v-2h-2V4.5h2v-2Z"
                    class="gt-car-add-plus"/>
            </svg>
          </button>
        </div>

        <%# The count only. There used to be a second, labelled "Add photo"
            button here that appeared at 640px and vanished below it -- two
            controls doing one job, and the one that survived on a phone was
            the one the operator could not see. Now there is exactly one
            camera button, on the image, at every width. %>
        <div class="gt-car-meta">
          <span class="gt-car-count">
            <%= imgs.length %> <%= T.images %><% if (nPhotos > 0) { %>
              &middot; <%= nPhotos %> <%= T.yours %><% } %>
          </span>
        </div>
      </section>

      <!-- ---- Facts ------------------------------------------------ -->
      <section class="gt-detl-info">
        <h1 class="gt-detl-title"><%= s(typeof ddesc !== 'undefined' ? ddesc : '') %></h1>
        <div class="gt-detl-sub">
          <span class="gt-chip gt-chip-brand">
            <%= T.depts[s(typeof ddept !== 'undefined' ? ddept : '')] || s(ddept) %>
          </span>
          <span class="gt-mono"><%= s(typeof dsku !== 'undefined' ? dsku : '') %></span>
          <span class="gt-detl-price"><%= money(typeof dretail !== 'undefined' ? dretail : 0) %></span>
        </div>

        <div class="gt-stats">
          <div class="gt-stat">
            <span class="gt-stat-n"><%= num(typeof dtotoh !== 'undefined' ? dtotoh : 0) %></span>
            <span class="gt-stat-l"><%= T.onHand %></span>
          </div>
          <div class="gt-stat">
            <span class="gt-stat-n"><%= num(typeof dtotav !== 'undefined' ? dtotav : 0) %></span>
            <span class="gt-stat-l"><%= T.available %></span>
          </div>
          <div class="gt-stat">
            <span class="gt-stat-n"><%= num(typeof dbulk !== 'undefined' ? dbulk : 0) %></span>
            <span class="gt-stat-l"><%= T.inBulk %></span>
          </div>
          <div class="gt-stat">
            <span class="gt-stat-n"><%= num(typeof dnlocs !== 'undefined' ? dnlocs : 0) %></span>
            <span class="gt-stat-l"><%= T.locations %></span>
          </div>
        </div>

        <h2 class="gt-card-sub"><%= T.details %></h2>
        <dl class="gt-facts">
          <dt><%= T.uom %></dt><dd><%= s(typeof duom !== 'undefined' ? duom : '') %></dd>
          <dt><%= T.casePack %></dt><dd><%= num(typeof dcasepk !== 'undefined' ? dcasepk : 0) %></dd>
          <dt><%= T.weight %></dt>
          <dd><%= num(typeof dweight !== 'undefined' ? dweight : 0, 3) %> kg</dd>
          <dt><%= T.dims %></dt>
          <dd><%= num(typeof dlen !== 'undefined' ? dlen : 0, 1) %> &times;
              <%= num(typeof dwid !== 'undefined' ? dwid : 0, 1) %> &times;
              <%= num(typeof dhgt !== 'undefined' ? dhgt : 0, 1) %> cm</dd>
          <% if (has(typeof dupc !== 'undefined' ? dupc : '')) { %>
            <dt><%= T.upc %></dt><dd class="gt-mono"><%= s(dupc) %></dd>
          <% } %>
          <% if (has(typeof dcase !== 'undefined' ? dcase : '')) { %>
            <dt><%= T.caseCode %></dt><dd class="gt-mono"><%= s(dcase) %></dd>
          <% } %>
        </dl>
      </section>
    </div>

    <!-- ---- Where is it ------------------------------------------- -->
    <h2 class="gt-section-title">
      <%= T.whereIsIt %> <span class="gt-count"><%= rows.length %></span>
    </h2>

    <% if (rows.length > 0) { %>
      <ul class="gt-loc-list">
        <% rows.forEach(function (row) { %>
          <li class="gt-loc-row is-<%= s(row.ltype).toLowerCase() %>">
            <span class="gt-loc-id gt-mono"><%= s(row.lloc) %></span>
            <span class="gt-loc-type">
              <%= T.types[s(row.ltype)] || s(row.ltype) %>
              <small><%= T.zone %> <%= s(row.lzone) %></small>
            </span>
            <span class="gt-loc-qty">
              <strong><%= num(row.lqty) %></strong>
              <% if (Number(row.lalloc) > 0) { %>
                <small><%= num(row.lalloc) %> <%= T.alloc %></small>
              <% } %>
            </span>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <section class="gt-card gt-scan-empty"><%= T.noStock %></section>
    <% } %>
  </main>

  <input type="hidden" name="action" value="">
  <input type="hidden" name="imgdata" id="gt-photo-data" value="">

  <%# Camera capture. The camera button opens a LIVE camera in the panel
      below -- the same getUserMedia path the scan screen uses -- rather than
      handing off to the platform's file picker. On a phone the picker offered
      a gallery-versus-camera choice nobody wants when they are standing in
      front of the damaged carton, and on a desktop it was simply a file
      dialog.

      The file input stays as the FALLBACK ONLY, for when getUserMedia is
      refused: no camera on the machine, or a non-HTTPS origin. gt-photo.js
      reaches for it only after the live camera fails, which is also what
      keeps demoing from a laptop possible. %>
  <input type="file" id="gt-photo-file" accept="image/*" capture="environment"
         class="gt-photo-file" onchange="if(window.gtPhoto)gtPhoto.chosen(this)">

  <div class="gt-photo-overlay" id="gt-photo-overlay">
    <div class="gt-photo-panel">
      <h2 class="gt-photo-title"><%= T.photoTitle %></h2>
      <p class="gt-photo-hint"><%= T.photoHint %></p>

      <%# One stage holding both the live video and the captured still. Which
          is visible is driven by is-live / is-shot on the overlay, so the
          controls can never disagree with the actual camera state. %>
      <div class="gt-photo-stage" id="gt-photo-stage">
        <video id="gt-photo-video" muted playsinline></video>
        <img id="gt-photo-preview" alt="">

        <div class="gt-photo-camctl">
          <button type="button" class="gt-photo-shutter" id="gt-photo-shutter"
                  title="<%= T.takePhoto %>" aria-label="<%= T.takePhoto %>"
                  onclick="if(window.gtPhoto)gtPhoto.shoot()">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
              <path d="M4 11h5l2-3h10l2 3h5a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V12a1 1 0 0 1 1-1z"/>
              <circle cx="16" cy="18" r="5"/>
            </svg>
          </button>

          <%# Same camera-plus-no-entry badge as the scan screen, so "close the
              camera" reads identically on both. The camera stays readable at
              full size; the ban is a badge over one corner. %>
          <button type="button" class="gt-photo-stop" id="gt-photo-stop"
                  title="<%= T.closeCamera %>" aria-label="<%= T.closeCamera %>"
                  onclick="if(window.gtPhoto)gtPhoto.close()">
            <svg viewBox="0 0 32 32" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 aria-hidden="true">
              <g class="gt-icon-cam">
                <path d="M3 11h5l2-3h10l2 3h5a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V12a1 1 0 0 1 1-1z"/>
                <circle cx="15" cy="18" r="4.6"/>
              </g>
              <g class="gt-icon-ban">
                <circle cx="23" cy="23" r="8.4" class="gt-icon-ban-plate"/>
                <circle cx="23" cy="23" r="6.4" stroke-width="2.2"/>
                <line x1="18.5" y1="27.5" x2="27.5" y2="18.5" stroke-width="2.2"/>
              </g>
            </svg>
          </button>
        </div>
      </div>

      <div class="gt-photo-status" id="gt-photo-status"></div>
      <div class="gt-photo-actions">
        <button type="button" class="gt-btn gt-btn-primary" id="gt-photo-use"
                disabled onclick="if(window.gtPhoto)gtPhoto.use()">
          <%= T.usePhoto %>
        </button>
        <button type="button" class="gt-btn gt-photo-retake" id="gt-photo-retake"
                onclick="if(window.gtPhoto)gtPhoto.retake()"><%= T.retake %></button>
        <%# Only shown once the live camera has been refused. %>
        <button type="button" class="gt-btn gt-photo-choose" id="gt-photo-choose"
                onclick="if(window.gtPhoto)gtPhoto.pick()"><%= T.chooseFile %></button>
        <button type="button" class="gt-btn gt-btn-ghost"
                onclick="if(window.gtPhoto)gtPhoto.close()"><%= T.cancel %></button>
      </div>
    </div>
  </div>

  <%# Two ways out, both visible. Previously this screen offered only one
      button labelled "Scan another", and because two formats rendered at once
      it covered the search screen underneath -- so nothing but F3 worked. %>
  <footer class="gt-actions">
    <button type="button" class="gt-btn gt-btn-primary" data-fkey="F3"
            onclick="pui.submit({action:'BACK'})">&lsaquo; <%= T.back %></button>
    <button type="button" class="gt-btn" data-fkey="F12"
            onclick="pui.submit({action:'MENU'})"><%= T.menu %></button>
  </footer>
</div>
