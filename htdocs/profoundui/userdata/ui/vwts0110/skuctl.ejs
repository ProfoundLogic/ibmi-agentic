var vwApp = 'Ticket Item Inventory';
var vwSub = 'Store ' + T(dfstor) + ' ' + T(dfname) + ' - Dept ' + T(dfdept) + ' ' + T(dfdnam);
var vwPgm = T(prog) || 'TS0110W';
var vwDate = new Date().toLocaleDateString('en-US');
var vwKeys = [['F10', 'Create distribution'], ['F2', 'Back to the prompt'], ['F7', 'Top of the list'], ['F8', 'Bottom of the list'],
              ['Up / Down', 'Move between pack quantities'], ['+ / -', 'Add or remove a pack'], ['F1', 'Exit to the prompt']];
var rows = (typeof skusfl !== 'undefined' && skusfl) ? skusfl : [];
function kind(r) {
  var f = T(r.sfind) + '000000';
  if (f.charAt(0) === '1') { return f.charAt(3) === '1' ? 'sub' : 'cls'; }
  if (f.charAt(1) === '1') { return f.charAt(4) === '1' ? 'fin' : (f.charAt(3) === '1' ? 'subtot' : 'clstot'); }
  return 'sku';
}
var fin = null;
var skus = 0;
var mapped = 0;
var hot = 0;
var curSub = '';
var curCls = '';
rows.forEach(function (r) {
  r._k = kind(r);
  if (r._k === 'fin') { fin = r; }
  if (r._k === 'sub') { curSub = T(r.sfsku); }
  if (r._k === 'cls') { curCls = T(r.sfsku); }
  r._g = curSub + '-' + curCls;
  if (r._k === 'sku') {
    skus++;
    r._map = T(r.sfdes1).slice(-1) === 'Y';
    if (r._map) { mapped++; }
    if (N(r.sfpcts) >= 85) { hot++; }
  }
});
var finShp = fin ? N(fin.sfushp) : 0;
var finSld = fin ? N(fin.sfusld) : 0;
var finOnh = fin ? N(fin.sfuonh) : 0;
var finAv = fin ? N(fin.sfpavl) : 0;
var finPh = fin ? N(fin.sfphqt) : 0;
var finPct = finShp ? finSld / finShp * 100 : 0;
